  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#TapChangerInfo.highStep">
    <rdfs:comment xml:lang="en">Highest possible tap step position, advance from neutral.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#TapChangerInfo" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">highStep</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#TapChangerInfo.isTcul">
    <rdfs:comment xml:lang="en">Whether this tap changer has under load tap changing capabilities.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#TapChangerInfo" />
