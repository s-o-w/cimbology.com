  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#TimeSchedule">
    <rdfs:comment xml:lang="en">Description of anything that changes through time. Time schedule is used to perform a single-valued function of time. Use inherited 'type' attribute to give additional information on this schedule, such as: periodic (hourly, daily, weekly, monthly, etc.), day of the month, by date, calendar (specific times and dates).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">TimeSchedule</rdfs:label>
