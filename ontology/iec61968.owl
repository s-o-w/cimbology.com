  </owl:ObjectProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#OrganisationRole">
    <rdfs:comment xml:lang="en">Identifies a way in which an organisation may participate in the utility enterprise (e.g., customer, manufacturer, etc).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">OrganisationRole</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#IdentifiedObject" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61968.Common</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#OrganisationRole.ConfigurationEvents">
    <rdfs:comment xml:lang="en">All configuration events created for this organisation role.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#OrganisationRole" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">ConfigurationEvents</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#ConfigurationEvent" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#OrganisationRole.Organisation">
    <rdfs:comment xml:lang="en">Organisation having this role.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#OrganisationRole" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">Organisation</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Organisation" />
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#Outage">
    <rdfs:comment xml:lang="en">Document describing details of an active or planned outage in a part of the electrical network. A non-planned outage may be created upon: - a breaker trip, - a fault indicator status change, - a meter event indicating customer outage, - a reception of one or more customer trouble calls, or - an operator command, reflecting information obtained from the field crew. Outage restoration may be performed using a switching plan which complements the outage information with detailed switching activities, including the relationship to the crew and work. A planned outage may be created upon: - a request for service, maintenance or construction work in the field, or - an operator-defined outage for what-if/contingency network analysis.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">Outage</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#Document" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61968.Operations</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#Outage.Crew">
    <rdfs:comment xml:lang="en">The crew that is assigned to the outage.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#Outage" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">Crew</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Crew" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#Outage.DeEnergizedUsagePoint">
    <rdfs:comment xml:lang="en">all deenergized useage points associated with the outage.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#Outage" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">DeEnergizedUsagePoint</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#UsagePoint" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#Outage.EnergizedUsagePoint">
    <rdfs:comment xml:lang="en">All energized usage points associated with this outage.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#Outage" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">EnergizedUsagePoint</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#UsagePoint" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#Outage.Equipments">
    <rdfs:comment xml:lang="en">All equipments associated with this outage.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#Outage" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">Equipments</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Equipment" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#Outage.Faults">
    <rdfs:comment xml:lang="en">All faults involved in this outage.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#Outage" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">Faults</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Fault" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#Outage.OutageIsolationEquipment">
    <rdfs:comment xml:lang="en">The equipment that isolates this outage</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#Outage" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">OutageIsolationEquipment</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#ConductingEquipment" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#Outage.PlannedSwitchActions">
    <rdfs:comment xml:lang="en">All switch actions to apply within the scope of this planned outage. Each such action groups switches to which the action is to apply in order to produce the desired network state considered as outage.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#Outage" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">PlannedSwitchActions</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#SwitchAction" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#Outage.actualPeriod">
    <rdfs:comment xml:lang="en">Actual outage period; end of the period corresponds to the actual restoration time.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#Outage" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">actualPeriod</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#DateTimeInterval" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#Outage.communityDescriptor">
    <rdfs:comment xml:lang="en">a name to denote the community - this could be a name or a code of some kind.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#Outage" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">communityDescriptor</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#Outage.customersRestored">
    <rdfs:comment xml:lang="en">number of customers that have been restored in the area.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#Outage" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">customersRestored</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer" />
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#Outage.estimatedPeriod">
    <rdfs:comment xml:lang="en">Estimated outage period for a planned outage. The start of the period is the start of the planned outage and the end of the period corresponds to the end of the planned outage.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#Outage" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">estimatedPeriod</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#DateTimeInterval" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#Outage.metersAffected">
    <rdfs:comment xml:lang="en">The updated number of meters affected by the outage as reported by the OMS within the utility. It is assumed this number will be updated repeatedly until the full outage is resolved.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#Outage" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">metersAffected</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#Outage.originalCustomersServed">
    <rdfs:comment xml:lang="en">the total number of customers that are served in the area (both outaged and not outaged).</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#Outage" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">originalCustomersServed</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#Outage.originalMetersAffected">
    <rdfs:comment xml:lang="en">The original number of meters that were affected as reported by the OMS within the utility. That is, this is the total number of meters that were out at the beginning of the outage.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#Outage" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">originalMetersAffected</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer" />
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#Outage.outageKind">
    <rdfs:comment xml:lang="en">Defines if the outage has been verified or is only estimated</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#Outage" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">outageKind</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#OutageStatusKind" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#Outage.statusKind">
    <rdfs:comment xml:lang="en">defines the status of the crew as in dispatched or arrived, etc.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#Outage" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">statusKind</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#CrewStatusKind" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#Outage.summary">
    <rdfs:comment xml:lang="en">Summary counts of service points (customers) affected by this outage.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#Outage" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">summary</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#ServicePointOutageSummary" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#Outage.utilityDisclaimer">
    <rdfs:comment xml:lang="en">This contains an disclaimers the utility would like to place on the data provided to any stakeholder. This may be different for different stakeholders. This should possibly be an attribute under the Organization class but it is placed here for now.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#Outage" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">utilityDisclaimer</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#OutageArea">
    <rdfs:comment xml:lang="en">This defines the area covered by the Outage.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">OutageArea</rdfs:label>
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61968.Operations</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#OutageArea.Outage">
    <rdfs:comment xml:lang="en">The outage associated with the outage area.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#OutageArea" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">Outage</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Outage" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#OutageArea.earliestReportedTime">
    <rdfs:comment xml:lang="en">This is the reported time of the first outage report</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#OutageArea" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">earliestReportedTime</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#OutageArea.metersServed">
    <rdfs:comment xml:lang="en">defines the number of meters served in the defined area.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#OutageArea" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">metersServed</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer" />
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#OutageArea.outageAreaKind">
    <rdfs:comment xml:lang="en">defines the type of area that has the outage - county, state, zipcode, etc.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#OutageArea" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">outageAreaKind</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#AreaKind" />
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#OutageCauseKind">
    <rdfs:comment xml:lang="en">This enumeration describes the primary cause of the outage - planned, unplanned, etc.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">OutageCauseKind</rdfs:label>
    <owl:equivalentClass rdf:nodeID="oneOfClass_OutageCauseKind" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61968.Operations</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#OutageCauseKind.animal">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#OutageCauseKind" />
    <rdfs:comment xml:lang="en">This outage was caused by an animal is was unplanned. As such it is treated as a forced outage and is probably classified as "trouble" with a Trouble Ticket as well as a work/service order. The primary difference between this and an unplanned outage is the reason for the outage. If an animal caused this and perished as a result, the utility may have other actions that are required to be taken by the EPA or other groups with whom the utility has an agreement.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">animal</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#OutageCauseKind.lightingStrike">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#OutageCauseKind" />
    <rdfs:comment xml:lang="en">Outage is caused by a lighting strike</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">lightingStrike</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#OutageCauseKind.lineDown">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#OutageCauseKind" />
    <rdfs:comment xml:lang="en">The outage is caused by a line down</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">lineDown</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#OutageCauseKind.poleDown">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#OutageCauseKind" />
    <rdfs:comment xml:lang="en">The outage is caused by a pole down</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">poleDown</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#OutageCauseKind.treeDown">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#OutageCauseKind" />
    <rdfs:comment xml:lang="en">The outage is caused by a tree down</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">treeDown</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#OutageOrder">
    <rdfs:comment xml:lang="en">Transmits an outage plan to a crew in order for the planned outage to be executed.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">OutageOrder</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#Document" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61968.Operations</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#OutageOrder.Location">
    <rdfs:comment xml:lang="en">Location of this outage order.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#OutageOrder" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">Location</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Location" />
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#OutagePlan">
    <rdfs:comment xml:lang="en">Document containing the definition of planned outages of equipment and/or usage points. It will reference switching plans that are used to execute the planned outage.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">OutagePlan</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#Document" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61968.Operations</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#OutagePlan.OutageOrder">
    <rdfs:comment xml:lang="en">The outage order that will address the outage plan.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#OutagePlan" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">OutageOrder</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#OutageOrder" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#OutagePlan.PlannedOutage">
    <rdfs:comment xml:lang="en">The outage resulting from the execution of the outage plan.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#OutagePlan" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">PlannedOutage</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PlannedOutage" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#OutagePlan.approvedDateTime">
    <rdfs:comment xml:lang="en">The date and time the outage plan was approved</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#OutagePlan" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">approvedDateTime</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#OutagePlan.cancelledDateTime">
    <rdfs:comment xml:lang="en">Date and Time the planned outage was canceled.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#OutagePlan" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">cancelledDateTime</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime" />
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#OutagePlan.plannedPeriod">
    <rdfs:comment xml:lang="en">planned start and end time of the planned outage.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#OutagePlan" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">plannedPeriod</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#DateTimeInterval" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#OutagePlan.purpose">
    <rdfs:comment xml:lang="en">Purpose of this outage plan, such as whether it is to replace equipment or perform maintenance or repairs or to reconfigure network topology.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#OutagePlan" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">purpose</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#OutageStatusKind">
    <rdfs:comment xml:lang="en">This defines if the outage have been predicted or confirmed</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">OutageStatusKind</rdfs:label>
    <owl:equivalentClass rdf:nodeID="oneOfClass_OutageStatusKind" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61968.Operations</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#OutageStatusKind.closed">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#OutageStatusKind" />
    <rdfs:comment xml:lang="en">The outage has been fully restored, the crews have been released and the outage is shown as closed</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">closed</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#OutageStatusKind.confirmed">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#OutageStatusKind" />
    <rdfs:comment xml:lang="en">the outage has been verified</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">confirmed</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#OutageStatusKind.partiallyRestored">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#OutageStatusKind" />
    <rdfs:comment xml:lang="en">Some of the usage points affected by the outage have been restored but other usage points are still out of power.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">partiallyRestored</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#OutageStatusKind.predicted">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#OutageStatusKind" />
    <rdfs:comment xml:lang="en">the outage may not be real since it has not been verified - it is only thought to be an outage.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">predicted</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#OutageStatusKind.restored">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#OutageStatusKind" />
    <rdfs:comment xml:lang="en">All usage points associated with the outage have been restored</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">restored</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</cimdoc:enumCode>
  </owl:NamedIndividual>
