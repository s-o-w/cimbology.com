  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#NoLoadTest">
    <rdfs:comment xml:lang="en">No-load test results determine core admittance parameters. They include exciting current and core loss measurements from applying voltage to one winding. The excitation may be positive sequence or zero sequence. The test may be repeated at different voltages to measure saturation.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">NoLoadTest</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#TransformerTest" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61968.AssetInfo</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#NoLoadTest.EnergisedEnd">
    <rdfs:comment xml:lang="en">Transformer end that current is applied to in this no-load test.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#NoLoadTest" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">EnergisedEnd</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#TransformerEndInfo" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#NoLoadTest.energisedEndVoltage">
    <rdfs:comment xml:lang="en">Voltage applied to the winding (end) during test.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#NoLoadTest" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">energisedEndVoltage</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Voltage" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#NoLoadTest.excitingCurrent">
    <rdfs:comment xml:lang="en">Exciting current measured from a positive-sequence or single-phase excitation test.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#NoLoadTest" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">excitingCurrent</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PerCent" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#NoLoadTest.excitingCurrentZero">
    <rdfs:comment xml:lang="en">Exciting current measured from a zero-sequence open-circuit excitation test.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#NoLoadTest" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">excitingCurrentZero</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PerCent" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#NoLoadTest.loss">
    <rdfs:comment xml:lang="en">Losses measured from a positive-sequence or single-phase excitation test.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#NoLoadTest" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">loss</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#KiloActivePower" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#NoLoadTest.lossZero">
