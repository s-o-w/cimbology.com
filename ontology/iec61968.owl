    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">Jumper</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Jumper" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#JumperAction.kind">
