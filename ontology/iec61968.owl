  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#Channel.isVirtual">
    <rdfs:comment xml:lang="en">If true, the data is being calculated by an enterprise system rather than metered directly.</rdfs:comment>
