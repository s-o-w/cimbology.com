  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#OpenCircuitTest.OpenEnd">
    <rdfs:comment xml:lang="en">Transformer end measured for induced voltage and angle in this open-circuit test.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#OpenCircuitTest" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">OpenEnd</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#TransformerEndInfo" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#OpenCircuitTest.energisedEndStep">
    <rdfs:comment xml:lang="en">Tap step number for the energised end of the test pair.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#OpenCircuitTest" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
