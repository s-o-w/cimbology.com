  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#PowerQualityPricing.normalLowVoltLimit">
    <rdfs:comment xml:lang="en">Normal low voltage limit.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#PowerQualityPricing" />
