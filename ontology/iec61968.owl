    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#OilAnalysisPaperAnalogKind" />
    <rdfs:comment xml:lang="en">2-furaldehyde (2FAL) (in ppb). Also known as: 2-furfural, 2-furaldehyde, 2- furanaldehyde, fural, furfuraldehyde, furaldehyde, and 2-furancarboxaldehyde.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">furfural</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</cimdoc:enumCode>
  </owl:NamedIndividual>
