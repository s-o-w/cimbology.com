  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#ErpPayable">
    <rdfs:comment xml:lang="en">A transaction that represents an invoice from a supplier. A payable (or voucher) is an open item, approved and ready for payment, in the Accounts Payable ledger.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">ErpPayable</rdfs:label>
