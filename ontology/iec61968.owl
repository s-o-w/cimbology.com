  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#CrewStatusKind.enroute">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#CrewStatusKind" />
    <rdfs:comment xml:lang="en">the crew has been dispatched to work on an outage</rdfs:comment>
