    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SwitchInfo" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">ratedFrequency</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Frequency" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#SwitchInfo.ratedImpulseWithstandVoltage">
    <rdfs:comment xml:lang="en">Rated impulse withstand voltage, also known as BIL (Basic Impulse Level).</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SwitchInfo" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">ratedImpulseWithstandVoltage</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Voltage" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#SwitchInfo.ratedInterruptingTime">
