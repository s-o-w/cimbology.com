  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#Meter.connectionCategory">
    <rdfs:comment xml:lang="en">A code used to specify the connection category, e.g. low voltage, where the meter operates.</rdfs:comment>
