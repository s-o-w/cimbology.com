  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#SwitchInfo.breakingCapacity">
    <rdfs:comment xml:lang="en">The maximum fault current a breaking device can break safely under prescribed conditions of use.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SwitchInfo" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">breakingCapacity</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#CurrentFlow" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#SwitchInfo.gasWeightPerTank">
    <rdfs:comment xml:lang="en">Weight of gas in each tank of SF6 dead tank breaker.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SwitchInfo" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">gasWeightPerTank</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Mass" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#SwitchInfo.isSinglePhase">
    <rdfs:comment xml:lang="en">If true, it is a single phase switch.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SwitchInfo" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">isSinglePhase</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#SwitchInfo.isUnganged">
    <rdfs:comment xml:lang="en">If true, the switch is not ganged (i.e., a switch phase may be operated separately from other phases).</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SwitchInfo" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">isUnganged</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#SwitchInfo.lowPressureAlarm">
    <rdfs:comment xml:lang="en">Gas or air pressure at or below which a low pressure alarm is generated.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SwitchInfo" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">lowPressureAlarm</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Pressure" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#SwitchInfo.lowPressureLockOut">
    <rdfs:comment xml:lang="en">Gas or air pressure below which the breaker will not open.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SwitchInfo" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">lowPressureLockOut</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Pressure" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#SwitchInfo.oilVolumePerTank">
    <rdfs:comment xml:lang="en">Volume of oil in each tank of bulk oil breaker.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SwitchInfo" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">oilVolumePerTank</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Volume" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#SwitchInfo.ratedCurrent">
    <rdfs:comment xml:lang="en">Rated current.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SwitchInfo" />
