    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#RemoteConnectDisconnectInfo.isArmDisconnect">
    <rdfs:comment xml:lang="en">True if the RCD switch has to be armed before a disconnect action can be initiated.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#RemoteConnectDisconnectInfo" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">isArmDisconnect</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#RemoteConnectDisconnectInfo.isEnergyLimiting">
    <rdfs:comment xml:lang="en">True if the energy usage is limited and the customer will be disconnected if they go over the limit.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#RemoteConnectDisconnectInfo" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
