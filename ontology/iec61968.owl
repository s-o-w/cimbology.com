  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#SwitchingStepGroup.isFreeSequence">
    <rdfs:comment xml:lang="en">If true, the sequence number serves for presentation purposes only, and the activity itself may be executed at any time.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SwitchingStepGroup" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">isFreeSequence</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </owl:DatatypeProperty>
