    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#FieldDispatchStep.dispatchStatus">
    <rdfs:comment xml:lang="en">The status of one or more crews dispatched to perform field work at one or more work sites</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#FieldDispatchStep" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">dispatchStatus</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#CrewStatusKind" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#FieldDispatchStep.occurredDateTime">
    <rdfs:comment xml:lang="en">The date and time at which the dispatch status occurred.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#FieldDispatchStep" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">occurredDateTime</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#FieldDispatchStep.remarks">
    <rdfs:comment xml:lang="en">freeform comments related to the dispatch to perform field work.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#FieldDispatchStep" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">remarks</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#FieldDispatchStep.sequenceNumber">
    <rdfs:comment xml:lang="en">The sequence number of the field dispatch step within the field dispatch history. Begins with 1 and increments up.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#FieldDispatchStep" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">sequenceNumber</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#FieldSafetySupervisor">
    <rdfs:comment xml:lang="en">Crew member on work site responsible for all local safety measures for the work crew doing maintenance, construction and repair in a substation or on a power line/cable.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">FieldSafetySupervisor</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#CrewMember" />
