  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#FailureEvent">
    <rdfs:comment xml:lang="en">An event where an asset has failed to perform its functions within specified parameters. This class is intended to reflect the failure itself. Additional information resulting from forensic analysis could be captured by a diagnosis data set.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">FailureEvent</rdfs:label>
