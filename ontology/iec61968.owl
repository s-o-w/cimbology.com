    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Informative</cimdoc:packageTier>
  </owl:Class>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#ErpPayableLineItem">
    <rdfs:comment xml:lang="en">Of an ErpPayable, a line item references an ErpInvoiceLineitem or other source such as credit memos.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">ErpPayableLineItem</rdfs:label>
