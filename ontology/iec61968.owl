    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#TransactionKind.serviceChargePayment">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#TransactionKind" />
    <rdfs:comment xml:lang="en">Payment for a service.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
