  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#CustomerBillingInfo.pymtPlanAmt">
    <rdfs:comment xml:lang="en">Monthly amortized amount due during each billing cycle for the CustomerAccount balance for which the Payment Plan is set-up.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#CustomerBillingInfo" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">pymtPlanAmt</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Money" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#CustomerBillingInfo.pymtPlanType">
    <rdfs:comment xml:lang="en">Type of payment plan.</rdfs:comment>
