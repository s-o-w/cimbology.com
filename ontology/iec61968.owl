    <rdfs:comment xml:lang="en">Describes the overall purpose of the steps in this switching step group.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SwitchingStepGroup" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">purpose</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#SwitchingStepGroup.sequenceNumber">
