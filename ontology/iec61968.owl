  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#NotificationTriggerKind.powerOut">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#NotificationTriggerKind" />
    <rdfs:comment xml:lang="en">Notify customer of planned outage.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">powerOut</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</cimdoc:enumCode>
