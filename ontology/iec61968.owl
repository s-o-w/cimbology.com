    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Ground" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#GroundAction.GroundedEquipment">
    <rdfs:comment xml:lang="en">Equipment being grounded with this operation. In case of placing a ground anywhere along a line segment, you must use the clamp (to get the distance from one terminal), so use the explicit relation with line segment. In all other cases (including placing the ground at a line segment terminal), reference to one or more conducting equipment is sufficient.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#GroundAction" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">GroundedEquipment</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#ConductingEquipment" />
  </owl:ObjectProperty>
