    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#ErpLedgerEntry" />
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#ErpLedgerBudget">
    <rdfs:comment xml:lang="en">Information for utility Ledger Budgets. They support the transfer budget amounts between all possible source applications throughout an enterprise and a general ledger or budget application.</rdfs:comment>
