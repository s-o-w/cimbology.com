    <rdfs:comment xml:lang="en">Individual entry of an ErpReceivable, it is a particular transaction representing an invoice, credit memo or debit memo to a customer.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">ErpRecLineItem</rdfs:label>
