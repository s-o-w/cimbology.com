  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#PowerQualityPricing.powerFactorMin">
    <rdfs:comment xml:lang="en">Threshold minimum power factor for this PricingStructure, specified in instances where a special charge is levied if the actual power factor for a Service falls below the value specified here.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#PowerQualityPricing" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">powerFactorMin</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#PowerQualityPricing.valueUninterruptedServiceEnergy">
    <rdfs:comment xml:lang="en">Value of uninterrupted service (Cost per energy).</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#PowerQualityPricing" />
