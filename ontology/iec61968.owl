  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#ASTMStandardEditionKind.unknown">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#ASTMStandardEditionKind" />
    <rdfs:comment xml:lang="en">Unknown edition.</rdfs:comment>
