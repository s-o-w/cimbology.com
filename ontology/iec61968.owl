  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#SupplierKind.mdma">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#SupplierKind" />
    <rdfs:comment xml:lang="en">Meter Data Management Agent (MDMA) reads meters, validates meter data, and estimates missing data to be used in various applications</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">mdma</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#SupplierKind.msp">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#SupplierKind" />
    <rdfs:comment xml:lang="en">Managed service provider (MSP) delivers services, such as network, application, infrastructure and security, via ongoing and regular support and active administration</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">msp</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#SupplierKind.other">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#SupplierKind" />
    <rdfs:comment xml:lang="en">Other kind of supplier.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">other</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#SupplierKind.retailer">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#SupplierKind" />
    <rdfs:comment xml:lang="en">Entity that sells the service, but does not deliver to the customer; applies to the deregulated markets.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">retailer</rdfs:label>
