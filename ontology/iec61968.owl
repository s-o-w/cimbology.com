    <rdfs:label xml:lang="en">justification</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#Priority.rank">
    <rdfs:comment xml:lang="en">Priority level; lower number means high priority inside the same 'type'.</rdfs:comment>
