  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#DERMonitorableParameter">
    <rdfs:comment xml:lang="en">To define the DER monitorable parameters that will be forecasted and dispatched for a DER Group. Each parameter is represented as a Y Value at a point in time or on a curve as a function of time, which is represented on the X axis.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">DERMonitorableParameter</rdfs:label>
