    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SwitchInfo" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">ratedInterruptingTime</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Seconds" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#SwitchInfo.ratedVoltage">
