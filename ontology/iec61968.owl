  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#TownDetail.section">
    <rdfs:comment xml:lang="en">Town section. For example, it is common for there to be 36 sections per township.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#TownDetail" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">section</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#TownDetail.stateOrProvince">
    <rdfs:comment xml:lang="en">Name of the state or province.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#TownDetail" />
