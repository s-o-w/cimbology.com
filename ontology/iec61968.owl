    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#FieldSafetySupervisor.IssuedSafetyDocuments">
    <rdfs:comment xml:lang="en">All safety documents issued to this supervisor.</rdfs:comment>
