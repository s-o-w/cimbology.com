    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Voltage" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#RemoteConnectDisconnectInfo.energyLimit">
    <rdfs:comment xml:lang="en">Limit of energy before disconnect.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#RemoteConnectDisconnectInfo" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">energyLimit</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#RealEnergy" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#RemoteConnectDisconnectInfo.energyUsageStartDateTime">
    <rdfs:comment xml:lang="en">Start date and time to accumulate energy for energy usage limiting.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#RemoteConnectDisconnectInfo" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">energyUsageStartDateTime</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#RemoteConnectDisconnectInfo.energyUsageWarning">
    <rdfs:comment xml:lang="en">Warning energy limit, used to trigger event code that energy usage is nearing limit.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#RemoteConnectDisconnectInfo" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">energyUsageWarning</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#RealEnergy" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#RemoteConnectDisconnectInfo.isArmConnect">
    <rdfs:comment xml:lang="en">True if the RCD switch has to be armed before a connect action can be initiated.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#RemoteConnectDisconnectInfo" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
