  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#ComFunction">
    <rdfs:comment xml:lang="en">Communication function of communication equipment or a device such as a meter.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">ComFunction</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#EndDeviceFunction" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61968.Metering</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ComFunction.amrAddress">
    <rdfs:comment xml:lang="en">Communication ID number (e.g. serial number, IP address, telephone number, etc. ) of the AMR module which serves this meter.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ComFunction" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">amrAddress</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ComFunction.amrRouter">
    <rdfs:comment xml:lang="en">Communication ID number (e.g. port number, serial number, data collector ID, etc.) of the parent device associated to this AMR module.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ComFunction" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">amrRouter</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#ComFunction.direction">
    <rdfs:comment xml:lang="en">Kind of communication direction.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ComFunction" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">direction</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#ComDirectionKind" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#ComFunction.technology">
    <rdfs:comment xml:lang="en">Kind of communication technology.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ComFunction" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">technology</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#ComTechnologyKind" />
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#ComMedia">
    <rdfs:comment xml:lang="en">Communication media such as fibre optic cable, power-line, telephone, etc.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">ComMedia</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#Asset" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61968.AssetInfo.Assets</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#ComModule">
    <rdfs:comment xml:lang="en">An asset having communications capabilities that can be paired with a meter or other end device to provide the device with communication ability, through associated communication function. An end device that has communications capabilities through embedded hardware can use that function directly (without the communication module), or combine embedded communication function with additional communication functions provided through an external communication module (e.g. zigbee).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">ComModule</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#Asset" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61968.Metering</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#ComModule.ComFunctions">
    <rdfs:comment xml:lang="en">All functions this communication module performs.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ComModule" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">ComFunctions</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#ComFunction" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ComModule.amrSystem">
    <rdfs:comment xml:lang="en">Automated meter reading (AMR) system communicating with this com module.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ComModule" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">amrSystem</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ComModule.supportsAutonomousDst">
    <rdfs:comment xml:lang="en">If true, autonomous daylight saving time (DST) function is supported.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ComModule" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">supportsAutonomousDst</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ComModule.timeZoneOffset">
    <rdfs:comment xml:lang="en">Time zone offset relative to GMT for the location of this com module.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ComModule" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">timeZoneOffset</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Minutes" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#ComTechnologyKind">
    <rdfs:comment xml:lang="en">Kind of communication technology.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">ComTechnologyKind</rdfs:label>
    <owl:equivalentClass rdf:nodeID="oneOfClass_ComTechnologyKind" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61968.Metering</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#ComTechnologyKind.cellular">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#ComTechnologyKind" />
    <rdfs:comment xml:lang="en">Communicates using a public cellular radio network. A specific variant of 'rf'.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">cellular</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#ComTechnologyKind.ethernet">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#ComTechnologyKind" />
    <rdfs:comment xml:lang="en">Communicates using one or more of a family of frame-based computer networking technologies conforming to the IEEE 802.3 standard.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">ethernet</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#ComTechnologyKind.homePlug">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#ComTechnologyKind" />
    <rdfs:comment xml:lang="en">Communicates using power line communication technologies conforming to the standards established by the HomePlug Powerline Alliance. A specific variant of 'plc'.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">homePlug</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#ComTechnologyKind.pager">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#ComTechnologyKind" />
    <rdfs:comment xml:lang="en">Communicates using a public one-way or two-way radio-based paging network. A specific variant of 'rf'.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">pager</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#ComTechnologyKind.phone">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#ComTechnologyKind" />
    <rdfs:comment xml:lang="en">Communicates using a basic, wireline telephone system.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">phone</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#ComTechnologyKind.plc">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#ComTechnologyKind" />
    <rdfs:comment xml:lang="en">Communicates using power line communication technologies.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">plc</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#ComTechnologyKind.rf">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#ComTechnologyKind" />
    <rdfs:comment xml:lang="en">Communicates using private or public radio-based technology.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">rf</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#ComTechnologyKind.rfMesh">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#ComTechnologyKind" />
    <rdfs:comment xml:lang="en">Communicates using a mesh radio technology. A specific variant of 'rf'.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">rfMesh</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#ComTechnologyKind.zigbee">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#ComTechnologyKind" />
    <rdfs:comment xml:lang="en">Communicates using radio communication technologies conforming to the standards established by the ZigBee. A specific variant of 'rf'.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">zigbee</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#CommodityKind">
    <rdfs:comment xml:lang="en">Kind of commodity being measured.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">CommodityKind</rdfs:label>
    <owl:equivalentClass rdf:nodeID="oneOfClass_CommodityKind" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61968.Metering</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#CommodityKind.air">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#CommodityKind" />
    <rdfs:comment xml:lang="en">Atmospheric air</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">air</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#CommodityKind.carbon">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#CommodityKind" />
    <rdfs:comment xml:lang="en">The element has an atomic number of 6.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">carbon</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">19</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#CommodityKind.ch4">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#CommodityKind" />
    <rdfs:comment xml:lang="en">Methane CH4</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">ch4</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">17</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#CommodityKind.co2">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#CommodityKind" />
    <rdfs:comment xml:lang="en">Carbon Dioxide CO2</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">co2</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">18</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#CommodityKind.communication">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#CommodityKind" />
    <rdfs:comment xml:lang="en">A measurement of the communication infrastructure itself.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">communication</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#CommodityKind.coolingFluid">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#CommodityKind" />
    <rdfs:comment xml:lang="en">The cool fluid returns warmer than when it was sent. The heat conveyed may be metered.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">coolingFluid</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">13</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#CommodityKind.electricityPrimaryMetered">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#CommodityKind" />
    <rdfs:comment xml:lang="en">It is possible for a meter to be outfitted with an external VT and/or CT. The meter might not be aware of these devices, and the display not compensate for their presence. Ultimately, when these scalars are applied, the value that represents the service value is called the �primary metered� value. The �index� in sub-category 3 mirrors those of sub-category 0.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">electricityPrimaryMetered</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#CommodityKind.electricitySecondaryMetered">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#CommodityKind" />
    <rdfs:comment xml:lang="en">All types of metered quantities. This type of reading comes from the meter and represents a �secondary� metered value.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">electricitySecondaryMetered</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#CommodityKind.hch">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#CommodityKind" />
    <rdfs:comment xml:lang="en">Hexachlorocyclohexane HCH</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">hch</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">20</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#CommodityKind.heatingFluid">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#CommodityKind" />
    <rdfs:comment xml:lang="en">This fluid is likely in liquid form. It is not necessarily water or water based. The warm fluid returns cooler than when it was sent. The heat conveyed may be metered.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">heatingFluid</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#CommodityKind.insulativeGas">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#CommodityKind" />
    <rdfs:comment xml:lang="en">(SF6 is found separately below.)</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">insulativeGas</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#CommodityKind.insulativeOil">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#CommodityKind" />
    <rdfs:comment xml:lang="en">Oil that is used in transformers to provide insulation and heat conduction.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">insulativeOil</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#CommodityKind.internet">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#CommodityKind" />
    <rdfs:comment xml:lang="en">Internet service</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">internet</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">24</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#CommodityKind.naturalGas">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#CommodityKind" />
    <rdfs:comment xml:lang="en">A naturally occurring hydrocarbon gas mixture.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">naturalGas</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#CommodityKind.none">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#CommodityKind" />
    <rdfs:comment xml:lang="en">Not Applicable</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">none</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#CommodityKind.nonpotableWater">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#CommodityKind" />
    <rdfs:comment xml:lang="en">Reclaimed water � possibly used for irrigation but not sufficiently treated to be considered safe for drinking.</rdfs:comment>
