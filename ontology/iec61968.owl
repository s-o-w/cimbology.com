    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#OilAnalysisPaperAnalogKind" />
    <rdfs:comment xml:lang="en">Direct measurement of degree of polymerization (DP) (unitless).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">degreeOfPolymerization</rdfs:label>
