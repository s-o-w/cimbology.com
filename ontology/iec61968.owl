<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:dcterms="http://purl.org/dc/terms/" xmlns:cim="http://iec.ch/TC57/CIM100#" xmlns:cimdoc="https://cimbology.com/ontology/cimdoc#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
