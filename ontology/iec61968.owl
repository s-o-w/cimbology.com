    <rdfs:comment xml:lang="en">Voltage limit on customer side of RCD switch above which the connect should not be made.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#RemoteConnectDisconnectInfo" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
