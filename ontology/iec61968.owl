  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#JumperAction.ACLineSegments">
    <rdfs:comment xml:lang="en">The line segment that this jumper action will affect. This is the only way to access relationship to clamp in case the jumper needs to connect along the line segment.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#JumperAction" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
