  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#Priority.type">
    <rdfs:comment xml:lang="en">Type describing 'rank'; e.g., high, emergency, etc.</rdfs:comment>
