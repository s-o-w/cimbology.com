    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Informative</cimdoc:packageTier>
  </owl:Class>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#ErpEngChangeOrder">
    <rdfs:comment xml:lang="en">General Utility Engineering Change Order information.</rdfs:comment>
