    <rdfs:label xml:lang="en">tension</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#TownDetail">
