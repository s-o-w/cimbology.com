    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">corrosiveSulphurBy51353</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#OilAnalysisFluidDiscreteKind.corrosiveSulphurBy62535">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#OilAnalysisFluidDiscreteKind" />
