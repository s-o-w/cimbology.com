    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#OilAnalysisPaperAnalogKind" />
    <rdfs:comment xml:lang="en">2-acetylfuran (2ACF) (in ppb). Also known as: 2-acetylfuran, furyl methyl ketone, 2-furyl methyl ketone, methyl 2-furyl ketone, and 1-(2-furanyl)ethanone.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">acetylfuran</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11</cimdoc:enumCode>
  </owl:NamedIndividual>
