    <rdfs:comment xml:lang="en">Installation code.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#EndDevice" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">installCode</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#EndDevice.isPan">
    <rdfs:comment xml:lang="en">If true, this is a premises area network (PAN) device.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#EndDevice" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">isPan</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#EndDevice.isSmartInverter">
    <rdfs:comment xml:lang="en">If true, there is a communicating inverter present.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#EndDevice" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">isSmartInverter</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#EndDevice.isVirtual">
    <rdfs:comment xml:lang="en">If true, there is no physical device. As an example, a virtual meter can be defined to aggregate the consumption for two or more physical meters. Otherwise, this is a physical hardware device.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#EndDevice" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">isVirtual</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </owl:DatatypeProperty>
