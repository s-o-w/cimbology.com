    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#OilAnalysisPaperAnalogKind" />
    <rdfs:comment xml:lang="en">Concentration of ethanol (in ppb, specifically microgram/kilogram).</rdfs:comment>
