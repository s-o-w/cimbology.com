  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#Transaction.serviceUnitsError">
    <rdfs:comment xml:lang="en">Number of service units not reflected in 'serviceUnitsEnergy' due to process rounding or truncating errors.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#Transaction" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">serviceUnitsError</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#RealEnergy" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#TransactionKind">
    <rdfs:comment xml:lang="en">Kind of transaction.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">TransactionKind</rdfs:label>
