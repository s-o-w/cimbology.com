    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#ErpInvoice.kind">
    <rdfs:comment xml:lang="en">Kind of invoice (default is 'sales').</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ErpInvoice" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">kind</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#ErpInvoiceKind" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ErpInvoice.mailedDate">
    <rdfs:comment xml:lang="en">Date on which the customer billing statement/invoice was printed/mailed.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ErpInvoice" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
