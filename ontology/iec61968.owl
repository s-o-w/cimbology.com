  </owl:Class>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#ErpCompetency">
    <rdfs:comment xml:lang="en">Information that describes aptitudes of a utility employee. Unlike Skills that an ErpPerson must be certified to perform before undertaking certain type of assignments (to be able to perfrom a Craft), ErpCompetency has more to do with typical Human Resource (HR) matters such as schooling, training, etc.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">ErpCompetency</rdfs:label>
