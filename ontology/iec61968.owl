  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#TelephoneNumber.cityCode">
    <rdfs:comment xml:lang="en">City code.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#TelephoneNumber" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">cityCode</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#TelephoneNumber.countryCode">
    <rdfs:comment xml:lang="en">Country code.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#TelephoneNumber" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">countryCode</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#TelephoneNumber.dialOut">
    <rdfs:comment xml:lang="en">(if applicable) Dial out code, for instance to call outside an enterprise.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#TelephoneNumber" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">dialOut</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#TelephoneNumber.extension">
    <rdfs:comment xml:lang="en">(if applicable) Extension for this telephone number.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#TelephoneNumber" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">extension</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#TelephoneNumber.internationalPrefix">
    <rdfs:comment xml:lang="en">(if applicable) Prefix used when calling an international number.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#TelephoneNumber" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">internationalPrefix</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#TelephoneNumber.ituPhone">
    <rdfs:comment xml:lang="en">Phone number according to International Telecommunication Union (ITU) E.164.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#TelephoneNumber" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">ituPhone</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#TelephoneNumber.localNumber">
    <rdfs:comment xml:lang="en">Main (local) part of this telephone number.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#TelephoneNumber" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">localNumber</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#TempEquipActionKind">
    <rdfs:comment xml:lang="en">Kind of action on temporary equipment (such as cut, jumper, ground, energy source).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">TempEquipActionKind</rdfs:label>
    <owl:equivalentClass rdf:nodeID="oneOfClass_TempEquipActionKind" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61968.Operations</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#TempEquipActionKind.connect">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#TempEquipActionKind" />
    <rdfs:comment xml:lang="en">Connect the temp equipment to its terminal</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">connect</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#TempEquipActionKind.disconnect">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#TempEquipActionKind" />
    <rdfs:comment xml:lang="en">Disconnect the temp equipment from its terminal</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">disconnect</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#TempEquipActionKind.place">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#TempEquipActionKind" />
    <rdfs:comment xml:lang="en">Place the jumper (close) or the cut (open).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">place</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#TempEquipActionKind.remove">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#TempEquipActionKind" />
    <rdfs:comment xml:lang="en">Remove the jumper (open) or the cut (close).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">remove</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#Tender">
    <rdfs:comment xml:lang="en">Tender is what is "offered" by the customer towards making a payment and is often more than the required payment (hence the need for 'change'). The payment is thus that part of the Tender that goes towards settlement of a particular transaction. Tender is modelled as an aggregation of Cheque and Card. Both these tender types can exist in a single tender bid thus 'accountHolderName' has to exist separately in each of Cheque and Card as each could have a different account holder name.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">Tender</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#IdentifiedObject" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61968.PaymentMetering</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#Tender.Receipt">
    <rdfs:comment xml:lang="en">Receipt that recorded this receiving of a payment in the form of tenders.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#Tender" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">Receipt</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Receipt" />
