    <rdfs:comment xml:lang="en">Voltage applied to the winding (end) during test.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#OpenCircuitTest" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">energisedEndVoltage</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Voltage" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#OpenCircuitTest.openEndStep">
    <rdfs:comment xml:lang="en">Tap step number for the open end of the test pair.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#OpenCircuitTest" />
