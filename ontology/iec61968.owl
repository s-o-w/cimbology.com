  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#AcceptanceTest">
    <rdfs:comment xml:lang="en">Acceptance test for assets.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">AcceptanceTest</rdfs:label>
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61968.AssetInfo.Assets</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#AcceptanceTest.dateTime">
    <rdfs:comment xml:lang="en">Date and time the asset was last tested using the 'type' of test and yielding the current status in 'success' attribute.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#AcceptanceTest" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">dateTime</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#AcceptanceTest.success">
    <rdfs:comment xml:lang="en">True if asset has passed acceptance test and may be placed in or is in service. It is set to false if asset is removed from service and is required to be tested again before being placed back in service, possibly in a new location. Since asset may go through multiple tests during its lifecycle, the date of each acceptance test may be recorded in 'Asset.ActivityRecord.status.dateTime'.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#AcceptanceTest" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">success</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#AcceptanceTest.type">
    <rdfs:comment xml:lang="en">Type of test or group of tests that was conducted on 'dateTime'.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#AcceptanceTest" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">type</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#AccessPermit">
    <rdfs:comment xml:lang="en">A permit is sometimes needed to provide legal access to land or equipment. For example, local authority permission for road works.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">AccessPermit</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#WorkDocument" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61968.InfIEC61968.InfWork</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Informative</cimdoc:packageTier>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#AccessPermit.applicationNumber">
    <rdfs:comment xml:lang="en">Permit application number that is used by municipality, state, province, etc.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#AccessPermit" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">applicationNumber</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#AccessPermit.effectiveDate">
    <rdfs:comment xml:lang="en">Date that permit became official.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#AccessPermit" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">effectiveDate</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#AccessPermit.expirationDate">
    <rdfs:comment xml:lang="en">Permit expiration date.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#AccessPermit" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">expirationDate</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#AccessPermit.payment">
    <rdfs:comment xml:lang="en">Total cost of permit.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#AccessPermit" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">payment</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Money" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#AccessPermit.permitID">
    <rdfs:comment xml:lang="en">Permit identifier.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#AccessPermit" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">permitID</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#AccountMovement">
    <rdfs:comment xml:lang="en">Credit/debit movements for an account.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">AccountMovement</rdfs:label>
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61968.PaymentMetering</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#AccountMovement.amount">
    <rdfs:comment xml:lang="en">Amount that was credited to/debited from an account. For example: payment received/interest charge on arrears.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#AccountMovement" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">amount</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Money" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#AccountMovement.dateTime">
    <rdfs:comment xml:lang="en">Date and time when the credit/debit transaction was performed.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#AccountMovement" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">dateTime</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#AccountMovement.reason">
    <rdfs:comment xml:lang="en">Reason for credit/debit transaction on an account. Example: payment received/arrears interest levied.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#AccountMovement" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">reason</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#AccountNotification">
    <rdfs:comment xml:lang="en">Notifications for move-in, move-out, delinquencies, etc.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">AccountNotification</rdfs:label>
