    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">kind</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#MediumKind" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#Medium.volumeSpec">
    <rdfs:comment xml:lang="en">The volume of the medium specified for this application. Note that the actual volume is a type of measurement associated witht the asset.</rdfs:comment>
