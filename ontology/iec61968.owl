  </owl:Class>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#ErpSalesOrder">
    <rdfs:comment xml:lang="en">General purpose Sales Order is used for utility service orders, etc. As used by the OAG, the SalesOrder is a step beyond a PurchaseOrder in that the receiving entity of the order also communicates SalesInformoration about the Order along with the Order itself.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">ErpSalesOrder</rdfs:label>
