  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#AssetAnalog.TestStandard">
    <rdfs:comment xml:lang="en">The lab test standard to which this asset health analog is related.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#AssetAnalog" />
