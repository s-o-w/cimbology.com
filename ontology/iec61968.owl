  </owl:Class>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#SwitchActionKind.close">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#SwitchActionKind" />
    <rdfs:comment xml:lang="en">Close the switch.</rdfs:comment>
