  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#ErpRequisition">
    <rdfs:comment xml:lang="en">General information that applies to a utility requisition that is a request for the purchase of goods or services. Typically, a requisition leads to the creation of a purchase order to a specific supplier.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">ErpRequisition</rdfs:label>
