  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#ChargeKind.auxiliaryCharge">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#ChargeKind" />
    <rdfs:comment xml:lang="en">Any other charge which is not a consumptionCharge or demandCharge. For example: debt recovery, arrears, standing charge or charge for another service such as street lighting.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">auxiliaryCharge</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#ChargeKind.consumptionCharge">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#ChargeKind" />
    <rdfs:comment xml:lang="en">The charge levied for the actual usage of the service, normally expressed in terms of a tariff. For example: usage x price per kWh = total charge for consumption.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">consumptionCharge</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#ChargeKind.demandCharge">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#ChargeKind" />
    <rdfs:comment xml:lang="en">The charge related to the usage within a defined time interval, normally expressed in terms of a tariff. For example: a maximum-demand tariff will levy an additional charge on top of the consumption charge if the usage exceeds a defined limit per hour.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">demandCharge</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#ChargeKind.other">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#ChargeKind" />
    <rdfs:comment xml:lang="en">Other kind of charge.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">other</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#ChargeKind.taxCharge">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#ChargeKind" />
    <rdfs:comment xml:lang="en">Any charge that is classified as a tax of a kind. For example: VAT, GST, TV tax, etc.</rdfs:comment>
