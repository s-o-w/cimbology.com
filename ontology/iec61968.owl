  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#ErpChartOfAccounts">
    <rdfs:comment xml:lang="en">Accounting structure of a business. Each account represents a financial aspect of a business, such as its Accounts Payable, or the value of its inventory, or its office supply expenses.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
