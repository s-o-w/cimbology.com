    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">ProcedureDataSets</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#ProcedureDataSet" />
