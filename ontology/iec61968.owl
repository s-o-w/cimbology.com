  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#RemoteConnectDisconnectInfo.needsPowerLimitCheck">
    <rdfs:comment xml:lang="en">True if load limit has to be checked to issue an immediate disconnect (after a connect) if load is over the limit.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#RemoteConnectDisconnectInfo" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">needsPowerLimitCheck</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#RemoteConnectDisconnectInfo.needsVoltageLimitCheck">
    <rdfs:comment xml:lang="en">True if voltage limit has to be checked to prevent connect if voltage is over the limit.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#RemoteConnectDisconnectInfo" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
