  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind">
    <rdfs:comment xml:lang="en">Analogs representing oil fluid test analysis result.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">OilAnalysisFluidAnalogKind</rdfs:label>
    <owl:equivalentClass rdf:nodeID="oneOfClass_OilAnalysisFluidAnalogKind" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61968.AssetMeas</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind.acidNumber">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind" />
    <rdfs:comment xml:lang="en">Acid neutralization number (in milligram of KOH/gram).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">acidNumber</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind.additiveDBDS">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind" />
    <rdfs:comment xml:lang="en">Dibenzyl disulfide (DBDS) concentration (in ppm, specificially in milligram/kilogram).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">additiveDBDS</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind.aromatics">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind" />
    <rdfs:comment xml:lang="en">Concentration of aromatic compounds determined using infrared spectroscopy (in percent).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">aromatics</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">26</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind.carbonyl">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind" />
    <rdfs:comment xml:lang="en">Concentration of carbonyl compounds (aldehydes and ketones) determined using infrared spectroscopy (in percent).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">carbonyl</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">25</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind.density">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind" />
    <rdfs:comment xml:lang="en">Density (in gram/millilitre).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">density</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind.dielectricBreakdown">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind" />
    <rdfs:comment xml:lang="en">Dielectric breakdown, for electrode gap size and temperature specified by selected standard (in kV).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">dielectricBreakdown</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind.dissipationFactor">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind" />
    <rdfs:comment xml:lang="en">Fluid dissipation factor in absolute value, not a percentage. (Multiplying this value by 100 would result in dissipation factor percent).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">dissipationFactor</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind.dissipationFactorPercent">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind" />
    <rdfs:comment xml:lang="en">Fluid dissipation factor (in percent). Commonly used in Asia. Dissipation factor is also known as loss factor or tan delta.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">dissipationFactorPercent</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind.duration61125MethodC">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind" />
    <rdfs:comment xml:lang="en">Duration of oxidation stablity test performed according to IEC 61125, method C. This value should accompany values resulting from testing according to IEC 61125, method C to allow interpretation. Standard specified values are: 164, 332, and 500, but others can be used if agreed upon.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">duration61125MethodC</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">34</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind.firePoint">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind" />
    <rdfs:comment xml:lang="en">Fire point (in �C). Fire point is when fire is sustained (oil catches fire). Can only be done by means of open cup test, which is commonly used in US.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">firePoint</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind.flashPointClosedCup">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind" />
    <rdfs:comment xml:lang="en">Flash point (in �C) determined via closed cup test. Flash point occurs when enough vapors have accumulated to sustain a flash. Closed cup is used in Europe.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">flashPointClosedCup</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">14</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind.flashPointOpenCup">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind" />
    <rdfs:comment xml:lang="en">Flash point (in �C) determined via open cup test. Flash point occurs when enough vapors have accumulated to sustain a flash. Open cup is used in US.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">flashPointOpenCup</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">13</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind.inductionTime">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind" />
    <rdfs:comment xml:lang="en">Oxidation induction time (in hours). Typically performed on new oil,but can be done on used oil.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">inductionTime</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">32</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind.inhibitor61125MethodC">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind" />
    <rdfs:comment xml:lang="en">Amount of inhibitor used in oxidation stablity test performed according to IEC 61125, method C. This value should accompany values resulting from testing according to IEC 61125, method C to allow interpretation.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">inhibitor61125MethodC</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">33</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind.interfacialTension">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind" />
    <rdfs:comment xml:lang="en">Interfacial tension (in dyne/centimetre or milliNewton/metre, which are the same).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">interfacialTension</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind.kinematicViscosity">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind" />
    <rdfs:comment xml:lang="en">Kinematic viscosity (in millimetre2/second). Kinematic viscosity is the ratio of - absolute (or dynamic) viscosity to density.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">kinematicViscosity</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">17</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind.oxidation">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind" />
    <rdfs:comment xml:lang="en">Measure of oxidation stability (in hours).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">oxidation</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">27</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind.oxidationInhibitorD2668">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind" />
    <rdfs:comment xml:lang="en">2,6-ditertiary-butyl para-cresol and 2,6-ditertiary-butyl phenol concentration (in percent by weight).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">oxidationInhibitorD2668</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind.oxidationInhibitorDBP">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind" />
    <rdfs:comment xml:lang="en">2,6-ditertiary-butyl phenol (DBP) oxidation inhibitor concentration (in percent by weight).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">oxidationInhibitorDBP</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind.oxidationInhibitorDBPC">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind" />
    <rdfs:comment xml:lang="en">2,6-ditertiarybutyl para-cresol (DBPC) oxidation inhibitor concentration (in percent by weight).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">oxidationInhibitorDBPC</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind.passivatorBTA">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind" />
    <rdfs:comment xml:lang="en">Metal passivator BTA content (in milligram/kilogram).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">passivatorBTA</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">23</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind.passivatorContent">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind" />
    <rdfs:comment xml:lang="en">Total passivator content (in milligram/kilogram).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">passivatorContent</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">20</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind.passivatorIrgamet39">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind" />
    <rdfs:comment xml:lang="en">Irgamet 39 metal passivator content (in ppm, specifically milligram/kilogram).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">passivatorIrgamet39</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">21</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind.passivatorTTA">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind" />
    <rdfs:comment xml:lang="en">Metal passivator TTA (Irgamet39 in solid form) content (in milligram/kilogram).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">passivatorTTA</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">22</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind.petroleumOrigin">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind" />
    <rdfs:comment xml:lang="en">Characterization of the carbon-type composition of insulating oils by petroleum origin.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">petroleumOrigin</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">35</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind.pourPoint">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind" />
    <rdfs:comment xml:lang="en">Pour point (in �C). The pour point of a liquid is the temperature at which it becomes semi solid and loses its flow characteristics.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">pourPoint</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind.pourPointAutomatic">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind" />
    <rdfs:comment xml:lang="en">Pour point (in �C) determined by automatic method. The pour point of a liquid is the temperature at which it becomes semi solid and loses its flow characteristics.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">pourPointAutomatic</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">16</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind.powerFactorPercent">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind" />
    <rdfs:comment xml:lang="en">Fluid power factor at specified temperature (in percent). Commonly used in US. (Note: Fluid power factor is very similar to fluid dissapation factor, but fluid power factor is cosine of the phase angle between an AC voltage applied to oil and the resulting current (where dissipation factor is the tangent). For values up to 0.005, fluid power factor and dissapation factor are very close. There is a conversion equation between the two).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">powerFactorPercent</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind.resistivity">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind" />
    <rdfs:comment xml:lang="en">Resistivity at 90�C (in gigohm-metre).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">resistivity</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">19</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind.sedimentAndSludgePercent">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind" />
    <rdfs:comment xml:lang="en">Sediment and sludge (in percent).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">sedimentAndSludgePercent</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">24</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind.sludge">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind" />
    <rdfs:comment xml:lang="en">Sludge (in percent by mass). Typically performed on new oil,but can be done on used oil.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">sludge</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">28</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind.solubleAcids">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind" />
    <rdfs:comment xml:lang="en">Soluble acids (in milligram of KOH/gram). Typically performed on new oil,but can be done on used oil.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">solubleAcids</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">29</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind.specificGravity">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind" />
    <rdfs:comment xml:lang="en">Specific gravity corrected to 15�C. Also known as relative density. It is a ratio of density of tested oil to density of water at a specific temperature.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">specificGravity</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind.staticElectrification">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#OilAnalysisFluidAnalogKind" />
    <rdfs:comment xml:lang="en">Static electrification tendency (in microcoulombs per metre3). Also called static charging tendency and electrostatic charging tendency (ECT).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">staticElectrification</rdfs:label>
