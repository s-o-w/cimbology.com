    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">corrosiveSulphurBy62535</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#OilAnalysisFluidDiscreteKind.corrosiveSulphurByD1275">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#OilAnalysisFluidDiscreteKind" />
    <rdfs:comment xml:lang="en">Corrosive sulphur test result using bare copper strip test. Possible values: corrosive, nonCorrosive.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">corrosiveSulphurByD1275</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#OilAnalysisFluidDiscreteKind.sludgePrecipitation">
