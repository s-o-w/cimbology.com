    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">billMediaKind</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#BillMediaKind" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ErpInvoice.dueDate">
    <rdfs:comment xml:lang="en">Calculated date upon which the Invoice amount is due.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ErpInvoice" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
