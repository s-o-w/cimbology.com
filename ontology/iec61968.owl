    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#IdentifiedObject" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61968.Metering</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#EndDeviceControl.EndDeviceAction">
    <rdfs:comment xml:lang="en">End device action issued by this end device control.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#EndDeviceControl" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">EndDeviceAction</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#EndDeviceAction" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#EndDeviceControl.EndDeviceControlType">
