    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#EndDeviceControl" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">EndDeviceControlType</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#EndDeviceControlType" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#EndDeviceControl.EndDevices">
    <rdfs:comment xml:lang="en">All end devices receiving commands from this end device control.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#EndDeviceControl" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
