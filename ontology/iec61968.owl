    <rdfs:label xml:lang="en">disableReclosing</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#SwitchActionKind.enableReclosing">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#SwitchActionKind" />
    <rdfs:comment xml:lang="en">Enable (automatic) switch reclosing.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">enableReclosing</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#SwitchActionKind.open">
