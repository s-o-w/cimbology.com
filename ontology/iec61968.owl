  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#ErpJournal">
    <rdfs:comment xml:lang="en">Book for recording accounting transactions as they occur. Transactions and adjustments are first recorded in a journal, which is like a diary of instructions, advising which account to be charged and by how much. A journal represents a change in the balances of a business's financial accounts. Many tasks or transactions throughout an enterprise will result in the creation of a journal. Some examples are creating a customer invoice, paying a vendor, transferring inventory, or paying employees.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">ErpJournal</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#ErpDocument" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61968.InfIEC61968.InfERPSupport</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Informative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#ErpJournal.ErpJournalEntries">
    <rdfs:comment xml:lang="en">The erp journal entries</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ErpJournal" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
    <rdfs:label xml:lang="en">ErpJournalEntries</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#ErpJournalEntry" />
  </owl:ObjectProperty>
