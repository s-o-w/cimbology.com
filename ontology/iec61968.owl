  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#SupplierKind.utility">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#SupplierKind" />
    <rdfs:comment xml:lang="en">Entity that delivers the service to the customer.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
