  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#TimePoint.dateTime">
    <rdfs:comment xml:lang="en">Absolute date and time for this time point. For calendar-based time point, it is typically manually entered, while for interval-based or sequence-based time point it is derived.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#TimePoint" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
