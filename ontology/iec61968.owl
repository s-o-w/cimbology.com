  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#TapChangerInfo.bil">
    <rdfs:comment xml:lang="en">Basic Insulation Level (BIL) expressed as the impulse crest voltage of a nominal wave, typically 1.2 X 50 microsecond. This is a measure of the ability of the insulation to withstand very high voltage surges.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#TapChangerInfo" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
