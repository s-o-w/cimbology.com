<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:cimbology="https://cimbology.com/ontology/kg#" xmlns:cim="http://iec.ch/TC57/CIM100#" xmlns:qudt="http://qudt.org/schema/qudt/" xmlns:unit="http://qudt.org/vocab/unit/" xmlns:qkind="http://qudt.org/vocab/quantitykind/" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
  <owl:Ontology rdf:about="https://cimbology.com/ontology/cimbology-kg.ttl">
    <rdfs:comment xml:lang="en">CIMBOLOGY-KG Core Ontology — CIM-grounded knowledge graph extensions for electrical infrastructure. Uses IEC CIM100 types directly.</rdfs:comment>
    <rdfs:label xml:lang="en">CIMBOLOGY-KG Core Ontology</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://iec.ch/TC57/CIM100" />
    <owl:imports rdf:resource="https://cimbology.com/ontology/cim100.ttl" />
    <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1.0.0</owl:versionInfo>
  </owl:Ontology>
  <owl:Class rdf:about="https://cimbology.com/ontology/kg#AnchorGuy">
    <rdfs:comment xml:lang="en">Down-guy and anchor assembly providing lateral support to a distribution pole. Carries guy wire tension, lead distance, and attachment height. CIM has cim:StructureSupport.anchorKind (an enum) but does not model the full guy assembly as a class with engineering properties.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Anchor and Guy</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://iec.ch/TC57/CIM100#StructureSupport" />
  </owl:Class>
  <owl:Class rdf:about="https://cimbology.com/ontology/kg#AuxiliaryContact">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Discrete auxiliary breaker contact (for example 52a/52b) modeled as a first-class circuit node for path tracing.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Auxiliary Contact</rdfs:label>
    <cimbology:equipmentDomain rdf:datatype="http://www.w3.org/2001/XMLSchema#string">electrical</cimbology:equipmentDomain>
  </owl:Class>
  <owl:Class rdf:about="https://cimbology.com/ontology/kg#BusEnd">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">End fitting or termination point of a bus section. Not modeled in CIM (cim:BusbarSection models the bus itself, not its endpoints).</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bus End</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://iec.ch/TC57/CIM100#BusbarSection" />
  </owl:Class>
  <owl:Class rdf:about="https://cimbology.com/ontology/kg#BusExpansion">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Expansion joint or flexible connection in a bus run, allowing thermal expansion. Not modeled in CIM.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bus Expansion</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://cimbology.com/ontology/kg#CableTap">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cable tap or junction point where a cable is tapped for a branch connection. Not modeled in CIM.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cable Tap</rdfs:label>
  </owl:Class>
  <cimbology:RelationKind rdf:about="https://cimbology.com/ontology/kg#Clearance">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Source-to-target clearance relation carrying measured/required distance and governing rule metadata.</rdfs:comment>
  </cimbology:RelationKind>
  <owl:Class rdf:about="https://cimbology.com/ontology/kg#ClearanceCheck">
    <rdfs:comment xml:lang="en">Reusable clearance verification relation between two objects (including NESC Table 232-1 ground, road, building, and crossing checks for distribution spans as well as substation clearance checks). Stores actual clearance, required clearance, violation state, and governing rule citation.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clearance Check</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cimbology.com/ontology/kg#Relation" />
  </owl:Class>
  <rdfs:Class rdf:about="https://cimbology.com/ontology/kg#ClearanceKind">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class" />
  </rdfs:Class>
  <owl:Class rdf:about="https://cimbology.com/ontology/kg#CloseCircuit">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Aggregate circuit object representing the ordered wiring path that closes a breaker. Queryable metadata object, not a physical conductor.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Close Circuit</rdfs:label>
    <cimbology:equipmentDomain rdf:datatype="http://www.w3.org/2001/XMLSchema#string">electrical</cimbology:equipmentDomain>
  </owl:Class>
  <owl:Class rdf:about="https://cimbology.com/ontology/kg#Conductor">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A logical per-phase electrical conductor that runs between two equipment termination points. Has exactly 2 cim:Terminal nodes (sequenceNumber 1 = source, sequenceNumber 2 = destination); phase is on each terminal via cim:Terminal.phases. Physically composed of one or more members typed as cim:BusbarSection (rigid bus, A-frame segments) or cim:ACLineSegment (cable). Members point back via cimbology:memberOfConductorRun. cim:Conductor.length on the cimbology:Conductor itself is NOT stored at emit time; it is the lazy sum of member lengths, computed on demand across the graph. Three cimbology:Conductor instances (one per phase A/B/C) make up a typical 3-phase logical run.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Conductor (Logical Run)</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#Conductor" />
  </owl:Class>
  <owl:Class rdf:about="https://cimbology.com/ontology/kg#Conduit">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Conduit, raceway, or cable tray for routing and protecting cables. CIM models underground duct banks via cim:DuctBank but does not cover above-ground conduit or cable tray.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Conduit</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://iec.ch/TC57/CIM100#DuctBank" />
    <cimbology:equipmentDomain rdf:datatype="http://www.w3.org/2001/XMLSchema#string">structural</cimbology:equipmentDomain>
  </owl:Class>
  <owl:Class rdf:about="https://cimbology.com/ontology/kg#ConduitFitting">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Conduit fitting (elbows, couplings, junction boxes, pull boxes). Not modeled in CIM.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Conduit Fitting</rdfs:label>
    <cimbology:equipmentDomain rdf:datatype="http://www.w3.org/2001/XMLSchema#string">structural</cimbology:equipmentDomain>
  </owl:Class>
  <cimbology:RelationKind rdf:about="https://cimbology.com/ontology/kg#ConnectivityHint">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Low-confidence hint from IFC port topology suggesting two elements are connected.</rdfs:comment>
  </cimbology:RelationKind>
  <cimbology:RelationKind rdf:about="https://cimbology.com/ontology/kg#Containment">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Source contains target (cables in conduits, equipment in bays)</rdfs:comment>
  </cimbology:RelationKind>
  <owl:Class rdf:about="https://cimbology.com/ontology/kg#Crossing">
    <rdfs:comment xml:lang="en">Location where the distribution line crosses a road, railroad, power line, waterway, or other facility requiring specific NESC clearance rules. Not modeled in CIM.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Crossing</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://cimbology.com/ontology/kg#DCSystem">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Station DC control power system (batteries, charger, distribution panels). Provides power for trip/close coils and relays. Not modeled in CIM.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DC System</rdfs:label>
    <cimbology:equipmentDomain rdf:datatype="http://www.w3.org/2001/XMLSchema#string">electrical</cimbology:equipmentDomain>
  </owl:Class>
  <owl:Class rdf:about="https://cimbology.com/ontology/kg#DeadEndStructure">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Termination structure where overhead lines end and transition (e.g., line-to-bus or line-to-cable). A specialized structural type not modeled in CIM.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dead-End Structure</rdfs:label>
    <cimbology:equipmentDomain rdf:datatype="http://www.w3.org/2001/XMLSchema#string">structural</cimbology:equipmentDomain>
  </owl:Class>
  <owl:Class rdf:about="https://cimbology.com/ontology/kg#DistributionCriteria">
    <rdfs:comment xml:lang="en">NESC Section 23 design basis for a distribution line. Captures loading district, construction grade, overload factors, and environmental assumptions. CIM models as-built operational parameters, not design inputs — this class fills that gap.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Distribution Criteria</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://cimbology.com/ontology/kg#DistributionLine">
    <rdfs:comment xml:lang="en">Root container for a distribution line or circuit. CIM's cim:Line is abstract and covers both transmission and distribution; this class anchors distribution-specific design data (criteria, spans, pole loading) that cim:Line cannot express.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Distribution Line</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://iec.ch/TC57/CIM100#Line" />
  </owl:Class>
  <cimbology:ClearanceKind rdf:about="https://cimbology.com/ontology/kg#ElectricalClearance">
    <rdfs:comment xml:lang="en">Clearance driven by electrical insulation/separation requirements.</rdfs:comment>
  </cimbology:ClearanceKind>
  <cimbology:RelationKind rdf:about="https://cimbology.com/ontology/kg#ElectricalProximityHint">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Low-confidence hint from spatial proximity analysis suggesting electrical adjacency.</rdfs:comment>
  </cimbology:RelationKind>
  <owl:Class rdf:about="https://cimbology.com/ontology/kg#EquipmentBank">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A coordinated set of per-phase equipment (typically 3 members - one per phase) installed and managed as a single logical asset. Examples: 3 CTs monitoring a breaker, 3 CCVTs at a line entrance, 3 PTs at a bus section, 3 surge arresters protecting a transformer side. Subclassing cim:EquipmentContainer aligns the concept with CIM containment semantics; however, equipment links to its bank via cimbology:memberOfBank rather than cim:Equipment.EquipmentContainer (which remains reserved for the Substation/VoltageLevel/Bay containment chain). A bank node has UUID identity; its rdfs:label is optional and human-friendly only.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Equipment Bank</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#EquipmentContainer" />
  </owl:Class>
  <owl:Class rdf:about="https://cimbology.com/ontology/kg#Fence">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Perimeter fencing around a substation (chain-link fabric, pipe rails, masonry walls, gates). Every substation has a security fence but CIM does not model it — cim:AssetContainer mentions 'fences' only as an example of aggregated assets with no dedicated class.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fence</rdfs:label>
    <cimbology:equipmentDomain rdf:datatype="http://www.w3.org/2001/XMLSchema#string">structural</cimbology:equipmentDomain>
  </owl:Class>
  <owl:Class rdf:about="https://cimbology.com/ontology/kg#Fitting">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Conductor fitting or hardware (splices, clamps, connectors, terminations). Used for physical conductor accessories not modeled in CIM.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fitting</rdfs:label>
    <cimbology:equipmentDomain rdf:datatype="http://www.w3.org/2001/XMLSchema#string">structural</cimbology:equipmentDomain>
  </owl:Class>
  <owl:Class rdf:about="https://cimbology.com/ontology/kg#Foundation">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Concrete foundation for substation equipment (transformer pads, switch bases, etc.). Not modeled in CIM.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Foundation</rdfs:label>
    <cimbology:equipmentDomain rdf:datatype="http://www.w3.org/2001/XMLSchema#string">structural</cimbology:equipmentDomain>
  </owl:Class>
  <owl:Class rdf:about="https://cimbology.com/ontology/kg#Framing">
    <rdfs:comment xml:lang="en">Pole-top configuration defining crossarm type, phase arrangement, and attachment geometry. Distribution poles carry framing as a first-class concept (horizontal, vertical, triangular, wishbone, etc.) whereas transmission structures define attachment implicitly via geometry. Not modeled in CIM.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Framing</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://cimbology.com/ontology/kg#GenericEquipment">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Catch-all type for equipment that does not map to any specific CIM or CIMBOLOGY-KG type. Used as a fallback when type mapping produces no match.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Generic Equipment</rdfs:label>
    <cimbology:equipmentDomain rdf:datatype="http://www.w3.org/2001/XMLSchema#string">structural</cimbology:equipmentDomain>
  </owl:Class>
  <cimbology:ClearanceKind rdf:about="https://cimbology.com/ontology/kg#GroundOrCrossing">
    <rdfs:comment xml:lang="en">Clearance driven by ground/crossing rulebooks such as NESC crossing tables.</rdfs:comment>
  </cimbology:ClearanceKind>
  <owl:Class rdf:about="https://cimbology.com/ontology/kg#GroundingSystem">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physical grounding infrastructure (ground rods, ground grid, ground wells, grounding conductors). Distinct from CIM's cim:Ground which is an abstract electrical connection to earth in the network model.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Grounding System</rdfs:label>
    <cimbology:equipmentDomain rdf:datatype="http://www.w3.org/2001/XMLSchema#string">structural</cimbology:equipmentDomain>
  </owl:Class>
  <owl:Class rdf:about="https://cimbology.com/ontology/kg#GuyingResult">
    <rdfs:comment xml:lang="en">Per-guy analysis result from pole loading / guying calculations. Captures the computed tension, lead distance adequacy, and strength factor for an individual guy wire. Separating guy-level results from pole-level results (cimbology:PoleLoadResult) allows violation queries at each guy independently.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Guying Result</rdfs:label>
  </owl:Class>
  <cimbology:RelationKind rdf:about="https://cimbology.com/ontology/kg#HousedIn">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Links equipment (relays, panels, batteries) to the cim:Structure that physically contains it.</rdfs:comment>
  </cimbology:RelationKind>
  <owl:Class rdf:about="https://cimbology.com/ontology/kg#Insulator">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Electrical insulator (post, suspension, pin, etc.) providing mechanical support and electrical isolation. CIM does not define an insulator class; it models insulation as properties on other equipment.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Insulator</rdfs:label>
    <cimbology:equipmentDomain rdf:datatype="http://www.w3.org/2001/XMLSchema#string">structural</cimbology:equipmentDomain>
  </owl:Class>
  <owl:Class rdf:about="https://cimbology.com/ontology/kg#InsulatorBracket">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mounting bracket or hardware for attaching an insulator to a support structure. Not modeled in CIM.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Insulator Bracket</rdfs:label>
    <cimbology:equipmentDomain rdf:datatype="http://www.w3.org/2001/XMLSchema#string">structural</cimbology:equipmentDomain>
  </owl:Class>
  <rdfs:Class rdf:about="https://cimbology.com/ontology/kg#LinearGeometry">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ordered sequence of 3D points defining a path for cables, conduits, etc.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Linear Geometry</rdfs:label>
  </rdfs:Class>
  <owl:Class rdf:about="https://cimbology.com/ontology/kg#LoadCase">
    <rdfs:comment xml:lang="en">Temperature, wind, and ice loading combination for design analysis. Defines the environmental conditions under which sag-tension and clearance are evaluated. Distinct from CIM's cim:LoadGroup which models operational demand.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Load Case</rdfs:label>
  </owl:Class>
  <cimbology:ClearanceKind rdf:about="https://cimbology.com/ontology/kg#MaintenanceAccess">
    <rdfs:comment xml:lang="en">Clearance driven by maintenance access and removal path requirements.</rdfs:comment>
  </cimbology:ClearanceKind>
  <cimbology:RelationKind rdf:about="https://cimbology.com/ontology/kg#ParentChild">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Source is parent of target (assembly hierarchy)</rdfs:comment>
  </cimbology:RelationKind>
  <cimbology:RelationKind rdf:about="https://cimbology.com/ontology/kg#PhysicalConnection">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Source connects to target (terminal-to-terminal wiring)</rdfs:comment>
  </cimbology:RelationKind>
  <rdfs:Class rdf:about="https://cimbology.com/ontology/kg#PointGeometry">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Single 3D coordinate for connection points and attachment locations.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Point Geometry</rdfs:label>
  </rdfs:Class>
  <owl:Class rdf:about="https://cimbology.com/ontology/kg#PoleLoadResult">
    <rdfs:comment xml:lang="en">Pole loading analysis result expressing applied ground-line moment as a percentage of the pole's rated capacity. First-class in distribution design — every pole must pass a loading check. Transmission uses structure-level analysis instead.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pole Load Result</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://cimbology.com/ontology/kg#PrimarySpan">
    <rdfs:comment xml:lang="en">Physical span of primary conductor between two adjacent distribution poles. The unit for sag-tension analysis. Distinct from cim:ACLineSegment which models the electrical segment, not the physical catenary.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Primary Span</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://iec.ch/TC57/CIM100#ACLineSegment" />
  </owl:Class>
  <cimbology:RelationKind rdf:about="https://cimbology.com/ontology/kg#ProtectionAssignment">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Links a protection relay (cim:ProtectionEquipment) to the breaker it protects.</rdfs:comment>
  </cimbology:RelationKind>
  <rdfs:Class rdf:about="https://cimbology.com/ontology/kg#Relation">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Generic relation between CIMBOLOGY-KG objects. Requires relationKind.</rdfs:comment>
  </rdfs:Class>
  <rdfs:Class rdf:about="https://cimbology.com/ontology/kg#RelationKind">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class" />
  </rdfs:Class>
  <cimbology:RelationKind rdf:about="https://cimbology.com/ontology/kg#Replacement">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Source node replaces target node. Source should have changeAction=add, target should have changeAction=remove. Tools should transfer correlation data from target to source.</rdfs:comment>
  </cimbology:RelationKind>
  <owl:Class rdf:about="https://cimbology.com/ontology/kg#SagTensionResult">
    <rdfs:comment xml:lang="en">Read-only solver output for a distribution span under a specific load case. Same concept as transmission sag-tension but applied to distribution spans with typically shorter spans and lighter conductors.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sag Tension Result</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://cimbology.com/ontology/kg#ServicePoint">
    <rdfs:comment xml:lang="en">Customer service delivery point where the utility's distribution system connects to the customer's premises. Carries load data (demand, connected load) for voltage drop and transformer sizing. Not modeled in CIM's network topology.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Service Point</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://cimbology.com/ontology/kg#ServiceSpan">
    <rdfs:comment xml:lang="en">Span of secondary or service-drop conductor from a distribution pole or transformer to a service point. Distribution has distinct primary, secondary, and service conductor categories that transmission does not need.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Service Span</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://cimbology.com/ontology/kg#SupportStructure">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Steel structure supporting equipment in a substation (A-frames, columns, bus support stands). CIM models structures via cim:Structure (Pole, Tower) but does not cover substation-specific steel support.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Support Structure</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://iec.ch/TC57/CIM100#Structure" />
    <cimbology:equipmentDomain rdf:datatype="http://www.w3.org/2001/XMLSchema#string">structural</cimbology:equipmentDomain>
  </owl:Class>
  <owl:Class rdf:about="https://cimbology.com/ontology/kg#TerminalConnector">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physical terminal connector hardware (lugs, bolted connectors, compression connectors). Distinct from CIM's cim:Terminal which is an abstract electrical connection point in the network model.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Terminal Connector</rdfs:label>
  </owl:Class>
  <rdfs:Class rdf:about="https://cimbology.com/ontology/kg#Transform">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">4x4 transformation matrix for equipment placement. Serialized as flat 16-float array.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Transform</rdfs:label>
  </rdfs:Class>
  <owl:Class rdf:about="https://cimbology.com/ontology/kg#TripCircuit">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Aggregate circuit object representing the ordered wiring path that trips a breaker. Queryable metadata object, not a physical conductor.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Trip Circuit</rdfs:label>
    <cimbology:equipmentDomain rdf:datatype="http://www.w3.org/2001/XMLSchema#string">electrical</cimbology:equipmentDomain>
  </owl:Class>
  <owl:Class rdf:about="https://cimbology.com/ontology/kg#VoltageDropResult">
    <rdfs:comment xml:lang="en">Voltage drop analysis result for a distribution circuit section. Any distribution design tool must exchange voltage drop and flicker percentages to verify ANSI C84.1 service voltage limits. Not modeled in CIM (CIM tracks operational voltage, not design-stage voltage drop analysis).</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Voltage Drop Result</rdfs:label>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#aboveGroundHeight">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment xml:lang="en">Pole height above ground in meters (poleHeight minus settingDepth). CIM equivalent: cim:Structure.height (IEC61968 AssetInfo) — 'Visible height of structure above ground level for overhead construction (e.g., Pole or Tower).' cim:Pole is a subclass of cim:Structure, so this field applies directly.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Above Ground Height</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
    <rdfs:seeAlso rdf:resource="http://iec.ch/TC57/CIM100#Structure" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#acResistance">
    <rdfs:comment xml:lang="en">AC resistance at operating temperature in ohms per kilometer. Applies to distribution overhead conductors and HV cables alike. CIM equivalent: cim:WireInfo.rAC50 (IEC61968 AssetInfo) — resistance per unit length at 50°C. CIMBOLOGY-KG uses ohms/km to match ASTM B232 and conductor manufacturer data sheets; CIM uses ohms/meter.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AC Resistance</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
    <rdfs:seeAlso rdf:resource="http://iec.ch/TC57/CIM100#WireInfo" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#actualDemandKvar">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KILO-VAR" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/ReactivePower" />
    <rdfs:comment xml:lang="en">Measured or actual reactive demand in kilovar at the service point. Any distribution planning tool exchanging load-study inputs needs a separate reactive-demand slot.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ServicePoint" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Actual Demand kVAR</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#actualDemandKw">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloW" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Power" />
    <rdfs:comment xml:lang="en">Measured or actual service demand in kilowatts. Distinct from cimbology:demandKw, which is a design estimate derived from connected load and diversity.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ServicePoint" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Actual Demand</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#ambientTemp">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/DEG_C" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Temperature" />
    <rdfs:comment xml:lang="en">Ambient temperature for NESC combined loading in degrees Celsius. NESC §250B specifies -18°C for Heavy/Medium, -1°C for Light.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ambient Temperature</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#ampacity">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/A" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/ElectricCurrent" />
    <rdfs:comment xml:lang="en">Continuous thermal current rating in amperes. Applies to distribution conductors, HV cables, and substation buswork — any current-carrying conductor in any domain has an ampacity limit. Source: IEEE 738 and conductor manufacturer data.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ampacity</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
    <rdfs:seeAlso rdf:resource="http://iec.ch/TC57/CIM100#WireInfo" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#anchorCapacity">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/N" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Force" />
    <rdfs:comment xml:lang="en">Holding capacity of the anchor in newtons based on soil class.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#AnchorGuy" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Anchor Capacity</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#anchorIsDouble">
    <rdfs:comment xml:lang="en">True if the anchor consists of two anchor rods or plates (double anchor) providing roughly double the single-anchor holding capacity. Affects anchor adequacy check in pole loading analysis.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#AnchorGuy" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Is Double Anchor</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#anchorMaxTension">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/N" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Force" />
    <rdfs:comment xml:lang="en">Maximum rated pullout tension for this anchor assembly in newtons — the manufacturer's catalog capacity at standard soil class. Distinct from cimbology:anchorCapacity (domain: cimbology:GuyingResult) which is the computed soil-specific holding capacity for a specific installation.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#AnchorGuy" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Anchor Max Tension</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#anchorStrengthFactor">
    <rdfs:comment xml:lang="en">Strength factor for the anchor — ratio of anchor holding capacity to applied guy tension. Values below 1.0 indicate the anchor is inadequate.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#GuyingResult" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Anchor Strength Factor</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#anchorType">
    <rdfs:comment xml:lang="en">Anchor type (e.g., 'expanding', 'screw', 'plate', 'rock', 'swamp', 'log', 'cone', 'rail anchor', 'hinged tie bar', 'traction strut').</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#AnchorGuy" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Anchor Type</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#ansiDeviceNumber">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ANSI/IEEE device function number(s) (e.g., '50/51', '79', '86', '25'). Used by substation protection relays and distribution recloser/relay controllers. Multiple functions separated by '/'.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ANSI Device Number</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#applyWireDiversity">
    <rdfs:comment xml:lang="en">Whether to apply load diversity factors to wire voltage drop calculations. Typical default: true.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Apply Wire Diversity</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#applyXmfrDiversity">
    <rdfs:comment xml:lang="en">Whether to apply load diversity factors to transformer voltage drop calculations. Typical default: true.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Apply Xmfr Diversity</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#area">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M2" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Area" />
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Surface area or footprint area of the equipment in square meters.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Area</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#arresterMounting">
    <rdfs:comment xml:lang="en">Lightning arrester mounting method (e.g., 'Crossarm mounted', 'Bracket mounted').</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Arrester Mounting</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#assetTag">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Utility/owner-assigned asset tracking identifier.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asset Tag</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#attachmentHeight">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment xml:lang="en">Height of conductor attachment point above ground in meters.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Attachment Height</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#avgHeight">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment xml:lang="en">Average conductor height above ground across the span in meters.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#SagTensionResult" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Average Height</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#avgTension">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/N" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Force" />
    <rdfs:comment xml:lang="en">Average conductor tension across the span in newtons.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#SagTensionResult" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Average Tension</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#bayId">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Identifier of the bay containing this equipment.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bay ID</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#bayNumber">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1-based bay number within the voltage level. CIM models Bay as an EquipmentContainer but does not define an ordering property. This CIMBOLOGY-KG extension provides explicit bay sequencing for layout tools, SLD generators, and 3D renderers.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bay Number</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#bearing">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/DEG" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Angle" />
    <rdfs:comment xml:lang="en">Bearing of the line at this pole in degrees from true north (0–360).</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bearing</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#bendRadius">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Minimum bend radius at the conductor centerline. Not applicable for sagging or catenary conductors.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bend Radius</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#bil">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloV" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Voltage" />
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Basic Insulation Level (BIL) in kV. Applies to both substation and distribution equipment — transformers, capacitors, surge arresters, and switches at any voltage class.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BIL</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#breakerType">
    <rdfs:comment xml:lang="en">Functional breaker application string (for example 'feeder', 'tie', 'sectionalizing', 'main'). Distribution tools use this to distinguish system role even when all devices are cim:Breaker. Related CIM field: cim:AssetDeployment.breakerApplication.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Breaker Type</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <rdfs:seeAlso rdf:resource="http://iec.ch/TC57/CIM100#AssetDeployment" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#breakingCapacity">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloAMP" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/ElectricCurrent" />
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fault interrupting capacity in kA. Supplementary convenience alias of cim:ProtectedSwitch.breakingCapacity for compatibility with tools that still query CIMBOLOGY-KG namespace properties.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Breaking Capacity</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#buildingArea">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M2" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Area" />
    <rdfs:comment xml:lang="en">Building floor area in square meters. Used for VA/m² load density calculations. Imperial equivalent: sq ft (typical default: ~232 m² / 2500 sq ft).</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ServicePoint" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Building Area</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#busbarCrossSectionArea">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MM2" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Area" />
    <rdfs:comment xml:lang="en">Bus bar cross-sectional area in square millimeters. Needed for current-density and thermal-rise calculations on bus work. CIM BusbarSectionInfo carries rated electrical values but not physical section area.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bus Bar Cross Section Area</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#busbarMaterial">
    <rdfs:comment xml:lang="en">Bus bar conductor material (for example 'copper' or 'aluminum'). CIM BusbarSection models the conducting equipment but not the physical bar material needed for catalog and thermal checks.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bus Bar Material</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#cableRef">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reference to the cable URN associated with a connection relation.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cable Reference</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#cableSpec">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cable specification string for protection/control runs (for example '4/C #10' or '12/C #10').</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cable Spec</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#capacitorControl">
    <rdfs:comment xml:lang="en">Capacitor switching control type per IEEE 1036 (e.g., 'Fixed', 'Switched-Voltage', 'Switched-VAR', 'Switched-Time'). CIM models this via cim:RegulatingControl.mode. CIMBOLOGY-KG uses a string to accommodate vendor-specific control algorithms.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Capacitor Control</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <rdfs:seeAlso rdf:resource="http://iec.ch/TC57/CIM100#ShuntCompensator" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#capacitorKvar">
    <rdfs:comment xml:lang="en">Capacitor bank reactive power rating in kVAR per IEEE 1036-2020. CIM models this as cim:ShuntCompensator.nomQ (in VAR). CIMBOLOGY-KG uses kVAR because capacitor banks are universally specified in kVAR whether in distribution (300, 600, 900, 1200) or substation (power factor correction) contexts.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Capacitor kVAR</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
    <rdfs:seeAlso rdf:resource="http://iec.ch/TC57/CIM100#ShuntCompensator" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#capacitorUnitKvar">
    <rdfs:comment xml:lang="en">Individual capacitor unit rating in kVAR. Used in both distribution banks (standard sizes: 50, 100, 150, 200, 300) and substation power factor correction assemblies.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Capacitor Unit kVAR</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
    <rdfs:seeAlso rdf:resource="http://iec.ch/TC57/CIM100#ShuntCompensator" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#catalogItemId">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Standard catalog item identifier preserved through round-trips for cross-tool catalog traceability. Tool-specific catalog provenance belongs in tool-prefixed properties (e.g. revit:familyName); cimbology:catalogItemId is the canonical, tool-agnostic identifier.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Catalog Item ID</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#catalogModel">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Catalog model identifier used for matching equipment to tool-specific catalog entries.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Catalog Model</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#catalogName">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Catalog or library name where the equipment definition is stored.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Catalog Name</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#catenaryConstant">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment xml:lang="en">Catenary constant H/w in meters (horizontal tension divided by weight per unit length).</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Catenary Constant</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#changeAction">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Node lifecycle status relative to prior file revision. Values: none (default/unchanged), add (new), modify (properties changed), remove (tombstone — kept so tools can detect deletions). Absent = none.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Change Action</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://cimbology.com/ontology/kg#circuitMembers">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ordered list of cimbology:Relation URNs that compose a functional circuit path.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Circuit Members</rdfs:label>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#circuitRole">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Functional circuit role for a wiring relation or cable (for example trip, close, ct, dc-power, status, alarm).</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Circuit Role</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#classificationDisagreement">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Classification disagreement payload as JSON array of tier/code/rawSignal objects.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Classification Disagreement</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#classificationProvenance">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Classification winner provenance payload as JSON object: tier, rule, confidence, rawSignal.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Classification Provenance</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#clearance">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment xml:lang="en">Actual measured or computed clearance distance in meters at the governing point for the evaluated source-to-target pair (including distribution span NESC checks).</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ClearanceCheck" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clearance</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://cimbology.com/ontology/kg#clearanceKind">
    <rdfs:comment xml:lang="en">Classifies the driver for this clearance check (electrical, maintenance access, or ground/crossing).</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ClearanceCheck" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clearance Kind</rdfs:label>
    <rdfs:range rdf:resource="https://cimbology.com/ontology/kg#ClearanceKind" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#clearanceRule">
    <rdfs:comment xml:lang="en">Citation or identifier for the governing clearance rule used by this check (e.g., 'Table 232-1, Row 3 — Roads').</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ClearanceCheck" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clearance Rule</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#clearanceViolated">
    <rdfs:comment xml:lang="en">True when actual clearance is below the required clearance threshold.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ClearanceCheck" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clearance Violated</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#commissioningDate">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Date the equipment was energized and placed into service.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Commissioning Date</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#conditionPct">
    <rdfs:comment xml:lang="en">Remaining strength as a percentage (0–100) based on field inspection (bore test, ultrasound, or visual). Applied as a multiplier to ground-line moment capacity.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Condition Percent</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#conductorConstruction">
    <rdfs:comment xml:lang="en">Physical installation method for the conductor (e.g., 'full tension', 'slack', 'in conduit', 'direct buried', 'in conduit jacketed', 'direct buried jacketed', 'full tension twisted', 'slack twisted'). Applies to distribution overhead and underground conductors AND substation power cables routed through conduit, cable trench, or direct-buried duct bank. Determines sag behavior, pulling tension applicability, and construction constraints. Not modeled in CIM.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Conductor Construction</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#conductorCount">
    <rdfs:comment xml:lang="en">Number of conductors or cores represented by this cable specification. Required for triplex, quadruplex, and multi-core underground cable designs where one cim:ACLineSegment carries a multi-conductor assembly.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Conductor Count</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#conductorCurrentValue">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/A" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/ElectricCurrent" />
    <rdfs:comment xml:lang="en">Per-conductor current value in amperes captured by the voltage-drop solver. Needed to exchange conductor-by-conductor loading alongside the voltage-drop percentages.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#VoltageDropResult" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Conductor Current Value</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#conductorLength">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Total length of a conductor instance, in meters.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Conductor Length</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#conductorLengthSpan">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment xml:lang="en">Actual conductor length in the span in meters (longer than horizontal span due to sag).</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Conductor Length In Span</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#conductorMaterial">
    <rdfs:comment xml:lang="en">Conductor material designation (e.g., 'Aluminum', 'Copper', 'fiber', 'aluminum conductor steel reinforced', 'hard drawn copper', 'soft drawn copper', 'stranded copper'). Applies to distribution overhead conductors, substation bus conductors, and control cables — any current-carrying conductor in any domain has a material. CIM models this via cim:WireInfo.material using the WireMaterialKind enum. CIMBOLOGY-KG uses a flat string because design tools use material names more granular than the CIM enum (e.g., 'hard drawn copper' vs 'soft drawn copper' are sub-classifications CIM does not distinguish). Tool lens toolValueMap entries should map tool strings toward cim:WireMaterialKind values where a match exists.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Conductor Material</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <rdfs:seeAlso rdf:resource="http://iec.ch/TC57/CIM100#WireInfo" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#conductorMaxTension">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/N" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Force" />
    <rdfs:comment xml:lang="en">Maximum rated tension for this conductor specification in newtons — the tension the conductor manufacturer warrants without mechanical damage. A catalog property on the conductor model. Distinct from cimbology:maxTension (domain: cimbology:SagTensionResult) which is the computed tension in a specific span under a specific load case.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Conductor Max Tension</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#conductorMoment">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/N-M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Torque" />
    <rdfs:comment xml:lang="en">Ground-line moment contribution from conductor tension and wind on conductors in newton-meters.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#PoleLoadResult" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Conductor Moment</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#conductorRole">
    <rdfs:comment xml:lang="en">Functional role of the conductor (e.g., 'primary', 'secondary', 'neutral', 'service', 'street light', 'feeder', 'transmission', 'control', 'connection', 'internal'). Required to differentiate conductors sharing the same CIM type (cim:ACLineSegment).</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Conductor Role</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#conductorSizeAwg">
    <rdfs:comment xml:lang="en">Wire size in AWG or kcmil (e.g., '#2', '1/0', '336.4'). String because AWG uses non-numeric notation. Applies to distribution overhead conductors, substation control wiring, power cables, and grounding conductors — AWG/kcmil notation is used across all electric utility domains. CIM equivalent: cim:WireInfo.sizeDescription (IEC61968 AssetInfo) — 'Describes the wire gauge or cross section (e.g., 4/0, #2, 336.5).' CIMBOLOGY-KG keeps it flat (see decision D1) for round-trip fidelity with design tools.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Conductor Size</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <rdfs:seeAlso rdf:resource="http://iec.ch/TC57/CIM100#WireInfo" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#conductorType">
    <rdfs:comment xml:lang="en">Conductor specification/model string (e.g., '#2 ACSR', '1/0 AAC', '336.4 ACSR', '4/0 Triplex'). This is the wire designation, NOT the functional role (use cimbology:conductorRole for primary/neutral/service).</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Conductor Type</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#connectedLoadKw">
    <rdfs:comment xml:lang="en">Total connected load at the service point in kilowatts. Used for voltage drop analysis and transformer sizing. CIM models loads via cim:EnergyConsumer but focuses on operational metered load, not connected load for design sizing.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ServicePoint" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Connected Load</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#constructionGrade">
    <rdfs:comment xml:lang="en">NESC construction grade (A, B, or C per NESC §24). Grade B is most common for distribution; Grade A for crossings. Determines overload and strength factors.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Construction Grade</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#contactDesignation">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Auxiliary contact designation such as 52a or 52b.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Contact Designation</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#cookingDemandFactor">
    <rdfs:comment xml:lang="en">Demand factor for cooking loads (0–1). Typical default: 0.4.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ServicePoint" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cooking Demand Factor</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#cookingLoad1ph">
    <rdfs:comment xml:lang="en">Single-phase connected cooking load in kW. Typical default: 0.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ServicePoint" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cooking Load 1PH</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#cookingLoad3ph">
    <rdfs:comment xml:lang="en">Three-phase connected cooking load in kW. Typical default: 0.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ServicePoint" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cooking Load 3PH</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#cookingOprDaysPerMon">
    <rdfs:comment xml:lang="en">Cooking equipment operating days per month. Typical default: 21.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ServicePoint" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cooking Opr Days/Month</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#cookingPctOprHours">
    <rdfs:comment xml:lang="en">Fraction of daily operating hours cooking equipment runs (0–1). Typical default: 0.5.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ServicePoint" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cooking % Opr Hours</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#coolingDemandFactor">
    <rdfs:comment xml:lang="en">Demand factor for cooling loads (0–1). Typical default: 0.8.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ServicePoint" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cooling Demand Factor</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#coolingLoad1ph">
    <rdfs:comment xml:lang="en">Single-phase connected cooling load in kW. Typical default: 0.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ServicePoint" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cooling Load 1PH</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#coolingLoad3ph">
    <rdfs:comment xml:lang="en">Three-phase connected cooling load in kW. Typical default: 0.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ServicePoint" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cooling Load 3PH</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#coolingOprDaysPerMon">
    <rdfs:comment xml:lang="en">Cooling equipment operating days per month. Typical default: 21.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ServicePoint" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cooling Opr Days/Month</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#coolingPctOprHours">
    <rdfs:comment xml:lang="en">Fraction of daily operating hours cooling equipment runs (0–1). Typical default: 0.5.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ServicePoint" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cooling % Opr Hours</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#coreCount">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Number of conductors/cores in a cable run.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Core Count</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#created">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#crossSectionArea">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M2" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Area" />
    <rdfs:comment xml:lang="en">Total conductor cross-sectional area in square meters (sum of all strands). Used for current density checks and weight-per-length derivation. Applies to distribution overhead conductors, substation bus conductors, and power cables. Distinct from cimbology:busbarCrossSectionArea which covers flat/rectangular buswork. Source: ASTM B232 conductor data.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cross Section Area</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#crossarmLength">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment xml:lang="en">Crossarm length in meters. Determines phase spacing for horizontal and triangular configurations.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#Framing" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Crossarm Length</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#crossarmType">
    <rdfs:comment xml:lang="en">Crossarm material and style (e.g., 'Wood 8ft', 'Fiberglass 8ft', 'Steel'). Determines load-bearing capacity and material cost.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#Framing" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Crossarm Type</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#crossingClearance">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment xml:lang="en">Actual clearance at the crossing point in meters.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#Crossing" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Crossing Clearance</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#crossingElevation">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment xml:lang="en">Elevation of the crossed facility at the crossing point in meters above datum.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#Crossing" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Crossing Elevation</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#crossingRequired">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment xml:lang="en">Required clearance at the crossing per NESC in meters.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#Crossing" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Crossing Required Clearance</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#crossingType">
    <rdfs:comment xml:lang="en">Type of crossing (e.g., 'Road', 'Railroad', 'PowerLine', 'CommunicationLine', 'Waterway', 'Pipeline').</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#Crossing" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Crossing Type</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#ctBurden">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/V-A" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/ApparentPower" />
    <rdfs:comment xml:lang="en">Current transformer burden rating in volt-amperes. Needed for instrument-transformer selection and meter/relay loading checks. CIM equivalent if any: cim:CurrentTransformer.coreBurden.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CT Burden</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
    <rdfs:seeAlso rdf:resource="http://iec.ch/TC57/CIM100#CurrentTransformer" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#ctRatio">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Legacy current-transformer ratio string (e.g., '2000:5' for substation, '400:5' for distribution metering/recloser protection). For structured ratio metadata such as accuracy class, ratio components, and core count, use cim:CurrentTransformerInfo from the IEC 61968 informative AssetInfo package alongside this string when needed.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CT Ratio</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#currentRating">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/A" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/ElectricCurrent" />
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rated continuous current in amperes. Supplementary convenience alias of cim:Switch.ratedCurrent for compatibility with tools that still query CIMBOLOGY-KG namespace properties.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Current Rating</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#dcResistance">
    <rdfs:comment xml:lang="en">DC resistance at 20°C in ohms per kilometer. Companion to cimbology:acResistance for conductors where AC and DC values differ (large ACSR, bundled conductors, HV cable). Source: ASTM B232 conductor data sheets.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DC Resistance</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
    <rdfs:seeAlso rdf:resource="http://iec.ch/TC57/CIM100#WireInfo" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#dcVoltage">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/V" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Voltage" />
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nominal DC control voltage in volts (e.g. 125, 250).</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DCSystem" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DC Voltage</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#defaultHouseHeight">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment xml:lang="en">Assumed building height in meters for conductor-to-structure clearance checks when building height data is unavailable. Typical default: 16.4 ft = 5.0 m.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Default House Height</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#demandFactor">
    <rdfs:comment xml:lang="en">Demand factor (0–1) applied to connected load to estimate peak demand. Distribution design uses demand factors to avoid oversizing transformers and service conductors. Typical residential: 0.4–0.6; commercial: varies by load category.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ServicePoint" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Demand Factor</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#demandKw">
    <rdfs:comment xml:lang="en">Peak demand at the service point in kilowatts (connectedLoadKw × demandFactor). Used for transformer sizing and voltage drop analysis.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ServicePoint" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Peak Demand</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#depth">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bounding-box depth of the equipment in metres (Y-axis).</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Depth</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#description">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Human-readable description. Equivalent to cim:IdentifiedObject.description but usable on any CIMBOLOGY-KG object.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Description</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <owl:equivalentProperty rdf:resource="http://iec.ch/TC57/CIM100#IdentifiedObject.description" />
    <cimbology:firstClassProperty rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</cimbology:firstClassProperty>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#directCatalogItem">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fully resolved tool-native catalog item identifier. When present, a catalog resolver may bypass lens-driven catalog query construction and return this value directly. Use when the producing tool already knows the exact catalog row (e.g. user selected from a picker) and round-tripping through canonical CIM properties would risk precision loss.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Direct Catalog Item</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#dispositionStatus">
    <rdfs:comment xml:lang="en">Asset lifecycle status (e.g., 'install', 'existing', 'removal', 'modified', 'future', 'data correction', 'abandon'). Cross-domain — any GIS, asset management, or design tool (distribution, substation, comms) needs to exchange brownfield lifecycle state.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Disposition Status</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#elevatorsDemandFactor">
    <rdfs:comment xml:lang="en">Demand factor for elevator loads (0–1). Typical default: 0.3.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ServicePoint" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Elevators Demand Factor</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#elevatorsLoad1ph">
    <rdfs:comment xml:lang="en">Single-phase connected elevator load in kW. Typical default: 0.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ServicePoint" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Elevators Load 1PH</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#elevatorsLoad3ph">
    <rdfs:comment xml:lang="en">Three-phase connected elevator load in kW. Typical default: 0.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ServicePoint" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Elevators Load 3PH</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#elevatorsOprDaysPerMon">
    <rdfs:comment xml:lang="en">Elevator operating days per month. Typical default: 21.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ServicePoint" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Elevators Opr Days/Month</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#elevatorsPctOprHours">
    <rdfs:comment xml:lang="en">Fraction of daily operating hours elevators run (0–1). Typical default: 0.25.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ServicePoint" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Elevators % Opr Hours</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#endHeight">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment xml:lang="en">Conductor attachment height at the end (ahead) pole in meters above ground.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#SagTensionResult" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">End Height</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#endHorizontalLoad">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/N" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Force" />
    <rdfs:comment xml:lang="en">Horizontal load component at the end support in newtons.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#SagTensionResult" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">End Horizontal Load</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#endTension">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/N" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Force" />
    <rdfs:comment xml:lang="en">Conductor tension at the end (ahead) support point in newtons.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#SagTensionResult" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">End Tension</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#endVerticalLoad">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/N" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Force" />
    <rdfs:comment xml:lang="en">Vertical load component at the end support in newtons.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#SagTensionResult" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">End Vertical Load</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:AnnotationProperty rdf:about="https://cimbology.com/ontology/kg#equipmentDomain">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Industry domain classification for this equipment type (e.g., 'structural', 'electrical'). Used for domain-specific filtering. Types without this annotation are assumed to be domain equipment from the loaded type library (e.g., IEC CIM).</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Equipment Domain</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:AnnotationProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#equipmentMoment">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/N-M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Torque" />
    <rdfs:comment xml:lang="en">Ground-line moment contribution from pole-mounted equipment (transformers, switches, etc.) in newton-meters.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#PoleLoadResult" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Equipment Moment</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#equipmentWeight">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/N" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Force" />
    <rdfs:comment xml:lang="en">Weight of pole-mounted equipment in newtons. Contributes to vertical pole loading.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Equipment Weight</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#estimatedDemand">
    <rdfs:comment xml:lang="en">Directly entered estimated peak demand in kilowatts. Override for computed demand when actual metered or contracted data is available. Typical default: 0.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ServicePoint" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Estimated Demand</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#excavationDepth">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment xml:lang="en">Assumed excavation depth in meters for underground clearance checks. Typical default: 0.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Excavation Depth</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#excludeFinalBend">
    <rdfs:comment xml:lang="en">Whether to exclude the final bend from the pulling tension calculation. Typical default: false.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Exclude Final Bend</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#existingFamily">
    <rdfs:comment xml:lang="en">Existing pole family or catalog designation from the utility's asset system. Used for brownfield uprate design.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Existing Family</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <rdf:Property rdf:about="https://cimbology.com/ontology/kg#fallbackSymbol">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The symbol or family to use if no exact catalog match is found.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fallback Symbol</rdfs:label>
  </rdf:Property>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#faultCurrent">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/A" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/ElectricCurrent" />
    <rdfs:comment xml:lang="en">Available fault current in amperes. Used in distribution voltage-drop studies (service point fault level) and substation protection coordination (bus fault current). No rdfs:domain declared to allow use across distribution and substation contexts.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fault Current</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#feederLine">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Feeder or line identifier associated with this equipment.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Feeder Line</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#fileRevision">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Monotonically increasing revision number, incremented on each persisted revision.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">File Revision</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer" />
  </owl:DatatypeProperty>
  <owl:AnnotationProperty rdf:about="https://cimbology.com/ontology/kg#firstClassProperty">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If true, this property is handled as a first-class structural field during serialization rather than as a generic extension property. Serializers can query this annotation from the ontology graph to discover structural properties dynamically.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">First-Class Property</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </owl:AnnotationProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#flickerPowerFactor">
    <rdfs:comment xml:lang="en">Power factor used in flicker calculations. May differ from vdPowerFactor. Typical default: 0.9.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Flicker Power Factor</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#flickerSafetyFactorWire">
    <rdfs:comment xml:lang="en">Safety factor applied to wire flicker results. Typical default: 1.0.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wire Flicker Safety Factor</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#flickerSafetyFactorXmfr">
    <rdfs:comment xml:lang="en">Safety factor applied to transformer flicker results. Typical default: 1.0.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Xmfr Flicker Safety Factor</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#flickerWireAndTransformerPct">
    <rdfs:comment xml:lang="en">Total flicker through conductors plus transformer as a percentage.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#VoltageDropResult" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wire+Transformer Flicker (%)</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#flickerWireOnlyPct">
    <rdfs:comment xml:lang="en">Flicker (voltage dip from motor starting) through conductors only as a percentage.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#VoltageDropResult" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wire Flicker (%)</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#flowDirection">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Flow direction relative to source→target on a PhysicalConnection relation. Values: Forward, Reverse, Both. Omit if directionality is not known or not applicable.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#Relation" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Flow Direction</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#formatVersion">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CIMBOLOGY-KG format version (e.g., '1.0.0')</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#frLengthThreshold">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment xml:lang="en">Duct length threshold in meters above which fill ratio governs sizing (shorter ducts are governed by jam ratio). Typical default: ~1.969 ft = 0.6 m.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FR Length Threshold</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#frameSize">
    <rdfs:comment xml:lang="en">Physical frame designation for a breaker or switchgear assembly (for example '225AF' or '600A frame'). Needed for catalog resolution and replacement planning.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Frame Size</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#framingType">
    <rdfs:comment xml:lang="en">Pole-top framing layout (e.g., 'Horizontal', 'Vertical', 'Spacer'). Determines phase spacing, crossarm requirements, and pole head geometry.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#Framing" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Framing Type</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#frictionCoeffThreshold">
    <rdfs:comment xml:lang="en">Threshold in N/m above which the high friction coefficient applies. Imperial equivalent: lbf/ft (typical default: 2190 N/m = 150 lbf/ft).</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Friction Coeff Threshold</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#fuseRating">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/A" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/ElectricCurrent" />
    <rdfs:comment xml:lang="en">Fuse continuous current rating in amperes per IEEE C37.42-2016 (distribution cutouts and fuse links). CIM models fuses via cim:Fuse but does not carry detailed fuse link ratings.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fuse Rating</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
    <rdfs:seeAlso rdf:resource="http://iec.ch/TC57/CIM100#Fuse" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#fuseType">
    <rdfs:comment xml:lang="en">Fuse/cutout type (e.g., 'standard fuse', 'cutout', 'arrester', 'disconnect'). Fuse type determines time-current characteristics and fault interrupting behavior.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fuse Type</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <rdfs:seeAlso rdf:resource="http://iec.ch/TC57/CIM100#Fuse" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#groundLineMomentApplied">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/N-M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Torque" />
    <rdfs:comment xml:lang="en">Total applied ground-line moment in newton-meters (sum of all transverse and vertical moment contributions from conductors, equipment, wind, and ice).</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#PoleLoadResult" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Applied Ground-Line Moment</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#groundLineMomentCapacity">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/N-M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Torque" />
    <rdfs:comment xml:lang="en">Rated ground-line moment capacity in newton-meters, derived from pole class, species, and circumference at ground line per ANSI O5.1.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ground-Line Moment Capacity</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://cimbology.com/ontology/kg#groundedTo">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Functional relationship linking conductive equipment to the station grounding system used for fault-current dissipation and personnel safety.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Grounded To</rdfs:label>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#guyAngle">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/DEG" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Angle" />
    <rdfs:comment xml:lang="en">Guy wire angle from horizontal in degrees. Derived from attachment height and lead distance.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#AnchorGuy" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Guy Angle</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#guyAttachmentHeight">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment xml:lang="en">Height of guy wire attachment on the pole above ground in meters.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#AnchorGuy" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Guy Attachment Height</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#guyHighVoltOffset">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment xml:lang="en">Attachment height offset in meters at high-voltage levels to clear phase conductors. Typical default: ~0.984 ft = 0.3 m.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Guy HV Level Offset</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#guyHorizontalLoad">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/N" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Force" />
    <rdfs:comment xml:lang="en">Horizontal component of the guy wire load in newtons.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#GuyingResult" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Guy Horizontal Load</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#guyLead">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment xml:lang="en">Horizontal distance from pole base to anchor point in meters.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#AnchorGuy" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Guy Lead</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#guyLevelGroupTolerance">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment xml:lang="en">Tolerance in meters for grouping guys at the same attachment level. Guys within this distance are treated as co-planar. Typical default: ~0.15 m.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Guy Level Group Tolerance</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#guyLowVoltOffset">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment xml:lang="en">Attachment height offset in meters at low-voltage levels to clear secondary conductors. Typical default: ~0.492 ft = 0.15 m.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Guy LV Level Offset</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#guyMinLeadDistance">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment xml:lang="en">Minimum required lead distance for this guy in meters based on attachment height and guy angle constraints.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#GuyingResult" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Minimum Lead Distance</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#guyNextDisplacement">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment xml:lang="en">Vertical displacement in meters between adjacent guy attachment levels. Typical default: ~0.492 ft = 0.15 m.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Guy Next Displacement</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#guyRelief">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/N-M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Torque" />
    <rdfs:comment xml:lang="en">Ground-line moment reduction from guy wires in newton-meters. Subtracted from the total applied moment.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#PoleLoadResult" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Guy Relief</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#guyStrength">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/N" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Force" />
    <rdfs:comment xml:lang="en">Rated breaking strength of the guy wire in newtons.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#AnchorGuy" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Guy Strength</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#guyStrengthFactor">
    <rdfs:comment xml:lang="en">Strength factor for the guy wire — ratio of rated strength to applied tension. Values below 1.0 indicate the guy is overstressed.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#GuyingResult" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Guy Strength Factor</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#guyTensionDeviationAngle">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/DEG" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Angle" />
    <rdfs:comment xml:lang="en">Angle between the guy wire direction and the resultant load direction in degrees. Large deviations reduce guy effectiveness.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#GuyingResult" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tension Deviation Angle</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#guyTensionResult">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/N" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Force" />
    <rdfs:comment xml:lang="en">Computed tension in the guy wire in newtons under the design load case.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#GuyingResult" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Guy Tension (Result)</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#guyType">
    <rdfs:comment xml:lang="en">Guy wire functional type (e.g., 'normal', 'sidewalk', 'stub', 'head', 'brace', 'span', 'arm'). Describes the guy wire role, not the wire specification.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#AnchorGuy" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Guy Type</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#guyWireCount">
    <rdfs:comment xml:lang="en">Number of parallel guy wires in this assembly. Some high-load poles require two parallel guys for increased capacity. Needed for guy assembly material takeoff and total assembly strength calculations.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#AnchorGuy" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Guy Wire Count</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#hasAntiPump">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Whether the breaker close circuit includes anti-pump logic.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Has Anti-Pump</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#hasNeutral">
    <rdfs:comment xml:lang="en">Whether this framing includes a neutral conductor attachment.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#Framing" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Has Neutral</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#hasReclosing">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Whether automatic reclosing is enabled. Applies to substation breakers with reclosing relays and distribution reclosers/switches with recloser controllers.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Has Reclosing</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#hasTripSupervision">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Whether the breaker trip circuit includes supervision (open-circuit / blown-fuse detection).</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Has Trip Supervision</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#heatingDemandFactor">
    <rdfs:comment xml:lang="en">Demand factor for heating loads (0–1). Typical default: 0.5.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ServicePoint" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Heating Demand Factor</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#heatingLoad1ph">
    <rdfs:comment xml:lang="en">Single-phase connected heating load in kW. Typical default: 0.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ServicePoint" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Heating Load 1PH</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#heatingLoad3ph">
    <rdfs:comment xml:lang="en">Three-phase connected heating load in kW. Typical default: 0.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ServicePoint" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Heating Load 3PH</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#heatingOprDaysPerMon">
    <rdfs:comment xml:lang="en">Heating equipment operating days per month. Typical default: 21.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ServicePoint" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Heating Opr Days/Month</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#heatingPctOprHours">
    <rdfs:comment xml:lang="en">Fraction of daily operating hours heating equipment runs (0–1). Typical default: 0.5.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ServicePoint" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Heating % Opr Hours</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#height">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bounding-box height of the equipment in metres (Z-axis).</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Height</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#highFrictionCoeff">
    <rdfs:comment xml:lang="en">High friction coefficient (dimensionless) for cable-in-conduit pulling analysis. Applied when tension exceeds cimbology:frictionCoeffThreshold. Typical default: 0.09.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">High Friction Coefficient</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#horizontalSpan">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment xml:lang="en">Horizontal distance between adjacent poles in meters.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Horizontal Span</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#horizontalTension">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/N" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Force" />
    <rdfs:comment xml:lang="en">Horizontal component of conductor tension in newtons.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Horizontal Tension</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#host">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">URI of hosting element (e.g., foundation for transformer)</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#hostFace">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Identifier of the face on the host element where this element is attached.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Host Face</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#iceThickness">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment xml:lang="en">Radial ice thickness in meters for the design loading district. NESC §250B defines defaults (e.g., 0.0127 m = 0.5 in for Heavy district).</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ice Thickness</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#innerDiameter">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Diameter" />
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Internal diameter of a tubular conductor or equipment, in meters.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Inner Diameter</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#installationDate">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Date the equipment was physically installed.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Installation Date</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#internalId">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Internal identifier assigned by the originating design tool or system.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Internal ID</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <rdf:Property rdf:about="https://cimbology.com/ontology/kg#isCatalogKey">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Boolean: if true, this property is used as a search filter in the catalog query.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Is Catalog Key</rdfs:label>
  </rdf:Property>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#isGangOperated">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">True if a multi-pole switching device operates all poles simultaneously via a shared operating mechanism. Applicable to cim:Disconnector and cim:LoadBreakSwitch where independent-pole operation is physically possible but operationally undesired. Absent or false = poles may operate independently. Breakers inherently operate all poles simultaneously and do not need this flag. Aligns with (and inverts) CIM's SwitchInfo.isUnganged: isGangOperated = NOT isUnganged.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Is Gang Operated</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#isPhysicallyInverted">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">True if the equipment is physically installed 180° from the conventional orientation. Affects only the physical mapping from cim:Terminal.sequenceNumber to the physical terminal on the equipment body. Does NOT change electrical topology (odd sequenceNumber 1,3,5 = line side; even 2,4,6 = load side). Absent or false = conventional. Applicable to two-sided switching equipment (cim:Breaker, cim:Disconnector, cim:Fuse, cim:ACLineSegment).</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Is Physically Inverted</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#isReversed">
    <rdfs:comment xml:lang="en">True if the span direction was reversed during analysis (start/end poles swapped for computational reasons). Consumers must account for this when interpreting start/end height and tension values.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#SagTensionResult" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Is Reversed</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#lastMaintenance">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Date of the most recent maintenance or inspection.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Last Maintenance</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#lastModified">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Alias for cimbology:modified. Retained for backward compatibility with tools that use 'lastModified'.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Last Modified</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime" />
    <cimbology:firstClassProperty rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</cimbology:firstClassProperty>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#legacyId">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Identifier from a legacy system, preserved for traceability during migration.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Legacy ID</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#level">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Vertical level/elevation name</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#lightingDemandFactor">
    <rdfs:comment xml:lang="en">Demand factor for lighting loads (0–1). Typical default: 0.9.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ServicePoint" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lighting Demand Factor</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#lightingLoad1ph">
    <rdfs:comment xml:lang="en">Single-phase connected lighting load in kW. Typical default: 0.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ServicePoint" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lighting Load 1PH</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#lightingLoad3ph">
    <rdfs:comment xml:lang="en">Three-phase connected lighting load in kW. Typical default: 0.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ServicePoint" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lighting Load 3PH</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#lightingOprDaysPerMon">
    <rdfs:comment xml:lang="en">Lighting operating days per month. Typical default: 21.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ServicePoint" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lighting Opr Days/Month</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#lightingPctOprHours">
    <rdfs:comment xml:lang="en">Fraction of daily operating hours lighting runs (0–1). Typical default: 1.0.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ServicePoint" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lighting % Opr Hours</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#lineAngle">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/DEG" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Angle" />
    <rdfs:comment xml:lang="en">Line deflection angle at this pole in degrees. Zero for tangent poles, nonzero for angle poles. Determines transverse loading from conductor tension.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Line Angle</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://cimbology.com/ontology/kg#loadCase">
    <rdfs:comment xml:lang="en">Reference to the cimbology:LoadCase under which this result was computed.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#SagTensionResult" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Load Case</rdfs:label>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#loadCaseIce">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment xml:lang="en">Radial ice thickness for this load case in meters.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#LoadCase" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Load Case Ice</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#loadCaseName">
    <rdfs:comment xml:lang="en">Human-readable name for this load case (e.g., 'NESC Heavy', 'Max Operating Temp', 'Everyday 60°F').</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#LoadCase" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Load Case Name</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#loadCaseTemperature">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/DEG_C" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Temperature" />
    <rdfs:comment xml:lang="en">Temperature for this load case in degrees Celsius.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#LoadCase" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Load Case Temperature</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#loadCaseWind">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PA" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Pressure" />
    <rdfs:comment xml:lang="en">Wind pressure for this load case in pascals.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#LoadCase" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Load Case Wind</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#loadGrowthPerYear">
    <rdfs:comment xml:lang="en">Annual load growth rate as a multiplier (1.0 = no growth). Typical default: 1.0.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Load Growth Per Year</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#loadLoss">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/W" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Power" />
    <rdfs:comment xml:lang="en">Transformer load loss in watts from the rated-current short-circuit test. Needed for efficiency, voltage-drop, and thermal studies in both distribution and substation contexts. CIM equivalent if any: cim:ShortCircuitTest.loss.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Load Loss</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
    <rdfs:seeAlso rdf:resource="http://iec.ch/TC57/CIM100#ShortCircuitTest" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#lockedRotorAmpsMultiplier">
    <rdfs:comment xml:lang="en">Locked rotor amps multiplier for motor starting flicker analysis. Typical default: 5.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Locked Rotor Amps Multiplier</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#lowFrictionCoeff">
    <rdfs:comment xml:lang="en">Low friction coefficient (dimensionless) for cable-in-conduit pulling analysis. Applied when tension is below cimbology:frictionCoeffThreshold. Typical default: 0.05.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Low Friction Coefficient</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#lowestPointDistance">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment xml:lang="en">Horizontal distance from the start pole to the lowest point of the catenary in meters.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#SagTensionResult" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lowest Point Distance</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#lowestPointHeight">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment xml:lang="en">Height of the lowest point of the catenary above ground in meters.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#SagTensionResult" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lowest Point Height</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#lowestPointTension">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/N" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Force" />
    <rdfs:comment xml:lang="en">Conductor tension at the lowest point of the catenary in newtons (equals horizontal tension for a catenary; used both as a DistributionCriteria threshold, typical default 1 lbf = 4.45 N, and as a SagTensionResult output).</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lowest Point Tension</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#mainPanelSize">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/A" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/ElectricCurrent" />
    <rdfs:comment xml:lang="en">Customer main service entrance panel size in amperes. Used for service conductor sizing — the service drop must be rated for at least the main breaker ampacity. Any distribution design tool performing service conductor selection needs this.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ServicePoint" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Main Panel Size</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#manufacturer">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Name of the equipment manufacturer.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Manufacturer</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#marginAllowance">
    <rdfs:comment xml:lang="en">Total estimated margin allowance as a fraction or kW adder to account for unspecified future loads. Typical default: 0.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ServicePoint" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Margin Allowance</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#massPerLength">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloGM-PER-M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/MassPerLength" />
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mass per unit length of a linear conductor, in kg/m.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mass Per Length</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#maxAllowableSag">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment xml:lang="en">Maximum allowable conductor sag in meters. Design limit — conductors must not sag below this value under any design condition. Typical default: 16.4 ft = 5.0 m.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Max Allowable Sag</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#maxConductorTension">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/N" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Force" />
    <rdfs:comment xml:lang="en">Maximum allowable conductor tension in newtons for stringing design. Typical default: 22480 lbf = 99,970 N.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Max Conductor Tension</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#maxEyePull">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/N" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Force" />
    <rdfs:comment xml:lang="en">Maximum pulling tension via a pulling eye attached to the conductor core in newtons. Typically higher than cimbology:maxGripPull because load is transferred directly to the structural core. Source: conductor manufacturer installation data.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Max Eye Pull</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#maxGripPull">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/N" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Force" />
    <rdfs:comment xml:lang="en">Maximum pulling tension via a grip or stocking on the conductor outer jacket in newtons. Limits cable jacket damage during conduit pulls. Source: conductor manufacturer installation data.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Max Grip Pull</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#maxHeight">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment xml:lang="en">Maximum rated pole height in meters — the longest standard length available for this pole class/species. Distinct from cimbology:poleHeight which is the actual installed pole height.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Max Pole Height</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#maxIceThickness">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment xml:lang="en">Maximum radial ice thickness in meters for sag analysis. Distinct from cimbology:iceThickness (the NESC district design load). Typical default: 0.083 ft = 0.025 m.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Max Ice Thickness</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#maxJamRatio">
    <rdfs:comment xml:lang="en">Maximum allowable jam ratio (duct inner diameter / cable outer diameter). Jam occurs when ratio approaches 3. Typical default: 3.1.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Max Jam Ratio</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#maxOperatingTemp">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/DEG_C" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Temperature" />
    <rdfs:comment xml:lang="en">Maximum operating temperature in degrees Celsius for thermal rating. Applies to distribution conductors (sag calculation), HV cables (insulation thermal limit), and substation buswork (continuous current rating). CIM equivalent: cim:WireInfo.ratedCurrent implicitly encodes this via the thermal rating.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Max Operating Temperature</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#maxQueenpostLength">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment xml:lang="en">Maximum queenpost (sidewalk guy strut) length in meters. Typical default: ~8.005 ft = 2.44 m.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Max Queenpost Length</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#maxRulingAngle">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/DEG" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/PlaneAngle" />
    <rdfs:comment xml:lang="en">Maximum ruling span angle in degrees. Typical default: 15°.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Max Ruling Angle</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#maxRulingSpan">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment xml:lang="en">Maximum ruling span length in meters. Typical default: 328.083 ft = 100 m.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Max Ruling Span</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#maxSag">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment xml:lang="en">Maximum sag in meters under the specified load case.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Maximum Sag</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#maxSagTemp">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/DEG_C" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Temperature" />
    <rdfs:comment xml:lang="en">Maximum conductor temperature for sag analysis in degrees Celsius. Determines worst-case sag condition. Typical default: 120°F = 48.9°C.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Max Sag Temperature</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#maxSidewallBearingPressure">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PA" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Pressure" />
    <rdfs:comment xml:lang="en">Maximum allowable sidewall bearing pressure in pascals at conduit bends during cable installation. Prevents conductor deformation at corners. Commonly abbreviated SWBP. Source: conductor manufacturer installation data.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Max Sidewall Bearing Pressure</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#maxSpan">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment xml:lang="en">Maximum allowable span length in meters. Typical default: 328.083 ft = 100 m.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Max Span</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#maxSpanClearance">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment xml:lang="en">Maximum clearance to ground/obstacles within the span in meters.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#SagTensionResult" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Max Span Clearance</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#maxSpanClearanceDistance">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment xml:lang="en">Horizontal distance from the start pole to the maximum clearance point in meters.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#SagTensionResult" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Max Span Clearance Distance</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#maxTension">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/N" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Force" />
    <rdfs:comment xml:lang="en">Maximum conductor tension in newtons (at the high support point).</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Maximum Tension</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#maxTensionPctRbs">
    <rdfs:comment xml:lang="en">Maximum initial stringing tension as a percentage of rated breaking strength (RBS). Typical limit: 35% for distribution conductors under NESC heavy loading.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Max Tension Percent RBS</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#maxTotalFlicker">
    <rdfs:comment xml:lang="en">Maximum allowable total flicker as a percent. Typical default: 6%.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Max Total Flicker (%)</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#maxTotalVoltageDrop">
    <rdfs:comment xml:lang="en">Maximum allowable total system voltage drop (wire + transformer) as a percent. Typical default: 5%.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Max Total Voltage Drop (%)</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#maxUnguyedMoment">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/N-M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Torque" />
    <rdfs:comment xml:lang="en">Maximum pole moment in newton-meters before guying is required. Poles with ground-line moment below this threshold do not require guying. Typical default: ~2001.75 N·m.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Max Unguyed Moment</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#maxVerticalLoad">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/N" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Force" />
    <rdfs:comment xml:lang="en">Maximum allowable vertical load on the pole in newtons — the pole's rated capacity for downward loads from conductors, equipment, and ice. Used in pole loading analysis alongside ground-line moment.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Max Vertical Load</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#maxWindPressure">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PA" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Pressure" />
    <rdfs:comment xml:lang="en">Maximum wind pressure in pascals for sag analysis. Distinct from cimbology:windPressure (the NESC district design load). Typical default: 0.069 psi = 476 Pa.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Max Wind Pressure</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#maxWireFlicker">
    <rdfs:comment xml:lang="en">Maximum allowable wire flicker as a percent of nominal voltage. Typical default: 3%.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Max Wire Flicker (%)</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#maxWireVoltageDrop">
    <rdfs:comment xml:lang="en">Maximum allowable wire voltage drop as a percent of nominal voltage. Typical default: 2%.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Max Wire Voltage Drop (%)</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#maxXmfrFlicker">
    <rdfs:comment xml:lang="en">Maximum allowable transformer flicker as a percent. Typical default: 2.2%.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Max Xmfr Flicker (%)</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#maxXmfrVoltageDrop">
    <rdfs:comment xml:lang="en">Maximum allowable transformer voltage drop as a percent of nominal voltage. Typical default: 4.6%.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Max Xmfr Voltage Drop (%)</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#memberLength">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Length in metres of a physical conductor-run member (cim:BusbarSection or cim:ACLineSegment). Used INSTEAD OF cim:Conductor.length because cim:BusbarSection extends cim:Connector (not cim:Conductor), so cim:Conductor.length does not validly inherit. The lazy total length on cimbology:Conductor is the sum of cimbology:memberLength across all members. Members without this property are skipped in the sum; if no member declares it, total length is undefined.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Conductor Member Length</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://cimbology.com/ontology/kg#memberOfBank">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Links per-phase equipment to its cimbology:EquipmentBank node. Replaces the earlier name-derived bank identifier string model. Stable across equipment renames because the value is the bank's URN, not a derived label. Query pattern: SELECT ?member WHERE { ?member cimbology:memberOfBank &lt;urn:uuid:...&gt; } returns all bank members.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Member Of Bank</rdfs:label>
    <rdfs:range rdf:resource="https://cimbology.com/ontology/kg#EquipmentBank" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://cimbology.com/ontology/kg#memberOfConductorRun">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Links a physical current-carrying segment (cim:BusbarSection for rigid bus and A-frame segments; cim:ACLineSegment for cable runs) to the logical cimbology:Conductor it belongs to. Multiple physical members may share the same conductor URN — they are the assembly of pieces that make up one per-phase run between two terminals. Fittings, couplings, and elbows are NOT tracked at the CIMBOLOGY-KG layer in V1; they remain CAD/BIM tool-side concerns. Query pattern: SELECT ?member WHERE { ?member cimbology:memberOfConductorRun &lt;urn:uuid:...&gt; } returns all physical pieces of a known conductor run.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Member Of Conductor Run</rdfs:label>
    <rdfs:range rdf:resource="https://cimbology.com/ontology/kg#Conductor" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#meterClass">
    <rdfs:comment xml:lang="en">Metering or protection accuracy class string (for example '0.3', '0.5', '1.2', or relay-class designations). Applies to revenue metering CTs in distribution and protection CTs in substations. CIM equivalent if any: cim:CurrentTransformer.accuracyClass and cim:PotentialTransformer.accuracyClass.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Meter Class</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <rdfs:seeAlso rdf:resource="http://iec.ch/TC57/CIM100#CurrentTransformer" />
    <rdfs:seeAlso rdf:resource="http://iec.ch/TC57/CIM100#PotentialTransformer" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#meterNumber">
    <rdfs:comment xml:lang="en">Utility meter number at the service point.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ServicePoint" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Meter Number</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#minAllowableSag">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment xml:lang="en">Minimum allowable conductor sag in meters. Prevents conductors strung too tight. Typical default: 0.0656 ft = 0.02 m.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Min Allowable Sag</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#minCableBendRadius">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment xml:lang="en">Minimum installation bend radius for flexible cable in meters, used for conduit layout and splicing. Distinct from cimbology:bendRadius which applies to rigid tubular bus. Source: conductor manufacturer installation data.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Min Cable Bend Radius</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#minConductorTension">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/N" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Force" />
    <rdfs:comment xml:lang="en">Minimum conductor tension in newtons. Typical default: 1 lbf = 4.45 N.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Min Conductor Tension</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#minGroundClearance">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment xml:lang="en">Minimum ground clearance requirement for this conductor type in meters per NESC Table 232-1. A catalog property that encodes the conductor voltage class clearance requirement. Distinct from cimbology:clearance (domain: cimbology:ClearanceCheck) which is the computed actual clearance in a specific span.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Min Ground Clearance</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#minJamRatio">
    <rdfs:comment xml:lang="en">Minimum jam ratio — jam also occurs when ratio is too low (near 1). Typical default: 2.75.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Min Jam Ratio</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#minSagTemp">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/DEG_C" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Temperature" />
    <rdfs:comment xml:lang="en">Minimum conductor temperature for sag analysis in degrees Celsius. Determines worst-case tension condition. Typical default: 5°F = -15°C.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Min Sag Temperature</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#minSpan">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment xml:lang="en">Minimum span length in meters below which sag analysis is skipped. Typical default: 32.808 ft = 10 m.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Min Span</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#miscDemandFactor">
    <rdfs:comment xml:lang="en">Demand factor for miscellaneous loads (0–1). Typical default: 0.2.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ServicePoint" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Misc Demand Factor</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#miscLoad1ph">
    <rdfs:comment xml:lang="en">Single-phase connected miscellaneous load in kW. Typical default: 0.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ServicePoint" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Misc Load 1PH</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#miscLoad3ph">
    <rdfs:comment xml:lang="en">Three-phase connected miscellaneous load in kW. Typical default: 0.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ServicePoint" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Misc Load 3PH</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#miscOprDaysPerMon">
    <rdfs:comment xml:lang="en">Miscellaneous load operating days per month. Typical default: 21.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ServicePoint" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Misc Opr Days/Month</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#miscPctOprHours">
    <rdfs:comment xml:lang="en">Fraction of daily operating hours misc loads run (0–1). Typical default: 0.35.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ServicePoint" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Misc % Opr Hours</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#modelName">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Manufacturer model name or designation.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Model Name</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#modified">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#modifiedBy">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Username or identifier of the person or system that last modified this object.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Modified By</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <cimbology:firstClassProperty rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</cimbology:firstClassProperty>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#modulusOfElasticity">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PA" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Pressure" />
    <rdfs:comment xml:lang="en">Modulus of elasticity in pascals. Used in sag-tension analysis for distribution overhead conductors and substation strain bus, and in rigid bus structural calculations (IEEE 605 — Guide for Bus Design in Air Insulated Substations) for deflection and vibration checks. Source: ASTM B232 and manufacturer data.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Modulus of Elasticity</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://cimbology.com/ontology/kg#monitors">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Functional relationship linking an instrument transformer (CT/PT/CCVT) to the equipment it monitors for metering and protection logic.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Monitors</rdfs:label>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#motorLoadKw">
    <rdfs:comment xml:lang="en">Motor load at the service point in kilowatts. Separated from general load because motor starting drives flicker calculations (locked-rotor amps).</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ServicePoint" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Motor Load</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#motorsDemandFactor">
    <rdfs:comment xml:lang="en">Demand factor for motor loads (0–1). Separate from motorLoadKw which captures the total motor load for flicker; this factor applies to connected motor load in the detailed breakdown. Typical default: 0.3.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ServicePoint" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Motors Demand Factor</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#motorsLoad1ph">
    <rdfs:comment xml:lang="en">Single-phase connected motor load in kW. Typical default: 0.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ServicePoint" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Motors Load 1PH</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#motorsLoad3ph">
    <rdfs:comment xml:lang="en">Three-phase connected motor load in kW. Typical default: 0.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ServicePoint" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Motors Load 3PH</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#motorsOprDaysPerMon">
    <rdfs:comment xml:lang="en">Motor operating days per month. Typical default: 21.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ServicePoint" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Motors Opr Days/Month</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#motorsPctOprHours">
    <rdfs:comment xml:lang="en">Fraction of daily operating hours motors run (0–1). Typical default: 0.5.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ServicePoint" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Motors % Opr Hours</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#mountingHeight">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment xml:lang="en">Height of equipment mounting point above ground in meters. Used for pole loading moment arm calculation.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mounting Height</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#mountingLocation">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Description of where equipment is mounted on a host structure (e.g., 'top', 'side', 'crossarm').</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mounting Location</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#multiCableFrThreshold">
    <rdfs:comment xml:lang="en">Maximum fill ratio for three or more cables in a duct (dimensionless, 0–1). NEMA/ICEA guideline: 0.40. Typical default: 0.4.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Multi Cable FR Threshold</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#name">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Display name for the object. Equivalent to cim:IdentifiedObject.name but usable on any CIMBOLOGY-KG object.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Name</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <owl:equivalentProperty rdf:resource="http://iec.ch/TC57/CIM100#IdentifiedObject.name" />
    <cimbology:firstClassProperty rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</cimbology:firstClassProperty>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#nescDistrict">
    <rdfs:comment xml:lang="en">NESC loading district (Heavy, Medium, Light, or Warm Islands per NESC §250B). Determines baseline wind and ice loading assumptions.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NESC District</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#neutralOffset">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment xml:lang="en">Vertical offset of the neutral attachment point below the lowest phase conductor, in meters.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#Framing" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Neutral Offset</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#noLoadLoss">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/W" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Power" />
    <rdfs:comment xml:lang="en">Transformer core loss in watts at rated voltage with the secondary open. Needed for lifecycle costing and efficiency analysis in both distribution and substation tools. CIM equivalent if any: cim:NoLoadTest.loss.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No-Load Loss</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
    <rdfs:seeAlso rdf:resource="http://iec.ch/TC57/CIM100#NoLoadTest" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#normalGuyLead">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment xml:lang="en">Default guy lead distance in meters from pole base to anchor. Typical default: 25 ft = 7.62 m.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normal Guy Lead</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#normalIceThickness">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment xml:lang="en">Normal (everyday) radial ice thickness in meters for initial stringing. Typically 0 in most districts. Typical default: 0.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normal Ice Thickness</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#normalTemp">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/DEG_C" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Temperature" />
    <rdfs:comment xml:lang="en">Everyday (initial stringing) conductor temperature in degrees Celsius. Typical default: 68°F = 20°C.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normal Temperature</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#normalWindPressure">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PA" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Pressure" />
    <rdfs:comment xml:lang="en">Normal (everyday) wind pressure in pascals for initial stringing condition. Typical default: 0.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normal Wind Pressure</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#offsetFromHost">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Offset distance from the host element surface, in meters.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Offset From Host</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#oilCapacity">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/L" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Volume" />
    <rdfs:comment xml:lang="en">Insulating oil volume in liters for oil-filled transformers and regulators. Needed for maintenance planning, environmental handling, and catalog matching in both distribution and substation contexts. CIM has no direct oil-volume property on the base equipment classes.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Oil Capacity</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#oneCableFrThreshold">
    <rdfs:comment xml:lang="en">Maximum fill ratio for a single cable in a duct (dimensionless, 0–1). NEMA/ICEA guideline: 0.53. Typical default: 0.53.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">One Cable FR Threshold</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#operatingHoursPerDay">
    <rdfs:comment xml:lang="en">Facility operating hours per day. Used with per-category operating schedules to compute energy and demand. Typical default: 24.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ServicePoint" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Operating Hours Per Day</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#outerDiameter">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Diameter" />
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">External diameter of a conductor or equipment, in meters.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Outer Diameter</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#overloadFactorTransverse">
    <rdfs:comment xml:lang="en">Transverse overload factor (OLF) per NESC Table 253-1. Applied to wind loads on conductors and pole.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Overload Factor Transverse</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#overloadFactorVertical">
    <rdfs:comment xml:lang="en">Vertical overload factor (OLF) per NESC Table 253-1. Applied to vertical loads (conductor weight + ice).</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Overload Factor Vertical</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#partNumber">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Manufacturer part number or catalog number.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Part Number</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#path">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ordered sequence of [x,y,z] points for linear geometry (cables, conduits).</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#peakDemandKw">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloW" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Power" />
    <rdfs:comment xml:lang="en">Historical or billed peak demand in kilowatts. Distinct from cimbology:demandKw, which is the design-calculated demand, and cimbology:actualDemandKw, which captures current measured load.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ServicePoint" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Measured Peak Demand</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#phase">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Electrical phase assignment (e.g., 'A', 'B', 'C', 'N', 'ABC'). Used on relations and conductors. Supplementary convenience property for fast querying. cim:Terminal.phases is the authoritative source. If both present and conflict, cim:Terminal.phases wins.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Phase</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#phaseArrangement">
    <rdfs:comment xml:lang="en">Phase arrangement on the framing (e.g., 'ABC', 'ACB', 'BAC', 'Single'). Affects induced voltage calculations and circuit identification.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#Framing" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Phase Arrangement</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#phaseCount">
    <rdfs:comment xml:lang="en">Number of phases (1 for single-phase, 2 for V-phase/open-delta, 3 for three-phase). Applies to distribution framings, service points, and substation equipment (transformers, switchgear, feeders) in any domain.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Phase Count</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#phaseCreated">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Design/construction phase during which this element was created (e.g., 'Schematic', 'Detail Design').</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Phase Created</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#phases">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Number or combination of electrical phases (e.g., '3', 'ABC', '1'). Simplified from CIM's PhaseCode enumeration. Supplementary convenience property for fast querying. cim:Terminal.phases is the authoritative source. If both present and conflict, cim:Terminal.phases wins.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Phases</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#physicalSide">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physical side designation on a terminal of an inverted equipment. Values: 'LineSide' or 'LoadSide'. REQUIRED on all 6 terminals when the parent equipment has cimbology:isPhysicallyInverted = true; OMITTED on terminals of conventionally-installed equipment (convention is unambiguous from cim:Terminal.sequenceNumber). When inverted: terminals with odd sequenceNumber (1,3,5) carry physicalSide='LoadSide' and terminals with even sequenceNumber (2,4,6) carry physicalSide='LineSide'.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physical Side</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#pluginName">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Name of the tool plugin or exporter that produced this data.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Plugin Name</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#pluginVersion">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Version of the tool plugin that produced this data.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Plugin Version</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#point">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Single [x,y,z] coordinate (connection points, attachment locations).</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON" />
    <cimbology:firstClassProperty rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</cimbology:firstClassProperty>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#points">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Array of [x,y,z] coordinates (distinct from cimbology:path which implies ordering for linear geometry).</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON" />
    <cimbology:firstClassProperty rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</cimbology:firstClassProperty>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#poleCapLength">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment xml:lang="en">Pole cap length in meters — reserved clearance from pole top to the first conductor attachment. Typical default: 0.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pole Cap Length</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#poleClass">
    <rdfs:comment xml:lang="en">ANSI O5.1 pole class. Standard classes: '7', '6', '5', '4', '3', '2', '1', 'H1', 'H2', 'H3', 'H4', 'H5', 'H6'. Concrete classes: 'C-01.9' through 'C-12.0'. Other: 'G', 'F', 'H', 'J'. Determines ground-line moment capacity. CIM equivalent: cim:Pole.classification (IEC61968 InfAssets), which uses the same class codes.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pole Class</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <rdfs:seeAlso rdf:resource="http://iec.ch/TC57/CIM100#Pole" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#poleHeadStyle">
    <rdfs:comment xml:lang="en">Pole head assembly style (e.g., 'ruling span', 'non ruling span', 'buck', 'end'). Describes the structural assembly configuration.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#Framing" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pole Head Style</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#poleHeadType">
    <rdfs:comment xml:lang="en">Pole head conductor type (e.g., 'primary', 'secondary', 'service', 'neutral', 'communication'). Identifies which circuit level a pole head assembly serves.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#Framing" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pole Head Type</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#poleHeight">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment xml:lang="en">Total pole height in meters (above ground + setting depth). CIM equivalent: cim:Pole.length (IEC61968 InfAssets) — 'Length of the pole (inclusive of any section of the pole that may be underground post-installation).'</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pole Height</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
    <rdfs:seeAlso rdf:resource="http://iec.ch/TC57/CIM100#Pole" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#poleLoadingPct">
    <rdfs:comment xml:lang="en">Applied ground-line moment as a percentage of rated capacity (0–100+). Values over 100% indicate overloaded poles.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#PoleLoadResult" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pole Loading Percent</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#poleLoadingViolated">
    <rdfs:comment xml:lang="en">True if poleLoadingPct exceeds 100% (pole is overloaded after applying NESC strength factors per §261). Same convenience-boolean pattern as cimbology:clearanceViolated.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#PoleLoadResult" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pole Loading Violated</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#poleMaterial">
    <rdfs:comment xml:lang="en">Pole material (e.g., 'wood', 'composite', 'steel', 'concrete'). CIM equivalent: cim:Structure.materialKind (IEC61968 AssetInfo) using cim:StructureMaterialKind enum (wood, steel, concrete, other). CIMBOLOGY-KG uses a string to accommodate 'composite' which the CIM enum does not include.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pole Material</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <rdfs:seeAlso rdf:resource="http://iec.ch/TC57/CIM100#Structure" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#poleSpecies">
    <rdfs:comment xml:lang="en">Wood pole species per ANSI O5.1 (e.g., 'Southern Yellow Pine', 'Western Red Cedar', 'Douglas Fir'). Species determines fiber strength and ground-line moment capacity. CIM equivalent: cim:Pole.speciesType (IEC61968 InfAssets), which lists 'Wood-Treated', 'Wood-Hard', 'Wood-Salt Treated', 'Wood-Soft', etc. CIMBOLOGY-KG uses ANSI O5.1 species names because design tools reference the standard directly.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pole Species</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <rdfs:seeAlso rdf:resource="http://iec.ch/TC57/CIM100#Pole" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#poleType">
    <rdfs:comment xml:lang="en">Pole functional type (e.g., 'support', 'guy', 'porch', 'deadend', 'tangent', 'non-meter'). Describes the structural role in the line, not the material (use poleSpecies/poleMaterial for material).</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pole Type</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <rdfs:seeAlso rdf:resource="http://iec.ch/TC57/CIM100#Pole" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#positionInBay">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">0-based position of equipment within its bay. For BAH: 0=Bus-A-side, 1=Middle/Tie, 2=Bus-B-side. For DBDB: 0=Bus-A-side, 1=Bus-B-side. Consuming tools use this instead of parsing equipment names.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Position In Bay</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#projectCode">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Project or work order code for tracking design/construction scope.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Project Code</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://cimbology.com/ontology/kg#protects">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Functional relationship linking a surge arrester to the equipment or junction it protects from overvoltage events.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Protects</rdfs:label>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#provenanceCitation">
    <rdfs:comment xml:lang="en">Source citation for the data (e.g., 'Field survey 2024-03-15', 'GIS export v2.1', 'NESC Table 232-1'). Applies to any CIMBOLOGY-KG data regardless of source tool.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Provenance Citation</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#provenanceDate">
    <rdfs:comment xml:lang="en">Date when this value was set or last verified. Applies to any CIMBOLOGY-KG data regardless of source tool.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Provenance Date</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#provenanceSetterInitials">
    <rdfs:comment xml:lang="en">Initials of the engineer who set or verified this value. Part of the PE-stamp audit trail. Applies to any CIMBOLOGY-KG data regardless of source tool.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Provenance Setter</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#provenanceTier">
    <rdfs:comment xml:lang="en">Data confidence tier (e.g., 'Survey', 'GIS', 'Assumed', 'Calculated', 'PE-Verified'). Indicates the reliability of the associated property values. Applies to any CIMBOLOGY-KG data regardless of source tool.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Provenance Tier</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#ptRatio">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Legacy potential-transformer ratio string (e.g., '138000:120' for substation, '7200:120' for distribution). For structured ratio metadata such as accuracy class and ratio components, use cim:PotentialTransformerInfo from the IEC 61968 informative AssetInfo package alongside this string when needed.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PT Ratio</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#pullingTensionSafetyFactor">
    <rdfs:comment xml:lang="en">Safety factor applied to computed maximum pulling tension before comparing to cable rating. Typical default: 1.0.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pulling Tension Safety Factor</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#purchaseDate">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Date the equipment was purchased.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Purchase Date</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#qaReport">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Graph-level QA summary as JSON object (counts and top disagreement patterns).</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">QA Report</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#queenpostHeight">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment xml:lang="en">Normal queenpost attachment height in meters. Typical default: ~8.005 ft = 2.44 m.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Queenpost Height</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#r">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/OHM" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Resistance" />
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Positive sequence series resistance, in ohms. Optional. Mirrors cim:ACLineSegment.r. Absent unless an explicit value is provided by the designer; consumers fall back to cim:WireInfo per-length values * total length when this property is missing.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Positive Sequence Series Resistance</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#r0">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/OHM" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Resistance" />
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Zero sequence series resistance, in ohms. Optional. Mirrors cim:ACLineSegment.r0. Absent unless an explicit value is provided by the designer.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Zero Sequence Series Resistance</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#rbs">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/N" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Force" />
    <rdfs:comment xml:lang="en">Rated breaking strength in newtons. Applies to distribution overhead conductors, substation strain bus conductors, and shield wires. Source: ASTM B232 and conductor manufacturer data sheets.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rated Breaking Strength</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#reactance">
    <rdfs:comment xml:lang="en">Inductive reactance at 60 Hz in ohms per kilometer. Required by any tool performing voltage drop or power flow calculations — distribution overhead conductors, HV cable, and substation buswork all carry this parameter. Source: ASTM B232 and conductor manufacturer data sheets.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactance</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
    <rdfs:seeAlso rdf:resource="http://iec.ch/TC57/CIM100#WireInfo" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#recloserType">
    <rdfs:comment xml:lang="en">Recloser operational type (e.g., 'normal', 'bypass'). CIM may model reclosers as cim:Breaker or cim:Recloser depending on profile version.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Recloser Type</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#reelTension">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/N" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Force" />
    <rdfs:comment xml:lang="en">Cable reel back-tension in newtons applied at the start of pull. Typical default: 50 lbf = 222 N.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reel Tension</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#refDemandFactor">
    <rdfs:comment xml:lang="en">Demand factor for refrigeration loads (0–1). Typical default: 0.5.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ServicePoint" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Refrigeration Demand Factor</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#refLoad1ph">
    <rdfs:comment xml:lang="en">Single-phase connected refrigeration load in kW. Typical default: 0.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ServicePoint" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Refrigeration Load 1PH</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#refLoad3ph">
    <rdfs:comment xml:lang="en">Three-phase connected refrigeration load in kW. Typical default: 0.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ServicePoint" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Refrigeration Load 3PH</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#refOprDaysPerMon">
    <rdfs:comment xml:lang="en">Refrigeration operating days per month. Typical default: 21.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ServicePoint" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Refrigeration Opr Days/Month</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#refPctOprHours">
    <rdfs:comment xml:lang="en">Fraction of daily operating hours refrigeration runs (0–1). Typical default: 1.0.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ServicePoint" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Refrigeration % Opr Hours</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#regulatorBandwidth">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/V" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Voltage" />
    <rdfs:comment xml:lang="en">Voltage regulator bandwidth in volts per IEEE C57.15-2009. Bandwidth defines the voltage deadband within which the regulator does not tap-change. Typical values: 1.5–3.0 V on a 120 V base.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Regulator Bandwidth</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#regulatorImpedancePct">
    <rdfs:comment xml:lang="en">Series impedance of a voltage regulator expressed as percent of rated. Needed for voltage-drop and short-circuit studies on regulator banks. Related CIM concept: cim:TransformerEnd.x on the underlying regulator transformer.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Regulator Impedance</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
    <rdfs:seeAlso rdf:resource="http://iec.ch/TC57/CIM100#PowerTransformer" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#regulatorRangePct">
    <rdfs:comment xml:lang="en">Voltage regulator range as a percentage of nominal per IEEE C57.15 (e.g., ±10% is the most common for 32-step regulators). CIM models this via cim:RatioTapChanger.stepVoltageIncrement and step count.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Regulator Range</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
    <rdfs:seeAlso rdf:resource="http://iec.ch/TC57/CIM100#PowerTransformer" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#regulatorType">
    <rdfs:comment xml:lang="en">Voltage regulator type designation.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Regulator Type</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <rdfs:seeAlso rdf:resource="http://iec.ch/TC57/CIM100#PowerTransformer" />
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://cimbology.com/ontology/kg#relationKind">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">REQUIRED: The semantic type of this relation (Containment, PhysicalConnection, ParentChild, ProtectionAssignment, etc.)</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#Relation" />
    <rdfs:range rdf:resource="https://cimbology.com/ontology/kg#RelationKind" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#relayModel">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Manufacturer model identifier for a protection relay or recloser controller (e.g., 'SEL-351', 'SEL-651R', 'SEL-411L').</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Relay Model</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#requiredClearance">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment xml:lang="en">Minimum required clearance distance in meters from the governing rule source (e.g., NESC Table 232-1).</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ClearanceCheck" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Required Clearance</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#resultantMomentDirection">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/DEG" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Angle" />
    <rdfs:comment xml:lang="en">Direction of the resultant applied ground-line moment in degrees from true north.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#PoleLoadResult" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Resultant Moment Direction</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#revisionNote">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Optional human-readable description of what changed in this revision.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Revision Note</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#revisionTimestamp">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ISO 8601 timestamp when this revision was saved.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Revision Timestamp</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#revisionTool">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Name of the tool that saved this revision.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Revision Tool</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#sagAtMidspan">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment xml:lang="en">Sag at midspan in meters (equals maxSagM for level spans).</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Midspan Sag</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#sagMinGroundClearance">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment xml:lang="en">Global default minimum ground clearance in meters for sag analysis. Applied when no per-conductor clearance is specified. NESC §232. Typical default: 9.842 ft = 3.0 m.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sag Min Ground Clearance</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#sagPercent">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Percentage sag of a cable span relative to the span length.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sag Percent</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#sdsType">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Legacy Spatial Design System (SDS) type name, preserved for backward-compatible type mapping.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SDS Type</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#serialNumber">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Manufacturer-assigned serial number for the physical asset.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Serial Number</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#serviceLoadFactor">
    <rdfs:comment xml:lang="en">Load factor at the service point (average load divided by peak load, typically 0–1). Useful for transformer sizing, load forecasting, and distinguishing high-utilization services from peaky loads.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ServicePoint" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Service Load Factor</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#servicePhase">
    <rdfs:comment xml:lang="en">Service phase configuration (e.g., '1PH-2W', '1PH-3W', '3PH-4W').</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ServicePoint" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Service Phase</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#serviceVoltage">
    <rdfs:comment xml:lang="en">Service voltage designation (e.g., '120/240V', '120/208V', '277/480V').</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ServicePoint" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Service Voltage</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#settingDepth">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment xml:lang="en">Pole burial depth in meters (typically 10% of pole length + 2 ft per ANSI O5.1 rule of thumb).</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Setting Depth</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#sizeWireForFlicker">
    <rdfs:comment xml:lang="en">Whether to automatically upsize conductors to meet wire flicker limit. Typical default: true.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Size Wire For Flicker</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#sizeWireForTotalFlicker">
    <rdfs:comment xml:lang="en">Whether to automatically upsize conductors to meet total flicker limit. Typical default: false.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Size Wire For Total Flicker</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#sizeWireForTotalVd">
    <rdfs:comment xml:lang="en">Whether to automatically upsize conductors to meet total voltage drop limit. Typical default: false.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Size Wire For Total VD</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#sizeWireForVoltageDrop">
    <rdfs:comment xml:lang="en">Whether to automatically upsize conductors to meet wire voltage drop limit. Typical default: true.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Size Wire For VD</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#smallDuctFrThreshold">
    <rdfs:comment xml:lang="en">Maximum fill ratio for small duct installations (dimensionless, 0–1). Typical default: 0.6.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Small Duct FR Threshold</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://cimbology.com/ontology/kg#source">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The source/from object URI - points to the originating node of a relation</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#Relation" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://cimbology.com/ontology/kg#sourceTool">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tool that created/modified this file</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://cimbology.com/ontology/kg#span">
    <rdfs:comment xml:lang="en">Reference to the cimbology:PrimarySpan or cimbology:ServiceSpan this result applies to.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#SagTensionResult" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Span</rdfs:label>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#spanClearance">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment xml:lang="en">Minimum clearance to ground/obstacles within the span in meters.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#SagTensionResult" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Span Clearance</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#spanClearanceDistance">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment xml:lang="en">Horizontal distance from the start pole to the minimum clearance point in meters.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#SagTensionResult" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Span Clearance Distance</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#spanOrder">
    <rdfs:comment xml:lang="en">Ordinal position of this span in the circuit (1-based). Used for sequential identification and reporting.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#SagTensionResult" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Span Order</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#standardsReference">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reference to an applicable standard (e.g., 'IEEE C57.12', 'IEC 62271-100').</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Standards Reference</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#startHeight">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment xml:lang="en">Conductor attachment height at the start (back) pole in meters above ground.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#SagTensionResult" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Start Height</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#startHorizontalLoad">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/N" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Force" />
    <rdfs:comment xml:lang="en">Horizontal load component at the start support in newtons.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#SagTensionResult" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Start Horizontal Load</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#startTension">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/N" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Force" />
    <rdfs:comment xml:lang="en">Conductor tension at the start (back) support point in newtons.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#SagTensionResult" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Start Tension</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#startVerticalLoad">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/N" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Force" />
    <rdfs:comment xml:lang="en">Vertical load component at the start support in newtons.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#SagTensionResult" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Start Vertical Load</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#station">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment xml:lang="en">Station position along the distribution line in meters from the starting reference point. Canonical SI stationing property — application lenses add imperial companions (e.g., cad:stationFt) for round-trip fidelity.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Station</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#status">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Current operational status (e.g., 'In Service', 'Retired', 'Planned').</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Status</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#strengthFactor">
    <rdfs:comment xml:lang="en">Strength reduction factor per NESC §261. Applied to pole and crossarm rated strength (e.g., 0.65 for Grade B wood poles).</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Strength Factor</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#structureType">
    <rdfs:comment xml:lang="en">Structure location or installation type (e.g., 'above ground', 'underground', 'overhead'). Applies to distribution poles, substation structures, HV cable routes, and civil infrastructure alike.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Structure Type</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#stubAttachmentHeight">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment xml:lang="en">Default stub guy attachment height in meters. Typical default: ~16.01 ft = 4.88 m.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Stub Attachment Height</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#substationName">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Name of the substation containing this equipment.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Substation Name</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#supportConstruction">
    <rdfs:comment xml:lang="en">Support structure construction style (e.g., 'single', 'grid', 'couple', 'A shape', 'on roof', 'wood').</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Support Construction</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#surfaceType">
    <rdfs:comment xml:lang="en">Type of surface or facility over which clearance is measured (e.g., 'Ground', 'Road', 'Railroad', 'Building', 'Swimming Pool').</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ClearanceCheck" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Surface Type</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#swbpSafetyFactor">
    <rdfs:comment xml:lang="en">Safety factor applied to sidewall bearing pressure (SWBP) at conduit bends. Typical default: 1.0.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SWBP Safety Factor</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#switchOffVoltage">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloV" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Voltage" />
    <rdfs:comment xml:lang="en">Capacitor control setpoint voltage in kilovolts at which the bank switches off. Separate on/off thresholds prevent hunting and must survive interchange between distribution design tools.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Switch Off Voltage</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#switchOnVoltage">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloV" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Voltage" />
    <rdfs:comment xml:lang="en">Capacitor control setpoint voltage in kilovolts at which the bank switches on. Distribution tools commonly store explicit on/off thresholds for capacitor automation; CIM only provides the broader regulating-control concept.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Switch On Voltage</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#switchType">
    <rdfs:comment xml:lang="en">Type of distribution switch (e.g., 'disconnect', 'airbreak', 'line tension', 'load break elbow', 'solid blade'). CIM models switches via cim:Switch subtypes (LoadBreakSwitch, Disconnector); CIMBOLOGY-KG captures the switch form factor for design and catalog resolution.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Switch Type</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <rdfs:seeAlso rdf:resource="http://iec.ch/TC57/CIM100#Switch" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#tapChangerCycleCount">
    <rdfs:comment xml:lang="en">Maintenance counter recording the number of tap-change operations. Used by both distribution utilities (voltage regulators) and substation engineers (on-load tap changers on power transformers) to schedule inspection or rebuild work.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tap Changer Cycle Count</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer" />
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://cimbology.com/ontology/kg#target">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The target/to object URI - points to the destination node of a relation</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#Relation" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#tensionPctRbs">
    <rdfs:comment xml:lang="en">Tension as a percentage of rated breaking strength (0–100). Must not exceed cimbology:maxTensionPctRbs from the design criteria.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tension Percent RBS</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#thermalExpansionCoeff">
    <rdfs:comment xml:lang="en">Coefficient of linear thermal expansion in per-degree Celsius (1/°C). Required for temperature-dependent catenary calculations (distribution overhead, substation strain bus) and for rigid bus expansion fitting design (IEEE 605). Source: ASTM B232 and manufacturer data.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Thermal Expansion Coeff</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#timeOff">
    <rdfs:comment xml:lang="en">Time-of-day at which a switched capacitor is scheduled to turn off, formatted as HH:MM. Needed for time-clock control schemes.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Time Off</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#timeOn">
    <rdfs:comment xml:lang="en">Time-of-day at which a switched capacitor is scheduled to turn on, formatted as HH:MM. Needed for time-clock control schemes.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Time On</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <rdf:Property rdf:about="https://cimbology.com/ontology/kg#toolCategory">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The tool-specific category or library to search (e.g., 'Electrical Equipment').</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tool Category</rdfs:label>
  </rdf:Property>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#toolConnectorName">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tool-assigned name for a connector point on equipment. Unique within the family/type where it is created.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tool Connector Name</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#toolFormatVersion">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Version of the tool-specific data format (e.g., CAD/BIM tool data format version). Distinct from cimbology:formatVersion which tracks the CIMBOLOGY-KG file format version.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tool Format Version</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#toolName">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <rdf:Property rdf:about="https://cimbology.com/ontology/kg#toolParameter">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Maps a CIM/CIMBOLOGY-KG property to a tool-specific parameter name (e.g., 'Rated Volts').</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tool Parameter</rdfs:label>
  </rdf:Property>
  <rdf:Property rdf:about="https://cimbology.com/ontology/kg#toolValueMap">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Maps CIM/CIMBOLOGY-KG property values to tool-specific values (e.g., 'spring' -&gt; 'SpringOp').</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tool Value Map</rdfs:label>
  </rdf:Property>
  <owl:AnnotationProperty rdf:about="https://cimbology.com/ontology/kg#toolValueUnit">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unit of measure a specific tool uses for this property. Use a QUDT unit URI when the tool stores values in a non-canonical unit requiring conversion.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tool Value Unit</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource" />
  </owl:AnnotationProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#toolVersion">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#totalVerticalLoad">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/N" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Force" />
    <rdfs:comment xml:lang="en">Total vertical load on the pole in newtons (sum of conductor weight, equipment weight, and ice loading). Checked against cimbology:maxVerticalLoad.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#PoleLoadResult" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Total Vertical Load</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#transform">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">4x4 placement matrix as 16 floats, row-major. Translation in m03,m13,m23.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON" />
    <cimbology:firstClassProperty rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</cimbology:firstClassProperty>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#transformerConnection">
    <rdfs:comment xml:lang="en">Transformer winding connection type in utility-notation string (e.g., 'Single-Phase', 'Wye-Wye', 'Delta-Wye', 'Open-Delta'). CIM models this via cim:TransformerEnd.connectionKind (WindingConnection enum). CIMBOLOGY-KG uses a string to accommodate utility naming conventions. Note: IEC vector group notation (Dyn11, YNd1) is captured separately in cimbology:vectorGroup.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Transformer Connection</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <rdfs:seeAlso rdf:resource="http://iec.ch/TC57/CIM100#PowerTransformer" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#transformerDemandValue">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloW" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Power" />
    <rdfs:comment xml:lang="en">Transformer demand captured in the voltage-drop result set in kilowatts. Needed to exchange the load value actually used in the transformer portion of the study.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#VoltageDropResult" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Transformer Demand Value</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#transformerImpedancePct">
    <rdfs:comment xml:lang="en">Transformer impedance as a percentage of rated. Used for fault current and voltage drop calculations in both distribution and substation contexts. CIM models this as cim:TransformerEnd.x (per-unit reactance); CIMBOLOGY-KG uses percentage because transformer test reports universally express it as %Z.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Transformer Impedance</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
    <rdfs:seeAlso rdf:resource="http://iec.ch/TC57/CIM100#PowerTransformer" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#transformerKva">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloV-A" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/ApparentPower" />
    <rdfs:comment xml:lang="en">Transformer rated capacity in kilovolt-amperes. CIM models this as cim:PowerTransformerEnd.ratedS (in VA). CIMBOLOGY-KG uses kVA because utility transformers are universally specified in kVA on nameplates (distribution: 25, 50, 100, 167, 250; substation: 500, 1000, 5000 etc.).</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Transformer kVA</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
    <rdfs:seeAlso rdf:resource="http://iec.ch/TC57/CIM100#PowerTransformer" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#transformerMounting">
    <rdfs:comment xml:lang="en">Transformer mounting style (e.g., 'Pole-Mounted', 'Pad-Mounted', 'Submersible', 'Vault').</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Transformer Mounting</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#transformerPctReactance">
    <rdfs:comment xml:lang="en">Transformer percent reactance from factory test data — the reactive component of percent impedance (%Z). Any tool performing fault current or power flow analysis needs %R and %X separately rather than only total %Z. Applies to both distribution and substation transformers. CIM models this via cim:TransformerEnd.x (per-unit). CIMBOLOGY-KG uses percentage to match ANSI C57.12 nameplate convention.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Transformer % Reactance</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
    <rdfs:seeAlso rdf:resource="http://iec.ch/TC57/CIM100#PowerTransformer" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#transformerPctResistance">
    <rdfs:comment xml:lang="en">Transformer percent resistance from factory test data — the resistive component of percent impedance (%Z). Used with cimbology:transformerPctReactance to compute total %Z = sqrt(%R² + %X²). Applies to both distribution and substation transformers. Source: transformer factory test report per ANSI C57.12.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Transformer % Resistance</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
    <rdfs:seeAlso rdf:resource="http://iec.ch/TC57/CIM100#PowerTransformer" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#transformerPhaseCount">
    <rdfs:comment xml:lang="en">Number of phases for this transformer (1 for single-phase, 3 for three-phase). Distinct from cimbology:phaseCount (general-purpose phase count for any resource) — this property is scoped to distribution transformer catalog entries where the phase count drives winding configuration. CIM models this via cim:PowerTransformerEnd.phaseCode.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Transformer Phase Count</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer" />
    <rdfs:seeAlso rdf:resource="http://iec.ch/TC57/CIM100#PowerTransformer" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#transformerType">
    <rdfs:comment xml:lang="en">Transformer configuration type (e.g., 'Radial', 'Looped', 'Csp', 'Conventional'). Describes the transformer design topology.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Transformer Type</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <rdfs:seeAlso rdf:resource="http://iec.ch/TC57/CIM100#PowerTransformer" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#transverseMoment">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/N-M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Torque" />
    <rdfs:comment xml:lang="en">Transverse component of the applied ground-line moment in newton-meters (perpendicular to the line direction).</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#PoleLoadResult" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Transverse Moment</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#transverseMomentDirection">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/DEG" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Angle" />
    <rdfs:comment xml:lang="en">Direction of the transverse moment component in degrees from true north.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#PoleLoadResult" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Transverse Moment Direction</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#tripUnitType">
    <rdfs:comment xml:lang="en">Trip unit technology or protection package in the breaker (for example 'electronic', 'thermal-magnetic', 'hydraulic'). This matters to distribution protection behavior even when interrupting rating is unchanged.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Trip Unit Type</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#twoCableFrThreshold">
    <rdfs:comment xml:lang="en">Maximum fill ratio for two cables in a duct (dimensionless, 0–1). NEMA/ICEA guideline: 0.31. Typical default: 0.31.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Two Cable FR Threshold</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#unguyedMoment">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/N-M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Torque" />
    <rdfs:comment xml:lang="en">Applied ground-line moment before guy relief in newton-meters. If this exceeds the pole's strength-factored capacity, guying is required.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#PoleLoadResult" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unguyed Moment</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#vaDensity">
    <rdfs:comment xml:lang="en">Load density in VA per square meter. Used for commercial load estimation when per-category breakdown is unavailable. Imperial equivalent: VA/sq ft (conversion: VA/sqft × 10.7639 = VA/m²).</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ServicePoint" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">VA Density</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#vdPhase">
    <rdfs:comment xml:lang="en">Phase designation for this voltage drop result (e.g., 'A', 'B', 'C', 'AB', 'ABC').</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#VoltageDropResult" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">VD Phase</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#vdPowerFactor">
    <rdfs:comment xml:lang="en">Power factor used in voltage drop calculations. Typical default: 0.9.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">VD Power Factor</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#vdSafetyFactorWire">
    <rdfs:comment xml:lang="en">Safety factor applied to wire voltage drop results before comparing to limit. Typical default: 1.0.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wire VD Safety Factor</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#vdSafetyFactorXmfr">
    <rdfs:comment xml:lang="en">Safety factor applied to transformer voltage drop results. Typical default: 1.0.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Xmfr VD Safety Factor</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#vdWireAndTransformerPct">
    <rdfs:comment xml:lang="en">Total voltage drop through conductors plus transformer as a percentage of nominal voltage.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#VoltageDropResult" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wire+Transformer Voltage Drop (%)</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#vdWireOnlyPct">
    <rdfs:comment xml:lang="en">Voltage drop through conductors only (excluding transformer) as a percentage of nominal voltage.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#VoltageDropResult" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wire Voltage Drop (%)</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#verticalSpan">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment xml:lang="en">Elevation difference between adjacent attachment points in meters (positive = uphill).</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Vertical Span</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#voltageRating">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloV" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Voltage" />
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rated voltage in kV. Simplified flat property; CIM models voltage via complex measurement objects.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Voltage Rating</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#volume">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M3" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Volume" />
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">3D bounding volume of the equipment in cubic meters.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Volume</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#wallThickness">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wall thickness of a tubular bus bar, in meters.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wall Thickness</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#waterheatDemandFactor">
    <rdfs:comment xml:lang="en">Demand factor for water heating loads (0–1). Typical default: 0.5.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ServicePoint" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Water Heat Demand Factor</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#waterheatLoad1ph">
    <rdfs:comment xml:lang="en">Single-phase connected water heating load in kW. Typical default: 0.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ServicePoint" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Water Heat Load 1PH</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#waterheatLoad3ph">
    <rdfs:comment xml:lang="en">Three-phase connected water heating load in kW. Typical default: 0.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ServicePoint" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Water Heat Load 3PH</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#waterheatOprDaysPerMon">
    <rdfs:comment xml:lang="en">Water heating operating days per month. Typical default: 21.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ServicePoint" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Water Heat Opr Days/Month</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#waterheatPctOprHours">
    <rdfs:comment xml:lang="en">Fraction of daily operating hours water heating runs (0–1). Typical default: 0.5.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ServicePoint" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Water Heat % Opr Hours</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#weight">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/LB" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Mass" />
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Equipment weight (units specified by value, e.g., '450 kg').</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Weight</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#weightSpan">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment xml:lang="en">Weight span in meters — the horizontal distance over which conductor weight is supported by this pole.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Weight Span</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#width">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bounding-box width of the equipment in metres (X-axis).</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Width</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#windMoment">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/N-M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Torque" />
    <rdfs:comment xml:lang="en">Ground-line moment contribution from wind on the pole body in newton-meters.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#PoleLoadResult" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wind Moment</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#windPressure">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PA" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Pressure" />
    <rdfs:comment xml:lang="en">Design wind pressure in pascals. NESC §250B defines default values per loading district (e.g., 430 Pa for Heavy district).</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wind Pressure</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#windSpan">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment xml:lang="en">Wind span in meters — the horizontal distance over which wind load is applied to this pole (average of adjacent horizontal spans).</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wind Span</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#wireNumber">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wire number or conductor identifier within a cable bundle or conduit run.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wire Number</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#wireResultantLoad">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/N" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Force" />
    <rdfs:comment xml:lang="en">Resultant wire load (vector sum of vertical and horizontal loads) in newtons.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#SagTensionResult" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wire Resultant Load</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#workPlane">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CAD/BIM work plane or reference plane on which this element was placed.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Work Plane</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#worstPointStation">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length" />
    <rdfs:comment xml:lang="en">Station of the worst-case clearance point along the span in meters.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#ClearanceCheck" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Worst Point Station</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#x">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/OHM" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Reactance" />
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Positive sequence series reactance, in ohms. Optional. Mirrors cim:ACLineSegment.x. Absent unless an explicit value is provided by the designer.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Positive Sequence Series Reactance</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#x0">
    <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/OHM" />
    <qudt:quantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Reactance" />
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Zero sequence series reactance, in ohms. Optional. Mirrors cim:ACLineSegment.x0. Absent unless an explicit value is provided by the designer.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Zero Sequence Series Reactance</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#yearBuilt">
    <rdfs:comment xml:lang="en">Year the asset was originally installed. Applies to poles, substation equipment, cables, and any field asset in any domain. Used for age-based calculations (strength reduction, depreciation, replacement planning). CIM equivalent: cim:Asset.installationDate (date form).</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Year Built</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://cimbology.com/ontology/kg#yearsOfGrowth">
    <rdfs:comment xml:lang="en">Load growth projection period in years for conductor sizing. Typical default: 10.</rdfs:comment>
    <rdfs:domain rdf:resource="https://cimbology.com/ontology/kg#DistributionCriteria" />
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Years of Growth</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer" />
  </owl:DatatypeProperty>
</rdf:RDF>
