cim:FailureEvent a owl:Class;
                 rdfs:comment "An event where an asset has failed to perform its functions within specified parameters. This class is intended to reflect the failure itself. Additional information resulting from forensic analysis could be captured by a diagnosis data set."@en;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                 rdfs:label "FailureEvent"@en;
