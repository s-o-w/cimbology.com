                           rdfs:comment "The variable portion of this charge element, calculated as a percentage of the total amount of a parent charge."@en;
                           rdfs:domain cim:Charge;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                           rdfs:label "variablePortion"@en;
                           rdfs:range cim:PerCent.
cim:ChargeKind a owl:Class;
               rdfs:comment "Kind of charge."@en;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
               rdfs:label "ChargeKind"@en;
               owl:equivalentClass [a owl:Class ; 
                                    owl:oneOf (cim:ChargeKind.auxiliaryCharge
                                               cim:ChargeKind.consumptionCharge
                                               cim:ChargeKind.demandCharge
                                               cim:ChargeKind.other
                                               cim:ChargeKind.taxCharge)];
               cimdoc:cimPackage "IEC61968.PaymentMetering";
               cimdoc:packageTier "Normative".
cim:ChargeKind.auxiliaryCharge a owl:NamedIndividual,
                                 cim:ChargeKind;
                               rdfs:comment "Any other charge which is not a consumptionCharge or demandCharge. For example: debt recovery, arrears, standing charge or charge for another service such as street lighting."@en;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                               rdfs:label "auxiliaryCharge"@en;
                               cimdoc:enumCode 2 .
cim:ChargeKind.consumptionCharge a owl:NamedIndividual,
                                   cim:ChargeKind;
                                 rdfs:comment "The charge levied for the actual usage of the service, normally expressed in terms of a tariff. For example: usage x price per kWh = total charge for consumption."@en;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                 rdfs:label "consumptionCharge"@en;
                                 cimdoc:enumCode 0 .
cim:ChargeKind.demandCharge a owl:NamedIndividual,
                              cim:ChargeKind;
                            rdfs:comment "The charge related to the usage within a defined time interval, normally expressed in terms of a tariff. For example: a maximum-demand tariff will levy an additional charge on top of the consumption charge if the usage exceeds a defined limit per hour."@en;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                            rdfs:label "demandCharge"@en;
                            cimdoc:enumCode 1 .
cim:ChargeKind.other a owl:NamedIndividual,
                       cim:ChargeKind;
                     rdfs:comment "Other kind of charge."@en;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                     rdfs:label "other"@en;
                     cimdoc:enumCode 4 .
cim:ChargeKind.taxCharge a owl:NamedIndividual,
                           cim:ChargeKind;
                         rdfs:comment "Any charge that is classified as a tax of a kind. For example: VAT, GST, TV tax, etc."@en;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                         rdfs:label "taxCharge"@en;
                         cimdoc:enumCode 3 .
cim:Cheque a owl:Class;
           rdfs:comment "The actual tender when it is a type of cheque."@en;
           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
           rdfs:label "Cheque"@en;
