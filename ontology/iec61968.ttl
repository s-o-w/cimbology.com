cim:QualificationRequirement.qualificationID a owl:DatatypeProperty;
                                             rdfs:comment "Qualification identifier."@en;
                                             rdfs:domain cim:QualificationRequirement;
                                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                             rdfs:label "qualificationID"@en;
                                             rdfs:range xsd:string.
cim:RandomisationKind a owl:Class;
                      rdfs:comment "Kind of randomisation to be applied to control the timing of end device control commands and/or the definition of demand response and load control events. Value other than 'none' is typically used to mitigate potential deleterious effects of simultaneous operation of multiple devices."@en;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                      rdfs:label "RandomisationKind"@en;
                      owl:equivalentClass [a owl:Class ; 
                                           owl:oneOf (cim:RandomisationKind.default
                                                      cim:RandomisationKind.end
                                                      cim:RandomisationKind.none
                                                      cim:RandomisationKind.start
                                                      cim:RandomisationKind.startAndEnd)];
                      cimdoc:cimPackage "IEC61968.Metering";
                      cimdoc:packageTier "Normative".
cim:RandomisationKind.default a owl:NamedIndividual,
                                cim:RandomisationKind;
                              rdfs:comment "Randomisation of start and/or end times involving the operation of one or more devices is controlled by default settings for the device(s)."@en;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                              rdfs:label "default"@en;
                              cimdoc:enumCode 3 .
cim:RandomisationKind.end a owl:NamedIndividual,
                            cim:RandomisationKind;
                          rdfs:comment "End time of an event or control action affecting one or more devices is randomised to prevent simultaneous operation."@en;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                          rdfs:label "end"@en;
                          cimdoc:enumCode 1 .
cim:RandomisationKind.none a owl:NamedIndividual,
                             cim:RandomisationKind;
                           rdfs:comment "Neither the start time nor the end time of an event or control action affecting one or more devices is randomised."@en;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                           rdfs:label "none"@en;
                           cimdoc:enumCode 4 .
cim:RandomisationKind.start a owl:NamedIndividual,
                              cim:RandomisationKind;
                            rdfs:comment "Start time of an event or control action affecting one or more multiple devices is randomised."@en;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                            rdfs:label "start"@en;
                            cimdoc:enumCode 0 .
cim:RandomisationKind.startAndEnd a owl:NamedIndividual,
                                    cim:RandomisationKind;
                                  rdfs:comment "Both the start time and the end time of an event or control action affecting one or more devices are randomised to prevent simultaneous operation."@en;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                  rdfs:label "startAndEnd"@en;
                                  cimdoc:enumCode 2 .
cim:Ratio a owl:Class;
          rdfs:comment "Fraction specified explicitly with a numerator and denominator, which can be used to calculate the quotient."@en;
          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
          rdfs:label "Ratio"@en;
          cimdoc:cimPackage "IEC61968.InfIEC61968.InfCommon";
          cimdoc:packageTier "Informative".
cim:Ratio.denominator a owl:DatatypeProperty;
                      rdfs:comment "The part of a fraction that is below the line and that functions as the divisor of the numerator."@en;
                      rdfs:domain cim:Ratio;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                      rdfs:label "denominator"@en;
                      rdfs:range xsd:float.
cim:Ratio.numerator a owl:DatatypeProperty;
                    rdfs:comment "The part of a fraction that is above the line and signifies the number to be divided by the denominator."@en;
                    rdfs:domain cim:Ratio;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                    rdfs:label "numerator"@en;
                    rdfs:range xsd:float.
cim:RationalNumber a owl:Class;
                   rdfs:comment "Rational number = 'numerator' / 'denominator'."@en;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                   rdfs:label "RationalNumber"@en;
                   cimdoc:cimPackage "IEC61968.Metering";
                   cimdoc:packageTier "Normative".
cim:RationalNumber.denominator a owl:DatatypeProperty;
                               rdfs:comment "Denominator. Value 1 indicates the number is a simple integer."@en;
                               rdfs:domain cim:RationalNumber;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                               rdfs:label "denominator"@en;
                               rdfs:range xsd:integer.
cim:RationalNumber.numerator a owl:DatatypeProperty;
                             rdfs:comment "Numerator."@en;
                             rdfs:domain cim:RationalNumber;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                             rdfs:label "numerator"@en;
                             rdfs:range xsd:integer.
cim:Reading a owl:Class;
            rdfs:comment "Specific value measured by a meter or other asset, or calculated by a system. Each Reading is associated with a specific ReadingType."@en;
            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
            rdfs:label "Reading"@en;
            rdfs:subClassOf cim:BaseReading;
            cimdoc:cimPackage "IEC61968.Metering";
            cimdoc:packageTier "Normative".
cim:Reading.MeterReadings a owl:ObjectProperty;
                          rdfs:comment "All meter readings (sets of values) containing this reading value."@en;
                          rdfs:domain cim:Reading;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                          rdfs:label "MeterReadings"@en;
                          rdfs:range cim:MeterReading.
cim:Reading.ReadingType a owl:ObjectProperty;
                        rdfs:comment "Type information for this reading value."@en;
                        rdfs:domain cim:Reading;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                        rdfs:label "ReadingType"@en;
                        rdfs:range cim:ReadingType.
cim:Reading.position a owl:DatatypeProperty;
                     rdfs:comment "A sequential value representing the relative position within a given time interval."@en;
                     rdfs:domain cim:Reading;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                     rdfs:label "position"@en;
                     rdfs:range xsd:integer.
cim:Reading.reason a owl:ObjectProperty;
                   rdfs:comment "Reason for this reading being taken."@en;
                   rdfs:domain cim:Reading;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                   rdfs:label "reason"@en;
                   rdfs:range cim:ReadingReasonKind.
cim:Reading.valueMissing a owl:DatatypeProperty;
                         rdfs:comment "The indication of whether or not the quantity of this reading is missing."@en;
                         rdfs:domain cim:Reading;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                         rdfs:label "valueMissing"@en;
                         rdfs:range xsd:boolean.
cim:ReadingInterharmonic a owl:Class;
                         rdfs:comment "Interharmonics are represented as a rational number 'numerator' / 'denominator', and harmonics are represented using the same mechanism and identified by 'denominator'=1."@en;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                         rdfs:label "ReadingInterharmonic"@en;
                         cimdoc:cimPackage "IEC61968.Metering";
                         cimdoc:packageTier "Normative".
cim:ReadingInterharmonic.denominator a owl:DatatypeProperty;
                                     rdfs:comment "Interharmonic denominator. Value 0 means not applicable. Value 2 is used in combination with 'numerator'=1 to represent interharmonic 1/2. Finally, value 1 indicates the harmonic of the order specified with 'numerator'."@en;
                                     rdfs:domain cim:ReadingInterharmonic;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                     rdfs:label "denominator"@en;
                                     rdfs:range xsd:integer.
cim:ReadingInterharmonic.numerator a owl:DatatypeProperty;
                                   rdfs:comment "Interharmonic numerator. Value 0 means not applicable. Value 1 is used in combination with 'denominator'=2 to represent interharmonic 1/2, and with 'denominator'=1 it represents fundamental frequency. Finally, values greater than 1 indicate the harmonic of that order (e.g., 'numerator'=5 is the fifth harmonic)."@en;
                                   rdfs:domain cim:ReadingInterharmonic;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                   rdfs:label "numerator"@en;
                                   rdfs:range xsd:integer.
cim:ReadingQuality a owl:Class;
                   rdfs:comment "Quality of a specific reading value or interval reading value. Note that more than one quality may be applicable to a given reading. Typically not used unless problems or unusual conditions occur (i.e., quality for each reading is assumed to be good unless stated otherwise in associated reading quality type). It can also be used with the corresponding reading quality type to indicate that the validation has been performed and succeeded."@en;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                   rdfs:label "ReadingQuality"@en;
                   cimdoc:cimPackage "IEC61968.Metering";
                   cimdoc:packageTier "Normative".
cim:ReadingQuality.Reading a owl:ObjectProperty;
                           rdfs:comment "Reading value to which this quality applies."@en;
                           rdfs:domain cim:ReadingQuality;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                           rdfs:label "Reading"@en;
                           rdfs:range cim:BaseReading.
cim:ReadingQuality.ReadingQualityType a owl:ObjectProperty;
                                      rdfs:comment "Type of this reading quality."@en;
                                      rdfs:domain cim:ReadingQuality;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                      rdfs:label "ReadingQualityType"@en;
                                      rdfs:range cim:ReadingQualityType.
cim:ReadingQuality.comment a owl:DatatypeProperty;
                           rdfs:comment "Elaboration on the quality code."@en;
                           rdfs:domain cim:ReadingQuality;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                           rdfs:label "comment"@en;
                           rdfs:range xsd:string.
cim:ReadingQuality.source a owl:DatatypeProperty;
                          rdfs:comment "System acting as the source of the quality code."@en;
                          rdfs:domain cim:ReadingQuality;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                          rdfs:label "source"@en;
                          rdfs:range xsd:string.
cim:ReadingQuality.timeStamp a owl:DatatypeProperty;
                             rdfs:comment "Date and time at which the quality code was assigned or ascertained."@en;
                             rdfs:domain cim:ReadingQuality;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                             rdfs:label "timeStamp"@en;
                             rdfs:range xsd:dateTime.
cim:ReadingQualityType a owl:Class;
                       rdfs:comment "Detailed description for a quality of a reading value, produced by an end device or a system. Values in attributes allow for creation of the recommended codes to be used for identifying reading value quality codes as follows: systemId.category.subCategory."@en;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                       rdfs:label "ReadingQualityType"@en;
                       rdfs:subClassOf cim:IdentifiedObject;
                       cimdoc:cimPackage "IEC61968.Metering";
                       cimdoc:packageTier "Normative".
cim:ReadingQualityType.category a owl:DatatypeProperty;
                                rdfs:comment "High-level nature of the reading value quality."@en;
                                rdfs:domain cim:ReadingQualityType;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                rdfs:label "category"@en;
                                rdfs:range xsd:string.
cim:ReadingQualityType.subCategory a owl:DatatypeProperty;
                                   rdfs:comment "More specific nature of the reading value quality, as a further sub- categorisation of 'category'."@en;
                                   rdfs:domain cim:ReadingQualityType;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                   rdfs:label "subCategory"@en;
                                   rdfs:range xsd:string.
cim:ReadingQualityType.systemId a owl:DatatypeProperty;
                                rdfs:comment "Identification of the system which has declared the issue with the data or provided commentary on the data."@en;
                                rdfs:domain cim:ReadingQualityType;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                rdfs:label "systemId"@en;
                                rdfs:range xsd:string.
cim:ReadingReasonKind a owl:Class;
                      rdfs:comment "Reason for the reading being taken."@en;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                      rdfs:label "ReadingReasonKind"@en;
                      owl:equivalentClass [a owl:Class ; 
                                           owl:oneOf (cim:ReadingReasonKind.billing
                                                      cim:ReadingReasonKind.demandReset
                                                      cim:ReadingReasonKind.inquiry
                                                      cim:ReadingReasonKind.installation
                                                      cim:ReadingReasonKind.loadManagement
                                                      cim:ReadingReasonKind.loadResearch
                                                      cim:ReadingReasonKind.moveIn
                                                      cim:ReadingReasonKind.moveOut
                                                      cim:ReadingReasonKind.other
                                                      cim:ReadingReasonKind.removal
                                                      cim:ReadingReasonKind.serviceConnect
                                                      cim:ReadingReasonKind.serviceDisconnect)];
                      cimdoc:cimPackage "IEC61968.Metering";
                      cimdoc:packageTier "Normative".
cim:ReadingReasonKind.billing a owl:NamedIndividual,
                                cim:ReadingReasonKind;
                              rdfs:comment "Reading(s) taken or to be taken in response to a billing-related inquiry by a customer or other party. A variant of 'inquiry'."@en;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                              rdfs:label "billing"@en;
                              cimdoc:enumCode 3 .
cim:ReadingReasonKind.demandReset a owl:NamedIndividual,
                                    cim:ReadingReasonKind;
                                  rdfs:comment "Reading(s) taken or to be taken in conjunction with the resetting of one or more demand registers in a meter."@en;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                  rdfs:label "demandReset"@en;
                                  cimdoc:enumCode 6 .
cim:ReadingReasonKind.inquiry a owl:NamedIndividual,
                                cim:ReadingReasonKind;
                              rdfs:comment "Reading(s) taken or to be taken in response to an inquiry by a customer or other party."@en;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                              rdfs:label "inquiry"@en;
                              cimdoc:enumCode 2 .
cim:ReadingReasonKind.installation a owl:NamedIndividual,
                                     cim:ReadingReasonKind;
                                   rdfs:comment "Reading(s) taken or to be taken in conjunction with installation of a meter."@en;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                   rdfs:label "installation"@en;
                                   cimdoc:enumCode 0 .
cim:ReadingReasonKind.loadManagement a owl:NamedIndividual,
                                       cim:ReadingReasonKind;
                                     rdfs:comment "Reading(s) taken or to be taken to support management of loads on distribution networks or devices."@en;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                     rdfs:label "loadManagement"@en;
                                     cimdoc:enumCode 9 .
cim:ReadingReasonKind.loadResearch a owl:NamedIndividual,
                                     cim:ReadingReasonKind;
                                   rdfs:comment "Reading(s) taken or to be taken to support research and analysis of loads on distribution networks or devices."@en;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                   rdfs:label "loadResearch"@en;
                                   cimdoc:enumCode 10 .
cim:ReadingReasonKind.moveIn a owl:NamedIndividual,
                               cim:ReadingReasonKind;
                             rdfs:comment "Reading(s) taken or to be taken in conjunction with a customer move-in event."@en;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                             rdfs:label "moveIn"@en;
                             cimdoc:enumCode 4 .
cim:ReadingReasonKind.moveOut a owl:NamedIndividual,
                                cim:ReadingReasonKind;
                              rdfs:comment "Reading(s) taken or to be taken in conjunction with a customer move-out event."@en;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                              rdfs:label "moveOut"@en;
                              cimdoc:enumCode 5 .
cim:ReadingReasonKind.other a owl:NamedIndividual,
                              cim:ReadingReasonKind;
                            rdfs:comment "Reading(s) taken or to be taken for some other reason or purpose."@en;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                            rdfs:label "other"@en;
                            cimdoc:enumCode 11 .
cim:ReadingReasonKind.removal a owl:NamedIndividual,
                                cim:ReadingReasonKind;
                              rdfs:comment "Reading(s) taken or to be taken in conjunction with removal of a meter."@en;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                              rdfs:label "removal"@en;
                              cimdoc:enumCode 1 .
cim:ReadingReasonKind.serviceConnect a owl:NamedIndividual,
                                       cim:ReadingReasonKind;
                                     rdfs:comment "Reading(s) taken or to be taken in conjunction with a connection or re- connection of service."@en;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                     rdfs:label "serviceConnect"@en;
                                     cimdoc:enumCode 8 .
cim:ReadingReasonKind.serviceDisconnect a owl:NamedIndividual,
                                          cim:ReadingReasonKind;
                                        rdfs:comment "Reading(s) taken or to be taken in conjunction with a disconnection of service."@en;
                                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                        rdfs:label "serviceDisconnect"@en;
                                        cimdoc:enumCode 7 .
cim:ReadingType a owl:Class;
                rdfs:comment "Detailed description for a type of a reading value. Values in attributes allow for the creation of recommended codes to be used for identifying reading value types as follows: macroPeriod.aggregate.measuringPeriod.accumulation. flowDirection.commodity.measurementKind.interharmonic.numerator. interharmonic.denominator.argument.numerator.argument.denominator.tou. cpp.consumptionTier.phases.multiplier.unit.currency."@en;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                rdfs:label "ReadingType"@en;
                rdfs:subClassOf cim:IdentifiedObject;
                cimdoc:cimPackage "IEC61968.Metering";
                cimdoc:packageTier "Normative".
cim:ReadingType.Channel a owl:ObjectProperty;
                        rdfs:comment "Channel reporting/collecting register values with this type information."@en;
                        rdfs:domain cim:ReadingType;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                        rdfs:label "Channel"@en;
                        rdfs:range cim:Channel.
cim:ReadingType.accumulation a owl:ObjectProperty;
                             rdfs:comment "Accumulation behaviour of a reading over time, usually 'measuringPeriod', to be used with individual endpoints (as opposed to 'macroPeriod' and 'aggregate' that are used to describe aggregations of data from individual endpoints)."@en;
                             rdfs:domain cim:ReadingType;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                             rdfs:label "accumulation"@en;
                             rdfs:range cim:AccumulationKind.
cim:ReadingType.aggregate a owl:ObjectProperty;
                          rdfs:comment "Salient attribute of the reading data aggregated from individual endpoints. This is mainly used to define a mathematical operation carried out over 'macroPeriod', but may also be used to describe an attribute of the data when the 'macroPeriod' is not defined."@en;
                          rdfs:domain cim:ReadingType;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                          rdfs:label "aggregate"@en;
                          rdfs:range cim:AggregateKind.
cim:ReadingType.argument a owl:ObjectProperty;
                         rdfs:comment "Argument used to introduce numbers into the unit of measure description where they are needed (e.g., 4 where the measure needs an argument such as CEMI(n=4)). Most arguments used in practice however will be integers (i.e., 'denominator'=1). Value 0 in 'numerator' and 'denominator' means not applicable."@en;
                         rdfs:domain cim:ReadingType;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                         rdfs:label "argument"@en;
                         rdfs:range cim:RationalNumber.
cim:ReadingType.commodity a owl:ObjectProperty;
                          rdfs:comment "Commodity being measured."@en;
                          rdfs:domain cim:ReadingType;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                          rdfs:label "commodity"@en;
                          rdfs:range cim:CommodityKind.
cim:ReadingType.consumptionTier a owl:DatatypeProperty;
                                rdfs:comment """In case of common flat-rate pricing for power, in which all purchases are at a given rate, 'consumptionTier'=0. Otherwise, the value indicates the consumption tier, which can be used in conjunction with TOU or CPP pricing. Consumption tier pricing refers to the method of billing in which a certain \"block\" of energy is purchased/sold at one price, after which the next block of energy is purchased at another price, and so on, all throughout a defined period. At the start of the defined period, consumption is initially zero, and any usage is measured against the first consumption tier ('consumptionTier'=1). If this block of energy is consumed before the end of the period, energy consumption moves to be reconed against the second consumption tier ('consumptionTier'=2), and so on. At the end of the defined period, the consumption accumulator is reset, and usage within the 'consumptionTier'=1 restarts."""@en;
                                rdfs:domain cim:ReadingType;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                rdfs:label "consumptionTier"@en;
                                rdfs:range xsd:integer.
cim:ReadingType.cpp a owl:DatatypeProperty;
                    rdfs:comment "Critical peak period (CPP) bucket the reading value is attributed to. Value 0 means not applicable. Even though CPP is usually considered a specialised form of time of use 'tou', this attribute is defined explicitly for flexibility."@en;
                    rdfs:domain cim:ReadingType;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                    rdfs:label "cpp"@en;
                    rdfs:range xsd:integer.
cim:ReadingType.currency a owl:ObjectProperty;
                         rdfs:comment "Metering-specific currency."@en;
                         rdfs:domain cim:ReadingType;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                         rdfs:label "currency"@en;
                         rdfs:range cim:Currency.
cim:ReadingType.flowDirection a owl:ObjectProperty;
                              rdfs:comment "Flow direction for a reading where the direction of flow of the commodity is important (for electricity measurements this includes current, energy, power, and demand)."@en;
                              rdfs:domain cim:ReadingType;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                              rdfs:label "flowDirection"@en;
                              rdfs:range cim:FlowDirectionKind.
cim:ReadingType.interharmonic a owl:ObjectProperty;
                              rdfs:comment """Indication of a \"harmonic\" or \"interharmonic\" basis for the measurement. Value 0 in 'numerator' and 'denominator' means not applicable."""@en;
                              rdfs:domain cim:ReadingType;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                              rdfs:label "interharmonic"@en;
                              rdfs:range cim:ReadingInterharmonic.
cim:ReadingType.macroPeriod a owl:ObjectProperty;
                            rdfs:comment "Time period of interest that reflects how the reading is viewed or captured over a long period of time."@en;
                            rdfs:domain cim:ReadingType;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                            rdfs:label "macroPeriod"@en;
                            rdfs:range cim:MacroPeriodKind.
cim:ReadingType.measurementKind a owl:ObjectProperty;
                                rdfs:comment """Identifies \"what\" is being measured, as refinement of 'commodity'. When combined with 'unit', it provides detail to the unit of measure. For example, 'energy' with a unit of measure of 'kWh' indicates to the user that active energy is being measured, while with 'kVAh' or 'kVArh', it indicates apparent energy and reactive energy, respectively. 'power' can be combined in a similar way with various power units of measure: Distortion power ('distortionVoltAmperes') with 'kVA' is different from 'power' with 'kVA'."""@en;
                                rdfs:domain cim:ReadingType;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                rdfs:label "measurementKind"@en;
                                rdfs:range cim:MeasurementKind.
cim:ReadingType.measuringPeriod a owl:ObjectProperty;
                                rdfs:comment """Time attribute inherent or fundamental to the reading value (as opposed to 'macroPeriod' that supplies an \"adjective\" to describe aspects of a time period with regard to the measurement). It refers to the way the value was originally measured and not to the frequency at which it is reported or presented. For example, an hourly interval of consumption data would have value 'hourly' as an attribute. However in the case of an hourly sampled voltage value, the meterReadings schema would carry the 'hourly' interval size information. It is common for meters to report demand in a form that is measured over the course of a portion of an hour, while enterprise applications however commonly assume the demand (in kW or kVAr) normalised to 1 hour. The system that receives readings directly from the meter therefore shall perform this transformation before publishing readings for use by the other enterprise systems. The scalar used is chosen based on the block size (not any sub- interval size)."""@en;
                                rdfs:domain cim:ReadingType;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                rdfs:label "measuringPeriod"@en;
                                rdfs:range cim:MeasuringPeriodKind.
cim:ReadingType.multiplier a owl:ObjectProperty;
                           rdfs:comment "Metering-specific multiplier."@en;
                           rdfs:domain cim:ReadingType;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                           rdfs:label "multiplier"@en;
                           rdfs:range cim:UnitMultiplier.
cim:ReadingType.phases a owl:ObjectProperty;
                       rdfs:comment "Metering-specific phase code."@en;
                       rdfs:domain cim:ReadingType;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                       rdfs:label "phases"@en;
                       rdfs:range cim:PhaseCode.
cim:ReadingType.tou a owl:DatatypeProperty;
                    rdfs:comment "Time of use (TOU) bucket the reading value is attributed to. Value 0 means not applicable."@en;
                    rdfs:domain cim:ReadingType;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                    rdfs:label "tou"@en;
                    rdfs:range xsd:integer.
cim:ReadingType.unit a owl:ObjectProperty;
                     rdfs:comment "Metering-specific unit."@en;
                     rdfs:domain cim:ReadingType;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                     rdfs:label "unit"@en;
                     rdfs:range cim:UnitSymbol.
