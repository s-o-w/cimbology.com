                                 cim:ComTechnologyKind;
                               rdfs:comment "Communicates using a public cellular radio network. A specific variant of 'rf'."@en;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                               rdfs:label "cellular"@en;
