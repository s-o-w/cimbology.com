                                                     rdfs:range xsd:boolean.
cim:RemoteConnectDisconnectInfo.needsVoltageLimitCheck a owl:DatatypeProperty;
                                                       rdfs:comment "True if voltage limit has to be checked to prevent connect if voltage is over the limit."@en;
                                                       rdfs:domain cim:RemoteConnectDisconnectInfo;
                                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
