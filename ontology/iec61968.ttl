                                                rdfs:label "AssetModelCatalogue"@en;
                                                rdfs:range cim:AssetModelCatalogue.
cim:AssetModelCatalogueItem.ErpPOLineItems a owl:ObjectProperty;
                                           rdfs:comment "The erp po line items"@en;
                                           rdfs:domain cim:AssetModelCatalogueItem;
                                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
