cim:Transaction.receiverReference a owl:DatatypeProperty;
                                  rdfs:comment "Reference to the entity that is the recipient of 'amount' (for example, supplier for service charge payment; or tax receiver for VAT)."@en;
                                  rdfs:domain cim:Transaction;
