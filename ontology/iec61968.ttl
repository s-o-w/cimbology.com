                                           rdfs:label "DERMonitorableParameter"@en;
                                           rdfs:range cim:DERMonitorableParameter.
cim:EndDeviceGroup.EndDeviceControls a owl:ObjectProperty;
                                     rdfs:comment "All end device controls sending commands to this end device group."@en;
                                     rdfs:domain cim:EndDeviceGroup;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                     rdfs:label "EndDeviceControls"@en;
                                     rdfs:range cim:EndDeviceControl.
cim:EndDeviceGroup.EndDevices a owl:ObjectProperty;
                              rdfs:comment "All end devices this end device group refers to."@en;
                              rdfs:domain cim:EndDeviceGroup;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                              rdfs:label "EndDevices"@en;
                              rdfs:range cim:EndDevice.
cim:EndDeviceGroup.status a owl:ObjectProperty;
                          rdfs:comment "Current status information relevant to a group."@en;
                          rdfs:domain cim:EndDeviceGroup;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                          rdfs:label "status"@en;
                          rdfs:range cim:Status.
cim:EndDeviceGroup.type a owl:DatatypeProperty;
                        rdfs:comment "Type of this group."@en;
                        rdfs:domain cim:EndDeviceGroup;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                        rdfs:label "type"@en;
                        rdfs:range xsd:string.
cim:EndDeviceGroup.version a owl:ObjectProperty;
                           rdfs:comment "version of this group"@en;
