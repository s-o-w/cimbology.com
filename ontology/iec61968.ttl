                                                 rdfs:range xsd:boolean.
cim:RemoteConnectDisconnectInfo.needsPowerLimitCheck a owl:DatatypeProperty;
                                                     rdfs:comment "True if load limit has to be checked to issue an immediate disconnect (after a connect) if load is over the limit."@en;
                                                     rdfs:domain cim:RemoteConnectDisconnectInfo;
                                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
