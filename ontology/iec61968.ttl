                                   rdfs:label "biDirectional"@en;
                                   cimdoc:enumCode 2 .
cim:ComDirectionKind.fromDevice a owl:NamedIndividual,
                                  cim:ComDirectionKind;
                                rdfs:comment "Communication is from device."@en;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                rdfs:label "fromDevice"@en;
                                cimdoc:enumCode 0 .
cim:ComDirectionKind.toDevice a owl:NamedIndividual,
