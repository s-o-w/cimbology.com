cim:SwitchingPlanRequest.forwardSwitchingDateTimeInterval a owl:ObjectProperty;
                                                          rdfs:comment "The date when the switching to isolate equipment is performed."@en;
                                                          rdfs:domain cim:SwitchingPlanRequest;
                                                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                                          rdfs:label "forwardSwitchingDateTimeInterval"@en;
                                                          rdfs:range cim:DateTimeInterval.
cim:SwitchingPlanRequest.groundingPoints a owl:DatatypeProperty;
                                         rdfs:comment "free-form list of equipment to be grounded or other actions to be taken in order to accomplish the required grounding."@en;
                                         rdfs:domain cim:SwitchingPlanRequest;
                                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                         rdfs:label "groundingPoints"@en;
                                         rdfs:range xsd:string.
cim:SwitchingPlanRequest.isolationArea a owl:DatatypeProperty;
                                       rdfs:comment "free-form description of the area to be isolated by the switching"@en;
                                       rdfs:domain cim:SwitchingPlanRequest;
                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                       rdfs:label "isolationArea"@en;
                                       rdfs:range xsd:string.
cim:SwitchingPlanRequest.isolationPoints a owl:DatatypeProperty;
                                         rdfs:comment "free-form list of equipment to be operated or other actions to be taken in order to accomplish the required isolation."@en;
                                         rdfs:domain cim:SwitchingPlanRequest;
                                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                         rdfs:label "isolationPoints"@en;
                                         rdfs:range xsd:string.
cim:SwitchingPlanRequest.outageDateTimeInterval a owl:ObjectProperty;
                                                rdfs:comment "The window of time during which one or more customers will be de-energized during execution of the switching plan."@en;
                                                rdfs:domain cim:SwitchingPlanRequest;
                                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                                rdfs:label "outageDateTimeInterval"@en;
                                                rdfs:range cim:DateTimeInterval.
cim:SwitchingPlanRequest.purpose a owl:DatatypeProperty;
                                 rdfs:comment "The purpose of this switching plan request."@en;
                                 rdfs:domain cim:SwitchingPlanRequest;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                 rdfs:label "purpose"@en;
