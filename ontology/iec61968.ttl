                              rdfs:label "ConnectDisconnectFunction"@en;
                              rdfs:subClassOf cim:EndDeviceFunction;
                              cimdoc:cimPackage "IEC61968.LoadControl";
                              cimdoc:packageTier "Normative".
cim:ConnectDisconnectFunction.Switches a owl:ObjectProperty;
                                       rdfs:comment "The switches"@en;
                                       rdfs:domain cim:ConnectDisconnectFunction;
                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                       rdfs:label "Switches"@en;
                                       rdfs:range cim:Switch.
cim:ConnectDisconnectFunction.eventCount a owl:DatatypeProperty;
                                         rdfs:comment "Running cumulative count of connect or disconnect events, for the lifetime of this function or until the value is cleared."@en;
                                         rdfs:domain cim:ConnectDisconnectFunction;
                                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                         rdfs:label "eventCount"@en;
