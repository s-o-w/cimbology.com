cim:ConsumptionTariffInterval a owl:Class;
                              rdfs:comment "One of a sequence of intervals defined in terms of consumption quantity of a service such as electricity, water, gas, etc. It is typically used in association with TariffProfile to define the steps or blocks in a step tariff structure, where startValue simultaneously defines the entry value of this step and the closing value of the previous step. Where consumption is greater than or equal to startValue it falls within this interval and where consumption is less than startValue it falls within the previous interval."@en;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                              rdfs:label "ConsumptionTariffInterval"@en;
                              cimdoc:cimPackage "IEC61968.PaymentMetering";
                              cimdoc:packageTier "Normative".
cim:ConsumptionTariffInterval.Charges a owl:ObjectProperty;
                                      rdfs:comment "All charges used to define this consumption tariff interval."@en;
                                      rdfs:domain cim:ConsumptionTariffInterval;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                      rdfs:label "Charges"@en;
                                      rdfs:range cim:Charge.
cim:ConsumptionTariffInterval.ReadingType a owl:ObjectProperty;
                                          rdfs:comment "Reading type for 'startValue'."@en;
                                          rdfs:domain cim:ConsumptionTariffInterval;
                                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                          rdfs:label "ReadingType"@en;
                                          rdfs:range cim:ReadingType.
cim:ConsumptionTariffInterval.TouTariffIntervals a owl:ObjectProperty;
                                                 rdfs:comment "All time of use tariff intervals influenced by this consumption tariff interval."@en;
                                                 rdfs:domain cim:ConsumptionTariffInterval;
                                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                                 rdfs:label "TouTariffIntervals"@en;
                                                 rdfs:range cim:TimeTariffInterval.
cim:ConsumptionTariffInterval.sequenceNumber a owl:DatatypeProperty;
                                             rdfs:comment "A sequential reference that defines the identity of this interval and its relative position with respect to other intervals in a sequence of intervals."@en;
                                             rdfs:domain cim:ConsumptionTariffInterval;
                                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                             rdfs:label "sequenceNumber"@en;
                                             rdfs:range xsd:integer.
cim:ConsumptionTariffInterval.startValue a owl:DatatypeProperty;
                                         rdfs:comment "The lowest level of consumption that defines the starting point of this interval. The interval extends to the start of the next interval or until it is reset to the start of the first interval by TariffProfile.tariffCycle."@en;
