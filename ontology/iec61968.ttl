cim:Due a owl:Class;
        rdfs:comment "Details on amounts due for an account."@en;
        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
        rdfs:label "Due"@en;
        cimdoc:cimPackage "IEC61968.PaymentMetering";
        cimdoc:packageTier "Normative".
cim:Due.arrears a owl:DatatypeProperty;
                rdfs:comment "Part of 'current' that constitutes the arrears portion."@en;
                rdfs:domain cim:Due;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                rdfs:label "arrears"@en;
                rdfs:range cim:Money.
cim:Due.charges a owl:DatatypeProperty;
                rdfs:comment "Part of 'current' that constitutes the charge portion: 'charges' = 'Charge. fixedPortion' + 'Charge.variablePortion'."@en;
                rdfs:domain cim:Due;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                rdfs:label "charges"@en;
                rdfs:range cim:Money.
cim:Due.current a owl:DatatypeProperty;
                rdfs:comment "Current total amount now due: current = principle + arrears + interest + charges. Typically the rule for settlement priority is: interest dues, then arrears dues, then current dues, then charge dues."@en;
                rdfs:domain cim:Due;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                rdfs:label "current"@en;
                rdfs:range cim:Money.
cim:Due.interest a owl:DatatypeProperty;
                 rdfs:comment "Part of 'current' that constitutes the interest portion."@en;
                 rdfs:domain cim:Due;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                 rdfs:label "interest"@en;
                 rdfs:range cim:Money.
cim:Due.principle a owl:DatatypeProperty;
                  rdfs:comment "Part of 'current' that constitutes the portion of the principle amount currently due."@en;
                  rdfs:domain cim:Due;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                  rdfs:label "principle"@en;
                  rdfs:range cim:Money.
cim:EPAStandard a owl:Class;
