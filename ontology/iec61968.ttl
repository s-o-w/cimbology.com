                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                               rdfs:label "ratedVoltage"@en;
                               rdfs:range cim:Voltage.
cim:EndDeviceTiming a owl:Class;
                    rdfs:comment "Timing for the control actions of end devices."@en;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                    rdfs:label "EndDeviceTiming"@en;
                    cimdoc:cimPackage "IEC61968.Metering";
                    cimdoc:packageTier "Normative".
cim:EndDeviceTiming.duration a owl:DatatypeProperty;
                             rdfs:comment "Duration of the end device control action or the business event that is the subject of the end device control."@en;
