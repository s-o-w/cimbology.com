                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                  rdfs:label "realPowerDispatch"@en;
                                  rdfs:range xsd:boolean.
cim:DERFunction.voltVarCurveFunction a owl:DatatypeProperty;
                                     rdfs:comment "If set to TRUE, the voltVARCurveFunction is supported."@en;
                                     rdfs:domain cim:DERFunction;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                     rdfs:label "voltVarCurveFunction"@en;
                                     rdfs:range xsd:boolean.
cim:DERFunction.voltWattCurveFunction a owl:DatatypeProperty;
                                      rdfs:comment "If set to TRUE, the voltWattCurveFunction is supported."@en;
                                      rdfs:domain cim:DERFunction;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                      rdfs:label "voltWattCurveFunction"@en;
                                      rdfs:range xsd:boolean.
cim:DERFunction.voltageRegulation a owl:DatatypeProperty;
                                  rdfs:comment "If set to TRUE, the voltageRegulation function is supported."@en;
                                  rdfs:domain cim:DERFunction;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                  rdfs:label "voltageRegulation"@en;
                                  rdfs:range xsd:boolean.
cim:DERGroupDispatch a owl:Class;
                     rdfs:comment "Specifies the capabilities of the DER Group that are to be dispatched according to a schedule. Each dispatch identifies a DER Group and the specific monitorable parameter to be dispatched over a specific time interval."@en;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                     rdfs:label "DERGroupDispatch"@en;
                     rdfs:subClassOf cim:IdentifiedObject;
                     cimdoc:cimPackage "IEC61968.DER";
                     cimdoc:packageTier "Normative".
cim:DERGroupForecast a owl:Class;
                     rdfs:comment "Specifies the forecasted values of the DERMonitorableParameters for a DER Group over a specific time interval."@en;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                     rdfs:label "DERGroupForecast"@en;
                     rdfs:subClassOf cim:IdentifiedObject;
                     cimdoc:cimPackage "IEC61968.DER";
                     cimdoc:packageTier "Normative".
cim:DERGroupForecast.EndDeviceGroup a owl:ObjectProperty;
                                    rdfs:comment "The DER Group for which forecasts are made."@en;
                                    rdfs:domain cim:DERGroupForecast;
                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                    rdfs:label "EndDeviceGroup"@en;
                                    rdfs:range cim:EndDeviceGroup.
cim:DERGroupForecast.predictionCreationDate a owl:DatatypeProperty;
                                            rdfs:comment "The timestamp for when the DER Group forecast was created"@en;
                                            rdfs:domain cim:DERGroupForecast;
                                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                            rdfs:label "predictionCreationDate"@en;
                                            rdfs:range xsd:dateTime.
cim:DERMonitorableParameter a owl:Class;
                            rdfs:comment "To define the DER monitorable parameters that will be forecasted and dispatched for a DER Group. Each parameter is represented as a Y Value at a point in time or on a curve as a function of time, which is represented on the X axis."@en;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                            rdfs:label "DERMonitorableParameter"@en;
                            cimdoc:cimPackage "IEC61968.DER";
                            cimdoc:packageTier "Normative".
cim:DERMonitorableParameter.DERParameter a owl:ObjectProperty;
                                         rdfs:comment "Defines the specific engineering value being forecasted or dispatched."@en;
                                         rdfs:domain cim:DERMonitorableParameter;
                                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                         rdfs:label "DERParameter"@en;
                                         rdfs:range cim:DERParameterKind.
cim:DERMonitorableParameter.flowDirection a owl:ObjectProperty;
                                          rdfs:comment "Kind of flow direction for reading/measured values proper to some commodities such as, for example, energy, power, demand."@en;
                                          rdfs:domain cim:DERMonitorableParameter;
                                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                          rdfs:label "flowDirection"@en;
                                          rdfs:range cim:FlowDirectionKind.
cim:DERMonitorableParameter.yMultiplier a owl:ObjectProperty;
                                        rdfs:comment "The UnitMultiplier that is applied to the DERMonitorableParameter."@en;
                                        rdfs:domain cim:DERMonitorableParameter;
                                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                        rdfs:label "yMultiplier"@en;
                                        rdfs:range cim:UnitMultiplier.
cim:DERMonitorableParameter.yUnit a owl:ObjectProperty;
                                  rdfs:comment "The DERUnitSymbol that is applied to the DERMonitorableParameter"@en;
                                  rdfs:domain cim:DERMonitorableParameter;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                  rdfs:label "yUnit"@en;
                                  rdfs:range cim:DERUnitSymbol.
cim:DERMonitorableParameter.yUnitInstalledMax a owl:DatatypeProperty;
                                              rdfs:comment "The maximum value of the DERMonitorableParameter based on the installed capacity."@en;
                                              rdfs:domain cim:DERMonitorableParameter;
                                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                              rdfs:label "yUnitInstalledMax"@en;
                                              rdfs:range xsd:float.
cim:DERMonitorableParameter.yUnitInstalledMin a owl:DatatypeProperty;
                                              rdfs:comment "The minimum value of the DERMonitorableParameter based on the installed capacity."@en;
                                              rdfs:domain cim:DERMonitorableParameter;
                                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                              rdfs:label "yUnitInstalledMin"@en;
                                              rdfs:range xsd:float.
cim:DERParameterKind a owl:Class;
                     rdfs:comment "Specifies the DER parameters related to the unit of power, ramp rate and regulation flows."@en;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                     rdfs:label "DERParameterKind"@en;
                     owl:equivalentClass [a owl:Class ; 
                                          owl:oneOf (cim:DERParameterKind.activePower
                                                     cim:DERParameterKind.apparentPower
                                                     cim:DERParameterKind.decreasingRampRate
                                                     cim:DERParameterKind.highFilterBiDirectionalRegulation
                                                     cim:DERParameterKind.highFilterDownRegulation
                                                     cim:DERParameterKind.highFilterUpRegulation
                                                     cim:DERParameterKind.increasingRampRate
                                                     cim:DERParameterKind.lowFilterBiDirectionalRegulation
                                                     cim:DERParameterKind.lowFilterDownRegulation
                                                     cim:DERParameterKind.lowFilterUpRegulation
                                                     cim:DERParameterKind.reactivePower
                                                     cim:DERParameterKind.voltage)];
                     cimdoc:cimPackage "IEC61968.DER";
                     cimdoc:packageTier "Normative".
cim:DERParameterKind.activePower a owl:NamedIndividual,
                                   cim:DERParameterKind;
                                 rdfs:comment "The amount of power being used, measured in Watts."@en;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                 rdfs:label "activePower"@en;
                                 cimdoc:enumCode 2 .
cim:DERParameterKind.apparentPower a owl:NamedIndividual,
                                     cim:DERParameterKind;
                                   rdfs:comment "The combination of reactive power and active power, and is the product of voltage and current without reference to the phase angle."@en;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                   rdfs:label "apparentPower"@en;
                                   cimdoc:enumCode 1 .
cim:DERParameterKind.decreasingRampRate a owl:NamedIndividual,
                                          cim:DERParameterKind;
                                        rdfs:comment "An indication of whether the ramp rate associated with a curve is negative."@en;
                                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                        rdfs:label "decreasingRampRate"@en;
                                        cimdoc:enumCode 11 .
cim:DERParameterKind.highFilterBiDirectionalRegulation a owl:NamedIndividual,
                                                         cim:DERParameterKind;
                                                       rdfs:comment "AC voltage regulation of high frequency"@en;
                                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                                       rdfs:label "highFilterBiDirectionalRegulation"@en;
                                                       cimdoc:enumCode 4 .
cim:DERParameterKind.highFilterDownRegulation a owl:NamedIndividual,
                                                cim:DERParameterKind;
                                              rdfs:comment "High Pass Frequency Regulation downwards."@en;
                                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                              rdfs:label "highFilterDownRegulation"@en;
                                              cimdoc:enumCode 8 .
cim:DERParameterKind.highFilterUpRegulation a owl:NamedIndividual,
                                              cim:DERParameterKind;
                                            rdfs:comment "High Pass Frequency Regulation upwards."@en;
                                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                            rdfs:label "highFilterUpRegulation"@en;
                                            cimdoc:enumCode 6 .
cim:DERParameterKind.increasingRampRate a owl:NamedIndividual,
                                          cim:DERParameterKind;
                                        rdfs:comment "An indication of whether the ramp rate associated with a curve is positive."@en;
                                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                        rdfs:label "increasingRampRate"@en;
                                        cimdoc:enumCode 10 .
cim:DERParameterKind.lowFilterBiDirectionalRegulation a owl:NamedIndividual,
                                                        cim:DERParameterKind;
                                                      rdfs:comment "Used to filter out the sinosuidal disturbances to the grid."@en;
                                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                                      rdfs:label "lowFilterBiDirectionalRegulation"@en;
                                                      cimdoc:enumCode 5 .
cim:DERParameterKind.lowFilterDownRegulation a owl:NamedIndividual,
                                               cim:DERParameterKind;
                                             rdfs:comment "Low Pass Frequency Regulation downwards."@en;
                                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                             rdfs:label "lowFilterDownRegulation"@en;
                                             cimdoc:enumCode 9 .
cim:DERParameterKind.lowFilterUpRegulation a owl:NamedIndividual,
                                             cim:DERParameterKind;
                                           rdfs:comment "Low Pass Frequency Regulation upwards."@en;
                                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                           rdfs:label "lowFilterUpRegulation"@en;
                                           cimdoc:enumCode 7 .
cim:DERParameterKind.reactivePower a owl:NamedIndividual,
                                     cim:DERParameterKind;
                                   rdfs:comment "The measure of reactance, measured in Vars."@en;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                   rdfs:label "reactivePower"@en;
                                   cimdoc:enumCode 3 .
cim:DERParameterKind.voltage a owl:NamedIndividual,
                               cim:DERParameterKind;
                             rdfs:comment "The measure of difference in potential between two points, measured in Volts."@en;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                             rdfs:label "voltage"@en;
                             cimdoc:enumCode 12 .
cim:DERUnitSymbol a owl:Class;
                  rdfs:comment "The units defined for usage in DER related contexts. This class is a subset plus possible additions of the UnitSymbol Class in the CIM Domain Package."@en;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                  rdfs:label "DERUnitSymbol"@en;
