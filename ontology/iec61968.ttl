                                       rdfs:label "CustomerAgreements"@en;
                                       rdfs:range cim:CustomerAgreement.
cim:ServiceSupplier.UsagePoints a owl:ObjectProperty;
                                rdfs:comment "All usage points this service supplier utilises to deliver a service."@en;
                                rdfs:domain cim:ServiceSupplier;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                rdfs:label "UsagePoints"@en;
