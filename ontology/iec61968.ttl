                       cim:MediumKind;
                     rdfs:comment "Medium is solid."@en;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                     rdfs:label "solid"@en;
                     cimdoc:enumCode 7 .
cim:MerchantAccount a owl:Class;
                    rdfs:comment "The operating account controlled by merchant agreement, against which the vendor may vend tokens or receipt payments. Transactions via vendor shift debit the account and bank deposits via bank statement credit the account."@en;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                    rdfs:label "MerchantAccount"@en;
                    rdfs:subClassOf cim:Document;
                    cimdoc:cimPackage "IEC61968.PaymentMetering";
                    cimdoc:packageTier "Normative".
cim:MerchantAccount.Transactors a owl:ObjectProperty;
                                rdfs:comment "All transactors this merchant account is registered with."@en;
                                rdfs:domain cim:MerchantAccount;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                rdfs:label "Transactors"@en;
                                rdfs:range cim:Transactor.
cim:MerchantAccount.VendorShifts a owl:ObjectProperty;
                                 rdfs:comment "All vendor shifts that operate on this merchant account."@en;
                                 rdfs:domain cim:MerchantAccount;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                 rdfs:label "VendorShifts"@en;
                                 rdfs:range cim:VendorShift.
cim:MerchantAccount.currentBalance a owl:DatatypeProperty;
                                   rdfs:comment "The current operating balance of this account."@en;
                                   rdfs:domain cim:MerchantAccount;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                   rdfs:label "currentBalance"@en;
                                   rdfs:range cim:Money.
cim:MerchantAccount.provisionalBalance a owl:DatatypeProperty;
                                       rdfs:comment "The balance of this account after taking into account any pending debits from VendorShift.merchantDebitAmount and pending credits from BankStatement. merchantCreditAmount or credits (see also BankStatement attributes and VendorShift attributes)."@en;
                                       rdfs:domain cim:MerchantAccount;
                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                       rdfs:label "provisionalBalance"@en;
                                       rdfs:range cim:Money.
cim:MerchantAgreement a owl:Class;
                      rdfs:comment "A formal controlling contractual agreement between supplier and merchant, in terms of which the merchant is authorised to vend tokens and receipt payments on behalf of the supplier. The merchant is accountable to the supplier for revenue collected at point of sale."@en;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                      rdfs:label "MerchantAgreement"@en;
