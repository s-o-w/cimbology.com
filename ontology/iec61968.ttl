cim:Tariff a owl:Class;
           rdfs:comment "Document, approved by the responsible regulatory agency, listing the terms and conditions, including a schedule of prices, under which utility services will be provided. It has a unique number within the state or province. For rate schedules it is frequently allocated by the affiliated Public utilities commission (PUC)."@en;
           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
           rdfs:label "Tariff"@en;
           rdfs:subClassOf cim:Document;
           cimdoc:cimPackage "IEC61968.Customers";
           cimdoc:packageTier "Normative".
cim:Tariff.TariffProfiles a owl:ObjectProperty;
                          rdfs:comment "All tariff profiles using this tariff."@en;
                          rdfs:domain cim:Tariff;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                          rdfs:label "TariffProfiles"@en;
                          rdfs:range cim:TariffProfile.
cim:Tariff.endDate a owl:DatatypeProperty;
                   rdfs:comment "(if tariff became inactive) Date tariff was terminated."@en;
                   rdfs:domain cim:Tariff;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                   rdfs:label "endDate"@en;
                   rdfs:range xsd:date.
cim:Tariff.startDate a owl:DatatypeProperty;
                     rdfs:comment "Date tariff was activated."@en;
                     rdfs:domain cim:Tariff;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                     rdfs:label "startDate"@en;
                     rdfs:range xsd:date.
cim:TariffProfile a owl:Class;
                  rdfs:comment "A schedule of charges; structure associated with Tariff that allows the definition of complex tarif structures such as step and time of use when used in conjunction with TimeTariffInterval and Charge. Inherited 'status.value' is defined in the context of the utility's business rules, for example: active, inactive, etc."@en;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                  rdfs:label "TariffProfile"@en;
                  rdfs:subClassOf cim:Document;
                  cimdoc:cimPackage "IEC61968.PaymentMetering";
                  cimdoc:packageTier "Normative".
cim:TariffProfile.ConsumptionTariffIntervals a owl:ObjectProperty;
                                             rdfs:comment "All consumption tariff intervals used to define this tariff profile."@en;
                                             rdfs:domain cim:TariffProfile;
                                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                             rdfs:label "ConsumptionTariffIntervals"@en;
                                             rdfs:range cim:ConsumptionTariffInterval.
cim:TariffProfile.TimeTariffIntervals a owl:ObjectProperty;
                                      rdfs:comment "All time tariff intervals used to define this tariff profile."@en;
                                      rdfs:domain cim:TariffProfile;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                      rdfs:label "TimeTariffIntervals"@en;
                                      rdfs:range cim:TimeTariffInterval.
cim:TariffProfile.tariffCycle a owl:DatatypeProperty;
                              rdfs:comment "The frequency at which the tariff charge schedule is repeated. Examples are: once off on a specified date and time; hourly; daily; weekly; monthly; 3- monthly; 6-monthly; 12-monthly; etc. At the end of each cycle, the business rules are reset to start from the beginning again."@en;
                              rdfs:domain cim:TariffProfile;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                              rdfs:label "tariffCycle"@en;
                              rdfs:range xsd:string.
cim:TelephoneNumber a owl:Class;
                    rdfs:comment "Telephone number."@en;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                    rdfs:label "TelephoneNumber"@en;
                    cimdoc:cimPackage "IEC61968.Common";
                    cimdoc:packageTier "Normative".
cim:TelephoneNumber.areaCode a owl:DatatypeProperty;
                             rdfs:comment "(if applicable) Area or region code."@en;
