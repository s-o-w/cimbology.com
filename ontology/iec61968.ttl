                  cimdoc:packageTier "Informative".
cim:OldSwitchInfo.dielectricStrength a owl:DatatypeProperty;
                                     rdfs:comment "The maximum rms voltage that may be applied across an open contact without breaking down the dielectric properties of the switch in the open position."@en;
                                     rdfs:domain cim:OldSwitchInfo;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                     rdfs:label "dielectricStrength"@en;
                                     rdfs:range cim:Voltage.
cim:OldSwitchInfo.loadBreak a owl:DatatypeProperty;
                            rdfs:comment "True if switch has load breaking capabiity. Unless specified false, this is always assumed to be true for breakers and reclosers."@en;
                            rdfs:domain cim:OldSwitchInfo;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                            rdfs:label "loadBreak"@en;
                            rdfs:range xsd:boolean.
cim:OldSwitchInfo.makingCapacity a owl:DatatypeProperty;
                                 rdfs:comment "The highest value of current the switch can make at the rated voltage under specified operating conditions without suffering significant deterioration of its performance."@en;
                                 rdfs:domain cim:OldSwitchInfo;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                 rdfs:label "makingCapacity"@en;
                                 rdfs:range cim:CurrentFlow.
cim:OldSwitchInfo.minimumCurrent a owl:DatatypeProperty;
                                 rdfs:comment "The lowest value of current that the switch can make, carry and break in uninterrupted duty at the rated voltage under specified operating conditions without suffering significant deterioration of its performance."@en;
                                 rdfs:domain cim:OldSwitchInfo;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                 rdfs:label "minimumCurrent"@en;
                                 rdfs:range cim:CurrentFlow.
cim:OldSwitchInfo.poleCount a owl:DatatypeProperty;
                            rdfs:comment "Number of poles (i.e. of current carrying conductors that are switched)."@en;
                            rdfs:domain cim:OldSwitchInfo;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                            rdfs:label "poleCount"@en;
                            rdfs:range xsd:integer.
cim:OldSwitchInfo.remote a owl:DatatypeProperty;
                         rdfs:comment "True if device is capable of being operated by remote control."@en;
                         rdfs:domain cim:OldSwitchInfo;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                         rdfs:label "remote"@en;
                         rdfs:range xsd:boolean.
cim:OldSwitchInfo.withstandCurrent a owl:DatatypeProperty;
                                   rdfs:comment "The highest value of current the switch can carry in the closed position at the rated voltage under specified operating conditions without suffering significant deterioration of its performance."@en;
                                   rdfs:domain cim:OldSwitchInfo;
