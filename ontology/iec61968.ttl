                                      rdfs:label "connectionKind"@en;
                                      rdfs:range cim:WindingConnection.
cim:TransformerEndInfo.emergencyS a owl:DatatypeProperty;
                                  rdfs:comment "Apparent power that the winding can carry under emergency conditions (also called long-term emergency power)."@en;
                                  rdfs:domain cim:TransformerEndInfo;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                  rdfs:label "emergencyS"@en;
                                  rdfs:range cim:ApparentPower.
cim:TransformerEndInfo.endNumber a owl:DatatypeProperty;
                                 rdfs:comment "Number for this transformer end, corresponding to the end's order in the PowerTransformer.vectorGroup attribute. Highest voltage winding should be 1."@en;
                                 rdfs:domain cim:TransformerEndInfo;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                 rdfs:label "endNumber"@en;
