                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                         rdfs:label "kind"@en;
                         rdfs:range cim:SupplierKind.
cim:Shift a owl:Class;
          rdfs:comment """Generally referring to a period of operation or work performed. Whether the shift is open/closed can be derived from attributes 'activityInterval.start' and 'activityInterval.end'. The grand total for receipts (i.e., cumulative total of all actual receipted amounts during this shift; bankable + non-bankable; excludes rounding error totals) can be derived from receipt: =sum('Receipt.receiptAmount'); includes bankable and non-bankable receipts. It also has to be reconciled against: =sum('receiptsGrandTotalBankable' + 'receiptsGrandTotalNonBankable') and against receipt summary: =sum('ReceiptSummary.receiptsTotal'). The attributes with \"GrandTotal\" defined in this class may need to be used when the source data is periodically flushed from the system and then these cannot be derived."""@en;
          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
          rdfs:label "Shift"@en;
          rdfs:subClassOf cim:IdentifiedObject;
          cimdoc:cimPackage "IEC61968.PaymentMetering";
          cimdoc:packageTier "Normative".
cim:Shift.activityInterval a owl:ObjectProperty;
                           rdfs:comment "Interval for activity of this shift."@en;
                           rdfs:domain cim:Shift;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                           rdfs:label "activityInterval"@en;
                           rdfs:range cim:DateTimeInterval.
cim:Shift.receiptsGrandTotalBankable a owl:DatatypeProperty;
                                     rdfs:comment "Total of amounts receipted during this shift that can be manually banked (cash and cheques for example). Values are obtained from Receipt attributes: =sum(Receipt.receiptAmount) for all Receipt.bankable = true."@en;
                                     rdfs:domain cim:Shift;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                     rdfs:label "receiptsGrandTotalBankable"@en;
                                     rdfs:range cim:Money.
cim:Shift.receiptsGrandTotalNonBankable a owl:DatatypeProperty;
                                        rdfs:comment "Total of amounts receipted during this shift that cannot be manually banked (card payments for example). Values are obtained from Receipt attributes: =sum(Receipt.receiptAmount) for all Receipt.bankable = false."@en;
                                        rdfs:domain cim:Shift;
                                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                        rdfs:label "receiptsGrandTotalNonBankable"@en;
                                        rdfs:range cim:Money.
cim:Shift.receiptsGrandTotalRounding a owl:DatatypeProperty;
                                     rdfs:comment "Cumulative amount in error due to process rounding not reflected in receiptsGrandTotal. Values are obtained from Receipt attributes: =sum(Receipt.receiptRounding)."@en;
                                     rdfs:domain cim:Shift;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                     rdfs:label "receiptsGrandTotalRounding"@en;
                                     rdfs:range cim:Money.
cim:Shift.transactionsGrandTotal a owl:DatatypeProperty;
                                 rdfs:comment "Cumulative total of transacted amounts during this shift. Values are obtained from transaction: =sum('Transaction.transactionAmount'). It also has to be reconciled against transaction summary: =sum('TransactionSummary.transactionsTotal')."@en;
                                 rdfs:domain cim:Shift;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                 rdfs:label "transactionsGrandTotal"@en;
                                 rdfs:range cim:Money.
cim:Shift.transactionsGrandTotalRounding a owl:DatatypeProperty;
                                         rdfs:comment "Cumulative amount in error due to process rounding not reflected in transactionsGandTotal. Values are obtained from Transaction attributes: =sum(Transaction.transactionRounding)."@en;
                                         rdfs:domain cim:Shift;
                                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                         rdfs:label "transactionsGrandTotalRounding"@en;
                                         rdfs:range cim:Money.
cim:ShiftPattern a owl:Class;
                 rdfs:comment "The patterns of shifts worked by people or crews."@en;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                 rdfs:label "ShiftPattern"@en;
                 rdfs:subClassOf cim:WorkIdentifiedObject;
                 cimdoc:cimPackage "IEC61968.InfIEC61968.InfWork";
                 cimdoc:packageTier "Informative".
cim:ShiftPattern.assignmentType a owl:DatatypeProperty;
                                rdfs:comment "Type of assignement intended to be worked on this shift, for example, temporary, standard, etc."@en;
                                rdfs:domain cim:ShiftPattern;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                rdfs:label "assignmentType"@en;
                                rdfs:range xsd:string.
cim:ShiftPattern.cycleCount a owl:DatatypeProperty;
                            rdfs:comment "Number of cycles for a temporary shift."@en;
                            rdfs:domain cim:ShiftPattern;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                            rdfs:label "cycleCount"@en;
                            rdfs:range xsd:integer.
cim:ShiftPattern.status a owl:ObjectProperty;
                        rdfs:comment "The status"@en;
                        rdfs:domain cim:ShiftPattern;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                        rdfs:label "status"@en;
                        rdfs:range cim:Status.
cim:ShiftPattern.validityInterval a owl:ObjectProperty;
                                  rdfs:comment "Date and time interval for which this shift pattern is valid (when it became effective and when it expires)."@en;
                                  rdfs:domain cim:ShiftPattern;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                  rdfs:label "validityInterval"@en;
                                  rdfs:range cim:DateTimeInterval.
cim:ShortCircuitTest a owl:Class;
                     rdfs:comment "Short-circuit test results determine mesh impedance parameters. They include load losses and leakage impedances. For three-phase windings, the excitation can be a positive sequence (the default) or a zero sequence. There shall be at least one grounded winding."@en;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                     rdfs:label "ShortCircuitTest"@en;
                     rdfs:subClassOf cim:TransformerTest;
                     cimdoc:cimPackage "IEC61968.AssetInfo";
                     cimdoc:packageTier "Normative".
cim:ShortCircuitTest.EnergisedEnd a owl:ObjectProperty;
                                  rdfs:comment "Transformer end that voltage is applied to in this short-circuit test. The test voltage is chosen to induce rated current in the energised end."@en;
                                  rdfs:domain cim:ShortCircuitTest;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                  rdfs:label "EnergisedEnd"@en;
                                  rdfs:range cim:TransformerEndInfo.
cim:ShortCircuitTest.GroundedEnds a owl:ObjectProperty;
                                  rdfs:comment "All ends short-circuited in this short-circuit test."@en;
                                  rdfs:domain cim:ShortCircuitTest;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                  rdfs:label "GroundedEnds"@en;
                                  rdfs:range cim:TransformerEndInfo.
cim:ShortCircuitTest.current a owl:DatatypeProperty;
                             rdfs:comment "Short circuit current.."@en;
                             rdfs:domain cim:ShortCircuitTest;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                             rdfs:label "current"@en;
                             rdfs:range cim:CurrentFlow.
cim:ShortCircuitTest.energisedEndStep a owl:DatatypeProperty;
                                      rdfs:comment "Tap step number for the energised end of the test pair."@en;
                                      rdfs:domain cim:ShortCircuitTest;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                      rdfs:label "energisedEndStep"@en;
                                      rdfs:range xsd:integer.
cim:ShortCircuitTest.groundedEndStep a owl:DatatypeProperty;
                                     rdfs:comment "Tap step number for the grounded end of the test pair."@en;
                                     rdfs:domain cim:ShortCircuitTest;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                     rdfs:label "groundedEndStep"@en;
                                     rdfs:range xsd:integer.
cim:ShortCircuitTest.leakageImpedance a owl:DatatypeProperty;
                                      rdfs:comment "Leakage impedance measured from a positive-sequence or single-phase short- circuit test."@en;
                                      rdfs:domain cim:ShortCircuitTest;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                      rdfs:label "leakageImpedance"@en;
                                      rdfs:range cim:Impedance.
cim:ShortCircuitTest.leakageImpedanceZero a owl:DatatypeProperty;
                                          rdfs:comment "Leakage impedance measured from a zero-sequence short-circuit test."@en;
                                          rdfs:domain cim:ShortCircuitTest;
                                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                          rdfs:label "leakageImpedanceZero"@en;
                                          rdfs:range cim:Impedance.
cim:ShortCircuitTest.loss a owl:DatatypeProperty;
                          rdfs:comment "Load losses from a positive-sequence or single-phase short-circuit test."@en;
                          rdfs:domain cim:ShortCircuitTest;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                          rdfs:label "loss"@en;
                          rdfs:range cim:KiloActivePower.
cim:ShortCircuitTest.lossZero a owl:DatatypeProperty;
                              rdfs:comment "Load losses from a zero-sequence short-circuit test."@en;
                              rdfs:domain cim:ShortCircuitTest;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                              rdfs:label "lossZero"@en;
                              rdfs:range cim:KiloActivePower.
cim:ShortCircuitTest.power a owl:DatatypeProperty;
                           rdfs:comment "Short circuit apparent power."@en;
                           rdfs:domain cim:ShortCircuitTest;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                           rdfs:label "power"@en;
                           rdfs:range cim:ApparentPower.
cim:ShortCircuitTest.voltage a owl:DatatypeProperty;
                             rdfs:comment "Short circuit voltage.."@en;
                             rdfs:domain cim:ShortCircuitTest;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                             rdfs:label "voltage"@en;
                             rdfs:range cim:PerCent.
cim:ShuntCompensatorAction a owl:Class;
