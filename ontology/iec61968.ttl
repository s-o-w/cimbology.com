cim:ConnectDisconnectFunction.isRemoteAutoReconOp a owl:DatatypeProperty;
                                                  rdfs:comment "If set true and if reconnection can be operated remotely, then the operation happens automatically. If set false and if reconnection can be operated remotely, then the operation happens manually."@en;
