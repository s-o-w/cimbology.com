cim:ScheduledEvent a owl:Class;
                   rdfs:comment "An event to trigger one or more activities, such as reading a meter, recalculating a bill, requesting work, when generating units must be scheduled for maintenance, when a transformer is scheduled to be refurbished, etc."@en;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                   rdfs:label "ScheduledEvent"@en;
                   rdfs:subClassOf cim:IdentifiedObject;
                   cimdoc:cimPackage "IEC61968.Common";
                   cimdoc:packageTier "Normative".
cim:ScheduledEvent.Assets a owl:ObjectProperty;
                          rdfs:comment "Assets associated with the scheduled event."@en;
                          rdfs:domain cim:ScheduledEvent;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                          rdfs:label "Assets"@en;
                          rdfs:range cim:Asset.
cim:ScheduledEvent.duration a owl:DatatypeProperty;
                            rdfs:comment "Duration of the scheduled event, for example, the time to ramp between values."@en;
                            rdfs:domain cim:ScheduledEvent;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                            rdfs:label "duration"@en;
                            rdfs:range cim:Seconds.
cim:ScheduledEvent.status a owl:ObjectProperty;
                          rdfs:comment "Current status information relevant to a scheduled event"@en;
                          rdfs:domain cim:ScheduledEvent;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                          rdfs:label "status"@en;
                          rdfs:range cim:Status.
cim:ScheduledEvent.type a owl:DatatypeProperty;
                        rdfs:comment "Type of scheduled event."@en;
                        rdfs:domain cim:ScheduledEvent;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                        rdfs:label "type"@en;
                        rdfs:range xsd:string.
cim:ScheduledEventData a owl:Class;
                       rdfs:comment "Schedule parameters for an activity that is to occur, is occurring, or has completed."@en;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                       rdfs:label "ScheduledEventData"@en;
                       cimdoc:cimPackage "IEC61968.Common";
                       cimdoc:packageTier "Normative".
cim:ScheduledEventData.InspectionDataSet a owl:ObjectProperty;
                                         rdfs:comment "The inspection data set"@en;
                                         rdfs:domain cim:ScheduledEventData;
                                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                         rdfs:label "InspectionDataSet"@en;
                                         rdfs:range cim:InspectionDataSet.
cim:ScheduledEventData.ScheduledEvents a owl:ObjectProperty;
                                       rdfs:comment "All scheduled events with this specification."@en;
                                       rdfs:domain cim:ScheduledEventData;
                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                       rdfs:label "ScheduledEvents"@en;
                                       rdfs:range cim:ScheduledEvent.
cim:ScheduledEventData.estimatedWindow a owl:ObjectProperty;
                                       rdfs:comment "Estimated date and time for activity execution (with earliest possibility of activity initiation and latest possibility of activity completion)."@en;
                                       rdfs:domain cim:ScheduledEventData;
                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                       rdfs:label "estimatedWindow"@en;
                                       rdfs:range cim:DateTimeInterval.
cim:ScheduledEventData.requestedWindow a owl:ObjectProperty;
                                       rdfs:comment "Requested date and time interval for activity execution."@en;
                                       rdfs:domain cim:ScheduledEventData;
                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                       rdfs:label "requestedWindow"@en;
                                       rdfs:range cim:DateTimeInterval.
cim:ScheduledEventData.status a owl:ObjectProperty;
                              rdfs:comment "Current status information relevant to the data for a scheduled event"@en;
                              rdfs:domain cim:ScheduledEventData;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                              rdfs:label "status"@en;
                              rdfs:range cim:Status.
cim:Seal a owl:Class;
