                                                    cim:AssetHazardKind.ambientTempBelowMinus12
                                                    cim:AssetHazardKind.childrenAtPlay
                                                    cim:AssetHazardKind.fishingArea
                                                    cim:AssetHazardKind.other
                                                    cim:AssetHazardKind.vegetation)];
