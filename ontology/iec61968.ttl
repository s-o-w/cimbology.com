                                      rdfs:comment "The erp ledger budget"@en;
                                      rdfs:domain cim:ErpLedBudLineItem;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                      rdfs:label "ErpLedgerBudget"@en;
                                      rdfs:range cim:ErpLedgerBudget.
cim:ErpLedBudLineItem.status a owl:ObjectProperty;
                             rdfs:comment "The status"@en;
                             rdfs:domain cim:ErpLedBudLineItem;
