cim:ERTConfidenceKind a owl:Class;
                      rdfs:comment "The estimated restoration time (ERT) is the amount of time estimated to correct the outage and can have a confidence factor applied such as high or low confidence that the ERT will be accomplished. This confidence factor may be updated as needed during the outage period - just as the actual ERT can be updated."@en;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                      rdfs:label "ERTConfidenceKind"@en;
                      owl:equivalentClass [a owl:Class ; 
                                           owl:oneOf (cim:ERTConfidenceKind.high
                                                      cim:ERTConfidenceKind.low)];
                      cimdoc:cimPackage "IEC61968.Operations";
                      cimdoc:packageTier "Normative".
cim:ERTConfidenceKind.high a owl:NamedIndividual,
                             cim:ERTConfidenceKind;
                           rdfs:comment "there is a high confidence that the ERT will be accomplished"@en;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                           rdfs:label "high"@en;
                           cimdoc:enumCode 0 .
cim:ERTConfidenceKind.low a owl:NamedIndividual,
                            cim:ERTConfidenceKind;
                          rdfs:comment "there is a low confidence that the ERT will be accomplished."@en;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                          rdfs:label "low"@en;
                          cimdoc:enumCode 1 .
