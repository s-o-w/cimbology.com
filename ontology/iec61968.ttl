                          rdfs:label "value"@en;
                          rdfs:range xsd:float.
cim:MeterMultiplierKind a owl:Class;
                        rdfs:comment "Kind of meter multiplier."@en;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                        rdfs:label "MeterMultiplierKind"@en;
                        owl:equivalentClass [a owl:Class ; 
                                             owl:oneOf (cim:MeterMultiplierKind.ctRatio
                                                        cim:MeterMultiplierKind.kE
                                                        cim:MeterMultiplierKind.kH
                                                        cim:MeterMultiplierKind.kR
                                                        cim:MeterMultiplierKind.ptRatio
                                                        cim:MeterMultiplierKind.transformerRatio)];
                        cimdoc:cimPackage "IEC61968.Metering";
                        cimdoc:packageTier "Normative".
cim:MeterMultiplierKind.ctRatio a owl:NamedIndividual,
                                  cim:MeterMultiplierKind;
                                rdfs:comment "Current transformer ratio used to convert associated quantities to real measurements."@en;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                rdfs:label "ctRatio"@en;
                                cimdoc:enumCode 3 .
cim:MeterMultiplierKind.kE a owl:NamedIndividual,
                             cim:MeterMultiplierKind;
                           rdfs:comment "Test constant."@en;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                           rdfs:label "kE"@en;
                           cimdoc:enumCode 2 .
cim:MeterMultiplierKind.kH a owl:NamedIndividual,
                             cim:MeterMultiplierKind;
                           rdfs:comment "Meter kh (watthour) constant. The number of watthours that must be applied to the meter to cause one disk revolution for an electromechanical meter or the number of watthours represented by one increment pulse for an electronic meter."@en;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                           rdfs:label "kH"@en;
                           cimdoc:enumCode 0 .
cim:MeterMultiplierKind.kR a owl:NamedIndividual,
                             cim:MeterMultiplierKind;
                           rdfs:comment "Register multiplier. The number to multiply the register reading by in order to get kWh."@en;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                           rdfs:label "kR"@en;
                           cimdoc:enumCode 1 .
cim:MeterMultiplierKind.ptRatio a owl:NamedIndividual,
                                  cim:MeterMultiplierKind;
                                rdfs:comment "Potential transformer ratio used to convert associated quantities to real measurements."@en;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                rdfs:label "ptRatio"@en;
                                cimdoc:enumCode 4 .
cim:MeterMultiplierKind.transformerRatio a owl:NamedIndividual,
