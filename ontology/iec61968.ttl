cim:SwitchingAction a owl:Class;
                    rdfs:comment "Atomic switching action."@en;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                    rdfs:label "SwitchingAction"@en;
                    rdfs:subClassOf cim:IdentifiedObject;
                    cimdoc:cimPackage "IEC61968.Operations";
                    cimdoc:packageTier "Normative".
cim:SwitchingAction.Crew a owl:ObjectProperty;
                         rdfs:comment "The crew that is assigned to the switching action."@en;
                         rdfs:domain cim:SwitchingAction;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                         rdfs:label "Crew"@en;
                         rdfs:range cim:Crew.
cim:SwitchingAction.Operator a owl:ObjectProperty;
                             rdfs:comment "Operator responsible for this switching step."@en;
                             rdfs:domain cim:SwitchingAction;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                             rdfs:label "Operator"@en;
                             rdfs:range cim:Operator.
cim:SwitchingAction.SwitchingEvent a owl:ObjectProperty;
                                   rdfs:comment "The switching event that the switching action is performed on"@en;
                                   rdfs:domain cim:SwitchingAction;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                   rdfs:label "SwitchingEvent"@en;
                                   rdfs:range cim:SwitchingEvent.
cim:SwitchingAction.SwitchingPlan a owl:ObjectProperty;
                                  rdfs:comment "The switching plan that is associated with the switching actions."@en;
                                  rdfs:domain cim:SwitchingAction;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                  rdfs:label "SwitchingPlan"@en;
                                  rdfs:range cim:SwitchingPlan.
cim:SwitchingAction.executedDateTime a owl:DatatypeProperty;
                                     rdfs:comment "Actual date and time of this switching step."@en;
                                     rdfs:domain cim:SwitchingAction;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                     rdfs:label "executedDateTime"@en;
                                     rdfs:range xsd:dateTime.
cim:SwitchingAction.issuedDateTime a owl:DatatypeProperty;
                                   rdfs:comment "Date and time when the crew was given the instruction to execute the action; not applicable if the action is performed by operator remote control."@en;
                                   rdfs:domain cim:SwitchingAction;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                   rdfs:label "issuedDateTime"@en;
                                   rdfs:range xsd:dateTime.
cim:SwitchingAction.phases a owl:ObjectProperty;
                           rdfs:comment "Phases of the Switching Action"@en;
                           rdfs:domain cim:SwitchingAction;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                           rdfs:label "phases"@en;
                           rdfs:range cim:PhaseCode.
cim:SwitchingAction.plannedDateTime a owl:DatatypeProperty;
                                    rdfs:comment "Planned date and time of this switching step."@en;
                                    rdfs:domain cim:SwitchingAction;
                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                    rdfs:label "plannedDateTime"@en;
                                    rdfs:range xsd:dateTime.
cim:SwitchingEvent a owl:Class;
                   rdfs:comment "Event indicating the completion (success or fail) of any switching action (jumper action, cut action, tag action, etc). The switching action may or may not be a consequential event in response to a request to complete the action."@en;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                   rdfs:label "SwitchingEvent"@en;
                   rdfs:subClassOf cim:ActivityRecord;
                   cimdoc:cimPackage "IEC61968.Operations";
                   cimdoc:packageTier "Normative".
cim:SwitchingOrder a owl:Class;
                   rdfs:comment "Transmits a switching plan to a crew in order for the plan to be executed."@en;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                   rdfs:label "SwitchingOrder"@en;
                   rdfs:subClassOf cim:Document;
                   cimdoc:cimPackage "IEC61968.Operations";
                   cimdoc:packageTier "Normative".
cim:SwitchingOrder.SwitchingPlan a owl:ObjectProperty;
                                 rdfs:comment "The switching plan that is defined in the switching order."@en;
                                 rdfs:domain cim:SwitchingOrder;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                 rdfs:label "SwitchingPlan"@en;
                                 rdfs:range cim:SwitchingPlan.
cim:SwitchingOrder.plannedExecutionInterval a owl:ObjectProperty;
                                            rdfs:comment "The planned start and end time for the switching order."@en;
                                            rdfs:domain cim:SwitchingOrder;
                                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                            rdfs:label "plannedExecutionInterval"@en;
                                            rdfs:range cim:DateTimeInterval.
cim:SwitchingPlan a owl:Class;
                  rdfs:comment "A sequence of grouped or atomic steps intended to: - de-energise equipment or part of the network for safe work, and/or - bring back in service previously de-energised equipment or part of the network."@en;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                  rdfs:label "SwitchingPlan"@en;
                  rdfs:subClassOf cim:Document;
                  cimdoc:cimPackage "IEC61968.Operations";
                  cimdoc:packageTier "Normative".
cim:SwitchingPlan.Outage a owl:ObjectProperty;
                         rdfs:comment "Outage that will be activated or eliminated when this switching plan gets executed."@en;
                         rdfs:domain cim:SwitchingPlan;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                         rdfs:label "Outage"@en;
                         rdfs:range cim:Outage.
cim:SwitchingPlan.OutagePlan a owl:ObjectProperty;
                             rdfs:comment "The outage plan for which the switching plan is defined."@en;
