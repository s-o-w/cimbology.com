cim:EnergySourceAction a owl:Class;
                       rdfs:comment "Action on energy source as a switching step."@en;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                       rdfs:label "EnergySourceAction"@en;
