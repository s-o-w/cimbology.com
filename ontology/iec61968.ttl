                                        rdfs:domain cim:OperationalUpdatedRating;
                                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                        rdfs:label "changeType"@en;
                                        rdfs:range xsd:string.
cim:OperationsSafetySupervisor a owl:Class;
                               rdfs:comment "Operator with responsibility that the work in high voltage installation is executed in a safe manner and according to safety regulation."@en;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                               rdfs:label "OperationsSafetySupervisor"@en;
                               rdfs:subClassOf cim:Operator;
                               cimdoc:cimPackage "IEC61968.Operations";
                               cimdoc:packageTier "Normative".
cim:OperationsSafetySupervisor.IssuedSafetyDocuments a owl:ObjectProperty;
                                                     rdfs:comment "All safety documents issued by this supervisor."@en;
                                                     rdfs:domain cim:OperationsSafetySupervisor;
                                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                                     rdfs:label "IssuedSafetyDocuments"@en;
                                                     rdfs:range cim:SafetyDocument.
cim:OperationsSafetySupervisor.ReleasedSafetyDocuments a owl:ObjectProperty;
                                                       rdfs:comment "All safety documents released to this supervisor."@en;
                                                       rdfs:domain cim:OperationsSafetySupervisor;
                                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                                       rdfs:label "ReleasedSafetyDocuments"@en;
                                                       rdfs:range cim:SafetyDocument.
cim:Operator a owl:Class;
             rdfs:comment "Control room operator."@en;
             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
             rdfs:label "Operator"@en;
             rdfs:subClassOf cim:OperationPersonRole;
             cimdoc:cimPackage "IEC61968.Common";
             cimdoc:packageTier "Normative".
cim:OrgOrgRole a owl:Class;
               rdfs:comment "Roles played between Organisations and other Organisations. This includes role ups for ogranisations, cost centers, profit centers, regulatory reporting, etc. Note that the parent and child relationship is indicated by the name on each end of the association."@en;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
               rdfs:label "OrgOrgRole"@en;
               rdfs:subClassOf cim:OrganisationRole;
               cimdoc:cimPackage "IEC61968.InfIEC61968.InfCommon";
               cimdoc:packageTier "Informative".
cim:OrgOrgRole.clientID a owl:DatatypeProperty;
                        rdfs:comment "Identifiers of the organisation held by another organisation, such as a government agency (federal, state, province, city, county), financial institution (Dun and Bradstreet), etc."@en;
                        rdfs:domain cim:OrgOrgRole;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                        rdfs:label "clientID"@en;
                        rdfs:range xsd:string.
cim:Organisation a owl:Class;
                 rdfs:comment "Organisation that might have roles as utility, contractor, supplier, manufacturer, customer, etc."@en;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                 rdfs:label "Organisation"@en;
                 rdfs:subClassOf cim:IdentifiedObject;
                 cimdoc:cimPackage "IEC61968.Common";
                 cimdoc:packageTier "Normative".
cim:Organisation.ParentOrganisation a owl:ObjectProperty;
                                    rdfs:comment "Parent organisation of this organisation."@en;
                                    rdfs:domain cim:Organisation;
                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                    rdfs:label "ParentOrganisation"@en;
                                    rdfs:range cim:ParentOrganization.
cim:Organisation.electronicAddress a owl:ObjectProperty;
                                   rdfs:comment "Electronic address."@en;
                                   rdfs:domain cim:Organisation;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                   rdfs:label "electronicAddress"@en;
                                   rdfs:range cim:ElectronicAddress.
cim:Organisation.phone1 a owl:ObjectProperty;
                        rdfs:comment "Phone number."@en;
                        rdfs:domain cim:Organisation;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                        rdfs:label "phone1"@en;
                        rdfs:range cim:TelephoneNumber.
cim:Organisation.phone2 a owl:ObjectProperty;
                        rdfs:comment "Additional phone number."@en;
                        rdfs:domain cim:Organisation;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                        rdfs:label "phone2"@en;
                        rdfs:range cim:TelephoneNumber.
cim:Organisation.postalAddress a owl:ObjectProperty;
                               rdfs:comment "Postal address, potentially different than 'streetAddress' (e.g., another city)."@en;
                               rdfs:domain cim:Organisation;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                               rdfs:label "postalAddress"@en;
                               rdfs:range cim:StreetAddress.
cim:Organisation.streetAddress a owl:ObjectProperty;
                               rdfs:comment "Street address."@en;
                               rdfs:domain cim:Organisation;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                               rdfs:label "streetAddress"@en;
                               rdfs:range cim:StreetAddress.
cim:OrganisationRole a owl:Class;
                     rdfs:comment "Identifies a way in which an organisation may participate in the utility enterprise (e.g., customer, manufacturer, etc)."@en;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                     rdfs:label "OrganisationRole"@en;
                     rdfs:subClassOf cim:IdentifiedObject;
                     cimdoc:cimPackage "IEC61968.Common";
                     cimdoc:packageTier "Normative".
cim:OrganisationRole.ConfigurationEvents a owl:ObjectProperty;
                                         rdfs:comment "All configuration events created for this organisation role."@en;
                                         rdfs:domain cim:OrganisationRole;
                                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                         rdfs:label "ConfigurationEvents"@en;
                                         rdfs:range cim:ConfigurationEvent.
cim:OrganisationRole.Organisation a owl:ObjectProperty;
                                  rdfs:comment "Organisation having this role."@en;
                                  rdfs:domain cim:OrganisationRole;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                  rdfs:label "Organisation"@en;
                                  rdfs:range cim:Organisation.
cim:Outage a owl:Class;
           rdfs:comment "Document describing details of an active or planned outage in a part of the electrical network. A non-planned outage may be created upon: - a breaker trip, - a fault indicator status change, - a meter event indicating customer outage, - a reception of one or more customer trouble calls, or - an operator command, reflecting information obtained from the field crew. Outage restoration may be performed using a switching plan which complements the outage information with detailed switching activities, including the relationship to the crew and work. A planned outage may be created upon: - a request for service, maintenance or construction work in the field, or - an operator-defined outage for what-if/contingency network analysis."@en;
           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
           rdfs:label "Outage"@en;
           rdfs:subClassOf cim:Document;
           cimdoc:cimPackage "IEC61968.Operations";
           cimdoc:packageTier "Normative".
cim:Outage.Crew a owl:ObjectProperty;
                rdfs:comment "The crew that is assigned to the outage."@en;
                rdfs:domain cim:Outage;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                rdfs:label "Crew"@en;
                rdfs:range cim:Crew.
cim:Outage.DeEnergizedUsagePoint a owl:ObjectProperty;
                                 rdfs:comment "all deenergized useage points associated with the outage."@en;
                                 rdfs:domain cim:Outage;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                 rdfs:label "DeEnergizedUsagePoint"@en;
                                 rdfs:range cim:UsagePoint.
cim:Outage.EnergizedUsagePoint a owl:ObjectProperty;
                               rdfs:comment "All energized usage points associated with this outage."@en;
                               rdfs:domain cim:Outage;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                               rdfs:label "EnergizedUsagePoint"@en;
                               rdfs:range cim:UsagePoint.
cim:Outage.Equipments a owl:ObjectProperty;
                      rdfs:comment "All equipments associated with this outage."@en;
                      rdfs:domain cim:Outage;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                      rdfs:label "Equipments"@en;
                      rdfs:range cim:Equipment.
cim:Outage.Faults a owl:ObjectProperty;
                  rdfs:comment "All faults involved in this outage."@en;
                  rdfs:domain cim:Outage;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                  rdfs:label "Faults"@en;
                  rdfs:range cim:Fault.
cim:Outage.OutageIsolationEquipment a owl:ObjectProperty;
                                    rdfs:comment "The equipment that isolates this outage"@en;
                                    rdfs:domain cim:Outage;
                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                    rdfs:label "OutageIsolationEquipment"@en;
                                    rdfs:range cim:ConductingEquipment.
cim:Outage.PlannedSwitchActions a owl:ObjectProperty;
                                rdfs:comment "All switch actions to apply within the scope of this planned outage. Each such action groups switches to which the action is to apply in order to produce the desired network state considered as outage."@en;
                                rdfs:domain cim:Outage;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                rdfs:label "PlannedSwitchActions"@en;
                                rdfs:range cim:SwitchAction.
cim:Outage.actualPeriod a owl:ObjectProperty;
                        rdfs:comment "Actual outage period; end of the period corresponds to the actual restoration time."@en;
                        rdfs:domain cim:Outage;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                        rdfs:label "actualPeriod"@en;
                        rdfs:range cim:DateTimeInterval.
cim:Outage.communityDescriptor a owl:DatatypeProperty;
                               rdfs:comment "a name to denote the community - this could be a name or a code of some kind."@en;
                               rdfs:domain cim:Outage;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                               rdfs:label "communityDescriptor"@en;
                               rdfs:range xsd:string.
cim:Outage.customersRestored a owl:DatatypeProperty;
                             rdfs:comment "number of customers that have been restored in the area."@en;
                             rdfs:domain cim:Outage;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                             rdfs:label "customersRestored"@en;
                             rdfs:range xsd:integer.
cim:Outage.estimatedPeriod a owl:ObjectProperty;
                           rdfs:comment "Estimated outage period for a planned outage. The start of the period is the start of the planned outage and the end of the period corresponds to the end of the planned outage."@en;
                           rdfs:domain cim:Outage;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                           rdfs:label "estimatedPeriod"@en;
                           rdfs:range cim:DateTimeInterval.
cim:Outage.metersAffected a owl:DatatypeProperty;
                          rdfs:comment "The updated number of meters affected by the outage as reported by the OMS within the utility. It is assumed this number will be updated repeatedly until the full outage is resolved."@en;
                          rdfs:domain cim:Outage;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                          rdfs:label "metersAffected"@en;
                          rdfs:range xsd:integer.
cim:Outage.originalCustomersServed a owl:DatatypeProperty;
                                   rdfs:comment "the total number of customers that are served in the area (both outaged and not outaged)."@en;
                                   rdfs:domain cim:Outage;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                   rdfs:label "originalCustomersServed"@en;
                                   rdfs:range xsd:integer.
cim:Outage.originalMetersAffected a owl:DatatypeProperty;
                                  rdfs:comment "The original number of meters that were affected as reported by the OMS within the utility. That is, this is the total number of meters that were out at the beginning of the outage."@en;
                                  rdfs:domain cim:Outage;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                  rdfs:label "originalMetersAffected"@en;
                                  rdfs:range xsd:integer.
cim:Outage.outageKind a owl:ObjectProperty;
                      rdfs:comment "Defines if the outage has been verified or is only estimated"@en;
                      rdfs:domain cim:Outage;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                      rdfs:label "outageKind"@en;
                      rdfs:range cim:OutageStatusKind.
cim:Outage.statusKind a owl:ObjectProperty;
                      rdfs:comment "defines the status of the crew as in dispatched or arrived, etc."@en;
                      rdfs:domain cim:Outage;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                      rdfs:label "statusKind"@en;
                      rdfs:range cim:CrewStatusKind.
cim:Outage.summary a owl:ObjectProperty;
                   rdfs:comment "Summary counts of service points (customers) affected by this outage."@en;
                   rdfs:domain cim:Outage;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                   rdfs:label "summary"@en;
                   rdfs:range cim:ServicePointOutageSummary.
cim:Outage.utilityDisclaimer a owl:DatatypeProperty;
                             rdfs:comment "This contains an disclaimers the utility would like to place on the data provided to any stakeholder. This may be different for different stakeholders. This should possibly be an attribute under the Organization class but it is placed here for now."@en;
                             rdfs:domain cim:Outage;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                             rdfs:label "utilityDisclaimer"@en;
                             rdfs:range xsd:string.
cim:OutageArea a owl:Class;
               rdfs:comment "This defines the area covered by the Outage."@en;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
               rdfs:label "OutageArea"@en;
               cimdoc:cimPackage "IEC61968.Operations";
               cimdoc:packageTier "Normative".
cim:OutageArea.Outage a owl:ObjectProperty;
                      rdfs:comment "The outage associated with the outage area."@en;
                      rdfs:domain cim:OutageArea;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                      rdfs:label "Outage"@en;
                      rdfs:range cim:Outage.
cim:OutageArea.earliestReportedTime a owl:DatatypeProperty;
                                    rdfs:comment "This is the reported time of the first outage report"@en;
                                    rdfs:domain cim:OutageArea;
                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                    rdfs:label "earliestReportedTime"@en;
                                    rdfs:range xsd:dateTime.
cim:OutageArea.metersServed a owl:DatatypeProperty;
                            rdfs:comment "defines the number of meters served in the defined area."@en;
                            rdfs:domain cim:OutageArea;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                            rdfs:label "metersServed"@en;
                            rdfs:range xsd:integer.
cim:OutageArea.outageAreaKind a owl:ObjectProperty;
                              rdfs:comment "defines the type of area that has the outage - county, state, zipcode, etc."@en;
                              rdfs:domain cim:OutageArea;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                              rdfs:label "outageAreaKind"@en;
                              rdfs:range cim:AreaKind.
cim:OutageCauseKind a owl:Class;
                    rdfs:comment "This enumeration describes the primary cause of the outage - planned, unplanned, etc."@en;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                    rdfs:label "OutageCauseKind"@en;
                    owl:equivalentClass [a owl:Class ; 
                                         owl:oneOf (cim:OutageCauseKind.animal
                                                    cim:OutageCauseKind.lightingStrike
                                                    cim:OutageCauseKind.lineDown
                                                    cim:OutageCauseKind.poleDown
                                                    cim:OutageCauseKind.treeDown)];
                    cimdoc:cimPackage "IEC61968.Operations";
                    cimdoc:packageTier "Normative".
cim:OutageCauseKind.animal a owl:NamedIndividual,
                             cim:OutageCauseKind;
                           rdfs:comment """This outage was caused by an animal is was unplanned. As such it is treated as a forced outage and is probably classified as \"trouble\" with a Trouble Ticket as well as a work/service order. The primary difference between this and an unplanned outage is the reason for the outage. If an animal caused this and perished as a result, the utility may have other actions that are required to be taken by the EPA or other groups with whom the utility has an agreement."""@en;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                           rdfs:label "animal"@en;
                           cimdoc:enumCode 1 .
cim:OutageCauseKind.lightingStrike a owl:NamedIndividual,
                                     cim:OutageCauseKind;
                                   rdfs:comment "Outage is caused by a lighting strike"@en;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                   rdfs:label "lightingStrike"@en;
                                   cimdoc:enumCode 0 .
cim:OutageCauseKind.lineDown a owl:NamedIndividual,
                               cim:OutageCauseKind;
                             rdfs:comment "The outage is caused by a line down"@en;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                             rdfs:label "lineDown"@en;
                             cimdoc:enumCode 2 .
cim:OutageCauseKind.poleDown a owl:NamedIndividual,
                               cim:OutageCauseKind;
                             rdfs:comment "The outage is caused by a pole down"@en;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                             rdfs:label "poleDown"@en;
                             cimdoc:enumCode 3 .
cim:OutageCauseKind.treeDown a owl:NamedIndividual,
                               cim:OutageCauseKind;
                             rdfs:comment "The outage is caused by a tree down"@en;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                             rdfs:label "treeDown"@en;
                             cimdoc:enumCode 4 .
cim:OutageOrder a owl:Class;
                rdfs:comment "Transmits an outage plan to a crew in order for the planned outage to be executed."@en;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                rdfs:label "OutageOrder"@en;
                rdfs:subClassOf cim:Document;
                cimdoc:cimPackage "IEC61968.Operations";
                cimdoc:packageTier "Normative".
cim:OutageOrder.Location a owl:ObjectProperty;
                         rdfs:comment "Location of this outage order."@en;
                         rdfs:domain cim:OutageOrder;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                         rdfs:label "Location"@en;
                         rdfs:range cim:Location.
cim:OutagePlan a owl:Class;
               rdfs:comment "Document containing the definition of planned outages of equipment and/or usage points. It will reference switching plans that are used to execute the planned outage."@en;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
               rdfs:label "OutagePlan"@en;
               rdfs:subClassOf cim:Document;
               cimdoc:cimPackage "IEC61968.Operations";
               cimdoc:packageTier "Normative".
cim:OutagePlan.OutageOrder a owl:ObjectProperty;
                           rdfs:comment "The outage order that will address the outage plan."@en;
                           rdfs:domain cim:OutagePlan;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                           rdfs:label "OutageOrder"@en;
                           rdfs:range cim:OutageOrder.
cim:OutagePlan.PlannedOutage a owl:ObjectProperty;
                             rdfs:comment "The outage resulting from the execution of the outage plan."@en;
                             rdfs:domain cim:OutagePlan;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                             rdfs:label "PlannedOutage"@en;
                             rdfs:range cim:PlannedOutage.
cim:OutagePlan.approvedDateTime a owl:DatatypeProperty;
                                rdfs:comment "The date and time the outage plan was approved"@en;
                                rdfs:domain cim:OutagePlan;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                rdfs:label "approvedDateTime"@en;
                                rdfs:range xsd:dateTime.
cim:OutagePlan.cancelledDateTime a owl:DatatypeProperty;
                                 rdfs:comment "Date and Time the planned outage was canceled."@en;
                                 rdfs:domain cim:OutagePlan;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                 rdfs:label "cancelledDateTime"@en;
                                 rdfs:range xsd:dateTime.
cim:OutagePlan.plannedPeriod a owl:ObjectProperty;
                             rdfs:comment "planned start and end time of the planned outage."@en;
                             rdfs:domain cim:OutagePlan;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                             rdfs:label "plannedPeriod"@en;
                             rdfs:range cim:DateTimeInterval.
cim:OutagePlan.purpose a owl:DatatypeProperty;
                       rdfs:comment "Purpose of this outage plan, such as whether it is to replace equipment or perform maintenance or repairs or to reconfigure network topology."@en;
                       rdfs:domain cim:OutagePlan;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                       rdfs:label "purpose"@en;
                       rdfs:range xsd:string.
cim:OutageStatusKind a owl:Class;
                     rdfs:comment "This defines if the outage have been predicted or confirmed"@en;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                     rdfs:label "OutageStatusKind"@en;
                     owl:equivalentClass [a owl:Class ; 
                                          owl:oneOf (cim:OutageStatusKind.closed
                                                     cim:OutageStatusKind.confirmed
                                                     cim:OutageStatusKind.partiallyRestored
                                                     cim:OutageStatusKind.predicted
                                                     cim:OutageStatusKind.restored)];
                     cimdoc:cimPackage "IEC61968.Operations";
                     cimdoc:packageTier "Normative".
cim:OutageStatusKind.closed a owl:NamedIndividual,
                              cim:OutageStatusKind;
                            rdfs:comment "The outage has been fully restored, the crews have been released and the outage is shown as closed"@en;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                            rdfs:label "closed"@en;
                            cimdoc:enumCode 4 .
cim:OutageStatusKind.confirmed a owl:NamedIndividual,
                                 cim:OutageStatusKind;
                               rdfs:comment "the outage has been verified"@en;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                               rdfs:label "confirmed"@en;
                               cimdoc:enumCode 0 .
cim:OutageStatusKind.partiallyRestored a owl:NamedIndividual,
                                         cim:OutageStatusKind;
                                       rdfs:comment "Some of the usage points affected by the outage have been restored but other usage points are still out of power."@en;
                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                       rdfs:label "partiallyRestored"@en;
                                       cimdoc:enumCode 2 .
cim:OutageStatusKind.predicted a owl:NamedIndividual,
                                 cim:OutageStatusKind;
                               rdfs:comment "the outage may not be real since it has not been verified - it is only thought to be an outage."@en;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                               rdfs:label "predicted"@en;
                               cimdoc:enumCode 1 .
cim:OutageStatusKind.restored a owl:NamedIndividual,
                                cim:OutageStatusKind;
                              rdfs:comment "All usage points associated with the outage have been restored"@en;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                              rdfs:label "restored"@en;
                              cimdoc:enumCode 3 .
cim:OverheadCost a owl:Class;
                 rdfs:comment "Overhead cost applied to work order."@en;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                 rdfs:label "OverheadCost"@en;
                 rdfs:subClassOf cim:WorkIdentifiedObject;
                 cimdoc:cimPackage "IEC61968.InfIEC61968.InfWork";
                 cimdoc:packageTier "Informative".
cim:OverheadCost.WorkCostDetails a owl:ObjectProperty;
                                 rdfs:comment "The work cost details"@en;
                                 rdfs:domain cim:OverheadCost;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                 rdfs:label "WorkCostDetails"@en;
                                 rdfs:range cim:WorkCostDetail.
cim:OverheadCost.code a owl:DatatypeProperty;
                      rdfs:comment "Overhead code."@en;
                      rdfs:domain cim:OverheadCost;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                      rdfs:label "code"@en;
                      rdfs:range xsd:string.
cim:OverheadCost.cost a owl:DatatypeProperty;
                      rdfs:comment "The overhead cost to be applied."@en;
                      rdfs:domain cim:OverheadCost;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                      rdfs:label "cost"@en;
                      rdfs:range cim:Money.
cim:OverheadCost.status a owl:ObjectProperty;
                        rdfs:comment "The status"@en;
                        rdfs:domain cim:OverheadCost;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                        rdfs:label "status"@en;
                        rdfs:range cim:Status.
cim:OverheadWireInfo a owl:Class;
                     rdfs:comment "Overhead wire data."@en;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                     rdfs:label "OverheadWireInfo"@en;
                     rdfs:subClassOf cim:WireInfo;
                     cimdoc:cimPackage "IEC61968.AssetInfo";
                     cimdoc:packageTier "Normative".
cim:Ownership a owl:Class;
              rdfs:comment "Ownership of e.g. asset."@en;
              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
              rdfs:label "Ownership"@en;
              rdfs:subClassOf cim:IdentifiedObject;
              cimdoc:cimPackage "IEC61968.Common";
              cimdoc:packageTier "Normative".
cim:Ownership.Asset a owl:ObjectProperty;
                    rdfs:comment "Asset that is object of this ownership."@en;
                    rdfs:domain cim:Ownership;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                    rdfs:label "Asset"@en;
                    rdfs:range cim:Asset.
cim:Ownership.AssetOwner a owl:ObjectProperty;
                         rdfs:comment "Asset owner that is subject in this ownership."@en;
                         rdfs:domain cim:Ownership;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                         rdfs:label "AssetOwner"@en;
                         rdfs:range cim:AssetOwner.
cim:Ownership.share a owl:DatatypeProperty;
                    rdfs:comment "Share of this ownership."@en;
                    rdfs:domain cim:Ownership;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                    rdfs:label "share"@en;
                    rdfs:range cim:PerCent.
cim:PSREvent a owl:Class;
             rdfs:comment "Event recording the change in operational status of a power system resource (PSR); may be for an event that has already occurred or for a planned activity."@en;
             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
             rdfs:label "PSREvent"@en;
             rdfs:subClassOf cim:ActivityRecord;
             cimdoc:cimPackage "IEC61968.Operations";
             cimdoc:packageTier "Normative".
cim:PSREvent.PowerSystemResource a owl:ObjectProperty;
                                 rdfs:comment "Power system resource that generated this event."@en;
                                 rdfs:domain cim:PSREvent;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                 rdfs:label "PowerSystemResource"@en;
                                 rdfs:range cim:PowerSystemResource.
cim:PSREvent.kind a owl:ObjectProperty;
                  rdfs:comment "Kind of event."@en;
                  rdfs:domain cim:PSREvent;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                  rdfs:label "kind"@en;
                  rdfs:range cim:PSREventKind.
cim:PSREventKind a owl:Class;
                 rdfs:comment "Kind of power system resource (PSR) event."@en;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                 rdfs:label "PSREventKind"@en;
                 owl:equivalentClass [a owl:Class ; 
                                      owl:oneOf (cim:PSREventKind.inService
                                                 cim:PSREventKind.other
                                                 cim:PSREventKind.outOfService
                                                 cim:PSREventKind.pendingAdd
                                                 cim:PSREventKind.pendingRemove
                                                 cim:PSREventKind.pendingReplace
                                                 cim:PSREventKind.unknown)];
                 cimdoc:cimPackage "IEC61968.Operations";
                 cimdoc:packageTier "Normative".
cim:PSREventKind.inService a owl:NamedIndividual,
                             cim:PSREventKind;
                           rdfs:comment "Power system resource state change to in service."@en;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                           rdfs:label "inService"@en;
                           cimdoc:enumCode 0 .
cim:PSREventKind.other a owl:NamedIndividual,
                         cim:PSREventKind;
                       rdfs:comment "Other power system resource state change."@en;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                       rdfs:label "other"@en;
                       cimdoc:enumCode 5 .
cim:PSREventKind.outOfService a owl:NamedIndividual,
                                cim:PSREventKind;
                              rdfs:comment "Power system resource state change to out of service."@en;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                              rdfs:label "outOfService"@en;
                              cimdoc:enumCode 1 .
cim:PSREventKind.pendingAdd a owl:NamedIndividual,
                              cim:PSREventKind;
                            rdfs:comment "Power system resource state change to pending add."@en;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                            rdfs:label "pendingAdd"@en;
                            cimdoc:enumCode 2 .
cim:PSREventKind.pendingRemove a owl:NamedIndividual,
                                 cim:PSREventKind;
                               rdfs:comment "Power system resource state change to pending remove."@en;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                               rdfs:label "pendingRemove"@en;
                               cimdoc:enumCode 3 .
cim:PSREventKind.pendingReplace a owl:NamedIndividual,
                                  cim:PSREventKind;
                                rdfs:comment "Power system resource state change to pending replace."@en;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                rdfs:label "pendingReplace"@en;
                                cimdoc:enumCode 4 .
cim:PSREventKind.unknown a owl:NamedIndividual,
                           cim:PSREventKind;
                         rdfs:comment "Unknown power system resource state change."@en;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                         rdfs:label "unknown"@en;
                         cimdoc:enumCode 6 .
cim:PanDemandResponse a owl:Class;
                      rdfs:comment "PAN control used to issue action/command to PAN devices during a demand response/load control event."@en;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                      rdfs:label "PanDemandResponse"@en;
                      rdfs:subClassOf cim:EndDeviceAction;
                      cimdoc:cimPackage "IEC61968.Metering";
                      cimdoc:packageTier "Normative".
cim:PanDemandResponse.appliance a owl:ObjectProperty;
                                rdfs:comment "Appliance being controlled."@en;
                                rdfs:domain cim:PanDemandResponse;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                rdfs:label "appliance"@en;
                                rdfs:range cim:ControlledAppliance.
cim:PanDemandResponse.avgLoadAdjustment a owl:DatatypeProperty;
                                        rdfs:comment "Used to define a maximum energy usage limit as a percentage of the client implementations specific average energy usage. The load adjustment percentage is added to 100% creating a percentage limit applied to the client implementations specific average energy usage. A -10% load adjustment percentage will establish an energy usage limit equal to 90% of the client implementations specific average energy usage. Each load adjustment percentage is referenced to the client implementations specific average energy usage. There are no cumulative effects. The range of this field is -100% to +100% with a resolution of 1. A -100% value equals a total load shed. A +100% value will limit the energy usage to the client implementations specific average energy usage."@en;
                                        rdfs:domain cim:PanDemandResponse;
                                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                        rdfs:label "avgLoadAdjustment"@en;
                                        rdfs:range cim:PerCent.
cim:PanDemandResponse.cancelControlMode a owl:DatatypeProperty;
                                        rdfs:comment "Encoding of cancel control."@en;
                                        rdfs:domain cim:PanDemandResponse;
                                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                        rdfs:label "cancelControlMode"@en;
                                        rdfs:range xsd:string.
cim:PanDemandResponse.cancelDateTime a owl:DatatypeProperty;
                                     rdfs:comment "Timestamp when a canceling of the event is scheduled to start."@en;
                                     rdfs:domain cim:PanDemandResponse;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                     rdfs:label "cancelDateTime"@en;
                                     rdfs:range xsd:dateTime.
cim:PanDemandResponse.cancelNow a owl:DatatypeProperty;
                                rdfs:comment "If true, a canceling of the event should start immediately."@en;
                                rdfs:domain cim:PanDemandResponse;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                rdfs:label "cancelNow"@en;
                                rdfs:range xsd:boolean.
cim:PanDemandResponse.coolingOffset a owl:DatatypeProperty;
                                    rdfs:comment "Requested offset to apply to the normal cooling setpoint at the time of the start of the event. It represents a temperature change that will be applied to the associated cooling set point. The temperature offsets will be calculated per the local temperature in the thermostat. The calculated temperature will be interpreted as the number of degrees to be added to the cooling set point. Sequential demand response events are not cumulative. The offset shall be applied to the normal setpoint."@en;
                                    rdfs:domain cim:PanDemandResponse;
                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                    rdfs:label "coolingOffset"@en;
                                    rdfs:range cim:Temperature.
cim:PanDemandResponse.coolingSetpoint a owl:DatatypeProperty;
                                      rdfs:comment "Requested cooling set point. Temperature set point is typically defined and calculated based on local temperature."@en;
                                      rdfs:domain cim:PanDemandResponse;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                      rdfs:label "coolingSetpoint"@en;
                                      rdfs:range cim:Temperature.
cim:PanDemandResponse.criticalityLevel a owl:DatatypeProperty;
                                       rdfs:comment "Level of criticality for the action of this control. The action taken by load control devices for an event can be solely based on this value, or in combination with other load control event fields supported by the device."@en;
                                       rdfs:domain cim:PanDemandResponse;
                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                       rdfs:label "criticalityLevel"@en;
                                       rdfs:range xsd:string.
cim:PanDemandResponse.dutyCycle a owl:DatatypeProperty;
                                rdfs:comment """Maximum \"on\" state duty cycle as a percentage of time. For example, if the value is 80, the device would be in an \"on\" state for 80% of the time for the duration of the action."""@en;
                                rdfs:domain cim:PanDemandResponse;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                rdfs:label "dutyCycle"@en;
                                rdfs:range cim:PerCent.
cim:PanDemandResponse.enrollmentGroup a owl:DatatypeProperty;
                                      rdfs:comment "Provides a mechanism to direct load control actions to groups of PAN devices. It can be used in conjunction with the PAN device types."@en;
                                      rdfs:domain cim:PanDemandResponse;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                      rdfs:label "enrollmentGroup"@en;
                                      rdfs:range xsd:string.
cim:PanDemandResponse.heatingOffset a owl:DatatypeProperty;
                                    rdfs:comment "Requested offset to apply to the normal heating setpoint at the time of the start of the event. It represents a temperature change that will be applied to the associated heating set point. The temperature offsets will be calculated per the local temperature in the thermostat. The calculated temperature will be interpreted as the number of degrees to be subtracted from the heating set point. Sequential demand response events are not cumulative. The offset shall be applied to the normal setpoint."@en;
                                    rdfs:domain cim:PanDemandResponse;
                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                    rdfs:label "heatingOffset"@en;
                                    rdfs:range cim:Temperature.
cim:PanDemandResponse.heatingSetpoint a owl:DatatypeProperty;
                                      rdfs:comment "Requested heating set point. Temperature set point is typically defined and calculated based on local temperature."@en;
                                      rdfs:domain cim:PanDemandResponse;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                      rdfs:label "heatingSetpoint"@en;
                                      rdfs:range cim:Temperature.
cim:PanDisplay a owl:Class;
               rdfs:comment "PAN action/command used to issue the displaying of text messages on PAN devices."@en;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
               rdfs:label "PanDisplay"@en;
               rdfs:subClassOf cim:EndDeviceAction;
               cimdoc:cimPackage "IEC61968.Metering";
               cimdoc:packageTier "Normative".
cim:PanDisplay.confirmationRequired a owl:DatatypeProperty;
                                    rdfs:comment "If true, the requesting entity (e.g. retail electric provider) requires confirmation of the successful display of the text message."@en;
                                    rdfs:domain cim:PanDisplay;
                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                    rdfs:label "confirmationRequired"@en;
                                    rdfs:range xsd:boolean.
cim:PanDisplay.priority a owl:DatatypeProperty;
                        rdfs:comment "Priority associated with the text message to be displayed."@en;
                        rdfs:domain cim:PanDisplay;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                        rdfs:label "priority"@en;
                        rdfs:range xsd:string.
cim:PanDisplay.textMessage a owl:DatatypeProperty;
                           rdfs:comment "Text to be displayed by a PAN device."@en;
                           rdfs:domain cim:PanDisplay;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                           rdfs:label "textMessage"@en;
                           rdfs:range xsd:string.
cim:PanDisplay.transmissionMode a owl:ObjectProperty;
                                rdfs:comment "Transmission mode to be used for this PAN display control."@en;
                                rdfs:domain cim:PanDisplay;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                rdfs:label "transmissionMode"@en;
                                rdfs:range cim:TransmissionModeKind.
cim:PanPricing a owl:Class;
               rdfs:comment "PAN action/command used to issue pricing information to a PAN device."@en;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
               rdfs:label "PanPricing"@en;
               rdfs:subClassOf cim:EndDeviceAction;
               cimdoc:cimPackage "IEC61968.Metering";
               cimdoc:packageTier "Normative".
cim:PanPricing.PanPricingDetails a owl:ObjectProperty;
                                 rdfs:comment "All pricing details issued by this PAN pricing command/action."@en;
                                 rdfs:domain cim:PanPricing;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                 rdfs:label "PanPricingDetails"@en;
                                 rdfs:range cim:PanPricingDetail.
cim:PanPricing.providerID a owl:DatatypeProperty;
                          rdfs:comment "Unique identifier for the commodity provider."@en;
                          rdfs:domain cim:PanPricing;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                          rdfs:label "providerID"@en;
                          rdfs:range xsd:integer.
cim:PanPricingDetail a owl:Class;
                     rdfs:comment "Detail for a single price command/action."@en;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                     rdfs:label "PanPricingDetail"@en;
                     cimdoc:cimPackage "IEC61968.Metering";
                     cimdoc:packageTier "Normative".
cim:PanPricingDetail.alternateCostDelivered a owl:DatatypeProperty;
                                            rdfs:comment "Alternative measure of the cost of the energy consumed. An example might be the emissions of CO2 for each kWh of electricity consumed providing a measure of the environmental cost."@en;
                                            rdfs:domain cim:PanPricingDetail;
                                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                            rdfs:label "alternateCostDelivered"@en;
                                            rdfs:range xsd:float.
cim:PanPricingDetail.alternateCostUnit a owl:DatatypeProperty;
                                       rdfs:comment "Cost unit for the alternate cost delivered field. One example is kg of CO2 per unit of measure."@en;
                                       rdfs:domain cim:PanPricingDetail;
                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                       rdfs:label "alternateCostUnit"@en;
                                       rdfs:range xsd:string.
cim:PanPricingDetail.currentTimeDate a owl:DatatypeProperty;
                                     rdfs:comment "Current time as determined by a PAN device."@en;
                                     rdfs:domain cim:PanPricingDetail;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                     rdfs:label "currentTimeDate"@en;
                                     rdfs:range xsd:dateTime.
cim:PanPricingDetail.generationPrice a owl:DatatypeProperty;
                                     rdfs:comment "Price of the commodity measured in base unit of currency per 'unitOfMeasure'."@en;
                                     rdfs:domain cim:PanPricingDetail;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                     rdfs:label "generationPrice"@en;
                                     rdfs:range cim:Money.
cim:PanPricingDetail.generationPriceRatio a owl:DatatypeProperty;
                                          rdfs:comment """Ratio of 'generationPrice' to the \"normal\" price chosen by the commodity provider."""@en;
                                          rdfs:domain cim:PanPricingDetail;
                                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                          rdfs:label "generationPriceRatio"@en;
                                          rdfs:range xsd:float.
cim:PanPricingDetail.price a owl:DatatypeProperty;
                           rdfs:comment "Price of the commodity measured in base unit of currency per 'unitOfMeasure'."@en;
                           rdfs:domain cim:PanPricingDetail;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                           rdfs:label "price"@en;
                           rdfs:range cim:Money.
cim:PanPricingDetail.priceRatio a owl:DatatypeProperty;
                                rdfs:comment """Ratio of 'price' to the \"normal\" price chosen by the commodity provider."""@en;
                                rdfs:domain cim:PanPricingDetail;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                rdfs:label "priceRatio"@en;
                                rdfs:range xsd:float.
cim:PanPricingDetail.priceTier a owl:DatatypeProperty;
                               rdfs:comment "Pricing tier as chosen by the commodity provider."@en;
                               rdfs:domain cim:PanPricingDetail;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                               rdfs:label "priceTier"@en;
                               rdfs:range xsd:integer.
cim:PanPricingDetail.priceTierCount a owl:DatatypeProperty;
                                    rdfs:comment "Maximum number of price tiers available."@en;
                                    rdfs:domain cim:PanPricingDetail;
                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                    rdfs:label "priceTierCount"@en;
                                    rdfs:range xsd:integer.
cim:PanPricingDetail.priceTierLabel a owl:DatatypeProperty;
                                    rdfs:comment "Label for price tier."@en;
                                    rdfs:domain cim:PanPricingDetail;
                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                    rdfs:label "priceTierLabel"@en;
                                    rdfs:range xsd:string.
cim:PanPricingDetail.rateLabel a owl:DatatypeProperty;
                               rdfs:comment "Label of the current billing rate specified by commodity provider."@en;
                               rdfs:domain cim:PanPricingDetail;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                               rdfs:label "rateLabel"@en;
                               rdfs:range xsd:string.
cim:PanPricingDetail.registerTier a owl:DatatypeProperty;
                                  rdfs:comment "Register tier accumulating usage information."@en;
                                  rdfs:domain cim:PanPricingDetail;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                  rdfs:label "registerTier"@en;
                                  rdfs:range xsd:string.
cim:PanPricingDetail.unitOfMeasure a owl:DatatypeProperty;
                                   rdfs:comment "Defines commodity as well as its base unit of measure."@en;
                                   rdfs:domain cim:PanPricingDetail;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                   rdfs:label "unitOfMeasure"@en;
                                   rdfs:range xsd:string.
cim:ParentOrganization a owl:Class;
                       rdfs:comment "The parent organization class"@en;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                       rdfs:label "ParentOrganization"@en;
                       rdfs:subClassOf cim:Organisation;
                       cimdoc:cimPackage "IEC61968.Common";
                       cimdoc:packageTier "Normative".
cim:PendingCalculation a owl:Class;
                       rdfs:comment "When present, a scalar conversion that needs to be applied to every IntervalReading.value contained in IntervalBlock. This conversion results in a new associated ReadingType, reflecting the true dimensions of IntervalReading values after the conversion."@en;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                       rdfs:label "PendingCalculation"@en;
                       cimdoc:cimPackage "IEC61968.Metering";
                       cimdoc:packageTier "Normative".
cim:PendingCalculation.ReadingType a owl:ObjectProperty;
                                   rdfs:comment "Reading type resulting from this pending conversion."@en;
                                   rdfs:domain cim:PendingCalculation;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                   rdfs:label "ReadingType"@en;
                                   rdfs:range cim:ReadingType.
cim:PendingCalculation.multiplyBeforeAdd a owl:DatatypeProperty;
                                         rdfs:comment "Whether scalars should be applied before adding the 'offset'."@en;
                                         rdfs:domain cim:PendingCalculation;
                                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                         rdfs:label "multiplyBeforeAdd"@en;
                                         rdfs:range xsd:boolean.
cim:PendingCalculation.offset a owl:DatatypeProperty;
                              rdfs:comment "(if applicable) Offset to be added as well as multiplication using scalars."@en;
                              rdfs:domain cim:PendingCalculation;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                              rdfs:label "offset"@en;
                              rdfs:range xsd:integer.
cim:PendingCalculation.scalarDenominator a owl:DatatypeProperty;
                                         rdfs:comment "(if scalar is rational number) When 'IntervalReading.value' is multiplied by 'scalarNumerator' and divided by this value, it causes a unit of measure conversion to occur, resulting in the 'ReadingType.unit'."@en;
                                         rdfs:domain cim:PendingCalculation;
                                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                         rdfs:label "scalarDenominator"@en;
                                         rdfs:range xsd:integer.
cim:PendingCalculation.scalarFloat a owl:DatatypeProperty;
                                   rdfs:comment "(if scalar is floating number) When multiplied with 'IntervalReading.value', it causes a unit of measure conversion to occur, according to the 'ReadingType. unit'."@en;
                                   rdfs:domain cim:PendingCalculation;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                   rdfs:label "scalarFloat"@en;
                                   rdfs:range xsd:float.
cim:PendingCalculation.scalarNumerator a owl:DatatypeProperty;
                                       rdfs:comment "(if scalar is integer or rational number) When the scalar is a simple integer, and this attribute is presented alone and multiplied with 'IntervalReading. value', it causes a unit of measure conversion to occur, resulting in the 'ReadingType.unit'. It is never used in conjunction with 'scalarFloat', only with 'scalarDenominator'."@en;
                                       rdfs:domain cim:PendingCalculation;
                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                       rdfs:label "scalarNumerator"@en;
                                       rdfs:range xsd:integer.
cim:PeriodicStatisticalCalculation a owl:Class;
                                   rdfs:comment "Description of period for which calculation is performed."@en;
