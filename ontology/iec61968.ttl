                               rdfs:domain cim:SwitchingStepGroup;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                               rdfs:label "purpose"@en;
                               rdfs:range xsd:string.
cim:SwitchingStepGroup.sequenceNumber a owl:DatatypeProperty;
                                      rdfs:comment "Order of this activity in the sequence of activities within the switching plan."@en;
                                      rdfs:domain cim:SwitchingStepGroup;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                      rdfs:label "sequenceNumber"@en;
                                      rdfs:range xsd:integer.
