cim:ServiceSupplier.issuerIdentificationNumber a owl:DatatypeProperty;
                                               rdfs:comment "Unique transaction reference prefix number issued to an entity by the International Organization for Standardization for the purpose of tagging onto electronic financial transactions, as defined in ISO/IEC 7812-1 and ISO/IEC 7812-2."@en;
                                               rdfs:domain cim:ServiceSupplier;
                                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
