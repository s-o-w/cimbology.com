                  cimdoc:cimPackage "IEC61968.DER";
                  cimdoc:packageTier "Normative".
cim:DERUnitSymbol.A a owl:NamedIndividual,
                      cim:DERUnitSymbol;
                    rdfs:comment "Current in Ampere."@en;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                    rdfs:label "A"@en;
                    cimdoc:enumCode 5 .
cim:DERUnitSymbol.Ah a owl:NamedIndividual,
                       cim:DERUnitSymbol;
                     rdfs:comment "Ampere-hours, Ampere-hours."@en;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                     rdfs:label "Ah"@en;
                     cimdoc:enumCode 106 .
cim:DERUnitSymbol.As a owl:NamedIndividual,
                       cim:DERUnitSymbol;
                     rdfs:comment "Ampere seconds (A�s)."@en;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                     rdfs:label "As"@en;
                     cimdoc:enumCode 68 .
cim:DERUnitSymbol.Btu a owl:NamedIndividual,
                        cim:DERUnitSymbol;
                      rdfs:comment "Energy, British Thermal Unit."@en;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                      rdfs:label "Btu"@en;
                      cimdoc:enumCode 132 .
cim:DERUnitSymbol.Hz a owl:NamedIndividual,
                       cim:DERUnitSymbol;
                     rdfs:comment "Frequency in Hertz (1/s)."@en;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                     rdfs:label "Hz"@en;
                     cimdoc:enumCode 33 .
cim:DERUnitSymbol.Q a owl:NamedIndividual,
                      cim:DERUnitSymbol;
                    rdfs:comment "Quantity power, Q."@en;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                    rdfs:label "Q"@en;
                    cimdoc:enumCode 100 .
cim:DERUnitSymbol.Qh a owl:NamedIndividual,
                       cim:DERUnitSymbol;
                     rdfs:comment "Quantity energy, Qh."@en;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                     rdfs:label "Qh"@en;
                     cimdoc:enumCode 101 .
cim:DERUnitSymbol.V a owl:NamedIndividual,
                      cim:DERUnitSymbol;
                    rdfs:comment "Electric potential in Volt (W/A)."@en;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                    rdfs:label "V"@en;
                    cimdoc:enumCode 29 .
cim:DERUnitSymbol.VA a owl:NamedIndividual,
                       cim:DERUnitSymbol;
                     rdfs:comment "Apparent power in Volt Ampere (See also real power and reactive power.)"@en;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                     rdfs:label "VA"@en;
                     cimdoc:enumCode 61 .
cim:DERUnitSymbol.VAh a owl:NamedIndividual,
                        cim:DERUnitSymbol;
                      rdfs:comment "Apparent energy in Volt Ampere hours."@en;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                      rdfs:label "VAh"@en;
                      cimdoc:enumCode 71 .
cim:DERUnitSymbol.VAr a owl:NamedIndividual,
                        cim:DERUnitSymbol;
                      rdfs:comment "Reactive power in Volt Ampere reactive. The �reactive� or �imaginary� component of electrical power (VIsin(phi)). (See also real power and apparent power). Note: Different meter designs use different methods to arrive at their results. Some meters may compute reactive power as an arithmetic value, while others compute the value vectorially. The data consumer should determine the method in use and the suitability of the measurement for the intended purpose."@en;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                      rdfs:label "VAr"@en;
                      cimdoc:enumCode 63 .
cim:DERUnitSymbol.VArh a owl:NamedIndividual,
                         cim:DERUnitSymbol;
                       rdfs:comment "Reactive energy in Volt Ampere reactive hours."@en;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                       rdfs:label "VArh"@en;
                       cimdoc:enumCode 73 .
cim:DERUnitSymbol.VPerVA a owl:NamedIndividual,
                           cim:DERUnitSymbol;
                         rdfs:comment "Power factor, PF, the ratio of the active power to the apparent power. Note: The sign convention used for power factor will differ between IEC meters and EEI (ANSI) meters. It is assumed that the data consumers understand the type of meter being used and agree on the sign convention in use at any given utility."@en;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                         rdfs:label "VPerVA"@en;
                         cimdoc:enumCode 153 .
cim:DERUnitSymbol.VPerVAr a owl:NamedIndividual,
                            cim:DERUnitSymbol;
                          rdfs:comment "Power factor, PF, the ratio of the active power to the apparent power. Note: The sign convention used for power factor will differ between IEC meters and EEI (ANSI) meters. It is assumed that the data consumers understand the type of meter being used and agree on the sign convention in use at any given utility."@en;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                          rdfs:label "VPerVAr"@en;
                          cimdoc:enumCode 283 .
cim:DERUnitSymbol.Vh a owl:NamedIndividual,
                       cim:DERUnitSymbol;
                     rdfs:comment "Volt-hour, Volt hours."@en;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                     rdfs:label "Vh"@en;
                     cimdoc:enumCode 280 .
cim:DERUnitSymbol.Vs a owl:NamedIndividual,
                       cim:DERUnitSymbol;
                     rdfs:comment "Volt second (Ws/A)."@en;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                     rdfs:label "Vs"@en;
                     cimdoc:enumCode 66 .
cim:DERUnitSymbol.W a owl:NamedIndividual,
                      cim:DERUnitSymbol;
                    rdfs:comment "Real power in Watt (J/s). Electrical power may have real and reactive components. The real portion of electrical power (I�R or VIcos(phi)), is expressed in Watts. (See also apparent power and reactive power.)"@en;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                    rdfs:label "W"@en;
                    cimdoc:enumCode 38 .
cim:DERUnitSymbol.WPerA a owl:NamedIndividual,
                          cim:DERUnitSymbol;
                        rdfs:comment "Active power per current flow, watt per Ampere."@en;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                        rdfs:label "WPerA"@en;
                        cimdoc:enumCode 281 .
cim:DERUnitSymbol.WPers a owl:NamedIndividual,
                          cim:DERUnitSymbol;
                        rdfs:comment "Ramp rate in Watt per second."@en;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                        rdfs:label "WPers"@en;
                        cimdoc:enumCode 81 .
cim:DERUnitSymbol.Wh a owl:NamedIndividual,
                       cim:DERUnitSymbol;
                     rdfs:comment "Real energy in Watt hours."@en;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                     rdfs:label "Wh"@en;
                     cimdoc:enumCode 72 .
cim:DERUnitSymbol.deg a owl:NamedIndividual,
                        cim:DERUnitSymbol;
                      rdfs:comment "Plane angle in degrees."@en;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                      rdfs:label "deg"@en;
                      cimdoc:enumCode 9 .
cim:DERUnitSymbol.degC a owl:NamedIndividual,
                         cim:DERUnitSymbol;
                       rdfs:comment "Relative temperature in degrees Celsius. In the SI unit system the symbol is �C. Electric charge is measured in coulomb that has the unit symbol C. To distinguish degree Celsius form coulomb the symbol used in the UML is degC. Reason for not using �C is the special character � is difficult to manage in software."@en;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                       rdfs:label "degC"@en;
                       cimdoc:enumCode 23 .
cim:DERUnitSymbol.h a owl:NamedIndividual,
                      cim:DERUnitSymbol;
                    rdfs:comment "Time, hour = 60 min = 3600 s."@en;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                    rdfs:label "h"@en;
                    cimdoc:enumCode 84 .
cim:DERUnitSymbol.min a owl:NamedIndividual,
                        cim:DERUnitSymbol;
                      rdfs:comment "Time, minute = 60 s."@en;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                      rdfs:label "min"@en;
                      cimdoc:enumCode 85 .
cim:DERUnitSymbol.ohm a owl:NamedIndividual,
                        cim:DERUnitSymbol;
                      rdfs:comment "Electric resistance in ohm (V/A)."@en;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                      rdfs:label "ohm"@en;
                      cimdoc:enumCode 30 .
cim:DERUnitSymbol.ohmPerm a owl:NamedIndividual,
                            cim:DERUnitSymbol;
                          rdfs:comment "Electric resistance per length in ohm per metre ((V/A)/m)."@en;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                          rdfs:label "ohmPerm"@en;
                          cimdoc:enumCode 284 .
cim:DERUnitSymbol.ohmm a owl:NamedIndividual,
                         cim:DERUnitSymbol;
                       rdfs:comment "resistivity, Ohm metre, (rho)."@en;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                       rdfs:label "ohmm"@en;
                       cimdoc:enumCode 102 .
