cim:TimePoint a owl:Class;
              rdfs:comment "A point in time within a sequence of points in time relative to a time schedule."@en;
              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
              rdfs:label "TimePoint"@en;
              rdfs:subClassOf cim:IdentifiedObject;
              cimdoc:cimPackage "IEC61968.Common";
              cimdoc:packageTier "Normative".
cim:TimePoint.dateTime a owl:DatatypeProperty;
                       rdfs:comment "Absolute date and time for this time point. For calendar-based time point, it is typically manually entered, while for interval-based or sequence-based time point it is derived."@en;
                       rdfs:domain cim:TimePoint;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                       rdfs:label "dateTime"@en;
                       rdfs:range xsd:dateTime.
cim:TimePoint.relativeTimeInterval a owl:DatatypeProperty;
                                   rdfs:comment "(if interval-based) A point in time relative to scheduled start time in 'TimeSchedule.scheduleInterval.start'."@en;
                                   rdfs:domain cim:TimePoint;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                   rdfs:label "relativeTimeInterval"@en;
                                   rdfs:range cim:Seconds.
cim:TimePoint.sequenceNumber a owl:DatatypeProperty;
                             rdfs:comment "(if sequence-based) Relative sequence number for this time point."@en;
                             rdfs:domain cim:TimePoint;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                             rdfs:label "sequenceNumber"@en;
                             rdfs:range xsd:integer.
cim:TimePoint.status a owl:ObjectProperty;
                     rdfs:comment "Status of this time point."@en;
                     rdfs:domain cim:TimePoint;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                     rdfs:label "status"@en;
                     rdfs:range cim:Status.
cim:TimePoint.window a owl:ObjectProperty;
                     rdfs:comment "Interval defining the window of time for which this time point is valid."@en;
                     rdfs:domain cim:TimePoint;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                     rdfs:label "window"@en;
                     rdfs:range cim:DateTimeInterval.
cim:TimeSchedule a owl:Class;
                 rdfs:comment "Description of anything that changes through time. Time schedule is used to perform a single-valued function of time. Use inherited 'type' attribute to give additional information on this schedule, such as: periodic (hourly, daily, weekly, monthly, etc.), day of the month, by date, calendar (specific times and dates)."@en;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                 rdfs:label "TimeSchedule"@en;
                 rdfs:subClassOf cim:Document;
                 cimdoc:cimPackage "IEC61968.Common";
                 cimdoc:packageTier "Normative".
cim:TimeSchedule.TimePoints a owl:ObjectProperty;
                            rdfs:comment "Sequence of time points belonging to this time schedule."@en;
                            rdfs:domain cim:TimeSchedule;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                            rdfs:label "TimePoints"@en;
                            rdfs:range cim:TimePoint.
cim:TimeSchedule.disabled a owl:DatatypeProperty;
                          rdfs:comment "True if this schedule is deactivated (disabled)."@en;
                          rdfs:domain cim:TimeSchedule;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                          rdfs:label "disabled"@en;
                          rdfs:range xsd:boolean.
cim:TimeSchedule.offset a owl:DatatypeProperty;
                        rdfs:comment "The offset from midnight (i.e., 0 h, 0 min, 0 s) for the periodic time points to begin. For example, for an interval meter that is set up for five minute intervals ('recurrencePeriod'=300=5 min), setting 'offset'=120=2 min would result in scheduled events to read the meter executing at 2 min, 7 min, 12 min, 17 min, 22 min, 27 min, 32 min, 37 min, 42 min, 47 min, 52 min, and 57 min past each hour."@en;
                        rdfs:domain cim:TimeSchedule;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                        rdfs:label "offset"@en;
                        rdfs:range cim:Seconds.
cim:TimeSchedule.recurrencePattern a owl:DatatypeProperty;
                                   rdfs:comment "Interval at which the scheduled action repeats (e.g., first Monday of every month, last day of the month, etc.)."@en;
                                   rdfs:domain cim:TimeSchedule;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                   rdfs:label "recurrencePattern"@en;
                                   rdfs:range xsd:string.
cim:TimeSchedule.recurrencePeriod a owl:DatatypeProperty;
                                  rdfs:comment "Duration between time points, from the beginning of one period to the beginning of the next period. Note that a device like a meter may have multiple interval periods (e.g., 1 min, 5 min, 15 min, 30 min, or 60 min)."@en;
                                  rdfs:domain cim:TimeSchedule;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                  rdfs:label "recurrencePeriod"@en;
                                  rdfs:range cim:Seconds.
cim:TimeSchedule.scheduleInterval a owl:ObjectProperty;
                                  rdfs:comment "Schedule date and time interval."@en;
                                  rdfs:domain cim:TimeSchedule;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                  rdfs:label "scheduleInterval"@en;
                                  rdfs:range cim:DateTimeInterval.
cim:TimeTariffInterval a owl:Class;
                       rdfs:comment "One of a sequence of time intervals defined in terms of real time. It is typically used in association with TariffProfile to define the intervals in a time of use tariff structure, where startDateTime simultaneously determines the starting point of this interval and the ending point of the previous interval."@en;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                       rdfs:label "TimeTariffInterval"@en;
                       cimdoc:cimPackage "IEC61968.PaymentMetering";
                       cimdoc:packageTier "Normative".
cim:TimeTariffInterval.Charges a owl:ObjectProperty;
                               rdfs:comment "All charges used to define this time tariff interval."@en;
                               rdfs:domain cim:TimeTariffInterval;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                               rdfs:label "Charges"@en;
                               rdfs:range cim:Charge.
cim:TimeTariffInterval.sequenceNumber a owl:DatatypeProperty;
                                      rdfs:comment "A sequential reference that defines the identity of this interval and its relative position with respect to other intervals in a sequence of intervals."@en;
                                      rdfs:domain cim:TimeTariffInterval;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                      rdfs:label "sequenceNumber"@en;
                                      rdfs:range xsd:integer.
cim:TimeTariffInterval.startTime a owl:DatatypeProperty;
                                 rdfs:comment "A real time marker that defines the starting time (typically it is the time of day) for this interval. The interval extends to the start of the next interval or until it is reset to the start of the first interval by TariffProfile. tariffCycle."@en;
                                 rdfs:domain cim:TimeTariffInterval;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                 rdfs:label "startTime"@en;
                                 rdfs:range xsd:time.
