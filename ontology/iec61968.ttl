cim:AssetTestLab a owl:Class;
                 rdfs:comment "Test lab that performs various types of testing related to assets."@en;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                 rdfs:label "AssetTestLab"@en;
                 rdfs:subClassOf cim:AssetOrganisationRole;
