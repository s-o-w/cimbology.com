                                    rdfs:comment "Energy source on which this action is taken."@en;
                                    rdfs:domain cim:EnergySourceAction;
                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                    rdfs:label "EnergySource"@en;
                                    rdfs:range cim:EnergySource.
cim:EnergySourceAction.kind a owl:ObjectProperty;
                            rdfs:comment "Switching action to perform."@en;
                            rdfs:domain cim:EnergySourceAction;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                            rdfs:label "kind"@en;
