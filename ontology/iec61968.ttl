                                     cimdoc:enumCode 2 .
cim:AssetFailureMode.failToOpen a owl:NamedIndividual,
                                  cim:AssetFailureMode;
                                rdfs:comment "Failure to open."@en;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                rdfs:label "failToOpen"@en;
