cim:SurgeArresterInfo.lightningImpulseDischargeVoltage a owl:DatatypeProperty;
                                                       rdfs:comment "Residual voltage during an 8x20 microsecond current impulse at the nominal discharge current level."@en;
                                                       rdfs:domain cim:SurgeArresterInfo;
                                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                                       rdfs:label "lightningImpulseDischargeVoltage"@en;
                                                       rdfs:range cim:Voltage.
cim:SurgeArresterInfo.lineDischargeClass a owl:DatatypeProperty;
                                         rdfs:comment "Determines the arrester energy discharge capability. Choices are limited to 0 (none) through 5 (highest) by IEC 60099. Classes 1..3 require a 10-kA nominal discharge current. Classes 4..5 require a 20-kA nominal discharge current. Lower nominal discharge currents must use class 0."@en;
                                         rdfs:domain cim:SurgeArresterInfo;
                                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                         rdfs:label "lineDischargeClass"@en;
                                         rdfs:range xsd:integer.
cim:SurgeArresterInfo.nominalDischargeCurrent a owl:DatatypeProperty;
                                              rdfs:comment "The lightning discharge current used to classify the arrester. Choices are limited to 1.5, 2.5, 5, 10, and 20 kA by IEC 60099."@en;
                                              rdfs:domain cim:SurgeArresterInfo;
                                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                              rdfs:label "nominalDischargeCurrent"@en;
                                              rdfs:range cim:CurrentFlow.
cim:SurgeArresterInfo.pressureReliefClass a owl:DatatypeProperty;
                                          rdfs:comment "Fault current level at which all parts of the failed arrester lie within a circle prescribed by IEC 60099."@en;
                                          rdfs:domain cim:SurgeArresterInfo;
                                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                          rdfs:label "pressureReliefClass"@en;
                                          rdfs:range cim:CurrentFlow.
cim:SurgeArresterInfo.ratedVoltage a owl:DatatypeProperty;
                                   rdfs:comment "The temporary overvoltage (TOV) level at power frequency that the surge arrester withstands for 10 seconds."@en;
                                   rdfs:domain cim:SurgeArresterInfo;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                   rdfs:label "ratedVoltage"@en;
                                   rdfs:range cim:Voltage.
cim:SurgeArresterInfo.steepFrontDischargeVoltage a owl:DatatypeProperty;
                                                 rdfs:comment "Residual voltage during a current impulse with front time of 1 microsecond, and magnitude equal to the nominal discharge current level."@en;
                                                 rdfs:domain cim:SurgeArresterInfo;
                                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                                 rdfs:label "steepFrontDischargeVoltage"@en;
                                                 rdfs:range cim:Voltage.
cim:SurgeArresterInfo.switchingImpulseDischargeVoltage a owl:DatatypeProperty;
                                                       rdfs:comment "Residual voltage during a current impulse with front time of at least 30 microseconds, and magnitude specified in IEC 60099 for the line discharge class. Does not apply to line discharge class 0."@en;
                                                       rdfs:domain cim:SurgeArresterInfo;
                                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                                       rdfs:label "switchingImpulseDischargeVoltage"@en;
                                                       rdfs:range cim:Voltage.
cim:SwitchAction a owl:Class;
                 rdfs:comment "Action on switch as a switching step."@en;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                 rdfs:label "SwitchAction"@en;
                 rdfs:subClassOf cim:SwitchingAction;
                 cimdoc:cimPackage "IEC61968.Operations";
                 cimdoc:packageTier "Normative".
cim:SwitchAction.OperatedSwitch a owl:ObjectProperty;
                                rdfs:comment "Switch that is the object of this switch action."@en;
                                rdfs:domain cim:SwitchAction;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                rdfs:label "OperatedSwitch"@en;
                                rdfs:range cim:Switch.
cim:SwitchAction.kind a owl:ObjectProperty;
                      rdfs:comment "Switching action to perform."@en;
                      rdfs:domain cim:SwitchAction;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                      rdfs:label "kind"@en;
                      rdfs:range cim:SwitchActionKind.
cim:SwitchActionKind a owl:Class;
                     rdfs:comment "Kind of action on switch."@en;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                     rdfs:label "SwitchActionKind"@en;
                     owl:equivalentClass [a owl:Class ; 
                                          owl:oneOf (cim:SwitchActionKind.close
                                                     cim:SwitchActionKind.disableReclosing
                                                     cim:SwitchActionKind.enableReclosing
                                                     cim:SwitchActionKind.open)];
                     cimdoc:cimPackage "IEC61968.Operations";
                     cimdoc:packageTier "Normative".
cim:SwitchActionKind.close a owl:NamedIndividual,
                             cim:SwitchActionKind;
                           rdfs:comment "Close the switch."@en;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                           rdfs:label "close"@en;
                           cimdoc:enumCode 1 .
cim:SwitchActionKind.disableReclosing a owl:NamedIndividual,
                                        cim:SwitchActionKind;
                                      rdfs:comment "Disable (automatic) switch reclosing."@en;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                      rdfs:label "disableReclosing"@en;
                                      cimdoc:enumCode 2 .
cim:SwitchActionKind.enableReclosing a owl:NamedIndividual,
                                       cim:SwitchActionKind;
                                     rdfs:comment "Enable (automatic) switch reclosing."@en;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                     rdfs:label "enableReclosing"@en;
                                     cimdoc:enumCode 3 .
cim:SwitchActionKind.open a owl:NamedIndividual,
                            cim:SwitchActionKind;
                          rdfs:comment "Open the switch."@en;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                          rdfs:label "open"@en;
                          cimdoc:enumCode 0 .
cim:SwitchInfo a owl:Class;
               rdfs:comment "Switch datasheet information."@en;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
               rdfs:label "SwitchInfo"@en;
               rdfs:subClassOf cim:AssetInfo;
               cimdoc:cimPackage "IEC61968.AssetInfo";
               cimdoc:packageTier "Normative".
cim:SwitchInfo.breakingCapacity a owl:DatatypeProperty;
                                rdfs:comment "The maximum fault current a breaking device can break safely under prescribed conditions of use."@en;
                                rdfs:domain cim:SwitchInfo;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                rdfs:label "breakingCapacity"@en;
                                rdfs:range cim:CurrentFlow.
cim:SwitchInfo.gasWeightPerTank a owl:DatatypeProperty;
                                rdfs:comment "Weight of gas in each tank of SF6 dead tank breaker."@en;
                                rdfs:domain cim:SwitchInfo;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                rdfs:label "gasWeightPerTank"@en;
                                rdfs:range cim:Mass.
cim:SwitchInfo.isSinglePhase a owl:DatatypeProperty;
                             rdfs:comment "If true, it is a single phase switch."@en;
                             rdfs:domain cim:SwitchInfo;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                             rdfs:label "isSinglePhase"@en;
                             rdfs:range xsd:boolean.
cim:SwitchInfo.isUnganged a owl:DatatypeProperty;
                          rdfs:comment "If true, the switch is not ganged (i.e., a switch phase may be operated separately from other phases)."@en;
                          rdfs:domain cim:SwitchInfo;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                          rdfs:label "isUnganged"@en;
                          rdfs:range xsd:boolean.
cim:SwitchInfo.lowPressureAlarm a owl:DatatypeProperty;
                                rdfs:comment "Gas or air pressure at or below which a low pressure alarm is generated."@en;
                                rdfs:domain cim:SwitchInfo;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                rdfs:label "lowPressureAlarm"@en;
                                rdfs:range cim:Pressure.
cim:SwitchInfo.lowPressureLockOut a owl:DatatypeProperty;
                                  rdfs:comment "Gas or air pressure below which the breaker will not open."@en;
                                  rdfs:domain cim:SwitchInfo;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                  rdfs:label "lowPressureLockOut"@en;
                                  rdfs:range cim:Pressure.
cim:SwitchInfo.oilVolumePerTank a owl:DatatypeProperty;
                                rdfs:comment "Volume of oil in each tank of bulk oil breaker."@en;
                                rdfs:domain cim:SwitchInfo;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                rdfs:label "oilVolumePerTank"@en;
                                rdfs:range cim:Volume.
cim:SwitchInfo.ratedCurrent a owl:DatatypeProperty;
                            rdfs:comment "Rated current."@en;
                            rdfs:domain cim:SwitchInfo;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                            rdfs:label "ratedCurrent"@en;
                            rdfs:range cim:CurrentFlow.
cim:SwitchInfo.ratedFrequency a owl:DatatypeProperty;
                              rdfs:comment "Frequency for which switch is rated."@en;
                              rdfs:domain cim:SwitchInfo;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                              rdfs:label "ratedFrequency"@en;
                              rdfs:range cim:Frequency.
cim:SwitchInfo.ratedImpulseWithstandVoltage a owl:DatatypeProperty;
                                            rdfs:comment "Rated impulse withstand voltage, also known as BIL (Basic Impulse Level)."@en;
                                            rdfs:domain cim:SwitchInfo;
                                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                            rdfs:label "ratedImpulseWithstandVoltage"@en;
                                            rdfs:range cim:Voltage.
cim:SwitchInfo.ratedInterruptingTime a owl:DatatypeProperty;
                                     rdfs:comment "Switch rated interrupting time in seconds."@en;
                                     rdfs:domain cim:SwitchInfo;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                     rdfs:label "ratedInterruptingTime"@en;
                                     rdfs:range cim:Seconds.
cim:SwitchInfo.ratedVoltage a owl:DatatypeProperty;
                            rdfs:comment "Rated voltage."@en;
                            rdfs:domain cim:SwitchInfo;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                            rdfs:label "ratedVoltage"@en;
                            rdfs:range cim:Voltage.
cim:SwitchOperationSummary a owl:Class;
                           rdfs:comment "Up-to-date, of-record summary of switch operation information, distilled from a variety of sources (real-time data or real-time data historian, field inspections, etc.) of use to asset health analytics."@en;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                           rdfs:label "SwitchOperationSummary"@en;
                           rdfs:subClassOf cim:IdentifiedObject;
                           cimdoc:cimPackage "IEC61968.AssetInfo.Assets";
                           cimdoc:packageTier "Normative".
cim:SwitchOperationSummary.Breaker a owl:ObjectProperty;
                                   rdfs:comment "Breaker asset to which this operation information applies."@en;
