                   cimdoc:packageTier "Normative".
cim:TapChangerInfo.bil a owl:DatatypeProperty;
                       rdfs:comment "Basic Insulation Level (BIL) expressed as the impulse crest voltage of a nominal wave, typically 1.2 X 50 microsecond. This is a measure of the ability of the insulation to withstand very high voltage surges."@en;
                       rdfs:domain cim:TapChangerInfo;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                       rdfs:label "bil"@en;
