                             cim:DERUnitSymbol;
                           rdfs:comment "Reciprocal of frequency (1/Hz)."@en;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                           rdfs:label "onePerHz"@en;
                           cimdoc:enumCode 282 .
