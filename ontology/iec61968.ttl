                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                   rdfs:label "insulationU"@en;
                                   rdfs:range cim:Voltage.
cim:TransformerEndInfo.phaseAngleClock a owl:DatatypeProperty;
                                       rdfs:comment "Winding phase angle where 360 degrees are represented with clock hours, so the valid values are {0, ..., 11}. For example, to express the second winding in code 'Dyn11', set attributes as follows: 'endNumber'=2, 'connectionKind' = Yn and 'phaseAngleClock' = 11."@en;
                                       rdfs:domain cim:TransformerEndInfo;
                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                       rdfs:label "phaseAngleClock"@en;
                                       rdfs:range xsd:integer.
