                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                           rdfs:label "enroute"@en;
                           cimdoc:enumCode 3 .
cim:CrewStatusKind.fieldComplete a owl:NamedIndividual,
                                   cim:CrewStatusKind;
                                 rdfs:comment "the crew has corrected the outage in the field. The equipment or other devices may not be energized at this time."@en;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                 rdfs:label "fieldComplete"@en;
                                 cimdoc:enumCode 4 .
