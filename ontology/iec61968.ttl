                               rdfs:label "status"@en;
                               rdfs:range cim:Status.
cim:AssetModelCatalogueItem a owl:Class;
                            rdfs:comment "Provides pricing and other relevant information about a specific manufacturer's product (i.e., AssetModel), and its price from a given supplier. A single AssetModel may be availble from multiple suppliers. Note that manufacturer and supplier are both types of organisation, which the association is inherited from Document."@en;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                            rdfs:label "AssetModelCatalogueItem"@en;
