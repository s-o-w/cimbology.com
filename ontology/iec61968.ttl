                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                             rdfs:label "OutagePlan"@en;
                             rdfs:range cim:OutagePlan.
cim:SwitchingPlan.SafetyDocuments a owl:ObjectProperty;
                                  rdfs:comment "All safety documents applicable to this swtiching plan."@en;
                                  rdfs:domain cim:SwitchingPlan;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                  rdfs:label "SafetyDocuments"@en;
                                  rdfs:range cim:SafetyDocument.
cim:SwitchingPlan.SwitchingStepGroups a owl:ObjectProperty;
                                      rdfs:comment "All groups of switching steps within this switching plan."@en;
                                      rdfs:domain cim:SwitchingPlan;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                      rdfs:label "SwitchingStepGroups"@en;
                                      rdfs:range cim:SwitchingStepGroup.
cim:SwitchingPlan.WorkTasks a owl:ObjectProperty;
                            rdfs:comment "All work tasks to execute this switching plan."@en;
                            rdfs:domain cim:SwitchingPlan;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                            rdfs:label "WorkTasks"@en;
