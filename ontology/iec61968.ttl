                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                  rdfs:label "tension"@en;
                                  cimdoc:enumCode 1 .
cim:TownDetail a owl:Class;
               rdfs:comment "Town details, in the context of address."@en;
