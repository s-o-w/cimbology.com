cim:TransformerEndInfo.CoreAdmittance a owl:ObjectProperty;
                                      rdfs:comment "Core admittance calculated from this transformer end datasheet, representing magnetising current and core losses. The full values of the transformer should be supplied for one transformer end info only."@en;
                                      rdfs:domain cim:TransformerEndInfo;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                      rdfs:label "CoreAdmittance"@en;
                                      rdfs:range cim:TransformerCoreAdmittance.
cim:TransformerEndInfo.FromMeshImpedances a owl:ObjectProperty;
                                          rdfs:comment "All mesh impedances between this 'to' and other 'from' transformer ends."@en;
                                          rdfs:domain cim:TransformerEndInfo;
                                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                          rdfs:label "FromMeshImpedances"@en;
                                          rdfs:range cim:TransformerMeshImpedance.
cim:TransformerEndInfo.ToMeshImpedances a owl:ObjectProperty;
                                        rdfs:comment "All mesh impedances between this 'from' and other 'to' transformer ends."@en;
                                        rdfs:domain cim:TransformerEndInfo;
                                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                        rdfs:label "ToMeshImpedances"@en;
                                        rdfs:range cim:TransformerMeshImpedance.
cim:TransformerEndInfo.TransformerStarImpedance a owl:ObjectProperty;
                                                rdfs:comment "Transformer star impedance calculated from this transformer end datasheet."@en;
                                                rdfs:domain cim:TransformerEndInfo;
                                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
