cim:ErpItemMaster a owl:Class;
                  rdfs:comment "Any unique purchased part for manufactured product tracked by ERP systems for a utility. Item, as used by the OAG, refers to the basic information about an item, including its attributes, cost, and locations. It does not include item quantities. Compare to the Inventory, which includes all quantities and other location-specific information."@en;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                  rdfs:label "ErpItemMaster"@en;
                  rdfs:subClassOf cim:ErpIdentifiedObject;
                  cimdoc:cimPackage "IEC61968.InfIEC61968.InfERPSupport";
                  cimdoc:packageTier "Informative".
cim:ErpItemMaster.Asset a owl:ObjectProperty;
                        rdfs:comment "The asset"@en;
                        rdfs:domain cim:ErpItemMaster;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                        rdfs:label "Asset"@en;
                        rdfs:range cim:Asset.
cim:ErpItemMaster.status a owl:ObjectProperty;
                         rdfs:comment "The status"@en;
                         rdfs:domain cim:ErpItemMaster;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                         rdfs:label "status"@en;
                         rdfs:range cim:Status.
cim:ErpJournal a owl:Class;
               rdfs:comment "Book for recording accounting transactions as they occur. Transactions and adjustments are first recorded in a journal, which is like a diary of instructions, advising which account to be charged and by how much. A journal represents a change in the balances of a business's financial accounts. Many tasks or transactions throughout an enterprise will result in the creation of a journal. Some examples are creating a customer invoice, paying a vendor, transferring inventory, or paying employees."@en;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
               rdfs:label "ErpJournal"@en;
               rdfs:subClassOf cim:ErpDocument;
               cimdoc:cimPackage "IEC61968.InfIEC61968.InfERPSupport";
               cimdoc:packageTier "Informative".
cim:ErpJournal.ErpJournalEntries a owl:ObjectProperty;
                                 rdfs:comment "The erp journal entries"@en;
                                 rdfs:domain cim:ErpJournal;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                 rdfs:label "ErpJournalEntries"@en;
                                 rdfs:range cim:ErpJournalEntry.
cim:ErpJournalEntry a owl:Class;
                    rdfs:comment "Details of an individual entry in a journal, which is to be posted to a ledger on the posting date."@en;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                    rdfs:label "ErpJournalEntry"@en;
                    rdfs:subClassOf cim:ErpIdentifiedObject;
                    cimdoc:cimPackage "IEC61968.InfIEC61968.InfERPSupport";
                    cimdoc:packageTier "Informative".
cim:ErpJournalEntry.accountID a owl:DatatypeProperty;
                              rdfs:comment "Account identifier for this entry."@en;
                              rdfs:domain cim:ErpJournalEntry;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                              rdfs:label "accountID"@en;
                              rdfs:range xsd:string.
cim:ErpJournalEntry.amount a owl:DatatypeProperty;
                           rdfs:comment "The amount of the debit or credit for this account."@en;
                           rdfs:domain cim:ErpJournalEntry;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                           rdfs:label "amount"@en;
                           rdfs:range cim:Money.
cim:ErpJournalEntry.postingDateTime a owl:DatatypeProperty;
                                    rdfs:comment "Date and time this entry is to be posted to the ledger."@en;
                                    rdfs:domain cim:ErpJournalEntry;
                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                    rdfs:label "postingDateTime"@en;
