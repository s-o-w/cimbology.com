cim:ElectronicAddress.radio a owl:DatatypeProperty;
                            rdfs:comment "Radio address."@en;
                            rdfs:domain cim:ElectronicAddress;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                            rdfs:label "radio"@en;
                            rdfs:range xsd:string.
cim:ElectronicAddress.userID a owl:DatatypeProperty;
                             rdfs:comment "User ID needed to log in, which can be for an individual person, an organisation, a location, etc."@en;
                             rdfs:domain cim:ElectronicAddress;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                             rdfs:label "userID"@en;
                             rdfs:range xsd:string.
cim:ElectronicAddress.web a owl:DatatypeProperty;
                          rdfs:comment "World wide web address."@en;
                          rdfs:domain cim:ElectronicAddress;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                          rdfs:label "web"@en;
                          rdfs:range xsd:string.
cim:EndDevice a owl:Class;
              rdfs:comment "Asset container that performs one or more end device functions. One type of end device is a meter which can perform metering, load management, connect/disconnect, accounting functions, etc. Some end devices, such as ones monitoring and controlling air conditioners, refrigerators, pool pumps may be connected to a meter. All end devices may have communication capability defined by the associated communication function(s). An end device may be owned by a consumer, a service provider, utility or otherwise. There may be a related end device function that identifies a sensor or control point within a metering application or communications systems (e.g., water, gas, electricity). Some devices may use an optical port that conforms to the ANSI C12.18 standard for communications."@en;
              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
              rdfs:label "EndDevice"@en;
              rdfs:subClassOf cim:AssetContainer;
              cimdoc:cimPackage "IEC61968.Metering";
              cimdoc:packageTier "Normative".
cim:EndDevice.EndDeviceFunctions a owl:ObjectProperty;
                                 rdfs:comment "All end device functions this end device performs."@en;
                                 rdfs:domain cim:EndDevice;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                 rdfs:label "EndDeviceFunctions"@en;
                                 rdfs:range cim:EndDeviceFunction.
cim:EndDevice.EndDeviceInfo a owl:ObjectProperty;
                            rdfs:comment "End device data."@en;
                            rdfs:domain cim:EndDevice;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                            rdfs:label "EndDeviceInfo"@en;
                            rdfs:range cim:EndDeviceInfo.
cim:EndDevice.amrSystem a owl:DatatypeProperty;
                        rdfs:comment "Automated meter reading (AMR) or other communication system responsible for communications to this end device."@en;
                        rdfs:domain cim:EndDevice;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                        rdfs:label "amrSystem"@en;
                        rdfs:range xsd:string.
cim:EndDevice.installCode a owl:DatatypeProperty;
                          rdfs:comment "Installation code."@en;
                          rdfs:domain cim:EndDevice;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                          rdfs:label "installCode"@en;
                          rdfs:range xsd:string.
cim:EndDevice.isPan a owl:DatatypeProperty;
                    rdfs:comment "If true, this is a premises area network (PAN) device."@en;
                    rdfs:domain cim:EndDevice;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                    rdfs:label "isPan"@en;
                    rdfs:range xsd:boolean.
cim:EndDevice.isSmartInverter a owl:DatatypeProperty;
                              rdfs:comment "If true, there is a communicating inverter present."@en;
                              rdfs:domain cim:EndDevice;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                              rdfs:label "isSmartInverter"@en;
                              rdfs:range xsd:boolean.
cim:EndDevice.isVirtual a owl:DatatypeProperty;
                        rdfs:comment "If true, there is no physical device. As an example, a virtual meter can be defined to aggregate the consumption for two or more physical meters. Otherwise, this is a physical hardware device."@en;
                        rdfs:domain cim:EndDevice;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                        rdfs:label "isVirtual"@en;
                        rdfs:range xsd:boolean.
cim:EndDevice.timeZoneOffset a owl:DatatypeProperty;
                             rdfs:comment "Time zone offset relative to GMT for the location of this end device."@en;
                             rdfs:domain cim:EndDevice;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                             rdfs:label "timeZoneOffset"@en;
                             rdfs:range cim:Minutes.
cim:EndDeviceAction a owl:Class;
                    rdfs:comment "Action/command performed by an end device on a device other than the end device."@en;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                    rdfs:label "EndDeviceAction"@en;
                    cimdoc:cimPackage "IEC61968.Metering";
                    cimdoc:packageTier "Normative".
cim:EndDeviceAction.command a owl:DatatypeProperty;
                            rdfs:comment "Command text."@en;
                            rdfs:domain cim:EndDeviceAction;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                            rdfs:label "command"@en;
                            rdfs:range xsd:string.
cim:EndDeviceAction.duration a owl:DatatypeProperty;
                             rdfs:comment "Amount of time the action of this control is to remain active."@en;
                             rdfs:domain cim:EndDeviceAction;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                             rdfs:label "duration"@en;
                             rdfs:range cim:Minutes.
cim:EndDeviceAction.durationIndefinite a owl:DatatypeProperty;
                                       rdfs:comment "True if the action of this control is indefinite."@en;
                                       rdfs:domain cim:EndDeviceAction;
                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                       rdfs:label "durationIndefinite"@en;
                                       rdfs:range xsd:boolean.
cim:EndDeviceAction.startDateTime a owl:DatatypeProperty;
                                  rdfs:comment "Start date and time for action of this control."@en;
                                  rdfs:domain cim:EndDeviceAction;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                  rdfs:label "startDateTime"@en;
                                  rdfs:range xsd:dateTime.
cim:EndDeviceCapability a owl:Class;
                        rdfs:comment "Inherent capabilities of an end device (i.e., the functions it supports)."@en;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                        rdfs:label "EndDeviceCapability"@en;
                        cimdoc:cimPackage "IEC61968.Metering";
                        cimdoc:packageTier "Normative".
cim:EndDeviceCapability.autonomousDst a owl:DatatypeProperty;
                                      rdfs:comment "True if autonomous DST (daylight saving time) function is supported."@en;
                                      rdfs:domain cim:EndDeviceCapability;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                      rdfs:label "autonomousDst"@en;
                                      rdfs:range xsd:boolean.
cim:EndDeviceCapability.communication a owl:DatatypeProperty;
                                      rdfs:comment "True if communication function is supported."@en;
                                      rdfs:domain cim:EndDeviceCapability;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                      rdfs:label "communication"@en;
                                      rdfs:range xsd:boolean.
cim:EndDeviceCapability.connectDisconnect a owl:DatatypeProperty;
                                          rdfs:comment "True if connect and disconnect function is supported."@en;
                                          rdfs:domain cim:EndDeviceCapability;
                                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                          rdfs:label "connectDisconnect"@en;
                                          rdfs:range xsd:boolean.
cim:EndDeviceCapability.demandResponse a owl:DatatypeProperty;
                                       rdfs:comment "True if demand response function is supported."@en;
                                       rdfs:domain cim:EndDeviceCapability;
                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                       rdfs:label "demandResponse"@en;
                                       rdfs:range xsd:boolean.
cim:EndDeviceCapability.electricMetering a owl:DatatypeProperty;
                                         rdfs:comment "True if electric metering function is supported."@en;
                                         rdfs:domain cim:EndDeviceCapability;
                                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                         rdfs:label "electricMetering"@en;
                                         rdfs:range xsd:boolean.
cim:EndDeviceCapability.gasMetering a owl:DatatypeProperty;
                                    rdfs:comment "True if gas metering function is supported."@en;
                                    rdfs:domain cim:EndDeviceCapability;
                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                    rdfs:label "gasMetering"@en;
                                    rdfs:range xsd:boolean.
cim:EndDeviceCapability.metrology a owl:DatatypeProperty;
                                  rdfs:comment "True if metrology function is supported."@en;
                                  rdfs:domain cim:EndDeviceCapability;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                  rdfs:label "metrology"@en;
                                  rdfs:range xsd:boolean.
cim:EndDeviceCapability.onRequestRead a owl:DatatypeProperty;
                                      rdfs:comment "True if on request read function is supported."@en;
                                      rdfs:domain cim:EndDeviceCapability;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                      rdfs:label "onRequestRead"@en;
                                      rdfs:range xsd:boolean.
cim:EndDeviceCapability.outageHistory a owl:DatatypeProperty;
                                      rdfs:comment "True if outage history function is supported."@en;
                                      rdfs:domain cim:EndDeviceCapability;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                      rdfs:label "outageHistory"@en;
                                      rdfs:range xsd:boolean.
cim:EndDeviceCapability.pressureCompensation a owl:DatatypeProperty;
                                             rdfs:comment "True if device performs pressure compensation for metered quantities."@en;
                                             rdfs:domain cim:EndDeviceCapability;
                                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                             rdfs:label "pressureCompensation"@en;
                                             rdfs:range xsd:boolean.
cim:EndDeviceCapability.pricingInfo a owl:DatatypeProperty;
                                    rdfs:comment "True if pricing information is supported."@en;
                                    rdfs:domain cim:EndDeviceCapability;
                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                    rdfs:label "pricingInfo"@en;
                                    rdfs:range xsd:boolean.
cim:EndDeviceCapability.pulseOutput a owl:DatatypeProperty;
                                    rdfs:comment "True if device produces pulse outputs."@en;
                                    rdfs:domain cim:EndDeviceCapability;
                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                    rdfs:label "pulseOutput"@en;
                                    rdfs:range xsd:boolean.
cim:EndDeviceCapability.relaysProgramming a owl:DatatypeProperty;
                                          rdfs:comment "True if relays programming function is supported."@en;
                                          rdfs:domain cim:EndDeviceCapability;
                                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                          rdfs:label "relaysProgramming"@en;
                                          rdfs:range xsd:boolean.
cim:EndDeviceCapability.reverseFlow a owl:DatatypeProperty;
                                    rdfs:comment "True if reverse flow function is supported."@en;
                                    rdfs:domain cim:EndDeviceCapability;
                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                    rdfs:label "reverseFlow"@en;
                                    rdfs:range xsd:boolean.
cim:EndDeviceCapability.superCompressibilityCompensation a owl:DatatypeProperty;
                                                         rdfs:comment "True if device performs super compressibility compensation for metered quantities."@en;
                                                         rdfs:domain cim:EndDeviceCapability;
                                                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                                         rdfs:label "superCompressibilityCompensation"@en;
                                                         rdfs:range xsd:boolean.
cim:EndDeviceCapability.temperatureCompensation a owl:DatatypeProperty;
                                                rdfs:comment "True if device performs temperature compensation for metered quantities."@en;
                                                rdfs:domain cim:EndDeviceCapability;
                                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                                rdfs:label "temperatureCompensation"@en;
                                                rdfs:range xsd:boolean.
cim:EndDeviceCapability.textMessage a owl:DatatypeProperty;
                                    rdfs:comment "True if the displaying of text messages is supported."@en;
                                    rdfs:domain cim:EndDeviceCapability;
                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                    rdfs:label "textMessage"@en;
                                    rdfs:range xsd:boolean.
cim:EndDeviceCapability.waterMetering a owl:DatatypeProperty;
                                      rdfs:comment "True if water metering function is supported."@en;
                                      rdfs:domain cim:EndDeviceCapability;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                      rdfs:label "waterMetering"@en;
                                      rdfs:range xsd:boolean.
cim:EndDeviceControl a owl:Class;
                     rdfs:comment "Instructs an end device (or an end device group) to perform a specified action."@en;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                     rdfs:label "EndDeviceControl"@en;
                     rdfs:subClassOf cim:IdentifiedObject;
                     cimdoc:cimPackage "IEC61968.Metering";
                     cimdoc:packageTier "Normative".
cim:EndDeviceControl.EndDeviceAction a owl:ObjectProperty;
                                     rdfs:comment "End device action issued by this end device control."@en;
                                     rdfs:domain cim:EndDeviceControl;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                     rdfs:label "EndDeviceAction"@en;
                                     rdfs:range cim:EndDeviceAction.
cim:EndDeviceControl.EndDeviceControlType a owl:ObjectProperty;
                                          rdfs:comment "Type of this end device control."@en;
                                          rdfs:domain cim:EndDeviceControl;
                                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                          rdfs:label "EndDeviceControlType"@en;
                                          rdfs:range cim:EndDeviceControlType.
cim:EndDeviceControl.EndDevices a owl:ObjectProperty;
                                rdfs:comment "All end devices receiving commands from this end device control."@en;
                                rdfs:domain cim:EndDeviceControl;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                rdfs:label "EndDevices"@en;
                                rdfs:range cim:EndDevice.
cim:EndDeviceControl.UsagePointGroups a owl:ObjectProperty;
                                      rdfs:comment "All usage point groups receiving commands from this end device control."@en;
                                      rdfs:domain cim:EndDeviceControl;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                      rdfs:label "UsagePointGroups"@en;
                                      rdfs:range cim:UsagePointGroup.
cim:EndDeviceControl.UsagePoints a owl:ObjectProperty;
                                 rdfs:comment "All usage points receiving commands from this end device control."@en;
                                 rdfs:domain cim:EndDeviceControl;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                 rdfs:label "UsagePoints"@en;
                                 rdfs:range cim:UsagePoint.
cim:EndDeviceControl.drProgramLevel a owl:DatatypeProperty;
                                    rdfs:comment "Level of a demand response program request, where 0=emergency. Note: Attribute is not defined on DemandResponseProgram as it is not its inherent property (it serves to control it)."@en;
                                    rdfs:domain cim:EndDeviceControl;
                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                    rdfs:label "drProgramLevel"@en;
                                    rdfs:range xsd:integer.
cim:EndDeviceControl.drProgramMandatory a owl:DatatypeProperty;
                                        rdfs:comment "Whether a demand response program request is mandatory. Note: Attribute is not defined on DemandResponseProgram as it is not its inherent property (it serves to control it)."@en;
                                        rdfs:domain cim:EndDeviceControl;
                                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                        rdfs:label "drProgramMandatory"@en;
                                        rdfs:range xsd:boolean.
cim:EndDeviceControl.issuerID a owl:DatatypeProperty;
                              rdfs:comment "Unique identifier of the business entity originating an end device control."@en;
                              rdfs:domain cim:EndDeviceControl;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                              rdfs:label "issuerID"@en;
                              rdfs:range xsd:string.
cim:EndDeviceControl.issuerTrackingID a owl:DatatypeProperty;
                                      rdfs:comment "Identifier assigned by the initiator (e.g. retail electric provider) of an end device control action to uniquely identify the demand response event, text message, or other subject of the control action. Can be used when cancelling an event or text message request or to identify the originating event or text message in a consequential end device event."@en;
                                      rdfs:domain cim:EndDeviceControl;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                      rdfs:label "issuerTrackingID"@en;
                                      rdfs:range xsd:string.
cim:EndDeviceControl.priceSignal a owl:DatatypeProperty;
                                 rdfs:comment "(if applicable) Price signal used as parameter for this end device control."@en;
                                 rdfs:domain cim:EndDeviceControl;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                 rdfs:label "priceSignal"@en;
                                 rdfs:range xsd:float.
cim:EndDeviceControl.primaryDeviceTiming a owl:ObjectProperty;
                                         rdfs:comment "Timing for the control actions performed on the device identified in the end device control."@en;
                                         rdfs:domain cim:EndDeviceControl;
                                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                         rdfs:label "primaryDeviceTiming"@en;
                                         rdfs:range cim:EndDeviceTiming.
cim:EndDeviceControl.reason a owl:DatatypeProperty;
                            rdfs:comment "Reason for the control action that allows to determine how to continue processing. For example, disconnect meter command may require different processing by the receiving system if it has been issued for a network-related reason (protection) or for a payment-related reason."@en;
                            rdfs:domain cim:EndDeviceControl;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                            rdfs:label "reason"@en;
                            rdfs:range xsd:string.
cim:EndDeviceControl.scheduledInterval a owl:ObjectProperty;
                                       rdfs:comment "(if control has scheduled duration) Date and time interval the control has been scheduled to execute within."@en;
                                       rdfs:domain cim:EndDeviceControl;
                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                       rdfs:label "scheduledInterval"@en;
                                       rdfs:range cim:DateTimeInterval.
cim:EndDeviceControl.secondaryDeviceTiming a owl:ObjectProperty;
                                           rdfs:comment "Timing for the control actions performed by devices that are responding to event related information sent to the primary device indicated in the end device control. For example, load control actions performed by a PAN device in response to demand response event information sent to a PAN gateway server."@en;
                                           rdfs:domain cim:EndDeviceControl;
                                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                           rdfs:label "secondaryDeviceTiming"@en;
                                           rdfs:range cim:EndDeviceTiming.
cim:EndDeviceControlType a owl:Class;
                         rdfs:comment "Detailed description for a control produced by an end device. Values in attributes allow for creation of recommended codes to be used for identifying end device controls as follows: type.domain.subDomain.eventOrAction."@en;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                         rdfs:label "EndDeviceControlType"@en;
                         rdfs:subClassOf cim:IdentifiedObject;
                         cimdoc:cimPackage "IEC61968.Metering";
                         cimdoc:packageTier "Normative".
cim:EndDeviceControlType.domain a owl:DatatypeProperty;
                                rdfs:comment "High-level nature of the control."@en;
                                rdfs:domain cim:EndDeviceControlType;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                rdfs:label "domain"@en;
                                rdfs:range xsd:string.
cim:EndDeviceControlType.eventOrAction a owl:DatatypeProperty;
                                       rdfs:comment "The most specific part of this control type. It is mainly in the form of a verb that gives action to the control that just occurred."@en;
                                       rdfs:domain cim:EndDeviceControlType;
                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                       rdfs:label "eventOrAction"@en;
                                       rdfs:range xsd:string.
cim:EndDeviceControlType.subDomain a owl:DatatypeProperty;
                                   rdfs:comment "More specific nature of the control, as a further sub-categorisation of 'domain'."@en;
                                   rdfs:domain cim:EndDeviceControlType;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                   rdfs:label "subDomain"@en;
                                   rdfs:range xsd:string.
cim:EndDeviceControlType.type a owl:DatatypeProperty;
                              rdfs:comment "Type of physical device from which the control was created. A value of zero (0) can be used when the source is unknown."@en;
                              rdfs:domain cim:EndDeviceControlType;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                              rdfs:label "type"@en;
                              rdfs:range xsd:string.
cim:EndDeviceEvent a owl:Class;
                   rdfs:comment "Event detected by a device function associated with the end device."@en;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                   rdfs:label "EndDeviceEvent"@en;
                   rdfs:subClassOf cim:ActivityRecord;
                   cimdoc:cimPackage "IEC61968.Metering";
                   cimdoc:packageTier "Normative".
cim:EndDeviceEvent.EndDevice a owl:ObjectProperty;
                             rdfs:comment "End device that reported this end device event."@en;
                             rdfs:domain cim:EndDeviceEvent;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                             rdfs:label "EndDevice"@en;
                             rdfs:range cim:EndDevice.
cim:EndDeviceEvent.EndDeviceEventDetails a owl:ObjectProperty;
                                         rdfs:comment "All details of this end device event."@en;
                                         rdfs:domain cim:EndDeviceEvent;
                                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                         rdfs:label "EndDeviceEventDetails"@en;
                                         rdfs:range cim:EndDeviceEventDetail.
cim:EndDeviceEvent.EndDeviceEventType a owl:ObjectProperty;
                                      rdfs:comment "Type of this end device event."@en;
                                      rdfs:domain cim:EndDeviceEvent;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                      rdfs:label "EndDeviceEventType"@en;
                                      rdfs:range cim:EndDeviceEventType.
cim:EndDeviceEvent.UsagePoint a owl:ObjectProperty;
                              rdfs:comment "Usage point for which this end device event is reported."@en;
                              rdfs:domain cim:EndDeviceEvent;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                              rdfs:label "UsagePoint"@en;
                              rdfs:range cim:UsagePoint.
cim:EndDeviceEvent.issuerID a owl:DatatypeProperty;
                            rdfs:comment "Unique identifier of the business entity originating an end device control."@en;
                            rdfs:domain cim:EndDeviceEvent;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                            rdfs:label "issuerID"@en;
                            rdfs:range xsd:string.
cim:EndDeviceEvent.issuerTrackingID a owl:DatatypeProperty;
                                    rdfs:comment "Identifier assigned by the initiator (e.g. retail electric provider) of an end device control action to uniquely identify the demand response event, text message, or other subject of the control action. Can be used when cancelling an event or text message request or to identify the originating event or text message in a consequential end device event."@en;
                                    rdfs:domain cim:EndDeviceEvent;
                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                    rdfs:label "issuerTrackingID"@en;
                                    rdfs:range xsd:string.
cim:EndDeviceEvent.userID a owl:DatatypeProperty;
                          rdfs:comment "(if user initiated) ID of user who initiated this end device event."@en;
                          rdfs:domain cim:EndDeviceEvent;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                          rdfs:label "userID"@en;
                          rdfs:range xsd:string.
cim:EndDeviceEventDetail a owl:Class;
                         rdfs:comment "Name-value pair, specific to end device events."@en;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                         rdfs:label "EndDeviceEventDetail"@en;
                         cimdoc:cimPackage "IEC61968.Metering";
                         cimdoc:packageTier "Normative".
cim:EndDeviceEventDetail.name a owl:DatatypeProperty;
                              rdfs:comment "Name."@en;
                              rdfs:domain cim:EndDeviceEventDetail;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                              rdfs:label "name"@en;
                              rdfs:range xsd:string.
cim:EndDeviceEventDetail.value a owl:DatatypeProperty;
                               rdfs:comment "Value, including unit information."@en;
                               rdfs:domain cim:EndDeviceEventDetail;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                               rdfs:label "value"@en;
                               rdfs:range cim:StringQuantity.
cim:EndDeviceEventType a owl:Class;
                       rdfs:comment "Detailed description for an event produced by an end device. Values in attributes allow for creation of recommended codes to be used for identifying end device events as follows: type.domain.subDomain.eventOrAction."@en;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                       rdfs:label "EndDeviceEventType"@en;
                       rdfs:subClassOf cim:IdentifiedObject;
                       cimdoc:cimPackage "IEC61968.Metering";
                       cimdoc:packageTier "Normative".
cim:EndDeviceEventType.domain a owl:DatatypeProperty;
                              rdfs:comment "High-level nature of the event. By properly classifying events by a small set of domain codes, a system can more easily run reports based on the types of events that have occurred or been received."@en;
                              rdfs:domain cim:EndDeviceEventType;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                              rdfs:label "domain"@en;
                              rdfs:range xsd:string.
cim:EndDeviceEventType.eventOrAction a owl:DatatypeProperty;
                                     rdfs:comment "The most specific part of this event type. It is mainly in the form of a verb that gives action to the event that just occurred."@en;
                                     rdfs:domain cim:EndDeviceEventType;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                     rdfs:label "eventOrAction"@en;
                                     rdfs:range xsd:string.
cim:EndDeviceEventType.subDomain a owl:DatatypeProperty;
                                 rdfs:comment "More specific nature of the event, as a further sub-categorisation of 'domain'."@en;
                                 rdfs:domain cim:EndDeviceEventType;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                 rdfs:label "subDomain"@en;
                                 rdfs:range xsd:string.
cim:EndDeviceEventType.type a owl:DatatypeProperty;
                            rdfs:comment "Type of physical device from which the event was created. A value of zero (0) can be used when the source is unknown."@en;
                            rdfs:domain cim:EndDeviceEventType;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                            rdfs:label "type"@en;
                            rdfs:range xsd:string.
cim:EndDeviceFunction a owl:Class;
                      rdfs:comment "Function performed by an end device such as a meter, communication equipment, controllers, etc."@en;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                      rdfs:label "EndDeviceFunction"@en;
                      rdfs:subClassOf cim:AssetFunction;
                      cimdoc:cimPackage "IEC61968.Metering";
                      cimdoc:packageTier "Normative".
cim:EndDeviceFunction.enabled a owl:DatatypeProperty;
                              rdfs:comment "True if the function is enabled."@en;
                              rdfs:domain cim:EndDeviceFunction;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                              rdfs:label "enabled"@en;
                              rdfs:range xsd:boolean.
cim:EndDeviceFunctionKind a owl:Class;
                          rdfs:comment "Kind of end device function."@en;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                          rdfs:label "EndDeviceFunctionKind"@en;
                          owl:equivalentClass [a owl:Class ; 
                                               owl:oneOf (cim:EndDeviceFunctionKind.autonomousDst
                                                          cim:EndDeviceFunctionKind.demandResponse
                                                          cim:EndDeviceFunctionKind.electricMetering
                                                          cim:EndDeviceFunctionKind.gasMetering
                                                          cim:EndDeviceFunctionKind.metrology
                                                          cim:EndDeviceFunctionKind.onRequestRead
                                                          cim:EndDeviceFunctionKind.outageHistory
                                                          cim:EndDeviceFunctionKind.relaysProgramming
                                                          cim:EndDeviceFunctionKind.reverseFlow
                                                          cim:EndDeviceFunctionKind.waterMetering)];
                          cimdoc:cimPackage "IEC61968.Metering";
                          cimdoc:packageTier "Normative".
cim:EndDeviceFunctionKind.autonomousDst a owl:NamedIndividual,
                                          cim:EndDeviceFunctionKind;
                                        rdfs:comment "Autonomous application of daylight saving time (DST)."@en;
                                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                        rdfs:label "autonomousDst"@en;
                                        cimdoc:enumCode 6 .
cim:EndDeviceFunctionKind.demandResponse a owl:NamedIndividual,
                                           cim:EndDeviceFunctionKind;
                                         rdfs:comment "Demand response functions."@en;
                                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                         rdfs:label "demandResponse"@en;
                                         cimdoc:enumCode 1 .
cim:EndDeviceFunctionKind.electricMetering a owl:NamedIndividual,
                                             cim:EndDeviceFunctionKind;
                                           rdfs:comment "Electricity metering."@en;
                                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                           rdfs:label "electricMetering"@en;
                                           cimdoc:enumCode 7 .
cim:EndDeviceFunctionKind.gasMetering a owl:NamedIndividual,
                                        cim:EndDeviceFunctionKind;
                                      rdfs:comment "Gas metering."@en;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                      rdfs:label "gasMetering"@en;
                                      cimdoc:enumCode 8 .
cim:EndDeviceFunctionKind.metrology a owl:NamedIndividual,
                                      cim:EndDeviceFunctionKind;
                                    rdfs:comment "Presentation of metered values to a user or another system (always a function of a meter, but might not be supported by a load control unit)."@en;
                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                    rdfs:label "metrology"@en;
                                    cimdoc:enumCode 2 .
cim:EndDeviceFunctionKind.onRequestRead a owl:NamedIndividual,
