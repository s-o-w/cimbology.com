                       rdfs:label "isVirtual"@en;
                       rdfs:range xsd:boolean.
cim:Register.leftDigitCount a owl:DatatypeProperty;
                            rdfs:comment "Number of digits (dials on a mechanical meter) to the left of the decimal place; default is normally 5."@en;
