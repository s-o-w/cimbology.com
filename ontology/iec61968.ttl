cim:Medium a owl:Class;
           rdfs:comment "A substance that either (1) provides the means of transmission of a force or effect, such as hydraulic fluid, or (2) is used for a surrounding or enveloping substance, such as oil in a transformer or circuit breaker."@en;
           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
           rdfs:label "Medium"@en;
           rdfs:subClassOf cim:IdentifiedObject;
