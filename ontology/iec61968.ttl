                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                               rdfs:label "ethernet"@en;
                               cimdoc:enumCode 1 .
cim:ComTechnologyKind.homePlug a owl:NamedIndividual,
                                 cim:ComTechnologyKind;
                               rdfs:comment "Communicates using power line communication technologies conforming to the standards established by the HomePlug Powerline Alliance. A specific variant of 'plc'."@en;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
