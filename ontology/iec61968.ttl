                                        rdfs:comment "On-request reads."@en;
                                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                        rdfs:label "onRequestRead"@en;
                                        cimdoc:enumCode 5 .
cim:EndDeviceFunctionKind.outageHistory a owl:NamedIndividual,
                                          cim:EndDeviceFunctionKind;
                                        rdfs:comment "Reporting historical power interruption data."@en;
                                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                        rdfs:label "outageHistory"@en;
                                        cimdoc:enumCode 3 .
cim:EndDeviceFunctionKind.relaysProgramming a owl:NamedIndividual,
