                          rdfs:domain cim:ElectronicAddress;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                          rdfs:label "mac"@en;
                          rdfs:range xsd:string.
cim:ElectronicAddress.password a owl:DatatypeProperty;
                               rdfs:comment "Password needed to log in."@en;
                               rdfs:domain cim:ElectronicAddress;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
