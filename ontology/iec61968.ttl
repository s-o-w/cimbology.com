cim:SwitchingPlan.approvedDateTime a owl:DatatypeProperty;
                                   rdfs:comment "The date and time the switching plan was approved"@en;
                                   rdfs:domain cim:SwitchingPlan;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                   rdfs:label "approvedDateTime"@en;
                                   rdfs:range xsd:dateTime.
cim:SwitchingPlan.cancelledDateTime a owl:DatatypeProperty;
                                    rdfs:comment "Date and Time the switching plan was cancelled."@en;
                                    rdfs:domain cim:SwitchingPlan;
                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                    rdfs:label "cancelledDateTime"@en;
                                    rdfs:range xsd:dateTime.
cim:SwitchingPlan.plannedPeriod a owl:ObjectProperty;
                                rdfs:comment "the planned start and end times for the switching plan."@en;
                                rdfs:domain cim:SwitchingPlan;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                rdfs:label "plannedPeriod"@en;
                                rdfs:range cim:DateTimeInterval.
cim:SwitchingPlan.purpose a owl:DatatypeProperty;
                          rdfs:comment "Purpose of this plan, such as whether it is to move the state from normal to some abnormal condition, or to restore the normal state after an abnormal condition, or to perform some kind of optimisation such as correction of overload, voltage control, etc."@en;
                          rdfs:domain cim:SwitchingPlan;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                          rdfs:label "purpose"@en;
                          rdfs:range xsd:string.
cim:SwitchingPlan.rank a owl:DatatypeProperty;
                       rdfs:comment "Ranking in comparison to other switching plans."@en;
                       rdfs:domain cim:SwitchingPlan;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                       rdfs:label "rank"@en;
                       rdfs:range xsd:integer.
cim:SwitchingPlanRequest a owl:Class;
                         rdfs:comment "A document used to request that a switching plan be created for a particular purpose."@en;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                         rdfs:label "SwitchingPlanRequest"@en;
                         rdfs:subClassOf cim:Document;
                         cimdoc:cimPackage "IEC61968.Operations";
                         cimdoc:packageTier "Normative".
cim:SwitchingPlanRequest.RequestingOrganization a owl:ObjectProperty;
                                                rdfs:comment "The organization that requested the switching plan."@en;
                                                rdfs:domain cim:SwitchingPlanRequest;
                                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                                rdfs:label "RequestingOrganization"@en;
                                                rdfs:range cim:Organisation.
cim:SwitchingPlanRequest.SwitchingPlan a owl:ObjectProperty;
                                       rdfs:comment "The switching plan for the request."@en;
                                       rdfs:domain cim:SwitchingPlanRequest;
                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
