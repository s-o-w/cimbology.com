cim:CrewStatusKind a owl:Class;
                   rdfs:comment "Defines the current status of the Crew - assigned, arrived, etc."@en;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                   rdfs:label "CrewStatusKind"@en;
                   owl:equivalentClass [a owl:Class ; 
                                        owl:oneOf (cim:CrewStatusKind.arrived
                                                   cim:CrewStatusKind.assigned
                                                   cim:CrewStatusKind.awaitingCrewAssignment
                                                   cim:CrewStatusKind.enroute
                                                   cim:CrewStatusKind.fieldComplete)];
                   cimdoc:cimPackage "IEC61968.Common";
                   cimdoc:packageTier "Normative".
cim:CrewStatusKind.arrived a owl:NamedIndividual,
                             cim:CrewStatusKind;
                           rdfs:comment "the crew is on site at the outage location"@en;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                           rdfs:label "arrived"@en;
                           cimdoc:enumCode 0 .
cim:CrewStatusKind.assigned a owl:NamedIndividual,
                              cim:CrewStatusKind;
                            rdfs:comment "the crew has been assigned to work on a task"@en;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                            rdfs:label "assigned"@en;
                            cimdoc:enumCode 1 .
cim:CrewStatusKind.awaitingCrewAssignment a owl:NamedIndividual,
                                            cim:CrewStatusKind;
