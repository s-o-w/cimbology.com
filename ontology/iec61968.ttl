cim:SwitchingStepGroup.description a owl:DatatypeProperty;
                                   rdfs:comment "Descriptive information concerning the switching step group."@en;
                                   rdfs:domain cim:SwitchingStepGroup;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                   rdfs:label "description"@en;
                                   rdfs:range xsd:string.
cim:SwitchingStepGroup.isFreeSequence a owl:DatatypeProperty;
                                      rdfs:comment "If true, the sequence number serves for presentation purposes only, and the activity itself may be executed at any time."@en;
                                      rdfs:domain cim:SwitchingStepGroup;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                      rdfs:label "isFreeSequence"@en;
                                      rdfs:range xsd:boolean.
cim:SwitchingStepGroup.purpose a owl:DatatypeProperty;
