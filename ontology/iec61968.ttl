cim:ErpBOM a owl:Class;
           rdfs:comment "Information that generally describes the Bill of Material Structure and its contents for a utility. This is used by ERP systems to transfer Bill of Material information between two business applications."@en;
           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
           rdfs:label "ErpBOM"@en;
           rdfs:subClassOf cim:ErpDocument;
           cimdoc:cimPackage "IEC61968.InfIEC61968.InfERPSupport";
           cimdoc:packageTier "Informative".
cim:ErpBankAccount a owl:Class;
                   rdfs:comment "Relationship under a particular name, usually evidenced by a deposit against which withdrawals can be made. Types of bank accounts include: demand, time, custodial, joint, trustee, corporate, special, and regular accounts. A statement of transactions during a fiscal period and the resulting balance is maintained on each account. For Payment metering, the account is associated with Bank and Supplier, reflecting details of the bank account used for depositing revenue collected by TokenVendor. The name of the account holder should be specified in 'name' attribute."@en;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                   rdfs:label "ErpBankAccount"@en;
                   rdfs:subClassOf cim:BankAccount;
                   cimdoc:cimPackage "IEC61968.InfIEC61968.InfERPSupport";
                   cimdoc:packageTier "Informative".
cim:ErpBankAccount.bankABA a owl:DatatypeProperty;
                           rdfs:comment "Bank ABA."@en;
                           rdfs:domain cim:ErpBankAccount;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                           rdfs:label "bankABA"@en;
                           rdfs:range xsd:string.
cim:ErpBomItemData a owl:Class;
                   rdfs:comment "An individual item on a bill of materials."@en;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                   rdfs:label "ErpBomItemData"@en;
                   rdfs:subClassOf cim:ErpIdentifiedObject;
                   cimdoc:cimPackage "IEC61968.InfIEC61968.InfERPSupport";
                   cimdoc:packageTier "Informative".
cim:ErpBomItemData.DesignLocation a owl:ObjectProperty;
                                  rdfs:comment "The design location"@en;
                                  rdfs:domain cim:ErpBomItemData;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                  rdfs:label "DesignLocation"@en;
                                  rdfs:range cim:DesignLocation.
cim:ErpBomItemData.ErpBOM a owl:ObjectProperty;
                          rdfs:comment "The erp bom"@en;
                          rdfs:domain cim:ErpBomItemData;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                          rdfs:label "ErpBOM"@en;
                          rdfs:range cim:ErpBOM.
cim:ErpChartOfAccounts a owl:Class;
                       rdfs:comment "Accounting structure of a business. Each account represents a financial aspect of a business, such as its Accounts Payable, or the value of its inventory, or its office supply expenses."@en;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                       rdfs:label "ErpChartOfAccounts"@en;
                       rdfs:subClassOf cim:ErpDocument;
                       cimdoc:cimPackage "IEC61968.InfIEC61968.InfERPSupport";
                       cimdoc:packageTier "Informative".
cim:ErpCompetency a owl:Class;
                  rdfs:comment "Information that describes aptitudes of a utility employee. Unlike Skills that an ErpPerson must be certified to perform before undertaking certain type of assignments (to be able to perfrom a Craft), ErpCompetency has more to do with typical Human Resource (HR) matters such as schooling, training, etc."@en;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                  rdfs:label "ErpCompetency"@en;
                  rdfs:subClassOf cim:ErpIdentifiedObject;
                  cimdoc:cimPackage "IEC61968.InfIEC61968.InfERPSupport";
                  cimdoc:packageTier "Informative".
