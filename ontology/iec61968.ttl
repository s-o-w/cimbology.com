cim:ErpJournalEntry.sourceID a owl:DatatypeProperty;
                             rdfs:comment "The identifer of the source for this entry."@en;
                             rdfs:domain cim:ErpJournalEntry;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                             rdfs:label "sourceID"@en;
                             rdfs:range xsd:string.
cim:ErpJournalEntry.status a owl:ObjectProperty;
                           rdfs:comment "The status"@en;
                           rdfs:domain cim:ErpJournalEntry;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                           rdfs:label "status"@en;
                           rdfs:range cim:Status.
cim:ErpJournalEntry.transactionDateTime a owl:DatatypeProperty;
                                        rdfs:comment "Date and time journal entry was recorded."@en;
                                        rdfs:domain cim:ErpJournalEntry;
                                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                        rdfs:label "transactionDateTime"@en;
                                        rdfs:range xsd:dateTime.
cim:ErpLedBudLineItem a owl:Class;
                      rdfs:comment "Individual entry of a given Ledger Budget, typically containing information such as amount, accounting date, accounting period, and is associated with the applicable general ledger account."@en;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                      rdfs:label "ErpLedBudLineItem"@en;
                      rdfs:subClassOf cim:ErpIdentifiedObject;
