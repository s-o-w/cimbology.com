cim:QualificationRequirement a owl:Class;
                             rdfs:comment "Certain skills are required and must be certified in order for a person (typically a member of a crew) to be qualified to work on types of equipment."@en;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
