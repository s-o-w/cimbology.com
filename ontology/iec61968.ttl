cim:QualificationRequirement.Specifications a owl:ObjectProperty;
                                            rdfs:comment "The specifications"@en;
                                            rdfs:domain cim:QualificationRequirement;
                                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                            rdfs:label "Specifications"@en;
