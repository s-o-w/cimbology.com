cim:GroundAction.GroundedEquipment a owl:ObjectProperty;
                                   rdfs:comment "Equipment being grounded with this operation. In case of placing a ground anywhere along a line segment, you must use the clamp (to get the distance from one terminal), so use the explicit relation with line segment. In all other cases (including placing the ground at a line segment terminal), reference to one or more conducting equipment is sufficient."@en;
                                   rdfs:domain cim:GroundAction;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
