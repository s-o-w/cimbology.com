                                 rdfs:label "EnergisedEnd"@en;
                                 rdfs:range cim:TransformerEndInfo.
cim:OpenCircuitTest.OpenEnd a owl:ObjectProperty;
                            rdfs:comment "Transformer end measured for induced voltage and angle in this open-circuit test."@en;
                            rdfs:domain cim:OpenCircuitTest;
