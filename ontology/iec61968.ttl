cim:ComTechnologyKind.rfMesh a owl:NamedIndividual,
                               cim:ComTechnologyKind;
                             rdfs:comment "Communicates using a mesh radio technology. A specific variant of 'rf'."@en;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                             rdfs:label "rfMesh"@en;
                             cimdoc:enumCode 7 .
cim:ComTechnologyKind.zigbee a owl:NamedIndividual,
