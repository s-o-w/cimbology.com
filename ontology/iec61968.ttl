cim:SwitchingPlanRequest.equipmentToBeIsolated a owl:DatatypeProperty;
                                               rdfs:comment "free-form list of the equipment to be isolated by the switching"@en;
                                               rdfs:domain cim:SwitchingPlanRequest;
                                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
