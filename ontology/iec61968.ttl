cim:SwitchOperationSummary.lifetimeTotalOperations a owl:DatatypeProperty;
                                                   rdfs:comment "Total breaker operations to date (including fault and non-fault)."@en;
                                                   rdfs:domain cim:SwitchOperationSummary;
                                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
