                                 cimdoc:enumCode 5 .
cim:ServiceRequestKind.repair a owl:NamedIndividual,
                                cim:ServiceRequestKind;
                              rdfs:comment "Repair work."@en;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                              rdfs:label "repair"@en;
                              cimdoc:enumCode 2 .
cim:ServiceRequestKind.replace a owl:NamedIndividual,
                                 cim:ServiceRequestKind;
                               rdfs:comment "replace an asset"@en;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
