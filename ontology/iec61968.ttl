cim:SwitchOperationSummary.mostRecentFaultOperationDate a owl:DatatypeProperty;
                                                        rdfs:comment "Date of most recent breaker fault operation."@en;
                                                        rdfs:domain cim:SwitchOperationSummary;
                                                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                                        rdfs:label "mostRecentFaultOperationDate"@en;
                                                        rdfs:range xsd:date.
cim:SwitchOperationSummary.mostRecentMotorStartDate a owl:DatatypeProperty;
                                                    rdfs:comment "Date of most recent motor start."@en;
                                                    rdfs:domain cim:SwitchOperationSummary;
                                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                                    rdfs:label "mostRecentMotorStartDate"@en;
                                                    rdfs:range xsd:date.
cim:SwitchOperationSummary.mostRecentOperationDate a owl:DatatypeProperty;
                                                   rdfs:comment "Date of most recent breaker operation (fault or non-fault)."@en;
                                                   rdfs:domain cim:SwitchOperationSummary;
                                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                                   rdfs:label "mostRecentOperationDate"@en;
