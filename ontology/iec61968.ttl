cim:EndDeviceGroup a owl:Class;
                   rdfs:comment "Abstraction for management of group communications within a two-way AMR system or the data for a group of related end devices. Commands can be issued to all of the end devices that belong to the group using a defined group address and the underlying AMR communication infrastructure. A DERGroup and a PANDeviceGroup is an EndDeviceGroup."@en;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                   rdfs:label "EndDeviceGroup"@en;
                   rdfs:subClassOf cim:IdentifiedObject;
                   cimdoc:cimPackage "IEC61968.Metering";
                   cimdoc:packageTier "Normative".
cim:EndDeviceGroup.DERFunction a owl:ObjectProperty;
                               rdfs:comment "The DER functions that are applied to the DER Group."@en;
                               rdfs:domain cim:EndDeviceGroup;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                               rdfs:label "DERFunction"@en;
                               rdfs:range cim:DERFunction.
cim:EndDeviceGroup.DERGroupDispatch a owl:ObjectProperty;
                                    rdfs:comment "An individual dispatch for a DER Group."@en;
                                    rdfs:domain cim:EndDeviceGroup;
                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                    rdfs:label "DERGroupDispatch"@en;
                                    rdfs:range cim:DERGroupDispatch.
cim:EndDeviceGroup.DERMonitorableParameter a owl:ObjectProperty;
