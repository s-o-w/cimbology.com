cim:AssetLocationHazard a owl:Class;
                        rdfs:comment "Potential hazard related to the location of an asset. Examples are trees growing under overhead power lines, a park being located by a substation (i.e., children climb fence to recover a ball), a lake near an overhead distribution line (fishing pole/line contacting power lines), dangerous neighbour, etc."@en;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                        rdfs:label "AssetLocationHazard"@en;
                        rdfs:subClassOf cim:Hazard;
                        cimdoc:cimPackage "IEC61968.AssetInfo.Assets";
                        cimdoc:packageTier "Normative".
