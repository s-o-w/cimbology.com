@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix cim: <http://iec.ch/TC57/CIM100#>.
@prefix cimdoc: <https://cimbology.com/ontology/cimdoc#>.

cim:ASTMStandard a owl:Class;
                 rdfs:comment "Standard published by ASTM (ASTM International)."@en;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                 rdfs:label "ASTMStandard"@en;
                 cimdoc:cimPackage "IEC61968.AssetInfo.Assets";
                 cimdoc:packageTier "Normative".
cim:ASTMStandard.standardEdition a owl:ObjectProperty;
                                 rdfs:comment "Edition of ASTM standard."@en;
                                 rdfs:domain cim:ASTMStandard;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                 rdfs:label "standardEdition"@en;
                                 rdfs:range cim:ASTMStandardEditionKind.
cim:ASTMStandard.standardNumber a owl:ObjectProperty;
                                rdfs:comment "ASTM standard number."@en;
                                rdfs:domain cim:ASTMStandard;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                rdfs:label "standardNumber"@en;
                                rdfs:range cim:ASTMStandardKind.
cim:ASTMStandardEditionKind a owl:Class;
                            rdfs:comment "List of editions for ASTM standards."@en;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                            rdfs:label "ASTMStandardEditionKind"@en;
                            owl:equivalentClass [a owl:Class ; 
                                                 owl:oneOf (cim:ASTMStandardEditionKind.none
                                                            cim:ASTMStandardEditionKind.unknown)];
                            cimdoc:cimPackage "IEC61968.AssetInfo.Assets";
                            cimdoc:packageTier "Normative".
cim:ASTMStandardEditionKind.none a owl:NamedIndividual,
                                   cim:ASTMStandardEditionKind;
                                 rdfs:comment "No edition."@en;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                 rdfs:label "none"@en;
                                 cimdoc:enumCode 0 .
cim:ASTMStandardEditionKind.unknown a owl:NamedIndividual,
                                      cim:ASTMStandardEditionKind;
                                    rdfs:comment "Unknown edition."@en;
                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                    rdfs:label "unknown"@en;
                                    cimdoc:enumCode 1 .
cim:ASTMStandardKind a owl:Class;
                     rdfs:comment "List of ASTM standards."@en;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                     rdfs:label "ASTMStandardKind"@en;
                     owl:equivalentClass [a owl:Class ; 
                                          owl:oneOf (cim:ASTMStandardKind.ASTMD1945)];
                     cimdoc:cimPackage "IEC61968.AssetInfo.Assets";
                     cimdoc:packageTier "Normative".
cim:ASTMStandardKind.ASTMD1945 a owl:NamedIndividual,
                                 cim:ASTMStandardKind;
                               rdfs:comment "Standard Test Method for Analysis of Natural Gases by Gas Chromatography."@en;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                               rdfs:label "ASTMD1945"@en;
                               cimdoc:enumCode 0 .
cim:AcceptanceTest a owl:Class;
                   rdfs:comment "Acceptance test for assets."@en;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                   rdfs:label "AcceptanceTest"@en;
                   cimdoc:cimPackage "IEC61968.AssetInfo.Assets";
                   cimdoc:packageTier "Normative".
cim:AcceptanceTest.dateTime a owl:DatatypeProperty;
                            rdfs:comment "Date and time the asset was last tested using the 'type' of test and yielding the current status in 'success' attribute."@en;
                            rdfs:domain cim:AcceptanceTest;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                            rdfs:label "dateTime"@en;
                            rdfs:range xsd:dateTime.
cim:AcceptanceTest.success a owl:DatatypeProperty;
                           rdfs:comment "True if asset has passed acceptance test and may be placed in or is in service. It is set to false if asset is removed from service and is required to be tested again before being placed back in service, possibly in a new location. Since asset may go through multiple tests during its lifecycle, the date of each acceptance test may be recorded in 'Asset.ActivityRecord.status.dateTime'."@en;
                           rdfs:domain cim:AcceptanceTest;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                           rdfs:label "success"@en;
                           rdfs:range xsd:boolean.
cim:AcceptanceTest.type a owl:DatatypeProperty;
                        rdfs:comment "Type of test or group of tests that was conducted on 'dateTime'."@en;
                        rdfs:domain cim:AcceptanceTest;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                        rdfs:label "type"@en;
                        rdfs:range xsd:string.
cim:AccessPermit a owl:Class;
                 rdfs:comment "A permit is sometimes needed to provide legal access to land or equipment. For example, local authority permission for road works."@en;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                 rdfs:label "AccessPermit"@en;
                 rdfs:subClassOf cim:WorkDocument;
                 cimdoc:cimPackage "IEC61968.InfIEC61968.InfWork";
                 cimdoc:packageTier "Informative".
cim:AccessPermit.applicationNumber a owl:DatatypeProperty;
                                   rdfs:comment "Permit application number that is used by municipality, state, province, etc."@en;
                                   rdfs:domain cim:AccessPermit;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                   rdfs:label "applicationNumber"@en;
                                   rdfs:range xsd:string.
cim:AccessPermit.effectiveDate a owl:DatatypeProperty;
                               rdfs:comment "Date that permit became official."@en;
                               rdfs:domain cim:AccessPermit;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                               rdfs:label "effectiveDate"@en;
                               rdfs:range xsd:date.
cim:AccessPermit.expirationDate a owl:DatatypeProperty;
                                rdfs:comment "Permit expiration date."@en;
                                rdfs:domain cim:AccessPermit;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                rdfs:label "expirationDate"@en;
                                rdfs:range xsd:date.
cim:AccessPermit.payment a owl:DatatypeProperty;
                         rdfs:comment "Total cost of permit."@en;
                         rdfs:domain cim:AccessPermit;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                         rdfs:label "payment"@en;
                         rdfs:range cim:Money.
cim:AccessPermit.permitID a owl:DatatypeProperty;
                          rdfs:comment "Permit identifier."@en;
                          rdfs:domain cim:AccessPermit;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                          rdfs:label "permitID"@en;
                          rdfs:range xsd:string.
cim:AccountMovement a owl:Class;
                    rdfs:comment "Credit/debit movements for an account."@en;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                    rdfs:label "AccountMovement"@en;
                    cimdoc:cimPackage "IEC61968.PaymentMetering";
                    cimdoc:packageTier "Normative".
cim:AccountMovement.amount a owl:DatatypeProperty;
                           rdfs:comment "Amount that was credited to/debited from an account. For example: payment received/interest charge on arrears."@en;
                           rdfs:domain cim:AccountMovement;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                           rdfs:label "amount"@en;
                           rdfs:range cim:Money.
cim:AccountMovement.dateTime a owl:DatatypeProperty;
                             rdfs:comment "Date and time when the credit/debit transaction was performed."@en;
                             rdfs:domain cim:AccountMovement;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                             rdfs:label "dateTime"@en;
                             rdfs:range xsd:dateTime.
cim:AccountMovement.reason a owl:DatatypeProperty;
                           rdfs:comment "Reason for credit/debit transaction on an account. Example: payment received/arrears interest levied."@en;
                           rdfs:domain cim:AccountMovement;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                           rdfs:label "reason"@en;
                           rdfs:range xsd:string.
cim:AccountNotification a owl:Class;
                        rdfs:comment "Notifications for move-in, move-out, delinquencies, etc."@en;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                        rdfs:label "AccountNotification"@en;
                        cimdoc:cimPackage "IEC61968.Customers";
                        cimdoc:packageTier "Normative".
cim:AccountNotification.customerNotificationType a owl:DatatypeProperty;
                                                 rdfs:comment "Notifications for move-in, move-out, delinquencies, planned outage, demand response programs, time of use, etc."@en;
                                                 rdfs:domain cim:AccountNotification;
                                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                                 rdfs:label "customerNotificationType"@en;
                                                 rdfs:range xsd:string.
cim:AccountNotification.methodType a owl:DatatypeProperty;
                                   rdfs:comment "method of notification such as phone call, email, letter, door hanger, text message, etc."@en;
                                   rdfs:domain cim:AccountNotification;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                   rdfs:label "methodType"@en;
                                   rdfs:range xsd:string.
cim:AccountNotification.note a owl:DatatypeProperty;
                             rdfs:comment "Free form text characterizing the notification."@en;
                             rdfs:domain cim:AccountNotification;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                             rdfs:label "note"@en;
                             rdfs:range xsd:string.
cim:AccountNotification.time a owl:DatatypeProperty;
                             rdfs:comment "Time of notification - this is the time the notification was sent."@en;
                             rdfs:domain cim:AccountNotification;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                             rdfs:label "time"@en;
                             rdfs:range xsd:dateTime.
cim:AccountingUnit a owl:Class;
                   rdfs:comment "Unit for accounting; use either 'energyUnit' or 'currencyUnit' to specify the unit for 'value'."@en;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                   rdfs:label "AccountingUnit"@en;
                   cimdoc:cimPackage "IEC61968.PaymentMetering";
                   cimdoc:packageTier "Normative".
cim:AccountingUnit.energyUnit a owl:DatatypeProperty;
                              rdfs:comment "Unit of service."@en;
                              rdfs:domain cim:AccountingUnit;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                              rdfs:label "energyUnit"@en;
                              rdfs:range cim:RealEnergy.
cim:AccountingUnit.monetaryUnit a owl:ObjectProperty;
                                rdfs:comment "Unit of currency."@en;
                                rdfs:domain cim:AccountingUnit;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                rdfs:label "monetaryUnit"@en;
                                rdfs:range cim:Currency.
cim:AccountingUnit.multiplier a owl:ObjectProperty;
                              rdfs:comment "Multiplier for the 'energyUnit' or 'monetaryUnit'."@en;
                              rdfs:domain cim:AccountingUnit;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                              rdfs:label "multiplier"@en;
                              rdfs:range cim:UnitMultiplier.
cim:AccountingUnit.value a owl:DatatypeProperty;
                         rdfs:comment "Value expressed in applicable units."@en;
                         rdfs:domain cim:AccountingUnit;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                         rdfs:label "value"@en;
                         rdfs:range xsd:float.
cim:AccumulationKind a owl:Class;
                     rdfs:comment "Kind of accumulation behaviour for read / measured values from individual end points."@en;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                     rdfs:label "AccumulationKind"@en;
                     owl:equivalentClass [a owl:Class ; 
                                          owl:oneOf (cim:AccumulationKind.boundedQuantity
                                                     cim:AccumulationKind.bulkQuantity
                                                     cim:AccumulationKind.continuousCumulative
                                                     cim:AccumulationKind.cumulative
                                                     cim:AccumulationKind.deltaData
                                                     cim:AccumulationKind.indicating
                                                     cim:AccumulationKind.instantaneous
                                                     cim:AccumulationKind.latchingQuantity
                                                     cim:AccumulationKind.none
                                                     cim:AccumulationKind.summation
                                                     cim:AccumulationKind.timeDelay)];
                     cimdoc:cimPackage "IEC61968.Metering";
                     cimdoc:packageTier "Normative".
cim:AccumulationKind.boundedQuantity a owl:NamedIndividual,
                                       cim:AccumulationKind;
                                     rdfs:comment "A time-independent cumulative quantity much like a 'bulkQuantity' or a 'latchingQuantity', except that the accumulation stops at the maximum or minimum values. When the maximum is reached, any additional positive accumulation is discarded, but negative accumulation may be accepted (thus lowering the counter.) Likewise, when the negative bound is reached, any additional negative accumulation is discarded, but positive accumulation is accepted (thus increasing the counter.)"@en;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                     rdfs:label "boundedQuantity"@en;
                                     cimdoc:enumCode 14 .
cim:AccumulationKind.bulkQuantity a owl:NamedIndividual,
                                    cim:AccumulationKind;
                                  rdfs:comment "A value from a register which represents the bulk quantity of a commodity. This quantity is computed as the integral of the commodity usage rate. This value is typically used as the basis for the dial reading at the meter, and as a result, will roll over upon reaching a maximum dial value. Note 1: With the metering system, the roll-over behaviour typically implies a roll-under behavior so that the value presented is always a positive value (e.g. unsigned integer or positive decimal.) However, when communicating data between enterprise applications a negative value might occur in a case such as net metering. Note 2: A 'bulkQuantity' refers primarily to the dial reading and not the consumption over a specific period of time."@en;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                  rdfs:label "bulkQuantity"@en;
                                  cimdoc:enumCode 1 .
cim:AccumulationKind.continuousCumulative a owl:NamedIndividual,
                                            cim:AccumulationKind;
                                          rdfs:comment "The sum of the previous billing period values and the present period value. Note: 'continuousCumulative' is commonly used in conjunction with 'demand', and it would represent the cumulative sum of the previous billing period maximum demand values (as occurring with each demand reset) summed with the present period maximum demand value (which has yet to be reset.)"@en;
                                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                          rdfs:label "continuousCumulative"@en;
                                          cimdoc:enumCode 2 .
cim:AccumulationKind.cumulative a owl:NamedIndividual,
                                  cim:AccumulationKind;
                                rdfs:comment "The sum of the previous billing period values. Note: 'cumulative' is commonly used in conjunction with �demand.� Each demand reset causes the maximum demand value for the present billing period (since the last demand reset) to accumulate as an accumulative total of all maximum demands. So instead of 'zeroing' the demand register, a demand reset has the effect of adding the present maximum demand to this accumulating total."@en;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                rdfs:label "cumulative"@en;
                                cimdoc:enumCode 3 .
cim:AccumulationKind.deltaData a owl:NamedIndividual,
                                 cim:AccumulationKind;
                               rdfs:comment "The difference between the value at the end of the prescribed interval and the beginning of the interval. This is used for incremental interval data. Note: One common application would be for load profile data, another use might be to report the number of events within an interval (such as the number of equipment energisations within the specified period of time.)"@en;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                               rdfs:label "deltaData"@en;
                               cimdoc:enumCode 4 .
cim:AccumulationKind.indicating a owl:NamedIndividual,
                                  cim:AccumulationKind;
                                rdfs:comment "As if a needle is swung out on the meter face to a value to indicate the current value. Note: An 'indicating' value is typically measured over hundreds of milliseconds or greater, or may imply a �pusher� mechanism to capture a value. Compare this to 'instantaneous' which is measured over a shorter period of time."@en;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                rdfs:label "indicating"@en;
                                cimdoc:enumCode 6 .
cim:AccumulationKind.instantaneous a owl:NamedIndividual,
                                     cim:AccumulationKind;
                                   rdfs:comment "Typically measured over the fastest period of time allowed by the definition of the metric (usually milliseconds or tens of milliseconds.) Note: 'instantaneous' was moved to attribute #3 in Ed.2 of IEC 61968-9, from attribute #1 in Ed.1 of IEC 61968-9."@en;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                   rdfs:label "instantaneous"@en;
                                   cimdoc:enumCode 12 .
cim:AccumulationKind.latchingQuantity a owl:NamedIndividual,
                                        cim:AccumulationKind;
                                      rdfs:comment "When this description is applied to a metered value, it implies that the value is a time-independent cumulative quantity much like a 'bulkQuantity', except that it latches upon the maximum value upon reaching that value. Any additional accumulation (positive or negative) is discarded until a reset occurs. Note: A 'latchingQuantity' may also occur in the downward direction � upon reaching a minimum value. The terms 'maximum' or 'minimum' (for 'aggregate') will usually be included when this type of accumulation behaviour is present. When this description is applied to an encoded value (UOM= 'Code'), it implies that the value has one or more bits which are latching. The condition that caused the bit to be set may have long since evaporated. In either case, the timestamp that accompanies the value may not coincide with the moment the value was initially set. In both cases a system will need to perform an operation to clear the latched value."@en;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                      rdfs:label "latchingQuantity"@en;
                                      cimdoc:enumCode 13 .
cim:AccumulationKind.none a owl:NamedIndividual,
                            cim:AccumulationKind;
                          rdfs:comment "Not applicable, or implied by the unit of measure."@en;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                          rdfs:label "none"@en;
                          cimdoc:enumCode 0 .
cim:AccumulationKind.summation a owl:NamedIndividual,
                                 cim:AccumulationKind;
                               rdfs:comment "A form of accumulation which is selective with respect to time. Note : 'summation' could be considered a specialisation of 'bulkQuantity' as it selectively accumulates pulses over a timing pattern (while 'bulkQuantity' accumulates pulses all of the time)."@en;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                               rdfs:label "summation"@en;
                               cimdoc:enumCode 9 .
cim:AccumulationKind.timeDelay a owl:NamedIndividual,
                                 cim:AccumulationKind;
                               rdfs:comment "A form of computation which introduces a time delay characteristic to the data value."@en;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                               rdfs:label "timeDelay"@en;
                               cimdoc:enumCode 10 .
cim:ActivityRecord a owl:Class;
                   rdfs:comment "Records activity for an entity at a point in time; activity may be for an event that has already occurred or for a planned activity."@en;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                   rdfs:label "ActivityRecord"@en;
                   rdfs:subClassOf cim:IdentifiedObject;
                   cimdoc:cimPackage "IEC61968.Common";
                   cimdoc:packageTier "Normative".
cim:ActivityRecord.createdDateTime a owl:DatatypeProperty;
                                   rdfs:comment "Date and time this activity record has been created (different from the 'status. dateTime', which is the time of a status change of the associated object, if applicable)."@en;
                                   rdfs:domain cim:ActivityRecord;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                   rdfs:label "createdDateTime"@en;
                                   rdfs:range xsd:dateTime.
cim:ActivityRecord.reason a owl:DatatypeProperty;
                          rdfs:comment "Reason for event resulting in this activity record, typically supplied when user initiated."@en;
                          rdfs:domain cim:ActivityRecord;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                          rdfs:label "reason"@en;
                          rdfs:range xsd:string.
cim:ActivityRecord.severity a owl:DatatypeProperty;
                            rdfs:comment "Severity level of event resulting in this activity record."@en;
                            rdfs:domain cim:ActivityRecord;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                            rdfs:label "severity"@en;
                            rdfs:range xsd:string.
cim:ActivityRecord.status a owl:ObjectProperty;
                          rdfs:comment "Information on consequence of event resulting in this activity record."@en;
                          rdfs:domain cim:ActivityRecord;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                          rdfs:label "status"@en;
                          rdfs:range cim:Status.
cim:ActivityRecord.type a owl:DatatypeProperty;
                        rdfs:comment "Type of event resulting in this activity record."@en;
                        rdfs:domain cim:ActivityRecord;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                        rdfs:label "type"@en;
                        rdfs:range xsd:string.
cim:AggregateKind a owl:Class;
                  rdfs:comment "Kind of aggregation for read / measured values from multiple end points."@en;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                  rdfs:label "AggregateKind"@en;
                  owl:equivalentClass [a owl:Class ; 
                                       owl:oneOf (cim:AggregateKind.average
                                                  cim:AggregateKind.excess
                                                  cim:AggregateKind.fifthMaximum
                                                  cim:AggregateKind.fourthMaximum
                                                  cim:AggregateKind.highThreshold
                                                  cim:AggregateKind.lowThreshold
                                                  cim:AggregateKind.maximum
                                                  cim:AggregateKind.minimum
                                                  cim:AggregateKind.nominal
                                                  cim:AggregateKind.none
                                                  cim:AggregateKind.normal
                                                  cim:AggregateKind.secondMaximum
                                                  cim:AggregateKind.secondMinimum
                                                  cim:AggregateKind.sum
                                                  cim:AggregateKind.thirdMaximum)];
                  cimdoc:cimPackage "IEC61968.Metering";
                  cimdoc:packageTier "Normative".
cim:AggregateKind.average a owl:NamedIndividual,
                            cim:AggregateKind;
                          rdfs:comment "The value represents average."@en;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                          rdfs:label "average"@en;
                          cimdoc:enumCode 2 .
cim:AggregateKind.excess a owl:NamedIndividual,
                           cim:AggregateKind;
                         rdfs:comment "The value represents an amount over which a threshold was exceeded."@en;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                         rdfs:label "excess"@en;
                         cimdoc:enumCode 4 .
cim:AggregateKind.fifthMaximum a owl:NamedIndividual,
                                 cim:AggregateKind;
                               rdfs:comment "The fifth highest value observed."@en;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                               rdfs:label "fifthMaximum"@en;
                               cimdoc:enumCode 25 .
cim:AggregateKind.fourthMaximum a owl:NamedIndividual,
                                  cim:AggregateKind;
                                rdfs:comment "The fourth highest value observed."@en;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                rdfs:label "fourthMaximum"@en;
                                cimdoc:enumCode 24 .
cim:AggregateKind.highThreshold a owl:NamedIndividual,
                                  cim:AggregateKind;
                                rdfs:comment "The value represents a programmed high threshold."@en;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                rdfs:label "highThreshold"@en;
                                cimdoc:enumCode 5 .
cim:AggregateKind.lowThreshold a owl:NamedIndividual,
                                 cim:AggregateKind;
                               rdfs:comment "The value represents a programmed low threshold."@en;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                               rdfs:label "lowThreshold"@en;
                               cimdoc:enumCode 7 .
cim:AggregateKind.maximum a owl:NamedIndividual,
                            cim:AggregateKind;
                          rdfs:comment "The highest value observed."@en;
