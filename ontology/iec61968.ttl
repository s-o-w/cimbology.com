                                                     cim:LandPropertyKind.store
                                                     cim:LandPropertyKind.substation)];
                     cimdoc:cimPackage "IEC61968.InfIEC61968.InfLocations";
                     cimdoc:packageTier "Informative".
cim:LandPropertyKind.building a owl:NamedIndividual,
                                cim:LandPropertyKind;
                              rdfs:comment "Site enclosed within a building."@en;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                              rdfs:label "building"@en;
                              cimdoc:enumCode 0 .
cim:LandPropertyKind.customerPremise a owl:NamedIndividual,
                                       cim:LandPropertyKind;
                                     rdfs:comment "Site with a customer."@en;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                     rdfs:label "customerPremise"@en;
                                     cimdoc:enumCode 1 .
cim:LandPropertyKind.depot a owl:NamedIndividual,
                             cim:LandPropertyKind;
                           rdfs:comment "Storehouse for supplies that also serves as a station for supporting crews."@en;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                           rdfs:label "depot"@en;
                           cimdoc:enumCode 2 .
cim:LandPropertyKind.external a owl:NamedIndividual,
                                cim:LandPropertyKind;
                              rdfs:comment "Property owned or used by an external party that is not a customer."@en;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                              rdfs:label "external"@en;
                              cimdoc:enumCode 6 .
cim:LandPropertyKind.gridSupplyPoint a owl:NamedIndividual,
                                       cim:LandPropertyKind;
                                     rdfs:comment "Substation where the distribution and transmission networks meet and hence have mixed ownership and mixed operational control."@en;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                     rdfs:label "gridSupplyPoint"@en;
                                     cimdoc:enumCode 5 .
cim:LandPropertyKind.store a owl:NamedIndividual,
                             cim:LandPropertyKind;
                           rdfs:comment "Place of storage (e.g., a warehouse) to put aside, or accumulate, material and equipment for use when needed."@en;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                           rdfs:label "store"@en;
                           cimdoc:enumCode 3 .
cim:LandPropertyKind.substation a owl:NamedIndividual,
                                  cim:LandPropertyKind;
                                rdfs:comment "Transmission network switchyard."@en;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                rdfs:label "substation"@en;
                                cimdoc:enumCode 4 .
cim:LifecycleDate a owl:Class;
                  rdfs:comment "Dates for asset lifecycle state changes. May have multiple lifecycle dates for this device and a compound type allows a query to return multiple dates."@en;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                  rdfs:label "LifecycleDate"@en;
                  cimdoc:cimPackage "IEC61968.AssetInfo.Assets";
                  cimdoc:packageTier "Normative".
cim:LifecycleDate.installationDate a owl:DatatypeProperty;
                                   rdfs:comment "Date current installation was completed, which may not be the same as the in- service date. Asset may have been installed at other locations previously. Ignored if asset is (1) not currently installed (e.g., stored in a depot) or (2) not intended to be installed (e.g., vehicle, tool)."@en;
                                   rdfs:domain cim:LifecycleDate;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                   rdfs:label "installationDate"@en;
                                   rdfs:range xsd:date.
cim:LifecycleDate.manufacturedDate a owl:DatatypeProperty;
                                   rdfs:comment "Date the asset was manufactured."@en;
                                   rdfs:domain cim:LifecycleDate;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                   rdfs:label "manufacturedDate"@en;
                                   rdfs:range xsd:date.
cim:LifecycleDate.purchaseDate a owl:DatatypeProperty;
                               rdfs:comment "Date the asset was purchased. Note that even though an asset may have been purchased, it may not have been received into inventory at the time of purchase."@en;
                               rdfs:domain cim:LifecycleDate;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                               rdfs:label "purchaseDate"@en;
                               rdfs:range xsd:date.
cim:LifecycleDate.receivedDate a owl:DatatypeProperty;
                               rdfs:comment "Date the asset was received and first placed into inventory."@en;
                               rdfs:domain cim:LifecycleDate;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                               rdfs:label "receivedDate"@en;
                               rdfs:range xsd:date.
cim:LifecycleDate.removalDate a owl:DatatypeProperty;
                              rdfs:comment "Date when the asset was last removed from service. Ignored if (1) not intended to be in service, or (2) currently in service."@en;
                              rdfs:domain cim:LifecycleDate;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                              rdfs:label "removalDate"@en;
                              rdfs:range xsd:date.
cim:LifecycleDate.retiredDate a owl:DatatypeProperty;
                              rdfs:comment "Date the asset is permanently retired from service and may be scheduled for disposal. Ignored if asset is (1) currently in service, or (2) permanently removed from service."@en;
                              rdfs:domain cim:LifecycleDate;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                              rdfs:label "retiredDate"@en;
                              rdfs:range xsd:date.
cim:LineDetail a owl:Class;
               rdfs:comment "Details on an amount line, with rounding, date and note."@en;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
               rdfs:label "LineDetail"@en;
               cimdoc:cimPackage "IEC61968.PaymentMetering";
               cimdoc:packageTier "Normative".
cim:LineDetail.amount a owl:DatatypeProperty;
                      rdfs:comment "Amount for this line item."@en;
                      rdfs:domain cim:LineDetail;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                      rdfs:label "amount"@en;
                      rdfs:range cim:Money.
cim:LineDetail.dateTime a owl:DatatypeProperty;
                        rdfs:comment "Date and time when this line was created in the application process."@en;
                        rdfs:domain cim:LineDetail;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                        rdfs:label "dateTime"@en;
                        rdfs:range xsd:dateTime.
cim:LineDetail.note a owl:DatatypeProperty;
                    rdfs:comment "Free format note relevant to this line."@en;
                    rdfs:domain cim:LineDetail;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                    rdfs:label "note"@en;
                    rdfs:range xsd:string.
cim:LineDetail.rounding a owl:DatatypeProperty;
                        rdfs:comment "Totalised monetary value of all errors due to process rounding or truncating that is not reflected in 'amount'."@en;
                        rdfs:domain cim:LineDetail;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                        rdfs:label "rounding"@en;
                        rdfs:range cim:Money.
cim:Location a owl:Class;
             rdfs:comment "The place, scene, or point of something where someone or something has been, is, and/or will be at a given moment in time. It can be defined with one or more position points (coordinates) in a given coordinate system."@en;
             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
             rdfs:label "Location"@en;
             rdfs:subClassOf cim:IdentifiedObject;
             cimdoc:cimPackage "IEC61968.Common";
             cimdoc:packageTier "Normative".
cim:Location.ConfigurationEvents a owl:ObjectProperty;
                                 rdfs:comment "All configuration events created for this location."@en;
                                 rdfs:domain cim:Location;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                 rdfs:label "ConfigurationEvents"@en;
                                 rdfs:range cim:ConfigurationEvent.
cim:Location.CoordinateSystem a owl:ObjectProperty;
                              rdfs:comment "Coordinate system used to describe position points of this location."@en;
                              rdfs:domain cim:Location;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                              rdfs:label "CoordinateSystem"@en;
                              rdfs:range cim:CoordinateSystem.
cim:Location.Crew a owl:ObjectProperty;
                  rdfs:comment "The crew that is assigned to this locaton."@en;
                  rdfs:domain cim:Location;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                  rdfs:label "Crew"@en;
                  rdfs:range cim:Crew.
cim:Location.Measurements a owl:ObjectProperty;
                          rdfs:comment "All measurements at this location."@en;
                          rdfs:domain cim:Location;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                          rdfs:label "Measurements"@en;
                          rdfs:range cim:Measurement.
cim:Location.PositionPoints a owl:ObjectProperty;
                            rdfs:comment "Sequence of position points describing this location, expressed in coordinate system 'Location.CoordinateSystem'."@en;
                            rdfs:domain cim:Location;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                            rdfs:label "PositionPoints"@en;
                            rdfs:range cim:PositionPoint.
cim:Location.PowerSystemResources a owl:ObjectProperty;
                                  rdfs:comment "All power system resources at this location."@en;
                                  rdfs:domain cim:Location;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                  rdfs:label "PowerSystemResources"@en;
                                  rdfs:range cim:PowerSystemResource.
cim:Location.SwitchingOrder a owl:ObjectProperty;
                            rdfs:comment "The switching order at this location."@en;
                            rdfs:domain cim:Location;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                            rdfs:label "SwitchingOrder"@en;
                            rdfs:range cim:SwitchingOrder.
cim:Location.direction a owl:DatatypeProperty;
                       rdfs:comment "(if applicable) Direction that allows field crews to quickly find a given asset. For a given location, such as a street address, this is the relative direction in which to find the asset. For example, a streetlight may be located at the 'NW' (northwest) corner of the customer's site, or a usage point may be located on the second floor of an apartment building."@en;
                       rdfs:domain cim:Location;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                       rdfs:label "direction"@en;
                       rdfs:range xsd:string.
cim:Location.electronicAddress a owl:ObjectProperty;
                               rdfs:comment "Electronic address."@en;
                               rdfs:domain cim:Location;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                               rdfs:label "electronicAddress"@en;
                               rdfs:range cim:ElectronicAddress.
cim:Location.geoInfoReference a owl:DatatypeProperty;
                              rdfs:comment "(if applicable) Reference to geographical information source, often external to the utility."@en;
                              rdfs:domain cim:Location;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                              rdfs:label "geoInfoReference"@en;
                              rdfs:range xsd:string.
cim:Location.mainAddress a owl:ObjectProperty;
                         rdfs:comment "Main address of the location."@en;
                         rdfs:domain cim:Location;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                         rdfs:label "mainAddress"@en;
                         rdfs:range cim:StreetAddress.
cim:Location.phone1 a owl:ObjectProperty;
                    rdfs:comment "Phone number."@en;
                    rdfs:domain cim:Location;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                    rdfs:label "phone1"@en;
                    rdfs:range cim:TelephoneNumber.
cim:Location.phone2 a owl:ObjectProperty;
                    rdfs:comment "Additional phone number."@en;
                    rdfs:domain cim:Location;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                    rdfs:label "phone2"@en;
                    rdfs:range cim:TelephoneNumber.
cim:Location.secondaryAddress a owl:ObjectProperty;
                              rdfs:comment "Secondary address of the location. For example, PO Box address may have different ZIP code than that in the 'mainAddress'."@en;
                              rdfs:domain cim:Location;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                              rdfs:label "secondaryAddress"@en;
                              rdfs:range cim:StreetAddress.
cim:Location.status a owl:ObjectProperty;
                    rdfs:comment "Status of this location."@en;
                    rdfs:domain cim:Location;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                    rdfs:label "status"@en;
                    rdfs:range cim:Status.
cim:Location.type a owl:DatatypeProperty;
                  rdfs:comment "Classification by utility's corporate standards and practices, relative to the location itself (e.g., geographical, functional accounting, etc., not a given property that happens to exist at that location)."@en;
                  rdfs:domain cim:Location;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                  rdfs:label "type"@en;
                  rdfs:range xsd:string.
cim:LocationGrant a owl:Class;
                  rdfs:comment "A grant provides a right, as defined by type, for a parcel of land. Note that the association to Location, Asset, Organisation, etc. for the Grant is inherited from Agreement, a type of Document."@en;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                  rdfs:label "LocationGrant"@en;
                  rdfs:subClassOf cim:Agreement;
                  cimdoc:cimPackage "IEC61968.InfIEC61968.InfLocations";
                  cimdoc:packageTier "Informative".
cim:LocationGrant.propertyData a owl:DatatypeProperty;
                               rdfs:comment "Property related information that describes the Grant's land parcel. For example, it may be a deed book number, deed book page number, and parcel number."@en;
                               rdfs:domain cim:LocationGrant;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                               rdfs:label "propertyData"@en;
                               rdfs:range xsd:string.
cim:MacroPeriodKind a owl:Class;
                    rdfs:comment "Kind of macro period for calculations on read / measured values."@en;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                    rdfs:label "MacroPeriodKind"@en;
                    owl:equivalentClass [a owl:Class ; 
                                         owl:oneOf (cim:MacroPeriodKind.billingPeriod
                                                    cim:MacroPeriodKind.daily
                                                    cim:MacroPeriodKind.monthly
                                                    cim:MacroPeriodKind.none
                                                    cim:MacroPeriodKind.seasonal
                                                    cim:MacroPeriodKind.specifiedPeriod
                                                    cim:MacroPeriodKind.weekly)];
                    cimdoc:cimPackage "IEC61968.Metering";
                    cimdoc:packageTier "Normative".
cim:MacroPeriodKind.billingPeriod a owl:NamedIndividual,
                                    cim:MacroPeriodKind;
                                  rdfs:comment """Captured during the billing period starting at midnight of the first day of the billing period (as defined by the billing cycle day). If during the current billing period, it specifies a period from the start of the current billing period until \"now\"."""@en;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                  rdfs:label "billingPeriod"@en;
                                  cimdoc:enumCode 8 .
cim:MacroPeriodKind.daily a owl:NamedIndividual,
                            cim:MacroPeriodKind;
                          rdfs:comment """Daily period starting at midnight. If for the current day, this specifies the time from midnight to \"now\"."""@en;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                          rdfs:label "daily"@en;
                          cimdoc:enumCode 11 .
cim:MacroPeriodKind.monthly a owl:NamedIndividual,
                              cim:MacroPeriodKind;
                            rdfs:comment """Monthly period starting at midnight on the first day of the month. If within the current month, this specifies the period from the start of the month until \"now.\""""@en;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                            rdfs:label "monthly"@en;
                            cimdoc:enumCode 13 .
cim:MacroPeriodKind.none a owl:NamedIndividual,
                           cim:MacroPeriodKind;
                         rdfs:comment "Not applicable."@en;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                         rdfs:label "none"@en;
                         cimdoc:enumCode 0 .
cim:MacroPeriodKind.seasonal a owl:NamedIndividual,
                               cim:MacroPeriodKind;
                             rdfs:comment """A season of time spanning multiple months. E.g. \"Summer,\" \"Spring,\" \"Fall,\" and \"Winter\" based cycle. If within the current season, it specifies the period from the start of the current season until \"now.\""""@en;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                             rdfs:label "seasonal"@en;
                             cimdoc:enumCode 22 .
cim:MacroPeriodKind.specifiedPeriod a owl:NamedIndividual,
                                      cim:MacroPeriodKind;
                                    rdfs:comment "For the period defined by the start and end of the TimePeriod element in the message."@en;
                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                    rdfs:label "specifiedPeriod"@en;
                                    cimdoc:enumCode 32 .
cim:MacroPeriodKind.weekly a owl:NamedIndividual,
                             cim:MacroPeriodKind;
                           rdfs:comment """Weekly period starting at midnight on the first day of the week and ending the instant before midnight the last day of the week. If within the current week, it specifies the period from the start of the week until \"now.\""""@en;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                           rdfs:label "weekly"@en;
                           cimdoc:enumCode 24 .
cim:Maintainer a owl:Class;
