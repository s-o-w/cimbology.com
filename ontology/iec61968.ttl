cim:Tender a owl:Class;
           rdfs:comment """Tender is what is \"offered\" by the customer towards making a payment and is often more than the required payment (hence the need for 'change'). The payment is thus that part of the Tender that goes towards settlement of a particular transaction. Tender is modelled as an aggregation of Cheque and Card. Both these tender types can exist in a single tender bid thus 'accountHolderName' has to exist separately in each of Cheque and Card as each could have a different account holder name."""@en;
           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
           rdfs:label "Tender"@en;
           rdfs:subClassOf cim:IdentifiedObject;
           cimdoc:cimPackage "IEC61968.PaymentMetering";
           cimdoc:packageTier "Normative".
cim:Tender.Receipt a owl:ObjectProperty;
                   rdfs:comment "Receipt that recorded this receiving of a payment in the form of tenders."@en;
                   rdfs:domain cim:Tender;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                   rdfs:label "Receipt"@en;
                   rdfs:range cim:Receipt.
cim:Tender.amount a owl:DatatypeProperty;
                  rdfs:comment "Amount tendered by customer."@en;
                  rdfs:domain cim:Tender;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                  rdfs:label "amount"@en;
                  rdfs:range cim:Money.
cim:Tender.change a owl:DatatypeProperty;
                  rdfs:comment "Difference between amount tendered by customer and the amount charged by point of sale."@en;
                  rdfs:domain cim:Tender;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                  rdfs:label "change"@en;
                  rdfs:range cim:Money.
cim:Tender.kind a owl:ObjectProperty;
                rdfs:comment "Kind of tender from customer."@en;
                rdfs:domain cim:Tender;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                rdfs:label "kind"@en;
                rdfs:range cim:TenderKind.
cim:TenderKind a owl:Class;
               rdfs:comment "Kind of tender."@en;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
               rdfs:label "TenderKind"@en;
               owl:equivalentClass [a owl:Class ; 
                                    owl:oneOf (cim:TenderKind.card
                                               cim:TenderKind.cash
                                               cim:TenderKind.cheque
