                                                       cim:ServiceRequestKind.repair
                                                       cim:ServiceRequestKind.replace
                                                       cim:ServiceRequestKind.test
                                                       cim:ServiceRequestKind.turnOff
                                                       cim:ServiceRequestKind.turnOn)];
                       cimdoc:cimPackage "IEC61968.Customers";
                       cimdoc:packageTier "Normative".
cim:ServiceRequestKind.connect a owl:NamedIndividual,
                                 cim:ServiceRequestKind;
                               rdfs:comment "Physically connect the service."@en;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                               rdfs:label "connect"@en;
