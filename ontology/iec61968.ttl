cim:Assignment a owl:Class;
               rdfs:comment "An assignment is given to an ErpPerson, Crew, Organisation, Equipment Item, Tool, etc. and may be used to perform Work, WorkTasks, Procedures, etc. TimeSchedules may be set up directly for Assignments or indirectly via the associated WorkTask. Note that these associations are all inherited through the recursive relationship on Document."@en;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
               rdfs:label "Assignment"@en;
               rdfs:subClassOf cim:WorkDocument;
               cimdoc:cimPackage "IEC61968.InfIEC61968.InfWork";
               cimdoc:packageTier "Informative".
cim:Assignment.effectivePeriod a owl:ObjectProperty;
                               rdfs:comment "Period between the assignment becoming effective and its expiration."@en;
                               rdfs:domain cim:Assignment;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                               rdfs:label "effectivePeriod"@en;
                               rdfs:range cim:DateTimeInterval.
cim:Author a owl:Class;
           rdfs:comment "Person who created document or activity record."@en;
           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
           rdfs:label "Author"@en;
           rdfs:subClassOf cim:DocumentPersonRole;
           cimdoc:cimPackage "IEC61968.Common";
           cimdoc:packageTier "Normative".
cim:Author.ActivityRecords a owl:ObjectProperty;
                           rdfs:comment "All activity records with this author."@en;
                           rdfs:domain cim:Author;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                           rdfs:label "ActivityRecords"@en;
                           rdfs:range cim:ActivityRecord.
cim:Author.Documents a owl:ObjectProperty;
                     rdfs:comment "All documents of this this author."@en;
                     rdfs:domain cim:Author;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                     rdfs:label "Documents"@en;
                     rdfs:range cim:Document.
cim:AuxiliaryAccount a owl:Class;
                     rdfs:comment "Variable and dynamic part of auxiliary agreement, generally representing the current state of the account related to the outstanding balance defined in auxiliary agreement."@en;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                     rdfs:label "AuxiliaryAccount"@en;
                     rdfs:subClassOf cim:Document;
                     cimdoc:cimPackage "IEC61968.PaymentMetering";
                     cimdoc:packageTier "Normative".
cim:AuxiliaryAccount.Charges a owl:ObjectProperty;
                             rdfs:comment "All charges levied on this account."@en;
                             rdfs:domain cim:AuxiliaryAccount;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                             rdfs:label "Charges"@en;
                             rdfs:range cim:Charge.
cim:AuxiliaryAccount.PaymentTransactions a owl:ObjectProperty;
                                         rdfs:comment "All payments against this account."@en;
                                         rdfs:domain cim:AuxiliaryAccount;
                                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                         rdfs:label "PaymentTransactions"@en;
                                         rdfs:range cim:Transaction.
cim:AuxiliaryAccount.balance a owl:DatatypeProperty;
                             rdfs:comment "The total amount currently remaining on this account that is required to be paid in order to settle the account to zero. This excludes any due amounts not yet paid."@en;
                             rdfs:domain cim:AuxiliaryAccount;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                             rdfs:label "balance"@en;
                             rdfs:range cim:Money.
cim:AuxiliaryAccount.due a owl:ObjectProperty;
                         rdfs:comment "Current amounts now due for payment on this account."@en;
                         rdfs:domain cim:AuxiliaryAccount;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                         rdfs:label "due"@en;
                         rdfs:range cim:Due.
cim:AuxiliaryAccount.lastCredit a owl:ObjectProperty;
                                rdfs:comment "Details of the last credit transaction performed on this account."@en;
                                rdfs:domain cim:AuxiliaryAccount;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                rdfs:label "lastCredit"@en;
                                rdfs:range cim:AccountMovement.
cim:AuxiliaryAccount.lastDebit a owl:ObjectProperty;
                               rdfs:comment "Details of the last debit transaction performed on this account."@en;
                               rdfs:domain cim:AuxiliaryAccount;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                               rdfs:label "lastDebit"@en;
                               rdfs:range cim:AccountMovement.
cim:AuxiliaryAccount.principleAmount a owl:DatatypeProperty;
                                     rdfs:comment "The initial principle amount, with which this account was instantiated."@en;
                                     rdfs:domain cim:AuxiliaryAccount;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                     rdfs:label "principleAmount"@en;
                                     rdfs:range cim:Money.
cim:AuxiliaryAgreement a owl:Class;
                       rdfs:comment "An ad-hoc auxiliary account agreement associated with a customer agreement, not part of the customer's account, but typically subject to formal agreement between customer and supplier (utility). Typically this is used to collect revenue owed by the customer for other services or arrears accrued with the utility for other services. It is typically linked to a prepaid token purchase transaction, thus forcing the customer to make a payment towards settlement of the auxiliary account balance whenever the customer needs to purchase a prepaid token for electricity. The present status of the auxiliary agreement can be defined in the context of the utility's business rules, for example: enabled, disabled, pending, over recovered, under recovered, written off, etc."@en;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                       rdfs:label "AuxiliaryAgreement"@en;
                       rdfs:subClassOf cim:Agreement;
                       cimdoc:cimPackage "IEC61968.PaymentMetering";
                       cimdoc:packageTier "Normative".
cim:AuxiliaryAgreement.AuxiliaryAccounts a owl:ObjectProperty;
                                         rdfs:comment "All auxiliary accounts regulated by this agreement."@en;
                                         rdfs:domain cim:AuxiliaryAgreement;
                                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                         rdfs:label "AuxiliaryAccounts"@en;
                                         rdfs:range cim:AuxiliaryAccount.
cim:AuxiliaryAgreement.arrearsInterest a owl:DatatypeProperty;
                                       rdfs:comment "The interest per annum to be charged prorata on 'AuxiliaryAccount.dueArrears' at the end of each 'payCycle'."@en;
                                       rdfs:domain cim:AuxiliaryAgreement;
                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                       rdfs:label "arrearsInterest"@en;
                                       rdfs:range cim:PerCent.
cim:AuxiliaryAgreement.auxCycle a owl:DatatypeProperty;
                                rdfs:comment "The frequency for automatically recurring auxiliary charges, where 'AuxiliaryAccount.initialCharge' is recursively added to 'AuxiliaryAccount. dueCurrent' at the start of each 'auxCycle'. For example: on a specified date and time; hourly; daily; weekly; monthly; 3-monthly; 6-monthly; 12-monthly; etc."@en;
                                rdfs:domain cim:AuxiliaryAgreement;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                rdfs:label "auxCycle"@en;
                                rdfs:range xsd:string.
cim:AuxiliaryAgreement.auxPriorityCode a owl:DatatypeProperty;
                                       rdfs:comment "The coded priority indicating the priority that this auxiliary agreement has above other auxiliary agreements (associated with the same customer agreement) when it comes to competing for settlement from a payment transaction or token purchase."@en;
                                       rdfs:domain cim:AuxiliaryAgreement;
                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                       rdfs:label "auxPriorityCode"@en;
                                       rdfs:range xsd:string.
cim:AuxiliaryAgreement.fixedAmount a owl:DatatypeProperty;
                                   rdfs:comment "The fixed amount that has to be collected from each vending transaction towards settlement of this auxiliary agreement. Note that there may be multiple tokens vended per vending transaction, but this is not relevant."@en;
                                   rdfs:domain cim:AuxiliaryAgreement;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                   rdfs:label "fixedAmount"@en;
                                   rdfs:range cim:Money.
cim:AuxiliaryAgreement.minAmount a owl:DatatypeProperty;
                                 rdfs:comment "The minimum amount that has to be paid at any transaction towards settling this auxiliary agreement or reducing the balance."@en;
                                 rdfs:domain cim:AuxiliaryAgreement;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                 rdfs:label "minAmount"@en;
                                 rdfs:range cim:Money.
cim:AuxiliaryAgreement.payCycle a owl:DatatypeProperty;
                                rdfs:comment "The contractually expected payment frequency (by the customer). Examples are: ad-hoc; on specified date; hourly, daily, weekly, monthly. etc."@en;
                                rdfs:domain cim:AuxiliaryAgreement;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                rdfs:label "payCycle"@en;
                                rdfs:range xsd:string.
cim:AuxiliaryAgreement.subType a owl:DatatypeProperty;
                               rdfs:comment "Sub-classification of the inherited 'type' for this AuxiliaryAgreement."@en;
                               rdfs:domain cim:AuxiliaryAgreement;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                               rdfs:label "subType"@en;
                               rdfs:range xsd:string.
cim:AuxiliaryAgreement.vendPortion a owl:DatatypeProperty;
                                   rdfs:comment "The percentage of the transaction amount that has to be collected from each vending transaction towards settlement of this auxiliary agreement when payments are not in arrears. Note that there may be multiple tokens vended per vending transaction, but this is not relevant."@en;
                                   rdfs:domain cim:AuxiliaryAgreement;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                   rdfs:label "vendPortion"@en;
                                   rdfs:range cim:PerCent.
cim:AuxiliaryAgreement.vendPortionArrear a owl:DatatypeProperty;
                                         rdfs:comment "The percentage of the transaction amount that has to be collected from each vending transaction towards settlement of this auxiliary agreement when payments are in arrears. Note that there may be multiple tokens vended per vending transaction, but this is not relevant."@en;
                                         rdfs:domain cim:AuxiliaryAgreement;
                                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                         rdfs:label "vendPortionArrear"@en;
                                         rdfs:range cim:PerCent.
