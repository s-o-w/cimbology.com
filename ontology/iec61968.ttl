                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                         rdfs:label "EnergyConsumerAction"@en;
                         rdfs:subClassOf cim:SwitchingAction;
                         cimdoc:cimPackage "IEC61968.Operations";
                         cimdoc:packageTier "Normative".
cim:EnergyConsumerAction.kind a owl:ObjectProperty;
                              rdfs:comment "Switching action to perform"@en;
                              rdfs:domain cim:EnergyConsumerAction;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                              rdfs:label "kind"@en;
