cim:ConnectDisconnectFunction.isConnected a owl:DatatypeProperty;
                                          rdfs:comment "True if this function is in the connected state."@en;
                                          rdfs:domain cim:ConnectDisconnectFunction;
                                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                          rdfs:label "isConnected"@en;
                                          rdfs:range xsd:boolean.
cim:ConnectDisconnectFunction.isDelayedDiscon a owl:DatatypeProperty;
                                              rdfs:comment "If set true, the switch may disconnect the service at the end of a specified time delay after the disconnect signal has been given. If set false, the switch may disconnect the service immediately after the disconnect signal has been given. This is typically the case for over current circuit-breakers which are classified as either instantaneous or slow acting."@en;
                                              rdfs:domain cim:ConnectDisconnectFunction;
                                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                              rdfs:label "isDelayedDiscon"@en;
                                              rdfs:range xsd:boolean.
cim:ConnectDisconnectFunction.isLocalAutoDisconOp a owl:DatatypeProperty;
                                                  rdfs:comment "If set true and if disconnection can be operated locally, the operation happens automatically. Otherwise it happens manually."@en;
                                                  rdfs:domain cim:ConnectDisconnectFunction;
                                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                                  rdfs:label "isLocalAutoDisconOp"@en;
                                                  rdfs:range xsd:boolean.
cim:ConnectDisconnectFunction.isLocalAutoReconOp a owl:DatatypeProperty;
                                                 rdfs:comment "If set true and if reconnection can be operated locally, then the operation happens automatically. Otherwise, it happens manually."@en;
                                                 rdfs:domain cim:ConnectDisconnectFunction;
                                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                                 rdfs:label "isLocalAutoReconOp"@en;
                                                 rdfs:range xsd:boolean.
cim:ConnectDisconnectFunction.isRemoteAutoDisconOp a owl:DatatypeProperty;
                                                   rdfs:comment "If set true and if disconnection can be operated remotely, then the operation happens automatically. If set false and if disconnection can be operated remotely, then the operation happens manually."@en;
                                                   rdfs:domain cim:ConnectDisconnectFunction;
                                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
