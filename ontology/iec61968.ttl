                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                           rdfs:label "constructionKind"@en;
                           rdfs:range cim:TowerConstructionKind.
cim:TowerConstructionKind a owl:Class;
                          rdfs:comment "Kind of tower construction."@en;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
