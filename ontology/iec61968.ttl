             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
             rdfs:label "DuctBank"@en;
             rdfs:subClassOf cim:AssetContainer;
             cimdoc:cimPackage "IEC61968.AssetInfo.Assets";
             cimdoc:packageTier "Normative".
cim:DuctBank.circuitCount a owl:DatatypeProperty;
                          rdfs:comment "Number of circuits in duct bank. Refer to associations between a duct (ConductorAsset) and an ACLineSegment to understand which circuits are in which ducts."@en;
                          rdfs:domain cim:DuctBank;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
