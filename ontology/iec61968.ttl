cim:Transaction.reversedId a owl:DatatypeProperty;
                           rdfs:comment "(if 'kind' is transactionReversal) Reference to the original transaction that is being reversed by this transaction."@en;
                           rdfs:domain cim:Transaction;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
