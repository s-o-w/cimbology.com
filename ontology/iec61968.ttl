cim:SwitchingStep a owl:Class;
                  rdfs:comment "Atomic switching step; can be part of a switching step group, or part of a switching plan."@en;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                  rdfs:label "SwitchingStep"@en;
                  cimdoc:cimPackage "IEC61968.Operations";
                  cimdoc:packageTier "Normative".
cim:SwitchingStep.RevisionHistory a owl:ObjectProperty;
                                  rdfs:comment "The revision history"@en;
                                  rdfs:domain cim:SwitchingStep;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                  rdfs:label "RevisionHistory"@en;
                                  rdfs:range cim:RevisionHistory.
cim:SwitchingStep.SwitchingAction a owl:ObjectProperty;
                                  rdfs:comment "The switching action that is associated to the switching step."@en;
                                  rdfs:domain cim:SwitchingStep;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                  rdfs:label "SwitchingAction"@en;
                                  rdfs:range cim:SwitchingAction.
cim:SwitchingStep.SwitchingStepGroup a owl:ObjectProperty;
                                     rdfs:comment "The switching step group that contains the switching steps."@en;
                                     rdfs:domain cim:SwitchingStep;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                     rdfs:label "SwitchingStepGroup"@en;
                                     rdfs:range cim:SwitchingStepGroup.
cim:SwitchingStep.isFreeSequence a owl:DatatypeProperty;
                                 rdfs:comment "For a step, if isFreeSequence is set to false or is not specified, all of the steps in the group must be executed in the order defined by the sequenceNumber attribute. The sequenceNumber for a step has a different meaning when there are two or more sequential steps that have the isFreeSequence attribute set to true. Execution must still be performed in sequenceNumber order until a set of two or more steps that have isFreeSequence set to true is encountered. In this case, these steps can be executed in any sequence, until a step is encountered that has isFreeSequence set to false. All of the steps preceding this step must be executed before the step can be executed."@en;
                                 rdfs:domain cim:SwitchingStep;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                 rdfs:label "isFreeSequence"@en;
                                 rdfs:range xsd:boolean.
cim:SwitchingStep.sequenceNumber a owl:DatatypeProperty;
                                 rdfs:comment "Order of this activity in the sequence of activities within the switching plan."@en;
                                 rdfs:domain cim:SwitchingStep;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                 rdfs:label "sequenceNumber"@en;
                                 rdfs:range xsd:integer.
cim:SwitchingStep.subStepSequenceNumber a owl:DatatypeProperty;
                                        rdfs:comment "Supports compound switching steps that are made up of several sub steps."@en;
                                        rdfs:domain cim:SwitchingStep;
                                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                        rdfs:label "subStepSequenceNumber"@en;
                                        rdfs:range xsd:integer.
cim:SwitchingStepGroup a owl:Class;
                       rdfs:comment "A logical step, grouping atomic switching steps that are important to distinguish when they may change topology (e.g. placing a jumper between two cuts)."@en;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                       rdfs:label "SwitchingStepGroup"@en;
                       cimdoc:cimPackage "IEC61968.Operations";
