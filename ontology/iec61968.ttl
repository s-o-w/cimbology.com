                                     rdfs:label "dispatchStatus"@en;
                                     rdfs:range cim:CrewStatusKind.
cim:FieldDispatchStep.occurredDateTime a owl:DatatypeProperty;
                                       rdfs:comment "The date and time at which the dispatch status occurred."@en;
                                       rdfs:domain cim:FieldDispatchStep;
                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                       rdfs:label "occurredDateTime"@en;
                                       rdfs:range xsd:dateTime.
cim:FieldDispatchStep.remarks a owl:DatatypeProperty;
                              rdfs:comment "freeform comments related to the dispatch to perform field work."@en;
                              rdfs:domain cim:FieldDispatchStep;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                              rdfs:label "remarks"@en;
                              rdfs:range xsd:string.
cim:FieldDispatchStep.sequenceNumber a owl:DatatypeProperty;
                                     rdfs:comment "The sequence number of the field dispatch step within the field dispatch history. Begins with 1 and increments up."@en;
                                     rdfs:domain cim:FieldDispatchStep;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                     rdfs:label "sequenceNumber"@en;
                                     rdfs:range xsd:integer.
cim:FieldSafetySupervisor a owl:Class;
                          rdfs:comment "Crew member on work site responsible for all local safety measures for the work crew doing maintenance, construction and repair in a substation or on a power line/cable."@en;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                          rdfs:label "FieldSafetySupervisor"@en;
                          rdfs:subClassOf cim:CrewMember;
                          cimdoc:cimPackage "IEC61968.Operations";
                          cimdoc:packageTier "Normative".
cim:FieldSafetySupervisor.IssuedSafetyDocuments a owl:ObjectProperty;
                                                rdfs:comment "All safety documents issued to this supervisor."@en;
                                                rdfs:domain cim:FieldSafetySupervisor;
                                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                                rdfs:label "IssuedSafetyDocuments"@en;
                                                rdfs:range cim:SafetyDocument.
cim:FieldSafetySupervisor.ReleasedSafetyDocuments a owl:ObjectProperty;
                                                  rdfs:comment "All safety documents released by this supervisor."@en;
                                                  rdfs:domain cim:FieldSafetySupervisor;
                                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                                  rdfs:label "ReleasedSafetyDocuments"@en;
                                                  rdfs:range cim:SafetyDocument.
cim:FinancialInfo a owl:Class;
                  rdfs:comment "Various current financial properties associated with a particular asset. Historical properties may be determined by ActivityRecords associated with the asset."@en;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                  rdfs:label "FinancialInfo"@en;
                  rdfs:subClassOf cim:IdentifiedObject;
                  cimdoc:cimPackage "IEC61968.AssetInfo.Assets";
                  cimdoc:packageTier "Normative".
cim:FinancialInfo.Asset a owl:ObjectProperty;
                        rdfs:comment "The asset to which this financial information relates."@en;
                        rdfs:domain cim:FinancialInfo;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                        rdfs:label "Asset"@en;
                        rdfs:range cim:Asset.
cim:FinancialInfo.account a owl:DatatypeProperty;
                          rdfs:comment "The account to which this actual material item is charged."@en;
                          rdfs:domain cim:FinancialInfo;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                          rdfs:label "account"@en;
                          rdfs:range xsd:string.
cim:FinancialInfo.actualPurchaseCost a owl:DatatypeProperty;
                                     rdfs:comment "The actual purchase cost of this particular asset."@en;
                                     rdfs:domain cim:FinancialInfo;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                     rdfs:label "actualPurchaseCost"@en;
                                     rdfs:range cim:Money.
cim:FinancialInfo.costDescription a owl:DatatypeProperty;
                                  rdfs:comment "Description of the cost."@en;
                                  rdfs:domain cim:FinancialInfo;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                  rdfs:label "costDescription"@en;
                                  rdfs:range xsd:string.
cim:FinancialInfo.costType a owl:DatatypeProperty;
                           rdfs:comment "Type of cost to which this Material Item belongs."@en;
                           rdfs:domain cim:FinancialInfo;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                           rdfs:label "costType"@en;
                           rdfs:range xsd:string.
cim:FinancialInfo.financialValue a owl:DatatypeProperty;
                                 rdfs:comment "Value of asset as of 'valueDateTime'."@en;
                                 rdfs:domain cim:FinancialInfo;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                 rdfs:label "financialValue"@en;
                                 rdfs:range cim:Money.
cim:FinancialInfo.plantTransferDateTime a owl:DatatypeProperty;
                                        rdfs:comment """Date and time asset's financial value was put in plant for regulatory accounting purposes (e.g., for rate base calculations). This is sometime referred to as the \"in-service date\"."""@en;
                                        rdfs:domain cim:FinancialInfo;
                                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                        rdfs:label "plantTransferDateTime"@en;
                                        rdfs:range xsd:dateTime.
cim:FinancialInfo.purchaseDateTime a owl:DatatypeProperty;
                                   rdfs:comment "Date and time asset was purchased."@en;
                                   rdfs:domain cim:FinancialInfo;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                   rdfs:label "purchaseDateTime"@en;
                                   rdfs:range xsd:dateTime.
cim:FinancialInfo.purchaseOrderNumber a owl:DatatypeProperty;
                                      rdfs:comment "Purchase order identifier."@en;
                                      rdfs:domain cim:FinancialInfo;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                      rdfs:label "purchaseOrderNumber"@en;
                                      rdfs:range xsd:string.
cim:FinancialInfo.quantity a owl:DatatypeProperty;
                           rdfs:comment "The quantity of the asset if per unit length, for example conductor."@en;
                           rdfs:domain cim:FinancialInfo;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                           rdfs:label "quantity"@en;
                           rdfs:range cim:IntegerQuantity.
cim:FinancialInfo.valueDateTime a owl:DatatypeProperty;
                                rdfs:comment "Date and time at which the financial value was last established."@en;
                                rdfs:domain cim:FinancialInfo;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                rdfs:label "valueDateTime"@en;
                                rdfs:range xsd:dateTime.
cim:FinancialInfo.warrantyEndDateTime a owl:DatatypeProperty;
                                      rdfs:comment "Date and time warranty on asset expires."@en;
                                      rdfs:domain cim:FinancialInfo;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                      rdfs:label "warrantyEndDateTime"@en;
                                      rdfs:range xsd:dateTime.
cim:FlowDirectionKind a owl:Class;
                      rdfs:comment "Kind of flow direction for reading/measured values proper to some commodities such as, for example, energy, power, demand."@en;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                      rdfs:label "FlowDirectionKind"@en;
                      owl:equivalentClass [a owl:Class ; 
                                           owl:oneOf (cim:FlowDirectionKind.forward
                                                      cim:FlowDirectionKind.lagging
                                                      cim:FlowDirectionKind.leading
                                                      cim:FlowDirectionKind.net
                                                      cim:FlowDirectionKind.none
                                                      cim:FlowDirectionKind.q1minusQ4
                                                      cim:FlowDirectionKind.q1plusQ2
                                                      cim:FlowDirectionKind.q1plusQ3
                                                      cim:FlowDirectionKind.q1plusQ4
                                                      cim:FlowDirectionKind.q2minusQ3
                                                      cim:FlowDirectionKind.q2plusQ3
                                                      cim:FlowDirectionKind.q2plusQ4
                                                      cim:FlowDirectionKind.q3minusQ2
                                                      cim:FlowDirectionKind.q3plusQ4
                                                      cim:FlowDirectionKind.quadrant1
                                                      cim:FlowDirectionKind.quadrant2
                                                      cim:FlowDirectionKind.quadrant3
                                                      cim:FlowDirectionKind.quadrant4
                                                      cim:FlowDirectionKind.reverse
                                                      cim:FlowDirectionKind.total
                                                      cim:FlowDirectionKind.totalByPhase)];
                      cimdoc:cimPackage "IEC61968.Metering";
                      cimdoc:packageTier "Normative".
cim:FlowDirectionKind.forward a owl:NamedIndividual,
                                cim:FlowDirectionKind;
                              rdfs:comment """\"Delivered,\" or \"Imported\" as defined 61968-2. Forward Active Energy is a positive kWh value as one would naturally expect to find as energy is supplied by the utility and consumed at the service. Forward Reactive Energy is a positive VArh value as one would naturally expect to find in the presence of inductive loading. In polyphase metering, the forward energy register is incremented when the sum of the phase energies is greater than zero: graphic"""@en;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                              rdfs:label "forward"@en;
                              cimdoc:enumCode 1 .
cim:FlowDirectionKind.lagging a owl:NamedIndividual,
                                cim:FlowDirectionKind;
                              rdfs:comment "Typically used to describe that a power factor is lagging the reference value. Note 1: When used to describe VA, �lagging� describes a form of measurement where reactive power is considered in all four quadrants, but real power is considered only in quadrants I and IV. Note 2: When used to describe power factor, the term �Lagging� implies that the PF is negative. The term �lagging� in this case takes the place of the negative sign. If a signed PF value is to be passed by the data producer, then the direction of flow enumeration zero (none) should be used in order to avoid the possibility of creating an expression that employs a double negative. The data consumer should be able to tell from the sign of the data if the PF is leading or lagging. This principle is analogous to the concept that �Reverse� energy is an implied negative value, and to publish a negative reverse value would be ambiguous. Note 3: Lagging power factors typically indicate inductive loading."@en;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                              rdfs:label "lagging"@en;
                              cimdoc:enumCode 2 .
cim:FlowDirectionKind.leading a owl:NamedIndividual,
                                cim:FlowDirectionKind;
                              rdfs:comment "Typically used to describe that a power factor is leading the reference value. Note: Leading power factors typically indicate capacitive loading."@en;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                              rdfs:label "leading"@en;
                              cimdoc:enumCode 3 .
cim:FlowDirectionKind.net a owl:NamedIndividual,
                            cim:FlowDirectionKind;
                          rdfs:comment "|Forward| - |Reverse|, See 61968-2. Note: In some systems, the value passed as a �net� value could become negative. In other systems the value passed as a �net� value is always a positive number, and rolls-over and rolls-under as needed."@en;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                          rdfs:label "net"@en;
                          cimdoc:enumCode 4 .
cim:FlowDirectionKind.none a owl:NamedIndividual,
                             cim:FlowDirectionKind;
                           rdfs:comment "Not Applicable (N/A)"@en;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                           rdfs:label "none"@en;
                           cimdoc:enumCode 0 .
cim:FlowDirectionKind.q1minusQ4 a owl:NamedIndividual,
                                  cim:FlowDirectionKind;
                                rdfs:comment "Q1 minus Q4"@en;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                rdfs:label "q1minusQ4"@en;
                                cimdoc:enumCode 9 .
cim:FlowDirectionKind.q1plusQ2 a owl:NamedIndividual,
                                 cim:FlowDirectionKind;
                               rdfs:comment "Reactive positive quadrants. (The term �lagging� is preferred.)"@en;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                               rdfs:label "q1plusQ2"@en;
                               cimdoc:enumCode 5 .
cim:FlowDirectionKind.q1plusQ3 a owl:NamedIndividual,
                                 cim:FlowDirectionKind;
                               rdfs:comment "Quadrants 1 and 3"@en;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                               rdfs:label "q1plusQ3"@en;
                               cimdoc:enumCode 7 .
cim:FlowDirectionKind.q1plusQ4 a owl:NamedIndividual,
                                 cim:FlowDirectionKind;
                               rdfs:comment "Quadrants 1 and 4 usually represent forward active energy"@en;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                               rdfs:label "q1plusQ4"@en;
                               cimdoc:enumCode 8 .
cim:FlowDirectionKind.q2minusQ3 a owl:NamedIndividual,
                                  cim:FlowDirectionKind;
                                rdfs:comment "Q2 minus Q3"@en;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                rdfs:label "q2minusQ3"@en;
                                cimdoc:enumCode 12 .
cim:FlowDirectionKind.q2plusQ3 a owl:NamedIndividual,
                                 cim:FlowDirectionKind;
                               rdfs:comment "Quadrants 2 and 3 usually represent reverse active energy"@en;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                               rdfs:label "q2plusQ3"@en;
                               cimdoc:enumCode 10 .
cim:FlowDirectionKind.q2plusQ4 a owl:NamedIndividual,
                                 cim:FlowDirectionKind;
                               rdfs:comment "Quadrants 2 and 4"@en;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                               rdfs:label "q2plusQ4"@en;
                               cimdoc:enumCode 11 .
cim:FlowDirectionKind.q3minusQ2 a owl:NamedIndividual,
                                  cim:FlowDirectionKind;
                                rdfs:comment "Q3 minus Q2"@en;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                rdfs:label "q3minusQ2"@en;
                                cimdoc:enumCode 14 .
cim:FlowDirectionKind.q3plusQ4 a owl:NamedIndividual,
                                 cim:FlowDirectionKind;
                               rdfs:comment "Reactive negative quadrants. (The term �leading� is preferred.)"@en;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                               rdfs:label "q3plusQ4"@en;
                               cimdoc:enumCode 13 .
cim:FlowDirectionKind.quadrant1 a owl:NamedIndividual,
                                  cim:FlowDirectionKind;
                                rdfs:comment "Q1 only"@en;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                rdfs:label "quadrant1"@en;
                                cimdoc:enumCode 15 .
cim:FlowDirectionKind.quadrant2 a owl:NamedIndividual,
                                  cim:FlowDirectionKind;
                                rdfs:comment "Q2 only"@en;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                rdfs:label "quadrant2"@en;
                                cimdoc:enumCode 16 .
cim:FlowDirectionKind.quadrant3 a owl:NamedIndividual,
                                  cim:FlowDirectionKind;
                                rdfs:comment "Q3 only"@en;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                rdfs:label "quadrant3"@en;
                                cimdoc:enumCode 17 .
cim:FlowDirectionKind.quadrant4 a owl:NamedIndividual,
                                  cim:FlowDirectionKind;
                                rdfs:comment "Q4 only"@en;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                rdfs:label "quadrant4"@en;
                                cimdoc:enumCode 18 .
cim:FlowDirectionKind.reverse a owl:NamedIndividual,
                                cim:FlowDirectionKind;
                              rdfs:comment """Reverse Active Energy is equivalent to \"Received,\" or \"Exported\" as defined in 61968-2. Reverse Active Energy is a positive kWh value as one would expect to find when energy is backfed by the service onto the utility network. Reverse Reactive Energy is a positive VArh value as one would expect to find in the presence of capacitive loading and a leading Power Factor. In polyphase metering, the reverse energy register is incremented when the sum of the phase energies is less than zero: graphic Note: The value passed as a reverse value is always a positive value. It is understood by the label �reverse� that it represents negative flow."""@en;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                              rdfs:label "reverse"@en;
                              cimdoc:enumCode 19 .
cim:FlowDirectionKind.total a owl:NamedIndividual,
                              cim:FlowDirectionKind;
                            rdfs:comment "|Forward| + |Reverse|, See 61968-2. The sum of the commodity in all quadrants Q1+Q2+Q3+Q4. In polyphase metering, the total energy register is incremented when the absolute value of the sum of the phase energies is greater than zero: graphic"@en;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                            rdfs:label "total"@en;
                            cimdoc:enumCode 20 .
cim:FlowDirectionKind.totalByPhase a owl:NamedIndividual,
                                     cim:FlowDirectionKind;
                                   rdfs:comment "In polyphase metering, the total by phase energy register is incremented when the sum of the absolute values of the phase energies is greater than zero: graphic In single phase metering, the formulas for �Total� and �Total by phase� collapse to the same expression. For communication purposes however, the �Total� enumeration should be used with single phase meter data."@en;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                   rdfs:label "totalByPhase"@en;
                                   cimdoc:enumCode 21 .
cim:GeneratorTypeAsset a owl:Class;
                       rdfs:comment "Generic generation equipment that may be used for various purposes such as work planning. It defines both the Real and Reactive power properties (modelled at the PSR level as a GeneratingUnit + SynchronousMachine)."@en;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                       rdfs:label "GeneratorTypeAsset"@en;
                       rdfs:subClassOf cim:CatalogAssetType;
                       cimdoc:cimPackage "IEC61968.InfIEC61968.InfTypeAsset";
                       cimdoc:packageTier "Informative".
