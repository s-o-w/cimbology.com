                          rdfs:comment "Communicates using power line communication technologies."@en;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                          rdfs:label "plc"@en;
                          cimdoc:enumCode 5 .
cim:ComTechnologyKind.rf a owl:NamedIndividual,
