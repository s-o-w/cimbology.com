                      cim:TenderKind;
                    rdfs:comment "Payment method by means of a credit or debit card."@en;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                    rdfs:label "card"@en;
                    cimdoc:enumCode 1 .
cim:TenderKind.cash a owl:NamedIndividual,
                      cim:TenderKind;
                    rdfs:comment "Payment method by means of cash."@en;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                    rdfs:label "cash"@en;
                    cimdoc:enumCode 2 .
cim:TenderKind.cheque a owl:NamedIndividual,
                        cim:TenderKind;
                      rdfs:comment "Payment method by means of a cheque."@en;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                      rdfs:label "cheque"@en;
                      cimdoc:enumCode 0 .
cim:TenderKind.other a owl:NamedIndividual,
                       cim:TenderKind;
                     rdfs:comment "Other payment method such as electronic finds transfer."@en;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                     rdfs:label "other"@en;
                     cimdoc:enumCode 4 .
cim:TenderKind.unspecified a owl:NamedIndividual,
                             cim:TenderKind;
