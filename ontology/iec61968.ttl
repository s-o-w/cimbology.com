                                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                                   rdfs:label "lifetimeFaultOperations"@en;
                                                   rdfs:range xsd:integer.
cim:SwitchOperationSummary.lifetimeMotorStarts a owl:DatatypeProperty;
                                               rdfs:comment "Total motor starts to date."@en;
