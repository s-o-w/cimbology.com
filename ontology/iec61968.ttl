                            rdfs:label "ShuntCompensatorControl"@en;
                            rdfs:subClassOf cim:RegulatingControl;
                            cimdoc:cimPackage "IEC61968.InfIEC61968.InfWiresExt";
                            cimdoc:packageTier "Informative".
cim:ShuntCompensatorControl.branchDirect a owl:DatatypeProperty;
                                         rdfs:comment "For VAR, amp, or power factor locally controlled shunt impedances, the flow direction: in, out."@en;
                                         rdfs:domain cim:ShuntCompensatorControl;
                                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                         rdfs:label "branchDirect"@en;
                                         rdfs:range xsd:integer.
cim:ShuntCompensatorControl.cellSize a owl:DatatypeProperty;
                                     rdfs:comment "The size of the individual units that make up the bank."@en;
                                     rdfs:domain cim:ShuntCompensatorControl;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                     rdfs:label "cellSize"@en;
                                     rdfs:range cim:ReactivePower.
cim:ShuntCompensatorControl.controlKind a owl:ObjectProperty;
                                        rdfs:comment "Kind of control (if any)."@en;
                                        rdfs:domain cim:ShuntCompensatorControl;
                                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                        rdfs:label "controlKind"@en;
                                        rdfs:range cim:ShuntImpedanceControlKind.
cim:ShuntCompensatorControl.highVoltageOverride a owl:DatatypeProperty;
                                                rdfs:comment "For locally controlled shunt impedances which have a voltage override feature, the high voltage override value. If the voltage is above this value, the shunt impedance will be turned off regardless of the other local controller settings."@en;
                                                rdfs:domain cim:ShuntCompensatorControl;
                                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                                rdfs:label "highVoltageOverride"@en;
                                                rdfs:range cim:PU.
cim:ShuntCompensatorControl.localControlKind a owl:ObjectProperty;
                                             rdfs:comment "Kind of local controller."@en;
