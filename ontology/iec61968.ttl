             cimdoc:cimPackage "IEC61968.AssetInfo.Assets";
             cimdoc:packageTier "Normative".
cim:ComModule a owl:Class;
              rdfs:comment "An asset having communications capabilities that can be paired with a meter or other end device to provide the device with communication ability, through associated communication function. An end device that has communications capabilities through embedded hardware can use that function directly (without the communication module), or combine embedded communication function with additional communication functions provided through an external communication module (e.g. zigbee)."@en;
              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
              rdfs:label "ComModule"@en;
              rdfs:subClassOf cim:Asset;
              cimdoc:cimPackage "IEC61968.Metering";
              cimdoc:packageTier "Normative".
cim:ComModule.ComFunctions a owl:ObjectProperty;
                           rdfs:comment "All functions this communication module performs."@en;
                           rdfs:domain cim:ComModule;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                           rdfs:label "ComFunctions"@en;
                           rdfs:range cim:ComFunction.
cim:ComModule.amrSystem a owl:DatatypeProperty;
                        rdfs:comment "Automated meter reading (AMR) system communicating with this com module."@en;
                        rdfs:domain cim:ComModule;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                        rdfs:label "amrSystem"@en;
                        rdfs:range xsd:string.
cim:ComModule.supportsAutonomousDst a owl:DatatypeProperty;
                                    rdfs:comment "If true, autonomous daylight saving time (DST) function is supported."@en;
                                    rdfs:domain cim:ComModule;
                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                    rdfs:label "supportsAutonomousDst"@en;
                                    rdfs:range xsd:boolean.
cim:ComModule.timeZoneOffset a owl:DatatypeProperty;
                             rdfs:comment "Time zone offset relative to GMT for the location of this com module."@en;
                             rdfs:domain cim:ComModule;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                             rdfs:label "timeZoneOffset"@en;
                             rdfs:range cim:Minutes.
cim:ComTechnologyKind a owl:Class;
                      rdfs:comment "Kind of communication technology."@en;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                      rdfs:label "ComTechnologyKind"@en;
                      owl:equivalentClass [a owl:Class ; 
