                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                      rdfs:label "handhole"@en;
                                      cimdoc:enumCode 2 .
cim:UndergroundStructureKind.manhole a owl:NamedIndividual,
                                       cim:UndergroundStructureKind;
                                     rdfs:comment "The manhole underground structure kind"@en;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                     rdfs:label "manhole"@en;
                                     cimdoc:enumCode 3 .
cim:UndergroundStructureKind.pad a owl:NamedIndividual,
                                   cim:UndergroundStructureKind;
                                 rdfs:comment "The pad underground structure kind"@en;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                 rdfs:label "pad"@en;
                                 cimdoc:enumCode 4 .
cim:UndergroundStructureKind.pullbox a owl:NamedIndividual,
                                       cim:UndergroundStructureKind;
                                     rdfs:comment "The pullbox underground structure kind"@en;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                     rdfs:label "pullbox"@en;
                                     cimdoc:enumCode 9 .
cim:UndergroundStructureKind.subsurfaceEnclosure a owl:NamedIndividual,
                                                   cim:UndergroundStructureKind;
                                                 rdfs:comment "The subsurface enclosure underground structure kind"@en;
                                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                                 rdfs:label "subsurfaceEnclosure"@en;
                                                 cimdoc:enumCode 5 .
cim:UndergroundStructureKind.trench a owl:NamedIndividual,
                                      cim:UndergroundStructureKind;
                                    rdfs:comment "The trench underground structure kind"@en;
                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                    rdfs:label "trench"@en;
                                    cimdoc:enumCode 6 .
cim:UndergroundStructureKind.tunnel a owl:NamedIndividual,
                                      cim:UndergroundStructureKind;
                                    rdfs:comment "The tunnel underground structure kind"@en;
                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                    rdfs:label "tunnel"@en;
                                    cimdoc:enumCode 7 .
cim:UndergroundStructureKind.vault a owl:NamedIndividual,
                                     cim:UndergroundStructureKind;
                                   rdfs:comment "The vault underground structure kind"@en;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                   rdfs:label "vault"@en;
                                   cimdoc:enumCode 8 .
cim:UnplannedOutage a owl:Class;
                    rdfs:comment "Document describing the consequence of an unplanned outage in a part of the electrical network. For the purposes of this model, an unplanned outage refers to a state where energy is not delivered; such as, customers out of service, a street light is not served, etc. A unplanned outage may be created upon: - impacts the SAIDI calculation - a breaker trip, - a fault indicator status change, - a meter event indicating customer outage, - a reception of one or more customer trouble calls, or - an operator command, reflecting information obtained from the field crew. Outage restoration may be performed using a switching plan which complements the outage information with detailed switching activities, including the relationship to the crew and work."@en;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                    rdfs:label "UnplannedOutage"@en;
                    rdfs:subClassOf cim:Outage;
                    cimdoc:cimPackage "IEC61968.Operations";
                    cimdoc:packageTier "Normative".
cim:UnplannedOutage.TroubleOrder a owl:ObjectProperty;
                                 rdfs:comment "The trouble order that is associated to the unplanned outage."@en;
                                 rdfs:domain cim:UnplannedOutage;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                 rdfs:label "TroubleOrder"@en;
                                 rdfs:range cim:TroubleOrder.
cim:UnplannedOutage.TroubleTicket a owl:ObjectProperty;
                                  rdfs:comment "The ticket called in by the customer that describes the trouble"@en;
                                  rdfs:domain cim:UnplannedOutage;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                  rdfs:label "TroubleTicket"@en;
                                  rdfs:range cim:TroubleTicket.
cim:UnplannedOutage.cause a owl:DatatypeProperty;
                          rdfs:comment "The cause of this outage. This is the cause that is used to present to external entities. That is, the cause is weather, equipment failure, etc. Note: At present, this is a free string text; it could be replaced with an enumeration in the future."@en;
                          rdfs:domain cim:UnplannedOutage;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                          rdfs:label "cause"@en;
                          rdfs:range xsd:string.
cim:UnplannedOutage.causeKind a owl:ObjectProperty;
                              rdfs:comment "The possible cause that could be associated with this unplanned outage."@en;
                              rdfs:domain cim:UnplannedOutage;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                              rdfs:label "causeKind"@en;
                              rdfs:range cim:OutageCauseKind.
cim:UnplannedOutage.reportedStartTime a owl:DatatypeProperty;
                                      rdfs:comment "The earliest start time of the Outage - as reported by some system or individual"@en;
                                      rdfs:domain cim:UnplannedOutage;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                      rdfs:label "reportedStartTime"@en;
                                      rdfs:range xsd:dateTime.
cim:Usage a owl:Class;
          rdfs:comment "The way material and assets are used to perform a certain type of work task. The way is described in text in the inheritied description attribute."@en;
          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
          rdfs:label "Usage"@en;
          rdfs:subClassOf cim:WorkIdentifiedObject;
          cimdoc:cimPackage "IEC61968.InfIEC61968.InfWork";
          cimdoc:packageTier "Informative".
cim:Usage.status a owl:ObjectProperty;
                 rdfs:comment "The status"@en;
                 rdfs:domain cim:Usage;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                 rdfs:label "status"@en;
                 rdfs:range cim:Status.
cim:UsagePoint a owl:Class;
               rdfs:comment "Logical or physical point in the network to which readings or events may be attributed. Used at the place where a physical or virtual meter may be located; however, it is not required that a meter be present."@en;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
               rdfs:label "UsagePoint"@en;
               rdfs:subClassOf cim:IdentifiedObject;
               cimdoc:cimPackage "IEC61968.Metering";
               cimdoc:packageTier "Normative".
cim:UsagePoint.ConfigurationEvents a owl:ObjectProperty;
                                   rdfs:comment "All configuration events created for this usage point."@en;
                                   rdfs:domain cim:UsagePoint;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                   rdfs:label "ConfigurationEvents"@en;
                                   rdfs:range cim:ConfigurationEvent.
cim:UsagePoint.EndDevices a owl:ObjectProperty;
                          rdfs:comment "All end devices at this usage point."@en;
                          rdfs:domain cim:UsagePoint;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                          rdfs:label "EndDevices"@en;
                          rdfs:range cim:EndDevice.
cim:UsagePoint.Equipments a owl:ObjectProperty;
                          rdfs:comment "All equipment connecting this usage point to the electrical grid."@en;
                          rdfs:domain cim:UsagePoint;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                          rdfs:label "Equipments"@en;
                          rdfs:range cim:Equipment.
cim:UsagePoint.Register a owl:ObjectProperty;
                        rdfs:comment "All registers for quantities metered at this Usage Point."@en;
                        rdfs:domain cim:UsagePoint;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                        rdfs:label "Register"@en;
                        rdfs:range cim:Register.
cim:UsagePoint.ServiceCategory a owl:ObjectProperty;
                               rdfs:comment "Service category delivered by this usage point."@en;
                               rdfs:domain cim:UsagePoint;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                               rdfs:label "ServiceCategory"@en;
                               rdfs:range cim:ServiceCategory.
cim:UsagePoint.ServiceMultipliers a owl:ObjectProperty;
                                  rdfs:comment "All multipliers applied at this usage point."@en;
                                  rdfs:domain cim:UsagePoint;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                  rdfs:label "ServiceMultipliers"@en;
                                  rdfs:range cim:ServiceMultiplier.
cim:UsagePoint.amiBillingReady a owl:ObjectProperty;
                               rdfs:comment "Tracks the lifecycle of the metering installation at a usage point with respect to readiness for billing via advanced metering infrastructure reads."@en;
                               rdfs:domain cim:UsagePoint;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                               rdfs:label "amiBillingReady"@en;
                               rdfs:range cim:AmiBillingReadyKind.
cim:UsagePoint.checkBilling a owl:DatatypeProperty;
                            rdfs:comment "True if as a result of an inspection or otherwise, there is a reason to suspect that a previous billing may have been performed with erroneous data. Value should be reset once this potential discrepancy has been resolved."@en;
                            rdfs:domain cim:UsagePoint;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                            rdfs:label "checkBilling"@en;
                            rdfs:range xsd:boolean.
cim:UsagePoint.connectionCategory a owl:DatatypeProperty;
                                  rdfs:comment "A code used to specify the connection category, e.g., low voltage or low pressure, where the usage point is defined."@en;
                                  rdfs:domain cim:UsagePoint;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                  rdfs:label "connectionCategory"@en;
                                  rdfs:range xsd:string.
cim:UsagePoint.connectionState a owl:ObjectProperty;
                               rdfs:comment "State of the usage point with respect to connection to the network."@en;
                               rdfs:domain cim:UsagePoint;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                               rdfs:label "connectionState"@en;
                               rdfs:range cim:UsagePointConnectedKind.
cim:UsagePoint.disconnectionMethod a owl:DatatypeProperty;
                                   rdfs:comment "Is an indication of how the usage point is physically connected or disconnected."@en;
                                   rdfs:domain cim:UsagePoint;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                   rdfs:label "disconnectionMethod"@en;
                                   rdfs:range xsd:string.
cim:UsagePoint.estimatedLoad a owl:DatatypeProperty;
                             rdfs:comment "Estimated load."@en;
                             rdfs:domain cim:UsagePoint;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                             rdfs:label "estimatedLoad"@en;
                             rdfs:range cim:CurrentFlow.
cim:UsagePoint.grounded a owl:DatatypeProperty;
                        rdfs:comment "True if grounded."@en;
                        rdfs:domain cim:UsagePoint;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                        rdfs:label "grounded"@en;
                        rdfs:range xsd:boolean.
cim:UsagePoint.isSdp a owl:DatatypeProperty;
                     rdfs:comment "If true, this usage point is a service delivery point, i.e., a usage point where the ownership of the service changes hands."@en;
                     rdfs:domain cim:UsagePoint;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                     rdfs:label "isSdp"@en;
                     rdfs:range xsd:boolean.
cim:UsagePoint.isVirtual a owl:DatatypeProperty;
                         rdfs:comment "If true, this usage point is virtual, i.e., no physical location exists in the network where a meter could be located to collect the meter readings. For example, one may define a virtual usage point to serve as an aggregation of usage for all of a company's premises distributed widely across the distribution territory. Otherwise, the usage point is physical, i.e., there is a logical point in the network where a meter could be located to collect meter readings."@en;
                         rdfs:domain cim:UsagePoint;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                         rdfs:label "isVirtual"@en;
                         rdfs:range xsd:boolean.
cim:UsagePoint.minimalUsageExpected a owl:DatatypeProperty;
                                    rdfs:comment "If true, minimal or zero usage is expected at this usage point for situations such as premises vacancy, logical or physical disconnect. It is used for readings validation and estimation."@en;
                                    rdfs:domain cim:UsagePoint;
                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                    rdfs:label "minimalUsageExpected"@en;
                                    rdfs:range xsd:boolean.
cim:UsagePoint.nominalServiceVoltage a owl:DatatypeProperty;
                                     rdfs:comment "Nominal service voltage."@en;
                                     rdfs:domain cim:UsagePoint;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                     rdfs:label "nominalServiceVoltage"@en;
                                     rdfs:range cim:Voltage.
cim:UsagePoint.outageRegion a owl:DatatypeProperty;
                            rdfs:comment "Outage region in which this usage point is located."@en;
                            rdfs:domain cim:UsagePoint;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                            rdfs:label "outageRegion"@en;
                            rdfs:range xsd:string.
cim:UsagePoint.phaseCode a owl:ObjectProperty;
                         rdfs:comment "Phase code. Number of wires and specific nominal phases can be deduced from enumeration literal values. For example, ABCN is three-phase, four-wire, s12n (splitSecondary12N) is single-phase, three-wire, and s1n and s2n are single- phase, two-wire."@en;
                         rdfs:domain cim:UsagePoint;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                         rdfs:label "phaseCode"@en;
                         rdfs:range cim:PhaseCode.
cim:UsagePoint.phaseCount a owl:DatatypeProperty;
                          rdfs:comment "Number of potential phases the Usage Point supports, typically 0, 1 or 3."@en;
                          rdfs:domain cim:UsagePoint;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                          rdfs:label "phaseCount"@en;
                          rdfs:range xsd:integer.
cim:UsagePoint.physicalConnectionCapacity a owl:DatatypeProperty;
                                          rdfs:comment "Quantitative information about the maximum physical capacity of the connection for the usage point."@en;
                                          rdfs:domain cim:UsagePoint;
                                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                          rdfs:label "physicalConnectionCapacity"@en;
                                          rdfs:range cim:DecimalQuantity.
cim:UsagePoint.ratedCurrent a owl:DatatypeProperty;
                            rdfs:comment "Current flow that this usage point is configured to deliver."@en;
                            rdfs:domain cim:UsagePoint;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                            rdfs:label "ratedCurrent"@en;
                            rdfs:range cim:CurrentFlow.
cim:UsagePoint.ratedPower a owl:DatatypeProperty;
                          rdfs:comment "Active power that this usage point is configured to deliver."@en;
                          rdfs:domain cim:UsagePoint;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                          rdfs:label "ratedPower"@en;
                          rdfs:range cim:ActivePower.
cim:UsagePoint.readCycle a owl:DatatypeProperty;
                         rdfs:comment "Cycle day on which the meter for this usage point will normally be read. Usually correlated with the billing cycle."@en;
                         rdfs:domain cim:UsagePoint;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                         rdfs:label "readCycle"@en;
                         rdfs:range xsd:string.
cim:UsagePoint.readRoute a owl:DatatypeProperty;
                         rdfs:comment "Identifier of the route to which this usage point is assigned for purposes of meter reading. Typically used to configure hand held meter reading systems prior to collection of reads."@en;
                         rdfs:domain cim:UsagePoint;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                         rdfs:label "readRoute"@en;
                         rdfs:range xsd:string.
cim:UsagePoint.serviceDeliveryRemark a owl:DatatypeProperty;
                                     rdfs:comment "Remarks about this usage point, for example the reason for it being rated with a non-nominal priority."@en;
                                     rdfs:domain cim:UsagePoint;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                     rdfs:label "serviceDeliveryRemark"@en;
                                     rdfs:range xsd:string.
cim:UsagePoint.servicePriority a owl:DatatypeProperty;
                               rdfs:comment "Priority of service for this usage point. Note that usage points at the same service location can have different priorities."@en;
                               rdfs:domain cim:UsagePoint;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                               rdfs:label "servicePriority"@en;
                               rdfs:range xsd:string.
cim:UsagePointConnectedKind a owl:Class;
                            rdfs:comment "State of the usage point with respect to connection to the network."@en;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                            rdfs:label "UsagePointConnectedKind"@en;
                            owl:equivalentClass [a owl:Class ; 
                                                 owl:oneOf (cim:UsagePointConnectedKind.connected
                                                            cim:UsagePointConnectedKind.logicallyDisconnected
                                                            cim:UsagePointConnectedKind.physicallyDisconnected)];
                            cimdoc:cimPackage "IEC61968.Metering";
                            cimdoc:packageTier "Normative".
cim:UsagePointConnectedKind.connected a owl:NamedIndividual,
                                        cim:UsagePointConnectedKind;
                                      rdfs:comment "The usage point is connected to the network and able to receive or send the applicable commodity (electricity, gas, water, etc.)."@en;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                      rdfs:label "connected"@en;
                                      cimdoc:enumCode 0 .
cim:UsagePointConnectedKind.logicallyDisconnected a owl:NamedIndividual,
                                                    cim:UsagePointConnectedKind;
                                                  rdfs:comment "The usage point has been disconnected through operation of a disconnect function within the meter present at the usage point. The usage point is unable to receive or send the applicable commodity (electricity, gas, water, etc.) A logical disconnect can often be achieved without utilising a field crew."@en;
                                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                                  rdfs:label "logicallyDisconnected"@en;
                                                  cimdoc:enumCode 2 .
cim:UsagePointConnectedKind.physicallyDisconnected a owl:NamedIndividual,
                                                     cim:UsagePointConnectedKind;
                                                   rdfs:comment "The usage point has been disconnected from the network at a point upstream of the meter. The usage point is unable to receive or send the applicable commodity (electricity, gas, water, etc.). A physical disconnect is often achieved by utilising a field crew."@en;
                                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                                   rdfs:label "physicallyDisconnected"@en;
                                                   cimdoc:enumCode 1 .
cim:UsagePointGroup a owl:Class;
                    rdfs:comment "Abstraction for management of group communications within a two-way AMR system or the data for a group of related usage points. Commands can be issued to all of the usage points that belong to a usage point group using a defined group address and the underlying AMR communication infrastructure."@en;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                    rdfs:label "UsagePointGroup"@en;
                    rdfs:subClassOf cim:IdentifiedObject;
                    cimdoc:cimPackage "IEC61968.Metering";
                    cimdoc:packageTier "Normative".
cim:UsagePointGroup.UsagePoints a owl:ObjectProperty;
                                rdfs:comment "All usage points in this group."@en;
                                rdfs:domain cim:UsagePointGroup;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                rdfs:label "UsagePoints"@en;
                                rdfs:range cim:UsagePoint.
cim:UsagePointGroup.type a owl:DatatypeProperty;
                         rdfs:comment "Type of this group."@en;
                         rdfs:domain cim:UsagePointGroup;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                         rdfs:label "type"@en;
                         rdfs:range xsd:string.
cim:UsagePointLocation a owl:Class;
                       rdfs:comment "Location of an individual usage point."@en;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                       rdfs:label "UsagePointLocation"@en;
                       rdfs:subClassOf cim:Location;
                       cimdoc:cimPackage "IEC61968.Metering";
                       cimdoc:packageTier "Normative".
cim:UsagePointLocation.UsagePoints a owl:ObjectProperty;
                                   rdfs:comment "All usage points at this location."@en;
                                   rdfs:domain cim:UsagePointLocation;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                   rdfs:label "UsagePoints"@en;
                                   rdfs:range cim:UsagePoint.
cim:UsagePointLocation.accessMethod a owl:DatatypeProperty;
                                    rdfs:comment "Method for the service person to access this usage point location. For example, a description of where to obtain a key if the facility is unmanned and secured."@en;
                                    rdfs:domain cim:UsagePointLocation;
                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                    rdfs:label "accessMethod"@en;
                                    rdfs:range xsd:string.
cim:UsagePointLocation.remark a owl:DatatypeProperty;
                              rdfs:comment "Remarks about this location."@en;
                              rdfs:domain cim:UsagePointLocation;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                              rdfs:label "remark"@en;
                              rdfs:range xsd:string.
cim:UsagePointLocation.siteAccessProblem a owl:DatatypeProperty;
                                         rdfs:comment "Problems previously encountered when visiting or performing work at this location. Examples include: bad dog, violent customer, verbally abusive occupant, obstructions, safety hazards, etc."@en;
                                         rdfs:domain cim:UsagePointLocation;
                                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                         rdfs:label "siteAccessProblem"@en;
                                         rdfs:range xsd:string.
cim:UserAttribute a owl:Class;
                  rdfs:comment "Generic name-value pair class, with optional sequence number and units for value; can be used to model parts of information exchange when concrete types are not known in advance."@en;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                  rdfs:label "UserAttribute"@en;
                  cimdoc:cimPackage "IEC61968.Common";
                  cimdoc:packageTier "Normative".
cim:UserAttribute.ProcedureDataSets a owl:ObjectProperty;
                                    rdfs:comment "The procedure data sets"@en;
                                    rdfs:domain cim:UserAttribute;
                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                    rdfs:label "ProcedureDataSets"@en;
                                    rdfs:range cim:ProcedureDataSet.
cim:UserAttribute.PropertySpecification a owl:ObjectProperty;
                                        rdfs:comment "The property specification"@en;
                                        rdfs:domain cim:UserAttribute;
                                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                        rdfs:label "PropertySpecification"@en;
                                        rdfs:range cim:Specification.
cim:UserAttribute.RatingSpecification a owl:ObjectProperty;
                                      rdfs:comment "The rating specification"@en;
                                      rdfs:domain cim:UserAttribute;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                      rdfs:label "RatingSpecification"@en;
                                      rdfs:range cim:Specification.
cim:UserAttribute.Transaction a owl:ObjectProperty;
                              rdfs:comment "Transaction for which this snapshot has been recorded."@en;
                              rdfs:domain cim:UserAttribute;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                              rdfs:label "Transaction"@en;
                              rdfs:range cim:Transaction.
cim:UserAttribute.name a owl:DatatypeProperty;
                       rdfs:comment "Name of an attribute."@en;
                       rdfs:domain cim:UserAttribute;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                       rdfs:label "name"@en;
                       rdfs:range xsd:string.
cim:UserAttribute.sequenceNumber a owl:DatatypeProperty;
                                 rdfs:comment "Sequence number for this attribute in a list of attributes."@en;
                                 rdfs:domain cim:UserAttribute;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                 rdfs:label "sequenceNumber"@en;
                                 rdfs:range xsd:integer.
cim:UserAttribute.value a owl:DatatypeProperty;
                        rdfs:comment "Value of an attribute, including unit information."@en;
                        rdfs:domain cim:UserAttribute;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                        rdfs:label "value"@en;
                        rdfs:range cim:StringQuantity.
cim:Vehicle a owl:Class;
            rdfs:comment "Vehicle asset."@en;
            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
            rdfs:label "Vehicle"@en;
            rdfs:subClassOf cim:WorkAsset;
            cimdoc:cimPackage "IEC61968.Work";
            cimdoc:packageTier "Normative".
cim:Vehicle.odometerReadDateTime a owl:DatatypeProperty;
                                 rdfs:comment "Date and time the last odometer reading was recorded."@en;
                                 rdfs:domain cim:Vehicle;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                 rdfs:label "odometerReadDateTime"@en;
                                 rdfs:range xsd:dateTime.
cim:Vehicle.odometerReading a owl:DatatypeProperty;
                            rdfs:comment "Odometer reading of this vehicle as of the 'odometerReadingDateTime'. Refer to associated ActivityRecords for earlier readings."@en;
                            rdfs:domain cim:Vehicle;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                            rdfs:label "odometerReading"@en;
                            rdfs:range cim:Length.
cim:Vehicle.usageKind a owl:ObjectProperty;
                      rdfs:comment "Kind of usage of the vehicle."@en;
                      rdfs:domain cim:Vehicle;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                      rdfs:label "usageKind"@en;
                      rdfs:range cim:VehicleUsageKind.
cim:VehicleUsageKind a owl:Class;
                     rdfs:comment "Usage of a vehicle."@en;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                     rdfs:label "VehicleUsageKind"@en;
                     owl:equivalentClass [a owl:Class ; 
                                          owl:oneOf (cim:VehicleUsageKind.contractor
                                                     cim:VehicleUsageKind.crew
                                                     cim:VehicleUsageKind.other
                                                     cim:VehicleUsageKind.user)];
                     cimdoc:cimPackage "IEC61968.Work";
                     cimdoc:packageTier "Normative".
cim:VehicleUsageKind.contractor a owl:NamedIndividual,
                                  cim:VehicleUsageKind;
                                rdfs:comment "Contractor vehicle."@en;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                rdfs:label "contractor"@en;
                                cimdoc:enumCode 2 .
cim:VehicleUsageKind.crew a owl:NamedIndividual,
                            cim:VehicleUsageKind;
                          rdfs:comment "Crew vehicle."@en;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                          rdfs:label "crew"@en;
                          cimdoc:enumCode 0 .
cim:VehicleUsageKind.other a owl:NamedIndividual,
                             cim:VehicleUsageKind;
                           rdfs:comment "Other vehicle."@en;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                           rdfs:label "other"@en;
                           cimdoc:enumCode 3 .
cim:VehicleUsageKind.user a owl:NamedIndividual,
                            cim:VehicleUsageKind;
                          rdfs:comment "User vehicle."@en;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                          rdfs:label "user"@en;
                          cimdoc:enumCode 1 .
cim:Vendor a owl:Class;
           rdfs:comment "The entity that owns the point of sale and contracts with the cashier to receipt payments and vend tokens using the payment system. The vendor has a private contract with and is managed by the merchant which is a type of organisation. The vendor is accountable to the merchant for revenue collected, and the merchant is in turn accountable to the supplier."@en;
           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
           rdfs:label "Vendor"@en;
           rdfs:subClassOf cim:IdentifiedObject;
           cimdoc:cimPackage "IEC61968.PaymentMetering";
           cimdoc:packageTier "Normative".
cim:Vendor.VendorShifts a owl:ObjectProperty;
                        rdfs:comment "All vendor shifts opened and owned by this vendor."@en;
                        rdfs:domain cim:Vendor;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                        rdfs:label "VendorShifts"@en;
                        rdfs:range cim:VendorShift.
cim:VendorShift a owl:Class;
                rdfs:comment "The operating shift for a vendor during which the vendor may transact against the merchant's account. It aggregates transactions and receipts during the shift and periodically debits a merchant account. The totals in vendor shift should always be the sum of totals aggregated in all cashier shifts that were open under the particular vendor shift."@en;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                rdfs:label "VendorShift"@en;
                rdfs:subClassOf cim:Shift;
                cimdoc:cimPackage "IEC61968.PaymentMetering";
                cimdoc:packageTier "Normative".
cim:VendorShift.Receipts a owl:ObjectProperty;
                         rdfs:comment "All receipts recorded during this vendor shift."@en;
                         rdfs:domain cim:VendorShift;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                         rdfs:label "Receipts"@en;
                         rdfs:range cim:Receipt.
cim:VendorShift.Transactions a owl:ObjectProperty;
                             rdfs:comment "All transactions recorded during this vendor shift."@en;
                             rdfs:domain cim:VendorShift;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                             rdfs:label "Transactions"@en;
                             rdfs:range cim:Transaction.
cim:VendorShift.merchantDebitAmount a owl:DatatypeProperty;
                                    rdfs:comment "The amount that is to be debited from the merchant account for this vendor shift. This amount reflects the sum(PaymentTransaction.transactionAmount)."@en;
                                    rdfs:domain cim:VendorShift;
                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                    rdfs:label "merchantDebitAmount"@en;
                                    rdfs:range cim:Money.
cim:VendorShift.posted a owl:DatatypeProperty;
                       rdfs:comment "If true, merchantDebitAmount has been debited from MerchantAccount; typically happens at the end of VendorShift when it closes."@en;
                       rdfs:domain cim:VendorShift;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                       rdfs:label "posted"@en;
                       rdfs:range xsd:boolean.
cim:VerificationAction a owl:Class;
                       rdfs:comment "Verification of a switch position or other condition as a switching step"@en;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                       rdfs:label "VerificationAction"@en;
                       rdfs:subClassOf cim:SwitchingAction;
                       cimdoc:cimPackage "IEC61968.Operations";
                       cimdoc:packageTier "Normative".
cim:VerificationAction.PowerSystemResource a owl:ObjectProperty;
                                           rdfs:comment "The power system resource that the verification action is performed on"@en;
                                           rdfs:domain cim:VerificationAction;
                                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                           rdfs:label "PowerSystemResource"@en;
                                           rdfs:range cim:PowerSystemResource.
cim:VerificationAction.verificationCondition a owl:DatatypeProperty;
                                             rdfs:comment "freeform description of the condition to be verified"@en;
                                             rdfs:domain cim:VerificationAction;
                                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                             rdfs:label "verificationCondition"@en;
                                             rdfs:range xsd:string.
cim:Version a owl:Class;
            rdfs:comment "This is the version for a group of devices or objects. This could be used to track the version for any group of objects or devices over time. For example, for a DERGroup, the requesting system may want to get the details of a specific version of a DERGroup."@en;
            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
            rdfs:label "Version"@en;
            cimdoc:cimPackage "IEC61968.Common";
            cimdoc:packageTier "Normative".
cim:Version.date a owl:DatatypeProperty;
                 rdfs:comment "date of this version"@en;
                 rdfs:domain cim:Version;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                 rdfs:label "date"@en;
                 rdfs:range xsd:dateTime.
cim:Version.major a owl:DatatypeProperty;
                  rdfs:comment "major release level for this version"@en;
                  rdfs:domain cim:Version;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                  rdfs:label "major"@en;
                  rdfs:range xsd:integer.
cim:Version.minor a owl:DatatypeProperty;
                  rdfs:comment "minor release level for this version"@en;
                  rdfs:domain cim:Version;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                  rdfs:label "minor"@en;
                  rdfs:range xsd:integer.
cim:Version.revision a owl:DatatypeProperty;
                     rdfs:comment "revision level for this version"@en;
                     rdfs:domain cim:Version;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                     rdfs:label "revision"@en;
                     rdfs:range xsd:integer.
cim:WEPStandard a owl:Class;
                rdfs:comment "Standard published by Westinghouse - a WEP (Westinghouse Engineering Procedure)."@en;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                rdfs:label "WEPStandard"@en;
                cimdoc:cimPackage "IEC61968.AssetInfo.Assets";
                cimdoc:packageTier "Normative".
cim:WEPStandard.standardEdition a owl:ObjectProperty;
                                rdfs:comment "Edition of WEP standard."@en;
                                rdfs:domain cim:WEPStandard;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                rdfs:label "standardEdition"@en;
                                rdfs:range cim:WEPStandardEditionKind.
cim:WEPStandard.standardNumber a owl:ObjectProperty;
                               rdfs:comment "WEP standard number."@en;
                               rdfs:domain cim:WEPStandard;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                               rdfs:label "standardNumber"@en;
                               rdfs:range cim:WEPStandardKind.
cim:WEPStandardEditionKind a owl:Class;
                           rdfs:comment "List of editions for WEP standards."@en;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                           rdfs:label "WEPStandardEditionKind"@en;
                           owl:equivalentClass [a owl:Class ; 
                                                owl:oneOf (cim:WEPStandardEditionKind.none
                                                           cim:WEPStandardEditionKind.unknown)];
                           cimdoc:cimPackage "IEC61968.AssetInfo.Assets";
                           cimdoc:packageTier "Normative".
cim:WEPStandardEditionKind.none a owl:NamedIndividual,
                                  cim:WEPStandardEditionKind;
                                rdfs:comment "No edition."@en;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                rdfs:label "none"@en;
                                cimdoc:enumCode 0 .
cim:WEPStandardEditionKind.unknown a owl:NamedIndividual,
                                     cim:WEPStandardEditionKind;
                                   rdfs:comment "Unknown edition."@en;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                   rdfs:label "unknown"@en;
                                   cimdoc:enumCode 1 .
cim:WEPStandardKind a owl:Class;
                    rdfs:comment "List of WEP standards."@en;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                    rdfs:label "WEPStandardKind"@en;
                    owl:equivalentClass [a owl:Class ; 
                                         owl:oneOf (cim:WEPStandardKind.WE_12
                                                    cim:WEPStandardKind.WE_1254E)];
                    cimdoc:cimPackage "IEC61968.AssetInfo.Assets";
                    cimdoc:packageTier "Normative".
cim:WEPStandardKind.WE_12 a owl:NamedIndividual,
                            cim:WEPStandardKind;
                          rdfs:comment "Westinghouse Engineering Procedure 12,1254E."@en;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                          rdfs:label "WE_12"@en;
                          cimdoc:enumCode 0 .
cim:WEPStandardKind.WE_1254E a owl:NamedIndividual,
                               cim:WEPStandardKind;
                             rdfs:comment "The we 1254e wep standard kind"@en;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                             rdfs:label "WE_1254E"@en;
                             cimdoc:enumCode 1 .
cim:WindingInsulation a owl:Class;
                      rdfs:comment "Winding insulation condition as a result of a test."@en;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                      rdfs:label "WindingInsulation"@en;
                      rdfs:subClassOf cim:IdentifiedObject;
                      cimdoc:cimPackage "IEC61968.InfIEC61968.InfAssets";
                      cimdoc:packageTier "Informative".
cim:WindingInsulation.FromWinding a owl:ObjectProperty;
                                  rdfs:comment "The from winding"@en;
                                  rdfs:domain cim:WindingInsulation;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                  rdfs:label "FromWinding"@en;
                                  rdfs:range cim:TransformerEnd.
cim:WindingInsulation.ToWinding a owl:ObjectProperty;
                                rdfs:comment "The to winding"@en;
                                rdfs:domain cim:WindingInsulation;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                rdfs:label "ToWinding"@en;
                                rdfs:range cim:TransformerEnd.
cim:WindingInsulation.insulationPFStatus a owl:DatatypeProperty;
                                         rdfs:comment "Status of Winding Insulation Power Factor as of statusDate: Acceptable, Minor Deterioration or Moisture Absorption, Major Deterioration or Moisture Absorption, Failed."@en;
                                         rdfs:domain cim:WindingInsulation;
                                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                         rdfs:label "insulationPFStatus"@en;
                                         rdfs:range xsd:string.
cim:WindingInsulation.insulationResistance a owl:DatatypeProperty;
                                           rdfs:comment "For testType, status of Winding Insulation Resistance as of statusDate. Typical values are: Acceptable, Questionable, Failed."@en;
                                           rdfs:domain cim:WindingInsulation;
                                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                           rdfs:label "insulationResistance"@en;
                                           rdfs:range xsd:string.
cim:WindingInsulation.leakageReactance a owl:DatatypeProperty;
                                       rdfs:comment """As of statusDate, the leakage reactance measured at the \"from\" winding with the \"to\" winding short-circuited and all other windings open-circuited."""@en;
                                       rdfs:domain cim:WindingInsulation;
                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                       rdfs:label "leakageReactance"@en;
                                       rdfs:range cim:Reactance.
cim:WindingInsulation.status a owl:ObjectProperty;
                             rdfs:comment "The status"@en;
                             rdfs:domain cim:WindingInsulation;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                             rdfs:label "status"@en;
                             rdfs:range cim:Status.
cim:WindingInsulationKind a owl:Class;
                          rdfs:comment "Insulation kind for windings."@en;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                          rdfs:label "WindingInsulationKind"@en;
                          owl:equivalentClass [a owl:Class ; 
                                               owl:oneOf (cim:WindingInsulationKind.nomex
                                                          cim:WindingInsulationKind.other
                                                          cim:WindingInsulationKind.paper
                                                          cim:WindingInsulationKind.thermallyUpgradedPaper)];
                          cimdoc:cimPackage "IEC61968.InfIEC61968.InfAssetInfo";
                          cimdoc:packageTier "Informative".
cim:WindingInsulationKind.nomex a owl:NamedIndividual,
                                  cim:WindingInsulationKind;
                                rdfs:comment "The nomex winding insulation kind"@en;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                rdfs:label "nomex"@en;
                                cimdoc:enumCode 2 .
cim:WindingInsulationKind.other a owl:NamedIndividual,
                                  cim:WindingInsulationKind;
                                rdfs:comment "The other winding insulation kind"@en;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                rdfs:label "other"@en;
                                cimdoc:enumCode 3 .
cim:WindingInsulationKind.paper a owl:NamedIndividual,
                                  cim:WindingInsulationKind;
                                rdfs:comment "The paper winding insulation kind"@en;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                rdfs:label "paper"@en;
                                cimdoc:enumCode 0 .
cim:WindingInsulationKind.thermallyUpgradedPaper a owl:NamedIndividual,
                                                   cim:WindingInsulationKind;
                                                 rdfs:comment "The thermally upgraded paper winding insulation kind"@en;
                                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                                 rdfs:label "thermallyUpgradedPaper"@en;
                                                 cimdoc:enumCode 1 .
cim:WireAssemblyInfo a owl:Class;
                     rdfs:comment "Describes the construction of a multi-conductor wire."@en;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                     rdfs:label "WireAssemblyInfo"@en;
                     rdfs:subClassOf cim:AssetInfo;
                     cimdoc:cimPackage "IEC61968.AssetInfo";
                     cimdoc:packageTier "Normative".
cim:WireAssemblyInfo.PerLengthLineParameter a owl:ObjectProperty;
                                            rdfs:comment "Per length line parameter associated with this wire assembly."@en;
                                            rdfs:domain cim:WireAssemblyInfo;
                                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                            rdfs:label "PerLengthLineParameter"@en;
                                            rdfs:range cim:PerLengthLineParameter.
cim:WireInfo a owl:Class;
             rdfs:comment "Wire data that can be specified per line segment phase, or for the line segment as a whole in case its phases all have the same wire characteristics."@en;
             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
             rdfs:label "WireInfo"@en;
             rdfs:subClassOf cim:AssetInfo;
             cimdoc:cimPackage "IEC61968.AssetInfo";
             cimdoc:packageTier "Normative".
cim:WireInfo.WirePhaseInfo a owl:ObjectProperty;
                           rdfs:comment "Wire phase information associated with this wire information."@en;
                           rdfs:domain cim:WireInfo;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                           rdfs:label "WirePhaseInfo"@en;
                           rdfs:range cim:WirePhaseInfo.
cim:WireInfo.coreRadius a owl:DatatypeProperty;
                        rdfs:comment "(if there is a different core material) Radius of the central core."@en;
                        rdfs:domain cim:WireInfo;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                        rdfs:label "coreRadius"@en;
                        rdfs:range cim:Length.
cim:WireInfo.coreStrandCount a owl:DatatypeProperty;
                             rdfs:comment "(if used) Number of strands in the steel core."@en;
                             rdfs:domain cim:WireInfo;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                             rdfs:label "coreStrandCount"@en;
                             rdfs:range xsd:integer.
cim:WireInfo.gmr a owl:DatatypeProperty;
                 rdfs:comment "Geometric mean radius. If we replace the conductor by a thin walled tube of radius GMR, then its reactance is identical to the reactance of the actual conductor."@en;
                 rdfs:domain cim:WireInfo;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                 rdfs:label "gmr"@en;
                 rdfs:range cim:Length.
cim:WireInfo.insulated a owl:DatatypeProperty;
                       rdfs:comment "True if conductor is insulated."@en;
                       rdfs:domain cim:WireInfo;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                       rdfs:label "insulated"@en;
                       rdfs:range xsd:boolean.
cim:WireInfo.insulationMaterial a owl:ObjectProperty;
                                rdfs:comment "(if insulated conductor) Material used for insulation."@en;
                                rdfs:domain cim:WireInfo;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                rdfs:label "insulationMaterial"@en;
                                rdfs:range cim:WireInsulationKind.
cim:WireInfo.insulationThickness a owl:DatatypeProperty;
                                 rdfs:comment "(if insulated conductor) Thickness of the insulation."@en;
                                 rdfs:domain cim:WireInfo;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                 rdfs:label "insulationThickness"@en;
                                 rdfs:range cim:Length.
cim:WireInfo.material a owl:ObjectProperty;
                      rdfs:comment "Conductor material."@en;
                      rdfs:domain cim:WireInfo;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                      rdfs:label "material"@en;
                      rdfs:range cim:WireMaterialKind.
cim:WireInfo.rAC25 a owl:DatatypeProperty;
                   rdfs:comment "AC resistance per unit length of the conductor at 25 �C."@en;
                   rdfs:domain cim:WireInfo;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                   rdfs:label "rAC25"@en;
                   rdfs:range cim:ResistancePerLength.
cim:WireInfo.rAC50 a owl:DatatypeProperty;
                   rdfs:comment "AC resistance per unit length of the conductor at 50 �C."@en;
                   rdfs:domain cim:WireInfo;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                   rdfs:label "rAC50"@en;
                   rdfs:range cim:ResistancePerLength.
cim:WireInfo.rAC75 a owl:DatatypeProperty;
                   rdfs:comment "AC resistance per unit length of the conductor at 75 �C."@en;
                   rdfs:domain cim:WireInfo;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                   rdfs:label "rAC75"@en;
                   rdfs:range cim:ResistancePerLength.
cim:WireInfo.rDC20 a owl:DatatypeProperty;
                   rdfs:comment "DC resistance per unit length of the conductor at 20 �C."@en;
                   rdfs:domain cim:WireInfo;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                   rdfs:label "rDC20"@en;
                   rdfs:range cim:ResistancePerLength.
cim:WireInfo.radius a owl:DatatypeProperty;
                    rdfs:comment "Outside radius of the wire."@en;
                    rdfs:domain cim:WireInfo;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                    rdfs:label "radius"@en;
                    rdfs:range cim:Length.
cim:WireInfo.ratedCurrent a owl:DatatypeProperty;
                          rdfs:comment "Current carrying capacity of the wire under stated thermal conditions."@en;
                          rdfs:domain cim:WireInfo;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                          rdfs:label "ratedCurrent"@en;
                          rdfs:range cim:CurrentFlow.
cim:WireInfo.sizeDescription a owl:DatatypeProperty;
                             rdfs:comment "Describes the wire gauge or cross section (e.g., 4/0, #2, 336.5)."@en;
                             rdfs:domain cim:WireInfo;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                             rdfs:label "sizeDescription"@en;
                             rdfs:range xsd:string.
cim:WireInfo.strandCount a owl:DatatypeProperty;
                         rdfs:comment "Number of strands in the conductor."@en;
                         rdfs:domain cim:WireInfo;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                         rdfs:label "strandCount"@en;
                         rdfs:range xsd:integer.
cim:WireInsulationKind a owl:Class;
                       rdfs:comment "Kind of wire insulation."@en;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                       rdfs:label "WireInsulationKind"@en;
                       owl:equivalentClass [a owl:Class ; 
                                            owl:oneOf (cim:WireInsulationKind.asbestosAndVarnishedCambric
                                                       cim:WireInsulationKind.beltedPilc
                                                       cim:WireInsulationKind.butyl
                                                       cim:WireInsulationKind.crosslinkedPolyethylene
                                                       cim:WireInsulationKind.ethylenePropyleneRubber
