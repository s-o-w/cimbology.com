cim:OperationalRestriction a owl:Class;
                           rdfs:comment "A document that can be associated with equipment to describe any sort of restrictions compared with the original manufacturer's specification or with the usual operational practice e.g. temporary maximum loadings, maximum switching current, do not operate if bus couplers are open, etc. In the UK, for example, if a breaker or switch ever mal-operates, this is reported centrally and utilities use their asset systems to identify all the installed devices of the same manufacturer's type. They then apply operational restrictions in the operational systems to warn operators of potential problems. After appropriate inspection and maintenance, the operational restrictions may be removed."@en;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                           rdfs:label "OperationalRestriction"@en;
                           rdfs:subClassOf cim:Document;
                           cimdoc:cimPackage "IEC61968.Operations";
                           cimdoc:packageTier "Normative".
cim:OperationalRestriction.Equipments a owl:ObjectProperty;
                                      rdfs:comment "All equipments to which this restriction applies."@en;
                                      rdfs:domain cim:OperationalRestriction;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                      rdfs:label "Equipments"@en;
                                      rdfs:range cim:Equipment.
cim:OperationalRestriction.ProductAssetModel a owl:ObjectProperty;
                                             rdfs:comment "Asset model to which this restriction applies."@en;
                                             rdfs:domain cim:OperationalRestriction;
                                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                             rdfs:label "ProductAssetModel"@en;
                                             rdfs:range cim:ProductAssetModel.
cim:OperationalRestriction.activePeriod a owl:ObjectProperty;
                                        rdfs:comment "Interval during which this restriction is applied."@en;
                                        rdfs:domain cim:OperationalRestriction;
                                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                        rdfs:label "activePeriod"@en;
                                        rdfs:range cim:DateTimeInterval.
cim:OperationalRestriction.restrictedValue a owl:DatatypeProperty;
                                           rdfs:comment "Restricted (new) value; includes unit of measure and potentially multiplier."@en;
                                           rdfs:domain cim:OperationalRestriction;
                                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                           rdfs:label "restrictedValue"@en;
                                           rdfs:range cim:FloatQuantity.
cim:OperationalTag a owl:Class;
