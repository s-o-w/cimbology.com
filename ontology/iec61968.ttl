cim:TapChangerInfo.isTcul a owl:DatatypeProperty;
                          rdfs:comment "Whether this tap changer has under load tap changing capabilities."@en;
                          rdfs:domain cim:TapChangerInfo;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                          rdfs:label "isTcul"@en;
                          rdfs:range xsd:boolean.
cim:TapChangerInfo.lowStep a owl:DatatypeProperty;
                           rdfs:comment "Lowest possible tap step position, retard from neutral."@en;
