                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                 rdfs:label "CompatibleUnits"@en;
                                 rdfs:range cim:CompatibleUnit.
cim:PropertyUnit.accountingUsage a owl:DatatypeProperty;
                                 rdfs:comment "A code that identifies appropriate type of property accounts such as distribution, streetlgihts, communications."@en;
