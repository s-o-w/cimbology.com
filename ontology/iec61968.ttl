                                  rdfs:domain cim:Transaction;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                  rdfs:label "serviceUnitsError"@en;
                                  rdfs:range cim:RealEnergy.
cim:TransactionKind a owl:Class;
                    rdfs:comment "Kind of transaction."@en;
