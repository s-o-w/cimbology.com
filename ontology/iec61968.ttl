                                             rdfs:domain cim:RemoteConnectDisconnectInfo;
                                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                             rdfs:label "isArmConnect"@en;
                                             rdfs:range xsd:boolean.
cim:RemoteConnectDisconnectInfo.isArmDisconnect a owl:DatatypeProperty;
                                                rdfs:comment "True if the RCD switch has to be armed before a disconnect action can be initiated."@en;
                                                rdfs:domain cim:RemoteConnectDisconnectInfo;
                                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                                rdfs:label "isArmDisconnect"@en;
                                                rdfs:range xsd:boolean.
cim:RemoteConnectDisconnectInfo.isEnergyLimiting a owl:DatatypeProperty;
                                                 rdfs:comment "True if the energy usage is limited and the customer will be disconnected if they go over the limit."@en;
                                                 rdfs:domain cim:RemoteConnectDisconnectInfo;
                                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
