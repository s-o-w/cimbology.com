                         rdfs:range cim:ServiceKind.
cim:ServiceGuarantee a owl:Class;
                     rdfs:comment "A service guarantee, often imposed by a regulator, defines conditions that, if not satisfied, will result in the utility making a monetary payment to the customer. Note that guarantee's identifier is in the 'name' attribute and the status of the guarantee is in the 'Status.status' attribute. Example service requirements include: 1) If power is not restored within 24 hours, customers can claim $50 for residential customers or $100 for commercial and industrial customers. In addition for each extra period of 12 hours the customer's supply has not been activated, the customer can claim $25. 2) If a customer has a question about their electricity bill, the utility will investigate and respond to the inquiry within 15 working days. If utility fails to meet its guarantee, utility will automatically pay the customer $50."@en;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                     rdfs:label "ServiceGuarantee"@en;
                     rdfs:subClassOf cim:Document;
                     cimdoc:cimPackage "IEC61968.InfIEC61968.InfCustomers";
                     cimdoc:packageTier "Informative".
cim:ServiceGuarantee.applicationPeriod a owl:ObjectProperty;
                                       rdfs:comment "Period in which this service guantee applies."@en;
                                       rdfs:domain cim:ServiceGuarantee;
                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                       rdfs:label "applicationPeriod"@en;
                                       rdfs:range cim:DateTimeInterval.
cim:ServiceGuarantee.automaticPay a owl:DatatypeProperty;
                                  rdfs:comment "True if utility must autmatically pay the specified amount whenever the condition is not satisified, otherwise customer must make a claim to receive payment."@en;
                                  rdfs:domain cim:ServiceGuarantee;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                  rdfs:label "automaticPay"@en;
                                  rdfs:range xsd:boolean.
cim:ServiceGuarantee.payAmount a owl:DatatypeProperty;
                               rdfs:comment "Amount to be paid by the service provider to the customer for each violation of the 'serviceRequirement'."@en;
                               rdfs:domain cim:ServiceGuarantee;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                               rdfs:label "payAmount"@en;
                               rdfs:range cim:Money.
cim:ServiceGuarantee.serviceRequirement a owl:DatatypeProperty;
                                        rdfs:comment "Explanation of the requirement and conditions for satisfying it."@en;
                                        rdfs:domain cim:ServiceGuarantee;
                                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                        rdfs:label "serviceRequirement"@en;
                                        rdfs:range xsd:string.
