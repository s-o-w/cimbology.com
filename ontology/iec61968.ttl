cim:Register.isVirtual a owl:DatatypeProperty;
                       rdfs:comment "If true, the data it produces is calculated or measured by a device other than a physical end device/meter. Otherwise, any data streams it produces are measured by the hardware of the end device/meter itself."@en;
                       rdfs:domain cim:Register;
