                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                            rdfs:label "test"@en;
                            cimdoc:enumCode 3 .
cim:ServiceRequestKind.turnOff a owl:NamedIndividual,
