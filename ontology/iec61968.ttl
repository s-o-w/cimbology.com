                                  rdfs:comment "The location of this hazard."@en;
                                  rdfs:domain cim:AssetLocationHazard;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                                  rdfs:label "Locations"@en;
                                  rdfs:range cim:Location.
cim:AssetLocationHazard.kind a owl:ObjectProperty;
                             rdfs:comment "Kind of hazard."@en;
                             rdfs:domain cim:AssetLocationHazard;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                             rdfs:label "kind"@en;
