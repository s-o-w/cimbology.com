cim:TapChangerInfo.ctRatio a owl:DatatypeProperty;
                           rdfs:comment "Built-in current transducer ratio."@en;
                           rdfs:domain cim:TapChangerInfo;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
                           rdfs:label "ctRatio"@en;
