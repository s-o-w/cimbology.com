cim:Zone a owl:Class;
         rdfs:comment "Area divided off from other areas. It may be part of the electrical network, a land area where special restrictions apply, weather areas, etc. For weather, it is an area where a set of relatively homogenous weather measurements apply."@en;
         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
         rdfs:label "Zone"@en;
         rdfs:subClassOf cim:Location;
         cimdoc:cimPackage "IEC61968.InfIEC61968.InfLocations";
         cimdoc:packageTier "Informative".
cim:Zone.kind a owl:ObjectProperty;
              rdfs:comment "Kind of this zone."@en;
              rdfs:domain cim:Zone;
              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>;
              rdfs:label "kind"@en;
              rdfs:range cim:ZoneKind.
cim:ZoneKind a owl:Class;
