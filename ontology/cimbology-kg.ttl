# Motor loads
cimbology:motorsDemandFactor a owl:DatatypeProperty ;
    rdfs:range xsd:double ;
    rdfs:comment "Demand factor for motor loads (0–1). Separate from motorLoadKw which captures the total motor load for flicker; this factor applies to connected motor load in the detailed breakdown. Typical default: 0.3."@en ;
    rdfs:label "Motors Demand Factor" ;
    rdfs:domain cimbology:ServicePoint .

cimbology:motorsLoad1ph a owl:DatatypeProperty ;
    rdfs:range xsd:double ;
