# =============================================================================
# SECTION 12A: VOLTAGE DROP RESULT PROPERTIES
# =============================================================================
# Voltage drop analysis results that any distribution tool must exchange.
# ANSI C84.1 defines service voltage limits; these properties capture the
# design-stage voltage drop analysis needed to verify compliance.
# =============================================================================

cimbology:vdWireOnlyPct a owl:DatatypeProperty ;
    rdfs:range xsd:double ;
    rdfs:comment "Voltage drop through conductors only (excluding transformer) as a percentage of nominal voltage."@en ;
    rdfs:label "Wire Voltage Drop (%)" ;
    rdfs:domain cimbology:VoltageDropResult .

cimbology:vdWireAndTransformerPct a owl:DatatypeProperty ;
    rdfs:range xsd:double ;
    rdfs:comment "Total voltage drop through conductors plus transformer as a percentage of nominal voltage."@en ;
    rdfs:label "Wire+Transformer Voltage Drop (%)" ;
    rdfs:domain cimbology:VoltageDropResult .

cimbology:flickerWireOnlyPct a owl:DatatypeProperty ;
    rdfs:range xsd:double ;
    rdfs:comment "Flicker (voltage dip from motor starting) through conductors only as a percentage."@en ;
    rdfs:label "Wire Flicker (%)" ;
    rdfs:domain cimbology:VoltageDropResult .

cimbology:flickerWireAndTransformerPct a owl:DatatypeProperty ;
    rdfs:range xsd:double ;
    rdfs:comment "Total flicker through conductors plus transformer as a percentage."@en ;
    rdfs:label "Wire+Transformer Flicker (%)" ;
    rdfs:domain cimbology:VoltageDropResult .

cimbology:faultCurrent a owl:DatatypeProperty ;
    rdfs:range xsd:double ;
    rdfs:comment "Available fault current in amperes. Used in distribution voltage-drop studies (service point fault level) and substation protection coordination (bus fault current). No rdfs:domain declared to allow use across distribution and substation contexts."@en ;
    rdfs:label "Fault Current" ;
    qudt:applicableUnit unit:A ;
    qudt:quantityKind qkind:ElectricCurrent .

cimbology:conductorCurrentValue a owl:DatatypeProperty ;
    rdfs:range xsd:double ;
    rdfs:comment "Per-conductor current value in amperes captured by the voltage-drop solver. Needed to exchange conductor-by-conductor loading alongside the voltage-drop percentages."@en ;
    rdfs:label "Conductor Current Value" ;
    rdfs:domain cimbology:VoltageDropResult ;
    qudt:applicableUnit unit:A ;
    qudt:quantityKind qkind:ElectricCurrent .

cimbology:transformerDemandValue a owl:DatatypeProperty ;
    rdfs:range xsd:double ;
    rdfs:comment "Transformer demand captured in the voltage-drop result set in kilowatts. Needed to exchange the load value actually used in the transformer portion of the study."@en ;
    rdfs:label "Transformer Demand Value" ;
    rdfs:domain cimbology:VoltageDropResult ;
    qudt:applicableUnit unit:KiloW ;
    qudt:quantityKind qkind:Power .

cimbology:vdPhase a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:comment "Phase designation for this voltage drop result (e.g., 'A', 'B', 'C', 'AB', 'ABC')."@en ;
    rdfs:label "VD Phase" ;
    rdfs:domain cimbology:VoltageDropResult .


# =============================================================================
# SECTION 13: ANCHOR AND GUY PROPERTIES
# =============================================================================
# Guying is critical to distribution pole loading — a properly guyed pole can
# handle significantly higher transverse loads. These properties capture the
# guy wire configuration needed for pole loading calculations.
# =============================================================================

cimbology:anchorType a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:comment "Anchor type (e.g., 'expanding', 'screw', 'plate', 'rock', 'swamp', 'log', 'cone', 'rail anchor', 'hinged tie bar', 'traction strut')."@en ;
    rdfs:label "Anchor Type" ;
    rdfs:domain cimbology:AnchorGuy .

cimbology:guyType a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:comment "Guy wire functional type (e.g., 'normal', 'sidewalk', 'stub', 'head', 'brace', 'span', 'arm'). Describes the guy wire role, not the wire specification."@en ;
    rdfs:label "Guy Type" ;
    rdfs:domain cimbology:AnchorGuy .

cimbology:guyAttachmentHeight a owl:DatatypeProperty ;
    rdfs:range xsd:double ;
    rdfs:comment "Height of guy wire attachment on the pole above ground in meters."@en ;
    rdfs:label "Guy Attachment Height" ;
    rdfs:domain cimbology:AnchorGuy ;
    qudt:applicableUnit unit:M ;
    qudt:quantityKind qkind:Length .

cimbology:guyLead a owl:DatatypeProperty ;
    rdfs:range xsd:double ;
    rdfs:comment "Horizontal distance from pole base to anchor point in meters."@en ;
    rdfs:label "Guy Lead" ;
    rdfs:domain cimbology:AnchorGuy ;
    qudt:applicableUnit unit:M ;
    qudt:quantityKind qkind:Length .

cimbology:guyAngle a owl:DatatypeProperty ;
    rdfs:range xsd:double ;
    rdfs:comment "Guy wire angle from horizontal in degrees. Derived from attachment height and lead distance."@en ;
    rdfs:label "Guy Angle" ;
    rdfs:domain cimbology:AnchorGuy ;
    qudt:applicableUnit unit:DEG ;
    qudt:quantityKind qkind:Angle .

cimbology:guyStrength a owl:DatatypeProperty ;
    rdfs:range xsd:double ;
    rdfs:comment "Rated breaking strength of the guy wire in newtons."@en ;
    rdfs:label "Guy Strength" ;
    rdfs:domain cimbology:AnchorGuy ;
    qudt:applicableUnit unit:N ;
    qudt:quantityKind qkind:Force .

cimbology:anchorCapacity a owl:DatatypeProperty ;
    rdfs:range xsd:double ;
    rdfs:comment "Holding capacity of the anchor in newtons based on soil class."@en ;
    rdfs:label "Anchor Capacity" ;
    rdfs:domain cimbology:AnchorGuy ;
    qudt:applicableUnit unit:N ;
    qudt:quantityKind qkind:Force .

cimbology:guyWireCount a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    rdfs:comment "Number of parallel guy wires in this assembly. Some high-load poles require two parallel guys for increased capacity. Needed for guy assembly material takeoff and total assembly strength calculations."@en ;
    rdfs:label "Guy Wire Count" ;
    rdfs:domain cimbology:AnchorGuy .

cimbology:anchorIsDouble a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:comment "True if the anchor consists of two anchor rods or plates (double anchor) providing roughly double the single-anchor holding capacity. Affects anchor adequacy check in pole loading analysis."@en ;
    rdfs:label "Is Double Anchor" ;
    rdfs:domain cimbology:AnchorGuy .

cimbology:anchorMaxTension a owl:DatatypeProperty ;
    rdfs:range xsd:double ;
    rdfs:comment "Maximum rated pullout tension for this anchor assembly in newtons — the manufacturer's catalog capacity at standard soil class. Distinct from cimbology:anchorCapacity (domain: cimbology:GuyingResult) which is the computed soil-specific holding capacity for a specific installation."@en ;
    rdfs:label "Anchor Max Tension" ;
    rdfs:domain cimbology:AnchorGuy ;
    qudt:applicableUnit unit:N ;
    qudt:quantityKind qkind:Force .

# =============================================================================
# SECTION 14: PROVENANCE PROPERTIES
# =============================================================================
# Provenance is a DOMAIN concern — the PE-stamp audit trail belongs to the
# distribution engineering domain, not any specific application. Same pattern
# as TIF provenance.
# =============================================================================

cimbology:provenanceTier a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:comment "Data confidence tier (e.g., 'Survey', 'GIS', 'Assumed', 'Calculated', 'PE-Verified'). Indicates the reliability of the associated property values. Applies to any CIMBOLOGY-KG data regardless of source tool."@en ;
    rdfs:label "Provenance Tier" .

cimbology:provenanceCitation a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:comment "Source citation for the data (e.g., 'Field survey 2024-03-15', 'GIS export v2.1', 'NESC Table 232-1'). Applies to any CIMBOLOGY-KG data regardless of source tool."@en ;
    rdfs:label "Provenance Citation" .

cimbology:provenanceSetterInitials a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:comment "Initials of the engineer who set or verified this value. Part of the PE-stamp audit trail. Applies to any CIMBOLOGY-KG data regardless of source tool."@en ;
    rdfs:label "Provenance Setter" .

cimbology:provenanceDate a owl:DatatypeProperty ;
    rdfs:range xsd:date ;
    rdfs:comment "Date when this value was set or last verified. Applies to any CIMBOLOGY-KG data regardless of source tool."@en ;
    rdfs:label "Provenance Date" .
