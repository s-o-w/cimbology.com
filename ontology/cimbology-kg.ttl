    rdfs:range xsd:double ;
    rdfs:comment "Fraction of daily operating hours motors run (0–1). Typical default: 0.5."@en ;
    rdfs:label "Motors % Opr Hours" ;
    rdfs:domain cimbology:ServicePoint .

