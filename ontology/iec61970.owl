    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#AltGeneratingUnitMeas.AnalogValue">
    <rdfs:comment xml:lang="en">The specific analog value used as a source.</rdfs:comment>
