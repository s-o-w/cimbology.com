    <rdfs:comment xml:lang="en">The construction kind of the potential transformer.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">PotentialTransformerKind</rdfs:label>
