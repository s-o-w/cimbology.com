  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#GovCT2.kpload">
    <rdfs:comment xml:lang="en">Load limiter proportional gain for PI controller (Kpload). Typical value = 1.</rdfs:comment>
