  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ExcST6B.vmult">
    <rdfs:comment xml:lang="en">Selector (vmult). true = multiply regulator output by terminal voltage false = do not multiply regulator output by terminal voltage. Typical value = true.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ExcST6B" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
