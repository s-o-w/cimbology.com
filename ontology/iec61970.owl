    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#WindQcontrolModeKind" />
    <rdfs:comment xml:lang="en">Open loop reactive power control (only used with closed loop at plant level) (MqG equals 2).</rdfs:comment>
