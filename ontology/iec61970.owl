  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ExcSK.kgob">
    <rdfs:comment xml:lang="en">P controller gain (Kgob). Typical value = 10.</rdfs:comment>
