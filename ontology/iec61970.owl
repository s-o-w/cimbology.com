    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">m_IdcInverterControl</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#IdcInverterControl" />
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#VSCDynamics">
    <rdfs:comment xml:lang="en">VSC function block whose behaviour is described by reference to a standard model or by definition of a user-defined model.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">VSCDynamics</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#HVDCDynamics" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Dynamics.StandardModels.HVDCDynamics</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#VSCDynamics.VsConverter">
    <rdfs:comment xml:lang="en">Voltage source converter to which voltage source converter dynamics model applies.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#VSCDynamics" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">VsConverter</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#VsConverter" />
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#VSCUserDefined">
    <rdfs:comment xml:lang="en">Voltage source converter (VSC) function block whose dynamic behaviour is described by a user-defined model.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">VSCUserDefined</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#VSCDynamics" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Dynamics.UserDefinedModels</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#VSCUserDefined.ProprietaryParameterDynamics">
    <rdfs:comment xml:lang="en">Parameter of this proprietary user-defined model.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#VSCUserDefined" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">ProprietaryParameterDynamics</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#ProprietaryParameterDynamics" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#VSCUserDefined.proprietary">
    <rdfs:comment xml:lang="en">Behaviour is based on a proprietary model as opposed to a detailed model. true = user-defined model is proprietary with behaviour mutually understood by sending and receiving applications and parameters passed as general attributes false = user-defined model is explicitly defined in terms of control blocks and their input and output signals.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#VSCUserDefined" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">proprietary</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#VSCtype1">
    <rdfs:comment xml:lang="en">The vs ctype class</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">VSCtype1</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#VSCDynamics" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Dynamics.StandardModels.InfHVDCDynamics.VSC</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Informative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#VSCtype1.DCvoltageControl">
    <rdfs:comment xml:lang="en">The cvoltage control</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#VSCtype1" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">DCvoltageControl</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#DCvoltageControl" />
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#Validity">
    <rdfs:comment xml:lang="en">Validity for MeasurementValue.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">Validity</rdfs:label>
    <owl:equivalentClass rdf:nodeID="oneOfClass_Validity" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.Meas</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#Validity.GOOD">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#Validity" />
    <rdfs:comment xml:lang="en">The value is marked good if no abnormal condition of the acquisition function or the information source is detected.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">GOOD</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#Validity.INVALID">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#Validity" />
    <rdfs:comment xml:lang="en">The value is marked invalid when a supervision function recognises abnormal conditions of the acquisition function or the information source (missing or non-operating updating devices). The value is not defined under this condition. The mark invalid is used to indicate to the client that the value may be incorrect and shall not be used.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">INVALID</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#Validity.QUESTIONABLE">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#Validity" />
    <rdfs:comment xml:lang="en">The value is marked questionable if a supervision function detects an abnormal behaviour, however the value could still be valid. The client is responsible for determining whether or not values marked "questionable" should be used.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">QUESTIONABLE</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#ValueAliasSet">
    <rdfs:comment xml:lang="en">Describes the translation of a set of values into a name and is intendend to facilitate custom translations. Each ValueAliasSet has a name, description etc. A specific Measurement may represent a discrete state like Open, Closed, Intermediate etc. This requires a translation from the MeasurementValue.value number to a string, e.g. 0-&gt;"Invalid", 1-&gt;"Open", 2-&gt;"Closed", 3- &gt;"Intermediate". Each ValueToAlias member in ValueAliasSet.Value describe a mapping for one particular value to a name.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">ValueAliasSet</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#IdentifiedObject" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.Meas</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#ValueAliasSet.Discretes">
    <rdfs:comment xml:lang="en">The Measurements using the set for translation.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ValueAliasSet" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">Discretes</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Discrete" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#ValueAliasSet.Values">
    <rdfs:comment xml:lang="en">The ValueToAlias mappings included in the set.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ValueAliasSet" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">Values</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#ValueToAlias" />
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#ValueToAlias">
    <rdfs:comment xml:lang="en">Describes the translation of one particular value into a name, e.g. 1 as "Open".</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">ValueToAlias</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#IdentifiedObject" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.Meas</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ValueToAlias.value">
    <rdfs:comment xml:lang="en">The value that is mapped.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ValueToAlias" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">value</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#VisibilityLayer">
    <rdfs:comment xml:lang="en">Layers are typically used for grouping diagram objects according to themes and scales. Themes are used to display or hide certain information (e.g., lakes, borders), while scales are used for hiding or displaying information depending on the current zoom level (hide text when it is too small to be read, or when it exceeds the screen size). This is also called de-cluttering. CIM based graphics exchange supports an m:n relationship between diagram objects and layers. The importing system shall convert an m:n case into an appropriate 1:n representation if the importing system does not support m:n.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">VisibilityLayer</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#IdentifiedObject" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.DiagramLayout</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#VisibilityLayer.drawingOrder">
    <rdfs:comment xml:lang="en">The drawing order for this layer. The higher the number, the later the layer and the objects within it are rendered.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#VisibilityLayer" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">drawingOrder</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer" />
  </owl:DatatypeProperty>
  <rdfs:Datatype rdf:about="http://iec.ch/TC57/CIM100#Voltage">
    <rdfs:comment xml:lang="en">Electrical voltage, can be both AC and DC.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">Voltage</rdfs:label>
    <owl:equivalentClass rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.Domain</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
    <cimdoc:unitSymbol rdf:resource="http://iec.ch/TC57/CIM100#UnitSymbol.V" />
  </rdfs:Datatype>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#VoltageAdjusterDynamics">
    <rdfs:comment xml:lang="en">Voltage adjuster function block whose behaviour is described by reference to a standard model or by definition of a user-defined model.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">VoltageAdjusterDynamics</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#DynamicsFunctionBlock" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Dynamics.StandardModels.VoltageAdjusterDynamics</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#VoltageAdjusterDynamics.PFVArControllerType1Dynamics">
    <rdfs:comment xml:lang="en">Power factor or VAr controller type 1 model with which this voltage adjuster is associated.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#VoltageAdjusterDynamics" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">PFVArControllerType1Dynamics</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PFVArControllerType1Dynamics" />
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#VoltageAdjusterUserDefined">
    <rdfs:comment xml:lang="en">Voltage adjuster function block whose dynamic behaviour is described by a user-defined model.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">VoltageAdjusterUserDefined</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#VoltageAdjusterDynamics" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Dynamics.UserDefinedModels</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#VoltageAdjusterUserDefined.proprietary">
    <rdfs:comment xml:lang="en">Behaviour is based on a proprietary model as opposed to a detailed model. true = user-defined model is proprietary with behaviour mutually understood by sending and receiving applications and parameters passed as general attributes false = user-defined model is explicitly defined in terms of control blocks and their input and output signals.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#VoltageAdjusterUserDefined" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">proprietary</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#VoltageCompensatorDynamics">
    <rdfs:comment xml:lang="en">Voltage compensator function block whose behaviour is described by reference to a standard model or by definition of a user-defined model.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">VoltageCompensatorDynamics</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#DynamicsFunctionBlock" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Dynamics.StandardModels.VoltageCompensatorDynamics</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#VoltageCompensatorDynamics.PFVArControllerType2Dynamics">
    <rdfs:comment xml:lang="en">Power factor or VAr controller type 2 model with which this voltage compensator is associated.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#VoltageCompensatorDynamics" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">PFVArControllerType2Dynamics</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PFVArControllerType2Dynamics" />
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#VoltageCompensatorUserDefined">
    <rdfs:comment xml:lang="en">Voltage compensator function block whose dynamic behaviour is described by a user-defined model.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">VoltageCompensatorUserDefined</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#VoltageCompensatorDynamics" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Dynamics.UserDefinedModels</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#VoltageCompensatorUserDefined.proprietary">
    <rdfs:comment xml:lang="en">Behaviour is based on a proprietary model as opposed to a detailed model. true = user-defined model is proprietary with behaviour mutually understood by sending and receiving applications and parameters passed as general attributes false = user-defined model is explicitly defined in terms of control blocks and their input and output signals.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#VoltageCompensatorUserDefined" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">proprietary</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#VoltageControlZone">
    <rdfs:comment xml:lang="en">An area of the power system network which is defined for secondary voltage control purposes. A voltage control zone consists of a collection of substations with a designated bus bar section whose voltage will be controlled.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">VoltageControlZone</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#PowerSystemResource" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.Wires</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#VoltageLevel">
    <rdfs:comment xml:lang="en">A collection of equipment at one common system voltage forming a switchgear. The equipment typically consists of breakers, busbars, instrumentation, control, regulation and protection devices as well as assemblies of all these.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">VoltageLevel</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#EquipmentContainer" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.Core</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#VoltageLevel.BaseVoltage">
    <rdfs:comment xml:lang="en">The base voltage used for all equipment within the voltage level.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#VoltageLevel" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">BaseVoltage</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#BaseVoltage" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#VoltageLevel.Bays">
    <rdfs:comment xml:lang="en">The bays within this voltage level.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#VoltageLevel" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">Bays</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Bay" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#VoltageLevel.highVoltageLimit">
    <rdfs:comment xml:lang="en">The bus bar's high voltage limit. The limit applies to all equipment and nodes contained in a given VoltageLevel. It is not required that it is exchanged in pair with lowVoltageLimit. It is preferable to use operational VoltageLimit, which prevails, if present.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#VoltageLevel" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">highVoltageLimit</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Voltage" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#VoltageLevel.lowVoltageLimit">
    <rdfs:comment xml:lang="en">The bus bar's low voltage limit. The limit applies to all equipment and nodes contained in a given VoltageLevel. It is not required that it is exchanged in pair with highVoltageLimit. It is preferable to use operational VoltageLimit, which prevails, if present.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#VoltageLevel" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">lowVoltageLimit</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Voltage" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#VoltageLimit">
    <rdfs:comment xml:lang="en">Operational limit applied to voltage. The use of operational VoltageLimit is preferred instead of limits defined at VoltageLevel. The operational VoltageLimits are used, if present.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">VoltageLimit</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#OperationalLimit" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.OperationalLimits</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#VoltageLimit.normalValue">
    <rdfs:comment xml:lang="en">The normal limit on voltage. High or low limit nature of the limit depends upon the properties of the operational limit type. The attribute shall be a positive value or zero.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#VoltageLimit" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">normalValue</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Voltage" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#VoltageLimit.value">
    <rdfs:comment xml:lang="en">Limit on voltage. High or low limit nature of the limit depends upon the properties of the operational limit type. The attribute shall be a positive value or zero.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#VoltageLimit" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">value</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Voltage" />
  </owl:DatatypeProperty>
  <rdfs:Datatype rdf:about="http://iec.ch/TC57/CIM100#VoltagePerReactivePower">
    <rdfs:comment xml:lang="en">Voltage variation with reactive power.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">VoltagePerReactivePower</rdfs:label>
    <owl:equivalentClass rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.Domain</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
    <cimdoc:unitSymbol rdf:resource="http://iec.ch/TC57/CIM100#UnitSymbol.VPerVAr" />
  </rdfs:Datatype>
  <rdfs:Datatype rdf:about="http://iec.ch/TC57/CIM100#Volume">
    <rdfs:comment xml:lang="en">Volume.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">Volume</rdfs:label>
    <owl:equivalentClass rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.Domain</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
    <cimdoc:unitSymbol rdf:resource="http://iec.ch/TC57/CIM100#UnitSymbol.m3" />
  </rdfs:Datatype>
  <rdfs:Datatype rdf:about="http://iec.ch/TC57/CIM100#VolumeFlowRate">
    <rdfs:comment xml:lang="en">Volume per time.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">VolumeFlowRate</rdfs:label>
    <owl:equivalentClass rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.Domain</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
    <cimdoc:unitMultiplier rdf:resource="http://iec.ch/TC57/CIM100#UnitMultiplier.none" />
    <cimdoc:unitSymbol rdf:resource="http://iec.ch/TC57/CIM100#UnitSymbol.m3Pers" />
  </rdfs:Datatype>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#VsCapabilityCurve">
    <rdfs:comment xml:lang="en">The P-Q capability curve for a voltage source converter, with P on X-axis and Qmin and Qmax on Y1-axis and Y2-axis.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">VsCapabilityCurve</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#Curve" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.DC</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#VsConverter">
    <rdfs:comment xml:lang="en">DC side of the voltage source converter (VSC).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">VsConverter</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#ACDCConverter" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.DC</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#VsConverter.CapabilityCurve">
    <rdfs:comment xml:lang="en">Capability curve of this converter.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#VsConverter" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">CapabilityCurve</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#VsCapabilityCurve" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#VsConverter.delta">
    <rdfs:comment xml:lang="en">Angle between VsConverter.uv and ACDCConverter.uc. It is converter�s state variable used in power flow. The attribute shall be a positive value or zero.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#VsConverter" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">delta</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#AngleDegrees" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#VsConverter.droop">
    <rdfs:comment xml:lang="en">Droop constant. The pu value is obtained as D [kV/MW] x Sb / Ubdc. The attribute shall be a positive value.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#VsConverter" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">droop</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#VsConverter.droopCompensation">
    <rdfs:comment xml:lang="en">Compensation constant. Used to compensate for voltage drop when controlling voltage at a distant bus. The attribute shall be a positive value.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#VsConverter" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">droopCompensation</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Resistance" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#VsConverter.maxModulationIndex">
    <rdfs:comment xml:lang="en">The maximum quotient between the AC converter voltage (Uc) and DC voltage (Ud). A factor typically less than 1. It is converter�s configuration data used in power flow.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#VsConverter" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">maxModulationIndex</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#VsConverter.maxValveCurrent">
    <rdfs:comment xml:lang="en">The maximum current through a valve. It is converter�s configuration data.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#VsConverter" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">maxValveCurrent</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#CurrentFlow" />
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#VsConverter.pPccControl">
    <rdfs:comment xml:lang="en">Kind of control of real power and/or DC voltage.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#VsConverter" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">pPccControl</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#VsPpccControlKind" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#VsConverter.qPccControl">
    <rdfs:comment xml:lang="en">Kind of reactive power control.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#VsConverter" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">qPccControl</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#VsQpccControlKind" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#VsConverter.qShare">
    <rdfs:comment xml:lang="en">Reactive power sharing factor among parallel converters on Uac control. The attribute shall be a positive value or zero.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#VsConverter" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">qShare</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PerCent" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#VsConverter.targetPWMfactor">
    <rdfs:comment xml:lang="en">Magnitude of pulse-modulation factor. The attribute shall be a positive value.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#VsConverter" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">targetPWMfactor</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#VsConverter.targetPhasePcc">
    <rdfs:comment xml:lang="en">Phase target at AC side, at point of common coupling. The attribute shall be a positive value.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#VsConverter" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">targetPhasePcc</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#AngleDegrees" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#VsConverter.targetPowerFactorPcc">
    <rdfs:comment xml:lang="en">Power factor target at the AC side, at point of common coupling. The attribute shall be a positive value.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#VsConverter" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">targetPowerFactorPcc</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#VsConverter.targetQpcc">
    <rdfs:comment xml:lang="en">Reactive power injection target in AC grid, at point of common coupling. Load sign convention is used, i.e. positive sign means flow out from a node.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#VsConverter" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">targetQpcc</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#ReactivePower" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#VsConverter.targetUpcc">
    <rdfs:comment xml:lang="en">Voltage target in AC grid, at point of common coupling. The attribute shall be a positive value.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#VsConverter" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">targetUpcc</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Voltage" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#VsConverter.uv">
    <rdfs:comment xml:lang="en">Line-to-line voltage on the valve side of the converter transformer. It is converter�s state variable, result from power flow. The attribute shall be a positive value.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#VsConverter" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">uv</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Voltage" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#VsPpccControlKind">
    <rdfs:comment xml:lang="en">Types applicable to the control of real power and/or DC voltage by voltage source converter.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">VsPpccControlKind</rdfs:label>
    <owl:equivalentClass rdf:nodeID="oneOfClass_VsPpccControlKind" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.DC</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#VsPpccControlKind.pPcc">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#VsPpccControlKind" />
    <rdfs:comment xml:lang="en">Control is real power at point of common coupling. The target value is provided by ACDCConverter.targetPpcc.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">pPcc</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#VsPpccControlKind.pPccAndUdcDroop">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#VsPpccControlKind" />
    <rdfs:comment xml:lang="en">Control is active power at point of common coupling and local DC voltage, with the droop. Target values are provided by ACDCConverter.targetPpcc, ACDCConverter.targetUdc and VsConverter.droop.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">pPccAndUdcDroop</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#VsPpccControlKind.pPccAndUdcDroopPilot">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#VsPpccControlKind" />
    <rdfs:comment xml:lang="en">Control is active power at point of common coupling and the pilot DC voltage, with the droop. The mode is used for Multi Terminal High Voltage DC (MTDC) systems where multiple HVDC Substations are connected to the HVDC transmission lines. The pilot voltage is then used to coordinate the control the DC voltage across the HVDC substations. Targets are provided by ACDCConverter.targetPpcc, ACDCConverter.targetUdc and VsConverter.droop.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">pPccAndUdcDroopPilot</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#VsPpccControlKind.pPccAndUdcDroopWithCompensation">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#VsPpccControlKind" />
    <rdfs:comment xml:lang="en">Control is active power at point of common coupling and compensated DC voltage, with the droop. Compensation factor is the resistance, as an approximation of the DC voltage of a common (real or virtual) node in the DC network. Targets are provided by ACDCConverter.targetPpcc, ACDCConverter.targetUdc, VsConverter. droop and VsConverter.droopCompensation.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">pPccAndUdcDroopWithCompensation</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#VsPpccControlKind.phasePcc">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#VsPpccControlKind" />
    <rdfs:comment xml:lang="en">Control is phase at point of common coupling. Target is provided by VsConverter. targetPhasePcc.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">phasePcc</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#VsPpccControlKind.udc">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#VsPpccControlKind" />
    <rdfs:comment xml:lang="en">Control is DC voltage with target value provided by ACDCConverter.targetUdc.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">udc</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#VsQpccControlKind">
    <rdfs:comment xml:lang="en">Kind of reactive power control at point of common coupling for a voltage source converter.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">VsQpccControlKind</rdfs:label>
    <owl:equivalentClass rdf:nodeID="oneOfClass_VsQpccControlKind" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.DC</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#VsQpccControlKind.powerFactorPcc">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#VsQpccControlKind" />
    <rdfs:comment xml:lang="en">Control is power factor at point of common coupling. Target is provided by VsConverter.targetPowerFactorPcc.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">powerFactorPcc</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#VsQpccControlKind.pulseWidthModulation">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#VsQpccControlKind" />
    <rdfs:comment xml:lang="en">No explicit control. Pulse-modulation factor is directly set in magnitude (VsConverter.targetPWMfactor) and phase (VsConverter.targetPhasePcc).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">pulseWidthModulation</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#VsQpccControlKind.reactivePcc">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#VsQpccControlKind" />
    <rdfs:comment xml:lang="en">Control is reactive power at point of common coupling. Target is provided by VsConverter.targetQpcc.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">reactivePcc</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#VsQpccControlKind.voltagePcc">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#VsQpccControlKind" />
    <rdfs:comment xml:lang="en">Control is voltage at point of common coupling. Target is provided by VsConverter.targetUpcc.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">voltagePcc</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</cimdoc:enumCode>
  </owl:NamedIndividual>
  <rdfs:Datatype rdf:about="http://iec.ch/TC57/CIM100#WaterLevel">
    <rdfs:comment xml:lang="en">Reservoir water level referred to a given datum such as mean sea level.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">WaterLevel</rdfs:label>
    <owl:equivalentClass rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.Domain</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
    <cimdoc:unitSymbol rdf:resource="http://iec.ch/TC57/CIM100#UnitSymbol.m" />
  </rdfs:Datatype>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#WaveTrap">
    <rdfs:comment xml:lang="en">Line traps are devices that impede high frequency power line carrier signals yet present a negligible impedance at the main power frequency.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">WaveTrap</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#AuxiliaryEquipment" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.AuxiliaryEquipment</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#WeatherStation">
    <rdfs:comment xml:lang="en">This represents a source of ambient temperature.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">WeatherStation</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#PowerSystemResource" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.InfIEC61970.InfOperationalLimits</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Informative</cimdoc:packageTier>
  </owl:Class>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#WindAeroConstIEC">
    <rdfs:comment xml:lang="en">Constant aerodynamic torque model which assumes that the aerodynamic torque is constant. Reference: IEC 61400-27-1:2015, 5.6.1.1.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">WindAeroConstIEC</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#IdentifiedObject" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Dynamics.StandardModels.WindDynamics</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#WindAeroConstIEC.WindGenTurbineType1aIEC">
    <rdfs:comment xml:lang="en">Wind turbine type 1A model with which this wind aerodynamic model is associated.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#WindAeroConstIEC" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">WindGenTurbineType1aIEC</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#WindGenTurbineType1aIEC" />
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#WindAeroOneDimIEC">
    <rdfs:comment xml:lang="en">One-dimensional aerodynamic model. Reference: IEC 61400-27-1:2015, 5.6.1.2.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">WindAeroOneDimIEC</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#IdentifiedObject" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Dynamics.StandardModels.WindDynamics</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#WindAeroOneDimIEC.WindTurbineType3IEC">
    <rdfs:comment xml:lang="en">Wind turbine type 3 model with which this wind aerodynamic model is associated.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#WindAeroOneDimIEC" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">WindTurbineType3IEC</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#WindTurbineType3IEC" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#WindAeroOneDimIEC.ka">
    <rdfs:comment xml:lang="en">Aerodynamic gain (ka). It is a type-dependent parameter.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#WindAeroOneDimIEC" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">ka</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#WindAeroOneDimIEC.thetaomega">
    <rdfs:comment xml:lang="en">Initial pitch angle (thetaomega0). It is a case- dependent parameter.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#WindAeroOneDimIEC" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">thetaomega</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#AngleDegrees" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#WindAeroTwoDimIEC">
    <rdfs:comment xml:lang="en">Two-dimensional aerodynamic model. Reference: IEC 61400-27-1:2015, 5.6.1.3.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">WindAeroTwoDimIEC</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#IdentifiedObject" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Dynamics.StandardModels.WindDynamics</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#WindAeroTwoDimIEC.WindTurbineType3IEC">
    <rdfs:comment xml:lang="en">Wind turbine type 3 model with which this wind aerodynamic model is associated.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#WindAeroTwoDimIEC" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">WindTurbineType3IEC</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#WindTurbineType3IEC" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#WindAeroTwoDimIEC.dpomega">
    <rdfs:comment xml:lang="en">Partial derivative of aerodynamic power with respect to changes in WTR speed (dpomega). It is a type-dependent parameter.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#WindAeroTwoDimIEC" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">dpomega</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#WindAeroTwoDimIEC.dptheta">
    <rdfs:comment xml:lang="en">Partial derivative of aerodynamic power with respect to changes in pitch angle (dptheta). It is a type-dependent parameter.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#WindAeroTwoDimIEC" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">dptheta</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#WindAeroTwoDimIEC.dpv1">
    <rdfs:comment xml:lang="en">Partial derivative (dpv1). It is a type-dependent parameter.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#WindAeroTwoDimIEC" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">dpv1</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#WindAeroTwoDimIEC.omegazero">
    <rdfs:comment xml:lang="en">Rotor speed if the wind turbine is not derated (omega0). It is a type-dependent parameter.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#WindAeroTwoDimIEC" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">omegazero</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#WindAeroTwoDimIEC.pavail">
    <rdfs:comment xml:lang="en">Available aerodynamic power (pavail). It is a case-dependent parameter.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#WindAeroTwoDimIEC" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">pavail</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#WindAeroTwoDimIEC.thetav2">
    <rdfs:comment xml:lang="en">Blade angle at twice rated wind speed (thetav2). It is a type-dependent parameter.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#WindAeroTwoDimIEC" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">thetav2</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#AngleDegrees" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#WindAeroTwoDimIEC.thetazero">
    <rdfs:comment xml:lang="en">Pitch angle if the wind turbine is not derated (theta0). It is a case-dependent parameter.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#WindAeroTwoDimIEC" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">thetazero</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#AngleDegrees" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#WindContCurrLimIEC">
    <rdfs:comment xml:lang="en">Current limitation model. The current limitation model combines the physical limits and the control limits. Reference: IEC 61400-27-1:2015, 5.6.5.8.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">WindContCurrLimIEC</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#IdentifiedObject" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Dynamics.StandardModels.WindDynamics</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#WindContCurrLimIEC.WindTurbineType3or4IEC">
    <rdfs:comment xml:lang="en">Wind turbine type 3 or type 4 model with which this wind control current limitation model is associated.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#WindContCurrLimIEC" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">WindTurbineType3or4IEC</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#WindTurbineType3or4IEC" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#WindContCurrLimIEC.imax">
    <rdfs:comment xml:lang="en">Maximum continuous current at the wind turbine terminals (imax). It is a type-dependent parameter.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#WindContCurrLimIEC" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">imax</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#WindContCurrLimIEC.imaxdip">
    <rdfs:comment xml:lang="en">Maximum current during voltage dip at the wind turbine terminals (imaxdip). It is a project-dependent parameter.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#WindContCurrLimIEC" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">imaxdip</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#WindContCurrLimIEC.kpqu">
    <rdfs:comment xml:lang="en">Partial derivative of reactive current limit (Kpqu) versus voltage. It is a type-dependent parameter.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#WindContCurrLimIEC" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">kpqu</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#WindContCurrLimIEC.mdfslim">
    <rdfs:comment xml:lang="en">Limitation of type 3 stator current (MDFSLim). MDFSLim = 1 for wind turbines type 4. It is a type-dependent parameter. false= total current limitation (0 in the IEC model) true=stator current limitation (1 in the IEC model).</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#WindContCurrLimIEC" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">mdfslim</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#WindContCurrLimIEC.mqpri">
    <rdfs:comment xml:lang="en">Prioritisation of Q control during UVRT (Mqpri). It is a project-dependent parameter. true = reactive power priority (1 in the IEC model) false = active power priority (0 in the IEC model).</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#WindContCurrLimIEC" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">mqpri</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#WindContCurrLimIEC.tufiltcl">
    <rdfs:comment xml:lang="en">Voltage measurement filter time constant (Tufiltcl) (&gt;= 0). It is a type-dependent parameter.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#WindContCurrLimIEC" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">tufiltcl</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Seconds" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#WindContCurrLimIEC.upqumax">
    <rdfs:comment xml:lang="en">Wind turbine voltage in the operation point where zero reactive current can be delivered (upqumax). It is a type-dependent parameter.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#WindContCurrLimIEC" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">upqumax</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#WindContPType3IEC">
    <rdfs:comment xml:lang="en">P control model type 3. Reference: IEC 61400-27-1:2015, 5.6.5.4.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">WindContPType3IEC</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#IdentifiedObject" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Dynamics.StandardModels.WindDynamics</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#WindContPType3IEC.WindTurbineType3IEC">
    <rdfs:comment xml:lang="en">Wind turbine type 3 model with which this wind control P type 3 model is associated.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#WindContPType3IEC" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">WindTurbineType3IEC</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#WindTurbineType3IEC" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#WindContPType3IEC.dpmax">
    <rdfs:comment xml:lang="en">Maximum wind turbine power ramp rate (dpmax). It is a type-dependent parameter.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#WindContPType3IEC" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">dpmax</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#WindContPType3IEC.dprefmax">
    <rdfs:comment xml:lang="en">Maximum ramp rate of wind turbine reference power (dprefmax). It is a project-dependent parameter.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#WindContPType3IEC" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">dprefmax</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#WindContPType3IEC.dprefmin">
    <rdfs:comment xml:lang="en">Minimum ramp rate of wind turbine reference power (dprefmin). It is a project-dependent parameter.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#WindContPType3IEC" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">dprefmin</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#WindContPType3IEC.dthetamax">
    <rdfs:comment xml:lang="en">Ramp limitation of torque, required in some grid codes (dtmax). It is a project-dependent parameter.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#WindContPType3IEC" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">dthetamax</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#WindContPType3IEC.dthetamaxuvrt">
    <rdfs:comment xml:lang="en">Limitation of torque rise rate during UVRT (dthetamaxUVRT). It is a project-dependent parameter.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#WindContPType3IEC" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">dthetamaxuvrt</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#WindContPType3IEC.kdtd">
    <rdfs:comment xml:lang="en">Gain for active drive train damping (KDTD). It is a type-dependent parameter.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#WindContPType3IEC" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">kdtd</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#WindContPType3IEC.kip">
    <rdfs:comment xml:lang="en">PI controller integration parameter (KIp). It is a type- dependent parameter.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#WindContPType3IEC" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">kip</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#WindContPType3IEC.kpp">
    <rdfs:comment xml:lang="en">PI controller proportional gain (KPp). It is a type-dependent parameter.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#WindContPType3IEC" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">kpp</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#WindContPType3IEC.mpuvrt">
    <rdfs:comment xml:lang="en">Enable UVRT power control mode (MpUVRT). It is a project-dependent parameter. true = voltage control (1 in the IEC model) false = reactive power control (0 in the IEC model).</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#WindContPType3IEC" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">mpuvrt</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#WindContPType3IEC.omegadtd">
    <rdfs:comment xml:lang="en">Active drive train damping frequency (omegaDTD). It can be calculated from two mass model parameters. It is a type-dependent parameter.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#WindContPType3IEC" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">omegadtd</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#WindContPType3IEC.omegaoffset">
    <rdfs:comment xml:lang="en">Offset to reference value that limits controller action during rotor speed changes (omegaoffset). It is a case-dependent parameter.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#WindContPType3IEC" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">omegaoffset</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#WindContPType3IEC.pdtdmax">
    <rdfs:comment xml:lang="en">Maximum active drive train damping power (pDTDmax). It is a type-dependent parameter.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#WindContPType3IEC" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">pdtdmax</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#WindContPType3IEC.tdvs">
    <rdfs:comment xml:lang="en">Time delay after deep voltage sags (TDVS) (&gt;= 0). It is a project-dependent parameter.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#WindContPType3IEC" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">tdvs</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Seconds" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#WindContPType3IEC.thetaemin">
    <rdfs:comment xml:lang="en">Minimum electrical generator torque (temin). It is a type- dependent parameter.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#WindContPType3IEC" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">thetaemin</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#WindContPType3IEC.thetauscale">
    <rdfs:comment xml:lang="en">Voltage scaling factor of reset-torque (tuscale). It is a project-dependent parameter.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#WindContPType3IEC" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">thetauscale</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#WindContPType3IEC.tomegafiltp3">
    <rdfs:comment xml:lang="en">Filter time constant for generator speed measurement (Tomegafiltp3) (&gt;= 0). It is a type-dependent parameter.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#WindContPType3IEC" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">tomegafiltp3</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Seconds" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#WindContPType3IEC.tomegaref">
    <rdfs:comment xml:lang="en">Time constant in speed reference filter (Tomega,ref) (&gt;= 0). It is a type-dependent parameter.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#WindContPType3IEC" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">tomegaref</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Seconds" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#WindContPType3IEC.tpfiltp3">
    <rdfs:comment xml:lang="en">Filter time constant for power measurement (Tpfiltp3) (&gt;= 0). It is a type-dependent parameter.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#WindContPType3IEC" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">tpfiltp3</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Seconds" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#WindContPType3IEC.tpord">
    <rdfs:comment xml:lang="en">Time constant in power order lag (Tpord). It is a type- dependent parameter.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#WindContPType3IEC" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">tpord</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#WindContPType3IEC.tufiltp3">
    <rdfs:comment xml:lang="en">Filter time constant for voltage measurement (Tufiltp3) (&gt;= 0). It is a type-dependent parameter.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#WindContPType3IEC" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">tufiltp3</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Seconds" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#WindContPType3IEC.udvs">
    <rdfs:comment xml:lang="en">Voltage limit for hold UVRT status after deep voltage sags (uDVS). It is a project-dependent parameter.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#WindContPType3IEC" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">udvs</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#WindContPType3IEC.updip">
    <rdfs:comment xml:lang="en">Voltage dip threshold for P-control (uPdip). Part of turbine control, often different (e.g 0.8) from converter thresholds. It is a project- dependent parameter.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#WindContPType3IEC" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">updip</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#WindContPType3IEC.zeta">
    <rdfs:comment xml:lang="en">Coefficient for active drive train damping (zeta). It is a type- dependent parameter.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#WindContPType3IEC" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">zeta</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#WindContPType4aIEC">
    <rdfs:comment xml:lang="en">P control model type 4A. Reference: IEC 61400-27-1:2015, 5.6.5.5.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">WindContPType4aIEC</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#IdentifiedObject" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Dynamics.StandardModels.WindDynamics</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#WindContPType4aIEC.WindTurbineType4aIEC">
    <rdfs:comment xml:lang="en">Wind turbine type 4A model with which this wind control P type 4A model is associated.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#WindContPType4aIEC" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">WindTurbineType4aIEC</rdfs:label>
