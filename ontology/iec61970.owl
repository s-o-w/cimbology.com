  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#MechLoad1">
    <rdfs:comment xml:lang="en">Mechanical load model type 1.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">MechLoad1</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#MechanicalLoadDynamics" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Dynamics.StandardModels.MechanicalLoadDynamics</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#MechLoad1.a">
    <rdfs:comment xml:lang="en">Speed squared coefficient (a).</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#MechLoad1" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">a</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#MechLoad1.b">
    <rdfs:comment xml:lang="en">Speed coefficient (b).</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#MechLoad1" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">b</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#MechLoad1.d">
    <rdfs:comment xml:lang="en">Speed to the exponent coefficient (d).</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#MechLoad1" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">d</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#MechLoad1.e">
    <rdfs:comment xml:lang="en">Exponent (e).</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#MechLoad1" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">e</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#MechanicalLoadDynamics">
    <rdfs:comment xml:lang="en">Mechanical load function block whose behaviour is described by reference to a standard model or by definition of a user-defined model.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">MechanicalLoadDynamics</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#DynamicsFunctionBlock" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Dynamics.StandardModels.MechanicalLoadDynamics</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#MechanicalLoadDynamics.AsynchronousMachineDynamics">
    <rdfs:comment xml:lang="en">Asynchronous machine model with which this mechanical load model is associated. MechanicalLoadDynamics shall have either an association to SynchronousMachineDynamics or to AsynchronousMachineDynamics.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#MechanicalLoadDynamics" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">AsynchronousMachineDynamics</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#AsynchronousMachineDynamics" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#MechanicalLoadDynamics.SynchronousMachineDynamics">
    <rdfs:comment xml:lang="en">Synchronous machine model with which this mechanical load model is associated. MechanicalLoadDynamics shall have either an association to SynchronousMachineDynamics or AsynchronousMachineDyanmics.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#MechanicalLoadDynamics" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">SynchronousMachineDynamics</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#SynchronousMachineDynamics" />
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#MechanicalLoadUserDefined">
    <rdfs:comment xml:lang="en">Mechanical load function block whose dynamic behaviour is described by a user-defined model.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">MechanicalLoadUserDefined</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#MechanicalLoadDynamics" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Dynamics.UserDefinedModels</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#MechanicalLoadUserDefined.proprietary">
    <rdfs:comment xml:lang="en">Behaviour is based on a proprietary model as opposed to a detailed model. true = user-defined model is proprietary with behaviour mutually understood by sending and receiving applications and parameters passed as general attributes false = user-defined model is explicitly defined in terms of control blocks and their input and output signals.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#MechanicalLoadUserDefined" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">proprietary</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </owl:DatatypeProperty>
  <rdfs:Datatype rdf:about="http://iec.ch/TC57/CIM100#Minutes">
    <rdfs:comment xml:lang="en">Time in minutes.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">Minutes</rdfs:label>
    <owl:equivalentClass rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.Domain</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
    <cimdoc:unitMultiplier rdf:resource="http://iec.ch/TC57/CIM100#UnitMultiplier.none" />
    <cimdoc:unitSymbol rdf:resource="http://iec.ch/TC57/CIM100#UnitSymbol.min" />
  </rdfs:Datatype>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#ModelAuthority">
    <rdfs:comment xml:lang="en">A Modeling Authority is an entity responsible for supplying and maintaining the data defining a specific set of objects in a network model.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">ModelAuthority</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#IdentifiedObject" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.InfIEC61970.InfPart303.NetworkModelFrames</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Informative</cimdoc:packageTier>
  </owl:Class>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#ModelAuthoritySet">
    <rdfs:comment xml:lang="en">A Modeling Authority Set is a group of objects in a network model where the data is supplied and maintained by the same Modeling Authority. This class is typically not included in instance data exchange as this information is tracked by other mechanisms in the exchange.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">ModelAuthoritySet</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#IdentifiedObject" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.InfIEC61970.InfPart303.NetworkModelFrames</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Informative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#ModelAuthoritySet.ModelingAuthority">
    <rdfs:comment xml:lang="en">Modeling Authority suppliying and maintaining the data for the objects in this Modeling Authority Set.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ModelAuthoritySet" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">ModelingAuthority</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#ModelAuthority" />
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#ModelFrameType">
    <rdfs:comment xml:lang="en">Examples would be "Boundary" or "Region" type of frame.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">ModelFrameType</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#IdentifiedObject" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.InfIEC61970.InfPart303.NetworkModelFrames.unused</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Informative</cimdoc:packageTier>
  </owl:Class>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#ModelOperation">
    <rdfs:comment xml:lang="en">An operation performed on models.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">ModelOperation</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#IdentifiedObject" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.InfIEC61970.InfPart303.ModelOperations</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Informative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#ModelOperation.ModelOperationDescription">
    <rdfs:comment xml:lang="en">The type of the model operation.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ModelOperation" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">ModelOperationDescription</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#ModelOperationDescription" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ModelOperation.sequenceNumber">
    <rdfs:comment xml:lang="en">Sequence number within a operation sequence, lower is first. Normally starts with 1.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ModelOperation" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">sequenceNumber</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#ModelOperationArg">
    <rdfs:comment xml:lang="en">Describes the role a dataset plays in a model operation. The role is applicable only in the context of a single operation.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">ModelOperationArg</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#IdentifiedObject" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.InfIEC61970.InfPart303.ModelOperations</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Informative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#ModelOperationArg.ModelOperation">
    <rdfs:comment xml:lang="en">The operation for the operation argument.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ModelOperationArg" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">ModelOperation</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#ModelOperation" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ModelOperationArg.sequenceNumber">
    <rdfs:comment xml:lang="en">The sequence number of the argument in an operation. Argument entries are considered in numerical order where the operation requires an ordering.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ModelOperationArg" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">sequenceNumber</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#ModelOperationArgDescription">
    <rdfs:comment xml:lang="en">The type of custom operation dataset role for an operation description.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">ModelOperationArgDescription</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#IdentifiedObject" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.InfIEC61970.InfPart303.ModelOperations</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Informative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#ModelOperationArgDescription.ModelOperationDefinition">
    <rdfs:comment xml:lang="en">The type of operation for this type of dataset role. Operations referencing the dataset role type should only belong to operations that reference the operation type.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ModelOperationArgDescription" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">ModelOperationDefinition</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#ModelOperationDescription" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ModelOperationArgDescription.multiplicityMaximum">
    <rdfs:comment xml:lang="en">The maximum multiplicity of the instance arguments that should be supplied for a single operation. Use -1 to indicate unlimited.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ModelOperationArgDescription" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">multiplicityMaximum</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ModelOperationArgDescription.multiplicityMinimum">
    <rdfs:comment xml:lang="en">The minimum multiplicity of the instance arguments that should be supplied for a single operation. Use zero to indicate optional.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ModelOperationArgDescription" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">multiplicityMinimum</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#ModelOperationDescription">
    <rdfs:comment xml:lang="en">The type of model operation. This class is referenced by model operations and defines the kind of operation.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">ModelOperationDescription</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#IdentifiedObject" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.InfIEC61970.InfPart303.ModelOperations</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Informative</cimdoc:packageTier>
  </owl:Class>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#ModelOperationSequence">
    <rdfs:comment xml:lang="en">A concrete sequence of operations. For example, this may be used to describe a specific audit trail, a script or other specific set of actions on specific datasets.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">ModelOperationSequence</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#IdentifiedObject" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.InfIEC61970.InfPart303.ModelOperations</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Informative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#ModelOperationSequence.ModelOperation">
    <rdfs:comment xml:lang="en">The model operation associated with this sequence.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ModelOperationSequence" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">ModelOperation</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#ModelOperation" />
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#ModelPartSpecification">
    <rdfs:comment xml:lang="en">The type of model. For example, state estimator, planning, planning dynamics, short circuit, or real-time dynamics etc. The model must conform to a profile.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">ModelPartSpecification</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#IdentifiedObject" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.InfIEC61970.InfPart303.NetworkModelFrames</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Informative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#ModelPartSpecification.FrameworkPart">
    <rdfs:comment xml:lang="en">Model frame of the model part.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ModelPartSpecification" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">FrameworkPart</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#ModelAuthoritySet" />
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#ModelPartVersion">
    <rdfs:comment xml:lang="en">This is a version of a part of a model. New instances of this class with new identity are instantiated upon changes to the content of this class or changes to the associated data set. Instances of this class are considered immutable. The case audit trail can reference this immutable data to exactly reproduce a case.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">ModelPartVersion</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#ModelToBeDeleted" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.InfIEC61970.InfPart303.NetworkModelFrames</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Informative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#ModelPartVersion.ModelSpecification">
    <rdfs:comment xml:lang="en">Model specification of the modelt.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ModelPartVersion" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">ModelSpecification</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#ModelPartSpecification" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#ModelPartVersion.m_CompleteModelToBeDeleted">
    <rdfs:comment xml:lang="en">The complete model to be deleted, if any, associated with this model part version.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ModelPartVersion" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">m_CompleteModelToBeDeleted</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#CompleteModelToBeDeleted" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#ModelPartVersion.m_DataSet">
    <rdfs:comment xml:lang="en">The data set associated with this model part version.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ModelPartVersion" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">m_DataSet</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#DataSet" />
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#ModelToBeDeleted">
    <rdfs:comment xml:lang="en">A Model is a collection of Datasets.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">ModelToBeDeleted</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#IdentifiedObject" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.InfIEC61970.InfPart303.NetworkModelFrames</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Informative</cimdoc:packageTier>
  </owl:Class>
  <rdfs:Datatype rdf:about="http://iec.ch/TC57/CIM100#Money">
    <rdfs:comment xml:lang="en">Amount of money.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">Money</rdfs:label>
    <owl:equivalentClass rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.Domain</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </rdfs:Datatype>
  <rdfs:Datatype rdf:about="http://iec.ch/TC57/CIM100#MonthDay">
    <rdfs:comment xml:lang="en">MonthDay format as "--mm-dd", which conforms with XSD data type gMonthDay.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">MonthDay</rdfs:label>
    <owl:equivalentClass rdf:resource="http://www.w3.org/2001/XMLSchema#gMonthDay" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.Domain</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </rdfs:Datatype>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#MonthDayInterval">
    <rdfs:comment xml:lang="en">Interval between two times specified as month and day.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">MonthDayInterval</rdfs:label>
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.Domain</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#MonthDayInterval.end">
    <rdfs:comment xml:lang="en">End time of this interval.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#MonthDayInterval" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">end</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#gMonthDay" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#MonthDayInterval.start">
    <rdfs:comment xml:lang="en">Start time of this interval.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#MonthDayInterval" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">start</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#gMonthDay" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#MutualCoupling">
    <rdfs:comment xml:lang="en">This class represents the zero sequence line mutual coupling.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">MutualCoupling</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#IdentifiedObject" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.Wires</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#MutualCoupling.First_Terminal">
    <rdfs:comment xml:lang="en">The starting terminal for the calculation of distances along the first branch of the mutual coupling. Normally MutualCoupling would only be used for terminals of AC line segments. The first and second terminals of a mutual coupling should point to different AC line segments.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#MutualCoupling" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">First_Terminal</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Terminal" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#MutualCoupling.Second_Terminal">
    <rdfs:comment xml:lang="en">The starting terminal for the calculation of distances along the second branch of the mutual coupling.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#MutualCoupling" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">Second_Terminal</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Terminal" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#MutualCoupling.b0ch">
    <rdfs:comment xml:lang="en">Zero sequence mutual coupling shunt (charging) susceptance, uniformly distributed, of the entire line section.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#MutualCoupling" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">b0ch</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Susceptance" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#MutualCoupling.distance11">
    <rdfs:comment xml:lang="en">Distance to the start of the coupled region from the first line's terminal having sequence number equal to 1.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#MutualCoupling" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">distance11</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Length" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#MutualCoupling.distance12">
    <rdfs:comment xml:lang="en">Distance to the end of the coupled region from the first line's terminal with sequence number equal to 1.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#MutualCoupling" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">distance12</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Length" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#MutualCoupling.distance21">
    <rdfs:comment xml:lang="en">Distance to the start of coupled region from the second line's terminal with sequence number equal to 1.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#MutualCoupling" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">distance21</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Length" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#MutualCoupling.distance22">
    <rdfs:comment xml:lang="en">Distance to the end of coupled region from the second line's terminal with sequence number equal to 1.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#MutualCoupling" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">distance22</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Length" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#MutualCoupling.g0ch">
    <rdfs:comment xml:lang="en">Zero sequence mutual coupling shunt (charging) conductance, uniformly distributed, of the entire line section.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#MutualCoupling" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">g0ch</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Conductance" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#MutualCoupling.r0">
    <rdfs:comment xml:lang="en">Zero sequence branch-to-branch mutual impedance coupling, resistance.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#MutualCoupling" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">r0</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Resistance" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#MutualCoupling.x0">
    <rdfs:comment xml:lang="en">Zero sequence branch-to-branch mutual impedance coupling, reactance.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#MutualCoupling" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">x0</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Reactance" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#Name">
    <rdfs:comment xml:lang="en">The Name class provides the means to define any number of human readable names for an object. A name is not to be used for defining inter-object relationships. For inter-object relationships instead use the object identification 'mRID'.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">Name</rdfs:label>
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.Core</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#Name.IdentifiedObject">
    <rdfs:comment xml:lang="en">Identified object that this name designates.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#Name" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">IdentifiedObject</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#IdentifiedObject" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#Name.NameType">
    <rdfs:comment xml:lang="en">Type of this name.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#Name" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">NameType</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#NameType" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#Name.name">
    <rdfs:comment xml:lang="en">Any free text that name the object.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#Name" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">name</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#NameType">
    <rdfs:comment xml:lang="en">Type of name. Possible values for attribute 'name' are implementation dependent but standard profiles may specify types. An enterprise may have multiple IT systems each having its own local name for the same object, e.g. a planning system may have different names from an EMS. An object may also have different names within the same IT system, e.g. localName as defined in CIM version 14. The definition from CIM14 is: The localName is a human readable name of the object. It is a free text name local to a node in a naming hierarchy similar to a file directory structure. A power system related naming hierarchy may be: Substation, VoltageLevel, Equipment etc. Children of the same parent in such a hierarchy have names that typically are unique among them.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">NameType</rdfs:label>
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.Core</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#NameType.NameTypeAuthority">
    <rdfs:comment xml:lang="en">Authority responsible for managing names of this type.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#NameType" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">NameTypeAuthority</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#NameTypeAuthority" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#NameType.description">
    <rdfs:comment xml:lang="en">Description of the name type.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#NameType" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">description</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#NameType.name">
    <rdfs:comment xml:lang="en">Name of the name type.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#NameType" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">name</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#NameTypeAuthority">
    <rdfs:comment xml:lang="en">Authority responsible for creation and management of names of a given type; typically an organization or an enterprise system.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">NameTypeAuthority</rdfs:label>
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.Core</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#NameTypeAuthority.description">
    <rdfs:comment xml:lang="en">Description of the name type authority.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#NameTypeAuthority" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">description</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#NameTypeAuthority.name">
    <rdfs:comment xml:lang="en">Name of the name type authority.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#NameTypeAuthority" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">name</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#NetworkBoundary">
    <rdfs:comment xml:lang="en">A framework part that is a boundary between 2 frames.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">NetworkBoundary</rdfs:label>
