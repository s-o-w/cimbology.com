    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">m_EnergyComponent</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#EnergyComponent" />
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#EnergyConsumer">
    <rdfs:comment xml:lang="en">Generic user of energy - a point of consumption on the power system model. EnergyConsumer.pfixed, .qfixed, .pfixedPct and .qfixedPct have meaning only if there is no LoadResponseCharacteristic associated with EnergyConsumer or if LoadResponseCharacteristic.exponentModel is set to False.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">EnergyConsumer</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#EnergyConnection" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.Wires</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#EnergyConsumer.EnergyConsumerAction">
    <rdfs:comment xml:lang="en">The energy consumer action that is performed on the energy consumer</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#EnergyConsumer" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">EnergyConsumerAction</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#EnergyConsumerAction" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#EnergyConsumer.EnergyConsumerPhase">
    <rdfs:comment xml:lang="en">The individual phase models for this energy consumer.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#EnergyConsumer" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">EnergyConsumerPhase</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#EnergyConsumerPhase" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#EnergyConsumer.LoadResponse">
    <rdfs:comment xml:lang="en">The load response characteristic of this load. If missing, this load is assumed to be constant power.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#EnergyConsumer" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">LoadResponse</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#LoadResponseCharacteristic" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#EnergyConsumer.customerCount">
    <rdfs:comment xml:lang="en">Number of individual customers represented by this demand.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#EnergyConsumer" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">customerCount</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#EnergyConsumer.grounded">
    <rdfs:comment xml:lang="en">Used for Yn and Zn connections. True if the neutral is solidly grounded.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#EnergyConsumer" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">grounded</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#EnergyConsumer.p">
    <rdfs:comment xml:lang="en">Active power of the load. Load sign convention is used, i.e. positive sign means flow out from a node. For voltage dependent loads the value is at rated voltage. Starting value for a steady state solution.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#EnergyConsumer" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">p</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#ActivePower" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#EnergyConsumer.pfixed">
    <rdfs:comment xml:lang="en">Active power of the load that is a fixed quantity and does not vary as load group value varies. Load sign convention is used, i.e. positive sign means flow out from a node.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#EnergyConsumer" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">pfixed</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#ActivePower" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#EnergyConsumer.pfixedPct">
    <rdfs:comment xml:lang="en">Fixed active power as a percentage of load group fixed active power. Used to represent the time-varying components. Load sign convention is used, i.e. positive sign means flow out from a node.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#EnergyConsumer" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">pfixedPct</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PerCent" />
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#EnergyConsumer.phaseConnection">
    <rdfs:comment xml:lang="en">The type of phase connection, such as wye or delta.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#EnergyConsumer" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">phaseConnection</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PhaseShuntConnectionKind" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#EnergyConsumer.q">
    <rdfs:comment xml:lang="en">Reactive power of the load. Load sign convention is used, i.e. positive sign means flow out from a node. For voltage dependent loads the value is at rated voltage. Starting value for a steady state solution.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#EnergyConsumer" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">q</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#ReactivePower" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#EnergyConsumer.qfixed">
    <rdfs:comment xml:lang="en">Reactive power of the load that is a fixed quantity and does not vary as load group value varies. Load sign convention is used, i.e. positive sign means flow out from a node.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#EnergyConsumer" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">qfixed</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#ReactivePower" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#EnergyConsumer.qfixedPct">
    <rdfs:comment xml:lang="en">Fixed reactive power as a percentage of load group fixed reactive power. Used to represent the time-varying components. Load sign convention is used, i.e. positive sign means flow out from a node.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#EnergyConsumer" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">qfixedPct</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PerCent" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#EnergyConsumerAction">
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
  </owl:Class>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#EnergyConsumerPhase">
    <rdfs:comment xml:lang="en">A single phase of an energy consumer.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">EnergyConsumerPhase</rdfs:label>
