    <rdfs:label xml:lang="en">IndustrialLoad</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#EnergyTypeKind.Other">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#EnergyTypeKind" />
