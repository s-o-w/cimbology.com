    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#AnalogValue" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#AltGeneratingUnitMeas.priority">
    <rdfs:comment xml:lang="en">Priority of a measurement usage. Lower numbers have first priority.</rdfs:comment>
