    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Informative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#NetworkBoundary.m_NetworkFrame">
    <rdfs:comment xml:lang="en">The network frame associated with this boundary.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#NetworkBoundary" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">m_NetworkFrame</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#NetworkFrame" />
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#NetworkFrame">
    <rdfs:comment xml:lang="en">A region isolated by boundaries.</rdfs:comment>
