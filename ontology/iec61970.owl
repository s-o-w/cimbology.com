    <rdfs:comment xml:lang="en">Maximum value of regulator set-point (Crmx). Typical value = 1,2.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#GovSteamFV4" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
