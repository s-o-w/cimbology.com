  </owl:Class>
  <rdfs:Datatype rdf:about="http://iec.ch/TC57/CIM100#Date">
    <rdfs:comment xml:lang="en">Date as "yyyy-mm-dd", which conforms with ISO 8601. UTC time zone is specified as "yyyy-mm-ddZ". A local timezone relative UTC is specified as "yyyy-mm-dd(+/- )hh:mm".</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">Date</rdfs:label>
    <owl:equivalentClass rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.Domain</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </rdfs:Datatype>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#DateInterval">
    <rdfs:comment xml:lang="en">Interval between two dates.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">DateInterval</rdfs:label>
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.Domain</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#DateInterval.end">
    <rdfs:comment xml:lang="en">End date of this interval.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#DateInterval" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">end</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#DateInterval.start">
    <rdfs:comment xml:lang="en">Start date of this interval.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#DateInterval" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">start</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
  </owl:DatatypeProperty>
  <rdfs:Datatype rdf:about="http://iec.ch/TC57/CIM100#DateTime">
    <rdfs:comment xml:lang="en">Date and time as "yyyy-mm-ddThh:mm:ss.sss", which conforms with ISO 8601. UTC time zone is specified as "yyyy-mm-ddThh:mm:ss.sssZ". A local timezone relative UTC is specified as "yyyy-mm-ddThh:mm:ss.sss-hh:mm". The second component (shown here as "ss.sss") could have any number of digits in its fractional part to allow any kind of precision beyond seconds.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">DateTime</rdfs:label>
    <owl:equivalentClass rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.Domain</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </rdfs:Datatype>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#DateTimeInterval">
    <rdfs:comment xml:lang="en">Interval between two date and time points, where the interval includes the start time but excludes end time.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">DateTimeInterval</rdfs:label>
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.Domain</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#DateTimeInterval.end">
    <rdfs:comment xml:lang="en">End date and time of this interval. The end date and time where the interval is defined up to, but excluded.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#DateTimeInterval" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">end</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#DateTimeInterval.start">
    <rdfs:comment xml:lang="en">Start date and time of this interval. The start date and time is included in the defined interval.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#DateTimeInterval" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">start</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime" />
  </owl:DatatypeProperty>
