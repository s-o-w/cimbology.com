    <rdfs:comment xml:lang="en">Time to trip the exciter at the mid voltage or current point on the inverse time characteristic (TIME2) (&gt;= 0). Typical value = 40.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#OverexcLimX2" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
