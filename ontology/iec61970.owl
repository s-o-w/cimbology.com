  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ExcIEEEDC4B.oelin">
    <rdfs:comment xml:lang="en">OEL input (OELin). true = LV gate false = subtract from error signal. Typical value = true.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ExcIEEEDC4B" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">oelin</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
