    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#SinglePhaseKind" />
    <rdfs:comment xml:lang="en">Secondary phase 1.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">s1</rdfs:label>
