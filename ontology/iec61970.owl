    <rdfs:comment xml:lang="en">Less or equal comparison operation.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">le</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#AnalogToDigitalLogicKind.lt">
