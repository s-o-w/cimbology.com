  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#HydroEnergyConversionKind">
    <rdfs:comment xml:lang="en">Specifies the capability of the hydro generating unit to convert energy as a generator or pump.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">HydroEnergyConversionKind</rdfs:label>
    <owl:equivalentClass rdf:nodeID="oneOfClass_HydroEnergyConversionKind" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.Generation.Production</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#HydroEnergyConversionKind.generator">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#HydroEnergyConversionKind" />
    <rdfs:comment xml:lang="en">Able to generate power, but not able to pump water for energy storage.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">generator</rdfs:label>
