    <rdfs:comment xml:lang="en">Excitation control system stabilizer gains (KF) (&gt;= 0). Typical value = 0,03.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ExcIEEEAC5A" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">kf</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ExcIEEEAC5A.seefd1">
    <rdfs:comment xml:lang="en">Exciter saturation function value at the corresponding exciter voltage, EFD1 (SE[EFD1]) (&gt;= 0). Typical value = 0,86.</rdfs:comment>
