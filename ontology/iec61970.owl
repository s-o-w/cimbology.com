  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#ProtectionEquipment">
    <rdfs:comment xml:lang="en">An electrical device designed to respond to input conditions in a prescribed manner and after specified conditions are met to cause contact operation or similar abrupt change in associated electric control circuits, or simply to display the detected condition. Protection equipment is associated with conducting equipment and usually operate circuit breakers.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">ProtectionEquipment</rdfs:label>
