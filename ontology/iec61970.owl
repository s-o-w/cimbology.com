    <rdfs:comment xml:lang="en">Head of compensation chamber water level with respect to the level of penstock (H1). Unit = km. Typical value = 0,004.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#GovHydroPelton" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
