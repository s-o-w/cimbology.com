    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
    <cimdoc:unitSymbol rdf:resource="http://iec.ch/TC57/CIM100#UnitSymbol.H" />
  </rdfs:Datatype>
  <rdfs:Datatype rdf:about="http://iec.ch/TC57/CIM100#InductancePerLength">
