    <rdfs:comment xml:lang="en">Filter time constant for voltage measurement (TWPufiltq) (&gt;= 0). It is a project-dependent parameter.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#WindPlantReactiveControlIEC" />
