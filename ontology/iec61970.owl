  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#GovHydro3.kg">
    <rdfs:comment xml:lang="en">Gate servo gain (Kg). Typical value = 2.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#GovHydro3" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">kg</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#GovHydro3.ki">
    <rdfs:comment xml:lang="en">Integral gain (Ki). Typical value = 0,5.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#GovHydro3" />
