  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#GovCT2.kiload">
    <rdfs:comment xml:lang="en">Load limiter integral gain for PI controller (Kiload). Typical value = 1.</rdfs:comment>
