    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#WindPlantQcontrolModeKind" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#WindPlantReactiveControlIEC.xrefmax">
    <rdfs:comment xml:lang="en">Maximum xWTref (qWTref or delta uWTref) request from the plant controller (xrefmax) (&gt; WindPlantReactiveControlIEC.xrefmin). It is a case-dependent parameter.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#WindPlantReactiveControlIEC" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">xrefmax</rdfs:label>
