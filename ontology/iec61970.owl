    <rdfs:label xml:lang="en">ICCPQualityKind</rdfs:label>
    <owl:equivalentClass rdf:nodeID="oneOfClass_ICCPQualityKind" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.ICCPConfiguration</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#ICCPQualityKind.extended">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#ICCPQualityKind" />
    <rdfs:comment xml:lang="en">Indicates that only extended information is to be provided.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">extended</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</cimdoc:enumCode>
  </owl:NamedIndividual>
