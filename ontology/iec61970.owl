    <rdfs:comment xml:lang="en">Frequency bias (reciprocal of droop) (Kf1). Typical value = 20.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#GovSteamFV4" />
