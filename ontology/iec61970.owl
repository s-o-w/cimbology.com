  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#HydroPlantStorageKind.storage">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#HydroPlantStorageKind" />
    <rdfs:comment xml:lang="en">Storage.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">storage</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#HydroPowerPlant">
    <rdfs:comment xml:lang="en">A hydro power station which can generate or pump. When generating, the generator turbines receive water from an upper reservoir. When pumping, the pumps receive their water from a lower reservoir.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">HydroPowerPlant</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#PowerSystemResource" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.Generation.Production</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#HydroPowerPlant.GenSourcePumpDischargeReservoir">
    <rdfs:comment xml:lang="en">Generators are supplied water from or pumps discharge water to an upstream reservoir.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#HydroPowerPlant" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">GenSourcePumpDischargeReservoir</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Reservoir" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#HydroPowerPlant.HydroGeneratingUnits">
    <rdfs:comment xml:lang="en">The hydro generating unit belongs to a hydro power plant.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#HydroPowerPlant" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">HydroGeneratingUnits</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#HydroGeneratingUnit" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#HydroPowerPlant.HydroPumps">
    <rdfs:comment xml:lang="en">The hydro pump may be a member of a pumped storage plant or a pump for distributing water.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#HydroPowerPlant" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">HydroPumps</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#HydroPump" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#HydroPowerPlant.Reservoir">
    <rdfs:comment xml:lang="en">Generators discharge water to or pumps are supplied water from a downstream reservoir.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#HydroPowerPlant" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">Reservoir</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Reservoir" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#HydroPowerPlant.dischargeTravelDelay">
    <rdfs:comment xml:lang="en">Water travel delay from tailbay to next downstream hydro power station.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#HydroPowerPlant" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">dischargeTravelDelay</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Seconds" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#HydroPowerPlant.genRatedP">
    <rdfs:comment xml:lang="en">The hydro plant's generating rating active power for rated head conditions. The attribute shall be a positive value.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#HydroPowerPlant" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">genRatedP</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#ActivePower" />
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#HydroPowerPlant.hydroPlantStorageType">
    <rdfs:comment xml:lang="en">The type of hydro power plant water storage.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#HydroPowerPlant" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">hydroPlantStorageType</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#HydroPlantStorageKind" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#HydroPowerPlant.penstockType">
    <rdfs:comment xml:lang="en">Type and configuration of hydro plant penstock(s).</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#HydroPowerPlant" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">penstockType</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#HydroPowerPlant.plantDischargeCapacity">
    <rdfs:comment xml:lang="en">Total plant discharge capacity.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#HydroPowerPlant" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">plantDischargeCapacity</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#VolumeFlowRate" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#HydroPowerPlant.plantRatedHead">
    <rdfs:comment xml:lang="en">The plant's rated gross head. The attribute shall be a positive value.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#HydroPowerPlant" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">plantRatedHead</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Length" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#HydroPowerPlant.pumpRatedP">
    <rdfs:comment xml:lang="en">The hydro plant's pumping rating active power for rated head conditions. The attribute shall be a positive value.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#HydroPowerPlant" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">pumpRatedP</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#ActivePower" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#HydroPowerPlant.surgeTankCode">
    <rdfs:comment xml:lang="en">A code describing the type (or absence) of surge tank that is associated with the hydro power plant.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#HydroPowerPlant" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">surgeTankCode</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#HydroPowerPlant.surgeTankCrestLevel">
    <rdfs:comment xml:lang="en">The level at which the surge tank spills.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#HydroPowerPlant" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">surgeTankCrestLevel</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#WaterLevel" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#HydroPump">
    <rdfs:comment xml:lang="en">A synchronous motor-driven pump, typically associated with a pumped storage plant.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">HydroPump</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#Equipment" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.Generation.Production</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#HydroPump.HydroPumpOpSchedule">
    <rdfs:comment xml:lang="en">The hydro pump has a pumping schedule over time, indicating when pumping is to occur.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#HydroPump" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">HydroPumpOpSchedule</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#HydroPumpOpSchedule" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#HydroPump.pumpDischAtMaxHead">
    <rdfs:comment xml:lang="en">The pumping discharge under maximum head conditions, usually at full gate.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#HydroPump" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">pumpDischAtMaxHead</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#VolumeFlowRate" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#HydroPump.pumpDischAtMinHead">
    <rdfs:comment xml:lang="en">The pumping discharge under minimum head conditions, usually at full gate.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#HydroPump" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">pumpDischAtMinHead</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#VolumeFlowRate" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#HydroPump.pumpPowerAtMaxHead">
    <rdfs:comment xml:lang="en">The pumping power under maximum head conditions, usually at full gate.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#HydroPump" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">pumpPowerAtMaxHead</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#ActivePower" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#HydroPump.pumpPowerAtMinHead">
    <rdfs:comment xml:lang="en">The pumping power under minimum head conditions, usually at full gate.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#HydroPump" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">pumpPowerAtMinHead</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#ActivePower" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#HydroPumpOpSchedule">
    <rdfs:comment xml:lang="en">The hydro pump's Operator-approved current operating schedule (or plan), typically produced with the aid of unit commitment type analyses. The unit's operating schedule status is typically given as: (0=unavailable) (1=available to startup or shutdown) (2=must pump).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">HydroPumpOpSchedule</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#RegularIntervalSchedule" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.Generation.Production</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#HydroTurbine">
