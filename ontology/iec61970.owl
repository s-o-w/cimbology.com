  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#BusNameMarker.priority">
    <rdfs:comment xml:lang="en">Priority of bus name marker for use as topology bus name. Use 0 for do not care. Use 1 for highest priority. Use 2 as priority is less than 1 and so on.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#BusNameMarker" />
