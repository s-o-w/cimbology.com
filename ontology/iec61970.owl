  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#LoadStatic.kq1">
    <rdfs:comment xml:lang="en">First term voltage coefficient for reactive power (Kq1). Not used when .staticLoadModelType = constantZ.</rdfs:comment>
