  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#AsynchronousMachineTimeConstantReactance">
    <rdfs:comment xml:lang="en">Parameter details: - If X'' = X', a single cage (one equivalent rotor winding per axis) is modelled. - The �p� in the attribute names is a substitution for a �prime� in the usual parameter notation, e.g. tpo refers to T'o. The parameters used for models expressed in time constant reactance form include: - RotatingMachine.ratedS (MVAbase); - RotatingMachineDynamics.damping (D); - RotatingMachineDynamics.inertia (H); - RotatingMachineDynamics.saturationFactor (S1); - RotatingMachineDynamics.saturationFactor120 (S12); - RotatingMachineDynamics.statorLeakageReactance (Xl); - RotatingMachineDynamics.statorResistance (Rs); - .xs (Xs); - .xp (X'); - .xpp (X''); - .tpo (T'o); - .tppo (T''o).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">AsynchronousMachineTimeConstantReactance</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#AsynchronousMachineDynamics" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Dynamics.StandardModels.AsynchronousMachineDynamics</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#AsynchronousMachineTimeConstantReactance.tpo">
    <rdfs:comment xml:lang="en">Transient rotor time constant (T'o) (&gt; AsynchronousMachineTimeConstantReactance.tppo). Typical value = 5.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#AsynchronousMachineTimeConstantReactance" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">tpo</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Seconds" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#AsynchronousMachineTimeConstantReactance.tppo">
    <rdfs:comment xml:lang="en">Subtransient rotor time constant (T''o) (&gt; 0). Typical value = 0,03.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#AsynchronousMachineTimeConstantReactance" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">tppo</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Seconds" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#AsynchronousMachineTimeConstantReactance.xp">
    <rdfs:comment xml:lang="en">Transient reactance (unsaturated) (X') (&gt;= AsynchronousMachineTimeConstantReactance.xpp). Typical value = 0,5.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#AsynchronousMachineTimeConstantReactance" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">xp</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#AsynchronousMachineTimeConstantReactance.xpp">
    <rdfs:comment xml:lang="en">Subtransient reactance (unsaturated) (X'') (&gt; RotatingMachineDynamics. statorLeakageReactance). Typical value = 0,2.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#AsynchronousMachineTimeConstantReactance" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">xpp</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#AsynchronousMachineTimeConstantReactance.xs">
    <rdfs:comment xml:lang="en">Synchronous reactance (Xs) (&gt;= AsynchronousMachineTimeConstantReactance. xp). Typical value = 1,8.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#AsynchronousMachineTimeConstantReactance" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">xs</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#AsynchronousMachineUserDefined">
    <rdfs:comment xml:lang="en">Asynchronous machine whose dynamic behaviour is described by a user-defined model.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">AsynchronousMachineUserDefined</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#AsynchronousMachineDynamics" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Dynamics.UserDefinedModels</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#AsynchronousMachineUserDefined.proprietary">
    <rdfs:comment xml:lang="en">Behaviour is based on a proprietary model as opposed to a detailed model. true = user-defined model is proprietary with behaviour mutually understood by sending and receiving applications and parameters passed as general attributes false = user-defined model is explicitly defined in terms of control blocks and their input and output signals.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#AsynchronousMachineUserDefined" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">proprietary</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#AuxiliaryEquipment">
    <rdfs:comment xml:lang="en">AuxiliaryEquipment describe equipment that is not performing any primary functions but support for the equipment performing the primary function. AuxiliaryEquipment is attached to primary equipment via an association with Terminal.</rdfs:comment>
