  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#SinglePhaseKind.s2">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#SinglePhaseKind" />
    <rdfs:comment xml:lang="en">Secondary phase 2.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
