    <rdfs:comment xml:lang="en">Zero sequence series reactance, per unit of length.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#PerLengthSequenceImpedance" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">x0</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#ReactancePerLength" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#PetersenCoil">
    <rdfs:comment xml:lang="en">A variable impedance device normally used to offset line charging during single line faults in an ungrounded section of network.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">PetersenCoil</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#EarthFaultCompensator" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.Wires</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#PetersenCoil.mode">
    <rdfs:comment xml:lang="en">The mode of operation of the Petersen coil.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#PetersenCoil" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">mode</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PetersenCoilModeKind" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#PetersenCoil.nominalU">
    <rdfs:comment xml:lang="en">The nominal voltage for which the coil is designed.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#PetersenCoil" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">nominalU</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Voltage" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#PetersenCoil.offsetCurrent">
    <rdfs:comment xml:lang="en">The offset current that the Petersen coil controller is operating from the resonant point. This is normally a fixed amount for which the controller is configured and could be positive or negative. Typically 0 to 60 A depending on voltage and resonance conditions.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#PetersenCoil" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">offsetCurrent</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#CurrentFlow" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#PetersenCoil.positionCurrent">
    <rdfs:comment xml:lang="en">The control current used to control the Petersen coil also known as the position current. Typically in the range of 20 mA to 200 mA.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#PetersenCoil" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">positionCurrent</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#CurrentFlow" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#PetersenCoil.xGroundMax">
    <rdfs:comment xml:lang="en">The maximum reactance.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#PetersenCoil" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">xGroundMax</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Reactance" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#PetersenCoil.xGroundMin">
    <rdfs:comment xml:lang="en">The minimum reactance.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#PetersenCoil" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">xGroundMin</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Reactance" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#PetersenCoil.xGroundNominal">
    <rdfs:comment xml:lang="en">The nominal reactance. This is the operating point (normally over compensation) that is defined based on the resonance point in the healthy network condition. The impedance is calculated based on nominal voltage divided by position current.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#PetersenCoil" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">xGroundNominal</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Reactance" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#PetersenCoilModeKind">
    <rdfs:comment xml:lang="en">The mode of operation for a Petersen coil.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">PetersenCoilModeKind</rdfs:label>
    <owl:equivalentClass rdf:nodeID="oneOfClass_PetersenCoilModeKind" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.Wires</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
