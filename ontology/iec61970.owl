  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#GovCT2.kpgov">
    <rdfs:comment xml:lang="en">Governor proportional gain (Kpgov). Typical value = 4.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#GovCT2" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
