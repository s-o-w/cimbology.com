  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#InputSignalKind.rotorSpeed">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#InputSignalKind" />
    <rdfs:comment xml:lang="en">Input signal is rotor or shaft speed (angular frequency).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">rotorSpeed</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#InstanceSet">
    <rdfs:comment xml:lang="en">Represents an instance set, a version of a model part corresponding to a payload of instance data.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">InstanceSet</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#DataSet" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.InfIEC61970.Part303.GenericDataSet</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Informative</cimdoc:packageTier>
  </owl:Class>
  <rdfs:Datatype rdf:about="http://iec.ch/TC57/CIM100#Integer">
    <rdfs:comment xml:lang="en">An integer number. The range is unspecified and not limited.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">Integer</rdfs:label>
    <owl:equivalentClass rdf:resource="http://www.w3.org/2001/XMLSchema#integer" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.Domain</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </rdfs:Datatype>
  <rdfs:Datatype rdf:about="http://iec.ch/TC57/CIM100#IntegerQuantity">
    <rdfs:comment xml:lang="en">Quantity with integer value and associated unit information.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">IntegerQuantity</rdfs:label>
    <owl:equivalentClass rdf:resource="http://www.w3.org/2001/XMLSchema#integer" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.Domain</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </rdfs:Datatype>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#IrregularIntervalSchedule">
    <rdfs:comment xml:lang="en">The schedule has time points where the time between them varies.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">IrregularIntervalSchedule</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#BasicIntervalSchedule" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.Core</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#IrregularIntervalSchedule.TimePoints">
    <rdfs:comment xml:lang="en">The point data values that define a curve.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#IrregularIntervalSchedule" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">TimePoints</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#IrregularTimePoint" />
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#IrregularTimePoint">
    <rdfs:comment xml:lang="en">TimePoints for a schedule where the time between the points varies.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">IrregularTimePoint</rdfs:label>
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.Core</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#IrregularTimePoint.time">
    <rdfs:comment xml:lang="en">The time is relative to the schedule starting time.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#IrregularTimePoint" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">time</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Seconds" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#IrregularTimePoint.value1">
    <rdfs:comment xml:lang="en">The first value at the time. The meaning of the value is defined by the derived type of the associated schedule.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#IrregularTimePoint" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">value1</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#IrregularTimePoint.value2">
    <rdfs:comment xml:lang="en">The second value at the time. The meaning of the value is defined by the derived type of the associated schedule.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#IrregularTimePoint" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">value2</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#Jumper">
    <rdfs:comment xml:lang="en">A short section of conductor with negligible impedance which can be manually removed and replaced if the circuit is de-energized. Note that zero-impedance branches can potentially be modelled by other equipment types.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">Jumper</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#Switch" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.Wires</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#JumperAction">
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
  </owl:Class>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#Junction">
    <rdfs:comment xml:lang="en">A point where one or more conducting equipments are connected with zero resistance.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">Junction</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#Connector" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.Wires</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <rdfs:Datatype rdf:about="http://iec.ch/TC57/CIM100#KiloActivePower">
    <rdfs:comment xml:lang="en">Active power in kilowatts.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">KiloActivePower</rdfs:label>
    <owl:equivalentClass rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.Domain</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
    <cimdoc:unitMultiplier rdf:resource="http://iec.ch/TC57/CIM100#UnitMultiplier.k" />
    <cimdoc:unitSymbol rdf:resource="http://iec.ch/TC57/CIM100#UnitSymbol.W" />
  </rdfs:Datatype>
  <rdfs:Datatype rdf:about="http://iec.ch/TC57/CIM100#Length">
    <rdfs:comment xml:lang="en">Unit of length. It shall be a positive value or zero.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">Length</rdfs:label>
    <owl:equivalentClass rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.Domain</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
    <cimdoc:unitSymbol rdf:resource="http://iec.ch/TC57/CIM100#UnitSymbol.m" />
  </rdfs:Datatype>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#LevelVsVolumeCurve">
    <rdfs:comment xml:lang="en">Relationship between reservoir volume and reservoir level. The volume is at the Y-axis and the reservoir level at the X-axis.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">LevelVsVolumeCurve</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#Curve" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.Generation.Production</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#Limit">
    <rdfs:comment xml:lang="en">Specifies one limit value for a Measurement. A Measurement typically has several limits that are kept together by the LimitSet class. The actual meaning and use of a Limit instance (i.e., if it is an alarm or warning limit or if it is a high or low limit) is not captured in the Limit class. However the name of a Limit instance may indicate both meaning and use.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">Limit</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#IdentifiedObject" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.Meas</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#LimitDependency">
    <rdfs:comment xml:lang="en">A limit calculation model used to compute an operational limit based on external input such as temperature. These are intended to be shared among operational limits with the same calculation form that apply to a piece of equipment.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">LimitDependency</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#IdentifiedObject" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.InfIEC61970.InfOperationalLimits</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Informative</cimdoc:packageTier>
  </owl:Class>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#LimitScalingLimit">
    <rdfs:comment xml:lang="en">Specifies an operational limit that is calculated by scaling another operational limit.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">LimitScalingLimit</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#LimitDependency" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.InfIEC61970.InfOperationalLimits</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Informative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#LimitScalingLimit.SourceOperationalLimit">
    <rdfs:comment xml:lang="en">The source operational limit used for scaling.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LimitScalingLimit" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">SourceOperationalLimit</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#OperationalLimit" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#LimitScalingLimit.limitScalingPercent">
    <rdfs:comment xml:lang="en">The associated source limit is scaled by this value to compute the limit of the dependency model.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LimitScalingLimit" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">limitScalingPercent</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PerCent" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#LimitSet">
    <rdfs:comment xml:lang="en">Specifies a set of Limits that are associated with a Measurement. A Measurement may have several LimitSets corresponding to seasonal or other changing conditions. The condition is captured in the name and description attributes. The same LimitSet may be used for several Measurements. In particular percentage limits are used this way.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">LimitSet</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#IdentifiedObject" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.Meas</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#LimitSet.isPercentageLimits">
    <rdfs:comment xml:lang="en">Tells if the limit values are in percentage of normalValue or the specified Unit for Measurements and Controls.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LimitSet" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">isPercentageLimits</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#Line">
    <rdfs:comment xml:lang="en">Contains equipment beyond a substation belonging to a power transmission line.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">Line</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#EquipmentContainer" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.Wires</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#LineFault">
    <rdfs:comment xml:lang="en">A fault that occurs on an AC line segment at some point along the length.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">LineFault</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#Fault" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.Faults</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#LineFault.ACLineSegment">
    <rdfs:comment xml:lang="en">The line segment of this line fault.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LineFault" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">ACLineSegment</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#ACLineSegment" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#LineFault.lengthFromTerminal1">
    <rdfs:comment xml:lang="en">The length to the place where the fault is located starting from terminal with sequence number 1 of the faulted line segment.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LineFault" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">lengthFromTerminal1</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Length" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#LinearShuntCompensator">
    <rdfs:comment xml:lang="en">A linear shunt compensator has banks or sections with equal admittance values.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">LinearShuntCompensator</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#ShuntCompensator" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.Wires</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#LinearShuntCompensator.b0PerSection">
    <rdfs:comment xml:lang="en">Zero sequence shunt (charging) susceptance per section.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LinearShuntCompensator" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">b0PerSection</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Susceptance" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#LinearShuntCompensator.bPerSection">
    <rdfs:comment xml:lang="en">Positive sequence shunt (charging) susceptance per section.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LinearShuntCompensator" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">bPerSection</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Susceptance" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#LinearShuntCompensator.g0PerSection">
    <rdfs:comment xml:lang="en">Zero sequence shunt (charging) conductance per section.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LinearShuntCompensator" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">g0PerSection</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Conductance" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#LinearShuntCompensator.gPerSection">
    <rdfs:comment xml:lang="en">Positive sequence shunt (charging) conductance per section.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LinearShuntCompensator" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">gPerSection</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Conductance" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#LinearShuntCompensatorPhase">
    <rdfs:comment xml:lang="en">A per phase linear shunt compensator has banks or sections with equal admittance values.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">LinearShuntCompensatorPhase</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#ShuntCompensatorPhase" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.Wires</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#LinearShuntCompensatorPhase.bPerSection">
    <rdfs:comment xml:lang="en">Susceptance per section of the phase if shunt compensator is wye connected. Susceptance per section phase to phase if shunt compensator is delta connected.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LinearShuntCompensatorPhase" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">bPerSection</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Susceptance" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#LinearShuntCompensatorPhase.gPerSection">
    <rdfs:comment xml:lang="en">Conductance per section for this phase if shunt compensator is wye connected. Conductance per section phase to phase if shunt compensator is delta connected.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LinearShuntCompensatorPhase" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">gPerSection</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Conductance" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#LoadAggregate">
    <rdfs:comment xml:lang="en">Aggregate loads are used to represent all or part of the real and reactive load from one or more loads in the static (power flow) data. This load is usually the aggregation of many individual load devices and the load model is an approximate representation of the aggregate response of the load devices to system disturbances. Standard aggregate load model comprised of static and/or dynamic components. A static load model represents the sensitivity of the real and reactive power consumed by the load to the amplitude and frequency of the bus voltage. A dynamic load model can be used to represent the aggregate response of the motor components of the load.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">LoadAggregate</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#LoadDynamics" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Dynamics.StandardModels.LoadDynamics</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#LoadArea">
    <rdfs:comment xml:lang="en">The class is the root or first level in a hierarchical structure for grouping of loads for the purpose of load flow load scaling.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">LoadArea</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#EnergyArea" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.LoadModel</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#LoadArea.SubLoadAreas">
    <rdfs:comment xml:lang="en">The SubLoadAreas in the LoadArea.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LoadArea" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">SubLoadAreas</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#SubLoadArea" />
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#LoadBreakSwitch">
    <rdfs:comment xml:lang="en">A mechanical switching device capable of making, carrying, and breaking currents under normal operating conditions.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">LoadBreakSwitch</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#ProtectedSwitch" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.Wires</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#LoadComposite">
    <rdfs:comment xml:lang="en">Combined static load and induction motor load effects. The dynamics of the motor are simplified by linearizing the induction machine equations.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">LoadComposite</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#LoadDynamics" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Dynamics.StandardModels.LoadDynamics</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#LoadComposite.epfd">
    <rdfs:comment xml:lang="en">Active load-frequency dependence index (dynamic) (Epfd). Typical value = 1,5.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LoadComposite" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">epfd</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#LoadComposite.epfs">
    <rdfs:comment xml:lang="en">Active load-frequency dependence index (static) (Epfs). Typical value = 1,5.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LoadComposite" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">epfs</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#LoadComposite.epvd">
    <rdfs:comment xml:lang="en">Active load-voltage dependence index (dynamic) (Epvd). Typical value = 0,7.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LoadComposite" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">epvd</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#LoadComposite.epvs">
    <rdfs:comment xml:lang="en">Active load-voltage dependence index (static) (Epvs). Typical value = 0, 7.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LoadComposite" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">epvs</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#LoadComposite.eqfd">
    <rdfs:comment xml:lang="en">Reactive load-frequency dependence index (dynamic) (Eqfd). Typical value = 0.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LoadComposite" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">eqfd</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#LoadComposite.eqfs">
    <rdfs:comment xml:lang="en">Reactive load-frequency dependence index (static) (Eqfs). Typical value = 0.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LoadComposite" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">eqfs</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#LoadComposite.eqvd">
    <rdfs:comment xml:lang="en">Reactive load-voltage dependence index (dynamic) (Eqvd). Typical value = 2.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LoadComposite" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">eqvd</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#LoadComposite.eqvs">
    <rdfs:comment xml:lang="en">Reactive load-voltage dependence index (static) (Eqvs). Typical value = 2.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LoadComposite" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">eqvs</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#LoadComposite.h">
    <rdfs:comment xml:lang="en">Inertia constant (H) (&gt;= 0). Typical value = 2,5.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LoadComposite" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">h</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Seconds" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#LoadComposite.lfac">
    <rdfs:comment xml:lang="en">Loading factor (Lfac). The ratio of initial P to motor MVA base. Typical value = 0,8.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LoadComposite" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">lfac</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#LoadComposite.pfrac">
    <rdfs:comment xml:lang="en">Fraction of constant-power load to be represented by this motor model (PFRAC) (greater than or equal to 0,0 and less than or equal to 1,0). Typical value = 0,5.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LoadComposite" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">pfrac</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#LoadDynamics">
    <rdfs:comment xml:lang="en">Load whose behaviour is described by reference to a standard model or by definition of a user-defined model. A standard feature of dynamic load behaviour modelling is the ability to associate the same behaviour to multiple energy consumers by means of a single load definition. The load model is always applied to individual bus loads (energy consumers).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">LoadDynamics</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#IdentifiedObject" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Dynamics.StandardModels.LoadDynamics</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#LoadDynamics.EnergyConsumer">
    <rdfs:comment xml:lang="en">Energy consumer to which this dynamics load model applies.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LoadDynamics" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">EnergyConsumer</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#EnergyConsumer" />
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#LoadGenericNonLinear">
    <rdfs:comment xml:lang="en">Generic non-linear dynamic (GNLD) load. This model can be used in mid-term and long-term voltage stability simulations (i.e., to study voltage collapse), as it can replace a more detailed representation of aggregate load, including induction motors, thermostatically controlled and static loads.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">LoadGenericNonLinear</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#LoadDynamics" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Dynamics.StandardModels.LoadDynamics</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#LoadGenericNonLinear.bs">
    <rdfs:comment xml:lang="en">Steady state voltage index for reactive power (BS).</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LoadGenericNonLinear" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">bs</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#LoadGenericNonLinear.bt">
    <rdfs:comment xml:lang="en">Transient voltage index for reactive power (BT).</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LoadGenericNonLinear" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">bt</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#LoadGenericNonLinear.genericNonLinearLoadModelType">
    <rdfs:comment xml:lang="en">Type of generic non-linear load model.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LoadGenericNonLinear" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">genericNonLinearLoadModelType</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#GenericNonLinearLoadModelKind" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#LoadGenericNonLinear.ls">
    <rdfs:comment xml:lang="en">Steady state voltage index for active power (LS).</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LoadGenericNonLinear" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">ls</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#LoadGenericNonLinear.lt">
    <rdfs:comment xml:lang="en">Transient voltage index for active power (LT).</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LoadGenericNonLinear" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">lt</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#LoadGenericNonLinear.tp">
    <rdfs:comment xml:lang="en">Time constant of lag function of active power (TP) (&gt; 0).</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LoadGenericNonLinear" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">tp</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Seconds" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#LoadGenericNonLinear.tq">
    <rdfs:comment xml:lang="en">Time constant of lag function of reactive power (TQ) (&gt; 0).</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LoadGenericNonLinear" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">tq</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Seconds" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#LoadGroup">
    <rdfs:comment xml:lang="en">The class is the third level in a hierarchical structure for grouping of loads for the purpose of load flow load scaling.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">LoadGroup</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#IdentifiedObject" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.LoadModel</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#LoadModelPartVersion">
    <rdfs:comment xml:lang="en">Load a model part version.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">LoadModelPartVersion</rdfs:label>
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.InfIEC61970.InfPart303.NetworkModelFrames</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Informative</cimdoc:packageTier>
  </owl:Class>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#LoadMotor">
    <rdfs:comment xml:lang="en">Aggregate induction motor load. This model is used to represent a fraction of an ordinary load as "induction motor load". It allows a load that is treated as an ordinary constant power in power flow analysis to be represented by an induction motor in dynamic simulation. This model is intended for representation of aggregations of many motors dispersed through a load represented at a high voltage bus but where there is no information on the characteristics of individual motors. Either a "one-cage" or "two-cage" model of the induction machine can be modelled. Magnetic saturation is not modelled. This model treats a fraction of the constant power part of a load as a motor. During initialisation, the initial power drawn by the motor is set equal to Pfrac times the constant P part of the static load. The remainder of the load is left as a static load. The reactive power demand of the motor is calculated during initialisation as a function of voltage at the load bus. This reactive power demand can be less than or greater than the constant Q component of the load. If the motor's reactive demand is greater than the constant Q component of the load, the model inserts a shunt capacitor at the terminal of the motor to bring its reactive demand down to equal the constant Q reactive load. If an induction motor load model and a static load model are both present for a load, the motor Pfrac is assumed to be subtracted from the power flow constant P load before the static load model is applied. The remainder of the load, if any, is then represented by the static load model.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">LoadMotor</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#IdentifiedObject" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Dynamics.StandardModels.LoadDynamics</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#LoadMotor.LoadAggregate">
    <rdfs:comment xml:lang="en">Aggregate load to which this aggregate motor (dynamic) load belongs.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LoadMotor" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">LoadAggregate</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#LoadAggregate" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#LoadMotor.d">
    <rdfs:comment xml:lang="en">Damping factor (D). Unit = delta P/delta speed. Typical value = 2.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LoadMotor" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">d</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#LoadMotor.h">
    <rdfs:comment xml:lang="en">Inertia constant (H) (greater than or equal to 0). Typical value = 0,4.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LoadMotor" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">h</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Seconds" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#LoadMotor.lfac">
    <rdfs:comment xml:lang="en">Loading factor (Lfac). The ratio of initial P to motor MVA base. Typical value = 0,8.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LoadMotor" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">lfac</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#LoadMotor.lp">
    <rdfs:comment xml:lang="en">Transient reactance (Lp). Typical value = 0,15.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LoadMotor" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">lp</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#LoadMotor.lpp">
    <rdfs:comment xml:lang="en">Subtransient reactance (Lpp). Typical value = 0,15.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LoadMotor" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">lpp</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#LoadMotor.ls">
    <rdfs:comment xml:lang="en">Synchronous reactance (Ls). Typical value = 3,2.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LoadMotor" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">ls</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#LoadMotor.pfrac">
    <rdfs:comment xml:lang="en">Fraction of constant-power load to be represented by this motor model (Pfrac) (greater than or equal to 0,0 and less than or equal to 1,0). Typical value = 0,3.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LoadMotor" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">pfrac</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#LoadMotor.ra">
    <rdfs:comment xml:lang="en">Stator resistance (Ra). Typical value = 0.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LoadMotor" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">ra</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#LoadMotor.tbkr">
    <rdfs:comment xml:lang="en">Circuit breaker operating time (Tbkr) (greater than or equal to 0). Typical value = 0,08.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LoadMotor" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">tbkr</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Seconds" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#LoadMotor.tpo">
    <rdfs:comment xml:lang="en">Transient rotor time constant (Tpo) (greater than or equal to 0). Typical value = 1.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LoadMotor" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">tpo</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Seconds" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#LoadMotor.tppo">
    <rdfs:comment xml:lang="en">Subtransient rotor time constant (Tppo) (greater than or equal to 0). Typical value = 0,02.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LoadMotor" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">tppo</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Seconds" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#LoadMotor.tv">
    <rdfs:comment xml:lang="en">Voltage trip pickup time (Tv) (greater than or equal to 0). Typical value = 0,1.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LoadMotor" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">tv</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Seconds" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#LoadMotor.vt">
    <rdfs:comment xml:lang="en">Voltage threshold for tripping (Vt). Typical value = 0,7.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LoadMotor" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">vt</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#LoadResponseCharacteristic">
    <rdfs:comment xml:lang="en">Models the characteristic response of the load demand due to changes in system conditions such as voltage and frequency. It is not related to demand response. If LoadResponseCharacteristic.exponentModel is True, the exponential voltage or frequency dependent models are specified and used as to calculate active and reactive power components of the load model. The equations to calculate active and reactive power components of the load model are internal to the power flow calculation, hence they use different quantities depending on the use case of the data exchange. The equations for exponential voltage dependent load model injected power are: pInjection= Pnominal* (Voltage/cim:BaseVoltage.nominalVoltage) ** cim: LoadResponseCharacteristic.pVoltageExponent qInjection= Qnominal* (Voltage/cim:BaseVoltage.nominalVoltage) ** cim: LoadResponseCharacteristic.qVoltageExponent Where: 1) * means "multiply" and ** is "raised to power of"; 2) Pnominal and Qnominal represent the active power and reactive power at nominal voltage as any load described by the voltage exponential model shall be given at nominal voltage. This means that EnergyConsumer.p and EnergyConsumer. q are at nominal voltage. 3) After power flow is solved: -pInjection and qInjection correspond to SvPowerflow.p and SvPowerflow.q respectively. - Voltage corresponds to SvVoltage.v at the TopologicalNode where the load is connected.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">LoadResponseCharacteristic</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#IdentifiedObject" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.LoadModel</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#LoadResponseCharacteristic.exponentModel">
    <rdfs:comment xml:lang="en">Indicates the exponential voltage dependency model is to be used. If false, the coefficient model is to be used. The exponential voltage dependency model consist of the attributes: - pVoltageExponent - qVoltageExponent - pFrequencyExponent - qFrequencyExponent. The coefficient model consist of the attributes: - pConstantImpedance - pConstantCurrent - pConstantPower - qConstantImpedance - qConstantCurrent - qConstantPower. The sum of pConstantImpedance, pConstantCurrent and pConstantPower shall equal 1. The sum of qConstantImpedance, qConstantCurrent and qConstantPower shall equal 1.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LoadResponseCharacteristic" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">exponentModel</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#LoadResponseCharacteristic.pConstantCurrent">
    <rdfs:comment xml:lang="en">Portion of active power load modelled as constant current.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LoadResponseCharacteristic" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">pConstantCurrent</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#LoadResponseCharacteristic.pConstantImpedance">
    <rdfs:comment xml:lang="en">Portion of active power load modelled as constant impedance.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LoadResponseCharacteristic" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">pConstantImpedance</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#LoadResponseCharacteristic.pConstantPower">
    <rdfs:comment xml:lang="en">Portion of active power load modelled as constant power.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LoadResponseCharacteristic" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">pConstantPower</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#LoadResponseCharacteristic.pFrequencyExponent">
    <rdfs:comment xml:lang="en">Exponent of per unit frequency effecting active power.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LoadResponseCharacteristic" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">pFrequencyExponent</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#LoadResponseCharacteristic.pVoltageExponent">
    <rdfs:comment xml:lang="en">Exponent of per unit voltage effecting real power.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LoadResponseCharacteristic" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">pVoltageExponent</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#LoadResponseCharacteristic.qConstantCurrent">
    <rdfs:comment xml:lang="en">Portion of reactive power load modelled as constant current.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LoadResponseCharacteristic" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">qConstantCurrent</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#LoadResponseCharacteristic.qConstantImpedance">
    <rdfs:comment xml:lang="en">Portion of reactive power load modelled as constant impedance.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LoadResponseCharacteristic" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">qConstantImpedance</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#LoadResponseCharacteristic.qConstantPower">
    <rdfs:comment xml:lang="en">Portion of reactive power load modelled as constant power.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LoadResponseCharacteristic" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">qConstantPower</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#LoadResponseCharacteristic.qFrequencyExponent">
    <rdfs:comment xml:lang="en">Exponent of per unit frequency effecting reactive power.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LoadResponseCharacteristic" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">qFrequencyExponent</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#LoadResponseCharacteristic.qVoltageExponent">
    <rdfs:comment xml:lang="en">Exponent of per unit voltage effecting reactive power.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LoadResponseCharacteristic" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">qVoltageExponent</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#LoadStatic">
    <rdfs:comment xml:lang="en">General static load. This model represents the sensitivity of the real and reactive power consumed by the load to the amplitude and frequency of the bus voltage.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">LoadStatic</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#IdentifiedObject" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Dynamics.StandardModels.LoadDynamics</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#LoadStatic.LoadAggregate">
