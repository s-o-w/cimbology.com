  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#Reservoir">
    <rdfs:comment xml:lang="en">A water storage facility within a hydro system, including: ponds, lakes, lagoons, and rivers. The storage is usually behind some type of dam.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">Reservoir</rdfs:label>
