    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Informative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#MeasurementCalculatorInput.Measurement">
    <rdfs:comment xml:lang="en">Measurement used as input to a calculation.</rdfs:comment>
