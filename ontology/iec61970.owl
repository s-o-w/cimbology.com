    <rdfs:comment xml:lang="en">Voltage regulator gain (KA) (&gt; 0). Typical value = 45, 62.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ExcIEEEAC3A" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">ka</rdfs:label>
