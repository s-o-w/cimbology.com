  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ExcIEEEST6B.tg">
    <rdfs:comment xml:lang="en">Feedback time constant of inner loop field voltage regulator (TG) (&gt;= 0). Typical value = 0,02.</rdfs:comment>
