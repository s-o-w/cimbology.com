    <rdfs:comment xml:lang="en">Firing circuit time constant (T1) (&gt;= 0). Typical value = 0,004.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ExcIEEEST5B" />
