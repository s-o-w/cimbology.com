  </owl:Class>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#CsPpccControlKind.activePower">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#CsPpccControlKind" />
    <rdfs:comment xml:lang="en">Control is active power control at AC side, at point of common coupling. Target is provided by ACDCConverter.targetPpcc.</rdfs:comment>
