    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">ModelFrameType</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#ModelFrameType" />
