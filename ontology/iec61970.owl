  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#AsynchronousMachineEquivalentCircuit.xlr1">
    <rdfs:comment xml:lang="en">Damper 1 winding leakage reactance.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#AsynchronousMachineEquivalentCircuit" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">xlr1</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#AsynchronousMachineEquivalentCircuit.xlr2">
    <rdfs:comment xml:lang="en">Damper 2 winding leakage reactance.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#AsynchronousMachineEquivalentCircuit" />
