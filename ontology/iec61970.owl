    <rdfs:label xml:lang="en">staticLoadModelType</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#StaticLoadModelKind" />
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#LoadUserDefined">
    <rdfs:comment xml:lang="en">Load whose dynamic behaviour is described by a user-defined model.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">LoadUserDefined</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#LoadDynamics" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Dynamics.UserDefinedModels</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#LoadUserDefined.proprietary">
    <rdfs:comment xml:lang="en">Behaviour is based on a proprietary model as opposed to a detailed model. true = user-defined model is proprietary with behaviour mutually understood by sending and receiving applications and parameters passed as general attributes false = user-defined model is explicitly defined in terms of control blocks and their input and output signals.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LoadUserDefined" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">proprietary</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#Location">
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61968.ttl" />
  </owl:Class>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#LookUpTableFunctionKind">
    <rdfs:comment xml:lang="en">The look up table function kind enum</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">LookUpTableFunctionKind</rdfs:label>
    <owl:equivalentClass rdf:nodeID="oneOfClass_LookUpTableFunctionKind" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Dynamics.StandardModels.InfHVDCDynamics</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Informative</cimdoc:packageTier>
  </owl:Class>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#LookUpTableFunctionKind.additionalQcurrent">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#LookUpTableFunctionKind" />
    <rdfs:comment xml:lang="en">The additional qcurrent look up table function kind</rdfs:comment>
