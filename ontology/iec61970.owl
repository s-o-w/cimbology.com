  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ExcAC8B.inlim">
    <rdfs:comment xml:lang="en">Input limiter indicator. true = input limiter Vimax and Vimin is considered false = input limiter Vimax and Vimin is not considered. Typical value = true.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ExcAC8B" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
