    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#ICCPQualityKind" />
    <rdfs:comment xml:lang="en">Indicates that only quality is to be provided.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">qualityOnly</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</cimdoc:enumCode>
  </owl:NamedIndividual>
