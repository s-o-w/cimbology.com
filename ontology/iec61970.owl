  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#PssRQB">
    <rdfs:comment xml:lang="en">Power system stabilizer type RQB. This power system stabilizer is intended to be used together with excitation system type ExcRQB, which is primarily used in nuclear or thermal generating units.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">PssRQB</rdfs:label>
