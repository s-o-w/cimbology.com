  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ExcST6B.vimax">
    <rdfs:comment xml:lang="en">Maximum voltage regulator input limit (Vimax) (greater than ExcST6B.vimin). Typical value = 10.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ExcST6B" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
