  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#UnitSymbol.therm">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#UnitSymbol" />
    <rdfs:comment xml:lang="en">Energy, therms.</rdfs:comment>
