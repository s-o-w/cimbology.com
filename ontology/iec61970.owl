  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#DataSet.Profile">
    <rdfs:comment xml:lang="en">The profile that describes the contents of the dataset and its governing rules.</rdfs:comment>
