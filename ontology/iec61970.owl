  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#HeatRecoveryBoiler">
    <rdfs:comment xml:lang="en">The heat recovery system associated with combustion turbines in order to produce steam for combined cycle plants.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">HeatRecoveryBoiler</rdfs:label>
