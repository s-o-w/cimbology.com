    <rdfs:comment xml:lang="en">Rated field voltage if m = false or rated field current if m = true (EFDRATED). Typical value = 1,05.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#OverexcLimX2" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
