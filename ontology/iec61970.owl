  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#GovHydroPelton.hn">
    <rdfs:comment xml:lang="en">Rated hydraulic head (Hn). Unit = km. Typical value = 0,250.</rdfs:comment>
