  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#GovGAST1.a">
    <rdfs:comment xml:lang="en">Turbine power time constant numerator scale factor (a). Typical value = 0,8.</rdfs:comment>
