    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#SinglePhaseKind.A">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#SinglePhaseKind" />
