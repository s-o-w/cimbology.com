  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ExcSK.emax">
    <rdfs:comment xml:lang="en">Maximum field voltage output (Emax) (&gt; ExcSK.emin). Typical value = 20.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ExcSK" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
