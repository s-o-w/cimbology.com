    <rdfs:comment xml:lang="en">Maximum voltage regulator output (VAMAX) (greater than 0). Typical value = 14,5.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ExcIEEEST1A" />
