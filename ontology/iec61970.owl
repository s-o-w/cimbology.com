    <rdfs:comment xml:lang="en">Voltage regulator proportional gain output (Kpm). Typical value = 1.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ExcST4B" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">kpm</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ExcST4B.kpr">
    <rdfs:comment xml:lang="en">Voltage regulator proportional gain (Kpr). Typical value = 10,75.</rdfs:comment>
