    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">dependencyType</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#DependencyKind" />
  </owl:ObjectProperty>
  <rdfs:Datatype rdf:about="http://iec.ch/TC57/CIM100#ApparentPower">
    <rdfs:comment xml:lang="en">Product of the RMS value of the voltage and the RMS value of the current.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">ApparentPower</rdfs:label>
    <owl:equivalentClass rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.Domain</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
    <cimdoc:unitSymbol rdf:resource="http://iec.ch/TC57/CIM100#UnitSymbol.VA" />
  </rdfs:Datatype>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#ApparentPowerLimit">
    <rdfs:comment xml:lang="en">Apparent power limit.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">ApparentPowerLimit</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#OperationalLimit" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.OperationalLimits</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ApparentPowerLimit.normalValue">
    <rdfs:comment xml:lang="en">The normal apparent power limit. The attribute shall be a positive value or zero.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ApparentPowerLimit" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">normalValue</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#ApparentPower" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ApparentPowerLimit.value">
    <rdfs:comment xml:lang="en">The apparent power limit. The attribute shall be a positive value or zero.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ApparentPowerLimit" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">value</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#ApparentPower" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#ApplicationSecurityKind">
    <rdfs:comment xml:lang="en">Specifies the expected security mechanism, per IEC 62351-4, to be utilized.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">ApplicationSecurityKind</rdfs:label>
    <owl:equivalentClass rdf:nodeID="oneOfClass_ApplicationSecurityKind" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.ICCPConfiguration</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#ApplicationSecurityKind.endToEndSecure">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#ApplicationSecurityKind" />
    <rdfs:comment xml:lang="en">Indicates that E2E-security shall be used in order to allow establishment of an MMS association.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">endToEndSecure</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#ApplicationSecurityKind.nonSecure">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#ApplicationSecurityKind" />
    <rdfs:comment xml:lang="en">Indicates that an application security shall not be used in order to allow establishment of an MSS association.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">nonSecure</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#ApplicationSecurityKind.secure">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#ApplicationSecurityKind" />
    <rdfs:comment xml:lang="en">Indicates that the A-security-profile as specified in Clause 11 (or IEC TS 62351-4:2007) shall be used in order to allow establishment of an MMS association.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">secure</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</cimdoc:enumCode>
  </owl:NamedIndividual>
  <rdfs:Datatype rdf:about="http://iec.ch/TC57/CIM100#Area">
    <rdfs:comment xml:lang="en">Area.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">Area</rdfs:label>
    <owl:equivalentClass rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.Domain</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
    <cimdoc:unitSymbol rdf:resource="http://iec.ch/TC57/CIM100#UnitSymbol.m2" />
  </rdfs:Datatype>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#AssemblyDescription">
    <rdfs:comment xml:lang="en">A description for how to assemble model parts for a specific purpose.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">AssemblyDescription</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#IdentifiedObject" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.InfIEC61970.InfPart303.NetworkModelFrames</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Informative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#AssemblyDescription.ModelSpecification">
    <rdfs:comment xml:lang="en">The models that are part of the assembly descrption.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#AssemblyDescription" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">ModelSpecification</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#ModelPartSpecification" />
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#AssemblyManifest">
    <rdfs:comment xml:lang="en">A collection of model parts when combined form a case or part of a case.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">AssemblyManifest</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#IdentifiedObject" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.InfIEC61970.InfPart303.NetworkModelFrames</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Informative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#AssemblyManifest.m_CompleteModelToBeDeleted">
    <rdfs:comment xml:lang="en">The complete model to be deleted, if any, associated with this assembly manifest.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#AssemblyManifest" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">m_CompleteModelToBeDeleted</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#CompleteModelToBeDeleted" />
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#AsynchronousMachine">
    <rdfs:comment xml:lang="en">A rotating machine whose shaft rotates asynchronously with the electrical field. Also known as an induction machine with no external connection to the rotor windings, e.g. squirrel-cage induction machine.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">AsynchronousMachine</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#RotatingMachine" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.Wires</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#AsynchronousMachine.asynchronousMachineType">
    <rdfs:comment xml:lang="en">Indicates the type of Asynchronous Machine (motor or generator).</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#AsynchronousMachine" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">asynchronousMachineType</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#AsynchronousMachineKind" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#AsynchronousMachine.converterFedDrive">
    <rdfs:comment xml:lang="en">Indicates whether the machine is a converter fed drive. Used for short circuit data exchange according to IEC 60909.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#AsynchronousMachine" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">converterFedDrive</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#AsynchronousMachine.efficiency">
    <rdfs:comment xml:lang="en">Efficiency of the asynchronous machine at nominal operation as a percentage. Indicator for converter drive motors. Used for short circuit data exchange according to IEC 60909.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#AsynchronousMachine" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">efficiency</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PerCent" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#AsynchronousMachine.iaIrRatio">
    <rdfs:comment xml:lang="en">Ratio of locked-rotor current to the rated current of the motor (Ia/Ir). Used for short circuit data exchange according to IEC 60909.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#AsynchronousMachine" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">iaIrRatio</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#AsynchronousMachine.nominalFrequency">
    <rdfs:comment xml:lang="en">Nameplate data indicates if the machine is 50 Hz or 60 Hz.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#AsynchronousMachine" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">nominalFrequency</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Frequency" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#AsynchronousMachine.nominalSpeed">
    <rdfs:comment xml:lang="en">Nameplate data. Depends on the slip and number of pole pairs.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#AsynchronousMachine" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">nominalSpeed</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#RotationSpeed" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#AsynchronousMachine.polePairNumber">
    <rdfs:comment xml:lang="en">Number of pole pairs of stator. Used for short circuit data exchange according to IEC 60909.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#AsynchronousMachine" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">polePairNumber</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#AsynchronousMachine.ratedMechanicalPower">
    <rdfs:comment xml:lang="en">Rated mechanical power (Pr in IEC 60909-0). Used for short circuit data exchange according to IEC 60909.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#AsynchronousMachine" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">ratedMechanicalPower</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#ActivePower" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#AsynchronousMachine.reversible">
    <rdfs:comment xml:lang="en">Indicates for converter drive motors if the power can be reversible. Used for short circuit data exchange according to IEC 60909.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#AsynchronousMachine" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">reversible</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#AsynchronousMachine.rr1">
    <rdfs:comment xml:lang="en">Damper 1 winding resistance.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#AsynchronousMachine" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">rr1</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Resistance" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#AsynchronousMachine.rr2">
    <rdfs:comment xml:lang="en">Damper 2 winding resistance.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#AsynchronousMachine" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">rr2</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Resistance" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#AsynchronousMachine.rxLockedRotorRatio">
    <rdfs:comment xml:lang="en">Locked rotor ratio (R/X). Used for short circuit data exchange according to IEC 60909.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#AsynchronousMachine" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">rxLockedRotorRatio</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#AsynchronousMachine.tpo">
    <rdfs:comment xml:lang="en">Transient rotor time constant (greater than tppo).</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#AsynchronousMachine" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">tpo</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Seconds" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#AsynchronousMachine.tppo">
    <rdfs:comment xml:lang="en">Sub-transient rotor time constant (greater than 0).</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#AsynchronousMachine" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">tppo</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Seconds" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#AsynchronousMachine.xlr1">
    <rdfs:comment xml:lang="en">Damper 1 winding leakage reactance.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#AsynchronousMachine" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">xlr1</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Reactance" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#AsynchronousMachine.xlr2">
    <rdfs:comment xml:lang="en">Damper 2 winding leakage reactance.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#AsynchronousMachine" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">xlr2</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Reactance" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#AsynchronousMachine.xm">
    <rdfs:comment xml:lang="en">Magnetizing reactance.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#AsynchronousMachine" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">xm</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Reactance" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#AsynchronousMachine.xp">
    <rdfs:comment xml:lang="en">Transient reactance (unsaturated) (greater than or equal to xpp).</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#AsynchronousMachine" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">xp</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Reactance" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#AsynchronousMachine.xpp">
    <rdfs:comment xml:lang="en">Sub-transient reactance (unsaturated).</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#AsynchronousMachine" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">xpp</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Reactance" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#AsynchronousMachine.xs">
    <rdfs:comment xml:lang="en">Synchronous reactance (greater than xp).</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#AsynchronousMachine" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">xs</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Reactance" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#AsynchronousMachineDynamics">
    <rdfs:comment xml:lang="en">Asynchronous machine whose behaviour is described by reference to a standard model expressed in either time constant reactance form or equivalent circuit form or by definition of a user-defined model. Parameter details: - Asynchronous machine parameters such as Xl, Xs, etc. are actually used as inductances in the model, but are commonly referred to as reactances since, at nominal frequency, the PU values are the same. However, some references use the symbol L instead of X.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">AsynchronousMachineDynamics</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#RotatingMachineDynamics" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Dynamics.StandardModels.AsynchronousMachineDynamics</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#AsynchronousMachineDynamics.AsynchronousMachine">
    <rdfs:comment xml:lang="en">Asynchronous machine to which this asynchronous machine dynamics model applies.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#AsynchronousMachineDynamics" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">AsynchronousMachine</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#AsynchronousMachine" />
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#AsynchronousMachineEquivalentCircuit">
    <rdfs:comment xml:lang="en">The electrical equations of all variations of the asynchronous model are based on the AsynchronousEquivalentCircuit diagram for the direct- and quadrature- axes, with two equivalent rotor windings in each axis. Equations for conversion between equivalent circuit and time constant reactance forms: Xs = Xm + Xl X' = Xl + Xm x Xlr1 / (Xm + Xlr1) X'' = Xl + Xm x Xlr1 x Xlr2 / (Xm x Xlr1 + Xm x Xlr2 + Xlr1 x Xlr2) T'o = (Xm + Xlr1) / (omega0 x Rr1) T''o = (Xm x Xlr1 + Xm x Xlr2 + Xlr1 x Xlr2) / (omega0 x Rr2 x (Xm + Xlr1) Same equations using CIM attributes from AsynchronousMachineTimeConstantReactance class on left of "=" and AsynchronousMachineEquivalentCircuit class on right (except as noted): xs = xm + RotatingMachineDynamics.statorLeakageReactance xp = RotatingMachineDynamics.statorLeakageReactance + xm x xlr1 / (xm + xlr1) xpp = RotatingMachineDynamics.statorLeakageReactance + xm x xlr1 x xlr2 / (xm x xlr1 + xm x xlr2 + xlr1 x xlr2) tpo = (xm + xlr1) / (2 x pi x nominal frequency x rr1) tppo = (xm x xlr1 + xm x xlr2 + xlr1 x xlr2) / (2 x pi x nominal frequency x rr2 x (xm + xlr1).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">AsynchronousMachineEquivalentCircuit</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#AsynchronousMachineDynamics" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Dynamics.StandardModels.AsynchronousMachineDynamics</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#AsynchronousMachineEquivalentCircuit.rr1">
    <rdfs:comment xml:lang="en">Damper 1 winding resistance.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#AsynchronousMachineEquivalentCircuit" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
