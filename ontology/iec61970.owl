  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ExcIEEEST5B.tob2">
    <rdfs:comment xml:lang="en">OEL lag time constant (TOB2) (&gt;= 0). Typical value = 0,08.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ExcIEEEST5B" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">tob2</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Seconds" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ExcIEEEST5B.toc1">
    <rdfs:comment xml:lang="en">OEL lead time constant (TOC1) (&gt;= 0). Typical value = 0,1.</rdfs:comment>
