    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Seconds" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ExcIEEEST5B.tuc1">
    <rdfs:comment xml:lang="en">UEL lead time constant (TUC1) (&gt;= 0). Typical value = 2.</rdfs:comment>
