  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ExcST4B.vrmax">
    <rdfs:comment xml:lang="en">Maximum voltage regulator output (Vrmax) (greater than 0). Typical value = 1.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ExcST4B" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
