  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ExcIEEEST3A.tm">
    <rdfs:comment xml:lang="en">Forward time constant of inner loop field regulator (TM) (&gt; 0). Typical value = 0,4.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ExcIEEEST3A" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">tm</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Seconds" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ExcIEEEST3A.vbmax">
    <rdfs:comment xml:lang="en">Maximum excitation voltage (VBMax) (&gt; 0). Typical value = 6,9.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ExcIEEEST3A" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">vbmax</rdfs:label>
