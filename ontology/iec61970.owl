    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#CurrentLimit.normalValue">
    <rdfs:comment xml:lang="en">The normal value for limit on current flow. The attribute shall be a positive value or zero.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#CurrentLimit" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">normalValue</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#CurrentFlow" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#CurrentLimit.value">
    <rdfs:comment xml:lang="en">Limit on current flow. The attribute shall be a positive value or zero.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#CurrentLimit" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">value</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#CurrentFlow" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#CurrentRelay">
