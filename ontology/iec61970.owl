    <rdfs:comment xml:lang="en">Not available.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">unavailable</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#GenericDataSetVersion">
    <rdfs:comment xml:lang="en">Represents a version of a generic data set, including major and minor versioning details.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">GenericDataSetVersion</rdfs:label>
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.InfIEC61970.Part303.GenericDataSet</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Informative</cimdoc:packageTier>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#GenericDataSetVersion.majorVersion">
    <rdfs:comment xml:lang="en">The universal CIM version name describing a consistent set of packages.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#GenericDataSetVersion" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">majorVersion</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#GenericDataSetVersion.minorVersion">
    <rdfs:comment xml:lang="en">Describes minor updates and error corrections.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#GenericDataSetVersion" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">minorVersion</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#GenericDataSetVersion.published">
    <rdfs:comment xml:lang="en">The date when the complete CIM canonical model is published and made available for use. After publication the major version and namespace are updated.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#GenericDataSetVersion" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">published</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#GenericNonLinearLoadModelKind">
    <rdfs:comment xml:lang="en">Type of generic non-linear load model.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">GenericNonLinearLoadModelKind</rdfs:label>
    <owl:equivalentClass rdf:nodeID="oneOfClass_GenericNonLinearLoadModelKind" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Dynamics.StandardModels.LoadDynamics</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#GenericNonLinearLoadModelKind.exponentialRecovery">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#GenericNonLinearLoadModelKind" />
    <rdfs:comment xml:lang="en">Exponential recovery model.</rdfs:comment>
