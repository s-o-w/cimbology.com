  </rdfs:Datatype>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#InflowForecast">
    <rdfs:comment xml:lang="en">Natural water inflow to a reservoir, usually forecasted from predicted rain and snowmelt. Typically in one hour increments for up to 10 days. The forecast is given in average cubic meters per second over the time increment.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">InflowForecast</rdfs:label>
