  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#GovCT2.kturb">
    <rdfs:comment xml:lang="en">Turbine gain (Kturb). Typical value = 1,9168.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#GovCT2" />
