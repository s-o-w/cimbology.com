    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#LoadStatic.kp4">
    <rdfs:comment xml:lang="en">Frequency coefficient for active power (Kp4) (not = 0 if .staticLoadModelType = zIP2). Used only when .staticLoadModelType = zIP2.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LoadStatic" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">kp4</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
