  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#ExcIEEEST6B">
    <rdfs:comment xml:lang="en">IEEE 421.5-2005 type ST6B model. This model consists of a PI voltage regulator with an inner loop field voltage regulator and pre-control. The field voltage regulator implements a proportional control. The pre-control and the delay in the feedback circuit increase the dynamic response. Reference: IEEE 421.5-2005, 7.6.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">ExcIEEEST6B</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#ExcitationSystemDynamics" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Dynamics.StandardModels.ExcitationSystemDynamics</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ExcIEEEST6B.ilr">
    <rdfs:comment xml:lang="en">Exciter output current limit reference (ILR) (&gt; 0). Typical value = 4,164.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ExcIEEEST6B" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">ilr</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ExcIEEEST6B.kci">
    <rdfs:comment xml:lang="en">Exciter output current limit adjustment (KCI) (&gt; 0). Typical value = 1,0577.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ExcIEEEST6B" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">kci</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ExcIEEEST6B.kff">
    <rdfs:comment xml:lang="en">Pre-control gain constant of the inner loop field regulator (KFF). Typical value = 1.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ExcIEEEST6B" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">kff</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ExcIEEEST6B.kg">
    <rdfs:comment xml:lang="en">Feedback gain constant of the inner loop field regulator (KG) (&gt;= 0). Typical value = 1.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ExcIEEEST6B" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">kg</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ExcIEEEST6B.kia">
    <rdfs:comment xml:lang="en">Voltage regulator integral gain (KIA) (&gt; 0). Typical value = 45,094.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ExcIEEEST6B" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">kia</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ExcIEEEST6B.klr">
    <rdfs:comment xml:lang="en">Exciter output current limiter gain (KLR) (&gt; 0). Typical value = 17,33.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ExcIEEEST6B" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">klr</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ExcIEEEST6B.km">
    <rdfs:comment xml:lang="en">Forward gain constant of the inner loop field regulator (KM). Typical value = 1.</rdfs:comment>
