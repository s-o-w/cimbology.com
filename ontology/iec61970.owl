  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#ICCPInformationMessage">
    <rdfs:comment xml:lang="en">This class represents the TASE.2 Information Message Object. The IdentifiedObject.name attribute must be non-null. The value of the attribute shall be used as the TASE.2 Information Reference, as specified by 60870-6-503.</rdfs:comment>
