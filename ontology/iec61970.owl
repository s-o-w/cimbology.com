  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#UnderexcLimIEEE1.kui">
    <rdfs:comment xml:lang="en">UEL integral gain (KUI). Typical value = 0.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#UnderexcLimIEEE1" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
