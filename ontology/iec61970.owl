  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#PerLengthSequenceImpedance.gch">
    <rdfs:comment xml:lang="en">Positive sequence shunt (charging) conductance, per unit of length.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#PerLengthSequenceImpedance" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">gch</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#ConductancePerLength" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#PerLengthSequenceImpedance.r">
    <rdfs:comment xml:lang="en">Positive sequence series resistance, per unit of length.</rdfs:comment>
