  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ExcST6B.klr">
    <rdfs:comment xml:lang="en">Exciter output current limit adjustment (Kcl) (&gt; 0). Typical value = 17, 33.</rdfs:comment>
