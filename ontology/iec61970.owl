  </owl:Class>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#CurrentTransformer">
    <rdfs:comment xml:lang="en">Instrument transformer used to measure electrical qualities of the circuit that is being protected and/or monitored. Typically used as current transducer for the purpose of metering or protection. A typical secondary current rating would be 5A.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">CurrentTransformer</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#Sensor" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.AuxiliaryEquipment</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#CurrentTransformer.accuracyClass">
    <rdfs:comment xml:lang="en">CT accuracy classification.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#CurrentTransformer" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">accuracyClass</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#CurrentTransformer.accuracyLimit">
    <rdfs:comment xml:lang="en">Percent of rated current for which the CT remains accurate within specified limits.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#CurrentTransformer" />
