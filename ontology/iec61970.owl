    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#PotentialTransformer" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">nominalRatio</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#PotentialTransformer.ptClass">
    <rdfs:comment xml:lang="en">Potential transformer (PT) classification covering burden.</rdfs:comment>
