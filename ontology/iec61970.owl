  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#PhaseTapChangerTablePoint.PhaseTapChangerTable">
    <rdfs:comment xml:lang="en">The table of this point.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#PhaseTapChangerTablePoint" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
