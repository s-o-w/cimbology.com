  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#SolarGeneratingUnit">
    <rdfs:comment xml:lang="en">A solar thermal generating unit, connected to the grid by means of a rotating machine. This class does not represent photovoltaic (PV) generation.</rdfs:comment>
