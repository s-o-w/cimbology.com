    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PhaseTapChangerTable" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#PhaseTapChangerTablePoint.angle">
    <rdfs:comment xml:lang="en">The angle difference in degrees. A positive value indicates a positive angle variation from the Terminal at the PowerTransformerEnd, where the TapChanger is located, into the transformer.</rdfs:comment>
