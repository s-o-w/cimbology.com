    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Seconds" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#Pss5.vadat">
    <rdfs:comment xml:lang="en">Signal selector (VadAtt). true = closed (generator power is greater than Pmin) false = open (Pe is smaller than Pmin). Typical value = true.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#Pss5" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">vadat</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#Pss5.vsmn">
    <rdfs:comment xml:lang="en">Stabilizer output maximum limit (VSMN). Typical value = -0,1.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#Pss5" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">vsmn</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#Pss5.vsmx">
    <rdfs:comment xml:lang="en">Stabilizer output minimum limit (VSMX). Typical value = 0,1.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#Pss5" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">vsmx</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#PssELIN2">
    <rdfs:comment xml:lang="en">Power system stabilizer typically associated with ExcELIN2 (though PssIEEE2B or Pss2B can also be used).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">PssELIN2</rdfs:label>
