    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.Meas</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#MeasurementValueSource">
    <rdfs:comment xml:lang="en">MeasurementValueSource describes the alternative sources updating a MeasurementValue. User conventions for how to use the MeasurementValueSource attributes are defined in IEC 61970-301.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">MeasurementValueSource</rdfs:label>
