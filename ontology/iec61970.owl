  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#DataSet.description">
    <rdfs:comment xml:lang="en">A free human readable text describing or naming the object. May be non-unique and not necessarily correlate to a naming hierarchy.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#DataSet" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">description</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#DataSet.mRID">
    <rdfs:comment xml:lang="en">Master resource identifier issued by a model authority. The mRID is unique within an exchange context and it is recommended to be a UUID (RFC 4122).</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#DataSet" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">mRID</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#DataSet.name">
    <rdfs:comment xml:lang="en">Any free human readable text naming the object. May be non-unique.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#DataSet" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">name</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#DatasetArg">
    <rdfs:comment xml:lang="en">A model operation argument referencing a dataset instance.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
