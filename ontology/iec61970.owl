  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#HydroPlantStorageKind.runOfRiver">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#HydroPlantStorageKind" />
    <rdfs:comment xml:lang="en">Run of river.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
