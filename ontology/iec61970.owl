    <rdfs:comment xml:lang="en">Time to trip the exciter at the low voltage or current point on the inverse time characteristic (TIME1) (&gt;= 0). Typical value = 120.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#OverexcLimX2" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
