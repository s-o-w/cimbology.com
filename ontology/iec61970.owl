    <rdfs:label xml:lang="en">additionalQcurrent</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#LookUpTableFunctionKind.vdcol">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#LookUpTableFunctionKind" />
    <rdfs:comment xml:lang="en">The vdcol look up table function kind</rdfs:comment>
