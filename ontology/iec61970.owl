  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#SynchronousMachineKind">
    <rdfs:comment xml:lang="en">Synchronous machine type.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">SynchronousMachineKind</rdfs:label>
    <owl:equivalentClass rdf:nodeID="oneOfClass_SynchronousMachineKind" />
