  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#GovHydro3.k1">
    <rdfs:comment xml:lang="en">Derivative gain (K1). Typical value = 0,01.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#GovHydro3" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">k1</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
