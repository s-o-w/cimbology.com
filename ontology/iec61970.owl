    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#GateInputPin" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#Gate.PinGate">
    <rdfs:comment xml:lang="en">The pin gate associated with this gate.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#Gate" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
