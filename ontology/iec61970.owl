    <rdfs:comment xml:lang="en">Minimum error (UImin) (&lt; ExcSK.uimax). Typical value = -10.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ExcSK" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">uimin</rdfs:label>
