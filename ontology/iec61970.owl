  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#EnergyConsumerPhase.p">
    <rdfs:comment xml:lang="en">Active power of the load. Load sign convention is used, i.e. positive sign means flow out from a node. For voltage dependent loads the value is at rated voltage. Starting value for a steady state solution.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#EnergyConsumerPhase" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">p</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#ActivePower" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#EnergyConsumerPhase.pfixed">
    <rdfs:comment xml:lang="en">Active power of the load that is a fixed quantity. Load sign convention is used, i.e. positive sign means flow out from a node.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#EnergyConsumerPhase" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">pfixed</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#ActivePower" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#EnergyConsumerPhase.pfixedPct">
    <rdfs:comment xml:lang="en">Fixed active power as per cent of load group fixed active power. Load sign convention is used, i.e. positive sign means flow out from a node.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#EnergyConsumerPhase" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">pfixedPct</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PerCent" />
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#EnergyConsumerPhase.phase">
    <rdfs:comment xml:lang="en">Phase of this energy consumer component. If the energy consumer is wye connected, the connection is from the indicated phase to the central ground or neutral point. If the energy consumer is delta connected, the phase indicates an energy consumer connected from the indicated phase to the next logical non- neutral phase.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#EnergyConsumerPhase" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">phase</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#SinglePhaseKind" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#EnergyConsumerPhase.q">
    <rdfs:comment xml:lang="en">Reactive power of the load. Load sign convention is used, i.e. positive sign means flow out from a node. For voltage dependent loads the value is at rated voltage. Starting value for a steady state solution.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#EnergyConsumerPhase" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">q</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#ReactivePower" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#EnergyConsumerPhase.qfixed">
    <rdfs:comment xml:lang="en">Reactive power of the load that is a fixed quantity. Load sign convention is used, i.e. positive sign means flow out from a node.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#EnergyConsumerPhase" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">qfixed</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#ReactivePower" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#EnergyConsumerPhase.qfixedPct">
    <rdfs:comment xml:lang="en">Fixed reactive power as per cent of load group fixed reactive power. Load sign convention is used, i.e. positive sign means flow out from a node.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#EnergyConsumerPhase" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">qfixedPct</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PerCent" />
  </owl:DatatypeProperty>
