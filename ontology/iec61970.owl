  <rdfs:Datatype rdf:about="http://iec.ch/TC57/CIM100#Damping">
    <rdfs:comment xml:lang="en">Per-unit active power variation with frequency referenced on the system apparent power base. Typical values are in the range 1,0 - 2,0.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">Damping</rdfs:label>
