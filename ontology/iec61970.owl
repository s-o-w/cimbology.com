    <rdfs:comment xml:lang="en">Reactance associated with potential source (Xl) (greater than or equal to 0). Typical value = 0,124.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ExcST4B" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
