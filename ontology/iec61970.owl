  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#EmissionType.sulfurDioxide">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#EmissionType" />
    <rdfs:comment xml:lang="en">Sulfur dioxide.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">sulfurDioxide</rdfs:label>
