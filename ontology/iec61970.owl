    <rdfs:comment xml:lang="en">Time constant (TD) (&gt;= 0). Typical value = 0,03.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#DiscExcContIEEEDEC1A" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
