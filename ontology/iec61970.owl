  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ExcST4B.vrmin">
    <rdfs:comment xml:lang="en">Minimum voltage regulator output (Vrmin) (less than 0). Typical value = -0,87.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ExcST4B" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
