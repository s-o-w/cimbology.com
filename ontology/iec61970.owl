    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Informative</cimdoc:packageTier>
  </owl:Class>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#ProjectAlternative">
    <rdfs:comment xml:lang="en">Project B is an alternative to project A. Project A is the primary alternative. Multiple project alternatives should not be selected into a single network study case.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">ProjectAlternative</rdfs:label>
