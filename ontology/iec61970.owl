    <rdfs:comment xml:lang="en">Ramp rate for frequency-dependent power limit (Prate). Typical value = 0,017.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#GovCT2" />
