    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#ICCPVirtualControlCentre">
    <rdfs:comment xml:lang="en">This contains the information that a particular actor exposes for a particular agreed upon ICCP Bilateral Table.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">ICCPVirtualControlCentre</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#BilateralExchangeActor" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.ICCPConfiguration</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#ICCPVirtualControlCentre.applicationSecurityRequirement">
    <rdfs:comment xml:lang="en">Specifies the expected security mechanism, per IEC 62351-4, to be utilized.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ICCPVirtualControlCentre" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">applicationSecurityRequirement</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#ApplicationSecurityKind" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ICCPVirtualControlCentre.calling">
    <rdfs:comment xml:lang="en">Used to indicate if the Provider is responsible for initiating the TASE.2 connection. If the value is TRUE, the provider is responsible for establishing the association. If the value is FALSE, the peer provider of the Bilateral Table will need to establish the association.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ICCPVirtualControlCentre" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">calling</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ICCPVirtualControlCentre.clientAndServer">
    <rdfs:comment xml:lang="en">If True the value indicates that the entity represented by the bilateral table is capable of issuing requests and responding to request (e.g. bidirectional support of ICCP requests). If False, this indicates that a calling entity (e.g. calling = True) will not be able to respond to ICCP requests. If False, and calling=False, this indicates that the entity will only respond to ICCP requests and not issue ICCP requests.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ICCPVirtualControlCentre" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">clientAndServer</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ICCPVirtualControlCentre.minimumUpdateInterval">
    <rdfs:comment xml:lang="en">Specifies the fastest update interval that can be provided for integrity information and Transfer Set creation. The value is in seconds.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ICCPVirtualControlCentre" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">minimumUpdateInterval</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ICCPVirtualControlCentre.nameOfLocalICC">
    <rdfs:comment xml:lang="en">Specifies the ICC scope name that the remote can use to access the information in the Bilateral Table if the information is not VCC scoped. This value may not be null.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ICCPVirtualControlCentre" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">nameOfLocalICC</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ICCPVirtualControlCentre.supportForBlock1">
    <rdfs:comment xml:lang="en">Per IEC 60870-6-702: If true indicates support for basic services. Must always be true.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ICCPVirtualControlCentre" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">supportForBlock1</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ICCPVirtualControlCentre.supportForBlock2">
    <rdfs:comment xml:lang="en">Per IEC 60870-6-702: If true indicates support for extended conditions.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ICCPVirtualControlCentre" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">supportForBlock2</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ICCPVirtualControlCentre.supportForBlock3">
    <rdfs:comment xml:lang="en">Per IEC 60870-6-702: If true indicates support for blocked transfers.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ICCPVirtualControlCentre" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">supportForBlock3</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ICCPVirtualControlCentre.supportForBlock4">
    <rdfs:comment xml:lang="en">Per IEC 60870-6-702: If true indicates support for information messages.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ICCPVirtualControlCentre" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">supportForBlock4</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ICCPVirtualControlCentre.supportForBlock5">
    <rdfs:comment xml:lang="en">Per IEC 60870-6-702: If true indicates support for device control.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ICCPVirtualControlCentre" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">supportForBlock5</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ICCPVirtualControlCentre.supportForDepriciatedBlock8">
    <rdfs:comment xml:lang="en">Per IEC 60870-6-702: If true indicates support for accounts. The use of this block was deprecated in Edition 3.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ICCPVirtualControlCentre" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">supportForDepriciatedBlock8</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ICCPVirtualControlCentre.transportSecurityRequirement">
    <rdfs:comment xml:lang="en">If true, then transport level security as specified by IEC 62351-6 is required.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ICCPVirtualControlCentre" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">transportSecurityRequirement</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#IEC61970CIMVersion">
    <rdfs:comment xml:lang="en">This is the IEC 61970 CIM version number assigned to this UML model.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">IEC61970CIMVersion</rdfs:label>
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#IEC61970CIMVersion.Date">
    <rdfs:comment xml:lang="en">Form is YYYY-MM-DD for example for January 5, 2009 it is 2009-01-05.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#IEC61970CIMVersion" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">Date</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#IEC61970CIMVersion.version">
    <rdfs:comment xml:lang="en">Form is IEC61970CIMXXvYY where XX is the major CIM package version and the YY is the minor version. For example IEC61970CIM13v18.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#IEC61970CIMVersion" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">version</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#IOPoint">
    <rdfs:comment xml:lang="en">The class describe a measurement or control value. The purpose is to enable having attributes and associations common for measurement and control.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">IOPoint</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#IdentifiedObject" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.Meas</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#IOPoint.BilateralToIOPoint">
    <rdfs:comment xml:lang="en">Bilateral ICCP point for the measurement or control.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#IOPoint" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">BilateralToIOPoint</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#ProvidedBilateralPoint" />
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#IOPointSource">
    <rdfs:comment xml:lang="en">Indicates the point source for an IO Point.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">IOPointSource</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#MeasurementValueSource" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.ICCPConfiguration</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#IOPointSource.IOPoint">
    <rdfs:comment xml:lang="en">ICCP point for a local measurement value source.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#IOPointSource" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">IOPoint</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#IOPoint" />
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#IPAccessPoint">
    <rdfs:comment xml:lang="en">Internet Protocol Access Point � used to represent an addressing structure is based upon an Internet Protocol (IP) address.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">IPAccessPoint</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#CommunicationLink" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.ICCPConfiguration</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#IPAccessPoint.address">
    <rdfs:comment xml:lang="en">Is the dotted decimal IP Address resolve the IP address. The format is controlled by the value of the addressType.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#IPAccessPoint" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">address</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#IPAccessPoint.addressType">
    <rdfs:comment xml:lang="en">IP address type.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#IPAccessPoint" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">addressType</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#IPAddressKind" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#IPAccessPoint.gateway">
    <rdfs:comment xml:lang="en">Is the dotted decimal IPAddress of the first hop router. Format is controlled by the addressType.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#IPAccessPoint" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">gateway</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#IPAccessPoint.subnet">
    <rdfs:comment xml:lang="en">This is the IP subnet mask which controls the local vs non-local routing.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#IPAccessPoint" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">subnet</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#IPAddressKind">
    <rdfs:comment xml:lang="en">Indicates if the addressing of the IPAccessPoint, gateway, and subnet are per IPv4 or IPv6.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">IPAddressKind</rdfs:label>
    <owl:equivalentClass rdf:nodeID="oneOfClass_IPAddressKind" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.ICCPConfiguration</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#IPAddressKind.iPv4">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#IPAddressKind" />
    <rdfs:comment xml:lang="en">Indicates that IPv4 dotted decimal notation is in use.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">iPv4</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#IPAddressKind.iPv6">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#IPAddressKind" />
    <rdfs:comment xml:lang="en">Indicates that an IPv6 dotted decimal is in use.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">iPv6</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#ISOUpperLayer">
    <rdfs:comment xml:lang="en">Is a set of configure addressing information that is required since ICCP utilizes addressing other than a TCP port.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">ISOUpperLayer</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#TCPAccessPoint" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.ICCPConfiguration</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ISOUpperLayer.aeInvoke">
    <rdfs:comment xml:lang="en">Is part of the Application Entity addressing as specified by ISO Addressing.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ISOUpperLayer" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">aeInvoke</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ISOUpperLayer.aeQual">
    <rdfs:comment xml:lang="en">Is the AE qualifier and represents further application level addressing information.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ISOUpperLayer" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">aeQual</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ISOUpperLayer.apInvoke">
    <rdfs:comment xml:lang="en">Is a further application level OSI addressing parameter.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ISOUpperLayer" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">apInvoke</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ISOUpperLayer.apTitle">
    <rdfs:comment xml:lang="en">Is a sequence of integer strings separated by ".". The value, in conjunction with other application addressing attributes (e.g. other APs) are used to select a specific application (e.g. the ICCP application entity) per the OSI reference model. The sequence, and its values, represent a namespace whose values are governed by ISO/IEC 7498-3.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ISOUpperLayer" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">apTitle</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ISOUpperLayer.osiPsel">
    <rdfs:comment xml:lang="en">Is the addressing selector for OSI presentation addressing.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ISOUpperLayer" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">osiPsel</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ISOUpperLayer.osiSsel">
    <rdfs:comment xml:lang="en">Is the OSI session layer addressing information.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ISOUpperLayer" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">osiSsel</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ISOUpperLayer.osiTsel">
    <rdfs:comment xml:lang="en">Is the OSI Transport Layer addressing information.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ISOUpperLayer" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">osiTsel</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#IdcInverterControl">
    <rdfs:comment xml:lang="en">The idc inverter control class</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">IdcInverterControl</rdfs:label>
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Dynamics.StandardModels.InfHVDCDynamics.CSC</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Informative</cimdoc:packageTier>
  </owl:Class>
