  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ExcST6B.kpa">
    <rdfs:comment xml:lang="en">Voltage regulator proportional gain (Kpa) (&gt; 0). Typical value = 18,038.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ExcST6B" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
