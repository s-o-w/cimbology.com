    <rdfs:label xml:lang="en">maxFuelAllocation</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#FuelAllocationSchedule.minFuelAllocation">
    <rdfs:comment xml:lang="en">The minimum amount of fuel that is allocated for consumption for the scheduled time period, e.g., based on a "take-or-pay" contract.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#FuelAllocationSchedule" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">minFuelAllocation</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
  </owl:DatatypeProperty>
