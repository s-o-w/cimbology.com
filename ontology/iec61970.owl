    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.Domain</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
    <cimdoc:unitSymbol rdf:resource="http://iec.ch/TC57/CIM100#UnitSymbol.S" />
  </rdfs:Datatype>
  <rdfs:Datatype rdf:about="http://iec.ch/TC57/CIM100#SusceptancePerLength">
    <rdfs:comment xml:lang="en">Imaginary part of admittance per unit of length.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">SusceptancePerLength</rdfs:label>
    <owl:equivalentClass rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.Domain</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
    <cimdoc:unitMultiplier rdf:resource="http://iec.ch/TC57/CIM100#UnitMultiplier.none" />
    <cimdoc:unitSymbol rdf:resource="http://iec.ch/TC57/CIM100#UnitSymbol.SPerm" />
  </rdfs:Datatype>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#SvInjection">
    <rdfs:comment xml:lang="en">The SvInjection reports the calculated bus injection minus the sum of the terminal flows. The terminal flow is positive out from the bus (load sign convention) and bus injection has positive flow into the bus. SvInjection may have the remainder after state estimation or slack after power flow calculation.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">SvInjection</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#StateVariable" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.StateVariables</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#SvInjection.TopologicalNode">
    <rdfs:comment xml:lang="en">The topological node associated with the flow injection state variable.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SvInjection" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">TopologicalNode</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#TopologicalNode" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#SvInjection.pInjection">
    <rdfs:comment xml:lang="en">The active power mismatch between calculated injection and initial injection. Positive sign means injection into the TopologicalNode (bus).</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SvInjection" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">pInjection</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#ActivePower" />
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#SvInjection.phase">
    <rdfs:comment xml:lang="en">The terminal phase at which the connection is applied. If missing, the injection is assumed to be balanced among non-neutral phases.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SvInjection" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">phase</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#SinglePhaseKind" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#SvInjection.qInjection">
    <rdfs:comment xml:lang="en">The reactive power mismatch between calculated injection and initial injection. Positive sign means injection into the TopologicalNode (bus).</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SvInjection" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">qInjection</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#ReactivePower" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#SvPowerFlow">
    <rdfs:comment xml:lang="en">State variable for power flow. Load convention is used for flow direction. This means flow out from the TopologicalNode into the equipment is positive.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">SvPowerFlow</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#StateVariable" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.StateVariables</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#SvPowerFlow.Terminal">
    <rdfs:comment xml:lang="en">The terminal associated with the power flow state variable.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SvPowerFlow" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">Terminal</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Terminal" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#SvPowerFlow.m_EnergyGroup">
    <rdfs:comment xml:lang="en">The energygroup</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SvPowerFlow" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">m_EnergyGroup</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#EnergyGroup" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#SvPowerFlow.p">
    <rdfs:comment xml:lang="en">The active power flow. Load sign convention is used, i.e. positive sign means flow out from a TopologicalNode (bus) into the conducting equipment.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SvPowerFlow" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">p</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#ActivePower" />
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#SvPowerFlow.phase">
    <rdfs:comment xml:lang="en">The individual phase of the flow. If unspecified, then assumed to be balanced among phases.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SvPowerFlow" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">phase</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#SinglePhaseKind" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#SvPowerFlow.q">
    <rdfs:comment xml:lang="en">The reactive power flow. Load sign convention is used, i.e. positive sign means flow out from a TopologicalNode (bus) into the conducting equipment.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SvPowerFlow" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">q</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#ReactivePower" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#SvShuntCompensatorSections">
    <rdfs:comment xml:lang="en">State variable for the number of sections in service for a shunt compensator.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">SvShuntCompensatorSections</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#StateVariable" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.StateVariables</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#SvShuntCompensatorSections.ShuntCompensator">
    <rdfs:comment xml:lang="en">The shunt compensator for which the state applies.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SvShuntCompensatorSections" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">ShuntCompensator</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#ShuntCompensator" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#SvShuntCompensatorSections.phase">
    <rdfs:comment xml:lang="en">The terminal phase at which the connection is applied. If missing, the injection is assumed to be balanced among non-neutral phases.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SvShuntCompensatorSections" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">phase</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#SinglePhaseKind" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#SvShuntCompensatorSections.sections">
    <rdfs:comment xml:lang="en">The number of sections in service as a continuous variable. The attribute shall be a positive value or zero. To get integer value scale with ShuntCompensator. bPerSection.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SvShuntCompensatorSections" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">sections</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#SvStatus">
    <rdfs:comment xml:lang="en">State variable for status.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">SvStatus</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#StateVariable" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.StateVariables</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#SvStatus.ConductingEquipment">
    <rdfs:comment xml:lang="en">The conducting equipment associated with the status state variable.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SvStatus" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">ConductingEquipment</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#ConductingEquipment" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#SvStatus.inService">
    <rdfs:comment xml:lang="en">The in service status as a result of topology processing. It indicates if the equipment is considered as energized by the power flow. It reflects if the equipment is connected within a solvable island. It does not necessarily reflect whether or not the island was solved by the power flow.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SvStatus" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">inService</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#SvStatus.phase">
    <rdfs:comment xml:lang="en">The individual phase status. If the attribute is unspecified, then three phase model is assumed.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SvStatus" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">phase</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#SinglePhaseKind" />
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#SvSwitch">
    <rdfs:comment xml:lang="en">State variable for switch.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">SvSwitch</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#StateVariable" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.StateVariables</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#SvSwitch.Switch">
    <rdfs:comment xml:lang="en">The switch associated with the switch state.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SvSwitch" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">Switch</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Switch" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#SvSwitch.open">
    <rdfs:comment xml:lang="en">The attribute tells if the computed state of the switch is considered open.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SvSwitch" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">open</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#SvSwitch.phase">
    <rdfs:comment xml:lang="en">The terminal phase at which the connection is applied. If missing, the injection is assumed to be balanced among non-neutral phases.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SvSwitch" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">phase</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#SinglePhaseKind" />
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#SvTapStep">
    <rdfs:comment xml:lang="en">State variable for transformer tap step.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">SvTapStep</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#StateVariable" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.StateVariables</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#SvTapStep.TapChanger">
    <rdfs:comment xml:lang="en">The tap changer associated with the tap step state.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SvTapStep" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">TapChanger</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#TapChanger" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#SvTapStep.position">
    <rdfs:comment xml:lang="en">The floating point tap position. This is not the tap ratio, but rather the tap step position as defined by the related tap changer model and normally is constrained to be within the range of minimum and maximum tap positions.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SvTapStep" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">position</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#SvVoltage">
    <rdfs:comment xml:lang="en">State variable for voltage.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">SvVoltage</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#StateVariable" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.StateVariables</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#SvVoltage.TopologicalNode">
    <rdfs:comment xml:lang="en">The topological node associated with the voltage state.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SvVoltage" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">TopologicalNode</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#TopologicalNode" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#SvVoltage.angle">
    <rdfs:comment xml:lang="en">The voltage angle of the topological node complex voltage with respect to system reference.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SvVoltage" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">angle</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#AngleDegrees" />
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#SvVoltage.phase">
    <rdfs:comment xml:lang="en">If specified the voltage is the line to ground voltage of the individual phase. If unspecified, then the voltage is assumed balanced.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SvVoltage" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">phase</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#SinglePhaseKind" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#SvVoltage.v">
    <rdfs:comment xml:lang="en">The voltage magnitude at the topological node. The attribute shall be a positive value.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SvVoltage" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">v</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Voltage" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#Switch">
    <rdfs:comment xml:lang="en">A generic device designed to close, or open, or both, one or more electric circuits. All switches are two terminal devices including grounding switches. The ACDCTerminal.connected at the two sides of the switch shall not be considered for assessing switch connectivity, i.e. only Switch.open, . normalOpen and .locked are relevant.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">Switch</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#ConductingEquipment" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.Wires</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#Switch.SwitchPhase">
    <rdfs:comment xml:lang="en">The individual switch phases for the switch.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#Switch" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">SwitchPhase</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#SwitchPhase" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#Switch.SwitchSchedules">
    <rdfs:comment xml:lang="en">A Switch can be associated with SwitchSchedules.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#Switch" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">SwitchSchedules</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#SwitchSchedule" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#Switch.locked">
    <rdfs:comment xml:lang="en">If true, the switch is locked. The resulting switch state is a combination of locked and Switch.open attributes as follows: - locked=true and Switch.open=true. The resulting state is open and locked; - locked=false and Switch.open=true. The resulting state is open; - locked=false and Switch.open=false. The resulting state is closed.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#Switch" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">locked</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#Switch.normalOpen">
    <rdfs:comment xml:lang="en">The attribute is used in cases when no Measurement for the status value is present. If the Switch has a status measurement the Discrete.normalValue is expected to match with the Switch.normalOpen.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#Switch" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">normalOpen</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#Switch.open">
    <rdfs:comment xml:lang="en">The attribute tells if the switch is considered open when used as input to topology processing.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#Switch" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">open</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#Switch.ratedCurrent">
    <rdfs:comment xml:lang="en">The maximum continuous current carrying capacity in amps governed by the device material and construction. The attribute shall be a positive value.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#Switch" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">ratedCurrent</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#CurrentFlow" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#Switch.retained">
    <rdfs:comment xml:lang="en">Branch is retained in the topological solution. The flow through retained switches will normally be calculated in power flow.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#Switch" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">retained</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#Switch.switchOnCount">
    <rdfs:comment xml:lang="en">The switch on count since the switch was last reset or initialized.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#Switch" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">switchOnCount</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#Switch.switchOnDate">
    <rdfs:comment xml:lang="en">The date and time when the switch was last switched on.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#Switch" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">switchOnDate</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#SwitchPhase">
    <rdfs:comment xml:lang="en">Single phase of a multi-phase switch when its attributes might be different per phase.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">SwitchPhase</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#PowerSystemResource" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.Wires</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#SwitchPhase.closed">
    <rdfs:comment xml:lang="en">The attribute tells if the switch is considered closed when used as input to topology processing.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SwitchPhase" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">closed</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#SwitchPhase.normalOpen">
    <rdfs:comment xml:lang="en">Used in cases when no Measurement for the status value is present. If the SwitchPhase has a status measurement the Discrete.normalValue is expected to match with this value.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SwitchPhase" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">normalOpen</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#SwitchPhase.phaseSide1">
    <rdfs:comment xml:lang="en">Phase of this SwitchPhase on the side with terminal sequence number equal to 1. Should be a phase contained in that terminal�s phases attribute.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SwitchPhase" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">phaseSide1</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#SinglePhaseKind" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#SwitchPhase.phaseSide2">
    <rdfs:comment xml:lang="en">Phase of this SwitchPhase on the side with terminal sequence number equal to 2. Should be a phase contained in that terminal�s Terminal.phases attribute.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SwitchPhase" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">phaseSide2</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#SinglePhaseKind" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#SwitchPhase.ratedCurrent">
    <rdfs:comment xml:lang="en">The maximum continuous current carrying capacity in amps governed by the device material and construction. The attribute shall be a positive value.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SwitchPhase" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">ratedCurrent</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#CurrentFlow" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#SwitchSchedule">
    <rdfs:comment xml:lang="en">A schedule of switch positions. If RegularTimePoint.value1 is 0, the switch is open. If 1, the switch is closed.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">SwitchSchedule</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#SeasonDayTypeSchedule" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.Wires</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#SynchrocheckRelay">
    <rdfs:comment xml:lang="en">A device that operates when two AC circuits are within the desired limits of frequency, phase angle, and voltage, to permit or to cause the paralleling of these two circuits. Used to prevent the paralleling of non-synchronous topological islands.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">SynchrocheckRelay</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#ProtectionEquipment" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.Protection</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#SynchrocheckRelay.maxAngleDiff">
    <rdfs:comment xml:lang="en">The maximum allowable voltage vector phase angle difference across the open device.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SynchrocheckRelay" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">maxAngleDiff</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#AngleRadians" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#SynchrocheckRelay.maxFreqDiff">
    <rdfs:comment xml:lang="en">The maximum allowable frequency difference across the open device.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SynchrocheckRelay" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">maxFreqDiff</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Frequency" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#SynchrocheckRelay.maxVoltDiff">
    <rdfs:comment xml:lang="en">The maximum allowable difference voltage across the open device.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SynchrocheckRelay" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">maxVoltDiff</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Voltage" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#SynchronousMachine">
    <rdfs:comment xml:lang="en">An electromechanical device that operates with shaft rotating synchronously with the network. It is a single machine operating either as a generator or synchronous condenser or pump.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">SynchronousMachine</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#RotatingMachine" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.Wires</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#SynchronousMachine.aVRToManualLag">
    <rdfs:comment xml:lang="en">Time delay required when switching from Automatic Voltage Regulation (AVR) to Manual for a lagging MVAr violation.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SynchronousMachine" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">aVRToManualLag</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Seconds" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#SynchronousMachine.aVRToManualLead">
    <rdfs:comment xml:lang="en">Time delay required when switching from Automatic Voltage Regulation (AVR) to Manual for a leading MVAr violation.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SynchronousMachine" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">aVRToManualLead</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Seconds" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#SynchronousMachine.baseQ">
    <rdfs:comment xml:lang="en">Default base reactive power value. This value represents the initial reactive power that can be used by any application function.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SynchronousMachine" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">baseQ</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#ReactivePower" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#SynchronousMachine.condenserP">
    <rdfs:comment xml:lang="en">Active power consumed when in condenser mode operation.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SynchronousMachine" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">condenserP</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#ActivePower" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#SynchronousMachine.coolantCondition">
    <rdfs:comment xml:lang="en">Temperature or pressure of coolant medium.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SynchronousMachine" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">coolantCondition</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#SynchronousMachine.coolantType">
    <rdfs:comment xml:lang="en">Method of cooling the machine.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SynchronousMachine" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">coolantType</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#CoolantType" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#SynchronousMachine.earthing">
    <rdfs:comment xml:lang="en">Indicates whether or not the generator is earthed. Used for short circuit data exchange according to IEC 60909.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SynchronousMachine" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">earthing</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#SynchronousMachine.earthingStarPointR">
    <rdfs:comment xml:lang="en">Generator star point earthing resistance (Re). Used for short circuit data exchange according to IEC 60909.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SynchronousMachine" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">earthingStarPointR</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Resistance" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#SynchronousMachine.earthingStarPointX">
    <rdfs:comment xml:lang="en">Generator star point earthing reactance (Xe). Used for short circuit data exchange according to IEC 60909.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SynchronousMachine" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">earthingStarPointX</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Reactance" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#SynchronousMachine.ikk">
    <rdfs:comment xml:lang="en">Steady-state short-circuit current (in A for the profile) of generator with compound excitation during 3-phase short circuit. - Ikk equals 0: Generator with no compound excitation. - Ikk not equal to 0: Generator with compound excitation. Ikk is used to calculate the minimum steady-state short-circuit current for generators with compound excitation. (4.6.1.2 in IEC 60909-0:2001). Used only for single fed short circuit on a generator. (4.3.4.2. in IEC 60909-0:2001).</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SynchronousMachine" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">ikk</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#CurrentFlow" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#SynchronousMachine.manualToAVR">
    <rdfs:comment xml:lang="en">Time delay required when switching from Manual to Automatic Voltage Regulation. This value is used in the accelerating power reference frame for powerflow solutions.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SynchronousMachine" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">manualToAVR</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Seconds" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#SynchronousMachine.maxQ">
    <rdfs:comment xml:lang="en">Maximum reactive power limit. This is the maximum (nameplate) limit for the unit.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SynchronousMachine" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">maxQ</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#ReactivePower" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#SynchronousMachine.maxU">
    <rdfs:comment xml:lang="en">Maximum voltage limit for the unit.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SynchronousMachine" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">maxU</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Voltage" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#SynchronousMachine.minQ">
    <rdfs:comment xml:lang="en">Minimum reactive power limit for the unit.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SynchronousMachine" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">minQ</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#ReactivePower" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#SynchronousMachine.minU">
    <rdfs:comment xml:lang="en">Minimum voltage limit for the unit.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SynchronousMachine" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">minU</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Voltage" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#SynchronousMachine.mu">
    <rdfs:comment xml:lang="en">Factor to calculate the breaking current (Section 4.5.2.1 in IEC 60909-0). Used only for single fed short circuit on a generator (Section 4.3.4.2. in IEC 60909-0).</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SynchronousMachine" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">mu</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#SynchronousMachine.operatingMode">
    <rdfs:comment xml:lang="en">Current mode of operation.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SynchronousMachine" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">operatingMode</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#SynchronousMachineOperatingMode" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#SynchronousMachine.qPercent">
    <rdfs:comment xml:lang="en">Part of the coordinated reactive control that comes from this machine. The attribute is used as a participation factor not necessarily summing up to 100% for the participating devices in the control.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SynchronousMachine" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">qPercent</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PerCent" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#SynchronousMachine.r">
    <rdfs:comment xml:lang="en">Equivalent resistance (RG) of generator. RG is considered for the calculation of all currents, except for the calculation of the peak current ip. Used for short circuit data exchange according to IEC 60909.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SynchronousMachine" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">r</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Resistance" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#SynchronousMachine.r0">
    <rdfs:comment xml:lang="en">Zero sequence resistance of the synchronous machine.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SynchronousMachine" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">r0</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Resistance" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#SynchronousMachine.r2">
    <rdfs:comment xml:lang="en">Negative sequence resistance.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SynchronousMachine" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">r2</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Resistance" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#SynchronousMachine.referencePriority">
    <rdfs:comment xml:lang="en">Priority of unit for use as powerflow voltage phase angle reference bus selection. 0 = don t care (default) 1 = highest priority. 2 is less than 1 and so on.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SynchronousMachine" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">referencePriority</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#SynchronousMachine.satDirectSubtransX">
    <rdfs:comment xml:lang="en">Direct-axis subtransient reactance saturated, also known as Xd"sat.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SynchronousMachine" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">satDirectSubtransX</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#SynchronousMachine.satDirectSyncX">
    <rdfs:comment xml:lang="en">Direct-axes saturated synchronous reactance (xdsat); reciprocal of short- circuit ration. Used for short circuit data exchange, only for single fed short circuit on a generator. (4.3.4.2. in IEC 60909-0:2001).</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SynchronousMachine" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">satDirectSyncX</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#SynchronousMachine.satDirectTransX">
    <rdfs:comment xml:lang="en">Saturated Direct-axis transient reactance. The attribute is primarily used for short circuit calculations according to ANSI.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SynchronousMachine" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">satDirectTransX</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#SynchronousMachine.shortCircuitRotorType">
    <rdfs:comment xml:lang="en">Type of rotor, used by short circuit applications, only for single fed short circuit according to IEC 60909.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SynchronousMachine" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">shortCircuitRotorType</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#ShortCircuitRotorKind" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#SynchronousMachine.type">
    <rdfs:comment xml:lang="en">Modes that this synchronous machine can operate in.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SynchronousMachine" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">type</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#SynchronousMachineKind" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#SynchronousMachine.voltageRegulationRange">
    <rdfs:comment xml:lang="en">Range of generator voltage regulation (PG in IEC 60909-0) used for calculation of the impedance correction factor KG defined in IEC 60909-0. This attribute is used to describe the operating voltage of the generating unit.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SynchronousMachine" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">voltageRegulationRange</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PerCent" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#SynchronousMachine.x0">
    <rdfs:comment xml:lang="en">Zero sequence reactance of the synchronous machine.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SynchronousMachine" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">x0</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Reactance" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#SynchronousMachine.x2">
    <rdfs:comment xml:lang="en">Negative sequence reactance.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SynchronousMachine" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">x2</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Reactance" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#SynchronousMachineDetailed">
    <rdfs:comment xml:lang="en">All synchronous machine detailed types use a subset of the same data parameters and input/output variables. The several variations differ in the following ways: - the number of equivalent windings that are included; - the way in which saturation is incorporated into the model; - whether or not �subtransient saliency� (X''q not = X''d) is represented. It is not necessary for each simulation tool to have separate models for each of the model types. The same model can often be used for several types by alternative logic within the model. Also, differences in saturation representation might not result in significant model performance differences so model substitutions are often acceptable.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">SynchronousMachineDetailed</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#SynchronousMachineDynamics" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Dynamics.StandardModels.SynchronousMachineDynamics</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#SynchronousMachineDetailed.efdBaseRatio">
    <rdfs:comment xml:lang="en">Ratio (exciter voltage/generator voltage) of Efd bases of exciter and generator models (&gt; 0). Typical value = 1.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SynchronousMachineDetailed" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">efdBaseRatio</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#SynchronousMachineDetailed.ifdBaseType">
    <rdfs:comment xml:lang="en">Excitation base system mode. It should be equal to the value of WLMDV given by the user. WLMDV is the PU ratio between the field voltage and the excitation current: Efd = WLMDV x Ifd. Typical value = ifag.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SynchronousMachineDetailed" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">ifdBaseType</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#IfdBaseKind" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#SynchronousMachineDetailed.saturationFactor120QAxis">
    <rdfs:comment xml:lang="en">Quadrature-axis saturation factor at 120% of rated terminal voltage (S12q) (&gt;= SynchonousMachineDetailed.saturationFactorQAxis). Typical value = 0,12.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SynchronousMachineDetailed" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">saturationFactor120QAxis</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#SynchronousMachineDetailed.saturationFactorQAxis">
    <rdfs:comment xml:lang="en">Quadrature-axis saturation factor at rated terminal voltage (S1q) (&gt;= 0). Typical value = 0,02.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SynchronousMachineDetailed" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">saturationFactorQAxis</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#SynchronousMachineDynamics">
    <rdfs:comment xml:lang="en">Synchronous machine whose behaviour is described by reference to a standard model expressed in one of the following forms: - simplified (or classical), where a group of generators or motors is not modelled in detail; - detailed, in equivalent circuit form; - detailed, in time constant reactance form; or - by definition of a user-defined model. It is a common practice to represent small generators by a negative load rather than by a dynamic generator model when performing dynamics simulations. In this case, a SynchronousMachine in the static model is not represented by anything in the dynamics model, instead it is treated as an ordinary load. Parameter details: - Synchronous machine parameters such as Xl, Xd, Xp etc. are actually used as inductances in the models, but are commonly referred to as reactances since, at nominal frequency, the PU values are the same. However, some references use the symbol L instead of X.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">SynchronousMachineDynamics</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#RotatingMachineDynamics" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Dynamics.StandardModels.SynchronousMachineDynamics</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#SynchronousMachineDynamics.SynchronousMachine">
    <rdfs:comment xml:lang="en">Synchronous machine to which synchronous machine dynamics model applies.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SynchronousMachineDynamics" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">SynchronousMachine</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#SynchronousMachine" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#SynchronousMachineDynamics.TurbineGovernorDynamics">
    <rdfs:comment xml:lang="en">Turbine-governor model associated with this synchronous machine model. Multiplicity of greater than one is intended to support hydro units that have multiple turbines on one generator.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SynchronousMachineDynamics" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">TurbineGovernorDynamics</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#TurbineGovernorDynamics" />
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#SynchronousMachineEquivalentCircuit">
    <rdfs:comment xml:lang="en">The electrical equations for all variations of the synchronous models are based on the SynchronousEquivalentCircuit diagram for the direct- and quadrature- axes. Equations for conversion between equivalent circuit and time constant reactance forms: Xd = Xad + Xl X�d = Xl + Xad x Xfd / (Xad + Xfd) X�d = Xl + Xad x Xfd x X1d / (Xad x Xfd + Xad x X1d + Xfd x X1d) Xq = Xaq + Xl X�q = Xl + Xaq x X1q / (Xaq + X1q) X�q = Xl + Xaq x X1q x X2q / (Xaq x X1q + Xaq x X2q + X1q x X2q) T�do = (Xad + Xfd) / (omega0 x Rfd) T�do = (Xad x Xfd + Xad x X1d + Xfd x X1d) / (omega0 x R1d x (Xad + Xfd) T�qo = (Xaq + X1q) / (omega0 x R1q) T�qo = (Xaq x X1q + Xaq x X2q + X1q x X2q) / (omega0 x R2q x (Xaq + X1q) Same equations using CIM attributes from SynchronousMachineTimeConstantReactance class on left of "=" and SynchronousMachineEquivalentCircuit class on right (except as noted): xDirectSync = xad + RotatingMachineDynamics.statorLeakageReactance xDirectTrans = RotatingMachineDynamics.statorLeakageReactance + xad x xfd / (xad + xfd) xDirectSubtrans = RotatingMachineDynamics.statorLeakageReactance + xad x xfd x x1d / (xad x xfd + xad x x1d + xfd x x1d) xQuadSync = xaq + RotatingMachineDynamics.statorLeakageReactance xQuadTrans = RotatingMachineDynamics.statorLeakageReactance + xaq x x1q / (xaq+ x1q) xQuadSubtrans = RotatingMachineDynamics.statorLeakageReactance + xaq x x1q x x2q / (xaq x x1q + xaq x x2q + x1q x x2q) tpdo = (xad + xfd) / (2 x pi x nominal frequency x rfd) tppdo = (xad x xfd + xad x x1d + xfd x x1d) / (2 x pi x nominal frequency x r1d x (xad + xfd) tpqo = (xaq + x1q) / (2 x pi x nominal frequency x r1q) tppqo = (xaq x x1q + xaq x x2q + x1q x x2q) / (2 x pi x nominal frequency x r2q x (xaq + x1q) These are only valid for a simplified model where "Canay" reactance is zero.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">SynchronousMachineEquivalentCircuit</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#SynchronousMachineDetailed" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Dynamics.StandardModels.SynchronousMachineDynamics</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#SynchronousMachineEquivalentCircuit.r1d">
    <rdfs:comment xml:lang="en">Direct-axis damper 1 winding resistance.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SynchronousMachineEquivalentCircuit" />
