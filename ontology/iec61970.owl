    <rdfs:comment xml:lang="en">Voltage regulator minimum limit (Vrmin) (less than ExcCZ.vrmax).</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ExcCZ" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
