    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#PotentialTransformerKind.capacitiveCoupling">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#PotentialTransformerKind" />
    <rdfs:comment xml:lang="en">The potential transformer is using capacitive coupling to create secondary voltage.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">capacitiveCoupling</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</cimdoc:enumCode>
