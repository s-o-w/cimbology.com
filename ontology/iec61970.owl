    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">kq1</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#LoadStatic.kq2">
    <rdfs:comment xml:lang="en">Second term voltage coefficient for reactive power (Kq2). Not used when .staticLoadModelType = constantZ.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LoadStatic" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">kq2</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#LoadStatic.kq3">
    <rdfs:comment xml:lang="en">Third term voltage coefficient for reactive power (Kq3). Not used when .staticLoadModelType = constantZ.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LoadStatic" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">kq3</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#LoadStatic.kq4">
    <rdfs:comment xml:lang="en">Frequency coefficient for reactive power (Kq4) (not = 0 when .staticLoadModelType = zIP2). Used only when .staticLoadModelType - zIP2.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LoadStatic" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">kq4</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#LoadStatic.kqf">
    <rdfs:comment xml:lang="en">Frequency deviation coefficient for reactive power (Kqf). Not used when .staticLoadModelType = constantZ.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LoadStatic" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">kqf</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#LoadStatic.staticLoadModelType">
    <rdfs:comment xml:lang="en">Type of static load model. Typical value = constantZ.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LoadStatic" />
