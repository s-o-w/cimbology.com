  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#OverexcLimX2.efd2">
    <rdfs:comment xml:lang="en">Mid voltage or current point on the inverse time characteristic (EFD2). Typical value = 1,2.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#OverexcLimX2" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">efd2</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
