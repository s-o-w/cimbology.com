  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#ExcNI">
    <rdfs:comment xml:lang="en">Bus or solid fed SCR (silicon-controlled rectifier) bridge excitation system model type NI (NVE).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">ExcNI</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#ExcitationSystemDynamics" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Dynamics.StandardModels.ExcitationSystemDynamics</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ExcNI.busFedSelector">
    <rdfs:comment xml:lang="en">Fed by selector (BusFedSelector). true = bus fed (switch is closed) false = solid fed (switch is open). Typical value = true.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ExcNI" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">busFedSelector</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ExcNI.ka">
    <rdfs:comment xml:lang="en">Voltage regulator gain (Ka) (&gt; 0). Typical value = 210.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ExcNI" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">ka</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ExcNI.kf">
    <rdfs:comment xml:lang="en">Excitation control system stabilizer gain (Kf) (&gt; 0). Typical value 0, 01.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ExcNI" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">kf</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ExcNI.r">
    <rdfs:comment xml:lang="en">rc / rfd (R) (&gt;= 0). 0 means exciter has negative current capability &gt; 0 means exciter does not have negative current capability. Typical value = 5.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ExcNI" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">r</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ExcNI.ta">
    <rdfs:comment xml:lang="en">Voltage regulator time constant (Ta) (&gt; 0). Typical value = 0,02.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ExcNI" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">ta</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Seconds" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ExcNI.tf1">
    <rdfs:comment xml:lang="en">Excitation control system stabilizer time constant (Tf1) (&gt; 0). Typical value = 1,0.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ExcNI" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">tf1</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Seconds" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ExcNI.tf2">
    <rdfs:comment xml:lang="en">Excitation control system stabilizer time constant (Tf2) (&gt; 0). Typical value = 0,1.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ExcNI" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">tf2</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Seconds" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ExcNI.tr">
    <rdfs:comment xml:lang="en">Time constant (Tr) (&gt;= 0). Typical value = 0,02.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ExcNI" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">tr</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Seconds" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ExcNI.vrmax">
    <rdfs:comment xml:lang="en">Maximum voltage regulator ouput (Vrmax) (greater than ExcNI.vrmin). Typical value = 5,0.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ExcNI" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">vrmax</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ExcNI.vrmin">
    <rdfs:comment xml:lang="en">Minimum voltage regulator ouput (Vrmin) (less than ExcNI.vrmax). Typical value = -2,0.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ExcNI" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">vrmin</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#ExcOEX3T">
    <rdfs:comment xml:lang="en">Modified IEEE type ST1 excitation system with semi-continuous and acting terminal voltage limiter.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">ExcOEX3T</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#ExcitationSystemDynamics" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Dynamics.StandardModels.ExcitationSystemDynamics</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ExcOEX3T.e1">
    <rdfs:comment xml:lang="en">Saturation parameter (E1).</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ExcOEX3T" />
