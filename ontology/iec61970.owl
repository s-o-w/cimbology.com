  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#WindLookupTableFunctionKind.omegap">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#WindLookupTableFunctionKind" />
    <rdfs:comment xml:lang="en">Power vs. speed lookup table (omega(p)). It is used for the P control model type 3, IEC 61400-27-1:2015, 5.6.5.4.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">omegap</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#WindLookupTableFunctionKind.prr">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#WindLookupTableFunctionKind" />
    <rdfs:comment xml:lang="en">Power versus speed change (negative slip) lookup table (prr(deltaomega)). It is used for the rotor resistance control model, IEC 61400-27-1:2015, 5.6.5.3.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">prr</rdfs:label>
