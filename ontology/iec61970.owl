    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#MeasurementCalculator" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">MeasurementCalculatorInput</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#MeasurementCalculatorInput" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#MeasurementCalculator.PinMeasurement">
    <rdfs:comment xml:lang="en">The pin measurement associated with this measurement calculator.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#MeasurementCalculator" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">PinMeasurement</rdfs:label>
