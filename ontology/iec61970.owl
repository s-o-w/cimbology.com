  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#PssPTIST1.dtc">
    <rdfs:comment xml:lang="en">Time step related to activation of controls (deltatc) (&gt;= 0). Typical value = 0,025.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#PssPTIST1" />
