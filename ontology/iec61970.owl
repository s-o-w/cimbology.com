  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#WindLookupTableFunctionKind.iqmax">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#WindLookupTableFunctionKind" />
    <rdfs:comment xml:lang="en">Lookup table for voltage dependency of reactive current limits (iqmax(uWT)). It is used for the current limitation model, IEC 61400-27-1:2015, 5.6.5.8.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">iqmax</rdfs:label>
