  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#HydroGeneratingUnit.dropHeight">
    <rdfs:comment xml:lang="en">The height water drops from the reservoir mid-point to the turbine.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#HydroGeneratingUnit" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">dropHeight</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Length" />
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#HydroGeneratingUnit.energyConversionCapability">
    <rdfs:comment xml:lang="en">Energy conversion capability for generating.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#HydroGeneratingUnit" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">energyConversionCapability</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#HydroEnergyConversionKind" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#HydroGeneratingUnit.hydroUnitWaterCost">
    <rdfs:comment xml:lang="en">The equivalent cost of water that drives the hydro turbine.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#HydroGeneratingUnit" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">hydroUnitWaterCost</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#CostPerVolume" />
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#HydroGeneratingUnit.turbineType">
    <rdfs:comment xml:lang="en">Type of turbine.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#HydroGeneratingUnit" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">turbineType</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#HydroTurbineKind" />
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#HydroPlantStorageKind">
    <rdfs:comment xml:lang="en">The type of hydro power plant.</rdfs:comment>
