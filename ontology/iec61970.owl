  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#GovGAST1.gv1">
    <rdfs:comment xml:lang="en">Nonlinear gain point 1, PU gv (Gv1). Typical value = 0.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#GovGAST1" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">gv1</rdfs:label>
