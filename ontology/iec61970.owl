  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#MeasurementValue">
    <rdfs:comment xml:lang="en">The current state for a measurement. A state value is an instance of a measurement from a specific source. Measurements can be associated with many state values, each representing a different source for the measurement.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">MeasurementValue</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#IOPoint" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.Meas</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#MeasurementValue.MeasurementValueQuality">
    <rdfs:comment xml:lang="en">A MeasurementValue has a MeasurementValueQuality associated with it.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#MeasurementValue" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">MeasurementValueQuality</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#MeasurementValueQuality" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#MeasurementValue.RemoteSource">
    <rdfs:comment xml:lang="en">Link to the physical telemetered point associated with this measurement.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#MeasurementValue" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
