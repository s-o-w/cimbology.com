    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#AnalogToDigitalLogicKind" />
    <rdfs:comment xml:lang="en">Greater than comparison operation.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
