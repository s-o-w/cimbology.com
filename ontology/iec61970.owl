  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#FuelAllocationSchedule.maxFuelAllocation">
    <rdfs:comment xml:lang="en">The maximum amount of fuel that is allocated for consumption for the scheduled time period.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#FuelAllocationSchedule" />
