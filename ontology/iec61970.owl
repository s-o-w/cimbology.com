  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ExcSK.qconoff">
    <rdfs:comment xml:lang="en">Secondary voltage control state (Qc_on_off). true = secondary voltage control is on false = secondary voltage control is off. Typical value = false.</rdfs:comment>
