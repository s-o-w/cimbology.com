    <rdfs:comment xml:lang="en">Exciter saturation function value at the corresponding exciter voltage, VE1, back of commutating reactance (SE[VE1]) (&gt;= 0). Typical value = 0,214.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ExcIEEEAC6A" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">seve1</rdfs:label>
