    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">r</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#ResistancePerLength" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#PerLengthSequenceImpedance.r0">
    <rdfs:comment xml:lang="en">Zero sequence series resistance, per unit of length.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#PerLengthSequenceImpedance" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">r0</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#ResistancePerLength" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#PerLengthSequenceImpedance.x">
    <rdfs:comment xml:lang="en">Positive sequence series reactance, per unit of length.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#PerLengthSequenceImpedance" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">x</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#ReactancePerLength" />
  </owl:DatatypeProperty>
