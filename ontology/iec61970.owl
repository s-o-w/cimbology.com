  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#EmissionType.nitrogenOxide">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#EmissionType" />
    <rdfs:comment xml:lang="en">Nitrogen oxide.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">nitrogenOxide</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</cimdoc:enumCode>
