    <rdfs:label xml:lang="en">seve2</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ExcIEEEAC6A.ta">
    <rdfs:comment xml:lang="en">Voltage regulator time constant (TA) (&gt;= 0). Typical value = 0,086.</rdfs:comment>
