  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#ICCPProvidedPoint.accessPriviledge">
    <rdfs:comment xml:lang="en">Provides information regarding the access privileges allowed to the ICCP Point.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ICCPProvidedPoint" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
