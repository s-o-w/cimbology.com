    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#DatasetArg" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">OperationDatasetArgDescription</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#DatasetArgDescription" />
