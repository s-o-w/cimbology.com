    <rdfs:comment xml:lang="en">Minimum value of regulator set-point (Crmn). Typical value = 0.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#GovSteamFV4" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
