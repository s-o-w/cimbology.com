  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ExcST6B.vimin">
    <rdfs:comment xml:lang="en">Minimum voltage regulator input limit (Vimin) (less than ExcST6B.vimax). Typical value = -10.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ExcST6B" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">vimin</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
