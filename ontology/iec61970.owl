  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#UnderexcLim2Simplified">
    <rdfs:comment xml:lang="en">Simplified type UEL2 underexcitation limiter. This model can be derived from UnderexcLimIEEE2. The limit characteristic (look �up table) is a single straight-line, the same as UnderexcLimIEEE2 (see Figure 10.4 (p 32), IEEE 421.5- 2005 Section 10.2).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">UnderexcLim2Simplified</rdfs:label>
