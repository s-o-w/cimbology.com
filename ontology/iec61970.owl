    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">ICCPScopeKind</rdfs:label>
    <owl:equivalentClass rdf:nodeID="oneOfClass_ICCPScopeKind" />
