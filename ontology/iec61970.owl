    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#WaterLevel" />
  </owl:DatatypeProperty>
  <rdfs:Datatype rdf:about="http://iec.ch/TC57/CIM100#Resistance">
    <rdfs:comment xml:lang="en">Resistance (real part of impedance).</rdfs:comment>
