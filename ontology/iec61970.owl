    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#Source.DEFAULTED">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#Source" />
    <rdfs:comment xml:lang="en">The value contains a default value.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">DEFAULTED</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#Source.PROCESS">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#Source" />
    <rdfs:comment xml:lang="en">The value is provided by input from the process I/O or being calculated from some function.</rdfs:comment>
