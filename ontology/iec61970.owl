  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#WindPlantDynamics">
    <rdfs:comment xml:lang="en">Parent class supporting relationships to wind turbines type 3 and type 4 and wind plant IEC and user-defined wind plants including their control models.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">WindPlantDynamics</rdfs:label>
