    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#WindUVRTQcontrolModeKind" />
    <rdfs:comment xml:lang="en">Reactive current injection controlled as the pre-fault value plus an additional voltage dependent reactive current injection (MqUVRT equals 1).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">mode1</rdfs:label>
