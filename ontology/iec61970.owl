  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ExcST6B.vamax">
    <rdfs:comment xml:lang="en">Maximum voltage regulator output (Vamax) (greater than 0). Typical value = 4,81.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ExcST6B" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">vamax</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ExcST6B.vamin">
    <rdfs:comment xml:lang="en">Minimum voltage regulator output (Vamin) (less than 0). Typical value = -3,85.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ExcST6B" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
