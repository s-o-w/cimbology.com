  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#WindQcontrolModeKind.openLooppowerFactor">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#WindQcontrolModeKind" />
    <rdfs:comment xml:lang="en">Open loop power factor control (MqG equals 4).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">openLooppowerFactor</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#WindQcontrolModeKind.powerFactor">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#WindQcontrolModeKind" />
    <rdfs:comment xml:lang="en">Power factor control (MqG equals 3).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">powerFactor</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#WindQcontrolModeKind.reactivePower">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#WindQcontrolModeKind" />
    <rdfs:comment xml:lang="en">Reactive power control (MqG equals 1).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">reactivePower</rdfs:label>
