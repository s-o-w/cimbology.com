  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#WindPlantReactiveControlIEC.tuqfilt">
    <rdfs:comment xml:lang="en">Filter time constant for voltage-dependent reactive power (Tuqfilt) (&gt;= 0). It is a project-dependent parameter.</rdfs:comment>
