  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ExcIEEEAC6A.tc">
    <rdfs:comment xml:lang="en">Voltage regulator time constant (TC) (&gt;= 0). Typical value = 3.</rdfs:comment>
