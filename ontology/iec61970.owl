    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#EmissionType" />
    <rdfs:comment xml:lang="en">Chlorine.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">chlorine</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#EmissionType.hydrogenSulfide">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#EmissionType" />
    <rdfs:comment xml:lang="en">Hydrogen sulfide.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">hydrogenSulfide</rdfs:label>
