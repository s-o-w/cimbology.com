    <rdfs:comment xml:lang="en">Time to trip the exciter at the high voltage or current point on the inverse time characteristic (TIME3) (&gt;= 0). Typical value = 15.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#OverexcLimX2" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">t3</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Seconds" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#OverexcLimX2.vlow">
    <rdfs:comment xml:lang="en">Low voltage limit (VLOW) (&gt; 0).</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#OverexcLimX2" />
