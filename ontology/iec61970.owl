    <rdfs:comment xml:lang="en">Maximum voltage reference signal (Vmax) (&gt; 0 and &gt; ExcST7B.vmin)). Typical value = 1,1.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ExcST7B" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
