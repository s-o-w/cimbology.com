  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ExcIEEEST6B.vrmin">
    <rdfs:comment xml:lang="en">Minimum voltage regulator output (VRMIN) (less than 0). Typical value = -3,85.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ExcIEEEST6B" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">vrmin</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
