  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#OverexcLimX2.efd3">
    <rdfs:comment xml:lang="en">High voltage or current point on the inverse time characteristic (EFD3). Typical value = 1,5.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#OverexcLimX2" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
