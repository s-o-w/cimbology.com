  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ExcSK.qz">
    <rdfs:comment xml:lang="en">Desired value (setpoint) of reactive power, manual setting (Qz).</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ExcSK" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
