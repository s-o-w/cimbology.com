    <rdfs:comment xml:lang="en">Inlet piping/steam bowl time constant (T4) (&gt;= 0). Typical value = 0,2.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#GovSteamFV3" />
