    <cimdoc:unitMultiplier rdf:resource="http://iec.ch/TC57/CIM100#UnitMultiplier.none" />
    <cimdoc:unitSymbol rdf:resource="http://iec.ch/TC57/CIM100#UnitSymbol.onePerHz" />
  </rdfs:Datatype>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#DataSet">
