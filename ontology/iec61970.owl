    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ExcSK.efdmax">
    <rdfs:comment xml:lang="en">Field voltage clipping upper level limit (Efdmax) (&gt; ExcSK.efdmin).</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ExcSK" />
