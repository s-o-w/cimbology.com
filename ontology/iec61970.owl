    <rdfs:label xml:lang="en">gateUpperLimit</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#HydroTurbine.maxHeadMaxP">
    <rdfs:comment xml:lang="en">Maximum efficiency active power at maximum head conditions.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#HydroTurbine" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">maxHeadMaxP</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#ActivePower" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#HydroTurbine.minHeadMaxP">
    <rdfs:comment xml:lang="en">Maximum efficiency active power at minimum head conditions.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#HydroTurbine" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">minHeadMaxP</rdfs:label>
