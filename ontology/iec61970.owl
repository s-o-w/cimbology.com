    <rdfs:comment xml:lang="en">Minimum controller output (URmin) (&lt; ExcSK.urmax). Typical value = -10.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ExcSK" />
