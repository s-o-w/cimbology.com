    <rdfs:comment xml:lang="en">A hydro generating unit has a tailbay loss curve.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#HydroGeneratingUnit" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
