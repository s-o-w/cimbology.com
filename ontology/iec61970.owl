    <rdfs:comment xml:lang="en">Direct-axis damper 1 winding leakage reactance.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#SynchronousMachineEquivalentCircuit" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
