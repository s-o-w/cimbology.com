    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#MeasurementCalculatorInput.order">
    <rdfs:comment xml:lang="en">Positive number that defines the order of the operant in the calculation. 0 = default. The order is not relevant (e.g. summation).</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#MeasurementCalculatorInput" />
