  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#LoadStatic.kp2">
    <rdfs:comment xml:lang="en">Second term voltage coefficient for active power (Kp2). Not used when .staticLoadModelType = constantZ.</rdfs:comment>
