    <rdfs:label xml:lang="en">CombustionTurbines</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#CombustionTurbine" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#HeatRecoveryBoiler.steamSupplyRating2">
    <rdfs:comment xml:lang="en">The steam supply rating in kilopounds per hour, if dual pressure boiler.</rdfs:comment>
