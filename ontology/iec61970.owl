    <rdfs:comment xml:lang="en">OEL input selector (OELin). Typical value = noOELinput (corresponds to OELin = 0 on diagram).</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ExcST6B" />
