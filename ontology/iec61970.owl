    <rdfs:comment xml:lang="en">Exciter saturation function value at the corresponding exciter voltage, EFD1 (SE[EFD1]) (&gt;= 0). Typical value = 0,08.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ExcIEEEDC4B" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">seefd1</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ExcIEEEDC4B.seefd2">
    <rdfs:comment xml:lang="en">Exciter saturation function value at the corresponding exciter voltage, EFD2 (SE[EFD2]) (&gt;= 0). Typical value = 0,27.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ExcIEEEDC4B" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
