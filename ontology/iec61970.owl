  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ExcST4B.kim">
    <rdfs:comment xml:lang="en">Voltage regulator integral gain output (Kim). Typical value = 0.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ExcST4B" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">kim</rdfs:label>
