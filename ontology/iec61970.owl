    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#AirCompressor.airCompressorRating">
    <rdfs:comment xml:lang="en">Rating of the CAES air compressor.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#AirCompressor" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">airCompressorRating</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
