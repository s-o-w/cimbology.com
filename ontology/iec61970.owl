  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ExcIEEEST1A.vimin">
    <rdfs:comment xml:lang="en">Minimum voltage regulator input limit (VIMIN) (less than 0). Typical value = -999.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ExcIEEEST1A" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">vimin</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
  </owl:DatatypeProperty>
