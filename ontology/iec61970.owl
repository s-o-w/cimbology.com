  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ExcSK.uimax">
    <rdfs:comment xml:lang="en">Maximum error (UImax) (&gt; ExcSK.uimin). Typical value = 10.</rdfs:comment>
