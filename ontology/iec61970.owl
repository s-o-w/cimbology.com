  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ExcST6B.kg">
    <rdfs:comment xml:lang="en">Feedback gain constant of the inner loop field regulator (Kg) (&gt;= 0). Typical value = 1.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ExcST6B" />
