  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#WindPlantReactiveControlIEC.txfv">
    <rdfs:comment xml:lang="en">Lag time constant in reference value transfer function (Txfv) (&gt;= 0). It is a project-dependent parameter.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#WindPlantReactiveControlIEC" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
