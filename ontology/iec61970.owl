    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">MeasurementValues</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#MeasurementValue" />
