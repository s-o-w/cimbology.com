    <rdfs:comment xml:lang="en">Time constant of crossover or third boiler pass (T6) (&gt;= 0). Typical value = 10.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#GovSteamFV3" />
