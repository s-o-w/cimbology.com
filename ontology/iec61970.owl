  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#NetworkModelCaseDefinition.m_Operation">
    <rdfs:comment xml:lang="en">The operation associated with this network model case definition.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#NetworkModelCaseDefinition" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">m_Operation</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Operation" />
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#NetworkModelProject">
    <rdfs:comment xml:lang="en">A grouping of network model change descriptions. Primarily used to organize the phases of an overall project.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">NetworkModelProject</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#NetworkModelProjectComponent" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.InfIEC61970.InfPart303.NetworkModelProjects</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Informative</cimdoc:packageTier>
  </owl:Class>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#NetworkModelProject2">
    <rdfs:comment xml:lang="en">Represents a network model project (version 2) as a component.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">NetworkModelProject2</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#NetworkModelProjectComponent2" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.InfIEC61970.InfPart303.NetworkModelProjects</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Informative</cimdoc:packageTier>
  </owl:Class>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#NetworkModelProjectChange">
    <rdfs:comment xml:lang="en">Network model project change described by versions of an associated change set. Has persistent identity over multiple versions of the associated change set.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">NetworkModelProjectChange</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#NetworkModelProjectComponent" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.InfIEC61970.InfPart303.NetworkModelProjects</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Informative</cimdoc:packageTier>
  </owl:Class>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#NetworkModelProjectChangeVersion">
    <rdfs:comment xml:lang="en">Describes the status and the planned implementation of the associated change set into the as-built model. New instances of this class with new identity are instantiated upon changes to the content of this class or changes to the associated change set. Instances of this class are considered immutable. The case audit trail can reference this immutable data to exactly reproduce a case.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">NetworkModelProjectChangeVersion</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#IdentifiedObject" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.InfIEC61970.InfPart303.NetworkModelProjects</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Informative</cimdoc:packageTier>
  </owl:Class>
