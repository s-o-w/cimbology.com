  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#GovGAST1.ka">
    <rdfs:comment xml:lang="en">Governor gain (Ka). Typical value = 0.</rdfs:comment>
