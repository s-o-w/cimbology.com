  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#GovSteamFV4.kdc">
    <rdfs:comment xml:lang="en">Derivative gain of pressure regulator (Kdc). Typical value = 1.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#GovSteamFV4" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
