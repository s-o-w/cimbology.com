    <rdfs:comment xml:lang="en">Maximum voltage regulator outputs (VRMAX) (&gt; 0). Typical value = 7,8.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ExcIEEEST1A" />
