    <rdfs:comment xml:lang="en">Segment P end point (P1). Typical value = 1.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#UnderexcLim2Simplified" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">p1</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#UnderexcLim2Simplified.q0">
    <rdfs:comment xml:lang="en">Segment Q initial point (Q0). Typical value = -0,31.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#UnderexcLim2Simplified" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">q0</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#UnderexcLim2Simplified.q1">
    <rdfs:comment xml:lang="en">Segment Q end point (Q1). Typical value = -0,1.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#UnderexcLim2Simplified" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
