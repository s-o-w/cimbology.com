    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#UnitSymbol" />
    <rdfs:comment xml:lang="en">Mass in tons, �tonne� or �metric ton� (1000 kg = 1 Mg).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">tonne</rdfs:label>
