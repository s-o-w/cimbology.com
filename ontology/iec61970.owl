    <rdfs:label xml:lang="en">TCPAccessPoint</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#TCPAccessPoint" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#PublicX509Certificate.issuerName">
    <rdfs:comment xml:lang="en">Represents the CA that issued the certificate. Defined to be per X.509.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#PublicX509Certificate" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">issuerName</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#PublicX509Certificate.serialNumber">
    <rdfs:comment xml:lang="en">Is the serial number of the certificate per X.509 definition.</rdfs:comment>
