    <rdfs:comment xml:lang="en">Third term voltage exponent for active power (Ep3). Used only when . staticLoadModelType = exponential.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LoadStatic" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">ep3</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#LoadStatic.eq1">
    <rdfs:comment xml:lang="en">First term voltage exponent for reactive power (Eq1). Used only when . staticLoadModelType = exponential.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LoadStatic" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">eq1</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#LoadStatic.eq2">
    <rdfs:comment xml:lang="en">Second term voltage exponent for reactive power (Eq2). Used only when . staticLoadModelType = exponential.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#LoadStatic" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">eq2</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float" />
