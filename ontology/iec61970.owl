  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ExcSCRX.cswitch">
    <rdfs:comment xml:lang="en">Power source switch (Cswitch). true = fixed voltage of 1.0 PU false = generator terminal voltage.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ExcSCRX" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
