  </owl:Class>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#PostLineSensor">
    <rdfs:comment xml:lang="en">A sensor used mainly in overhead distribution networks as the source of both current and voltage measurements.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">PostLineSensor</rdfs:label>
