  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#Pss1">
    <rdfs:comment xml:lang="en">Italian PSS with three inputs (speed, frequency, power).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">Pss1</rdfs:label>
