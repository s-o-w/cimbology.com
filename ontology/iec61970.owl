  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#PublicX509Certificate.TCPAccessPoint">
    <rdfs:comment xml:lang="en">The association allows a certificate to be bound for use by TLS.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#PublicX509Certificate" />
