    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#Reservoir" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">spillwayCrestLength</rdfs:label>
