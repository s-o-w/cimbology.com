  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#GovGAST1.lmax">
    <rdfs:comment xml:lang="en">Ambient temperature load limit (Lmax). Lmax is the turbine power output corresponding to the limiting exhaust gas temperature. Typical value = 1.</rdfs:comment>
