  </owl:Class>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#PotentialTransformer">
    <rdfs:comment xml:lang="en">Instrument transformer (also known as Voltage Transformer) used to measure electrical qualities of the circuit that is being protected and/or monitored. Typically used as voltage transducer for the purpose of metering, protection, or sometimes auxiliary substation supply. A typical secondary voltage rating would be 120V.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">PotentialTransformer</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://iec.ch/TC57/CIM100#Sensor" />
    <cimdoc:cimPackage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IEC61970.Base.AuxiliaryEquipment</cimdoc:cimPackage>
    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#PotentialTransformer.accuracyClass">
    <rdfs:comment xml:lang="en">PT accuracy classification.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#PotentialTransformer" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
