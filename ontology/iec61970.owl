  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#CsPpccControlKind.dcVoltage">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#CsPpccControlKind" />
