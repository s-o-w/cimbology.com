  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#GovHydro3.k2">
    <rdfs:comment xml:lang="en">Double derivative gain, if Cflag = -1 (K2). Typical value = 2,5.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#GovHydro3" />
