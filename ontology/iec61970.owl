    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Measurement" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#MeasurementCalculatorInput.absoluteValue">
    <rdfs:comment xml:lang="en">If true, use the absolute value for the calculation.</rdfs:comment>
