  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#WindPitchContPowerIEC.tr">
    <rdfs:comment xml:lang="en">Voltage measurement time constant (Tr) (&gt;= 0). It is a type-dependent parameter.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#WindPitchContPowerIEC" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">tr</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#Seconds" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#WindPitchContPowerIEC.uuvrt">
    <rdfs:comment xml:lang="en">Dip detection threshold (uUVRT). It is a type- dependent parameter.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#WindPitchContPowerIEC" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
