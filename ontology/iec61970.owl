    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#WindPitchContPowerIEC.pmin">
    <rdfs:comment xml:lang="en">Minimum power setting (pmin). It is a type-dependent parameter.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#WindPitchContPowerIEC" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">pmin</rdfs:label>
    <rdfs:range rdf:resource="http://iec.ch/TC57/CIM100#PU" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#WindPitchContPowerIEC.pset">
    <rdfs:comment xml:lang="en">If pinit &lt; pset then power will be ramped down to pmin. It is (pset) in the IEC 61400-27-1:2015. It is a type-dependent parameter.</rdfs:comment>
