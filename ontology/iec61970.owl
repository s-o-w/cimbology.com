  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ExcST6B.k1">
    <rdfs:comment xml:lang="en">Selector (K1). true = feedback is from Ifd false = feedback is not from Ifd. Typical value = true.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ExcST6B" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
