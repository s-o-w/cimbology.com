  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ExcST6B.kcl">
    <rdfs:comment xml:lang="en">Exciter output current limit adjustment (Kcl) (&gt; 0). Typical value = 1, 0577.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ExcST6B" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
