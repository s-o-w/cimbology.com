  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ExcIEEEST6B.vamax">
    <rdfs:comment xml:lang="en">Maximum voltage regulator output (VAMAX) (&gt; 0). Typical value = 4,81.</rdfs:comment>
