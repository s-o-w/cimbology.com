    <cimdoc:packageTier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normative</cimdoc:packageTier>
  </owl:Class>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#ExcST6BOELselectorKind.afterUEL">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#ExcST6BOELselectorKind" />
    <rdfs:comment xml:lang="en">The connection is after UEL. Corresponds to OELin = 2 on the ExcST6B diagram.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">afterUEL</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#ExcST6BOELselectorKind.beforeUEL">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#ExcST6BOELselectorKind" />
    <rdfs:comment xml:lang="en">The connection is before UEL. Corresponds to OELin = 1 on the ExcST6B diagram.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">beforeUEL</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</cimdoc:enumCode>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#ExcST6BOELselectorKind.noOELinput">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#ExcST6BOELselectorKind" />
    <rdfs:comment xml:lang="en">No OEL input is used. Corresponds to OELin not = 1 and not = 2 on the ExcST6B diagram. Original ExcST6B model would have called this OELin = 0.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">noOELinput</rdfs:label>
    <cimdoc:enumCode rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</cimdoc:enumCode>
  </owl:NamedIndividual>
