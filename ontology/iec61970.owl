  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://iec.ch/TC57/CIM100#EnergyTypeKind.IndustrialLoad">
    <rdf:type rdf:resource="http://iec.ch/TC57/CIM100#EnergyTypeKind" />
    <rdfs:comment xml:lang="en">Industrial load.</rdfs:comment>
