  </owl:NamedIndividual>
  <owl:Class rdf:about="http://iec.ch/TC57/CIM100#EmissionValueSource">
    <rdfs:comment xml:lang="en">The source of the emission value.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">EmissionValueSource</rdfs:label>
