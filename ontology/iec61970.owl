  </owl:Class>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#IdentifiedObject.DiagramObjects">
    <rdfs:comment xml:lang="en">The diagram objects that are associated with the domain object.</rdfs:comment>
