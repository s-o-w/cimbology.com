  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#ICCPInformationMessage.localReference">
    <rdfs:comment xml:lang="en">The Local Reference attribute specifies a value agreed upon between sender and receiver of the Information Message. It further identifies the Information Message.</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ICCPInformationMessage" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">localReference</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://iec.ch/TC57/CIM100#ICCPInformationMessage.scope">
    <rdfs:comment xml:lang="en">Indicates if the Point is global scoped (e.g. VCC) or accessible only to the Bilateral table peer (e.g. ICC).</rdfs:comment>
    <rdfs:domain rdf:resource="http://iec.ch/TC57/CIM100#ICCPInformationMessage" />
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
