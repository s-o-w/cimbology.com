    <rdfs:comment xml:lang="en">Specifies the kind of energy type for an energy area component.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://cimbology.com/ontology/iec61970.ttl" />
    <rdfs:label xml:lang="en">EnergyTypeKind</rdfs:label>
