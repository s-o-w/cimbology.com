  <owl:DatatypeProperty rdf:about="http://iec.ch/TC57/CIM100#LoadStatic.kpf">
    <rdfs:comment xml:lang="en">Frequency deviation coefficient for active power (Kpf). Not used when .staticLoadModelType = constantZ.</rdfs:comment>
