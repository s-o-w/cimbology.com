cim:NetworkModelProjectChange a owl:Class;
                              rdfs:comment "Network model project change described by versions of an associated change set. Has persistent identity over multiple versions of the associated change set."@en;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "NetworkModelProjectChange"@en;
                              rdfs:subClassOf cim:NetworkModelProjectComponent;
                              cimdoc:cimPackage "IEC61970.InfIEC61970.InfPart303.NetworkModelProjects";
                              cimdoc:packageTier "Informative".
cim:NetworkModelProjectChangeVersion a owl:Class;
                                     rdfs:comment "Describes the status and the planned implementation of the associated change set into the as-built model. New instances of this class with new identity are instantiated upon changes to the content of this class or changes to the associated change set. Instances of this class are considered immutable. The case audit trail can reference this immutable data to exactly reproduce a case."@en;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                     rdfs:label "NetworkModelProjectChangeVersion"@en;
                                     rdfs:subClassOf cim:IdentifiedObject;
                                     cimdoc:cimPackage "IEC61970.InfIEC61970.InfPart303.NetworkModelProjects";
                                     cimdoc:packageTier "Informative".
cim:NetworkModelProjectChangeVersion.ChangeSet a owl:ObjectProperty;
                                               rdfs:comment "The details of model changes for this project. The change set should have a new identifier if it changes."@en;
                                               rdfs:domain cim:NetworkModelProjectChangeVersion;
                                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                               rdfs:label "ChangeSet"@en;
                                               rdfs:range cim:ChangeSet.
cim:NetworkModelProjectChangeVersion.NetworkModelProjectChange a owl:ObjectProperty;
                                                               rdfs:comment "The persistent network model project change to which this version applies."@en;
                                                               rdfs:domain cim:NetworkModelProjectChangeVersion;
                                                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                               rdfs:label "NetworkModelProjectChange"@en;
                                                               rdfs:range cim:NetworkModelProjectChange.
cim:NetworkModelProjectChangeVersion.NetworkModelProjectState a owl:ObjectProperty;
                                                              rdfs:comment "The state of the network model project for this version."@en;
                                                              rdfs:domain cim:NetworkModelProjectChangeVersion;
                                                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                              rdfs:label "NetworkModelProjectState"@en;
                                                              rdfs:range cim:NetworkModelProjectState.
cim:NetworkModelProjectChangeVersion.SupercededBy a owl:ObjectProperty;
                                                  rdfs:comment "The version that supersedes this one, if any."@en;
                                                  rdfs:domain cim:NetworkModelProjectChangeVersion;
                                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                  rdfs:label "SupercededBy"@en;
                                                  rdfs:range cim:NetworkModelProjectChangeVersion.
cim:NetworkModelProjectChangeVersion.comment a owl:DatatypeProperty;
                                             rdfs:comment "A user provided comment describing the changes in this version from the previous version."@en;
                                             rdfs:domain cim:NetworkModelProjectChangeVersion;
                                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                             rdfs:label "comment"@en;
                                             rdfs:range xsd:string.
cim:NetworkModelProjectChangeVersion.effectiveDateTime a owl:DatatypeProperty;
                                                       rdfs:comment "The date/time the change set is included in the model."@en;
                                                       rdfs:domain cim:NetworkModelProjectChangeVersion;
                                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                       rdfs:label "effectiveDateTime"@en;
                                                       rdfs:range xsd:dateTime.
cim:NetworkModelProjectChangeVersion.timeStamp a owl:DatatypeProperty;
                                               rdfs:comment "The date/time this version was finalized and thus made immutable."@en;
                                               rdfs:domain cim:NetworkModelProjectChangeVersion;
                                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                               rdfs:label "timeStamp"@en;
                                               rdfs:range xsd:dateTime.
cim:NetworkModelProjectCollection a owl:Class;
