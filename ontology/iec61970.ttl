cim:ExcDC1A a owl:Class;
            rdfs:comment "Modified IEEE DC1A direct current commutator exciter with speed input and without underexcitation limiters (UEL) inputs."@en;
            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
            rdfs:label "ExcDC1A"@en;
            rdfs:subClassOf cim:ExcitationSystemDynamics;
            cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.ExcitationSystemDynamics";
            cimdoc:packageTier "Normative".
cim:ExcDC1A.efd1 a owl:DatatypeProperty;
                 rdfs:comment "Exciter voltage at which exciter saturation is defined (Efd1) (> 0). Typical value = 3,1."@en;
                 rdfs:domain cim:ExcDC1A;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "efd1"@en;
                 rdfs:range cim:PU.
cim:ExcDC1A.efd2 a owl:DatatypeProperty;
                 rdfs:comment "Exciter voltage at which exciter saturation is defined (Efd2) (> 0). Typical value = 2,3."@en;
                 rdfs:domain cim:ExcDC1A;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "efd2"@en;
                 rdfs:range cim:PU.
cim:ExcDC1A.efdmax a owl:DatatypeProperty;
                   rdfs:comment "Maximum voltage exciter output limiter (Efdmax) (> ExcDC1A.efdmin). Typical value = 99."@en;
                   rdfs:domain cim:ExcDC1A;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "efdmax"@en;
                   rdfs:range cim:PU.
cim:ExcDC1A.efdmin a owl:DatatypeProperty;
                   rdfs:comment "Minimum voltage exciter output limiter (Efdmin) (less than ExcDC1A.efdmax). Typical value = -99."@en;
                   rdfs:domain cim:ExcDC1A;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "efdmin"@en;
                   rdfs:range cim:PU.
cim:ExcDC1A.exclim a owl:DatatypeProperty;
                   rdfs:comment "(exclim). IEEE standard is ambiguous about lower limit on exciter output. true = a lower limit of zero is applied to integrator output false = a lower limit of zero is not applied to integrator output. Typical value = true."@en;
                   rdfs:domain cim:ExcDC1A;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "exclim"@en;
                   rdfs:range xsd:boolean.
cim:ExcDC1A.ka a owl:DatatypeProperty;
               rdfs:comment "Voltage regulator gain (Ka) (> 0). Typical value = 46."@en;
               rdfs:domain cim:ExcDC1A;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "ka"@en;
               rdfs:range cim:PU.
cim:ExcDC1A.ke a owl:DatatypeProperty;
               rdfs:comment "Exciter constant related to self-excited field (Ke). Typical value = 0."@en;
               rdfs:domain cim:ExcDC1A;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "ke"@en;
               rdfs:range cim:PU.
cim:ExcDC1A.kf a owl:DatatypeProperty;
               rdfs:comment "Excitation control system stabilizer gain (Kf) (>= 0). Typical value = 0,1."@en;
               rdfs:domain cim:ExcDC1A;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "kf"@en;
               rdfs:range cim:PU.
cim:ExcDC1A.ks a owl:DatatypeProperty;
               rdfs:comment "Coefficient to allow different usage of the model-speed coefficient (Ks). Typical value = 0."@en;
               rdfs:domain cim:ExcDC1A;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "ks"@en;
               rdfs:range cim:PU.
cim:ExcDC1A.seefd1 a owl:DatatypeProperty;
                   rdfs:comment "Exciter saturation function value at the corresponding exciter voltage, Efd1 (Se[Eefd1]) (>= 0). Typical value = 0,33."@en;
                   rdfs:domain cim:ExcDC1A;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "seefd1"@en;
                   rdfs:range xsd:float.
cim:ExcDC1A.seefd2 a owl:DatatypeProperty;
                   rdfs:comment "Exciter saturation function value at the corresponding exciter voltage, Efd2 (Se[Eefd2]) (>= 0). Typical value = 0,1."@en;
                   rdfs:domain cim:ExcDC1A;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "seefd2"@en;
                   rdfs:range xsd:float.
cim:ExcDC1A.ta a owl:DatatypeProperty;
               rdfs:comment "Voltage regulator time constant (Ta) (> 0). Typical value = 0,06."@en;
               rdfs:domain cim:ExcDC1A;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "ta"@en;
               rdfs:range cim:Seconds.
cim:ExcDC1A.tb a owl:DatatypeProperty;
               rdfs:comment "Voltage regulator time constant (Tb) (>= 0). Typical value = 0."@en;
               rdfs:domain cim:ExcDC1A;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "tb"@en;
               rdfs:range cim:Seconds.
cim:ExcDC1A.tc a owl:DatatypeProperty;
               rdfs:comment "Voltage regulator time constant (Tc) (>= 0). Typical value = 0."@en;
               rdfs:domain cim:ExcDC1A;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "tc"@en;
               rdfs:range cim:Seconds.
cim:ExcDC1A.te a owl:DatatypeProperty;
               rdfs:comment "Exciter time constant, integration rate associated with exciter control (Te) (> 0). Typical value = 0,46."@en;
               rdfs:domain cim:ExcDC1A;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "te"@en;
               rdfs:range cim:Seconds.
cim:ExcDC1A.tf a owl:DatatypeProperty;
               rdfs:comment "Excitation control system stabilizer time constant (Tf) (> 0). Typical value = 1."@en;
               rdfs:domain cim:ExcDC1A;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "tf"@en;
               rdfs:range cim:Seconds.
cim:ExcDC1A.vrmax a owl:DatatypeProperty;
                  rdfs:comment "Maximum voltage regulator output (Vrmax) (> ExcDC1A.vrmin). Typical value = 1."@en;
                  rdfs:domain cim:ExcDC1A;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "vrmax"@en;
                  rdfs:range cim:PU.
cim:ExcDC1A.vrmin a owl:DatatypeProperty;
                  rdfs:comment "Minimum voltage regulator output (Vrmin) (less than 0 and less than ExcDC1A.vrmax). Typical value = -0,9."@en;
                  rdfs:domain cim:ExcDC1A;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "vrmin"@en;
                  rdfs:range cim:PU.
cim:ExcDC2A a owl:Class;
            rdfs:comment "Modified IEEE DC2A direct current commutator exciter with speed input, one more leg block in feedback loop and without underexcitation limiters (UEL) inputs. DC type 2 excitation system model with added speed multiplier, added lead-lag, and voltage-dependent limits."@en;
            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
            rdfs:label "ExcDC2A"@en;
            rdfs:subClassOf cim:ExcitationSystemDynamics;
            cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.ExcitationSystemDynamics";
            cimdoc:packageTier "Normative".
cim:ExcDC2A.efd1 a owl:DatatypeProperty;
                 rdfs:comment "Exciter voltage at which exciter saturation is defined (Efd1) (> 0). Typical value = 3,05."@en;
                 rdfs:domain cim:ExcDC2A;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "efd1"@en;
                 rdfs:range cim:PU.
cim:ExcDC2A.efd2 a owl:DatatypeProperty;
                 rdfs:comment "Exciter voltage at which exciter saturation is defined (Efd2) (> 0). Typical value = 2,29."@en;
                 rdfs:domain cim:ExcDC2A;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "efd2"@en;
                 rdfs:range cim:PU.
cim:ExcDC2A.exclim a owl:DatatypeProperty;
                   rdfs:comment "(exclim). IEEE standard is ambiguous about lower limit on exciter output. true = a lower limit of zero is applied to integrator output false = a lower limit of zero is not applied to integrator output. Typical value = true."@en;
                   rdfs:domain cim:ExcDC2A;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "exclim"@en;
                   rdfs:range xsd:boolean.
cim:ExcDC2A.ka a owl:DatatypeProperty;
               rdfs:comment "Voltage regulator gain (Ka) (> 0). Typical value = 300."@en;
               rdfs:domain cim:ExcDC2A;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "ka"@en;
               rdfs:range cim:PU.
cim:ExcDC2A.ke a owl:DatatypeProperty;
               rdfs:comment "Exciter constant related to self-excited field (Ke). If Ke is entered as zero, the model calculates an effective value of Ke such that the initial condition value of Vr is zero. The zero value of Ke is not changed. If Ke is entered as non-zero, its value is used directly, without change. Typical value = 1."@en;
               rdfs:domain cim:ExcDC2A;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "ke"@en;
               rdfs:range cim:PU.
cim:ExcDC2A.kf a owl:DatatypeProperty;
               rdfs:comment "Excitation control system stabilizer gain (Kf) (>= 0). Typical value = 0,1."@en;
               rdfs:domain cim:ExcDC2A;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "kf"@en;
               rdfs:range cim:PU.
cim:ExcDC2A.ks a owl:DatatypeProperty;
               rdfs:comment "Coefficient to allow different usage of the model-speed coefficient (Ks). Typical value = 0."@en;
               rdfs:domain cim:ExcDC2A;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "ks"@en;
               rdfs:range cim:PU.
cim:ExcDC2A.seefd1 a owl:DatatypeProperty;
                   rdfs:comment "Exciter saturation function value at the corresponding exciter voltage, Efd1 (Se[Efd1]) (>= 0). Typical value = 0,279."@en;
                   rdfs:domain cim:ExcDC2A;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "seefd1"@en;
                   rdfs:range xsd:float.
cim:ExcDC2A.seefd2 a owl:DatatypeProperty;
                   rdfs:comment "Exciter saturation function value at the corresponding exciter voltage, Efd2 (Se[Efd2]) (>= 0). Typical value = 0,117."@en;
                   rdfs:domain cim:ExcDC2A;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "seefd2"@en;
                   rdfs:range xsd:float.
cim:ExcDC2A.ta a owl:DatatypeProperty;
               rdfs:comment "Voltage regulator time constant (Ta) (> 0). Typical value = 0,01."@en;
               rdfs:domain cim:ExcDC2A;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "ta"@en;
               rdfs:range cim:Seconds.
cim:ExcDC2A.tb a owl:DatatypeProperty;
               rdfs:comment "Voltage regulator time constant (Tb) (>= 0). Typical value = 0."@en;
               rdfs:domain cim:ExcDC2A;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "tb"@en;
               rdfs:range cim:Seconds.
cim:ExcDC2A.tc a owl:DatatypeProperty;
               rdfs:comment "Voltage regulator time constant (Tc) (>= 0). Typical value = 0."@en;
               rdfs:domain cim:ExcDC2A;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "tc"@en;
               rdfs:range cim:Seconds.
cim:ExcDC2A.te a owl:DatatypeProperty;
               rdfs:comment "Exciter time constant, integration rate associated with exciter control (Te) (> 0). Typical value = 1,33."@en;
               rdfs:domain cim:ExcDC2A;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "te"@en;
               rdfs:range cim:Seconds.
cim:ExcDC2A.tf a owl:DatatypeProperty;
               rdfs:comment "Excitation control system stabilizer time constant (Tf) (> 0). Typical value = 0,675."@en;
               rdfs:domain cim:ExcDC2A;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "tf"@en;
               rdfs:range cim:Seconds.
cim:ExcDC2A.tf1 a owl:DatatypeProperty;
                rdfs:comment "Excitation control system stabilizer time constant (Tf1) (>= 0). Typical value = 0."@en;
                rdfs:domain cim:ExcDC2A;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "tf1"@en;
                rdfs:range cim:Seconds.
cim:ExcDC2A.vrmax a owl:DatatypeProperty;
                  rdfs:comment "Maximum voltage regulator output (Vrmax) (> ExcDC2A.vrmin). Typical value = 4,95."@en;
                  rdfs:domain cim:ExcDC2A;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "vrmax"@en;
                  rdfs:range cim:PU.
cim:ExcDC2A.vrmin a owl:DatatypeProperty;
                  rdfs:comment "Minimum voltage regulator output (Vrmin) (< 0 and < ExcDC2A.vrmax). Typical value = -4,9."@en;
                  rdfs:domain cim:ExcDC2A;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "vrmin"@en;
                  rdfs:range cim:PU.
cim:ExcDC2A.vtlim a owl:DatatypeProperty;
                  rdfs:comment "(Vtlim). true = limiter at the block (Ka / [1 + sTa]) is dependent on Vt false = limiter at the block is not dependent on Vt. Typical value = true."@en;
                  rdfs:domain cim:ExcDC2A;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "vtlim"@en;
                  rdfs:range xsd:boolean.
cim:ExcDC3A a owl:Class;
            rdfs:comment "Modified IEEE DC3A direct current commutator exciter with speed input, and deadband. DC old type 4."@en;
            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
            rdfs:label "ExcDC3A"@en;
            rdfs:subClassOf cim:ExcitationSystemDynamics;
            cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.ExcitationSystemDynamics";
            cimdoc:packageTier "Normative".
cim:ExcDC3A.efd1 a owl:DatatypeProperty;
                 rdfs:comment "Exciter voltage at which exciter saturation is defined (Efd1) (> 0). Typical value = 2,6."@en;
                 rdfs:domain cim:ExcDC3A;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "efd1"@en;
                 rdfs:range cim:PU.
cim:ExcDC3A.efd2 a owl:DatatypeProperty;
                 rdfs:comment "Exciter voltage at which exciter saturation is defined (Efd2) (> 0). Typical value = 3,45."@en;
                 rdfs:domain cim:ExcDC3A;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "efd2"@en;
                 rdfs:range cim:PU.
cim:ExcDC3A.efdlim a owl:DatatypeProperty;
                   rdfs:comment "(Efdlim). true = exciter output limiter is active false = exciter output limiter not active. Typical value = true."@en;
                   rdfs:domain cim:ExcDC3A;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "efdlim"@en;
                   rdfs:range xsd:boolean.
cim:ExcDC3A.efdmax a owl:DatatypeProperty;
                   rdfs:comment "Maximum voltage exciter output limiter (Efdmax) (> ExcDC3A.efdmin). Typical value = 99."@en;
                   rdfs:domain cim:ExcDC3A;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "efdmax"@en;
                   rdfs:range cim:PU.
cim:ExcDC3A.efdmin a owl:DatatypeProperty;
                   rdfs:comment "Minimum voltage exciter output limiter (Efdmin) (< ExcDC3A.efdmax). Typical value = -99."@en;
                   rdfs:domain cim:ExcDC3A;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "efdmin"@en;
                   rdfs:range cim:PU.
cim:ExcDC3A.exclim a owl:DatatypeProperty;
                   rdfs:comment "(exclim). IEEE standard is ambiguous about lower limit on exciter output. true = a lower limit of zero is applied to integrator output false = a lower limit of zero not applied to integrator output. Typical value = true."@en;
                   rdfs:domain cim:ExcDC3A;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "exclim"@en;
                   rdfs:range xsd:boolean.
cim:ExcDC3A.ke a owl:DatatypeProperty;
               rdfs:comment "Exciter constant related to self-excited field (Ke). Typical value = 1."@en;
               rdfs:domain cim:ExcDC3A;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "ke"@en;
               rdfs:range cim:PU.
cim:ExcDC3A.kr a owl:DatatypeProperty;
               rdfs:comment "Deadband (Kr). Typical value = 0."@en;
