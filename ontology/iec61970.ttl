             rdfs:label "t7"@en;
             rdfs:range cim:Seconds.
cim:Pss2B.t8 a owl:DatatypeProperty;
             rdfs:comment "Lead of ramp tracking filter (T8) (>= 0). Typical value = 0,2."@en;
