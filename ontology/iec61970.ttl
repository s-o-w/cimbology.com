                  cimdoc:packageTier "Normative".
cim:RemoteControl.Control a owl:ObjectProperty;
                          rdfs:comment "The Control for the RemoteControl point."@en;
                          rdfs:domain cim:RemoteControl;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                          rdfs:label "Control"@en;
                          rdfs:range cim:Control.
cim:RemoteControl.actuatorMaximum a owl:DatatypeProperty;
