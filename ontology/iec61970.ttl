cim:ExcIEEEST4B a owl:Class;
                rdfs:comment "IEEE 421.5-2005 type ST4B model. This model is a variation of the type ST3A model, with a proportional plus integral (PI) regulator block replacing the lag- lead regulator characteristic that is in the ST3A model. Both potential and compound source rectifier excitation systems are modelled. The PI regulator blocks have non-windup limits that are represented. The voltage regulator of this model is typically implemented digitally. Reference: IEEE 421.5-2005, 7.4."@en;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "ExcIEEEST4B"@en;
                rdfs:subClassOf cim:ExcitationSystemDynamics;
                cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.ExcitationSystemDynamics";
                cimdoc:packageTier "Normative".
cim:ExcIEEEST4B.kc a owl:DatatypeProperty;
                   rdfs:comment "Rectifier loading factor proportional to commutating reactance (KC) (>= 0). Typical value = 0,113."@en;
                   rdfs:domain cim:ExcIEEEST4B;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "kc"@en;
                   rdfs:range cim:PU.
cim:ExcIEEEST4B.kg a owl:DatatypeProperty;
                   rdfs:comment "Feedback gain constant of the inner loop field regulator (KG) (>= 0). Typical value = 0."@en;
