                                                         rdfs:domain cim:VoltageAdjusterDynamics;
                                                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                         rdfs:label "PFVArControllerType1Dynamics"@en;
