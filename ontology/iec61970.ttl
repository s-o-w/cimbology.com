cim:PFVArType1IEEEVArController.vvtmin a owl:DatatypeProperty;
                                       rdfs:comment "Minimum machine terminal voltage needed to enable pf/var controller (VVTMIN) (less than PFVArType1IEEEVArController.vvtmax)."@en;
                                       rdfs:domain cim:PFVArType1IEEEVArController;
                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
