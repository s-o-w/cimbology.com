                   rdfs:label "kp"@en;
                   rdfs:range cim:PU.
cim:ExcIEEEAC7B.kpa a owl:DatatypeProperty;
                    rdfs:comment "Voltage regulator proportional gain (KPA) (> 0 if ExcIEEEAC7B.kia = 0). Typical value = 65,36."@en;
                    rdfs:domain cim:ExcIEEEAC7B;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "kpa"@en;
                    rdfs:range cim:PU.
cim:ExcIEEEAC7B.kpr a owl:DatatypeProperty;
                    rdfs:comment "Voltage regulator proportional gain (KPR) (> 0 if ExcIEEEAC7B.kir = 0). Typical value = 4,24."@en;
                    rdfs:domain cim:ExcIEEEAC7B;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "kpr"@en;
