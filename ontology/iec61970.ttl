cim:ExcDC3A1.vblim a owl:DatatypeProperty;
                   rdfs:comment "Vb limiter indicator. true = exciter Vbmax limiter is active false = Vb1max is active. Typical value = true."@en;
                   rdfs:domain cim:ExcDC3A1;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "vblim"@en;
                   rdfs:range xsd:boolean.
cim:ExcDC3A1.vbmax a owl:DatatypeProperty;
                   rdfs:comment "Available exciter voltage limiter (Vbmax) (> 0). Typical value = 11,63."@en;
                   rdfs:domain cim:ExcDC3A1;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "vbmax"@en;
