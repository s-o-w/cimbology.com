cim:ExcAC8B.inlim a owl:DatatypeProperty;
                  rdfs:comment "Input limiter indicator. true = input limiter Vimax and Vimin is considered false = input limiter Vimax and Vimin is not considered. Typical value = true."@en;
                  rdfs:domain cim:ExcAC8B;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "inlim"@en;
                  rdfs:range xsd:boolean.
cim:ExcAC8B.ka a owl:DatatypeProperty;
               rdfs:comment "Voltage regulator gain (Ka) (> 0). Typical value = 1."@en;
               rdfs:domain cim:ExcAC8B;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "ka"@en;
               rdfs:range cim:PU.
cim:ExcAC8B.kc a owl:DatatypeProperty;
               rdfs:comment "Rectifier loading factor proportional to commutating reactance (Kc) (>= 0). Typical value = 0,55."@en;
               rdfs:domain cim:ExcAC8B;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "kc"@en;
               rdfs:range cim:PU.
cim:ExcAC8B.kd a owl:DatatypeProperty;
               rdfs:comment "Demagnetizing factor, a function of exciter alternator reactances (Kd) (>= 0). Typical value = 1,1."@en;
               rdfs:domain cim:ExcAC8B;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "kd"@en;
               rdfs:range cim:PU.
cim:ExcAC8B.kdr a owl:DatatypeProperty;
                rdfs:comment "Voltage regulator derivative gain (Kdr) (>= 0). Typical value = 10."@en;
                rdfs:domain cim:ExcAC8B;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "kdr"@en;
                rdfs:range cim:PU.
cim:ExcAC8B.ke a owl:DatatypeProperty;
               rdfs:comment "Exciter constant related to self-excited field (Ke). Typical value = 1."@en;
               rdfs:domain cim:ExcAC8B;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "ke"@en;
               rdfs:range cim:PU.
cim:ExcAC8B.kir a owl:DatatypeProperty;
                rdfs:comment "Voltage regulator integral gain (Kir) (>= 0). Typical value = 5."@en;
                rdfs:domain cim:ExcAC8B;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "kir"@en;
                rdfs:range cim:PU.
cim:ExcAC8B.kpr a owl:DatatypeProperty;
                rdfs:comment "Voltage regulator proportional gain (Kpr) (> 0 if ExcAC8B.kir = 0). Typical value = 80."@en;
                rdfs:domain cim:ExcAC8B;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "kpr"@en;
                rdfs:range cim:PU.
cim:ExcAC8B.ks a owl:DatatypeProperty;
               rdfs:comment "Coefficient to allow different usage of the model-speed coefficient (Ks). Typical value = 0."@en;
               rdfs:domain cim:ExcAC8B;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "ks"@en;
               rdfs:range cim:PU.
cim:ExcAC8B.pidlim a owl:DatatypeProperty;
                   rdfs:comment "PID limiter indicator. true = input limiter Vpidmax and Vpidmin is considered false = input limiter Vpidmax and Vpidmin is not considered. Typical value = true."@en;
                   rdfs:domain cim:ExcAC8B;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "pidlim"@en;
                   rdfs:range xsd:boolean.
cim:ExcAC8B.seve1 a owl:DatatypeProperty;
                  rdfs:comment "Exciter saturation function value at the corresponding exciter voltage, Ve1, back of commutating reactance (Se[Ve1]) (>= 0). Typical value = 0,3."@en;
                  rdfs:domain cim:ExcAC8B;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "seve1"@en;
                  rdfs:range xsd:float.
cim:ExcAC8B.seve2 a owl:DatatypeProperty;
                  rdfs:comment "Exciter saturation function value at the corresponding exciter voltage, Ve2, back of commutating reactance (Se[Ve2]) (>= 0). Typical value = 3."@en;
                  rdfs:domain cim:ExcAC8B;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "seve2"@en;
                  rdfs:range xsd:float.
cim:ExcAC8B.ta a owl:DatatypeProperty;
               rdfs:comment "Voltage regulator time constant (Ta) (>= 0). Typical value = 0."@en;
               rdfs:domain cim:ExcAC8B;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "ta"@en;
               rdfs:range cim:Seconds.
cim:ExcAC8B.tdr a owl:DatatypeProperty;
                rdfs:comment "Lag time constant (Tdr) (> 0 if ExcAC8B.kdr > 0). Typical value = 0,1."@en;
                rdfs:domain cim:ExcAC8B;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "tdr"@en;
                rdfs:range cim:Seconds.
cim:ExcAC8B.te a owl:DatatypeProperty;
               rdfs:comment "Exciter time constant, integration rate associated with exciter control (Te) (> 0). Typical value = 1,2."@en;
               rdfs:domain cim:ExcAC8B;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "te"@en;
               rdfs:range cim:Seconds.
cim:ExcAC8B.telim a owl:DatatypeProperty;
                  rdfs:comment "Selector for the limiter on the block (1/sTe). See diagram for meaning of true and false. Typical value = false."@en;
                  rdfs:domain cim:ExcAC8B;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "telim"@en;
                  rdfs:range xsd:boolean.
cim:ExcAC8B.ve1 a owl:DatatypeProperty;
                rdfs:comment "Exciter alternator output voltages back of commutating reactance at which saturation is defined (Ve1) (> 0). Typical value = 6, 5."@en;
                rdfs:domain cim:ExcAC8B;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "ve1"@en;
                rdfs:range cim:PU.
cim:ExcAC8B.ve2 a owl:DatatypeProperty;
                rdfs:comment "Exciter alternator output voltages back of commutating reactance at which saturation is defined (Ve2) (> 0). Typical value = 9."@en;
                rdfs:domain cim:ExcAC8B;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "ve2"@en;
                rdfs:range cim:PU.
cim:ExcAC8B.vemin a owl:DatatypeProperty;
                  rdfs:comment "Minimum exciter voltage output (Vemin) (less than or equal to 0). Typical value = 0."@en;
                  rdfs:domain cim:ExcAC8B;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "vemin"@en;
                  rdfs:range cim:PU.
cim:ExcAC8B.vfemax a owl:DatatypeProperty;
                   rdfs:comment "Exciter field current limit reference (Vfemax). Typical value = 6."@en;
                   rdfs:domain cim:ExcAC8B;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "vfemax"@en;
                   rdfs:range cim:PU.
cim:ExcAC8B.vimax a owl:DatatypeProperty;
                  rdfs:comment "Input signal maximum (Vimax) (> ExcAC8B.vimin). Typical value = 35."@en;
                  rdfs:domain cim:ExcAC8B;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "vimax"@en;
                  rdfs:range cim:PU.
cim:ExcAC8B.vimin a owl:DatatypeProperty;
                  rdfs:comment "Input signal minimum (Vimin) (less than ExcAC8B.vimax). Typical value = -10."@en;
                  rdfs:domain cim:ExcAC8B;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "vimin"@en;
                  rdfs:range cim:PU.
cim:ExcAC8B.vpidmax a owl:DatatypeProperty;
                    rdfs:comment "PID maximum controller output (Vpidmax) (> ExcAC8B.vpidmin). Typical value = 35."@en;
                    rdfs:domain cim:ExcAC8B;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "vpidmax"@en;
                    rdfs:range cim:PU.
cim:ExcAC8B.vpidmin a owl:DatatypeProperty;
                    rdfs:comment "PID minimum controller output (Vpidmin) (less than ExcAC8B.vpidmax). Typical value = -10."@en;
                    rdfs:domain cim:ExcAC8B;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "vpidmin"@en;
                    rdfs:range cim:PU.
cim:ExcAC8B.vrmax a owl:DatatypeProperty;
                  rdfs:comment "Maximum voltage regulator output (Vrmax) (> 0). Typical value = 35."@en;
                  rdfs:domain cim:ExcAC8B;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "vrmax"@en;
                  rdfs:range cim:PU.
cim:ExcAC8B.vrmin a owl:DatatypeProperty;
                  rdfs:comment "Minimum voltage regulator output (Vrmin) (less than 0). Typical value = 0."@en;
                  rdfs:domain cim:ExcAC8B;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "vrmin"@en;
                  rdfs:range cim:PU.
cim:ExcAC8B.vtmult a owl:DatatypeProperty;
                   rdfs:comment "Multiply by generator's terminal voltage indicator. true =the limits Vrmax and Vrmin are multiplied by the generator�s terminal voltage to represent a thyristor power stage fed from the generator terminals false = limits are not multiplied by generator's terminal voltage. Typical value = false."@en;
                   rdfs:domain cim:ExcAC8B;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "vtmult"@en;
                   rdfs:range xsd:boolean.
cim:ExcANS a owl:Class;
           rdfs:comment "Italian excitation system. It represents static field voltage or excitation current feedback excitation system."@en;
           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
           rdfs:label "ExcANS"@en;
           rdfs:subClassOf cim:ExcitationSystemDynamics;
           cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.ExcitationSystemDynamics";
           cimdoc:packageTier "Normative".
cim:ExcANS.blint a owl:DatatypeProperty;
                 rdfs:comment "Governor control flag (BLINT). 0 = lead-lag regulator 1 = proportional integral regulator. Typical value = 0."@en;
                 rdfs:domain cim:ExcANS;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "blint"@en;
                 rdfs:range xsd:integer.
cim:ExcANS.ifmn a owl:DatatypeProperty;
                rdfs:comment "Minimum exciter current (IFMN). Typical value = -5,2."@en;
                rdfs:domain cim:ExcANS;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "ifmn"@en;
                rdfs:range cim:PU.
cim:ExcANS.ifmx a owl:DatatypeProperty;
                rdfs:comment "Maximum exciter current (IFMX). Typical value = 6,5."@en;
                rdfs:domain cim:ExcANS;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "ifmx"@en;
                rdfs:range cim:PU.
cim:ExcANS.k2 a owl:DatatypeProperty;
              rdfs:comment "Exciter gain (K2). Typical value = 20."@en;
              rdfs:domain cim:ExcANS;
              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
              rdfs:label "k2"@en;
              rdfs:range xsd:float.
cim:ExcANS.k3 a owl:DatatypeProperty;
              rdfs:comment "AVR gain (K3). Typical value = 1000."@en;
              rdfs:domain cim:ExcANS;
              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
              rdfs:label "k3"@en;
              rdfs:range xsd:float.
cim:ExcANS.kce a owl:DatatypeProperty;
               rdfs:comment "Ceiling factor (KCE). Typical value = 1."@en;
               rdfs:domain cim:ExcANS;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "kce"@en;
               rdfs:range xsd:float.
cim:ExcANS.krvecc a owl:DatatypeProperty;
                  rdfs:comment "Feedback enabling (KRVECC). 0 = open loop control 1 = closed loop control. Typical value = 1."@en;
                  rdfs:domain cim:ExcANS;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "krvecc"@en;
                  rdfs:range xsd:integer.
cim:ExcANS.kvfif a owl:DatatypeProperty;
                 rdfs:comment "Rate feedback signal flag (KVFIF). 0 = output voltage of the exciter 1 = exciter field current. Typical value = 0."@en;
                 rdfs:domain cim:ExcANS;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "kvfif"@en;
                 rdfs:range xsd:integer.
cim:ExcANS.t1 a owl:DatatypeProperty;
              rdfs:comment "Time constant (T1) (>= 0). Typical value = 20."@en;
              rdfs:domain cim:ExcANS;
              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
              rdfs:label "t1"@en;
              rdfs:range cim:Seconds.
cim:ExcANS.t2 a owl:DatatypeProperty;
              rdfs:comment "Time constant (T2) (>= 0). Typical value = 0,05."@en;
              rdfs:domain cim:ExcANS;
              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
              rdfs:label "t2"@en;
              rdfs:range cim:Seconds.
cim:ExcANS.t3 a owl:DatatypeProperty;
              rdfs:comment "Time constant (T3) (>= 0). Typical value = 1,6."@en;
              rdfs:domain cim:ExcANS;
              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
              rdfs:label "t3"@en;
              rdfs:range cim:Seconds.
cim:ExcANS.tb a owl:DatatypeProperty;
              rdfs:comment "Exciter time constant (TB) (>= 0). Typical value = 0, 04."@en;
              rdfs:domain cim:ExcANS;
              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
              rdfs:label "tb"@en;
              rdfs:range cim:Seconds.
cim:ExcANS.vrmn a owl:DatatypeProperty;
                rdfs:comment "Minimum AVR output (VRMN). Typical value = -5,2."@en;
                rdfs:domain cim:ExcANS;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "vrmn"@en;
                rdfs:range cim:PU.
cim:ExcANS.vrmx a owl:DatatypeProperty;
                rdfs:comment "Maximum AVR output (VRMX). Typical value = 6,5."@en;
                rdfs:domain cim:ExcANS;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "vrmx"@en;
                rdfs:range cim:PU.
cim:ExcAVR1 a owl:Class;
            rdfs:comment "Italian excitation system corresponding to IEEE (1968) type 1 model. It represents an exciter dynamo and electromechanical regulator."@en;
            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
            rdfs:label "ExcAVR1"@en;
            rdfs:subClassOf cim:ExcitationSystemDynamics;
            cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.ExcitationSystemDynamics";
            cimdoc:packageTier "Normative".
cim:ExcAVR1.e1 a owl:DatatypeProperty;
               rdfs:comment "Field voltage value 1 (E1). Typical value = 4.18."@en;
               rdfs:domain cim:ExcAVR1;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "e1"@en;
               rdfs:range cim:PU.
cim:ExcAVR1.e2 a owl:DatatypeProperty;
               rdfs:comment "Field voltage value 2 (E2). Typical value = 3,14."@en;
               rdfs:domain cim:ExcAVR1;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "e2"@en;
               rdfs:range cim:PU.
cim:ExcAVR1.ka a owl:DatatypeProperty;
               rdfs:comment "AVR gain (KA). Typical value = 500."@en;
               rdfs:domain cim:ExcAVR1;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "ka"@en;
               rdfs:range xsd:float.
cim:ExcAVR1.kf a owl:DatatypeProperty;
               rdfs:comment "Rate feedback gain (KF). Typical value = 0,12."@en;
               rdfs:domain cim:ExcAVR1;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "kf"@en;
               rdfs:range xsd:float.
cim:ExcAVR1.se1 a owl:DatatypeProperty;
                rdfs:comment "Saturation factor at E1 (S[E1]). Typical value = 0,1."@en;
                rdfs:domain cim:ExcAVR1;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "se1"@en;
                rdfs:range xsd:float.
cim:ExcAVR1.se2 a owl:DatatypeProperty;
                rdfs:comment "Saturation factor at E2 (S[E2]). Typical value = 0,03."@en;
                rdfs:domain cim:ExcAVR1;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "se2"@en;
                rdfs:range xsd:float.
cim:ExcAVR1.ta a owl:DatatypeProperty;
               rdfs:comment "AVR time constant (TA) (>= 0). Typical value = 0,2."@en;
               rdfs:domain cim:ExcAVR1;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "ta"@en;
               rdfs:range cim:Seconds.
cim:ExcAVR1.tb a owl:DatatypeProperty;
               rdfs:comment "AVR time constant (TB) (>= 0). Typical value = 0."@en;
               rdfs:domain cim:ExcAVR1;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "tb"@en;
               rdfs:range cim:Seconds.
cim:ExcAVR1.te a owl:DatatypeProperty;
               rdfs:comment "Exciter time constant (TE) (>= 0). Typical value = 1."@en;
               rdfs:domain cim:ExcAVR1;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "te"@en;
               rdfs:range cim:Seconds.
cim:ExcAVR1.tf a owl:DatatypeProperty;
               rdfs:comment "Rate feedback time constant (TF) (>= 0). Typical value = 1."@en;
               rdfs:domain cim:ExcAVR1;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "tf"@en;
               rdfs:range cim:Seconds.
cim:ExcAVR1.vrmn a owl:DatatypeProperty;
                 rdfs:comment "Minimum AVR output (VRMN). Typical value = -6."@en;
                 rdfs:domain cim:ExcAVR1;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "vrmn"@en;
                 rdfs:range cim:PU.
cim:ExcAVR1.vrmx a owl:DatatypeProperty;
                 rdfs:comment "Maximum AVR output (VRMX). Typical value = 7."@en;
                 rdfs:domain cim:ExcAVR1;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "vrmx"@en;
                 rdfs:range cim:PU.
cim:ExcAVR2 a owl:Class;
            rdfs:comment "Italian excitation system corresponding to IEEE (1968) type 2 model. It represents an alternator and rotating diodes and electromechanic voltage regulators."@en;
            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
            rdfs:label "ExcAVR2"@en;
            rdfs:subClassOf cim:ExcitationSystemDynamics;
