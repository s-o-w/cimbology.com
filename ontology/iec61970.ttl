                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "b"@en;
                rdfs:range xsd:float.
cim:MechLoad1.d a owl:DatatypeProperty;
                rdfs:comment "Speed to the exponent coefficient (d)."@en;
