            rdfs:domain cim:Pss2B;
            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
            rdfs:label "m"@en;
            rdfs:range xsd:integer.
cim:Pss2B.n a owl:DatatypeProperty;
            rdfs:comment "Order of ramp tracking filter (n). Typical value = 1."@en;
            rdfs:domain cim:Pss2B;
            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
            rdfs:label "n"@en;
            rdfs:range xsd:integer.
cim:Pss2B.t1 a owl:DatatypeProperty;
             rdfs:comment "Lead/lag time constant (T1) (>= 0). Typical value = 0, 12."@en;
             rdfs:domain cim:Pss2B;
             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
             rdfs:label "t1"@en;
             rdfs:range cim:Seconds.
cim:Pss2B.t10 a owl:DatatypeProperty;
              rdfs:comment "Lead/lag time constant (T10) (>= 0). Typical value = 0."@en;
              rdfs:domain cim:Pss2B;
              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
              rdfs:label "t10"@en;
              rdfs:range cim:Seconds.
cim:Pss2B.t11 a owl:DatatypeProperty;
              rdfs:comment "Lead/lag time constant (T11) (>= 0). Typical value = 0."@en;
              rdfs:domain cim:Pss2B;
              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
              rdfs:label "t11"@en;
              rdfs:range cim:Seconds.
cim:Pss2B.t2 a owl:DatatypeProperty;
             rdfs:comment "Lead/lag time constant (T2) (>= 0). Typical value = 0, 02."@en;
             rdfs:domain cim:Pss2B;
             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
             rdfs:label "t2"@en;
