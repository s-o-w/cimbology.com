cim:GovHydro4.uo a owl:DatatypeProperty;
                 rdfs:comment "Max gate opening velocity (Uo). Typical value = 0,2."@en;
                 rdfs:domain cim:GovHydro4;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
