cim:UnderexcLim2Simplified.q1 a owl:DatatypeProperty;
                              rdfs:comment "Segment Q end point (Q1). Typical value = -0,1."@en;
                              rdfs:domain cim:UnderexcLim2Simplified;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "q1"@en;
