cim:GovCT2.plim9 a owl:DatatypeProperty;
                 rdfs:comment "Power Limit 9 (Plim9). Typical value = 0."@en;
                 rdfs:domain cim:GovCT2;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "plim9"@en;
