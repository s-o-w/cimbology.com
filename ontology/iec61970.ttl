                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "kdr"@en;
                    rdfs:range cim:PU.
cim:ExcIEEEAC7B.ke a owl:DatatypeProperty;
                   rdfs:comment "Exciter constant related to self-excited field (KE). Typical value = 1."@en;
                   rdfs:domain cim:ExcIEEEAC7B;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "ke"@en;
                   rdfs:range cim:PU.
cim:ExcIEEEAC7B.kf1 a owl:DatatypeProperty;
