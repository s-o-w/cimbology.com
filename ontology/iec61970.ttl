                rdfs:comment "Fuel system time constant (Tf) (>= 0)."@en;
                rdfs:domain cim:GovGAST2;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "tf"@en;
