cim:CogenerationPlant a owl:Class;
                      rdfs:comment "A set of thermal generating units for the production of electrical energy and process steam (usually from the output of the steam turbines). The steam sendout is typically used for industrial purposes or for municipal heating and cooling."@en;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "CogenerationPlant"@en;
                      rdfs:subClassOf cim:PowerSystemResource;
                      cimdoc:cimPackage "IEC61970.Base.Generation.Production";
                      cimdoc:packageTier "Normative".
cim:CogenerationPlant.SteamSendoutSchedule a owl:ObjectProperty;
                                           rdfs:comment "A cogeneration plant has a steam sendout schedule."@en;
                                           rdfs:domain cim:CogenerationPlant;
                                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
