cim:EnergyConsumer.grounded a owl:DatatypeProperty;
                            rdfs:comment "Used for Yn and Zn connections. True if the neutral is solidly grounded."@en;
                            rdfs:domain cim:EnergyConsumer;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "grounded"@en;
