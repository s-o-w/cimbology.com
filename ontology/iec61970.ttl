cim:LoadStatic.kq1 a owl:DatatypeProperty;
                   rdfs:comment "First term voltage coefficient for reactive power (Kq1). Not used when .staticLoadModelType = constantZ."@en;
                   rdfs:domain cim:LoadStatic;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "kq1"@en;
                   rdfs:range xsd:float.
cim:LoadStatic.kq2 a owl:DatatypeProperty;
                   rdfs:comment "Second term voltage coefficient for reactive power (Kq2). Not used when .staticLoadModelType = constantZ."@en;
                   rdfs:domain cim:LoadStatic;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "kq2"@en;
                   rdfs:range xsd:float.
cim:LoadStatic.kq3 a owl:DatatypeProperty;
                   rdfs:comment "Third term voltage coefficient for reactive power (Kq3). Not used when .staticLoadModelType = constantZ."@en;
                   rdfs:domain cim:LoadStatic;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "kq3"@en;
                   rdfs:range xsd:float.
cim:LoadStatic.kq4 a owl:DatatypeProperty;
                   rdfs:comment "Frequency coefficient for reactive power (Kq4) (not = 0 when .staticLoadModelType = zIP2). Used only when .staticLoadModelType - zIP2."@en;
                   rdfs:domain cim:LoadStatic;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "kq4"@en;
                   rdfs:range xsd:float.
cim:LoadStatic.kqf a owl:DatatypeProperty;
                   rdfs:comment "Frequency deviation coefficient for reactive power (Kqf). Not used when .staticLoadModelType = constantZ."@en;
                   rdfs:domain cim:LoadStatic;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "kqf"@en;
                   rdfs:range xsd:float.
cim:LoadStatic.staticLoadModelType a owl:ObjectProperty;
                                   rdfs:comment "Type of static load model. Typical value = constantZ."@en;
                                   rdfs:domain cim:LoadStatic;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                   rdfs:label "staticLoadModelType"@en;
                                   rdfs:range cim:StaticLoadModelKind.
cim:LoadUserDefined a owl:Class;
                    rdfs:comment "Load whose dynamic behaviour is described by a user-defined model."@en;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "LoadUserDefined"@en;
                    rdfs:subClassOf cim:LoadDynamics;
                    cimdoc:cimPackage "IEC61970.Dynamics.UserDefinedModels";
                    cimdoc:packageTier "Normative".
cim:LoadUserDefined.proprietary a owl:DatatypeProperty;
                                rdfs:comment "Behaviour is based on a proprietary model as opposed to a detailed model. true = user-defined model is proprietary with behaviour mutually understood by sending and receiving applications and parameters passed as general attributes false = user-defined model is explicitly defined in terms of control blocks and their input and output signals."@en;
                                rdfs:domain cim:LoadUserDefined;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "proprietary"@en;
                                rdfs:range xsd:boolean.
cim:Location a owl:Class;
             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>.
cim:LookUpTableFunctionKind a owl:Class;
                            rdfs:comment "The look up table function kind enum"@en;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "LookUpTableFunctionKind"@en;
                            owl:equivalentClass [a owl:Class ; 
                                                 owl:oneOf (cim:LookUpTableFunctionKind.additionalQcurrent
                                                            cim:LookUpTableFunctionKind.vdcol)];
                            cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.InfHVDCDynamics";
                            cimdoc:packageTier "Informative".
cim:LookUpTableFunctionKind.additionalQcurrent a owl:NamedIndividual,
                                                 cim:LookUpTableFunctionKind;
                                               rdfs:comment "The additional qcurrent look up table function kind"@en;
                                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                               rdfs:label "additionalQcurrent"@en;
                                               cimdoc:enumCode 0 .
cim:LookUpTableFunctionKind.vdcol a owl:NamedIndividual,
                                    cim:LookUpTableFunctionKind;
                                  rdfs:comment "The vdcol look up table function kind"@en;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "vdcol"@en;
                                  cimdoc:enumCode 1 .
cim:Mass a rdfs:Datatype;
         rdfs:comment "Mass."@en;
         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
         rdfs:label "Mass"@en;
         owl:equivalentClass xsd:float;
         cimdoc:cimPackage "IEC61970.Base.Domain";
         cimdoc:packageTier "Normative";
         cimdoc:unitMultiplier cim:UnitMultiplier.k;
         cimdoc:unitSymbol cim:UnitSymbol.G.
cim:Measurement a owl:Class;
                rdfs:comment "A Measurement represents any measured, calculated or non-measured non- calculated quantity. Any piece of equipment may contain Measurements, e.g. a substation may have temperature measurements and door open indications, a transformer may have oil temperature and tank pressure measurements, a bay may contain a number of power flow measurements and a Breaker may contain a switch status measurement. The PSR - Measurement association is intended to capture this use of Measurement and is included in the naming hierarchy based on EquipmentContainer. The naming hierarchy typically has Measurements as leaves, e.g. Substation- VoltageLevel-Bay-Switch-Measurement. Some Measurements represent quantities related to a particular sensor location in the network, e.g. a voltage transformer (VT) or potential transformer (PT) at a busbar or a current transformer (CT) at the bar between a breaker and an isolator. The sensing position is not captured in the PSR - Measurement association. Instead it is captured by the Measurement - Terminal association that is used to define the sensing location in the network topology. The location is defined by the connection of the Terminal to ConductingEquipment. If both a Terminal and PSR are associated, and the PSR is of type ConductingEquipment, the associated Terminal should belong to that ConductingEquipment instance. When the sensor location is needed both Measurement-PSR and Measurement- Terminal are used. The Measurement-Terminal association is never used alone."@en;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "Measurement"@en;
                rdfs:subClassOf cim:IdentifiedObject;
                cimdoc:cimPackage "IEC61970.Base.Meas";
                cimdoc:packageTier "Normative".
cim:Measurement.CalculationMethodHierarchy a owl:ObjectProperty;
                                           rdfs:comment "Calculation method hierarchy which applies to this analog."@en;
                                           rdfs:domain cim:Measurement;
                                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                           rdfs:label "CalculationMethodHierarchy"@en;
                                           rdfs:range cim:CalculationMethodHierarchy.
cim:Measurement.ProtectiveActionAdjustment a owl:ObjectProperty;
                                           rdfs:comment "The protective action adjustment"@en;
                                           rdfs:domain cim:Measurement;
                                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                           rdfs:label "ProtectiveActionAdjustment"@en;
                                           rdfs:range cim:ProtectiveActionAdjustment.
cim:Measurement.Terminal a owl:ObjectProperty;
                         rdfs:comment "One or more measurements may be associated with a terminal in the network."@en;
                         rdfs:domain cim:Measurement;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                         rdfs:label "Terminal"@en;
                         rdfs:range cim:ACDCTerminal.
cim:Measurement.measurementType a owl:DatatypeProperty;
                                rdfs:comment """Specifies the type of measurement. For example, this specifies if the measurement represents an indoor temperature, outdoor temperature, bus voltage, line flow, etc. When the measurementType is set to \"Specialization\", the type of Measurement is defined in more detail by the specialized class which inherits from Measurement."""@en;
                                rdfs:domain cim:Measurement;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "measurementType"@en;
                                rdfs:range xsd:string.
cim:Measurement.phases a owl:ObjectProperty;
                       rdfs:comment "Indicates to which phases the measurement applies and avoids the need to use 'measurementType' to also encode phase information (which would explode the types). The phase information in Measurement, along with 'measurementType' and 'phases' uniquely defines a Measurement for a device, based on normal network phase. Their meaning will not change when the computed energizing phasing is changed due to jumpers or other reasons. If the attribute is missing three phases (ABC) shall be assumed."@en;
                       rdfs:domain cim:Measurement;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "phases"@en;
                       rdfs:range cim:PhaseCode.
cim:Measurement.unitMultiplier a owl:ObjectProperty;
                               rdfs:comment "The unit multiplier of the measured quantity."@en;
                               rdfs:domain cim:Measurement;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "unitMultiplier"@en;
                               rdfs:range cim:UnitMultiplier.
cim:Measurement.unitSymbol a owl:ObjectProperty;
                           rdfs:comment "The unit of measure of the measured quantity."@en;
                           rdfs:domain cim:Measurement;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "unitSymbol"@en;
                           rdfs:range cim:UnitSymbol.
cim:MeasurementCalculator a owl:Class;
                          rdfs:comment "Result of a calculation of one or more measurement."@en;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                          rdfs:label "MeasurementCalculator"@en;
                          rdfs:subClassOf cim:IdentifiedObject;
                          cimdoc:cimPackage "IEC61970.InfIEC61970.InfSIPS";
                          cimdoc:packageTier "Informative".
cim:MeasurementCalculator.MeasurementCalculatorInput a owl:ObjectProperty;
                                                     rdfs:comment "Used in the calculation."@en;
                                                     rdfs:domain cim:MeasurementCalculator;
                                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                     rdfs:label "MeasurementCalculatorInput"@en;
                                                     rdfs:range cim:MeasurementCalculatorInput.
cim:MeasurementCalculator.PinMeasurement a owl:ObjectProperty;
                                         rdfs:comment "The pin measurement associated with this measurement calculator."@en;
                                         rdfs:domain cim:MeasurementCalculator;
                                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                         rdfs:label "PinMeasurement"@en;
                                         rdfs:range cim:PinMeasurement.
cim:MeasurementCalculator.kind a owl:ObjectProperty;
                               rdfs:comment "Calculation operation executed on the operants."@en;
                               rdfs:domain cim:MeasurementCalculator;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "kind"@en;
                               rdfs:range cim:CalculationKind.
cim:MeasurementCalculatorInput a owl:Class;
                               rdfs:comment "Input to measurement calculation. Support Analog, Discrete and Accumulator."@en;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "MeasurementCalculatorInput"@en;
                               rdfs:subClassOf cim:IdentifiedObject;
                               cimdoc:cimPackage "IEC61970.InfIEC61970.InfSIPS";
                               cimdoc:packageTier "Informative".
cim:MeasurementCalculatorInput.Measurement a owl:ObjectProperty;
                                           rdfs:comment "Measurement used as input to a calculation."@en;
                                           rdfs:domain cim:MeasurementCalculatorInput;
                                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                           rdfs:label "Measurement"@en;
                                           rdfs:range cim:Measurement.
cim:MeasurementCalculatorInput.absoluteValue a owl:DatatypeProperty;
                                             rdfs:comment "If true, use the absolute value for the calculation."@en;
                                             rdfs:domain cim:MeasurementCalculatorInput;
                                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                             rdfs:label "absoluteValue"@en;
                                             rdfs:range xsd:boolean.
cim:MeasurementCalculatorInput.order a owl:DatatypeProperty;
                                     rdfs:comment "Positive number that defines the order of the operant in the calculation. 0 = default. The order is not relevant (e.g. summation)."@en;
                                     rdfs:domain cim:MeasurementCalculatorInput;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                     rdfs:label "order"@en;
                                     rdfs:range xsd:integer.
cim:MeasurementValue a owl:Class;
                     rdfs:comment "The current state for a measurement. A state value is an instance of a measurement from a specific source. Measurements can be associated with many state values, each representing a different source for the measurement."@en;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                     rdfs:label "MeasurementValue"@en;
                     rdfs:subClassOf cim:IOPoint;
                     cimdoc:cimPackage "IEC61970.Base.Meas";
                     cimdoc:packageTier "Normative".
cim:MeasurementValue.MeasurementValueQuality a owl:ObjectProperty;
                                             rdfs:comment "A MeasurementValue has a MeasurementValueQuality associated with it."@en;
                                             rdfs:domain cim:MeasurementValue;
                                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                             rdfs:label "MeasurementValueQuality"@en;
                                             rdfs:range cim:MeasurementValueQuality.
cim:MeasurementValue.RemoteSource a owl:ObjectProperty;
                                  rdfs:comment "Link to the physical telemetered point associated with this measurement."@en;
                                  rdfs:domain cim:MeasurementValue;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "RemoteSource"@en;
                                  rdfs:range cim:RemoteSource.
cim:MeasurementValue.sensorAccuracy a owl:DatatypeProperty;
                                    rdfs:comment "The limit, expressed as a percentage of the sensor maximum, that errors will not exceed when the sensor is used under reference conditions."@en;
                                    rdfs:domain cim:MeasurementValue;
                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                    rdfs:label "sensorAccuracy"@en;
                                    rdfs:range cim:PerCent.
cim:MeasurementValue.timeStamp a owl:DatatypeProperty;
                               rdfs:comment "The time when the value was last updated."@en;
                               rdfs:domain cim:MeasurementValue;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "timeStamp"@en;
                               rdfs:range xsd:dateTime.
cim:MeasurementValueQuality a owl:Class;
                            rdfs:comment "Measurement quality flags. Bits 0-10 are defined for substation automation in IEC 61850-7-3. Bits 11-15 are reserved for future expansion by that document. Bits 16-31 are reserved for EMS applications."@en;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "MeasurementValueQuality"@en;
                            rdfs:subClassOf cim:Quality61850;
                            cimdoc:cimPackage "IEC61970.Base.Meas";
                            cimdoc:packageTier "Normative".
cim:MeasurementValueSource a owl:Class;
                           rdfs:comment "MeasurementValueSource describes the alternative sources updating a MeasurementValue. User conventions for how to use the MeasurementValueSource attributes are defined in IEC 61970-301."@en;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "MeasurementValueSource"@en;
                           rdfs:subClassOf cim:IdentifiedObject;
                           cimdoc:cimPackage "IEC61970.Base.Meas";
                           cimdoc:packageTier "Normative".
cim:MeasurementValueSource.MeasurementValues a owl:ObjectProperty;
                                             rdfs:comment "The MeasurementValues updated by the source."@en;
                                             rdfs:domain cim:MeasurementValueSource;
                                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                             rdfs:label "MeasurementValues"@en;
                                             rdfs:range cim:MeasurementValue.
cim:MechLoad1 a owl:Class;
              rdfs:comment "Mechanical load model type 1."@en;
