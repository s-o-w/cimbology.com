cim:UnitSymbol.none a owl:NamedIndividual,
                      cim:UnitSymbol;
                    rdfs:comment "Dimension less quantity, e.g. count, per unit, etc."@en;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "none"@en;
                    cimdoc:enumCode 0 .
cim:UnitSymbol.ohm a owl:NamedIndividual,
                     cim:UnitSymbol;
                   rdfs:comment "Electric resistance in ohms (V/A)."@en;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "ohm"@en;
                   cimdoc:enumCode 30 .
cim:UnitSymbol.ohmPerm a owl:NamedIndividual,
