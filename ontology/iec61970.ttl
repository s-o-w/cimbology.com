cim:Clamp a owl:Class;
          rdfs:comment "A Clamp is a galvanic connection at a line segment where other equipment is connected. A Clamp does not cut the line segment. A Clamp is ConductingEquipment and has one Terminal with an associated ConnectivityNode. Any other ConductingEquipment can be connected to the Clamp ConnectivityNode."@en;
          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
          rdfs:label "Clamp"@en;
          rdfs:subClassOf cim:ConductingEquipment;
          cimdoc:cimPackage "IEC61970.Base.Wires";
          cimdoc:packageTier "Normative".
cim:Clamp.ClampAction a owl:ObjectProperty;
                      rdfs:comment "The clamp action that is performed on the clamp"@en;
                      rdfs:domain cim:Clamp;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "ClampAction"@en;
                      rdfs:range cim:ClampAction.
cim:Clamp.JumperAction a owl:ObjectProperty;
                       rdfs:comment "Action taken with this jumper."@en;
                       rdfs:domain cim:Clamp;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "JumperAction"@en;
                       rdfs:range cim:JumperAction.
cim:Clamp.lengthFromTerminal1 a owl:DatatypeProperty;
                              rdfs:comment "The length to the place where the clamp is located starting from side one of the line segment, i.e. the line segment terminal with sequence number equal to 1."@en;
                              rdfs:domain cim:Clamp;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "lengthFromTerminal1"@en;
                              rdfs:range cim:Length.
cim:ClampAction a owl:Class;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>.
