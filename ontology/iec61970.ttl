                                     rdfs:range xsd:boolean.
cim:BranchGroupTerminal a owl:Class;
                        rdfs:comment "A specific directed terminal flow for a branch group."@en;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                        rdfs:label "BranchGroupTerminal"@en;
                        cimdoc:cimPackage "IEC61970.Base.OperationalLimits";
