                                           rdfs:domain cim:HydroPowerPlant;
                                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                           rdfs:label "plantDischargeCapacity"@en;
                                           rdfs:range cim:VolumeFlowRate.
cim:HydroPowerPlant.plantRatedHead a owl:DatatypeProperty;
                                   rdfs:comment "The plant's rated gross head. The attribute shall be a positive value."@en;
                                   rdfs:domain cim:HydroPowerPlant;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                   rdfs:label "plantRatedHead"@en;
                                   rdfs:range cim:Length.
cim:HydroPowerPlant.pumpRatedP a owl:DatatypeProperty;
                               rdfs:comment "The hydro plant's pumping rating active power for rated head conditions. The attribute shall be a positive value."@en;
                               rdfs:domain cim:HydroPowerPlant;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "pumpRatedP"@en;
                               rdfs:range cim:ActivePower.
cim:HydroPowerPlant.surgeTankCode a owl:DatatypeProperty;
