                            cimdoc:packageTier "Normative".
cim:ICCPAccessPrivilegeKind.readOnly a owl:NamedIndividual,
                                       cim:ICCPAccessPrivilegeKind;
                                     rdfs:comment "Indicates that the remote is not allowed to change the value of the ICCPPoint."@en;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                     rdfs:label "readOnly"@en;
                                     cimdoc:enumCode 0 .
cim:ICCPAccessPrivilegeKind.readWrite a owl:NamedIndividual,
                                        cim:ICCPAccessPrivilegeKind;
                                      rdfs:comment "Indicates that the remote can not only get the value, but may also change the value of the ICCP Point."@en;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                      rdfs:label "readWrite"@en;
                                      cimdoc:enumCode 1 .
cim:ICCPInformationMessage a owl:Class;
                           rdfs:comment "This class represents the TASE.2 Information Message Object. The IdentifiedObject.name attribute must be non-null. The value of the attribute shall be used as the TASE.2 Information Reference, as specified by 60870-6-503."@en;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "ICCPInformationMessage"@en;
                           rdfs:subClassOf cim:IdentifiedObject;
                           cimdoc:cimPackage "IEC61970.Base.ICCPConfiguration";
                           cimdoc:packageTier "Normative".
cim:ICCPInformationMessage.TASE2BilateralTable a owl:ObjectProperty;
                                               rdfs:comment "Bilateral table agreement that includes the informational message."@en;
                                               rdfs:domain cim:ICCPInformationMessage;
                                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                               rdfs:label "TASE2BilateralTable"@en;
                                               rdfs:range cim:TASE2BilateralTable.
cim:ICCPInformationMessage.localReference a owl:DatatypeProperty;
                                          rdfs:comment "The Local Reference attribute specifies a value agreed upon between sender and receiver of the Information Message. It further identifies the Information Message."@en;
                                          rdfs:domain cim:ICCPInformationMessage;
                                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                          rdfs:label "localReference"@en;
                                          rdfs:range xsd:string.
cim:ICCPInformationMessage.scope a owl:ObjectProperty;
                                 rdfs:comment "Indicates if the Point is global scoped (e.g. VCC) or accessible only to the Bilateral table peer (e.g. ICC)."@en;
                                 rdfs:domain cim:ICCPInformationMessage;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "scope"@en;
                                 rdfs:range cim:ICCPScopeKind.
cim:ICCPPointKind a owl:Class;
                  rdfs:comment "The kind of ICCP point that is to be conveyed."@en;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "ICCPPointKind"@en;
                  owl:equivalentClass [a owl:Class ; 
                                       owl:oneOf (cim:ICCPPointKind.discrete
                                                  cim:ICCPPointKind.packedProtectionEvent
                                                  cim:ICCPPointKind.real
                                                  cim:ICCPPointKind.singleProtectionEvent
                                                  cim:ICCPPointKind.state
                                                  cim:ICCPPointKind.stateSupplemental)];
                  cimdoc:cimPackage "IEC61970.Base.ICCPConfiguration";
                  cimdoc:packageTier "Normative".
cim:ICCPPointKind.discrete a owl:NamedIndividual,
                             cim:ICCPPointKind;
                           rdfs:comment "Indicates that an ICCP discrete type is to be conveyed."@en;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "discrete"@en;
                           cimdoc:enumCode 0 .
cim:ICCPPointKind.packedProtectionEvent a owl:NamedIndividual,
                                          cim:ICCPPointKind;
                                        rdfs:comment "Indicates that an ICCP packed Protection Event is to be conveyed."@en;
                                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                        rdfs:label "packedProtectionEvent"@en;
                                        cimdoc:enumCode 5 .
cim:ICCPPointKind.real a owl:NamedIndividual,
                         cim:ICCPPointKind;
                       rdfs:comment "Indicates that an ICCP real type is to be conveyed."@en;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "real"@en;
                       cimdoc:enumCode 1 .
cim:ICCPPointKind.singleProtectionEvent a owl:NamedIndividual,
                                          cim:ICCPPointKind;
                                        rdfs:comment "Indicates that an ICCP single Protection Event type is to be conveyed."@en;
                                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                        rdfs:label "singleProtectionEvent"@en;
                                        cimdoc:enumCode 4 .
cim:ICCPPointKind.state a owl:NamedIndividual,
                          cim:ICCPPointKind;
                        rdfs:comment "Indicates that an ICCP state type is to be conveyed."@en;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                        rdfs:label "state"@en;
                        cimdoc:enumCode 2 .
cim:ICCPPointKind.stateSupplemental a owl:NamedIndividual,
