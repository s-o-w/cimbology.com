            cimdoc:packageTier "Normative".
cim:PssWECC.inputSignal1Type a owl:ObjectProperty;
                             rdfs:comment "Type of input signal #1 (rotorAngularFrequencyDeviation, busFrequencyDeviation, generatorElectricalPower, generatorAcceleratingPower, busVoltage, or busVoltageDerivative - shall be different than PssWECC.inputSignal2Type). Typical value = rotorAngularFrequencyDeviation."@en;
                             rdfs:domain cim:PssWECC;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "inputSignal1Type"@en;
                             rdfs:range cim:InputSignalKind.
cim:PssWECC.inputSignal2Type a owl:ObjectProperty;
                             rdfs:comment "Type of input signal #2 (rotorAngularFrequencyDeviation, busFrequencyDeviation, generatorElectricalPower, generatorAcceleratingPower, busVoltage, busVoltageDerivative - shall be different than PssWECC.inputSignal1Type). Typical value = busVoltageDerivative."@en;
                             rdfs:domain cim:PssWECC;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "inputSignal2Type"@en;
                             rdfs:range cim:InputSignalKind.
cim:PssWECC.k1 a owl:DatatypeProperty;
