cim:ApplicationSecurityKind a owl:Class;
                            rdfs:comment "Specifies the expected security mechanism, per IEC 62351-4, to be utilized."@en;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "ApplicationSecurityKind"@en;
                            owl:equivalentClass [a owl:Class ; 
                                                 owl:oneOf (cim:ApplicationSecurityKind.endToEndSecure
                                                            cim:ApplicationSecurityKind.nonSecure
                                                            cim:ApplicationSecurityKind.secure)];
                            cimdoc:cimPackage "IEC61970.Base.ICCPConfiguration";
                            cimdoc:packageTier "Normative".
cim:ApplicationSecurityKind.endToEndSecure a owl:NamedIndividual,
                                             cim:ApplicationSecurityKind;
                                           rdfs:comment "Indicates that E2E-security shall be used in order to allow establishment of an MMS association."@en;
                                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                           rdfs:label "endToEndSecure"@en;
                                           cimdoc:enumCode 2 .
cim:ApplicationSecurityKind.nonSecure a owl:NamedIndividual,
                                        cim:ApplicationSecurityKind;
                                      rdfs:comment "Indicates that an application security shall not be used in order to allow establishment of an MSS association."@en;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                      rdfs:label "nonSecure"@en;
                                      cimdoc:enumCode 0 .
cim:ApplicationSecurityKind.secure a owl:NamedIndividual,
                                     cim:ApplicationSecurityKind;
                                   rdfs:comment "Indicates that the A-security-profile as specified in Clause 11 (or IEC TS 62351-4:2007) shall be used in order to allow establishment of an MMS association."@en;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                   rdfs:label "secure"@en;
                                   cimdoc:enumCode 1 .
