cim:UnderexcLim2Simplified.vuimax a owl:DatatypeProperty;
                                  rdfs:comment "Maximum error signal (VUIMAX) (> UnderexcLim2Simplified.vuimin). Typical value = 1."@en;
                                  rdfs:domain cim:UnderexcLim2Simplified;
