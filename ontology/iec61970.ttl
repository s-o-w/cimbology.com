cim:GovCT2.ldref a owl:DatatypeProperty;
                 rdfs:comment "Load limiter reference value (Ldref). Typical value = 1."@en;
                 rdfs:domain cim:GovCT2;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "ldref"@en;
                 rdfs:range cim:PU.
cim:GovCT2.maxerr a owl:DatatypeProperty;
                  rdfs:comment "Maximum value for speed error signal (Maxerr) (greater than GovCT2.minerr). Typical value = 1."@en;
                  rdfs:domain cim:GovCT2;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "maxerr"@en;
                  rdfs:range cim:PU.
cim:GovCT2.minerr a owl:DatatypeProperty;
                  rdfs:comment "Minimum value for speed error signal (Minerr) (less than GovCT2.maxerr). Typical value = -1."@en;
                  rdfs:domain cim:GovCT2;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "minerr"@en;
                  rdfs:range cim:PU.
cim:GovCT2.mwbase a owl:DatatypeProperty;
                  rdfs:comment "Base for power values (MWbase) (> 0). Unit = MW."@en;
                  rdfs:domain cim:GovCT2;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "mwbase"@en;
                  rdfs:range cim:ActivePower.
cim:GovCT2.plim1 a owl:DatatypeProperty;
                 rdfs:comment "Power limit 1 (Plim1). Typical value = 0,8325."@en;
                 rdfs:domain cim:GovCT2;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
