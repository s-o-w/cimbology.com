                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "shaft2PowerLP1"@en;
                                rdfs:range xsd:float.
cim:SteamTurbine.shaft2PowerLP2 a owl:DatatypeProperty;
                                rdfs:comment "Fraction of power from shaft 2 second low pressure turbine output."@en;
                                rdfs:domain cim:SteamTurbine;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "shaft2PowerLP2"@en;
                                rdfs:range xsd:float.
cim:SteamTurbine.steamChestTC a owl:DatatypeProperty;
                              rdfs:comment "Steam chest time constant."@en;
                              rdfs:domain cim:SteamTurbine;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "steamChestTC"@en;
                              rdfs:range cim:Seconds.
cim:String a rdfs:Datatype;
           rdfs:comment "A string consisting of a sequence of characters. The character encoding is UTF- 8. The string length is unspecified and unlimited."@en;
           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
           rdfs:label "String"@en;
           owl:equivalentClass xsd:string;
           cimdoc:cimPackage "IEC61970.Base.Domain";
           cimdoc:packageTier "Normative".
cim:StringMeasurement a owl:Class;
                      rdfs:comment "StringMeasurement represents a measurement with values of type string."@en;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "StringMeasurement"@en;
                      rdfs:subClassOf cim:Measurement;
                      cimdoc:cimPackage "IEC61970.Base.Meas";
                      cimdoc:packageTier "Normative".
cim:StringMeasurementValue a owl:Class;
                           rdfs:comment "StringMeasurementValue represents a measurement value of type string."@en;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "StringMeasurementValue"@en;
                           rdfs:subClassOf cim:MeasurementValue;
                           cimdoc:cimPackage "IEC61970.Base.Meas";
                           cimdoc:packageTier "Normative".
cim:StringMeasurementValue.StringMeasurement a owl:ObjectProperty;
                                             rdfs:comment "Measurement to which this value is connected."@en;
                                             rdfs:domain cim:StringMeasurementValue;
                                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                             rdfs:label "StringMeasurement"@en;
                                             rdfs:range cim:StringMeasurement.
cim:StringMeasurementValue.value a owl:DatatypeProperty;
                                 rdfs:comment "The value to supervise."@en;
                                 rdfs:domain cim:StringMeasurementValue;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "value"@en;
                                 rdfs:range xsd:string.
cim:StringQuantity a rdfs:Datatype;
                   rdfs:comment "Quantity with string value (when it is not important whether it is an integral or a floating point number) and associated unit information."@en;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "StringQuantity"@en;
                   owl:equivalentClass xsd:string;
                   cimdoc:cimPackage "IEC61970.Base.Domain";
                   cimdoc:packageTier "Normative".
cim:SubGeographicalRegion a owl:Class;
