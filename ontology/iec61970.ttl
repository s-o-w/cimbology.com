               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "kind"@en;
               rdfs:range cim:PhaseConnectedFaultKind.
cim:Fault.occurredDateTime a owl:DatatypeProperty;
