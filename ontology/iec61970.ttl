cim:GovGAST2.a a owl:DatatypeProperty;
               rdfs:comment "Valve positioner (A)."@en;
               rdfs:domain cim:GovGAST2;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "a"@en;
               rdfs:range xsd:float.
cim:GovGAST2.af1 a owl:DatatypeProperty;
                 rdfs:comment "Exhaust temperature parameter (Af1). Unit = PU temperature. Based on temperature in degrees C."@en;
                 rdfs:domain cim:GovGAST2;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "af1"@en;
                 rdfs:range cim:PU.
cim:GovGAST2.af2 a owl:DatatypeProperty;
                 rdfs:comment "Coefficient equal to 0,5(1-speed) (Af2)."@en;
                 rdfs:domain cim:GovGAST2;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "af2"@en;
                 rdfs:range cim:PU.
cim:GovGAST2.b a owl:DatatypeProperty;
               rdfs:comment "Valve positioner (B)."@en;
               rdfs:domain cim:GovGAST2;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "b"@en;
               rdfs:range xsd:float.
cim:GovGAST2.bf1 a owl:DatatypeProperty;
                 rdfs:comment "(Bf1). Bf1 = E(1 - W) where E (speed sensitivity coefficient) is 0,55 to 0,65 x Tr. Unit = PU temperature. Based on temperature in degrees C."@en;
                 rdfs:domain cim:GovGAST2;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "bf1"@en;
                 rdfs:range cim:PU.
cim:GovGAST2.bf2 a owl:DatatypeProperty;
                 rdfs:comment "Turbine torque coefficient Khhv (depends on heating value of fuel stream in combustion chamber) (Bf2)."@en;
                 rdfs:domain cim:GovGAST2;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "bf2"@en;
                 rdfs:range cim:PU.
cim:GovGAST2.c a owl:DatatypeProperty;
               rdfs:comment "Valve positioner (C)."@en;
               rdfs:domain cim:GovGAST2;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "c"@en;
               rdfs:range xsd:float.
