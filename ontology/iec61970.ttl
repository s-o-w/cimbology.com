cim:ChangeSet a owl:Class;
              rdfs:comment "Represents a set of changes that can be applied in different scenarios. A given registered target object's MRID may only be referenced once by the change set members."@en;
              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
              rdfs:label "ChangeSet"@en;
              rdfs:subClassOf cim:DataSet;
