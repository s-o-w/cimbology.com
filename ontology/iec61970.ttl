cim:ExcELIN2.iefmin a owl:DatatypeProperty;
                    rdfs:comment "Limiter (Iefmin) (< ExcELIN2.iefmax). Typical value = 1."@en;
                    rdfs:domain cim:ExcELIN2;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
