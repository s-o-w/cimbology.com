                                                         cim:BreakerConfiguration.doubleBreaker
                                                         cim:BreakerConfiguration.noBreaker
                                                         cim:BreakerConfiguration.singleBreaker)];
                         cimdoc:cimPackage "IEC61970.Base.Core";
                         cimdoc:packageTier "Normative".
cim:BreakerConfiguration.breakerAndAHalf a owl:NamedIndividual,
