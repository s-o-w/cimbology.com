                                         rdfs:label "FrameworkPart"@en;
                                         rdfs:range cim:ModelAuthoritySet.
cim:ModelPartVersion a owl:Class;
                     rdfs:comment "This is a version of a part of a model. New instances of this class with new identity are instantiated upon changes to the content of this class or changes to the associated data set. Instances of this class are considered immutable. The case audit trail can reference this immutable data to exactly reproduce a case."@en;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                     rdfs:label "ModelPartVersion"@en;
                     rdfs:subClassOf cim:ModelToBeDeleted;
                     cimdoc:cimPackage "IEC61970.InfIEC61970.InfPart303.NetworkModelFrames";
