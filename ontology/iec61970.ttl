                   rdfs:comment "Classification of level. Specify as 1..n, with 1 being the most detailed, highest priority, etc as described on the attribute using this data type."@en;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "Classification"@en;
                   owl:equivalentClass xsd:integer;
                   cimdoc:cimPackage "IEC61970.Base.Domain";
