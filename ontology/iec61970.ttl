                   rdfs:domain cim:GovHydro4;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "pgv2"@en;
                   rdfs:range cim:PU.
cim:GovHydro4.pgv3 a owl:DatatypeProperty;
                   rdfs:comment "Nonlinear gain point 3, PU power (Pgv3) (= 0 for simple). Typical value for Francis/Pelton = 0,8, Kaplan = 0,796."@en;
                   rdfs:domain cim:GovHydro4;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "pgv3"@en;
                   rdfs:range cim:PU.
cim:GovHydro4.pgv4 a owl:DatatypeProperty;
