                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "vrmax"@en;
                      rdfs:range cim:PU.
cim:ExcIEEEDC1A.vrmin a owl:DatatypeProperty;
                      rdfs:comment "Minimum voltage regulator output (VRMIN) (< 0 and < ExcIEEEDC1A.vrmax). Typical value = -0,9."@en;
                      rdfs:domain cim:ExcIEEEDC1A;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "vrmin"@en;
                      rdfs:range cim:PU.
cim:ExcIEEEDC2A a owl:Class;
                rdfs:comment "IEEE 421.5-2005 type DC2A model. This model represents field-controlled DC commutator exciters with continuously acting voltage regulators having supplies obtained from the generator or auxiliary bus. It differs from the type DC1A model only in the voltage regulator output limits, which are now proportional to terminal voltage VT. It is representative of solid-state replacements for various forms of older mechanical and rotating amplifier regulating equipment connected to DC commutator exciters. Reference: IEEE 421.5-2005, 5.2."@en;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "ExcIEEEDC2A"@en;
                rdfs:subClassOf cim:ExcitationSystemDynamics;
                cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.ExcitationSystemDynamics";
                cimdoc:packageTier "Normative".
cim:ExcIEEEDC2A.efd1 a owl:DatatypeProperty;
                     rdfs:comment "Exciter voltage at which exciter saturation is defined (EFD1) (> 0). Typical value = 3,05."@en;
                     rdfs:domain cim:ExcIEEEDC2A;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                     rdfs:label "efd1"@en;
                     rdfs:range cim:PU.
cim:ExcIEEEDC2A.efd2 a owl:DatatypeProperty;
                     rdfs:comment "Exciter voltage at which exciter saturation is defined (EFD2) (> 0). Typical value = 2,29."@en;
                     rdfs:domain cim:ExcIEEEDC2A;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                     rdfs:label "efd2"@en;
                     rdfs:range cim:PU.
cim:ExcIEEEDC2A.exclim a owl:DatatypeProperty;
                       rdfs:comment "(exclim). IEEE standard is ambiguous about lower limit on exciter output. Typical value = - 999 which means that there is no limit applied."@en;
                       rdfs:domain cim:ExcIEEEDC2A;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "exclim"@en;
                       rdfs:range cim:PU.
cim:ExcIEEEDC2A.ka a owl:DatatypeProperty;
                   rdfs:comment "Voltage regulator gain (KA) (> 0). Typical value = 300."@en;
                   rdfs:domain cim:ExcIEEEDC2A;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "ka"@en;
                   rdfs:range cim:PU.
cim:ExcIEEEDC2A.ke a owl:DatatypeProperty;
                   rdfs:comment "Exciter constant related to self-excited field (KE). Typical value = 1."@en;
                   rdfs:domain cim:ExcIEEEDC2A;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "ke"@en;
                   rdfs:range cim:PU.
cim:ExcIEEEDC2A.kf a owl:DatatypeProperty;
                   rdfs:comment "Excitation control system stabilizer gain (KF) (>= 0). Typical value = 0,1."@en;
                   rdfs:domain cim:ExcIEEEDC2A;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "kf"@en;
                   rdfs:range cim:PU.
cim:ExcIEEEDC2A.seefd1 a owl:DatatypeProperty;
                       rdfs:comment "Exciter saturation function value at the corresponding exciter voltage, EFD1 (SE[EFD1]) (>= 0). Typical value = 0,279."@en;
                       rdfs:domain cim:ExcIEEEDC2A;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "seefd1"@en;
                       rdfs:range xsd:float.
cim:ExcIEEEDC2A.seefd2 a owl:DatatypeProperty;
                       rdfs:comment "Exciter saturation function value at the corresponding exciter voltage, EFD2 (SE[EFD2]) (>= 0). Typical value = 0,117."@en;
                       rdfs:domain cim:ExcIEEEDC2A;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "seefd2"@en;
                       rdfs:range xsd:float.
cim:ExcIEEEDC2A.ta a owl:DatatypeProperty;
                   rdfs:comment "Voltage regulator time constant (TA) (> 0). Typical value = 0,01."@en;
                   rdfs:domain cim:ExcIEEEDC2A;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "ta"@en;
                   rdfs:range cim:Seconds.
cim:ExcIEEEDC2A.tb a owl:DatatypeProperty;
                   rdfs:comment "Voltage regulator time constant (TB) (>= 0). Typical value = 0."@en;
                   rdfs:domain cim:ExcIEEEDC2A;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "tb"@en;
                   rdfs:range cim:Seconds.
cim:ExcIEEEDC2A.tc a owl:DatatypeProperty;
                   rdfs:comment "Voltage regulator time constant (TC) (>= 0). Typical value = 0."@en;
                   rdfs:domain cim:ExcIEEEDC2A;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "tc"@en;
                   rdfs:range cim:Seconds.
cim:ExcIEEEDC2A.te a owl:DatatypeProperty;
                   rdfs:comment "Exciter time constant, integration rate associated with exciter control (TE) (> 0). Typical value = 1,33."@en;
                   rdfs:domain cim:ExcIEEEDC2A;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "te"@en;
                   rdfs:range cim:Seconds.
cim:ExcIEEEDC2A.tf a owl:DatatypeProperty;
                   rdfs:comment "Excitation control system stabilizer time constant (TF) (> 0). Typical value = 0,675."@en;
                   rdfs:domain cim:ExcIEEEDC2A;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "tf"@en;
                   rdfs:range cim:Seconds.
cim:ExcIEEEDC2A.uelin a owl:DatatypeProperty;
                      rdfs:comment "UEL input (uelin). true = input is connected to the HV gate false = input connects to the error signal. Typical value = true."@en;
                      rdfs:domain cim:ExcIEEEDC2A;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "uelin"@en;
                      rdfs:range xsd:boolean.
cim:ExcIEEEDC2A.vrmax a owl:DatatypeProperty;
                      rdfs:comment "Maximum voltage regulator output (VRMAX)(greater than ExcIEEEDC2A. vrmin). Typical value = 4,95."@en;
                      rdfs:domain cim:ExcIEEEDC2A;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "vrmax"@en;
                      rdfs:range cim:PU.
cim:ExcIEEEDC2A.vrmin a owl:DatatypeProperty;
                      rdfs:comment "Minimum voltage regulator output (VRMIN) (less than 0 and less than ExcIEEEDC2A.vrmax). Typical value = -4,9."@en;
                      rdfs:domain cim:ExcIEEEDC2A;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "vrmin"@en;
                      rdfs:range cim:PU.
cim:ExcIEEEDC3A a owl:Class;
                rdfs:comment "IEEE 421.5-2005 type DC3A model. This model represents older systems, in particular those DC commutator exciters with non-continuously acting regulators that were commonly used before the development of the continuously acting varieties. These systems respond at basically two different rates, depending upon the magnitude of voltage error. For small errors, adjustment is made periodically with a signal to a motor-operated rheostat. Larger errors cause resistors to be quickly shorted or inserted and a strong forcing signal applied to the exciter. Continuous motion of the motor-operated rheostat occurs for these larger error signals, even though it is bypassed by contactor action. Reference: IEEE 421.5-2005, 5.3."@en;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "ExcIEEEDC3A"@en;
                rdfs:subClassOf cim:ExcitationSystemDynamics;
                cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.ExcitationSystemDynamics";
                cimdoc:packageTier "Normative".
cim:ExcIEEEDC3A.efd1 a owl:DatatypeProperty;
                     rdfs:comment "Exciter voltage at which exciter saturation is defined (EFD1) (> 0). Typical value = 3,375."@en;
                     rdfs:domain cim:ExcIEEEDC3A;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                     rdfs:label "efd1"@en;
                     rdfs:range cim:PU.
cim:ExcIEEEDC3A.efd2 a owl:DatatypeProperty;
                     rdfs:comment "Exciter voltage at which exciter saturation is defined (EFD2) (> 0). Typical value = 3,15."@en;
                     rdfs:domain cim:ExcIEEEDC3A;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                     rdfs:label "efd2"@en;
                     rdfs:range cim:PU.
cim:ExcIEEEDC3A.exclim a owl:DatatypeProperty;
                       rdfs:comment "(exclim). IEEE standard is ambiguous about lower limit on exciter output. true = a lower limit of zero is applied to integrator output false = a lower limit of zero is not applied to integrator output. Typical value = true."@en;
                       rdfs:domain cim:ExcIEEEDC3A;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "exclim"@en;
                       rdfs:range xsd:boolean.
cim:ExcIEEEDC3A.ke a owl:DatatypeProperty;
                   rdfs:comment "Exciter constant related to self-excited field (KE). Typical value = 0,05."@en;
                   rdfs:domain cim:ExcIEEEDC3A;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "ke"@en;
                   rdfs:range cim:PU.
cim:ExcIEEEDC3A.kv a owl:DatatypeProperty;
                   rdfs:comment "Fast raise/lower contact setting (KV) (> 0). Typical value = 0,05."@en;
                   rdfs:domain cim:ExcIEEEDC3A;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "kv"@en;
                   rdfs:range cim:PU.
cim:ExcIEEEDC3A.seefd1 a owl:DatatypeProperty;
                       rdfs:comment "Exciter saturation function value at the corresponding exciter voltage, EFD1 (SE[EFD1]) (>= 0). Typical value = 0,267."@en;
                       rdfs:domain cim:ExcIEEEDC3A;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "seefd1"@en;
                       rdfs:range xsd:float.
cim:ExcIEEEDC3A.seefd2 a owl:DatatypeProperty;
                       rdfs:comment "Exciter saturation function value at the corresponding exciter voltage, EFD2 (SE[EFD2]) (>= 0). Typical value = 0,068."@en;
                       rdfs:domain cim:ExcIEEEDC3A;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "seefd2"@en;
                       rdfs:range xsd:float.
cim:ExcIEEEDC3A.te a owl:DatatypeProperty;
                   rdfs:comment "Exciter time constant, integration rate associated with exciter control (TE) (> 0). Typical value = 0,5."@en;
                   rdfs:domain cim:ExcIEEEDC3A;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "te"@en;
                   rdfs:range cim:Seconds.
cim:ExcIEEEDC3A.trh a owl:DatatypeProperty;
                    rdfs:comment "Rheostat travel time (TRH) (> 0). Typical value = 20."@en;
                    rdfs:domain cim:ExcIEEEDC3A;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "trh"@en;
                    rdfs:range cim:Seconds.
cim:ExcIEEEDC3A.vrmax a owl:DatatypeProperty;
                      rdfs:comment "Maximum voltage regulator output (VRMAX) (greater than 0). Typical value = 1."@en;
                      rdfs:domain cim:ExcIEEEDC3A;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "vrmax"@en;
                      rdfs:range cim:PU.
cim:ExcIEEEDC3A.vrmin a owl:DatatypeProperty;
                      rdfs:comment "Minimum voltage regulator output (VRMIN) (less than or equal to 0). Typical value = 0."@en;
                      rdfs:domain cim:ExcIEEEDC3A;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "vrmin"@en;
                      rdfs:range cim:PU.
cim:ExcIEEEDC4B a owl:Class;
                rdfs:comment "IEEE 421.5-2005 type DC4B model. These excitation systems utilize a field- controlled DC commutator exciter with a continuously acting voltage regulator having supplies obtained from the generator or auxiliary bus. Reference: IEEE 421.5-2005, 5.4."@en;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "ExcIEEEDC4B"@en;
                rdfs:subClassOf cim:ExcitationSystemDynamics;
                cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.ExcitationSystemDynamics";
                cimdoc:packageTier "Normative".
cim:ExcIEEEDC4B.efd1 a owl:DatatypeProperty;
                     rdfs:comment "Exciter voltage at which exciter saturation is defined (EFD1) (> 0). Typical value = 1,75."@en;
                     rdfs:domain cim:ExcIEEEDC4B;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                     rdfs:label "efd1"@en;
                     rdfs:range cim:PU.
cim:ExcIEEEDC4B.efd2 a owl:DatatypeProperty;
                     rdfs:comment "Exciter voltage at which exciter saturation is defined (EFD2) (> 0). Typical value = 2,33."@en;
                     rdfs:domain cim:ExcIEEEDC4B;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                     rdfs:label "efd2"@en;
                     rdfs:range cim:PU.
cim:ExcIEEEDC4B.ka a owl:DatatypeProperty;
                   rdfs:comment "Voltage regulator gain (KA) (> 0). Typical value = 1."@en;
                   rdfs:domain cim:ExcIEEEDC4B;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "ka"@en;
                   rdfs:range cim:PU.
cim:ExcIEEEDC4B.kd a owl:DatatypeProperty;
                   rdfs:comment "Regulator derivative gain (KD) (>= 0). Typical value = 20."@en;
                   rdfs:domain cim:ExcIEEEDC4B;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "kd"@en;
                   rdfs:range cim:PU.
cim:ExcIEEEDC4B.ke a owl:DatatypeProperty;
                   rdfs:comment "Exciter constant related to self-excited field (KE). Typical value = 1."@en;
                   rdfs:domain cim:ExcIEEEDC4B;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "ke"@en;
                   rdfs:range cim:PU.
cim:ExcIEEEDC4B.kf a owl:DatatypeProperty;
                   rdfs:comment "Excitation control system stabilizer gain (KF) (>= 0). Typical value = 0."@en;
                   rdfs:domain cim:ExcIEEEDC4B;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "kf"@en;
                   rdfs:range cim:PU.
cim:ExcIEEEDC4B.ki a owl:DatatypeProperty;
                   rdfs:comment "Regulator integral gain (KI) (>= 0). Typical value = 20."@en;
                   rdfs:domain cim:ExcIEEEDC4B;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "ki"@en;
                   rdfs:range cim:PU.
cim:ExcIEEEDC4B.kp a owl:DatatypeProperty;
                   rdfs:comment "Regulator proportional gain (KP) (>= 0). Typical value = 20."@en;
                   rdfs:domain cim:ExcIEEEDC4B;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "kp"@en;
                   rdfs:range cim:PU.
cim:ExcIEEEDC4B.oelin a owl:DatatypeProperty;
                      rdfs:comment "OEL input (OELin). true = LV gate false = subtract from error signal. Typical value = true."@en;
                      rdfs:domain cim:ExcIEEEDC4B;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "oelin"@en;
                      rdfs:range xsd:boolean.
cim:ExcIEEEDC4B.seefd1 a owl:DatatypeProperty;
                       rdfs:comment "Exciter saturation function value at the corresponding exciter voltage, EFD1 (SE[EFD1]) (>= 0). Typical value = 0,08."@en;
                       rdfs:domain cim:ExcIEEEDC4B;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "seefd1"@en;
                       rdfs:range xsd:float.
cim:ExcIEEEDC4B.seefd2 a owl:DatatypeProperty;
                       rdfs:comment "Exciter saturation function value at the corresponding exciter voltage, EFD2 (SE[EFD2]) (>= 0). Typical value = 0,27."@en;
                       rdfs:domain cim:ExcIEEEDC4B;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "seefd2"@en;
                       rdfs:range xsd:float.
cim:ExcIEEEDC4B.ta a owl:DatatypeProperty;
                   rdfs:comment "Voltage regulator time constant (TA) (> 0). Typical value = 0,2."@en;
                   rdfs:domain cim:ExcIEEEDC4B;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "ta"@en;
                   rdfs:range cim:Seconds.
cim:ExcIEEEDC4B.td a owl:DatatypeProperty;
                   rdfs:comment "Regulator derivative filter time constant (TD) (> 0 if ExcIEEEDC4B.kd > 0). Typical value = 0,01."@en;
                   rdfs:domain cim:ExcIEEEDC4B;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "td"@en;
                   rdfs:range cim:Seconds.
cim:ExcIEEEDC4B.te a owl:DatatypeProperty;
                   rdfs:comment "Exciter time constant, integration rate associated with exciter control (TE) (> 0). Typical value = 0,8."@en;
                   rdfs:domain cim:ExcIEEEDC4B;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "te"@en;
                   rdfs:range cim:Seconds.
cim:ExcIEEEDC4B.tf a owl:DatatypeProperty;
                   rdfs:comment "Excitation control system stabilizer time constant (TF) (>= 0). Typical value = 1."@en;
                   rdfs:domain cim:ExcIEEEDC4B;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "tf"@en;
                   rdfs:range cim:Seconds.
cim:ExcIEEEDC4B.uelin a owl:DatatypeProperty;
                      rdfs:comment "UEL input (UELin). true = HV gate false = add to error signal. Typical value = true."@en;
                      rdfs:domain cim:ExcIEEEDC4B;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "uelin"@en;
                      rdfs:range xsd:boolean.
cim:ExcIEEEDC4B.vemin a owl:DatatypeProperty;
                      rdfs:comment "Minimum exciter voltage output (VEMIN) (less than or equal to 0). Typical value = 0."@en;
                      rdfs:domain cim:ExcIEEEDC4B;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "vemin"@en;
                      rdfs:range cim:PU.
cim:ExcIEEEDC4B.vrmax a owl:DatatypeProperty;
                      rdfs:comment "Maximum voltage regulator output (VRMAX) (greater than ExcIEEEDC4B.vrmin). Typical value = 2,7."@en;
                      rdfs:domain cim:ExcIEEEDC4B;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "vrmax"@en;
                      rdfs:range cim:PU.
cim:ExcIEEEDC4B.vrmin a owl:DatatypeProperty;
                      rdfs:comment "Minimum voltage regulator output (VRMIN) (less than or equal to 0 and less than ExcIEEEDC4B.vrmax). Typical value = -0,9."@en;
                      rdfs:domain cim:ExcIEEEDC4B;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "vrmin"@en;
