cim:PhaseCode.BCN a owl:NamedIndividual,
                    cim:PhaseCode;
                  rdfs:comment "Phases B, C, and neutral."@en;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
