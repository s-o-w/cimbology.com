                     cimdoc:packageTier "Informative".
cim:DCvoltageControl.kivdc a owl:DatatypeProperty;
                           rdfs:comment "Integral gain of the DC voltage regulator (Kivdc)."@en;
                           rdfs:domain cim:DCvoltageControl;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "kivdc"@en;
                           rdfs:range cim:PU.
cim:DCvoltageControl.kpvdc a owl:DatatypeProperty;
                           rdfs:comment "Proportional gain of the DC voltage regulator (Kpvdc)."@en;
                           rdfs:domain cim:DCvoltageControl;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "kpvdc"@en;
                           rdfs:range cim:PU.
cim:DCvoltageControl.vdcmax a owl:DatatypeProperty;
                            rdfs:comment "Maximum DC voltage (Vdcmax)."@en;
                            rdfs:domain cim:DCvoltageControl;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "vdcmax"@en;
                            rdfs:range cim:PU.
cim:DCvoltageControl.vdcmin a owl:DatatypeProperty;
                            rdfs:comment "Minimum DC voltage (Vdcmin)."@en;
                            rdfs:domain cim:DCvoltageControl;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "vdcmin"@en;
                            rdfs:range cim:PU.
cim:Damping a rdfs:Datatype;
            rdfs:comment "Per-unit active power variation with frequency referenced on the system apparent power base. Typical values are in the range 1,0 - 2,0."@en;
            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
            rdfs:label "Damping"@en;
            owl:equivalentClass xsd:float;
            cimdoc:cimPackage "IEC61970.Base.Domain";
            cimdoc:packageTier "Normative";
            cimdoc:unitMultiplier cim:UnitMultiplier.none;
            cimdoc:unitSymbol cim:UnitSymbol.onePerHz.
cim:DataSet a owl:Class;
            rdfs:comment "A generic container of a version of instance data."@en;
            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
            rdfs:label "DataSet"@en;
            cimdoc:cimPackage "IEC61970.InfIEC61970.Part303.GenericDataSet";
            cimdoc:packageTier "Informative".
cim:DataSet.Profile a owl:ObjectProperty;
                    rdfs:comment "The profile that describes the contents of the dataset and its governing rules."@en;
                    rdfs:domain cim:DataSet;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "Profile"@en;
                    rdfs:range cim:Profile.
cim:DataSet.description a owl:DatatypeProperty;
                        rdfs:comment "A free human readable text describing or naming the object. May be non-unique and not necessarily correlate to a naming hierarchy."@en;
                        rdfs:domain cim:DataSet;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                        rdfs:label "description"@en;
                        rdfs:range xsd:string.
cim:DataSet.mRID a owl:DatatypeProperty;
                 rdfs:comment "Master resource identifier issued by a model authority. The mRID is unique within an exchange context and it is recommended to be a UUID (RFC 4122)."@en;
                 rdfs:domain cim:DataSet;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "mRID"@en;
                 rdfs:range xsd:string.
cim:DataSet.name a owl:DatatypeProperty;
                 rdfs:comment "Any free human readable text naming the object. May be non-unique."@en;
                 rdfs:domain cim:DataSet;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "name"@en;
                 rdfs:range xsd:string.
cim:DatasetArg a owl:Class;
               rdfs:comment "A model operation argument referencing a dataset instance."@en;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "DatasetArg"@en;
               rdfs:subClassOf cim:ModelOperationArg;
               cimdoc:cimPackage "IEC61970.InfIEC61970.InfPart303.ModelOperations";
               cimdoc:packageTier "Informative".
cim:DatasetArg.Dataset a owl:ObjectProperty;
                       rdfs:comment "Dataset referenced by this argument of a model operation."@en;
                       rdfs:domain cim:DatasetArg;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "Dataset"@en;
                       rdfs:range cim:InstanceSet.
cim:DatasetArg.OperationDatasetArgDescription a owl:ObjectProperty;
                                              rdfs:comment "The type of role for this dataset role. Should only reference role types that belong to the operation type of the associated operation."@en;
                                              rdfs:domain cim:DatasetArg;
                                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                              rdfs:label "OperationDatasetArgDescription"@en;
                                              rdfs:range cim:DatasetArgDescription.
cim:DatasetArgDescription a owl:Class;
                          rdfs:comment "Describes the type of dataset argument for a model operation."@en;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                          rdfs:label "DatasetArgDescription"@en;
                          rdfs:subClassOf cim:ModelOperationArgDescription;
                          cimdoc:cimPackage "IEC61970.InfIEC61970.InfPart303.ModelOperations";
                          cimdoc:packageTier "Informative".
cim:Date a rdfs:Datatype;
         rdfs:comment """Date as \"yyyy-mm-dd\", which conforms with ISO 8601. UTC time zone is specified as \"yyyy-mm-ddZ\". A local timezone relative UTC is specified as \"yyyy-mm-dd(+/- )hh:mm\"."""@en;
         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
         rdfs:label "Date"@en;
         owl:equivalentClass xsd:date;
         cimdoc:cimPackage "IEC61970.Base.Domain";
         cimdoc:packageTier "Normative".
cim:DateInterval a owl:Class;
                 rdfs:comment "Interval between two dates."@en;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "DateInterval"@en;
                 cimdoc:cimPackage "IEC61970.Base.Domain";
                 cimdoc:packageTier "Normative".
cim:DateInterval.end a owl:DatatypeProperty;
                     rdfs:comment "End date of this interval."@en;
                     rdfs:domain cim:DateInterval;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                     rdfs:label "end"@en;
                     rdfs:range xsd:date.
cim:DateInterval.start a owl:DatatypeProperty;
                       rdfs:comment "Start date of this interval."@en;
                       rdfs:domain cim:DateInterval;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "start"@en;
                       rdfs:range xsd:date.
cim:DateTime a rdfs:Datatype;
             rdfs:comment """Date and time as \"yyyy-mm-ddThh:mm:ss.sss\", which conforms with ISO 8601. UTC time zone is specified as \"yyyy-mm-ddThh:mm:ss.sssZ\". A local timezone relative UTC is specified as \"yyyy-mm-ddThh:mm:ss.sss-hh:mm\". The second component (shown here as \"ss.sss\") could have any number of digits in its fractional part to allow any kind of precision beyond seconds."""@en;
             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
             rdfs:label "DateTime"@en;
             owl:equivalentClass xsd:dateTime;
             cimdoc:cimPackage "IEC61970.Base.Domain";
             cimdoc:packageTier "Normative".
cim:DateTimeInterval a owl:Class;
                     rdfs:comment "Interval between two date and time points, where the interval includes the start time but excludes end time."@en;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                     rdfs:label "DateTimeInterval"@en;
                     cimdoc:cimPackage "IEC61970.Base.Domain";
                     cimdoc:packageTier "Normative".
cim:DateTimeInterval.end a owl:DatatypeProperty;
                         rdfs:comment "End date and time of this interval. The end date and time where the interval is defined up to, but excluded."@en;
                         rdfs:domain cim:DateTimeInterval;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                         rdfs:label "end"@en;
                         rdfs:range xsd:dateTime.
cim:DateTimeInterval.start a owl:DatatypeProperty;
                           rdfs:comment "Start date and time of this interval. The start date and time is included in the defined interval."@en;
                           rdfs:domain cim:DateTimeInterval;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "start"@en;
                           rdfs:range xsd:dateTime.
cim:DayType a owl:Class;
            rdfs:comment "Group of similar days. For example it could be used to represent weekdays, weekend, or holidays."@en;
            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
            rdfs:label "DayType"@en;
