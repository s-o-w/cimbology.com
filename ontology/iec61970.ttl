                               rdfs:domain cim:Reservoir;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "spillwayCapacity"@en;
                               rdfs:range xsd:float.
cim:Reservoir.spillwayCrestLength a owl:DatatypeProperty;
                                  rdfs:comment "The length of the spillway crest."@en;
                                  rdfs:domain cim:Reservoir;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "spillwayCrestLength"@en;
                                  rdfs:range cim:Length.
cim:Reservoir.spillwayCrestLevel a owl:DatatypeProperty;
                                 rdfs:comment "Spillway crest level above which water will spill."@en;
                                 rdfs:domain cim:Reservoir;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "spillwayCrestLevel"@en;
                                 rdfs:range cim:WaterLevel.
