cim:ExcIEEEDC1A.te a owl:DatatypeProperty;
                   rdfs:comment "Exciter time constant, integration rate associated with exciter control (TE) (> 0). Typical value = 0,46."@en;
                   rdfs:domain cim:ExcIEEEDC1A;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "te"@en;
                   rdfs:range cim:Seconds.
cim:ExcIEEEDC1A.tf a owl:DatatypeProperty;
                   rdfs:comment "Excitation control system stabilizer time constant (TF) (> 0). Typical value = 1."@en;
                   rdfs:domain cim:ExcIEEEDC1A;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "tf"@en;
                   rdfs:range cim:Seconds.
cim:ExcIEEEDC1A.uelin a owl:DatatypeProperty;
                      rdfs:comment "UEL input (uelin). true = input is connected to the HV gate false = input connects to the error signal. Typical value = true."@en;
                      rdfs:domain cim:ExcIEEEDC1A;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "uelin"@en;
