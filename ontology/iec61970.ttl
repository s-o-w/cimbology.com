cim:PFVArControllerType2Dynamics a owl:Class;
                                 rdfs:comment "Power factor or VAr controller type 2 function block whose behaviour is described by reference to a standard model or by definition of a user-defined model."@en;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "PFVArControllerType2Dynamics"@en;
                                 rdfs:subClassOf cim:DynamicsFunctionBlock;
                                 cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.PFVArControllerType2Dynamics";
                                 cimdoc:packageTier "Normative".
cim:PFVArControllerType2Dynamics.ExcitationSystemDynamics a owl:ObjectProperty;
                                                          rdfs:comment "Excitation system model with which this power factor or VAr controller type 2 is associated."@en;
                                                          rdfs:domain cim:PFVArControllerType2Dynamics;
                                                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                          rdfs:label "ExcitationSystemDynamics"@en;
                                                          rdfs:range cim:ExcitationSystemDynamics.
cim:PFVArControllerType2UserDefined a owl:Class;
                                    rdfs:comment "Power factor or VAr controller type 2 function block whose dynamic behaviour is described by a user-defined model."@en;
                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                    rdfs:label "PFVArControllerType2UserDefined"@en;
                                    rdfs:subClassOf cim:PFVArControllerType2Dynamics;
                                    cimdoc:cimPackage "IEC61970.Dynamics.UserDefinedModels";
                                    cimdoc:packageTier "Normative".
cim:PFVArControllerType2UserDefined.proprietary a owl:DatatypeProperty;
                                                rdfs:comment "Behaviour is based on a proprietary model as opposed to a detailed model. true = user-defined model is proprietary with behaviour mutually understood by sending and receiving applications and parameters passed as general attributes false = user-defined model is explicitly defined in terms of control blocks and their input and output signals."@en;
                                                rdfs:domain cim:PFVArControllerType2UserDefined;
                                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                rdfs:label "proprietary"@en;
                                                rdfs:range xsd:boolean.
cim:PFVArType1IEEEPFController a owl:Class;
                               rdfs:comment "IEEE PF controller type 1 which operates by moving the voltage reference directly. Reference: IEEE 421.5-2005, 11.2."@en;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "PFVArType1IEEEPFController"@en;
                               rdfs:subClassOf cim:PFVArControllerType1Dynamics;
                               cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.PFVArControllerType1Dynamics";
                               cimdoc:packageTier "Normative".
cim:PFVArType1IEEEPFController.ovex a owl:DatatypeProperty;
                                    rdfs:comment "Overexcitation Flag (OVEX) true = overexcited false = underexcited."@en;
                                    rdfs:domain cim:PFVArType1IEEEPFController;
                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                    rdfs:label "ovex"@en;
                                    rdfs:range xsd:boolean.
cim:PFVArType1IEEEPFController.tpfc a owl:DatatypeProperty;
                                    rdfs:comment "PF controller time delay (TPFC) (>= 0). Typical value = 5."@en;
                                    rdfs:domain cim:PFVArType1IEEEPFController;
                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                    rdfs:label "tpfc"@en;
                                    rdfs:range cim:Seconds.
cim:PFVArType1IEEEPFController.vitmin a owl:DatatypeProperty;
                                      rdfs:comment "Minimum machine terminal current needed to enable pf/var controller (VITMIN)."@en;
                                      rdfs:domain cim:PFVArType1IEEEPFController;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                      rdfs:label "vitmin"@en;
                                      rdfs:range cim:PU.
cim:PFVArType1IEEEPFController.vpf a owl:DatatypeProperty;
                                   rdfs:comment "Synchronous machine power factor (VPF)."@en;
                                   rdfs:domain cim:PFVArType1IEEEPFController;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                   rdfs:label "vpf"@en;
                                   rdfs:range cim:PU.
cim:PFVArType1IEEEPFController.vpfcbw a owl:DatatypeProperty;
                                      rdfs:comment "PF controller deadband (VPFC_BW). Typical value = 0, 05."@en;
                                      rdfs:domain cim:PFVArType1IEEEPFController;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                      rdfs:label "vpfcbw"@en;
                                      rdfs:range xsd:float.
cim:PFVArType1IEEEPFController.vpfref a owl:DatatypeProperty;
                                      rdfs:comment "PF controller reference (VPFREF)."@en;
                                      rdfs:domain cim:PFVArType1IEEEPFController;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                      rdfs:label "vpfref"@en;
                                      rdfs:range cim:PU.
cim:PFVArType1IEEEPFController.vvtmax a owl:DatatypeProperty;
                                      rdfs:comment "Maximum machine terminal voltage needed for pf/var controller to be enabled (VVTMAX) (greater than PFVArType1IEEEPFController.vvtmin)."@en;
                                      rdfs:domain cim:PFVArType1IEEEPFController;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                      rdfs:label "vvtmax"@en;
                                      rdfs:range cim:PU.
cim:PFVArType1IEEEPFController.vvtmin a owl:DatatypeProperty;
                                      rdfs:comment "Minimum machine terminal voltage needed to enable pf/var controller (VVTMIN) (less than PFVArType1IEEEPFController.vvtmax)."@en;
                                      rdfs:domain cim:PFVArType1IEEEPFController;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                      rdfs:label "vvtmin"@en;
                                      rdfs:range cim:PU.
cim:PFVArType1IEEEVArController a owl:Class;
                                rdfs:comment "IEEE VAR controller type 1 which operates by moving the voltage reference directly. Reference: IEEE 421.5-2005, 11.3."@en;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "PFVArType1IEEEVArController"@en;
                                rdfs:subClassOf cim:PFVArControllerType1Dynamics;
                                cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.PFVArControllerType1Dynamics";
                                cimdoc:packageTier "Normative".
cim:PFVArType1IEEEVArController.tvarc a owl:DatatypeProperty;
