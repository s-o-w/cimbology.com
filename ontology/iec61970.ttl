cim:LoadStatic.kp2 a owl:DatatypeProperty;
                   rdfs:comment "Second term voltage coefficient for active power (Kp2). Not used when .staticLoadModelType = constantZ."@en;
                   rdfs:domain cim:LoadStatic;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "kp2"@en;
                   rdfs:range xsd:float.
cim:LoadStatic.kp3 a owl:DatatypeProperty;
                   rdfs:comment "Third term voltage coefficient for active power (Kp3). Not used when .staticLoadModelType = constantZ."@en;
                   rdfs:domain cim:LoadStatic;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "kp3"@en;
