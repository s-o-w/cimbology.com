cim:Money a rdfs:Datatype;
          rdfs:comment "Amount of money."@en;
          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
          rdfs:label "Money"@en;
          owl:equivalentClass xsd:decimal;
          cimdoc:cimPackage "IEC61970.Base.Domain";
          cimdoc:packageTier "Normative".
cim:MonthDay a rdfs:Datatype;
             rdfs:comment """MonthDay format as \"--mm-dd\", which conforms with XSD data type gMonthDay."""@en;
             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
             rdfs:label "MonthDay"@en;
             owl:equivalentClass xsd:gMonthDay;
             cimdoc:cimPackage "IEC61970.Base.Domain";
             cimdoc:packageTier "Normative".
cim:MonthDayInterval a owl:Class;
                     rdfs:comment "Interval between two times specified as month and day."@en;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                     rdfs:label "MonthDayInterval"@en;
                     cimdoc:cimPackage "IEC61970.Base.Domain";
                     cimdoc:packageTier "Normative".
cim:MonthDayInterval.end a owl:DatatypeProperty;
                         rdfs:comment "End time of this interval."@en;
                         rdfs:domain cim:MonthDayInterval;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                         rdfs:label "end"@en;
                         rdfs:range xsd:gMonthDay.
cim:MonthDayInterval.start a owl:DatatypeProperty;
                           rdfs:comment "Start time of this interval."@en;
                           rdfs:domain cim:MonthDayInterval;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "start"@en;
