                 rdfs:subClassOf cim:OperationalLimit;
                 cimdoc:cimPackage "IEC61970.Base.OperationalLimits";
                 cimdoc:packageTier "Normative".
cim:CurrentLimit.normalValue a owl:DatatypeProperty;
                             rdfs:comment "The normal value for limit on current flow. The attribute shall be a positive value or zero."@en;
                             rdfs:domain cim:CurrentLimit;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "normalValue"@en;
                             rdfs:range cim:CurrentFlow.
cim:CurrentLimit.value a owl:DatatypeProperty;
                       rdfs:comment "Limit on current flow. The attribute shall be a positive value or zero."@en;
