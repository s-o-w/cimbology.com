                rdfs:comment "Selector for frequency/shaft speed input (isFreq). true = speed (same meaning as InputSignaKind.rotorSpeed) false = frequency (same meaning as InputSignalKind.busFrequency). Typical value = true (same meaning as InputSignalKind.rotorSpeed)."@en;
                rdfs:domain cim:Pss5;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
