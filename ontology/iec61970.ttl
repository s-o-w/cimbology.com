                       rdfs:label "onePerm"@en;
                       cimdoc:enumCode 173 .
cim:UnitSymbol.ppm a owl:NamedIndividual,
                     cim:UnitSymbol;
                   rdfs:comment "Concentration in parts per million."@en;
