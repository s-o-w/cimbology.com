                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "VoltageAdjusterDynamics"@en;
                            rdfs:subClassOf cim:DynamicsFunctionBlock;
                            cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.VoltageAdjusterDynamics";
