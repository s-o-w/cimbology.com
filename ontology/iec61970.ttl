                  rdfs:range cim:PU.
cim:GovGAST1.r a owl:DatatypeProperty;
               rdfs:comment "Permanent droop (R) (>0). Typical value = 0,04."@en;
               rdfs:domain cim:GovGAST1;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "r"@en;
               rdfs:range cim:PU.
cim:GovGAST1.rmax a owl:DatatypeProperty;
                  rdfs:comment "Maximum fuel valve opening rate (Rmax). Unit = PU / s. Typical value = 1."@en;
                  rdfs:domain cim:GovGAST1;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "rmax"@en;
                  rdfs:range xsd:float.
cim:GovGAST1.t1 a owl:DatatypeProperty;
                rdfs:comment "Governor mechanism time constant (T1) (>= 0). T1 represents the natural valve positioning time constant of the governor for small disturbances, as seen when rate limiting is not in effect. Typical value = 0,5."@en;
                rdfs:domain cim:GovGAST1;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "t1"@en;
                rdfs:range cim:Seconds.
cim:GovGAST1.t2 a owl:DatatypeProperty;
                rdfs:comment "Turbine power time constant (T2) (>= 0). T2 represents delay due to internal energy storage of the gas turbine engine. T2 can be used to give a rough approximation to the delay associated with acceleration of the compressor spool of a multi-shaft engine, or with the compressibility of gas in the plenum of the free power turbine of an aero-derivative unit, for example. Typical value = 0,5."@en;
                rdfs:domain cim:GovGAST1;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "t2"@en;
                rdfs:range cim:Seconds.
cim:GovGAST1.t3 a owl:DatatypeProperty;
                rdfs:comment "Turbine exhaust temperature time constant (T3) (>= 0). T3 represents delay in the exhaust temperature and load limiting system. Typical value = 3."@en;
                rdfs:domain cim:GovGAST1;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "t3"@en;
                rdfs:range cim:Seconds.
cim:GovGAST1.t4 a owl:DatatypeProperty;
                rdfs:comment "Governor lead time constant (T4) (>= 0). Typical value = 0."@en;
                rdfs:domain cim:GovGAST1;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "t4"@en;
                rdfs:range cim:Seconds.
cim:GovGAST1.t5 a owl:DatatypeProperty;
                rdfs:comment "Governor lag time constant (T5) (>= 0). If = 0, entire gain and lead- lag block is bypassed. Typical value = 0."@en;
                rdfs:domain cim:GovGAST1;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "t5"@en;
                rdfs:range cim:Seconds.
cim:GovGAST1.tltr a owl:DatatypeProperty;
                  rdfs:comment "Valve position averaging time constant (Tltr) (>= 0). Typical value = 10."@en;
                  rdfs:domain cim:GovGAST1;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "tltr"@en;
                  rdfs:range cim:Seconds.
cim:GovGAST1.vmax a owl:DatatypeProperty;
                  rdfs:comment "Maximum turbine power, PU of MWbase (Vmax) (greater than GovGAST1.vmin). Typical value = 1."@en;
                  rdfs:domain cim:GovGAST1;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "vmax"@en;
                  rdfs:range cim:PU.
cim:GovGAST1.vmin a owl:DatatypeProperty;
                  rdfs:comment "Minimum turbine power, PU of MWbase (Vmin) (less than GovGAST1.vmax). Typical value = 0."@en;
                  rdfs:domain cim:GovGAST1;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "vmin"@en;
