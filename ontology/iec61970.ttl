cim:NetworkBoundary.m_NetworkFrame a owl:ObjectProperty;
                                   rdfs:comment "The network frame associated with this boundary."@en;
                                   rdfs:domain cim:NetworkBoundary;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
