                            rdfs:label "vucmax"@en;
                            rdfs:range cim:PU.
cim:UnderexcLimIEEE1.vuimax a owl:DatatypeProperty;
                            rdfs:comment "UEL integrator output maximum limit (VUIMAX) (> UnderexcLimIEEE1.vuimin)."@en;
                            rdfs:domain cim:UnderexcLimIEEE1;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
