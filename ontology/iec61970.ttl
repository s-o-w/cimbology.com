cim:Substation.VoltageLevels a owl:ObjectProperty;
                             rdfs:comment "The voltage levels within this substation."@en;
                             rdfs:domain cim:Substation;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "VoltageLevels"@en;
                             rdfs:range cim:VoltageLevel.
cim:Supercritical a owl:Class;
                  rdfs:comment "Once-through supercritical boiler."@en;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "Supercritical"@en;
                  rdfs:subClassOf cim:FossilSteamSupply;
                  cimdoc:cimPackage "IEC61970.Base.Generation.GenerationTrainingSimulation";
                  cimdoc:packageTier "Normative".
cim:SurgeArrester a owl:Class;
                  rdfs:comment "Shunt device, installed on the network, usually in the proximity of electrical equipment in order to protect the said equipment against transient voltage transients caused by lightning or switching activity."@en;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "SurgeArrester"@en;
                  rdfs:subClassOf cim:AuxiliaryEquipment;
                  cimdoc:cimPackage "IEC61970.Base.AuxiliaryEquipment";
                  cimdoc:packageTier "Normative".
cim:Susceptance a rdfs:Datatype;
                rdfs:comment "Imaginary part of admittance."@en;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "Susceptance"@en;
                owl:equivalentClass xsd:float;
                cimdoc:cimPackage "IEC61970.Base.Domain";
                cimdoc:packageTier "Normative";
                cimdoc:unitSymbol cim:UnitSymbol.S.
cim:SusceptancePerLength a rdfs:Datatype;
                         rdfs:comment "Imaginary part of admittance per unit of length."@en;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                         rdfs:label "SusceptancePerLength"@en;
                         owl:equivalentClass xsd:float;
                         cimdoc:cimPackage "IEC61970.Base.Domain";
                         cimdoc:packageTier "Normative";
                         cimdoc:unitMultiplier cim:UnitMultiplier.none;
                         cimdoc:unitSymbol cim:UnitSymbol.SPerm.
cim:SvInjection a owl:Class;
                rdfs:comment "The SvInjection reports the calculated bus injection minus the sum of the terminal flows. The terminal flow is positive out from the bus (load sign convention) and bus injection has positive flow into the bus. SvInjection may have the remainder after state estimation or slack after power flow calculation."@en;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "SvInjection"@en;
                rdfs:subClassOf cim:StateVariable;
                cimdoc:cimPackage "IEC61970.Base.StateVariables";
                cimdoc:packageTier "Normative".
cim:SvInjection.TopologicalNode a owl:ObjectProperty;
                                rdfs:comment "The topological node associated with the flow injection state variable."@en;
                                rdfs:domain cim:SvInjection;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "TopologicalNode"@en;
                                rdfs:range cim:TopologicalNode.
cim:SvInjection.pInjection a owl:DatatypeProperty;
                           rdfs:comment "The active power mismatch between calculated injection and initial injection. Positive sign means injection into the TopologicalNode (bus)."@en;
                           rdfs:domain cim:SvInjection;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "pInjection"@en;
                           rdfs:range cim:ActivePower.
cim:SvInjection.phase a owl:ObjectProperty;
                      rdfs:comment "The terminal phase at which the connection is applied. If missing, the injection is assumed to be balanced among non-neutral phases."@en;
                      rdfs:domain cim:SvInjection;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "phase"@en;
                      rdfs:range cim:SinglePhaseKind.
cim:SvInjection.qInjection a owl:DatatypeProperty;
                           rdfs:comment "The reactive power mismatch between calculated injection and initial injection. Positive sign means injection into the TopologicalNode (bus)."@en;
                           rdfs:domain cim:SvInjection;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "qInjection"@en;
                           rdfs:range cim:ReactivePower.
cim:SvPowerFlow a owl:Class;
                rdfs:comment "State variable for power flow. Load convention is used for flow direction. This means flow out from the TopologicalNode into the equipment is positive."@en;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "SvPowerFlow"@en;
                rdfs:subClassOf cim:StateVariable;
                cimdoc:cimPackage "IEC61970.Base.StateVariables";
                cimdoc:packageTier "Normative".
cim:SvPowerFlow.Terminal a owl:ObjectProperty;
                         rdfs:comment "The terminal associated with the power flow state variable."@en;
                         rdfs:domain cim:SvPowerFlow;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                         rdfs:label "Terminal"@en;
                         rdfs:range cim:Terminal.
cim:SvPowerFlow.m_EnergyGroup a owl:ObjectProperty;
                              rdfs:comment "The energygroup"@en;
                              rdfs:domain cim:SvPowerFlow;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "m_EnergyGroup"@en;
                              rdfs:range cim:EnergyGroup.
cim:SvPowerFlow.p a owl:DatatypeProperty;
                  rdfs:comment "The active power flow. Load sign convention is used, i.e. positive sign means flow out from a TopologicalNode (bus) into the conducting equipment."@en;
                  rdfs:domain cim:SvPowerFlow;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "p"@en;
                  rdfs:range cim:ActivePower.
cim:SvPowerFlow.phase a owl:ObjectProperty;
                      rdfs:comment "The individual phase of the flow. If unspecified, then assumed to be balanced among phases."@en;
                      rdfs:domain cim:SvPowerFlow;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "phase"@en;
                      rdfs:range cim:SinglePhaseKind.
cim:SvPowerFlow.q a owl:DatatypeProperty;
                  rdfs:comment "The reactive power flow. Load sign convention is used, i.e. positive sign means flow out from a TopologicalNode (bus) into the conducting equipment."@en;
                  rdfs:domain cim:SvPowerFlow;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "q"@en;
                  rdfs:range cim:ReactivePower.
cim:SvShuntCompensatorSections a owl:Class;
                               rdfs:comment "State variable for the number of sections in service for a shunt compensator."@en;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "SvShuntCompensatorSections"@en;
                               rdfs:subClassOf cim:StateVariable;
                               cimdoc:cimPackage "IEC61970.Base.StateVariables";
                               cimdoc:packageTier "Normative".
cim:SvShuntCompensatorSections.ShuntCompensator a owl:ObjectProperty;
                                                rdfs:comment "The shunt compensator for which the state applies."@en;
                                                rdfs:domain cim:SvShuntCompensatorSections;
                                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                rdfs:label "ShuntCompensator"@en;
                                                rdfs:range cim:ShuntCompensator.
cim:SvShuntCompensatorSections.phase a owl:ObjectProperty;
                                     rdfs:comment "The terminal phase at which the connection is applied. If missing, the injection is assumed to be balanced among non-neutral phases."@en;
                                     rdfs:domain cim:SvShuntCompensatorSections;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                     rdfs:label "phase"@en;
                                     rdfs:range cim:SinglePhaseKind.
cim:SvShuntCompensatorSections.sections a owl:DatatypeProperty;
                                        rdfs:comment "The number of sections in service as a continuous variable. The attribute shall be a positive value or zero. To get integer value scale with ShuntCompensator. bPerSection."@en;
                                        rdfs:domain cim:SvShuntCompensatorSections;
                                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                        rdfs:label "sections"@en;
                                        rdfs:range xsd:float.
cim:SvStatus a owl:Class;
             rdfs:comment "State variable for status."@en;
             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
             rdfs:label "SvStatus"@en;
             rdfs:subClassOf cim:StateVariable;
             cimdoc:cimPackage "IEC61970.Base.StateVariables";
             cimdoc:packageTier "Normative".
cim:SvStatus.ConductingEquipment a owl:ObjectProperty;
                                 rdfs:comment "The conducting equipment associated with the status state variable."@en;
                                 rdfs:domain cim:SvStatus;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "ConductingEquipment"@en;
                                 rdfs:range cim:ConductingEquipment.
cim:SvStatus.inService a owl:DatatypeProperty;
                       rdfs:comment "The in service status as a result of topology processing. It indicates if the equipment is considered as energized by the power flow. It reflects if the equipment is connected within a solvable island. It does not necessarily reflect whether or not the island was solved by the power flow."@en;
                       rdfs:domain cim:SvStatus;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "inService"@en;
                       rdfs:range xsd:boolean.
cim:SvStatus.phase a owl:ObjectProperty;
                   rdfs:comment "The individual phase status. If the attribute is unspecified, then three phase model is assumed."@en;
                   rdfs:domain cim:SvStatus;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "phase"@en;
                   rdfs:range cim:SinglePhaseKind.
cim:SvSwitch a owl:Class;
             rdfs:comment "State variable for switch."@en;
             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
             rdfs:label "SvSwitch"@en;
             rdfs:subClassOf cim:StateVariable;
             cimdoc:cimPackage "IEC61970.Base.StateVariables";
             cimdoc:packageTier "Normative".
cim:SvSwitch.Switch a owl:ObjectProperty;
                    rdfs:comment "The switch associated with the switch state."@en;
                    rdfs:domain cim:SvSwitch;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "Switch"@en;
                    rdfs:range cim:Switch.
cim:SvSwitch.open a owl:DatatypeProperty;
                  rdfs:comment "The attribute tells if the computed state of the switch is considered open."@en;
                  rdfs:domain cim:SvSwitch;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "open"@en;
                  rdfs:range xsd:boolean.
cim:SvSwitch.phase a owl:ObjectProperty;
                   rdfs:comment "The terminal phase at which the connection is applied. If missing, the injection is assumed to be balanced among non-neutral phases."@en;
                   rdfs:domain cim:SvSwitch;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "phase"@en;
                   rdfs:range cim:SinglePhaseKind.
cim:SvTapStep a owl:Class;
              rdfs:comment "State variable for transformer tap step."@en;
              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
              rdfs:label "SvTapStep"@en;
              rdfs:subClassOf cim:StateVariable;
              cimdoc:cimPackage "IEC61970.Base.StateVariables";
              cimdoc:packageTier "Normative".
cim:SvTapStep.TapChanger a owl:ObjectProperty;
                         rdfs:comment "The tap changer associated with the tap step state."@en;
                         rdfs:domain cim:SvTapStep;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                         rdfs:label "TapChanger"@en;
                         rdfs:range cim:TapChanger.
cim:SvTapStep.position a owl:DatatypeProperty;
                       rdfs:comment "The floating point tap position. This is not the tap ratio, but rather the tap step position as defined by the related tap changer model and normally is constrained to be within the range of minimum and maximum tap positions."@en;
                       rdfs:domain cim:SvTapStep;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "position"@en;
                       rdfs:range xsd:float.
cim:SvVoltage a owl:Class;
              rdfs:comment "State variable for voltage."@en;
              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
              rdfs:label "SvVoltage"@en;
              rdfs:subClassOf cim:StateVariable;
              cimdoc:cimPackage "IEC61970.Base.StateVariables";
              cimdoc:packageTier "Normative".
cim:SvVoltage.TopologicalNode a owl:ObjectProperty;
                              rdfs:comment "The topological node associated with the voltage state."@en;
                              rdfs:domain cim:SvVoltage;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "TopologicalNode"@en;
                              rdfs:range cim:TopologicalNode.
cim:SvVoltage.angle a owl:DatatypeProperty;
                    rdfs:comment "The voltage angle of the topological node complex voltage with respect to system reference."@en;
                    rdfs:domain cim:SvVoltage;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "angle"@en;
                    rdfs:range cim:AngleDegrees.
cim:SvVoltage.phase a owl:ObjectProperty;
                    rdfs:comment "If specified the voltage is the line to ground voltage of the individual phase. If unspecified, then the voltage is assumed balanced."@en;
                    rdfs:domain cim:SvVoltage;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "phase"@en;
                    rdfs:range cim:SinglePhaseKind.
cim:SvVoltage.v a owl:DatatypeProperty;
                rdfs:comment "The voltage magnitude at the topological node. The attribute shall be a positive value."@en;
                rdfs:domain cim:SvVoltage;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "v"@en;
                rdfs:range cim:Voltage.
cim:Switch a owl:Class;
           rdfs:comment "A generic device designed to close, or open, or both, one or more electric circuits. All switches are two terminal devices including grounding switches. The ACDCTerminal.connected at the two sides of the switch shall not be considered for assessing switch connectivity, i.e. only Switch.open, . normalOpen and .locked are relevant."@en;
           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
           rdfs:label "Switch"@en;
           rdfs:subClassOf cim:ConductingEquipment;
           cimdoc:cimPackage "IEC61970.Base.Wires";
           cimdoc:packageTier "Normative".
cim:Switch.SwitchPhase a owl:ObjectProperty;
                       rdfs:comment "The individual switch phases for the switch."@en;
                       rdfs:domain cim:Switch;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "SwitchPhase"@en;
                       rdfs:range cim:SwitchPhase.
cim:Switch.SwitchSchedules a owl:ObjectProperty;
                           rdfs:comment "A Switch can be associated with SwitchSchedules."@en;
                           rdfs:domain cim:Switch;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "SwitchSchedules"@en;
                           rdfs:range cim:SwitchSchedule.
cim:Switch.locked a owl:DatatypeProperty;
                  rdfs:comment "If true, the switch is locked. The resulting switch state is a combination of locked and Switch.open attributes as follows: - locked=true and Switch.open=true. The resulting state is open and locked; - locked=false and Switch.open=true. The resulting state is open; - locked=false and Switch.open=false. The resulting state is closed."@en;
                  rdfs:domain cim:Switch;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "locked"@en;
                  rdfs:range xsd:boolean.
cim:Switch.normalOpen a owl:DatatypeProperty;
                      rdfs:comment "The attribute is used in cases when no Measurement for the status value is present. If the Switch has a status measurement the Discrete.normalValue is expected to match with the Switch.normalOpen."@en;
                      rdfs:domain cim:Switch;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "normalOpen"@en;
                      rdfs:range xsd:boolean.
cim:Switch.open a owl:DatatypeProperty;
                rdfs:comment "The attribute tells if the switch is considered open when used as input to topology processing."@en;
                rdfs:domain cim:Switch;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "open"@en;
                rdfs:range xsd:boolean.
cim:Switch.ratedCurrent a owl:DatatypeProperty;
                        rdfs:comment "The maximum continuous current carrying capacity in amps governed by the device material and construction. The attribute shall be a positive value."@en;
                        rdfs:domain cim:Switch;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                        rdfs:label "ratedCurrent"@en;
                        rdfs:range cim:CurrentFlow.
cim:Switch.retained a owl:DatatypeProperty;
                    rdfs:comment "Branch is retained in the topological solution. The flow through retained switches will normally be calculated in power flow."@en;
                    rdfs:domain cim:Switch;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "retained"@en;
                    rdfs:range xsd:boolean.
cim:Switch.switchOnCount a owl:DatatypeProperty;
                         rdfs:comment "The switch on count since the switch was last reset or initialized."@en;
                         rdfs:domain cim:Switch;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                         rdfs:label "switchOnCount"@en;
                         rdfs:range xsd:integer.
cim:Switch.switchOnDate a owl:DatatypeProperty;
                        rdfs:comment "The date and time when the switch was last switched on."@en;
                        rdfs:domain cim:Switch;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                        rdfs:label "switchOnDate"@en;
                        rdfs:range xsd:dateTime.
cim:SwitchPhase a owl:Class;
                rdfs:comment "Single phase of a multi-phase switch when its attributes might be different per phase."@en;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "SwitchPhase"@en;
                rdfs:subClassOf cim:PowerSystemResource;
                cimdoc:cimPackage "IEC61970.Base.Wires";
                cimdoc:packageTier "Normative".
cim:SwitchPhase.closed a owl:DatatypeProperty;
                       rdfs:comment "The attribute tells if the switch is considered closed when used as input to topology processing."@en;
                       rdfs:domain cim:SwitchPhase;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "closed"@en;
                       rdfs:range xsd:boolean.
cim:SwitchPhase.normalOpen a owl:DatatypeProperty;
                           rdfs:comment "Used in cases when no Measurement for the status value is present. If the SwitchPhase has a status measurement the Discrete.normalValue is expected to match with this value."@en;
                           rdfs:domain cim:SwitchPhase;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "normalOpen"@en;
                           rdfs:range xsd:boolean.
cim:SwitchPhase.phaseSide1 a owl:ObjectProperty;
                           rdfs:comment "Phase of this SwitchPhase on the side with terminal sequence number equal to 1. Should be a phase contained in that terminal�s phases attribute."@en;
                           rdfs:domain cim:SwitchPhase;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "phaseSide1"@en;
                           rdfs:range cim:SinglePhaseKind.
cim:SwitchPhase.phaseSide2 a owl:ObjectProperty;
                           rdfs:comment "Phase of this SwitchPhase on the side with terminal sequence number equal to 2. Should be a phase contained in that terminal�s Terminal.phases attribute."@en;
                           rdfs:domain cim:SwitchPhase;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "phaseSide2"@en;
                           rdfs:range cim:SinglePhaseKind.
cim:SwitchPhase.ratedCurrent a owl:DatatypeProperty;
                             rdfs:comment "The maximum continuous current carrying capacity in amps governed by the device material and construction. The attribute shall be a positive value."@en;
                             rdfs:domain cim:SwitchPhase;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "ratedCurrent"@en;
                             rdfs:range cim:CurrentFlow.
cim:SwitchSchedule a owl:Class;
                   rdfs:comment "A schedule of switch positions. If RegularTimePoint.value1 is 0, the switch is open. If 1, the switch is closed."@en;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "SwitchSchedule"@en;
                   rdfs:subClassOf cim:SeasonDayTypeSchedule;
                   cimdoc:cimPackage "IEC61970.Base.Wires";
                   cimdoc:packageTier "Normative".
cim:SynchrocheckRelay a owl:Class;
                      rdfs:comment "A device that operates when two AC circuits are within the desired limits of frequency, phase angle, and voltage, to permit or to cause the paralleling of these two circuits. Used to prevent the paralleling of non-synchronous topological islands."@en;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "SynchrocheckRelay"@en;
                      rdfs:subClassOf cim:ProtectionEquipment;
                      cimdoc:cimPackage "IEC61970.Base.Protection";
                      cimdoc:packageTier "Normative".
cim:SynchrocheckRelay.maxAngleDiff a owl:DatatypeProperty;
                                   rdfs:comment "The maximum allowable voltage vector phase angle difference across the open device."@en;
                                   rdfs:domain cim:SynchrocheckRelay;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                   rdfs:label "maxAngleDiff"@en;
                                   rdfs:range cim:AngleRadians.
cim:SynchrocheckRelay.maxFreqDiff a owl:DatatypeProperty;
                                  rdfs:comment "The maximum allowable frequency difference across the open device."@en;
                                  rdfs:domain cim:SynchrocheckRelay;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "maxFreqDiff"@en;
                                  rdfs:range cim:Frequency.
cim:SynchrocheckRelay.maxVoltDiff a owl:DatatypeProperty;
                                  rdfs:comment "The maximum allowable difference voltage across the open device."@en;
                                  rdfs:domain cim:SynchrocheckRelay;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "maxVoltDiff"@en;
                                  rdfs:range cim:Voltage.
cim:SynchronousMachine a owl:Class;
                       rdfs:comment "An electromechanical device that operates with shaft rotating synchronously with the network. It is a single machine operating either as a generator or synchronous condenser or pump."@en;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "SynchronousMachine"@en;
                       rdfs:subClassOf cim:RotatingMachine;
                       cimdoc:cimPackage "IEC61970.Base.Wires";
                       cimdoc:packageTier "Normative".
cim:SynchronousMachine.aVRToManualLag a owl:DatatypeProperty;
                                      rdfs:comment "Time delay required when switching from Automatic Voltage Regulation (AVR) to Manual for a lagging MVAr violation."@en;
                                      rdfs:domain cim:SynchronousMachine;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                      rdfs:label "aVRToManualLag"@en;
                                      rdfs:range cim:Seconds.
cim:SynchronousMachine.aVRToManualLead a owl:DatatypeProperty;
                                       rdfs:comment "Time delay required when switching from Automatic Voltage Regulation (AVR) to Manual for a leading MVAr violation."@en;
                                       rdfs:domain cim:SynchronousMachine;
                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                       rdfs:label "aVRToManualLead"@en;
                                       rdfs:range cim:Seconds.
cim:SynchronousMachine.baseQ a owl:DatatypeProperty;
                             rdfs:comment "Default base reactive power value. This value represents the initial reactive power that can be used by any application function."@en;
                             rdfs:domain cim:SynchronousMachine;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "baseQ"@en;
                             rdfs:range cim:ReactivePower.
cim:SynchronousMachine.condenserP a owl:DatatypeProperty;
                                  rdfs:comment "Active power consumed when in condenser mode operation."@en;
                                  rdfs:domain cim:SynchronousMachine;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "condenserP"@en;
                                  rdfs:range cim:ActivePower.
cim:SynchronousMachine.coolantCondition a owl:DatatypeProperty;
                                        rdfs:comment "Temperature or pressure of coolant medium."@en;
                                        rdfs:domain cim:SynchronousMachine;
                                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                        rdfs:label "coolantCondition"@en;
                                        rdfs:range xsd:float.
cim:SynchronousMachine.coolantType a owl:ObjectProperty;
                                   rdfs:comment "Method of cooling the machine."@en;
                                   rdfs:domain cim:SynchronousMachine;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                   rdfs:label "coolantType"@en;
                                   rdfs:range cim:CoolantType.
cim:SynchronousMachine.earthing a owl:DatatypeProperty;
                                rdfs:comment "Indicates whether or not the generator is earthed. Used for short circuit data exchange according to IEC 60909."@en;
                                rdfs:domain cim:SynchronousMachine;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "earthing"@en;
                                rdfs:range xsd:boolean.
cim:SynchronousMachine.earthingStarPointR a owl:DatatypeProperty;
                                          rdfs:comment "Generator star point earthing resistance (Re). Used for short circuit data exchange according to IEC 60909."@en;
                                          rdfs:domain cim:SynchronousMachine;
                                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                          rdfs:label "earthingStarPointR"@en;
                                          rdfs:range cim:Resistance.
cim:SynchronousMachine.earthingStarPointX a owl:DatatypeProperty;
                                          rdfs:comment "Generator star point earthing reactance (Xe). Used for short circuit data exchange according to IEC 60909."@en;
                                          rdfs:domain cim:SynchronousMachine;
                                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                          rdfs:label "earthingStarPointX"@en;
                                          rdfs:range cim:Reactance.
cim:SynchronousMachine.ikk a owl:DatatypeProperty;
                           rdfs:comment "Steady-state short-circuit current (in A for the profile) of generator with compound excitation during 3-phase short circuit. - Ikk equals 0: Generator with no compound excitation. - Ikk not equal to 0: Generator with compound excitation. Ikk is used to calculate the minimum steady-state short-circuit current for generators with compound excitation. (4.6.1.2 in IEC 60909-0:2001). Used only for single fed short circuit on a generator. (4.3.4.2. in IEC 60909-0:2001)."@en;
                           rdfs:domain cim:SynchronousMachine;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "ikk"@en;
                           rdfs:range cim:CurrentFlow.
cim:SynchronousMachine.manualToAVR a owl:DatatypeProperty;
                                   rdfs:comment "Time delay required when switching from Manual to Automatic Voltage Regulation. This value is used in the accelerating power reference frame for powerflow solutions."@en;
                                   rdfs:domain cim:SynchronousMachine;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                   rdfs:label "manualToAVR"@en;
                                   rdfs:range cim:Seconds.
cim:SynchronousMachine.maxQ a owl:DatatypeProperty;
                            rdfs:comment "Maximum reactive power limit. This is the maximum (nameplate) limit for the unit."@en;
                            rdfs:domain cim:SynchronousMachine;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "maxQ"@en;
                            rdfs:range cim:ReactivePower.
cim:SynchronousMachine.maxU a owl:DatatypeProperty;
                            rdfs:comment "Maximum voltage limit for the unit."@en;
                            rdfs:domain cim:SynchronousMachine;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "maxU"@en;
                            rdfs:range cim:Voltage.
cim:SynchronousMachine.minQ a owl:DatatypeProperty;
                            rdfs:comment "Minimum reactive power limit for the unit."@en;
                            rdfs:domain cim:SynchronousMachine;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "minQ"@en;
                            rdfs:range cim:ReactivePower.
cim:SynchronousMachine.minU a owl:DatatypeProperty;
                            rdfs:comment "Minimum voltage limit for the unit."@en;
                            rdfs:domain cim:SynchronousMachine;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "minU"@en;
                            rdfs:range cim:Voltage.
cim:SynchronousMachine.mu a owl:DatatypeProperty;
                          rdfs:comment "Factor to calculate the breaking current (Section 4.5.2.1 in IEC 60909-0). Used only for single fed short circuit on a generator (Section 4.3.4.2. in IEC 60909-0)."@en;
                          rdfs:domain cim:SynchronousMachine;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                          rdfs:label "mu"@en;
                          rdfs:range xsd:float.
cim:SynchronousMachine.operatingMode a owl:ObjectProperty;
                                     rdfs:comment "Current mode of operation."@en;
                                     rdfs:domain cim:SynchronousMachine;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                     rdfs:label "operatingMode"@en;
                                     rdfs:range cim:SynchronousMachineOperatingMode.
cim:SynchronousMachine.qPercent a owl:DatatypeProperty;
                                rdfs:comment "Part of the coordinated reactive control that comes from this machine. The attribute is used as a participation factor not necessarily summing up to 100% for the participating devices in the control."@en;
                                rdfs:domain cim:SynchronousMachine;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "qPercent"@en;
                                rdfs:range cim:PerCent.
cim:SynchronousMachine.r a owl:DatatypeProperty;
                         rdfs:comment "Equivalent resistance (RG) of generator. RG is considered for the calculation of all currents, except for the calculation of the peak current ip. Used for short circuit data exchange according to IEC 60909."@en;
                         rdfs:domain cim:SynchronousMachine;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                         rdfs:label "r"@en;
                         rdfs:range cim:Resistance.
cim:SynchronousMachine.r0 a owl:DatatypeProperty;
                          rdfs:comment "Zero sequence resistance of the synchronous machine."@en;
                          rdfs:domain cim:SynchronousMachine;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                          rdfs:label "r0"@en;
                          rdfs:range cim:Resistance.
cim:SynchronousMachine.r2 a owl:DatatypeProperty;
                          rdfs:comment "Negative sequence resistance."@en;
                          rdfs:domain cim:SynchronousMachine;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                          rdfs:label "r2"@en;
                          rdfs:range cim:Resistance.
cim:SynchronousMachine.referencePriority a owl:DatatypeProperty;
                                         rdfs:comment "Priority of unit for use as powerflow voltage phase angle reference bus selection. 0 = don t care (default) 1 = highest priority. 2 is less than 1 and so on."@en;
                                         rdfs:domain cim:SynchronousMachine;
                                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                         rdfs:label "referencePriority"@en;
                                         rdfs:range xsd:integer.
cim:SynchronousMachine.satDirectSubtransX a owl:DatatypeProperty;
                                          rdfs:comment """Direct-axis subtransient reactance saturated, also known as Xd\"sat."""@en;
                                          rdfs:domain cim:SynchronousMachine;
                                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                          rdfs:label "satDirectSubtransX"@en;
                                          rdfs:range cim:PU.
cim:SynchronousMachine.satDirectSyncX a owl:DatatypeProperty;
                                      rdfs:comment "Direct-axes saturated synchronous reactance (xdsat); reciprocal of short- circuit ration. Used for short circuit data exchange, only for single fed short circuit on a generator. (4.3.4.2. in IEC 60909-0:2001)."@en;
                                      rdfs:domain cim:SynchronousMachine;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                      rdfs:label "satDirectSyncX"@en;
                                      rdfs:range cim:PU.
cim:SynchronousMachine.satDirectTransX a owl:DatatypeProperty;
                                       rdfs:comment "Saturated Direct-axis transient reactance. The attribute is primarily used for short circuit calculations according to ANSI."@en;
                                       rdfs:domain cim:SynchronousMachine;
                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                       rdfs:label "satDirectTransX"@en;
                                       rdfs:range cim:PU.
cim:SynchronousMachine.shortCircuitRotorType a owl:ObjectProperty;
                                             rdfs:comment "Type of rotor, used by short circuit applications, only for single fed short circuit according to IEC 60909."@en;
                                             rdfs:domain cim:SynchronousMachine;
                                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                             rdfs:label "shortCircuitRotorType"@en;
                                             rdfs:range cim:ShortCircuitRotorKind.
cim:SynchronousMachine.type a owl:ObjectProperty;
                            rdfs:comment "Modes that this synchronous machine can operate in."@en;
                            rdfs:domain cim:SynchronousMachine;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "type"@en;
                            rdfs:range cim:SynchronousMachineKind.
cim:SynchronousMachine.voltageRegulationRange a owl:DatatypeProperty;
                                              rdfs:comment "Range of generator voltage regulation (PG in IEC 60909-0) used for calculation of the impedance correction factor KG defined in IEC 60909-0. This attribute is used to describe the operating voltage of the generating unit."@en;
                                              rdfs:domain cim:SynchronousMachine;
                                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                              rdfs:label "voltageRegulationRange"@en;
                                              rdfs:range cim:PerCent.
cim:SynchronousMachine.x0 a owl:DatatypeProperty;
                          rdfs:comment "Zero sequence reactance of the synchronous machine."@en;
                          rdfs:domain cim:SynchronousMachine;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                          rdfs:label "x0"@en;
                          rdfs:range cim:Reactance.
cim:SynchronousMachine.x2 a owl:DatatypeProperty;
                          rdfs:comment "Negative sequence reactance."@en;
                          rdfs:domain cim:SynchronousMachine;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                          rdfs:label "x2"@en;
                          rdfs:range cim:Reactance.
cim:SynchronousMachineDetailed a owl:Class;
                               rdfs:comment "All synchronous machine detailed types use a subset of the same data parameters and input/output variables. The several variations differ in the following ways: - the number of equivalent windings that are included; - the way in which saturation is incorporated into the model; - whether or not �subtransient saliency� (X''q not = X''d) is represented. It is not necessary for each simulation tool to have separate models for each of the model types. The same model can often be used for several types by alternative logic within the model. Also, differences in saturation representation might not result in significant model performance differences so model substitutions are often acceptable."@en;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "SynchronousMachineDetailed"@en;
                               rdfs:subClassOf cim:SynchronousMachineDynamics;
                               cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.SynchronousMachineDynamics";
                               cimdoc:packageTier "Normative".
cim:SynchronousMachineDetailed.efdBaseRatio a owl:DatatypeProperty;
                                            rdfs:comment "Ratio (exciter voltage/generator voltage) of Efd bases of exciter and generator models (> 0). Typical value = 1."@en;
                                            rdfs:domain cim:SynchronousMachineDetailed;
                                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                            rdfs:label "efdBaseRatio"@en;
                                            rdfs:range xsd:float.
cim:SynchronousMachineDetailed.ifdBaseType a owl:ObjectProperty;
                                           rdfs:comment "Excitation base system mode. It should be equal to the value of WLMDV given by the user. WLMDV is the PU ratio between the field voltage and the excitation current: Efd = WLMDV x Ifd. Typical value = ifag."@en;
                                           rdfs:domain cim:SynchronousMachineDetailed;
                                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                           rdfs:label "ifdBaseType"@en;
                                           rdfs:range cim:IfdBaseKind.
cim:SynchronousMachineDetailed.saturationFactor120QAxis a owl:DatatypeProperty;
                                                        rdfs:comment "Quadrature-axis saturation factor at 120% of rated terminal voltage (S12q) (>= SynchonousMachineDetailed.saturationFactorQAxis). Typical value = 0,12."@en;
                                                        rdfs:domain cim:SynchronousMachineDetailed;
                                                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                        rdfs:label "saturationFactor120QAxis"@en;
                                                        rdfs:range xsd:float.
cim:SynchronousMachineDetailed.saturationFactorQAxis a owl:DatatypeProperty;
                                                     rdfs:comment "Quadrature-axis saturation factor at rated terminal voltage (S1q) (>= 0). Typical value = 0,02."@en;
                                                     rdfs:domain cim:SynchronousMachineDetailed;
                                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                     rdfs:label "saturationFactorQAxis"@en;
                                                     rdfs:range xsd:float.
cim:SynchronousMachineDynamics a owl:Class;
                               rdfs:comment "Synchronous machine whose behaviour is described by reference to a standard model expressed in one of the following forms: - simplified (or classical), where a group of generators or motors is not modelled in detail; - detailed, in equivalent circuit form; - detailed, in time constant reactance form; or - by definition of a user-defined model. It is a common practice to represent small generators by a negative load rather than by a dynamic generator model when performing dynamics simulations. In this case, a SynchronousMachine in the static model is not represented by anything in the dynamics model, instead it is treated as an ordinary load. Parameter details: - Synchronous machine parameters such as Xl, Xd, Xp etc. are actually used as inductances in the models, but are commonly referred to as reactances since, at nominal frequency, the PU values are the same. However, some references use the symbol L instead of X."@en;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "SynchronousMachineDynamics"@en;
                               rdfs:subClassOf cim:RotatingMachineDynamics;
                               cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.SynchronousMachineDynamics";
                               cimdoc:packageTier "Normative".
cim:SynchronousMachineDynamics.SynchronousMachine a owl:ObjectProperty;
                                                  rdfs:comment "Synchronous machine to which synchronous machine dynamics model applies."@en;
                                                  rdfs:domain cim:SynchronousMachineDynamics;
                                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                  rdfs:label "SynchronousMachine"@en;
                                                  rdfs:range cim:SynchronousMachine.
cim:SynchronousMachineDynamics.TurbineGovernorDynamics a owl:ObjectProperty;
                                                       rdfs:comment "Turbine-governor model associated with this synchronous machine model. Multiplicity of greater than one is intended to support hydro units that have multiple turbines on one generator."@en;
                                                       rdfs:domain cim:SynchronousMachineDynamics;
                                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                       rdfs:label "TurbineGovernorDynamics"@en;
                                                       rdfs:range cim:TurbineGovernorDynamics.
cim:SynchronousMachineEquivalentCircuit a owl:Class;
                                        rdfs:comment """The electrical equations for all variations of the synchronous models are based on the SynchronousEquivalentCircuit diagram for the direct- and quadrature- axes. Equations for conversion between equivalent circuit and time constant reactance forms: Xd = Xad + Xl X�d = Xl + Xad x Xfd / (Xad + Xfd) X�d = Xl + Xad x Xfd x X1d / (Xad x Xfd + Xad x X1d + Xfd x X1d) Xq = Xaq + Xl X�q = Xl + Xaq x X1q / (Xaq + X1q) X�q = Xl + Xaq x X1q x X2q / (Xaq x X1q + Xaq x X2q + X1q x X2q) T�do = (Xad + Xfd) / (omega0 x Rfd) T�do = (Xad x Xfd + Xad x X1d + Xfd x X1d) / (omega0 x R1d x (Xad + Xfd) T�qo = (Xaq + X1q) / (omega0 x R1q) T�qo = (Xaq x X1q + Xaq x X2q + X1q x X2q) / (omega0 x R2q x (Xaq + X1q) Same equations using CIM attributes from SynchronousMachineTimeConstantReactance class on left of \"=\" and SynchronousMachineEquivalentCircuit class on right (except as noted): xDirectSync = xad + RotatingMachineDynamics.statorLeakageReactance xDirectTrans = RotatingMachineDynamics.statorLeakageReactance + xad x xfd / (xad + xfd) xDirectSubtrans = RotatingMachineDynamics.statorLeakageReactance + xad x xfd x x1d / (xad x xfd + xad x x1d + xfd x x1d) xQuadSync = xaq + RotatingMachineDynamics.statorLeakageReactance xQuadTrans = RotatingMachineDynamics.statorLeakageReactance + xaq x x1q / (xaq+ x1q) xQuadSubtrans = RotatingMachineDynamics.statorLeakageReactance + xaq x x1q x x2q / (xaq x x1q + xaq x x2q + x1q x x2q) tpdo = (xad + xfd) / (2 x pi x nominal frequency x rfd) tppdo = (xad x xfd + xad x x1d + xfd x x1d) / (2 x pi x nominal frequency x r1d x (xad + xfd) tpqo = (xaq + x1q) / (2 x pi x nominal frequency x r1q) tppqo = (xaq x x1q + xaq x x2q + x1q x x2q) / (2 x pi x nominal frequency x r2q x (xaq + x1q) These are only valid for a simplified model where \"Canay\" reactance is zero."""@en;
                                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                        rdfs:label "SynchronousMachineEquivalentCircuit"@en;
                                        rdfs:subClassOf cim:SynchronousMachineDetailed;
                                        cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.SynchronousMachineDynamics";
                                        cimdoc:packageTier "Normative".
cim:SynchronousMachineEquivalentCircuit.r1d a owl:DatatypeProperty;
                                            rdfs:comment "Direct-axis damper 1 winding resistance."@en;
                                            rdfs:domain cim:SynchronousMachineEquivalentCircuit;
                                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                            rdfs:label "r1d"@en;
                                            rdfs:range cim:PU.
cim:SynchronousMachineEquivalentCircuit.r1q a owl:DatatypeProperty;
                                            rdfs:comment "Quadrature-axis damper 1 winding resistance."@en;
                                            rdfs:domain cim:SynchronousMachineEquivalentCircuit;
                                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                            rdfs:label "r1q"@en;
                                            rdfs:range cim:PU.
cim:SynchronousMachineEquivalentCircuit.r2q a owl:DatatypeProperty;
                                            rdfs:comment "Quadrature-axis damper 2 winding resistance."@en;
                                            rdfs:domain cim:SynchronousMachineEquivalentCircuit;
                                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                            rdfs:label "r2q"@en;
                                            rdfs:range cim:PU.
cim:SynchronousMachineEquivalentCircuit.rfd a owl:DatatypeProperty;
