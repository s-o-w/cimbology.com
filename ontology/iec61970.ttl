                rdfs:comment "Neutral phase."@en;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "N"@en;
                cimdoc:enumCode 16 .
cim:PhaseCode.X a owl:NamedIndividual,
                  cim:PhaseCode;
                rdfs:comment "Unknown non-neutral phase."@en;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "X"@en;
                cimdoc:enumCode 1024 .
cim:PhaseCode.XN a owl:NamedIndividual,
                   cim:PhaseCode;
                 rdfs:comment "Unknown non-neutral phase plus neutral."@en;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "XN"@en;
                 cimdoc:enumCode 1040 .
cim:PhaseCode.XY a owl:NamedIndividual,
                   cim:PhaseCode;
                 rdfs:comment "Two unknown non-neutral phases."@en;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "XY"@en;
                 cimdoc:enumCode 3072 .
cim:PhaseCode.XYN a owl:NamedIndividual,
                    cim:PhaseCode;
                  rdfs:comment "Two unknown non-neutral phases plus neutral."@en;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "XYN"@en;
                  cimdoc:enumCode 3088 .
cim:PhaseCode.none a owl:NamedIndividual,
                     cim:PhaseCode;
                   rdfs:comment "No phases specified."@en;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "none"@en;
                   cimdoc:enumCode 0 .
cim:PhaseCode.s1 a owl:NamedIndividual,
                   cim:PhaseCode;
                 rdfs:comment "Secondary phase 1."@en;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "s1"@en;
                 cimdoc:enumCode 512 .
cim:PhaseCode.s12 a owl:NamedIndividual,
                    cim:PhaseCode;
                  rdfs:comment "Secondary phase 1 and 2."@en;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "s12"@en;
                  cimdoc:enumCode 768 .
cim:PhaseCode.s12N a owl:NamedIndividual,
                     cim:PhaseCode;
                   rdfs:comment "Secondary phases 1, 2, and neutral."@en;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "s12N"@en;
                   cimdoc:enumCode 784 .
cim:PhaseCode.s1N a owl:NamedIndividual,
                    cim:PhaseCode;
                  rdfs:comment "Secondary phase 1 and neutral."@en;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "s1N"@en;
                  cimdoc:enumCode 528 .
cim:PhaseCode.s2 a owl:NamedIndividual,
                   cim:PhaseCode;
                 rdfs:comment "Secondary phase 2."@en;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "s2"@en;
                 cimdoc:enumCode 256 .
cim:PhaseCode.s2N a owl:NamedIndividual,
                    cim:PhaseCode;
                  rdfs:comment "Secondary phase 2 and neutral."@en;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "s2N"@en;
                  cimdoc:enumCode 272 .
cim:PhaseConnectedFaultKind a owl:Class;
                            rdfs:comment "The type of fault connection among phases."@en;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "PhaseConnectedFaultKind"@en;
                            owl:equivalentClass [a owl:Class ; 
                                                 owl:oneOf (cim:PhaseConnectedFaultKind.lineOpen
                                                            cim:PhaseConnectedFaultKind.lineToGround
                                                            cim:PhaseConnectedFaultKind.lineToLine
                                                            cim:PhaseConnectedFaultKind.lineToLineToGround)];
                            cimdoc:cimPackage "IEC61970.Base.Faults";
                            cimdoc:packageTier "Normative".
cim:PhaseConnectedFaultKind.lineOpen a owl:NamedIndividual,
                                       cim:PhaseConnectedFaultKind;
                                     rdfs:comment "The fault is when the conductor path is broken between two terminals. Additional coexisting faults may be required if the broken conductor also causes connections to grounds or other lines or phases."@en;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                     rdfs:label "lineOpen"@en;
                                     cimdoc:enumCode 3 .
cim:PhaseConnectedFaultKind.lineToGround a owl:NamedIndividual,
                                           cim:PhaseConnectedFaultKind;
                                         rdfs:comment "The fault connects the indicated phases to ground. The line to line fault impedance is not used and assumed infinite. The full ground impedance is connected between each phase specified in the fault and ground, but not between the phases."@en;
                                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                         rdfs:label "lineToGround"@en;
                                         cimdoc:enumCode 0 .
cim:PhaseConnectedFaultKind.lineToLine a owl:NamedIndividual,
                                         cim:PhaseConnectedFaultKind;
                                       rdfs:comment "The fault connects the specified phases together without a connection to ground. The ground impedance of this fault is ignored. The line to line impedance is connected between each of the phases specified in the fault. For example three times for a three phase fault, one time for a two phase fault. A single phase fault should not be specified."@en;
                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                       rdfs:label "lineToLine"@en;
                                       cimdoc:enumCode 1 .
cim:PhaseConnectedFaultKind.lineToLineToGround a owl:NamedIndividual,
                                                 cim:PhaseConnectedFaultKind;
                                               rdfs:comment "The fault connects the indicated phases to ground and to each other. The line to line impedance is connected between each of the phases specified in the fault in a full mesh. For example three times for a three phase fault, one time for a two phase fault. A single phase fault should not be specified. The full ground impedance is connected between each phase specified in the fault and ground."@en;
                                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                               rdfs:label "lineToLineToGround"@en;
                                               cimdoc:enumCode 2 .
cim:PhaseImpedanceData a owl:Class;
                       rdfs:comment "Impedance and conductance matrix element values. The diagonal elements are described by the elements having the same toPhase and fromPhase value and the off diagonal elements have different toPhase and fromPhase values. The matrix can also be stored in symmetric lower triangular format using the row and column attributes, which map to ACLineSegmentPhase. sequenceNumber."@en;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "PhaseImpedanceData"@en;
                       cimdoc:cimPackage "IEC61970.Base.Wires";
                       cimdoc:packageTier "Normative".
cim:PhaseImpedanceData.b a owl:DatatypeProperty;
                         rdfs:comment "Susceptance matrix element value, per length of unit."@en;
                         rdfs:domain cim:PhaseImpedanceData;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                         rdfs:label "b"@en;
                         rdfs:range cim:SusceptancePerLength.
cim:PhaseImpedanceData.column a owl:DatatypeProperty;
                              rdfs:comment "The matrix element's column number, in the range 1 to row. Only the lower triangle needs to be stored. This column number matches ACLineSegmentPhase. sequenceNumber."@en;
                              rdfs:domain cim:PhaseImpedanceData;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "column"@en;
                              rdfs:range xsd:integer.
cim:PhaseImpedanceData.fromPhase a owl:ObjectProperty;
                                 rdfs:comment "Refer to the class description."@en;
                                 rdfs:domain cim:PhaseImpedanceData;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "fromPhase"@en;
                                 rdfs:range cim:SinglePhaseKind.
cim:PhaseImpedanceData.g a owl:DatatypeProperty;
                         rdfs:comment "Conductance matrix element value, per length of unit."@en;
                         rdfs:domain cim:PhaseImpedanceData;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                         rdfs:label "g"@en;
                         rdfs:range cim:ConductancePerLength.
cim:PhaseImpedanceData.r a owl:DatatypeProperty;
                         rdfs:comment "Resistance matrix element value, per length of unit."@en;
                         rdfs:domain cim:PhaseImpedanceData;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                         rdfs:label "r"@en;
                         rdfs:range cim:ResistancePerLength.
cim:PhaseImpedanceData.row a owl:DatatypeProperty;
                           rdfs:comment "The matrix element�s row number, in the range 1 to PerLengthPhaseImpedance. conductorCount. Only the lower triangle needs to be stored. This row number matches ACLineSegmentPhase.sequenceNumber."@en;
                           rdfs:domain cim:PhaseImpedanceData;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "row"@en;
                           rdfs:range xsd:integer.
cim:PhaseImpedanceData.toPhase a owl:ObjectProperty;
                               rdfs:comment "Refer to the class description."@en;
                               rdfs:domain cim:PhaseImpedanceData;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "toPhase"@en;
                               rdfs:range cim:SinglePhaseKind.
cim:PhaseImpedanceData.x a owl:DatatypeProperty;
                         rdfs:comment "Reactance matrix element value, per length of unit."@en;
                         rdfs:domain cim:PhaseImpedanceData;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                         rdfs:label "x"@en;
                         rdfs:range cim:ReactancePerLength.
cim:PhaseShuntConnectionKind a owl:Class;
                             rdfs:comment "The configuration of phase connections for a single terminal device such as a load or capacitor."@en;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "PhaseShuntConnectionKind"@en;
                             owl:equivalentClass [a owl:Class ; 
                                                  owl:oneOf (cim:PhaseShuntConnectionKind.D
                                                             cim:PhaseShuntConnectionKind.G
                                                             cim:PhaseShuntConnectionKind.I
                                                             cim:PhaseShuntConnectionKind.Y
                                                             cim:PhaseShuntConnectionKind.Yn)];
                             cimdoc:cimPackage "IEC61970.Base.Wires";
                             cimdoc:packageTier "Normative".
cim:PhaseShuntConnectionKind.D a owl:NamedIndividual,
                                 cim:PhaseShuntConnectionKind;
                               rdfs:comment "Delta connection."@en;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "D"@en;
                               cimdoc:enumCode 1 .
cim:PhaseShuntConnectionKind.G a owl:NamedIndividual,
                                 cim:PhaseShuntConnectionKind;
                               rdfs:comment "Ground connection; use when explicit connection to ground needs to be expressed in combination with the phase code, such as for electrical wire/cable or for meters."@en;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "G"@en;
                               cimdoc:enumCode 5 .
cim:PhaseShuntConnectionKind.I a owl:NamedIndividual,
                                 cim:PhaseShuntConnectionKind;
                               rdfs:comment "Independent winding, for single-phase connections."@en;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "I"@en;
                               cimdoc:enumCode 4 .
cim:PhaseShuntConnectionKind.Y a owl:NamedIndividual,
                                 cim:PhaseShuntConnectionKind;
                               rdfs:comment "Wye connection."@en;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "Y"@en;
                               cimdoc:enumCode 2 .
cim:PhaseShuntConnectionKind.Yn a owl:NamedIndividual,
                                  cim:PhaseShuntConnectionKind;
                                rdfs:comment "Wye, with neutral brought out for grounding."@en;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "Yn"@en;
                                cimdoc:enumCode 3 .
cim:PhaseTapChanger a owl:Class;
                    rdfs:comment "A transformer phase shifting tap model that controls the phase angle difference across the power transformer and potentially the active power flow through the power transformer. This phase tap model may also impact the voltage magnitude."@en;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "PhaseTapChanger"@en;
                    rdfs:subClassOf cim:TapChanger;
                    cimdoc:cimPackage "IEC61970.Base.Wires";
                    cimdoc:packageTier "Normative".
cim:PhaseTapChangerAsymmetrical a owl:Class;
                                rdfs:comment "Describes the tap model for an asymmetrical phase shifting transformer in which the difference voltage vector adds to the in-phase winding. The out-of-phase winding is the transformer end where the tap changer is located. The angle between the in-phase and out-of-phase windings is named the winding connection angle. The phase shift depends on both the difference voltage magnitude and the winding connection angle."@en;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "PhaseTapChangerAsymmetrical"@en;
                                rdfs:subClassOf cim:PhaseTapChangerNonLinear;
                                cimdoc:cimPackage "IEC61970.Base.Wires";
                                cimdoc:packageTier "Normative".
cim:PhaseTapChangerAsymmetrical.windingConnectionAngle a owl:DatatypeProperty;
                                                       rdfs:comment "The phase angle between the in-phase winding and the out-of -phase winding used for creating phase shift. The out-of-phase winding produces what is known as the difference voltage. Setting this angle to 90 degrees is not the same as a symmetrical transformer. The attribute can only be multiples of 30 degrees. The allowed range is -150 degrees to 150 degrees excluding 0."@en;
                                                       rdfs:domain cim:PhaseTapChangerAsymmetrical;
                                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                       rdfs:label "windingConnectionAngle"@en;
                                                       rdfs:range cim:AngleDegrees.
cim:PhaseTapChangerLinear a owl:Class;
                          rdfs:comment "Describes a tap changer with a linear relation between the tap step and the phase angle difference across the transformer. This is a mathematical model that is an approximation of a real phase tap changer. The phase angle is computed as stepPhaseShiftIncrement times the tap position. The voltage magnitude of both sides is the same."@en;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                          rdfs:label "PhaseTapChangerLinear"@en;
                          rdfs:subClassOf cim:PhaseTapChanger;
                          cimdoc:cimPackage "IEC61970.Base.Wires";
                          cimdoc:packageTier "Normative".
cim:PhaseTapChangerLinear.stepPhaseShiftIncrement a owl:DatatypeProperty;
                                                  rdfs:comment "Phase shift per step position. A positive value indicates a positive angle variation from the Terminal at the PowerTransformerEnd, where the TapChanger is located, into the transformer. The actual phase shift increment might be more accurately computed from the symmetrical or asymmetrical models or a tap step table lookup if those are available."@en;
                                                  rdfs:domain cim:PhaseTapChangerLinear;
                                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                  rdfs:label "stepPhaseShiftIncrement"@en;
                                                  rdfs:range cim:AngleDegrees.
cim:PhaseTapChangerLinear.xMax a owl:DatatypeProperty;
                               rdfs:comment """The reactance depends on the tap position according to a \"u\" shaped curve. The maximum reactance (xMax) appears at the low and high tap positions. Depending on the �u� curve the attribute can be either higher or lower than PowerTransformerEnd.x."""@en;
                               rdfs:domain cim:PhaseTapChangerLinear;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "xMax"@en;
                               rdfs:range cim:Reactance.
cim:PhaseTapChangerLinear.xMin a owl:DatatypeProperty;
                               rdfs:comment """The reactance depends on the tap position according to a \"u\" shaped curve. The minimum reactance (xMin) appears at the mid tap position. PowerTransformerEnd. x shall be consistent with PhaseTapChangerLinear.xMin and PhaseTapChangerNonLinear.xMin. In case of inconsistency, PowerTransformerEnd.x shall be used."""@en;
                               rdfs:domain cim:PhaseTapChangerLinear;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "xMin"@en;
                               rdfs:range cim:Reactance.
cim:PhaseTapChangerNonLinear a owl:Class;
                             rdfs:comment "The non-linear phase tap changer describes the non-linear behaviour of a phase tap changer. This is a base class for the symmetrical and asymmetrical phase tap changer models. The details of these models can be found in IEC 61970-301."@en;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "PhaseTapChangerNonLinear"@en;
                             rdfs:subClassOf cim:PhaseTapChanger;
                             cimdoc:cimPackage "IEC61970.Base.Wires";
                             cimdoc:packageTier "Normative".
cim:PhaseTapChangerNonLinear.voltageStepIncrement a owl:DatatypeProperty;
                                                  rdfs:comment "The voltage step increment on the out of phase winding (the PowerTransformerEnd where the TapChanger is located) specified in percent of rated voltage of the PowerTransformerEnd. A positive value means a positive voltage variation from the Terminal at the PowerTransformerEnd, where the TapChanger is located, into the transformer. When the increment is negative, the voltage decreases when the tap step increases."@en;
                                                  rdfs:domain cim:PhaseTapChangerNonLinear;
                                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                  rdfs:label "voltageStepIncrement"@en;
                                                  rdfs:range cim:PerCent.
cim:PhaseTapChangerNonLinear.xMax a owl:DatatypeProperty;
                                  rdfs:comment """The reactance depends on the tap position according to a \"u\" shaped curve. The maximum reactance (xMax) appears at the low and high tap positions. Depending on the �u� curve the attribute can be either higher or lower than PowerTransformerEnd.x."""@en;
                                  rdfs:domain cim:PhaseTapChangerNonLinear;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "xMax"@en;
                                  rdfs:range cim:Reactance.
cim:PhaseTapChangerNonLinear.xMin a owl:DatatypeProperty;
                                  rdfs:comment """The reactance depend on the tap position according to a \"u\" shaped curve. The minimum reactance (xMin) appear at the mid tap position. PowerTransformerEnd. x shall be consistent with PhaseTapChangerLinear.xMin and PhaseTapChangerNonLinear.xMin. In case of inconsistency, PowerTransformerEnd.x shall be used."""@en;
                                  rdfs:domain cim:PhaseTapChangerNonLinear;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "xMin"@en;
                                  rdfs:range cim:Reactance.
cim:PhaseTapChangerSymmetrical a owl:Class;
                               rdfs:comment "Describes a symmetrical phase shifting transformer tap model in which the voltage magnitude of both sides is the same. The difference voltage magnitude is the base in an equal-sided triangle where the sides corresponds to the primary and secondary voltages. The phase angle difference corresponds to the top angle and can be expressed as twice the arctangent of half the total difference voltage."@en;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "PhaseTapChangerSymmetrical"@en;
                               rdfs:subClassOf cim:PhaseTapChangerNonLinear;
                               cimdoc:cimPackage "IEC61970.Base.Wires";
                               cimdoc:packageTier "Normative".
cim:PhaseTapChangerTable a owl:Class;
                         rdfs:comment "Describes a tabular curve for how the phase angle difference and impedance varies with the tap step."@en;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                         rdfs:label "PhaseTapChangerTable"@en;
                         rdfs:subClassOf cim:IdentifiedObject;
                         cimdoc:cimPackage "IEC61970.Base.Wires";
                         cimdoc:packageTier "Normative".
cim:PhaseTapChangerTable.PhaseTapChangerTabular a owl:ObjectProperty;
                                                rdfs:comment "The phase tap changers to which this phase tap table applies."@en;
                                                rdfs:domain cim:PhaseTapChangerTable;
                                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                rdfs:label "PhaseTapChangerTabular"@en;
                                                rdfs:range cim:PhaseTapChangerTabular.
cim:PhaseTapChangerTablePoint a owl:Class;
                              rdfs:comment "Describes each tap step in the phase tap changer tabular curve."@en;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "PhaseTapChangerTablePoint"@en;
                              rdfs:subClassOf cim:TapChangerTablePoint;
                              cimdoc:cimPackage "IEC61970.Base.Wires";
                              cimdoc:packageTier "Normative".
cim:PhaseTapChangerTablePoint.PhaseTapChangerTable a owl:ObjectProperty;
                                                   rdfs:comment "The table of this point."@en;
                                                   rdfs:domain cim:PhaseTapChangerTablePoint;
                                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                   rdfs:label "PhaseTapChangerTable"@en;
                                                   rdfs:range cim:PhaseTapChangerTable.
cim:PhaseTapChangerTablePoint.angle a owl:DatatypeProperty;
                                    rdfs:comment "The angle difference in degrees. A positive value indicates a positive angle variation from the Terminal at the PowerTransformerEnd, where the TapChanger is located, into the transformer."@en;
                                    rdfs:domain cim:PhaseTapChangerTablePoint;
                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                    rdfs:label "angle"@en;
                                    rdfs:range cim:AngleDegrees.
cim:PhaseTapChangerTabular a owl:Class;
                           rdfs:comment "Describes a tap changer with a table defining the relation between the tap step and the phase angle difference across the transformer."@en;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "PhaseTapChangerTabular"@en;
                           rdfs:subClassOf cim:PhaseTapChanger;
                           cimdoc:cimPackage "IEC61970.Base.Wires";
                           cimdoc:packageTier "Normative".
cim:PhotoVoltaicUnit a owl:Class;
                     rdfs:comment "A photovoltaic device or an aggregation of such devices."@en;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                     rdfs:label "PhotoVoltaicUnit"@en;
                     rdfs:subClassOf cim:PowerElectronicsUnit;
                     cimdoc:cimPackage "IEC61970.Base.Generation.Production";
                     cimdoc:packageTier "Normative".
cim:PinBranchGroup a owl:Class;
                   rdfs:comment "Value associated with branch group is used as compare."@en;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "PinBranchGroup"@en;
                   rdfs:subClassOf cim:GateInputPin;
                   cimdoc:cimPackage "IEC61970.InfIEC61970.InfSIPS";
                   cimdoc:packageTier "Informative".
cim:PinBranchGroup.BranchGroup a owl:ObjectProperty;
                               rdfs:comment "The branch group that should be used in compare."@en;
                               rdfs:domain cim:PinBranchGroup;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "BranchGroup"@en;
                               rdfs:range cim:BranchGroup.
cim:PinBranchGroup.kind a owl:ObjectProperty;
                        rdfs:comment "The compare operation done on the branch group."@en;
                        rdfs:domain cim:PinBranchGroup;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                        rdfs:label "kind"@en;
                        rdfs:range cim:PinBranchGroupKind.
cim:PinBranchGroupKind a owl:Class;
                       rdfs:comment "Categorisation of type of compare done on a branch group."@en;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "PinBranchGroupKind"@en;
                       owl:equivalentClass [a owl:Class ; 
                                            owl:oneOf (cim:PinBranchGroupKind.activePower
                                                       cim:PinBranchGroupKind.reactivePower)];
                       cimdoc:cimPackage "IEC61970.InfIEC61970.InfSIPS";
                       cimdoc:packageTier "Informative".
cim:PinBranchGroupKind.activePower a owl:NamedIndividual,
                                     cim:PinBranchGroupKind;
                                   rdfs:comment "Active power in the branch group."@en;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                   rdfs:label "activePower"@en;
                                   cimdoc:enumCode 0 .
cim:PinBranchGroupKind.reactivePower a owl:NamedIndividual,
                                       cim:PinBranchGroupKind;
                                     rdfs:comment "Reactive power in the branch group."@en;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                     rdfs:label "reactivePower"@en;
                                     cimdoc:enumCode 1 .
cim:PinEquipment a owl:Class;
                 rdfs:comment "Value associated with Equipment is used as compare."@en;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "PinEquipment"@en;
                 rdfs:subClassOf cim:GateInputPin;
                 cimdoc:cimPackage "IEC61970.InfIEC61970.InfSIPS";
                 cimdoc:packageTier "Informative".
cim:PinEquipment.Equipment a owl:ObjectProperty;
                           rdfs:comment "The Equipment that should be used in compare."@en;
                           rdfs:domain cim:PinEquipment;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "Equipment"@en;
                           rdfs:range cim:Equipment.
cim:PinEquipment.kind a owl:ObjectProperty;
                      rdfs:comment "The compare operation done on the equipment."@en;
                      rdfs:domain cim:PinEquipment;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "kind"@en;
                      rdfs:range cim:PinEquipmentKind.
cim:PinEquipmentKind a owl:Class;
                     rdfs:comment "Categorisation of type of compare done on Equipment."@en;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                     rdfs:label "PinEquipmentKind"@en;
                     owl:equivalentClass [a owl:Class ; 
                                          owl:oneOf (cim:PinEquipmentKind.activePowerLimit
                                                     cim:PinEquipmentKind.apparentPowerLimit
                                                     cim:PinEquipmentKind.connected
                                                     cim:PinEquipmentKind.currentLimit
                                                     cim:PinEquipmentKind.inService
                                                     cim:PinEquipmentKind.ratedCurrent
                                                     cim:PinEquipmentKind.voltageLimit)];
                     cimdoc:cimPackage "IEC61970.InfIEC61970.InfSIPS";
                     cimdoc:packageTier "Informative".
cim:PinEquipmentKind.activePowerLimit a owl:NamedIndividual,
                                        cim:PinEquipmentKind;
                                      rdfs:comment "Compare load flow result against the active limit for active power for the given equipment."@en;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                      rdfs:label "activePowerLimit"@en;
                                      cimdoc:enumCode 4 .
cim:PinEquipmentKind.apparentPowerLimit a owl:NamedIndividual,
                                          cim:PinEquipmentKind;
                                        rdfs:comment "Compare load flow result against the active limit for apparent power for the given equipment."@en;
                                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                        rdfs:label "apparentPowerLimit"@en;
                                        cimdoc:enumCode 5 .
cim:PinEquipmentKind.connected a owl:NamedIndividual,
                                 cim:PinEquipmentKind;
                               rdfs:comment "Check if all terminal on the equipment is connected."@en;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "connected"@en;
                               cimdoc:enumCode 6 .
cim:PinEquipmentKind.currentLimit a owl:NamedIndividual,
                                    cim:PinEquipmentKind;
                                  rdfs:comment "Compare load flow result against the active current limit for the equipment."@en;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "currentLimit"@en;
                                  cimdoc:enumCode 3 .
cim:PinEquipmentKind.inService a owl:NamedIndividual,
                                 cim:PinEquipmentKind;
                               rdfs:comment "Check if equipment is in service, True if in service otherwise false."@en;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "inService"@en;
                               cimdoc:enumCode 0 .
cim:PinEquipmentKind.ratedCurrent a owl:NamedIndividual,
                                    cim:PinEquipmentKind;
                                  rdfs:comment "Compare load flow result against rated current on the equipment (switch)."@en;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "ratedCurrent"@en;
                                  cimdoc:enumCode 1 .
cim:PinEquipmentKind.voltageLimit a owl:NamedIndividual,
                                    cim:PinEquipmentKind;
                                  rdfs:comment "Compare load flow result against the active voltage limit for the equipment."@en;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "voltageLimit"@en;
                                  cimdoc:enumCode 2 .
cim:PinGate a owl:Class;
            rdfs:comment "An output from one gate represent an input to another gate."@en;
            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
            rdfs:label "PinGate"@en;
            rdfs:subClassOf cim:GateInputPin;
            cimdoc:cimPackage "IEC61970.InfIEC61970.InfSIPS";
            cimdoc:packageTier "Informative".
cim:PinMeasurement a owl:Class;
                   rdfs:comment "Gate input pin that is associated with a Measurement or a calculation of Measurement."@en;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "PinMeasurement"@en;
                   rdfs:subClassOf cim:GateInputPin;
                   cimdoc:cimPackage "IEC61970.InfIEC61970.InfSIPS";
                   cimdoc:packageTier "Informative".
cim:PinMeasurement.Measurement a owl:ObjectProperty;
                               rdfs:comment "The Measurement that should be used in compare."@en;
                               rdfs:domain cim:PinMeasurement;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "Measurement"@en;
                               rdfs:range cim:Measurement.
cim:PinTerminal a owl:Class;
                rdfs:comment "Value associated with Terminal is used as compare."@en;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "PinTerminal"@en;
                rdfs:subClassOf cim:GateInputPin;
                cimdoc:cimPackage "IEC61970.InfIEC61970.InfSIPS";
                cimdoc:packageTier "Informative".
cim:PinTerminal.Terminal a owl:ObjectProperty;
                         rdfs:comment "The Terminal that should be used in compare."@en;
                         rdfs:domain cim:PinTerminal;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                         rdfs:label "Terminal"@en;
                         rdfs:range cim:Terminal.
cim:PinTerminal.kind a owl:ObjectProperty;
                     rdfs:comment "The compare operation done on the terminal."@en;
                     rdfs:domain cim:PinTerminal;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                     rdfs:label "kind"@en;
                     rdfs:range cim:PinTerminalKind.
cim:PinTerminalKind a owl:Class;
                    rdfs:comment "Categorisation of type of compare done on Terminal."@en;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "PinTerminalKind"@en;
                    owl:equivalentClass [a owl:Class ; 
                                         owl:oneOf (cim:PinTerminalKind.activePower
                                                    cim:PinTerminalKind.apparentPower
                                                    cim:PinTerminalKind.reactivePower
                                                    cim:PinTerminalKind.voltage)];
                    cimdoc:cimPackage "IEC61970.InfIEC61970.InfSIPS";
                    cimdoc:packageTier "Informative".
cim:PinTerminalKind.activePower a owl:NamedIndividual,
                                  cim:PinTerminalKind;
                                rdfs:comment "Active Power on the Terminal."@en;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "activePower"@en;
                                cimdoc:enumCode 0 .
cim:PinTerminalKind.apparentPower a owl:NamedIndividual,
                                    cim:PinTerminalKind;
                                  rdfs:comment "Apparent Power on the Terminal."@en;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "apparentPower"@en;
                                  cimdoc:enumCode 1 .
cim:PinTerminalKind.reactivePower a owl:NamedIndividual,
                                    cim:PinTerminalKind;
                                  rdfs:comment "Reactive Power on the Terminal."@en;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "reactivePower"@en;
                                  cimdoc:enumCode 2 .
cim:PinTerminalKind.voltage a owl:NamedIndividual,
                              cim:PinTerminalKind;
                            rdfs:comment "Voltage on the Terminal."@en;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "voltage"@en;
                            cimdoc:enumCode 3 .
cim:Plant a owl:Class;
          rdfs:comment "A Plant is a collection of equipment for purposes of generation."@en;
          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
          rdfs:label "Plant"@en;
          rdfs:subClassOf cim:EquipmentContainer;
          cimdoc:cimPackage "IEC61970.Base.Wires";
          cimdoc:packageTier "Normative".
cim:PostLineSensor a owl:Class;
                   rdfs:comment "A sensor used mainly in overhead distribution networks as the source of both current and voltage measurements."@en;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "PostLineSensor"@en;
                   rdfs:subClassOf cim:Sensor;
                   cimdoc:cimPackage "IEC61970.Base.AuxiliaryEquipment";
                   cimdoc:packageTier "Normative".
cim:PotentialTransformer a owl:Class;
                         rdfs:comment "Instrument transformer (also known as Voltage Transformer) used to measure electrical qualities of the circuit that is being protected and/or monitored. Typically used as voltage transducer for the purpose of metering, protection, or sometimes auxiliary substation supply. A typical secondary voltage rating would be 120V."@en;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                         rdfs:label "PotentialTransformer"@en;
                         rdfs:subClassOf cim:Sensor;
                         cimdoc:cimPackage "IEC61970.Base.AuxiliaryEquipment";
                         cimdoc:packageTier "Normative".
cim:PotentialTransformer.accuracyClass a owl:DatatypeProperty;
                                       rdfs:comment "PT accuracy classification."@en;
                                       rdfs:domain cim:PotentialTransformer;
                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                       rdfs:label "accuracyClass"@en;
                                       rdfs:range xsd:string.
cim:PotentialTransformer.nominalRatio a owl:DatatypeProperty;
                                      rdfs:comment "Nominal ratio between the primary and secondary voltage."@en;
                                      rdfs:domain cim:PotentialTransformer;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                      rdfs:label "nominalRatio"@en;
                                      rdfs:range xsd:float.
cim:PotentialTransformer.ptClass a owl:DatatypeProperty;
                                 rdfs:comment "Potential transformer (PT) classification covering burden."@en;
                                 rdfs:domain cim:PotentialTransformer;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "ptClass"@en;
                                 rdfs:range xsd:string.
cim:PotentialTransformer.type a owl:ObjectProperty;
                              rdfs:comment "Potential transformer construction type."@en;
                              rdfs:domain cim:PotentialTransformer;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "type"@en;
                              rdfs:range cim:PotentialTransformerKind.
cim:PotentialTransformerKind a owl:Class;
                             rdfs:comment "The construction kind of the potential transformer."@en;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "PotentialTransformerKind"@en;
                             owl:equivalentClass [a owl:Class ; 
                                                  owl:oneOf (cim:PotentialTransformerKind.capacitiveCoupling
                                                             cim:PotentialTransformerKind.inductive)];
                             cimdoc:cimPackage "IEC61970.Base.AuxiliaryEquipment";
                             cimdoc:packageTier "Normative".
cim:PotentialTransformerKind.capacitiveCoupling a owl:NamedIndividual,
                                                  cim:PotentialTransformerKind;
                                                rdfs:comment "The potential transformer is using capacitive coupling to create secondary voltage."@en;
                                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                rdfs:label "capacitiveCoupling"@en;
                                                cimdoc:enumCode 1 .
cim:PotentialTransformerKind.inductive a owl:NamedIndividual,
                                         cim:PotentialTransformerKind;
                                       rdfs:comment "The potential transformer is using induction coils to create secondary voltage."@en;
                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                       rdfs:label "inductive"@en;
                                       cimdoc:enumCode 0 .
cim:PowerCutZone a owl:Class;
                 rdfs:comment "An area or zone of the power system which is used for load shedding purposes."@en;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "PowerCutZone"@en;
                 rdfs:subClassOf cim:PowerSystemResource;
                 cimdoc:cimPackage "IEC61970.Base.LoadModel";
                 cimdoc:packageTier "Normative".
cim:PowerCutZone.EnergyConsumers a owl:ObjectProperty;
                                 rdfs:comment "Energy consumer is assigned to the power cut zone."@en;
                                 rdfs:domain cim:PowerCutZone;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "EnergyConsumers"@en;
                                 rdfs:range cim:EnergyConsumer.
cim:PowerCutZone.cutLevel1 a owl:DatatypeProperty;
                           rdfs:comment "First level (amount) of load to cut as a percentage of total zone load."@en;
                           rdfs:domain cim:PowerCutZone;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "cutLevel1"@en;
                           rdfs:range cim:PerCent.
cim:PowerCutZone.cutLevel2 a owl:DatatypeProperty;
                           rdfs:comment "Second level (amount) of load to cut as a percentage of total zone load."@en;
                           rdfs:domain cim:PowerCutZone;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "cutLevel2"@en;
                           rdfs:range cim:PerCent.
cim:PowerElectronicsConnection a owl:Class;
                               rdfs:comment "A connection to the AC network for energy production or consumption that uses power electronics rather than rotating machines."@en;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "PowerElectronicsConnection"@en;
                               rdfs:subClassOf cim:RegulatingCondEq;
                               cimdoc:cimPackage "IEC61970.Base.Wires";
                               cimdoc:packageTier "Normative".
cim:PowerElectronicsConnection.PowerElectronicsConnectionPhase a owl:ObjectProperty;
                                                               rdfs:comment "The individual phases models for the power electronics connection."@en;
                                                               rdfs:domain cim:PowerElectronicsConnection;
                                                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                               rdfs:label "PowerElectronicsConnectionPhase"@en;
                                                               rdfs:range cim:PowerElectronicsConnectionPhase.
cim:PowerElectronicsConnection.PowerElectronicsUnit a owl:ObjectProperty;
                                                    rdfs:comment "An AC network connection may have several power electronics units connecting through it."@en;
                                                    rdfs:domain cim:PowerElectronicsConnection;
                                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                    rdfs:label "PowerElectronicsUnit"@en;
                                                    rdfs:range cim:PowerElectronicsUnit.
cim:PowerElectronicsConnection.maxIFault a owl:DatatypeProperty;
                                         rdfs:comment "Maximum fault current this device will contribute, in per-unit of rated current, before the converter protection will trip or bypass."@en;
                                         rdfs:domain cim:PowerElectronicsConnection;
                                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                         rdfs:label "maxIFault"@en;
                                         rdfs:range cim:PU.
cim:PowerElectronicsConnection.maxQ a owl:DatatypeProperty;
                                    rdfs:comment "Maximum reactive power limit. This is the maximum (nameplate) limit for the unit."@en;
                                    rdfs:domain cim:PowerElectronicsConnection;
                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                    rdfs:label "maxQ"@en;
                                    rdfs:range cim:ReactivePower.
cim:PowerElectronicsConnection.minQ a owl:DatatypeProperty;
                                    rdfs:comment "Minimum reactive power limit for the unit. This is the minimum (nameplate) limit for the unit."@en;
                                    rdfs:domain cim:PowerElectronicsConnection;
                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                    rdfs:label "minQ"@en;
                                    rdfs:range cim:ReactivePower.
cim:PowerElectronicsConnection.p a owl:DatatypeProperty;
                                 rdfs:comment "Active power injection. Load sign convention is used, i.e. positive sign means flow out from a node. Starting value for a steady state solution."@en;
                                 rdfs:domain cim:PowerElectronicsConnection;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "p"@en;
                                 rdfs:range cim:ActivePower.
cim:PowerElectronicsConnection.q a owl:DatatypeProperty;
                                 rdfs:comment "Reactive power injection. Load sign convention is used, i.e. positive sign means flow out from a node. Starting value for a steady state solution."@en;
                                 rdfs:domain cim:PowerElectronicsConnection;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "q"@en;
                                 rdfs:range cim:ReactivePower.
cim:PowerElectronicsConnection.r a owl:DatatypeProperty;
                                 rdfs:comment "Equivalent resistance (RG) of generator. RG is considered for the calculation of all currents, except for the calculation of the peak current ip. Used for short circuit data exchange according to IEC 60909."@en;
                                 rdfs:domain cim:PowerElectronicsConnection;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "r"@en;
                                 rdfs:range cim:Resistance.
cim:PowerElectronicsConnection.r0 a owl:DatatypeProperty;
                                  rdfs:comment "Zero sequence resistance of the synchronous machine."@en;
                                  rdfs:domain cim:PowerElectronicsConnection;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "r0"@en;
                                  rdfs:range cim:Resistance.
cim:PowerElectronicsConnection.ratedS a owl:DatatypeProperty;
                                      rdfs:comment "Nameplate apparent power rating for the unit. The attribute shall have a positive value."@en;
                                      rdfs:domain cim:PowerElectronicsConnection;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                      rdfs:label "ratedS"@en;
                                      rdfs:range cim:ApparentPower.
cim:PowerElectronicsConnection.ratedU a owl:DatatypeProperty;
                                      rdfs:comment "Rated voltage (nameplate data, Ur in IEC 60909-0). It is primarily used for short circuit data exchange according to IEC 60909. The attribute shall be a positive value."@en;
                                      rdfs:domain cim:PowerElectronicsConnection;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                      rdfs:label "ratedU"@en;
                                      rdfs:range cim:Voltage.
cim:PowerElectronicsConnection.rn a owl:DatatypeProperty;
                                  rdfs:comment "Negative sequence Thevenin resistance."@en;
                                  rdfs:domain cim:PowerElectronicsConnection;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "rn"@en;
                                  rdfs:range cim:Resistance.
cim:PowerElectronicsConnection.x a owl:DatatypeProperty;
                                 rdfs:comment "Positive sequence Thevenin reactance."@en;
                                 rdfs:domain cim:PowerElectronicsConnection;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "x"@en;
                                 rdfs:range cim:Reactance.
cim:PowerElectronicsConnection.x0 a owl:DatatypeProperty;
                                  rdfs:comment "Zero sequence Thevenin reactance."@en;
                                  rdfs:domain cim:PowerElectronicsConnection;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "x0"@en;
                                  rdfs:range cim:Reactance.
cim:PowerElectronicsConnection.xn a owl:DatatypeProperty;
                                  rdfs:comment "Negative sequence Thevenin reactance."@en;
                                  rdfs:domain cim:PowerElectronicsConnection;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "xn"@en;
                                  rdfs:range cim:Reactance.
cim:PowerElectronicsConnectionPhase a owl:Class;
                                    rdfs:comment "A single phase of a power electronics connection."@en;
                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                    rdfs:label "PowerElectronicsConnectionPhase"@en;
                                    rdfs:subClassOf cim:PowerSystemResource;
                                    cimdoc:cimPackage "IEC61970.Base.Wires";
                                    cimdoc:packageTier "Normative".
cim:PowerElectronicsConnectionPhase.p a owl:DatatypeProperty;
                                      rdfs:comment "Active power injection. Load sign convention is used, i.e. positive sign means flow into the equipment from the network."@en;
                                      rdfs:domain cim:PowerElectronicsConnectionPhase;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                      rdfs:label "p"@en;
                                      rdfs:range cim:ActivePower.
cim:PowerElectronicsConnectionPhase.phase a owl:ObjectProperty;
                                          rdfs:comment "Phase of this energy producer component. If the energy producer is wye connected, the connection is from the indicated phase to the central ground or neutral point. If the energy producer is delta connected, the phase indicates an energy producer connected from the indicated phase to the next logical non- neutral phase."@en;
                                          rdfs:domain cim:PowerElectronicsConnectionPhase;
                                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                          rdfs:label "phase"@en;
                                          rdfs:range cim:SinglePhaseKind.
cim:PowerElectronicsConnectionPhase.q a owl:DatatypeProperty;
                                      rdfs:comment "Reactive power injection. Load sign convention is used, i.e. positive sign means flow into the equipment from the network."@en;
                                      rdfs:domain cim:PowerElectronicsConnectionPhase;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                      rdfs:label "q"@en;
                                      rdfs:range cim:ReactivePower.
cim:PowerElectronicsUnit a owl:Class;
                         rdfs:comment "A generating unit or battery or aggregation that connects to the AC network using power electronics rather than rotating machines."@en;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                         rdfs:label "PowerElectronicsUnit"@en;
                         rdfs:subClassOf cim:Equipment;
                         cimdoc:cimPackage "IEC61970.Base.Generation.Production";
                         cimdoc:packageTier "Normative".
cim:PowerElectronicsUnit.maxP a owl:DatatypeProperty;
                              rdfs:comment "Maximum active power limit. This is the maximum (nameplate) limit for the unit."@en;
                              rdfs:domain cim:PowerElectronicsUnit;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "maxP"@en;
                              rdfs:range cim:ActivePower.
cim:PowerElectronicsUnit.minP a owl:DatatypeProperty;
                              rdfs:comment "Minimum active power limit. This is the minimum (nameplate) limit for the unit."@en;
                              rdfs:domain cim:PowerElectronicsUnit;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "minP"@en;
                              rdfs:range cim:ActivePower.
cim:PowerElectronicsWindUnit a owl:Class;
                             rdfs:comment "A wind generating unit that connects to the AC network with power electronics rather than rotating machines or an aggregation of such units."@en;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "PowerElectronicsWindUnit"@en;
                             rdfs:subClassOf cim:PowerElectronicsUnit;
                             cimdoc:cimPackage "IEC61970.Base.Generation.Production";
                             cimdoc:packageTier "Normative".
cim:PowerSystemProjectLifecycleToBeDeleted a owl:Class;
                                           rdfs:comment "Represent the base lifecycle of a functional model change that could be a construction of new elements."@en;
                                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                           rdfs:label "PowerSystemProjectLifecycleToBeDeleted"@en;
                                           cimdoc:cimPackage "IEC61970.InfIEC61970.InfPart303.NetworkModelProjects";
                                           cimdoc:packageTier "Informative".
cim:PowerSystemProjectLifecycleToBeDeleted.cancelled a owl:DatatypeProperty;
                                                     rdfs:comment "The date the Power System Project is in cancelled stage."@en;
                                                     rdfs:domain cim:PowerSystemProjectLifecycleToBeDeleted;
                                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                     rdfs:label "cancelled"@en;
                                                     rdfs:range xsd:date.
cim:PowerSystemProjectLifecycleToBeDeleted.committed a owl:DatatypeProperty;
                                                     rdfs:comment "The date Power System Project is in committed stage."@en;
                                                     rdfs:domain cim:PowerSystemProjectLifecycleToBeDeleted;
                                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                     rdfs:label "committed"@en;
                                                     rdfs:range xsd:date.
cim:PowerSystemProjectLifecycleToBeDeleted.inBuild a owl:DatatypeProperty;
                                                   rdfs:comment "The date Power System Project is in build stage."@en;
                                                   rdfs:domain cim:PowerSystemProjectLifecycleToBeDeleted;
                                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                   rdfs:label "inBuild"@en;
                                                   rdfs:range xsd:date.
cim:PowerSystemProjectLifecycleToBeDeleted.inPlan a owl:DatatypeProperty;
                                                  rdfs:comment "The date Power System Project is in planning stage."@en;
                                                  rdfs:domain cim:PowerSystemProjectLifecycleToBeDeleted;
                                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                  rdfs:label "inPlan"@en;
                                                  rdfs:range xsd:date.
cim:PowerSystemResource a owl:Class;
                        rdfs:comment "A power system resource (PSR) can be an item of equipment such as a switch, an equipment container containing many individual items of equipment such as a substation, or an organisational entity such as sub-control area. Power system resources can have measurements associated."@en;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                        rdfs:label "PowerSystemResource"@en;
                        rdfs:subClassOf cim:IdentifiedObject;
                        cimdoc:cimPackage "IEC61970.Base.Core";
                        cimdoc:packageTier "Normative".
cim:PowerSystemResource.ConfigurationEvent a owl:ObjectProperty;
                                           rdfs:comment "All configuration events created for this Power System resource."@en;
                                           rdfs:domain cim:PowerSystemResource;
                                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                           rdfs:label "ConfigurationEvent"@en;
                                           rdfs:range cim:ConfigurationEvent.
cim:PowerSystemResource.Controls a owl:ObjectProperty;
                                 rdfs:comment "The controller outputs used to actually govern a regulating device, e.g. the magnetization of a synchronous machine or capacitor bank breaker actuator."@en;
                                 rdfs:domain cim:PowerSystemResource;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "Controls"@en;
                                 rdfs:range cim:Control.
cim:PowerSystemResource.Measurements a owl:ObjectProperty;
                                     rdfs:comment "The measurements associated with this power system resource."@en;
                                     rdfs:domain cim:PowerSystemResource;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                     rdfs:label "Measurements"@en;
                                     rdfs:range cim:Measurement.
cim:PowerSystemResource.PSRType a owl:ObjectProperty;
                                rdfs:comment "Custom classification for this power system resource."@en;
                                rdfs:domain cim:PowerSystemResource;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "PSRType"@en;
                                rdfs:range cim:PSRType.
cim:PowerSystemStabilizerDynamics a owl:Class;
                                  rdfs:comment "Power system stabilizer function block whose behaviour is described by reference to a standard model or by definition of a user- defined model."@en;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "PowerSystemStabilizerDynamics"@en;
                                  rdfs:subClassOf cim:DynamicsFunctionBlock;
                                  cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.PowerSystemStabilizerDynamics";
                                  cimdoc:packageTier "Normative".
cim:PowerSystemStabilizerDynamics.ExcitationSystemDynamics a owl:ObjectProperty;
                                                           rdfs:comment "Excitation system model with which this power system stabilizer model is associated."@en;
                                                           rdfs:domain cim:PowerSystemStabilizerDynamics;
                                                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                           rdfs:label "ExcitationSystemDynamics"@en;
                                                           rdfs:range cim:ExcitationSystemDynamics.
cim:PowerSystemStabilizerDynamics.RemoteInputSignal a owl:ObjectProperty;
                                                    rdfs:comment "Remote input signal used by this power system stabilizer model."@en;
                                                    rdfs:domain cim:PowerSystemStabilizerDynamics;
                                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                    rdfs:label "RemoteInputSignal"@en;
                                                    rdfs:range cim:RemoteInputSignal.
cim:PowerSystemStabilizerUserDefined a owl:Class;
                                     rdfs:comment "Power system stabilizer function block whose dynamic behaviour is described by a user-defined model."@en;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                     rdfs:label "PowerSystemStabilizerUserDefined"@en;
                                     rdfs:subClassOf cim:PowerSystemStabilizerDynamics;
                                     cimdoc:cimPackage "IEC61970.Dynamics.UserDefinedModels";
                                     cimdoc:packageTier "Normative".
cim:PowerSystemStabilizerUserDefined.proprietary a owl:DatatypeProperty;
                                                 rdfs:comment "Behaviour is based on a proprietary model as opposed to a detailed model. true = user-defined model is proprietary with behaviour mutually understood by sending and receiving applications and parameters passed as general attributes false = user-defined model is explicitly defined in terms of control blocks and their input and output signals."@en;
                                                 rdfs:domain cim:PowerSystemStabilizerUserDefined;
                                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                 rdfs:label "proprietary"@en;
                                                 rdfs:range xsd:boolean.
cim:PowerTransformer a owl:Class;
                     rdfs:comment "An electrical device consisting of two or more coupled windings, with or without a magnetic core, for introducing mutual coupling between electric circuits. Transformers can be used to control voltage and phase shift (active power flow). A power transformer may be composed of separate transformer tanks that need not be identical. A power transformer can be modelled with or without tanks and is intended for use in both balanced and unbalanced representations. A power transformer typically has two terminals, but may have one (grounding), three or more terminals. The inherited association ConductingEquipment.BaseVoltage should not be used. The association from TransformerEnd to BaseVoltage should be used instead."@en;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                     rdfs:label "PowerTransformer"@en;
                     rdfs:subClassOf cim:ConductingEquipment;
                     cimdoc:cimPackage "IEC61970.Base.Wires";
                     cimdoc:packageTier "Normative".
cim:PowerTransformer.PowerTransformerEnd a owl:ObjectProperty;
                                         rdfs:comment "The ends of this power transformer."@en;
                                         rdfs:domain cim:PowerTransformer;
                                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                         rdfs:label "PowerTransformerEnd"@en;
                                         rdfs:range cim:PowerTransformerEnd.
cim:PowerTransformer.beforeShCircuitHighestOperatingCurrent a owl:DatatypeProperty;
                                                            rdfs:comment "The highest operating current (Ib in IEC 60909-0) before short circuit (depends on network configuration and relevant reliability philosophy). It is used for calculation of the impedance correction factor KT defined in IEC 60909-0."@en;
                                                            rdfs:domain cim:PowerTransformer;
                                                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                            rdfs:label "beforeShCircuitHighestOperatingCurrent"@en;
                                                            rdfs:range cim:CurrentFlow.
cim:PowerTransformer.beforeShCircuitHighestOperatingVoltage a owl:DatatypeProperty;
                                                            rdfs:comment "The highest operating voltage (Ub in IEC 60909-0) before short circuit. It is used for calculation of the impedance correction factor KT defined in IEC 60909- 0. This is worst case voltage on the low side winding (3.7.1 of IEC 60909:2001). Used to define operating conditions."@en;
                                                            rdfs:domain cim:PowerTransformer;
                                                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                            rdfs:label "beforeShCircuitHighestOperatingVoltage"@en;
                                                            rdfs:range cim:Voltage.
cim:PowerTransformer.beforeShortCircuitAnglePf a owl:DatatypeProperty;
                                               rdfs:comment "The angle of power factor before short circuit (phib in IEC 60909-0). It is used for calculation of the impedance correction factor KT defined in IEC 60909- 0. This is the worst case power factor. Used to define operating conditions."@en;
                                               rdfs:domain cim:PowerTransformer;
                                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                               rdfs:label "beforeShortCircuitAnglePf"@en;
                                               rdfs:range cim:AngleDegrees.
cim:PowerTransformer.highSideMinOperatingU a owl:DatatypeProperty;
                                           rdfs:comment "The minimum operating voltage (uQmin in IEC 60909-0) at the high voltage side (Q side) of the unit transformer of the power station unit. A value well established from long-term operating experience of the system. It is used for calculation of the impedance correction factor KG defined in IEC 60909-0."@en;
                                           rdfs:domain cim:PowerTransformer;
                                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                           rdfs:label "highSideMinOperatingU"@en;
                                           rdfs:range cim:Voltage.
cim:PowerTransformer.isPartOfGeneratorUnit a owl:DatatypeProperty;
                                           rdfs:comment "Indicates whether the machine is part of a power station unit. Used for short circuit data exchange according to IEC 60909. It has an impact on how the correction factors are calculated for transformers, since the transformer is not necessarily part of a synchronous machine and generating unit. It is not always possible to derive this information from the model. This is why the attribute is necessary."@en;
                                           rdfs:domain cim:PowerTransformer;
                                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                           rdfs:label "isPartOfGeneratorUnit"@en;
                                           rdfs:range xsd:boolean.
cim:PowerTransformer.operationalValuesConsidered a owl:DatatypeProperty;
                                                 rdfs:comment "It is used to define if the data (other attributes related to short circuit data exchange) defines long term operational conditions or not. Used for short circuit data exchange according to IEC 60909."@en;
                                                 rdfs:domain cim:PowerTransformer;
                                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                 rdfs:label "operationalValuesConsidered"@en;
                                                 rdfs:range xsd:boolean.
cim:PowerTransformer.vectorGroup a owl:DatatypeProperty;
                                 rdfs:comment "Vector group of the transformer for protective relaying, e.g., Dyn1. For unbalanced transformers, this may not be simply determined from the constituent winding connections and phase angle displacements. The vectorGroup string consists of the following components in the order listed: high voltage winding connection, mid voltage winding connection (for three winding transformers), phase displacement clock number from 0 to 11, low voltage winding connection phase displacement clock number from 0 to 11. The winding connections are D (delta), Y (wye), YN (wye with neutral), Z (zigzag), ZN (zigzag with neutral), A (auto transformer). Upper case means the high voltage, lower case mid or low. The high voltage winding always has clock position 0 and is not included in the vector group string. Some examples: YNy0 (two winding wye to wye with no phase displacement), YNd11 (two winding wye to delta with 330 degrees phase displacement), YNyn0d5 (three winding transformer wye with neutral high voltage, wye with neutral mid voltage and no phase displacement, delta low voltage with 150 degrees displacement). Phase displacement is defined as the angular difference between the phasors representing the voltages between the neutral point (real or imaginary) and the corresponding terminals of two windings, a positive sequence voltage system being applied to the high-voltage terminals, following each other in alphabetical sequence if they are lettered, or in numerical sequence if they are numbered: the phasors are assumed to rotate in a counter-clockwise sense."@en;
                                 rdfs:domain cim:PowerTransformer;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "vectorGroup"@en;
                                 rdfs:range xsd:string.
cim:PowerTransformerEnd a owl:Class;
                        rdfs:comment "A PowerTransformerEnd is associated with each Terminal of a PowerTransformer. The impedance values r, r0, x, and x0 of a PowerTransformerEnd represents a star equivalent as follows. 1) for a two Terminal PowerTransformer the high voltage (TransformerEnd. endNumber=1) PowerTransformerEnd has non zero values on r, r0, x, and x0 while the low voltage (TransformerEnd.endNumber=2) PowerTransformerEnd has zero values for r, r0, x, and x0. Parameters are always provided, even if the PowerTransformerEnds have the same rated voltage. In this case, the parameters are provided at the PowerTransformerEnd which has TransformerEnd.endNumber equal to 1. 2) for a three Terminal PowerTransformer the three PowerTransformerEnds represent a star equivalent with each leg in the star represented by r, r0, x, and x0 values. 3) For a three Terminal transformer each PowerTransformerEnd shall have g, g0, b and b0 values corresponding to the no load losses distributed on the three PowerTransformerEnds. The total no load loss shunt impedances may also be placed at one of the PowerTransformerEnds, preferably the end numbered 1, having the shunt values on end 1. This is the preferred way. 4) for a PowerTransformer with more than three Terminals the PowerTransformerEnd impedance values cannot be used. Instead use the TransformerMeshImpedance or split the transformer into multiple PowerTransformers. Each PowerTransformerEnd must be contained by a PowerTransformer. Because a PowerTransformerEnd (or any other object) can not be contained by more than one parent, a PowerTransformerEnd can not have an association to an EquipmentContainer (Substation, VoltageLevel, etc)."@en;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                        rdfs:label "PowerTransformerEnd"@en;
                        rdfs:subClassOf cim:TransformerEnd;
                        cimdoc:cimPackage "IEC61970.Base.Wires";
                        cimdoc:packageTier "Normative".
cim:PowerTransformerEnd.b a owl:DatatypeProperty;
                          rdfs:comment "Magnetizing branch susceptance (B mag). The value can be positive or negative."@en;
                          rdfs:domain cim:PowerTransformerEnd;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                          rdfs:label "b"@en;
                          rdfs:range cim:Susceptance.
cim:PowerTransformerEnd.b0 a owl:DatatypeProperty;
                           rdfs:comment "Zero sequence magnetizing branch susceptance."@en;
                           rdfs:domain cim:PowerTransformerEnd;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "b0"@en;
                           rdfs:range cim:Susceptance.
cim:PowerTransformerEnd.connectionKind a owl:ObjectProperty;
                                       rdfs:comment "Kind of connection."@en;
                                       rdfs:domain cim:PowerTransformerEnd;
                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                       rdfs:label "connectionKind"@en;
                                       rdfs:range cim:WindingConnection.
cim:PowerTransformerEnd.g a owl:DatatypeProperty;
                          rdfs:comment "Magnetizing branch conductance."@en;
                          rdfs:domain cim:PowerTransformerEnd;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                          rdfs:label "g"@en;
                          rdfs:range cim:Conductance.
cim:PowerTransformerEnd.g0 a owl:DatatypeProperty;
                           rdfs:comment "Zero sequence magnetizing branch conductance (star-model)."@en;
                           rdfs:domain cim:PowerTransformerEnd;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "g0"@en;
                           rdfs:range cim:Conductance.
cim:PowerTransformerEnd.phaseAngleClock a owl:DatatypeProperty;
                                        rdfs:comment "Terminal voltage phase angle displacement where 360 degrees are represented with clock hours. The valid values are 0 to 11. For example, for the secondary side end of a transformer with vector group code of 'Dyn11', specify the connection kind as wye with neutral and specify the phase angle of the clock as 11. The clock value of the transformer end number specified as 1, is assumed to be zero. Note the transformer end number is not assumed to be the same as the terminal sequence number."@en;
                                        rdfs:domain cim:PowerTransformerEnd;
                                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                        rdfs:label "phaseAngleClock"@en;
                                        rdfs:range xsd:integer.
cim:PowerTransformerEnd.r a owl:DatatypeProperty;
                          rdfs:comment "Resistance (star-model) of the transformer end. The attribute shall be equal to or greater than zero for non-equivalent transformers."@en;
                          rdfs:domain cim:PowerTransformerEnd;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                          rdfs:label "r"@en;
                          rdfs:range cim:Resistance.
cim:PowerTransformerEnd.r0 a owl:DatatypeProperty;
                           rdfs:comment "Zero sequence series resistance (star-model) of the transformer end."@en;
                           rdfs:domain cim:PowerTransformerEnd;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "r0"@en;
                           rdfs:range cim:Resistance.
cim:PowerTransformerEnd.ratedS a owl:DatatypeProperty;
                               rdfs:comment "Normal apparent power rating. The attribute shall be a positive value. For a two-winding transformer the values for the high and low voltage sides shall be identical."@en;
                               rdfs:domain cim:PowerTransformerEnd;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "ratedS"@en;
                               rdfs:range cim:ApparentPower.
cim:PowerTransformerEnd.ratedU a owl:DatatypeProperty;
                               rdfs:comment "Rated voltage: phase-phase for three-phase windings, and either phase-phase or phase-neutral for single-phase windings. A high voltage side, as given by TransformerEnd.endNumber, shall have a ratedU that is greater than or equal to ratedU for the lower voltage sides. The attribute shall be a positive value."@en;
                               rdfs:domain cim:PowerTransformerEnd;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "ratedU"@en;
                               rdfs:range cim:Voltage.
cim:PowerTransformerEnd.x a owl:DatatypeProperty;
                          rdfs:comment "Positive sequence series reactance (star-model) of the transformer end."@en;
                          rdfs:domain cim:PowerTransformerEnd;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                          rdfs:label "x"@en;
                          rdfs:range cim:Reactance.
cim:PowerTransformerEnd.x0 a owl:DatatypeProperty;
                           rdfs:comment "Zero sequence series reactance of the transformer end."@en;
                           rdfs:domain cim:PowerTransformerEnd;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "x0"@en;
                           rdfs:range cim:Reactance.
cim:Pressure a rdfs:Datatype;
             rdfs:comment "Pressure in pascals."@en;
             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
             rdfs:label "Pressure"@en;
             owl:equivalentClass xsd:float;
             cimdoc:cimPackage "IEC61970.Base.Domain";
             cimdoc:packageTier "Normative";
             cimdoc:unitSymbol cim:UnitSymbol.Pa.
cim:PrimeMover a owl:Class;
               rdfs:comment "The machine used to develop mechanical energy used to drive a generator."@en;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "PrimeMover"@en;
               rdfs:subClassOf cim:PowerSystemResource;
               cimdoc:cimPackage "IEC61970.Base.Generation.GenerationTrainingSimulation";
               cimdoc:packageTier "Normative".
cim:PrimeMover.SynchronousMachines a owl:ObjectProperty;
                                   rdfs:comment "Synchronous machines this Prime mover drives."@en;
                                   rdfs:domain cim:PrimeMover;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                   rdfs:label "SynchronousMachines"@en;
                                   rdfs:range cim:SynchronousMachine.
cim:PrimeMover.primeMoverRating a owl:DatatypeProperty;
                                rdfs:comment "Rating of prime mover."@en;
                                rdfs:domain cim:PrimeMover;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "primeMoverRating"@en;
                                rdfs:range xsd:float.
cim:Profile a owl:Class;
            rdfs:comment "Describes the existence of a profile. The MRID is usually defined as a static value by the document or artifact that defines the contents of the profile and the rules for using the profile."@en;
            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
            rdfs:label "Profile"@en;
            rdfs:subClassOf cim:IdentifiedObject;
            cimdoc:cimPackage "IEC61970.InfIEC61970.Part303.GenericDataSet";
            cimdoc:packageTier "Informative".
cim:ProjectAlternative a owl:Class;
                       rdfs:comment "Project B is an alternative to project A. Project A is the primary alternative. Multiple project alternatives should not be selected into a single network study case."@en;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "ProjectAlternative"@en;
                       rdfs:subClassOf cim:NetworkModelProjectRelationship;
                       cimdoc:cimPackage "IEC61970.InfIEC61970.InfPart303.NetworkModelProjects";
                       cimdoc:packageTier "Informative".
cim:ProjectDependency a owl:Class;
                      rdfs:comment "Project A change sets should be applied before Project B during case creation."@en;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "ProjectDependency"@en;
                      rdfs:subClassOf cim:NetworkModelProjectRelationship;
                      cimdoc:cimPackage "IEC61970.InfIEC61970.InfPart303.NetworkModelProjects";
                      cimdoc:packageTier "Informative".
cim:ProjectStatusKind a owl:Class;
                      rdfs:comment "Enumerates the possible statuses for a network model project."@en;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "ProjectStatusKind"@en;
                      owl:equivalentClass [a owl:Class ; 
                                           owl:oneOf (cim:ProjectStatusKind.cancelled
                                                      cim:ProjectStatusKind.closed
                                                      cim:ProjectStatusKind.draft
                                                      cim:ProjectStatusKind.frozen)];
                      cimdoc:cimPackage "IEC61970.InfIEC61970.InfPart303.NetworkModelProjects";
                      cimdoc:packageTier "Informative".
cim:ProjectStatusKind.cancelled a owl:NamedIndividual,
                                  cim:ProjectStatusKind;
                                rdfs:comment "The project is cancelled."@en;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "cancelled"@en;
                                cimdoc:enumCode 1 .
cim:ProjectStatusKind.closed a owl:NamedIndividual,
                               cim:ProjectStatusKind;
                             rdfs:comment "The project is closed."@en;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "closed"@en;
                             cimdoc:enumCode 3 .
cim:ProjectStatusKind.draft a owl:NamedIndividual,
                              cim:ProjectStatusKind;
                            rdfs:comment "The project is in draft status."@en;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "draft"@en;
                            cimdoc:enumCode 0 .
cim:ProjectStatusKind.frozen a owl:NamedIndividual,
                               cim:ProjectStatusKind;
                             rdfs:comment "The project is frozen."@en;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "frozen"@en;
                             cimdoc:enumCode 2 .
cim:ProportionalDistributionComponent a owl:Class;
                                      rdfs:comment "Represents a proportional distribution component in the energy area."@en;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                      rdfs:label "ProportionalDistributionComponent"@en;
                                      rdfs:subClassOf cim:EnergyComponent;
                                      cimdoc:cimPackage "IEC61970.InfIEC61970.EnergyArea";
                                      cimdoc:packageTier "Informative".
cim:ProportionalDistributionComponent.distributionFactor a owl:DatatypeProperty;
                                                         rdfs:comment "The distribution factor for proportional distribution."@en;
                                                         rdfs:domain cim:ProportionalDistributionComponent;
                                                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                         rdfs:label "distributionFactor"@en;
                                                         rdfs:range cim:ActivePower.
cim:ProprietaryParameterDynamics a owl:Class;
                                 rdfs:comment "Supports definition of one or more parameters of several different datatypes for use by proprietary user-defined models. This class does not inherit from IdentifiedObject since it is not intended that a single instance of it be referenced by more than one proprietary user-defined model instance."@en;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "ProprietaryParameterDynamics"@en;
                                 cimdoc:cimPackage "IEC61970.Dynamics.UserDefinedModels";
                                 cimdoc:packageTier "Normative".
cim:ProprietaryParameterDynamics.AsynchronousMachineUserDefined a owl:ObjectProperty;
                                                                rdfs:comment "Proprietary user-defined model with which this parameter is associated."@en;
                                                                rdfs:domain cim:ProprietaryParameterDynamics;
                                                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                                rdfs:label "AsynchronousMachineUserDefined"@en;
                                                                rdfs:range cim:AsynchronousMachineUserDefined.
cim:ProprietaryParameterDynamics.DiscontinuousExcitationControlUserDefined a owl:ObjectProperty;
                                                                           rdfs:comment "Proprietary user-defined model with which this parameter is associated."@en;
                                                                           rdfs:domain cim:ProprietaryParameterDynamics;
