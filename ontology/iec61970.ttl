cim:ModelOperationSequence.ModelOperation a owl:ObjectProperty;
                                          rdfs:comment "The model operation associated with this sequence."@en;
                                          rdfs:domain cim:ModelOperationSequence;
                                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                          rdfs:label "ModelOperation"@en;
                                          rdfs:range cim:ModelOperation.
cim:ModelPartSpecification a owl:Class;
                           rdfs:comment "The type of model. For example, state estimator, planning, planning dynamics, short circuit, or real-time dynamics etc. The model must conform to a profile."@en;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "ModelPartSpecification"@en;
                           rdfs:subClassOf cim:IdentifiedObject;
