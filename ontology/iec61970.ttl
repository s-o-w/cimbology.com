cim:UnderexcLimIEEE1.vuimin a owl:DatatypeProperty;
                            rdfs:comment "UEL integrator output minimum limit (VUIMIN) (< UnderexcLimIEEE1.vuimax)."@en;
                            rdfs:domain cim:UnderexcLimIEEE1;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
