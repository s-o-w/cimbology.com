                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "pumpPowerAtMinHead"@en;
                                 rdfs:range cim:ActivePower.
cim:HydroPumpOpSchedule a owl:Class;
                        rdfs:comment "The hydro pump's Operator-approved current operating schedule (or plan), typically produced with the aid of unit commitment type analyses. The unit's operating schedule status is typically given as: (0=unavailable) (1=available to startup or shutdown) (2=must pump)."@en;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                        rdfs:label "HydroPumpOpSchedule"@en;
                        rdfs:subClassOf cim:RegularIntervalSchedule;
                        cimdoc:cimPackage "IEC61970.Base.Generation.Production";
                        cimdoc:packageTier "Normative".
cim:HydroTurbine a owl:Class;
                 rdfs:comment "A water driven prime mover. Typical turbine types are: Francis, Kaplan, and Pelton."@en;
