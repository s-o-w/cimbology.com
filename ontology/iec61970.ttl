cim:HydroPowerPlant.HydroGeneratingUnits a owl:ObjectProperty;
                                         rdfs:comment "The hydro generating unit belongs to a hydro power plant."@en;
                                         rdfs:domain cim:HydroPowerPlant;
                                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
