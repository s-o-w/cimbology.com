                   rdfs:range cim:PU.
cim:ExcDC3A1.vrmin a owl:DatatypeProperty;
                   rdfs:comment "Minimum voltage regulator output (Vrmin) (< 0 and < ExcDC3A1.vrmax). Typical value = 0."@en;
                   rdfs:domain cim:ExcDC3A1;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "vrmin"@en;
                   rdfs:range cim:PU.
cim:ExcELIN1 a owl:Class;
             rdfs:comment "Static PI transformer fed excitation system ELIN (VATECH) - simplified model. This model represents an all-static excitation system. A PI voltage controller establishes a desired field current set point for a proportional current controller. The integrator of the PI controller has a follow-up input to match its signal to the present field current. A power system stabilizer with power input is included in the model."@en;
             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
             rdfs:label "ExcELIN1"@en;
             rdfs:subClassOf cim:ExcitationSystemDynamics;
             cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.ExcitationSystemDynamics";
             cimdoc:packageTier "Normative".
cim:ExcELIN1.dpnf a owl:DatatypeProperty;
                  rdfs:comment "Controller follow up deadband (Dpnf). Typical value = 0."@en;
                  rdfs:domain cim:ExcELIN1;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "dpnf"@en;
                  rdfs:range cim:PU.
cim:ExcELIN1.efmax a owl:DatatypeProperty;
                   rdfs:comment "Maximum open circuit excitation voltage (Efmax) (> ExcELIN1.efmin). Typical value = 5."@en;
                   rdfs:domain cim:ExcELIN1;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "efmax"@en;
                   rdfs:range cim:PU.
cim:ExcELIN1.efmin a owl:DatatypeProperty;
                   rdfs:comment "Minimum open circuit excitation voltage (Efmin) (< ExcELIN1.efmax). Typical value = -5."@en;
                   rdfs:domain cim:ExcELIN1;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "efmin"@en;
                   rdfs:range cim:PU.
cim:ExcELIN1.ks1 a owl:DatatypeProperty;
                 rdfs:comment "Stabilizer gain 1 (Ks1). Typical value = 0."@en;
                 rdfs:domain cim:ExcELIN1;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "ks1"@en;
                 rdfs:range cim:PU.
cim:ExcELIN1.ks2 a owl:DatatypeProperty;
                 rdfs:comment "Stabilizer gain 2 (Ks2). Typical value = 0."@en;
                 rdfs:domain cim:ExcELIN1;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "ks2"@en;
                 rdfs:range cim:PU.
cim:ExcELIN1.smax a owl:DatatypeProperty;
                  rdfs:comment "Stabilizer limit output (smax). Typical value = 0,1."@en;
                  rdfs:domain cim:ExcELIN1;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "smax"@en;
                  rdfs:range cim:PU.
cim:ExcELIN1.tfi a owl:DatatypeProperty;
                 rdfs:comment "Current transducer time constant (Tfi) (>= 0). Typical value = 0."@en;
                 rdfs:domain cim:ExcELIN1;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "tfi"@en;
                 rdfs:range cim:Seconds.
cim:ExcELIN1.tnu a owl:DatatypeProperty;
                 rdfs:comment "Controller reset time constant (Tnu) (>= 0). Typical value = 2."@en;
                 rdfs:domain cim:ExcELIN1;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "tnu"@en;
                 rdfs:range cim:Seconds.
cim:ExcELIN1.ts1 a owl:DatatypeProperty;
                 rdfs:comment "Stabilizer phase lag time constant (Ts1) (>= 0). Typical value = 1."@en;
                 rdfs:domain cim:ExcELIN1;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "ts1"@en;
                 rdfs:range cim:Seconds.
cim:ExcELIN1.ts2 a owl:DatatypeProperty;
                 rdfs:comment "Stabilizer filter time constant (Ts2) (>= 0). Typical value = 1."@en;
                 rdfs:domain cim:ExcELIN1;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "ts2"@en;
                 rdfs:range cim:Seconds.
cim:ExcELIN1.tsw a owl:DatatypeProperty;
                 rdfs:comment "Stabilizer parameters (Tsw) (>= 0). Typical value = 3."@en;
                 rdfs:domain cim:ExcELIN1;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "tsw"@en;
                 rdfs:range cim:Seconds.
cim:ExcELIN1.vpi a owl:DatatypeProperty;
                 rdfs:comment "Current controller gain (Vpi). Typical value = 12,45."@en;
                 rdfs:domain cim:ExcELIN1;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "vpi"@en;
                 rdfs:range cim:PU.
cim:ExcELIN1.vpnf a owl:DatatypeProperty;
                  rdfs:comment "Controller follow up gain (Vpnf). Typical value = 2."@en;
                  rdfs:domain cim:ExcELIN1;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "vpnf"@en;
                  rdfs:range cim:PU.
cim:ExcELIN1.vpu a owl:DatatypeProperty;
                 rdfs:comment "Voltage controller proportional gain (Vpu). Typical value = 34,5."@en;
                 rdfs:domain cim:ExcELIN1;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "vpu"@en;
                 rdfs:range cim:PU.
cim:ExcELIN1.xe a owl:DatatypeProperty;
                rdfs:comment "Excitation transformer effective reactance (Xe) (>= 0). Xe represents the regulation of the transformer/rectifier unit. Typical value = 0, 06."@en;
                rdfs:domain cim:ExcELIN1;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "xe"@en;
                rdfs:range cim:PU.
cim:ExcELIN2 a owl:Class;
             rdfs:comment "Detailed excitation system ELIN (VATECH). This model represents an all-static excitation system. A PI voltage controller establishes a desired field current set point for a proportional current controller. The integrator of the PI controller has a follow-up input to match its signal to the present field current. Power system stabilizer models used in conjunction with this excitation system model: PssELIN2, PssIEEE2B, Pss2B."@en;
             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
             rdfs:label "ExcELIN2"@en;
             rdfs:subClassOf cim:ExcitationSystemDynamics;
             cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.ExcitationSystemDynamics";
             cimdoc:packageTier "Normative".
