                      rdfs:label "vrmin"@en;
                      rdfs:range cim:PU.
cim:ExcIEEEAC2A a owl:Class;
                rdfs:comment "IEEE 421.5-2005 type AC2A model. The model represents a high initial response field-controlled alternator-rectifier excitation system. The alternator main exciter is used with non-controlled rectifiers. The type AC2A model is similar to that of type AC1A except for the inclusion of exciter time constant compensation and exciter field current limiting elements. Reference: IEEE 421.5-2005, 6.2."@en;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "ExcIEEEAC2A"@en;
                rdfs:subClassOf cim:ExcitationSystemDynamics;
