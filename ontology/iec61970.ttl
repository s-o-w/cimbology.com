cim:LoadGenericNonLinear.ls a owl:DatatypeProperty;
                            rdfs:comment "Steady state voltage index for active power (LS)."@en;
                            rdfs:domain cim:LoadGenericNonLinear;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "ls"@en;
                            rdfs:range xsd:float.
cim:LoadGenericNonLinear.lt a owl:DatatypeProperty;
                            rdfs:comment "Transient voltage index for active power (LT)."@en;
                            rdfs:domain cim:LoadGenericNonLinear;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "lt"@en;
                            rdfs:range xsd:float.
cim:LoadGenericNonLinear.tp a owl:DatatypeProperty;
                            rdfs:comment "Time constant of lag function of active power (TP) (> 0)."@en;
                            rdfs:domain cim:LoadGenericNonLinear;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "tp"@en;
                            rdfs:range cim:Seconds.
cim:LoadGenericNonLinear.tq a owl:DatatypeProperty;
                            rdfs:comment "Time constant of lag function of reactive power (TQ) (> 0)."@en;
                            rdfs:domain cim:LoadGenericNonLinear;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "tq"@en;
