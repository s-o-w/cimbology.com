                    rdfs:range cim:PU.
cim:ExcIEEEAC7B.kir a owl:DatatypeProperty;
                    rdfs:comment "Voltage regulator integral gain (KIR) (>= 0). Typical value = 4,24."@en;
                    rdfs:domain cim:ExcIEEEAC7B;
