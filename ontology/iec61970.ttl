cim:GovHydro1.gmin a owl:DatatypeProperty;
                   rdfs:comment "Minimum gate opening (Gmin) (>= 0 and < GovHydro1.gmax). Typical value = 0."@en;
                   rdfs:domain cim:GovHydro1;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
