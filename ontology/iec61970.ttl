                                                    cim:CalculationKind.mul
                                                    cim:CalculationKind.sqrt
                                                    cim:CalculationKind.sum)];
                    cimdoc:cimPackage "IEC61970.InfIEC61970.InfSIPS";
                    cimdoc:packageTier "Informative".
cim:CalculationKind.div a owl:NamedIndividual,
                          cim:CalculationKind;
                        rdfs:comment "Division operation the input values (operands)."@en;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                        rdfs:label "div"@en;
                        cimdoc:enumCode 2 .
cim:CalculationKind.mul a owl:NamedIndividual,
                          cim:CalculationKind;
                        rdfs:comment "Multiplication operation the input values (operands)."@en;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                        rdfs:label "mul"@en;
                        cimdoc:enumCode 1 .
cim:CalculationKind.sqrt a owl:NamedIndividual,
