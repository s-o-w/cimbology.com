                        cim:ICCPScopeKind;
                      rdfs:comment "Inter-Control Centre scope � available for exchange between the control centres in the bilateral table."@en;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "iCC"@en;
                      cimdoc:enumCode 1 .
cim:ICCPScopeKind.vCC a owl:NamedIndividual,
                        cim:ICCPScopeKind;
                      rdfs:comment "Virtual Control Centre Scope � globally available."@en;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "vCC"@en;
                      cimdoc:enumCode 0 .
cim:ICCPVCC a owl:Class;
            rdfs:comment "Indicates that the ICCP information is global in nature and normally is available to all authorized peers."@en;
            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
            rdfs:label "ICCPVCC"@en;
            rdfs:subClassOf cim:BilateralExchangeActor;
            cimdoc:cimPackage "IEC61970.Base.ICCPConfiguration";
            cimdoc:packageTier "Normative".
cim:ICCPVirtualControlCentre a owl:Class;
                             rdfs:comment "This contains the information that a particular actor exposes for a particular agreed upon ICCP Bilateral Table."@en;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "ICCPVirtualControlCentre"@en;
                             rdfs:subClassOf cim:BilateralExchangeActor;
                             cimdoc:cimPackage "IEC61970.Base.ICCPConfiguration";
                             cimdoc:packageTier "Normative".
cim:ICCPVirtualControlCentre.applicationSecurityRequirement a owl:ObjectProperty;
                                                            rdfs:comment "Specifies the expected security mechanism, per IEC 62351-4, to be utilized."@en;
                                                            rdfs:domain cim:ICCPVirtualControlCentre;
                                                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                            rdfs:label "applicationSecurityRequirement"@en;
                                                            rdfs:range cim:ApplicationSecurityKind.
cim:ICCPVirtualControlCentre.calling a owl:DatatypeProperty;
                                     rdfs:comment "Used to indicate if the Provider is responsible for initiating the TASE.2 connection. If the value is TRUE, the provider is responsible for establishing the association. If the value is FALSE, the peer provider of the Bilateral Table will need to establish the association."@en;
                                     rdfs:domain cim:ICCPVirtualControlCentre;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                     rdfs:label "calling"@en;
                                     rdfs:range xsd:boolean.
cim:ICCPVirtualControlCentre.clientAndServer a owl:DatatypeProperty;
                                             rdfs:comment "If True the value indicates that the entity represented by the bilateral table is capable of issuing requests and responding to request (e.g. bidirectional support of ICCP requests). If False, this indicates that a calling entity (e.g. calling = True) will not be able to respond to ICCP requests. If False, and calling=False, this indicates that the entity will only respond to ICCP requests and not issue ICCP requests."@en;
                                             rdfs:domain cim:ICCPVirtualControlCentre;
                                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                             rdfs:label "clientAndServer"@en;
                                             rdfs:range xsd:boolean.
cim:ICCPVirtualControlCentre.minimumUpdateInterval a owl:DatatypeProperty;
                                                   rdfs:comment "Specifies the fastest update interval that can be provided for integrity information and Transfer Set creation. The value is in seconds."@en;
                                                   rdfs:domain cim:ICCPVirtualControlCentre;
                                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                   rdfs:label "minimumUpdateInterval"@en;
                                                   rdfs:range xsd:integer.
cim:ICCPVirtualControlCentre.nameOfLocalICC a owl:DatatypeProperty;
                                            rdfs:comment "Specifies the ICC scope name that the remote can use to access the information in the Bilateral Table if the information is not VCC scoped. This value may not be null."@en;
                                            rdfs:domain cim:ICCPVirtualControlCentre;
                                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                            rdfs:label "nameOfLocalICC"@en;
                                            rdfs:range xsd:string.
cim:ICCPVirtualControlCentre.supportForBlock1 a owl:DatatypeProperty;
                                              rdfs:comment "Per IEC 60870-6-702: If true indicates support for basic services. Must always be true."@en;
                                              rdfs:domain cim:ICCPVirtualControlCentre;
                                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                              rdfs:label "supportForBlock1"@en;
                                              rdfs:range xsd:boolean.
cim:ICCPVirtualControlCentre.supportForBlock2 a owl:DatatypeProperty;
                                              rdfs:comment "Per IEC 60870-6-702: If true indicates support for extended conditions."@en;
                                              rdfs:domain cim:ICCPVirtualControlCentre;
                                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                              rdfs:label "supportForBlock2"@en;
                                              rdfs:range xsd:boolean.
cim:ICCPVirtualControlCentre.supportForBlock3 a owl:DatatypeProperty;
                                              rdfs:comment "Per IEC 60870-6-702: If true indicates support for blocked transfers."@en;
                                              rdfs:domain cim:ICCPVirtualControlCentre;
                                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                              rdfs:label "supportForBlock3"@en;
                                              rdfs:range xsd:boolean.
cim:ICCPVirtualControlCentre.supportForBlock4 a owl:DatatypeProperty;
                                              rdfs:comment "Per IEC 60870-6-702: If true indicates support for information messages."@en;
                                              rdfs:domain cim:ICCPVirtualControlCentre;
                                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                              rdfs:label "supportForBlock4"@en;
                                              rdfs:range xsd:boolean.
cim:ICCPVirtualControlCentre.supportForBlock5 a owl:DatatypeProperty;
                                              rdfs:comment "Per IEC 60870-6-702: If true indicates support for device control."@en;
                                              rdfs:domain cim:ICCPVirtualControlCentre;
                                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                              rdfs:label "supportForBlock5"@en;
                                              rdfs:range xsd:boolean.
cim:ICCPVirtualControlCentre.supportForDepriciatedBlock8 a owl:DatatypeProperty;
                                                         rdfs:comment "Per IEC 60870-6-702: If true indicates support for accounts. The use of this block was deprecated in Edition 3."@en;
                                                         rdfs:domain cim:ICCPVirtualControlCentre;
                                                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                         rdfs:label "supportForDepriciatedBlock8"@en;
                                                         rdfs:range xsd:boolean.
cim:ICCPVirtualControlCentre.transportSecurityRequirement a owl:DatatypeProperty;
                                                          rdfs:comment "If true, then transport level security as specified by IEC 62351-6 is required."@en;
                                                          rdfs:domain cim:ICCPVirtualControlCentre;
                                                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                          rdfs:label "transportSecurityRequirement"@en;
                                                          rdfs:range xsd:boolean.
cim:IEC61970CIMVersion a owl:Class;
                       rdfs:comment "This is the IEC 61970 CIM version number assigned to this UML model."@en;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "IEC61970CIMVersion"@en;
                       cimdoc:cimPackage "IEC61970";
