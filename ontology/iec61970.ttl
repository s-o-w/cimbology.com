                       rdfs:comment "Intentional dead-band width (DB1). Unit = Hz. Typical value = 0."@en;
                       rdfs:domain cim:GovHydroPelton;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
