                                        rdfs:comment "Disconnection time versus under-voltage lookup table (Tuunder(uWT)). It is used for the grid protection model, IEC 61400-27-1:2015, 5.6.6."@en;
                                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                        rdfs:label "tuunder"@en;
                                        cimdoc:enumCode 12 .
