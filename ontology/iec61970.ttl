cim:ProtectionEquipment a owl:Class;
                        rdfs:comment "An electrical device designed to respond to input conditions in a prescribed manner and after specified conditions are met to cause contact operation or similar abrupt change in associated electric control circuits, or simply to display the detected condition. Protection equipment is associated with conducting equipment and usually operate circuit breakers."@en;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                        rdfs:label "ProtectionEquipment"@en;
                        rdfs:subClassOf cim:Equipment;
                        cimdoc:cimPackage "IEC61970.Base.Protection";
                        cimdoc:packageTier "Normative".
