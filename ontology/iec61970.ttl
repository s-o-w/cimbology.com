cim:PetersenCoilModeKind.fixedPosition a owl:NamedIndividual,
                                         cim:PetersenCoilModeKind;
                                       rdfs:comment "Fixed position."@en;
                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                       rdfs:label "fixedPosition"@en;
                                       cimdoc:enumCode 0 .
cim:PetersenCoilModeKind.manualPosition a owl:NamedIndividual,
                                          cim:PetersenCoilModeKind;
                                        rdfs:comment "Manual positioning."@en;
                                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                        rdfs:label "manualPosition"@en;
                                        cimdoc:enumCode 1 .
cim:PhaseCode a owl:Class;
              rdfs:comment "An unordered enumeration of phase identifiers. Allows designation of phases for both transmission and distribution equipment, circuits and loads. The enumeration, by itself, does not describe how the phases are connected together or connected to ground. Ground is not explicitly denoted as a phase. Residential and small commercial loads are often served from single-phase, or split-phase, secondary circuits. For the example of s12N, phases 1 and 2 refer to hot wires that are 180 degrees out of phase, while N refers to the neutral wire. Through single-phase transformer connections, these secondary circuits may be served from one or two of the primary phases A, B, and C. For three- phase loads, use the A, B, C phase codes instead of s12N. The integer values are from IEC 61968-9 to support revenue metering applications."@en;
              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
              rdfs:label "PhaseCode"@en;
              owl:equivalentClass [a owl:Class ; 
                                   owl:oneOf (cim:PhaseCode.A
                                              cim:PhaseCode.AB
                                              cim:PhaseCode.ABC
                                              cim:PhaseCode.ABCN
                                              cim:PhaseCode.ABN
                                              cim:PhaseCode.AC
                                              cim:PhaseCode.ACN
                                              cim:PhaseCode.AN
                                              cim:PhaseCode.B
                                              cim:PhaseCode.BC
                                              cim:PhaseCode.BCN
                                              cim:PhaseCode.BN
                                              cim:PhaseCode.C
                                              cim:PhaseCode.CN
                                              cim:PhaseCode.N
                                              cim:PhaseCode.X
                                              cim:PhaseCode.XN
                                              cim:PhaseCode.XY
                                              cim:PhaseCode.XYN
                                              cim:PhaseCode.none
                                              cim:PhaseCode.s1
                                              cim:PhaseCode.s12
                                              cim:PhaseCode.s12N
                                              cim:PhaseCode.s1N
                                              cim:PhaseCode.s2
                                              cim:PhaseCode.s2N)];
              cimdoc:cimPackage "IEC61970.Base.Core";
              cimdoc:packageTier "Normative".
cim:PhaseCode.A a owl:NamedIndividual,
                  cim:PhaseCode;
                rdfs:comment "Phase A."@en;
