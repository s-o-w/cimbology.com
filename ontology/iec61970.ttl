                                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                          rdfs:label "PenstockLossCurve"@en;
                                          rdfs:range cim:PenstockLossCurve.
cim:HydroGeneratingUnit.TailbayLossCurve a owl:ObjectProperty;
                                         rdfs:comment "A hydro generating unit has a tailbay loss curve."@en;
