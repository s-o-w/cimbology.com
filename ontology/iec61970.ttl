cim:PFVArType1IEEEVArController.vvar a owl:DatatypeProperty;
                                     rdfs:comment "Synchronous machine power factor (VVAR)."@en;
                                     rdfs:domain cim:PFVArType1IEEEVArController;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                     rdfs:label "vvar"@en;
