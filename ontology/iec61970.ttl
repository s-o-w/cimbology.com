                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "tf"@en;
                   rdfs:range cim:Seconds.
cim:ExcIEEEST1A.uelin a owl:ObjectProperty;
                      rdfs:comment "Selector of the connection of the UEL input (UELin). Typical value = ignoreUELsignal."@en;
                      rdfs:domain cim:ExcIEEEST1A;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "uelin"@en;
                      rdfs:range cim:ExcIEEEST1AUELselectorKind.
cim:ExcIEEEST1A.vamax a owl:DatatypeProperty;
                      rdfs:comment "Maximum voltage regulator output (VAMAX) (greater than 0). Typical value = 14,5."@en;
                      rdfs:domain cim:ExcIEEEST1A;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "vamax"@en;
                      rdfs:range cim:PU.
cim:ExcIEEEST1A.vamin a owl:DatatypeProperty;
                      rdfs:comment "Minimum voltage regulator output (VAMIN) (less than 0). Typical value = -14,5."@en;
                      rdfs:domain cim:ExcIEEEST1A;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "vamin"@en;
                      rdfs:range cim:PU.
cim:ExcIEEEST1A.vimax a owl:DatatypeProperty;
                      rdfs:comment "Maximum voltage regulator input limit (VIMAX) (greater than 0). Typical value = 999."@en;
                      rdfs:domain cim:ExcIEEEST1A;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "vimax"@en;
                      rdfs:range cim:PU.
cim:ExcIEEEST1A.vimin a owl:DatatypeProperty;
                      rdfs:comment "Minimum voltage regulator input limit (VIMIN) (less than 0). Typical value = -999."@en;
                      rdfs:domain cim:ExcIEEEST1A;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "vimin"@en;
                      rdfs:range cim:PU.
cim:ExcIEEEST1A.vrmax a owl:DatatypeProperty;
                      rdfs:comment "Maximum voltage regulator outputs (VRMAX) (> 0). Typical value = 7,8."@en;
                      rdfs:domain cim:ExcIEEEST1A;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "vrmax"@en;
                      rdfs:range cim:PU.
cim:ExcIEEEST1A.vrmin a owl:DatatypeProperty;
                      rdfs:comment "Minimum voltage regulator outputs (VRMIN) (less than 0). Typical value = -6,7."@en;
                      rdfs:domain cim:ExcIEEEST1A;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "vrmin"@en;
                      rdfs:range cim:PU.
cim:ExcIEEEST1AUELselectorKind a owl:Class;
                               rdfs:comment "Types of connections for the UEL input used in ExcIEEEST1A."@en;
