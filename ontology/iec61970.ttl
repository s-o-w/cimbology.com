cim:ExcIEEEST1A a owl:Class;
                rdfs:comment "IEEE 421.5-2005 type ST1A model. This model represents systems in which excitation power is supplied through a transformer from the generator terminals (or the unit�s auxiliary bus) and is regulated by a controlled rectifier. The maximum exciter voltage available from such systems is directly related to the generator terminal voltage. Reference: IEEE 421.5-2005, 7.1."@en;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "ExcIEEEST1A"@en;
                rdfs:subClassOf cim:ExcitationSystemDynamics;
                cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.ExcitationSystemDynamics";
                cimdoc:packageTier "Normative".
cim:ExcIEEEST1A.ilr a owl:DatatypeProperty;
                    rdfs:comment "Exciter output current limit reference (ILR). Typical value = 0."@en;
                    rdfs:domain cim:ExcIEEEST1A;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "ilr"@en;
                    rdfs:range cim:PU.
cim:ExcIEEEST1A.ka a owl:DatatypeProperty;
                   rdfs:comment "Voltage regulator gain (KA) (> 0). Typical value = 190."@en;
                   rdfs:domain cim:ExcIEEEST1A;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "ka"@en;
                   rdfs:range cim:PU.
cim:ExcIEEEST1A.kc a owl:DatatypeProperty;
                   rdfs:comment "Rectifier loading factor proportional to commutating reactance (KC) (>= 0). Typical value = 0,08."@en;
                   rdfs:domain cim:ExcIEEEST1A;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "kc"@en;
                   rdfs:range cim:PU.
cim:ExcIEEEST1A.kf a owl:DatatypeProperty;
                   rdfs:comment "Excitation control system stabilizer gains (KF) (>= 0). Typical value = 0."@en;
                   rdfs:domain cim:ExcIEEEST1A;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "kf"@en;
                   rdfs:range cim:PU.
cim:ExcIEEEST1A.klr a owl:DatatypeProperty;
                    rdfs:comment "Exciter output current limiter gain (KLR). Typical value = 0."@en;
                    rdfs:domain cim:ExcIEEEST1A;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "klr"@en;
                    rdfs:range cim:PU.
cim:ExcIEEEST1A.pssin a owl:DatatypeProperty;
                      rdfs:comment "Selector of the Power System Stabilizer (PSS) input (PSSin). true = PSS input (Vs) added to error signal false = PSS input (Vs) added to voltage regulator output. Typical value = true."@en;
                      rdfs:domain cim:ExcIEEEST1A;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "pssin"@en;
                      rdfs:range xsd:boolean.
cim:ExcIEEEST1A.ta a owl:DatatypeProperty;
                   rdfs:comment "Voltage regulator time constant (TA) (>= 0). Typical value = 0."@en;
                   rdfs:domain cim:ExcIEEEST1A;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "ta"@en;
                   rdfs:range cim:Seconds.
cim:ExcIEEEST1A.tb a owl:DatatypeProperty;
                   rdfs:comment "Voltage regulator time constant (TB) (>= 0). Typical value = 10."@en;
                   rdfs:domain cim:ExcIEEEST1A;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "tb"@en;
                   rdfs:range cim:Seconds.
cim:ExcIEEEST1A.tb1 a owl:DatatypeProperty;
                    rdfs:comment "Voltage regulator time constant (TB1) (>= 0). Typical value = 0."@en;
                    rdfs:domain cim:ExcIEEEST1A;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "tb1"@en;
                    rdfs:range cim:Seconds.
cim:ExcIEEEST1A.tc a owl:DatatypeProperty;
                   rdfs:comment "Voltage regulator time constant (TC) (>= 0). Typical value = 1."@en;
                   rdfs:domain cim:ExcIEEEST1A;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "tc"@en;
                   rdfs:range cim:Seconds.
cim:ExcIEEEST1A.tc1 a owl:DatatypeProperty;
                    rdfs:comment "Voltage regulator time constant (TC1) (>= 0). Typical value = 0."@en;
                    rdfs:domain cim:ExcIEEEST1A;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "tc1"@en;
