                                                      rdfs:label "inputHVgateErrorSignal"@en;
                                                      cimdoc:enumCode 2 .
cim:ExcIEEEST1AUELselectorKind.inputHVgateVoltageOutput a owl:NamedIndividual,
                                                          cim:ExcIEEEST1AUELselectorKind;
                                                        rdfs:comment "UEL input HV gate with voltage regulator output."@en;
                                                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
