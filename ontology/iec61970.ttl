                          rdfs:label "PublicX509Certificate"@en;
                          cimdoc:cimPackage "IEC61970.Base.ICCPConfiguration";
                          cimdoc:packageTier "Normative".
cim:PublicX509Certificate.ISOUpperLayer a owl:ObjectProperty;
                                        rdfs:comment "Application layer used with the certificate for mutual authentication."@en;
                                        rdfs:domain cim:PublicX509Certificate;
                                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                        rdfs:label "ISOUpperLayer"@en;
                                        rdfs:range cim:ISOUpperLayer.
cim:PublicX509Certificate.TCPAccessPoint a owl:ObjectProperty;
                                         rdfs:comment "The association allows a certificate to be bound for use by TLS."@en;
                                         rdfs:domain cim:PublicX509Certificate;
                                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                         rdfs:label "TCPAccessPoint"@en;
                                         rdfs:range cim:TCPAccessPoint.
cim:PublicX509Certificate.issuerName a owl:DatatypeProperty;
