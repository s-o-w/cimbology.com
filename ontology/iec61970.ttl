cim:HeatInputCurve.heatInputEff a owl:DatatypeProperty;
                                rdfs:comment "Heat input - efficiency multiplier adjustment factor."@en;
                                rdfs:domain cim:HeatInputCurve;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "heatInputEff"@en;
                                rdfs:range cim:PU.
cim:HeatInputCurve.heatInputOffset a owl:DatatypeProperty;
                                   rdfs:comment "Heat input - offset adjustment factor."@en;
                                   rdfs:domain cim:HeatInputCurve;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                   rdfs:label "heatInputOffset"@en;
                                   rdfs:range cim:HeatRate.
cim:HeatInputCurve.isNetGrossP a owl:DatatypeProperty;
                               rdfs:comment "Flag is set to true when output is expressed in net active power."@en;
                               rdfs:domain cim:HeatInputCurve;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
