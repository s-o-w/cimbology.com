cim:GovHydro2.tg a owl:DatatypeProperty;
                 rdfs:comment "Gate servo time constant (Tg) (> 0). Typical value = 0,5."@en;
                 rdfs:domain cim:GovHydro2;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "tg"@en;
                 rdfs:range cim:Seconds.
cim:GovHydro2.tp a owl:DatatypeProperty;
                 rdfs:comment "Pilot servo valve time constant (Tp) (>= 0). Typical value = 0,03."@en;
                 rdfs:domain cim:GovHydro2;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "tp"@en;
                 rdfs:range cim:Seconds.
cim:GovHydro2.tr a owl:DatatypeProperty;
                 rdfs:comment "Dashpot time constant (Tr) (>= 0). Typical value = 12."@en;
                 rdfs:domain cim:GovHydro2;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "tr"@en;
                 rdfs:range cim:Seconds.
cim:GovHydro2.tw a owl:DatatypeProperty;
                 rdfs:comment "Water inertia time constant (Tw) (>= 0). Typical value = 2."@en;
                 rdfs:domain cim:GovHydro2;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "tw"@en;
                 rdfs:range cim:Seconds.
cim:GovHydro2.uc a owl:DatatypeProperty;
                 rdfs:comment "Maximum gate closing velocity (Uc) (< 0). Unit = PU / s. Typical value = -0,1."@en;
                 rdfs:domain cim:GovHydro2;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "uc"@en;
                 rdfs:range xsd:float.
cim:GovHydro2.uo a owl:DatatypeProperty;
                 rdfs:comment "Maximum gate opening velocity (Uo). Unit = PU / s. Typical value = 0,1."@en;
                 rdfs:domain cim:GovHydro2;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "uo"@en;
                 rdfs:range xsd:float.
cim:GovHydro3 a owl:Class;
              rdfs:comment """Modified IEEE hydro governor-turbine. This model differs from that defined in the IEEE modelling guideline paper in that the limits on gate position and velocity do not permit \"wind up\" of the upstream signals."""@en;
              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
              rdfs:label "GovHydro3"@en;
              rdfs:subClassOf cim:TurbineGovernorDynamics;
              cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.TurbineGovernorDynamics";
              cimdoc:packageTier "Normative".
cim:GovHydro3.at a owl:DatatypeProperty;
                 rdfs:comment "Turbine gain (At) (>0). Typical value = 1,2."@en;
                 rdfs:domain cim:GovHydro3;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "at"@en;
                 rdfs:range cim:PU.
cim:GovHydro3.db1 a owl:DatatypeProperty;
                  rdfs:comment "Intentional dead-band width (db1). Unit = Hz. Typical value = 0."@en;
                  rdfs:domain cim:GovHydro3;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "db1"@en;
                  rdfs:range cim:Frequency.
cim:GovHydro3.db2 a owl:DatatypeProperty;
                  rdfs:comment "Unintentional dead-band (db2). Unit = MW. Typical value = 0."@en;
                  rdfs:domain cim:GovHydro3;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "db2"@en;
                  rdfs:range cim:ActivePower.
cim:GovHydro3.dturb a owl:DatatypeProperty;
                    rdfs:comment "Turbine damping factor (Dturb). Typical value = 0,2."@en;
                    rdfs:domain cim:GovHydro3;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "dturb"@en;
                    rdfs:range cim:PU.
cim:GovHydro3.eps a owl:DatatypeProperty;
                  rdfs:comment "Intentional db hysteresis (eps). Unit = Hz. Typical value = 0."@en;
                  rdfs:domain cim:GovHydro3;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "eps"@en;
                  rdfs:range cim:Frequency.
cim:GovHydro3.governorControl a owl:DatatypeProperty;
                              rdfs:comment "Governor control flag (Cflag). true = PID control is active false = double derivative control is active. Typical value = true."@en;
                              rdfs:domain cim:GovHydro3;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "governorControl"@en;
                              rdfs:range xsd:boolean.
cim:GovHydro3.gv1 a owl:DatatypeProperty;
                  rdfs:comment "Nonlinear gain point 1, PU gv (Gv1). Typical value = 0."@en;
                  rdfs:domain cim:GovHydro3;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "gv1"@en;
                  rdfs:range cim:PU.
cim:GovHydro3.gv2 a owl:DatatypeProperty;
