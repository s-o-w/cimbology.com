                      rdfs:label "seve1"@en;
                      rdfs:range xsd:float.
cim:ExcIEEEAC7B.seve2 a owl:DatatypeProperty;
                      rdfs:comment "Exciter saturation function value at the corresponding exciter voltage, VE2, back of commutating reactance (SE[VE2]) (>= 0). Typical value = 0,075."@en;
                      rdfs:domain cim:ExcIEEEAC7B;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "seve2"@en;
                      rdfs:range xsd:float.
cim:ExcIEEEAC7B.tdr a owl:DatatypeProperty;
                    rdfs:comment "Lag time constant (TDR) (>= 0). Typical value = 0."@en;
                    rdfs:domain cim:ExcIEEEAC7B;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "tdr"@en;
                    rdfs:range cim:Seconds.
cim:ExcIEEEAC7B.te a owl:DatatypeProperty;
                   rdfs:comment "Exciter time constant, integration rate associated with exciter control (TE) (> 0). Typical value = 1,1."@en;
                   rdfs:domain cim:ExcIEEEAC7B;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "te"@en;
                   rdfs:range cim:Seconds.
cim:ExcIEEEAC7B.tf a owl:DatatypeProperty;
                   rdfs:comment "Excitation control system stabilizer time constant (TF) (> 0). Typical value = 1."@en;
                   rdfs:domain cim:ExcIEEEAC7B;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "tf"@en;
                   rdfs:range cim:Seconds.
cim:ExcIEEEAC7B.vamax a owl:DatatypeProperty;
                      rdfs:comment "Maximum voltage regulator output (VAMAX) (greater than 0). Typical value = 1."@en;
                      rdfs:domain cim:ExcIEEEAC7B;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "vamax"@en;
                      rdfs:range cim:PU.
cim:ExcIEEEAC7B.vamin a owl:DatatypeProperty;
                      rdfs:comment "Minimum voltage regulator output (VAMIN) (less than 0). Typical value = -0,95."@en;
                      rdfs:domain cim:ExcIEEEAC7B;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "vamin"@en;
                      rdfs:range cim:PU.
cim:ExcIEEEAC7B.ve1 a owl:DatatypeProperty;
                    rdfs:comment "Exciter alternator output voltages back of commutating reactance at which saturation is defined (VE1) (> 0). Typical value = 6, 3."@en;
                    rdfs:domain cim:ExcIEEEAC7B;
