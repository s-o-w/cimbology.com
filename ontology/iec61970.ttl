cim:RemoteSource a owl:Class;
                 rdfs:comment "Remote sources are state variables that are telemetered or calculated within the remote unit."@en;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "RemoteSource"@en;
                 rdfs:subClassOf cim:RemotePoint;
                 cimdoc:cimPackage "IEC61970.Base.SCADA";
                 cimdoc:packageTier "Normative".
cim:RemoteSource.deadband a owl:DatatypeProperty;
                          rdfs:comment "The smallest change in value to be reported."@en;
                          rdfs:domain cim:RemoteSource;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                          rdfs:label "deadband"@en;
                          rdfs:range xsd:float.
cim:RemoteSource.scanInterval a owl:DatatypeProperty;
                              rdfs:comment "The time interval between scans."@en;
                              rdfs:domain cim:RemoteSource;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "scanInterval"@en;
                              rdfs:range cim:Seconds.
cim:RemoteSource.sensorMaximum a owl:DatatypeProperty;
                               rdfs:comment "The maximum value the telemetry item can return."@en;
                               rdfs:domain cim:RemoteSource;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "sensorMaximum"@en;
                               rdfs:range xsd:float.
cim:RemoteSource.sensorMinimum a owl:DatatypeProperty;
                               rdfs:comment "The minimum value the telemetry item can return."@en;
                               rdfs:domain cim:RemoteSource;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "sensorMinimum"@en;
                               rdfs:range xsd:float.
cim:RemoteUnit a owl:Class;
               rdfs:comment "A remote unit can be an RTU, IED, substation control system, control centre, etc. The communication with the remote unit can be through various standard protocols (e.g. IEC 61870, IEC 61850) or non standard protocols (e.g. DNP, RP570, etc.). A remote unit contains remote data points that might be telemetered, collected or calculated. The RemoteUnit class inherits PowerSystemResource. The intention is to allow RemoteUnits to have Measurements. These Measurements can be used to model unit status as operational, out of service, unit failure, etc."@en;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "RemoteUnit"@en;
               rdfs:subClassOf cim:PowerSystemResource;
               cimdoc:cimPackage "IEC61970.Base.SCADA";
               cimdoc:packageTier "Normative".
cim:RemoteUnit.RemotePoints a owl:ObjectProperty;
                            rdfs:comment "Remote points this Remote unit contains."@en;
                            rdfs:domain cim:RemoteUnit;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "RemotePoints"@en;
                            rdfs:range cim:RemotePoint.
cim:RemoteUnit.remoteUnitType a owl:ObjectProperty;
                              rdfs:comment "Type of remote unit."@en;
                              rdfs:domain cim:RemoteUnit;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "remoteUnitType"@en;
                              rdfs:range cim:RemoteUnitType.
cim:RemoteUnitType a owl:Class;
                   rdfs:comment "Type of remote unit."@en;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "RemoteUnitType"@en;
                   owl:equivalentClass [a owl:Class ; 
                                        owl:oneOf (cim:RemoteUnitType.ControlCenter
                                                   cim:RemoteUnitType.IED
                                                   cim:RemoteUnitType.RTU
                                                   cim:RemoteUnitType.SubstationControlSystem)];
                   cimdoc:cimPackage "IEC61970.Base.SCADA";
                   cimdoc:packageTier "Normative".
cim:RemoteUnitType.ControlCenter a owl:NamedIndividual,
                                   cim:RemoteUnitType;
                                 rdfs:comment "Control centre."@en;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "ControlCenter"@en;
                                 cimdoc:enumCode 2 .
cim:RemoteUnitType.IED a owl:NamedIndividual,
                         cim:RemoteUnitType;
                       rdfs:comment "Intelligent electronic device (IED)."@en;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "IED"@en;
                       cimdoc:enumCode 3 .
cim:RemoteUnitType.RTU a owl:NamedIndividual,
                         cim:RemoteUnitType;
                       rdfs:comment "Remote terminal unit."@en;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "RTU"@en;
                       cimdoc:enumCode 0 .
cim:RemoteUnitType.SubstationControlSystem a owl:NamedIndividual,
                                             cim:RemoteUnitType;
                                           rdfs:comment "Substation control system."@en;
                                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                           rdfs:label "SubstationControlSystem"@en;
                                           cimdoc:enumCode 1 .
cim:ReportingGroup a owl:Class;
                   rdfs:comment "A reporting group is used for various ad-hoc groupings used for reporting."@en;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "ReportingGroup"@en;
                   rdfs:subClassOf cim:IdentifiedObject;
                   cimdoc:cimPackage "IEC61970.Base.Core";
                   cimdoc:packageTier "Normative".
cim:ReportingGroup.PowerSystemResource a owl:ObjectProperty;
                                       rdfs:comment "Power system resources which belong to this reporting group."@en;
                                       rdfs:domain cim:ReportingGroup;
                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                       rdfs:label "PowerSystemResource"@en;
                                       rdfs:range cim:PowerSystemResource.
cim:ReportingSuperGroup a owl:Class;
                        rdfs:comment "A reporting super group, groups reporting groups for a higher level report."@en;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                        rdfs:label "ReportingSuperGroup"@en;
                        rdfs:subClassOf cim:IdentifiedObject;
                        cimdoc:cimPackage "IEC61970.Base.Core";
                        cimdoc:packageTier "Normative".
cim:ReportingSuperGroup.ReportingGroup a owl:ObjectProperty;
                                       rdfs:comment "Reporting groups that are grouped under this super group."@en;
                                       rdfs:domain cim:ReportingSuperGroup;
                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                       rdfs:label "ReportingGroup"@en;
                                       rdfs:range cim:ReportingGroup.
cim:Reservoir a owl:Class;
              rdfs:comment "A water storage facility within a hydro system, including: ponds, lakes, lagoons, and rivers. The storage is usually behind some type of dam."@en;
              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
              rdfs:label "Reservoir"@en;
              rdfs:subClassOf cim:PowerSystemResource;
              cimdoc:cimPackage "IEC61970.Base.Generation.Production";
              cimdoc:packageTier "Normative".
cim:Reservoir.InflowForecasts a owl:ObjectProperty;
                              rdfs:comment """A reservoir may have a \"natural\" inflow forecast."""@en;
                              rdfs:domain cim:Reservoir;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "InflowForecasts"@en;
                              rdfs:range cim:InflowForecast.
cim:Reservoir.LevelVsVolumeCurves a owl:ObjectProperty;
                                  rdfs:comment "A reservoir may have a level versus volume relationship."@en;
                                  rdfs:domain cim:Reservoir;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "LevelVsVolumeCurves"@en;
                                  rdfs:range cim:LevelVsVolumeCurve.
cim:Reservoir.SpillsIntoReservoirs a owl:ObjectProperty;
                                   rdfs:comment "A reservoir may spill into a downstream reservoir."@en;
                                   rdfs:domain cim:Reservoir;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                   rdfs:label "SpillsIntoReservoirs"@en;
                                   rdfs:range cim:Reservoir.
cim:Reservoir.TargetLevelSchedule a owl:ObjectProperty;
                                  rdfs:comment "A reservoir may have a water level target schedule."@en;
                                  rdfs:domain cim:Reservoir;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "TargetLevelSchedule"@en;
                                  rdfs:range cim:TargetLevelSchedule.
cim:Reservoir.activeStorageCapacity a owl:DatatypeProperty;
                                    rdfs:comment "Storage volume between the full supply level and the normal minimum operating level."@en;
                                    rdfs:domain cim:Reservoir;
                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                    rdfs:label "activeStorageCapacity"@en;
                                    rdfs:range cim:Volume.
cim:Reservoir.energyStorageRating a owl:DatatypeProperty;
                                  rdfs:comment "The reservoir's energy storage rating in energy for given head conditions."@en;
                                  rdfs:domain cim:Reservoir;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "energyStorageRating"@en;
                                  rdfs:range xsd:float.
cim:Reservoir.fullSupplyLevel a owl:DatatypeProperty;
                              rdfs:comment "Full supply level, above which water will spill. This can be the spillway crest level or the top of closed gates."@en;
                              rdfs:domain cim:Reservoir;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "fullSupplyLevel"@en;
                              rdfs:range cim:WaterLevel.
cim:Reservoir.grossCapacity a owl:DatatypeProperty;
                            rdfs:comment "Total capacity of reservoir."@en;
                            rdfs:domain cim:Reservoir;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "grossCapacity"@en;
                            rdfs:range cim:Volume.
cim:Reservoir.normalMinOperateLevel a owl:DatatypeProperty;
                                    rdfs:comment "Normal minimum operating level below which the penstocks will draw air."@en;
                                    rdfs:domain cim:Reservoir;
                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                    rdfs:label "normalMinOperateLevel"@en;
                                    rdfs:range cim:WaterLevel.
cim:Reservoir.riverOutletWorks a owl:DatatypeProperty;
                               rdfs:comment "River outlet works for riparian right releases or other purposes."@en;
                               rdfs:domain cim:Reservoir;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "riverOutletWorks"@en;
                               rdfs:range xsd:string.
cim:Reservoir.spillTravelDelay a owl:DatatypeProperty;
                               rdfs:comment "The spillway water travel delay to the next downstream reservoir."@en;
                               rdfs:domain cim:Reservoir;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "spillTravelDelay"@en;
                               rdfs:range cim:Seconds.
cim:Reservoir.spillWayGateType a owl:DatatypeProperty;
                               rdfs:comment "Type of spillway gate, including parameters."@en;
                               rdfs:domain cim:Reservoir;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "spillWayGateType"@en;
                               rdfs:range xsd:string.
cim:Reservoir.spillwayCapacity a owl:DatatypeProperty;
