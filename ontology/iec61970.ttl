                  rdfs:comment "Gate servo time constant (Tp) (>= 0). If = 0, block is bypassed. Typical value = 0,35."@en;
                  rdfs:domain cim:GovHydroDD;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
