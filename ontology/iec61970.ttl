cim:GovGAST1.gv3 a owl:DatatypeProperty;
                 rdfs:comment "Nonlinear gain point 3, PU gv (Gv3). Typical value = 0."@en;
                 rdfs:domain cim:GovGAST1;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "gv3"@en;
                 rdfs:range cim:PU.
cim:GovGAST1.gv4 a owl:DatatypeProperty;
                 rdfs:comment "Nonlinear gain point 4, PU gv (Gv4). Typical value = 0."@en;
                 rdfs:domain cim:GovGAST1;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "gv4"@en;
