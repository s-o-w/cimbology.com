cim:FrequencyConverter a owl:Class;
                       rdfs:comment "A device to convert from one frequency to another (e.g., frequency F1 to F2) comprises a pair of FrequencyConverter instances. One converts from F1 to DC, the other converts the DC to F2."@en;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "FrequencyConverter"@en;
                       rdfs:subClassOf cim:RegulatingCondEq;
                       cimdoc:cimPackage "IEC61970.Base.Wires";
                       cimdoc:packageTier "Normative".
cim:FrequencyConverter.frequency a owl:DatatypeProperty;
                                 rdfs:comment "Frequency on the AC side."@en;
