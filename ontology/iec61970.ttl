cim:Pss2B.t3 a owl:DatatypeProperty;
             rdfs:comment "Lead/lag time constant (T3) (>= 0). Typical value = 0, 3."@en;
             rdfs:domain cim:Pss2B;
             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
             rdfs:label "t3"@en;
             rdfs:range cim:Seconds.
cim:Pss2B.t4 a owl:DatatypeProperty;
             rdfs:comment "Lead/lag time constant (T4) (>= 0). Typical value = 0, 02."@en;
             rdfs:domain cim:Pss2B;
             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
             rdfs:label "t4"@en;
