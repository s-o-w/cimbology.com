                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "gv3"@en;
                   rdfs:range cim:PU.
cim:GovHydroDD.gv4 a owl:DatatypeProperty;
                   rdfs:comment "Nonlinear gain point 4, PU gv (Gv4). Typical value = 0."@en;
                   rdfs:domain cim:GovHydroDD;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
