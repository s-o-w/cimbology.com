                 cimdoc:packageTier "Informative".
cim:CurrentTransformer a owl:Class;
                       rdfs:comment "Instrument transformer used to measure electrical qualities of the circuit that is being protected and/or monitored. Typically used as current transducer for the purpose of metering or protection. A typical secondary current rating would be 5A."@en;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "CurrentTransformer"@en;
                       rdfs:subClassOf cim:Sensor;
                       cimdoc:cimPackage "IEC61970.Base.AuxiliaryEquipment";
                       cimdoc:packageTier "Normative".
cim:CurrentTransformer.accuracyClass a owl:DatatypeProperty;
                                     rdfs:comment "CT accuracy classification."@en;
                                     rdfs:domain cim:CurrentTransformer;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                     rdfs:label "accuracyClass"@en;
                                     rdfs:range xsd:string.
cim:CurrentTransformer.accuracyLimit a owl:DatatypeProperty;
                                     rdfs:comment "Percent of rated current for which the CT remains accurate within specified limits."@en;
                                     rdfs:domain cim:CurrentTransformer;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                     rdfs:label "accuracyLimit"@en;
                                     rdfs:range cim:PerCent.
cim:CurrentTransformer.coreBurden a owl:DatatypeProperty;
                                  rdfs:comment "Power burden of the CT core."@en;
                                  rdfs:domain cim:CurrentTransformer;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "coreBurden"@en;
                                  rdfs:range cim:ActivePower.
cim:CurrentTransformer.ctClass a owl:DatatypeProperty;
                               rdfs:comment "CT classification; i.e. class 10P."@en;
                               rdfs:domain cim:CurrentTransformer;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "ctClass"@en;
                               rdfs:range xsd:string.
cim:CurrentTransformer.usage a owl:DatatypeProperty;
                             rdfs:comment "Intended usage of the CT; i.e. metering, protection."@en;
                             rdfs:domain cim:CurrentTransformer;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "usage"@en;
                             rdfs:range xsd:string.
cim:Curve a owl:Class;
          rdfs:comment "A multi-purpose curve or functional relationship between an independent variable (X-axis) and dependent (Y-axis) variables."@en;
          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
          rdfs:label "Curve"@en;
          rdfs:subClassOf cim:IdentifiedObject;
          cimdoc:cimPackage "IEC61970.Base.Core";
          cimdoc:packageTier "Normative".
cim:Curve.CurveDatas a owl:ObjectProperty;
                     rdfs:comment "The point data values that define this curve."@en;
                     rdfs:domain cim:Curve;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                     rdfs:label "CurveDatas"@en;
                     rdfs:range cim:CurveData.
cim:Curve.curveStyle a owl:ObjectProperty;
                     rdfs:comment "The style or shape of the curve."@en;
                     rdfs:domain cim:Curve;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                     rdfs:label "curveStyle"@en;
                     rdfs:range cim:CurveStyle.
cim:Curve.xMultiplier a owl:ObjectProperty;
                      rdfs:comment "Multiplier for X-axis."@en;
                      rdfs:domain cim:Curve;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "xMultiplier"@en;
                      rdfs:range cim:UnitMultiplier.
cim:Curve.xUnit a owl:ObjectProperty;
                rdfs:comment "The X-axis units of measure."@en;
                rdfs:domain cim:Curve;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "xUnit"@en;
                rdfs:range cim:UnitSymbol.
cim:Curve.y1Multiplier a owl:ObjectProperty;
                       rdfs:comment "Multiplier for Y1-axis."@en;
                       rdfs:domain cim:Curve;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "y1Multiplier"@en;
                       rdfs:range cim:UnitMultiplier.
cim:Curve.y1Unit a owl:ObjectProperty;
                 rdfs:comment "The Y1-axis units of measure."@en;
                 rdfs:domain cim:Curve;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "y1Unit"@en;
                 rdfs:range cim:UnitSymbol.
cim:Curve.y2Multiplier a owl:ObjectProperty;
                       rdfs:comment "Multiplier for Y2-axis."@en;
                       rdfs:domain cim:Curve;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "y2Multiplier"@en;
                       rdfs:range cim:UnitMultiplier.
cim:Curve.y2Unit a owl:ObjectProperty;
                 rdfs:comment "The Y2-axis units of measure."@en;
                 rdfs:domain cim:Curve;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "y2Unit"@en;
                 rdfs:range cim:UnitSymbol.
cim:Curve.y3Multiplier a owl:ObjectProperty;
                       rdfs:comment "Multiplier for Y3-axis."@en;
                       rdfs:domain cim:Curve;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "y3Multiplier"@en;
                       rdfs:range cim:UnitMultiplier.
cim:Curve.y3Unit a owl:ObjectProperty;
                 rdfs:comment "The Y3-axis units of measure."@en;
                 rdfs:domain cim:Curve;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "y3Unit"@en;
                 rdfs:range cim:UnitSymbol.
cim:CurveData a owl:Class;
              rdfs:comment "Multi-purpose data points for defining a curve. The use of this generic class is discouraged if a more specific class can be used to specify the X and Y axis values along with their specific data types."@en;
              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
              rdfs:label "CurveData"@en;
              cimdoc:cimPackage "IEC61970.Base.Core";
              cimdoc:packageTier "Normative".
cim:CurveData.xvalue a owl:DatatypeProperty;
                     rdfs:comment "The data value of the X-axis variable, depending on the X-axis units."@en;
                     rdfs:domain cim:CurveData;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                     rdfs:label "xvalue"@en;
                     rdfs:range xsd:float.
cim:CurveData.y1value a owl:DatatypeProperty;
                      rdfs:comment "The data value of the first Y-axis variable, depending on the Y-axis units."@en;
                      rdfs:domain cim:CurveData;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "y1value"@en;
                      rdfs:range xsd:float.
cim:CurveData.y2value a owl:DatatypeProperty;
                      rdfs:comment "The data value of the second Y-axis variable (if present), depending on the Y- axis units."@en;
                      rdfs:domain cim:CurveData;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "y2value"@en;
                      rdfs:range xsd:float.
cim:CurveData.y3value a owl:DatatypeProperty;
                      rdfs:comment "The data value of the third Y-axis variable (if present), depending on the Y- axis units."@en;
                      rdfs:domain cim:CurveData;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "y3value"@en;
                      rdfs:range xsd:float.
cim:CurveStyle a owl:Class;
               rdfs:comment "Style or shape of curve."@en;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "CurveStyle"@en;
               owl:equivalentClass [a owl:Class ; 
                                    owl:oneOf (cim:CurveStyle.constantYValue
                                               cim:CurveStyle.straightLineYValues)];
               cimdoc:cimPackage "IEC61970.Base.Core";
               cimdoc:packageTier "Normative".
cim:CurveStyle.constantYValue a owl:NamedIndividual,
                                cim:CurveStyle;
                              rdfs:comment "The Y-axis values are assumed constant until the next curve point and prior to the first curve point."@en;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "constantYValue"@en;
                              cimdoc:enumCode 0 .
cim:CurveStyle.straightLineYValues a owl:NamedIndividual,
                                     cim:CurveStyle;
                                   rdfs:comment "The Y-axis values are assumed to be a straight line between values. Also known as linear interpolation."@en;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                   rdfs:label "straightLineYValues"@en;
                                   cimdoc:enumCode 1 .
cim:Cut a owl:Class;
        rdfs:comment "A cut separates a line segment into two parts. The cut appears as a switch inserted between these two parts and connects them together. As the cut is normally open there is no galvanic connection between the two line segment parts. But it is possible to close the cut to get galvanic connection. The cut terminals are oriented towards the line segment terminals with the same sequence number. Hence the cut terminal with sequence number equal to 1 is oriented to the line segment's terminal with sequence number equal to 1. The cut terminals also act as connection points for jumpers and other equipment, e.g. a mobile generator. To enable this, connectivity nodes are placed at the cut terminals. Once the connectivity nodes are in place any conducting equipment can be connected at them."@en;
        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
        rdfs:label "Cut"@en;
        rdfs:subClassOf cim:Switch;
        cimdoc:cimPackage "IEC61970.Base.Wires";
        cimdoc:packageTier "Normative".
cim:Cut.ACLineSegment a owl:ObjectProperty;
                      rdfs:comment "The line segment to which the cut is applied."@en;
                      rdfs:domain cim:Cut;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "ACLineSegment"@en;
                      rdfs:range cim:ACLineSegment.
cim:Cut.lengthFromTerminal1 a owl:DatatypeProperty;
                            rdfs:comment "The length to the place where the cut is located starting from side one of the cut line segment, i.e. the line segment Terminal with sequenceNumber equal to 1."@en;
                            rdfs:domain cim:Cut;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "lengthFromTerminal1"@en;
                            rdfs:range cim:Length.
cim:DCBaseTerminal a owl:Class;
                   rdfs:comment "An electrical connection point at a piece of DC conducting equipment. DC terminals are connected at one physical DC node that may have multiple DC terminals connected. A DC node is similar to an AC connectivity node. The model requires that DC connections are distinct from AC connections."@en;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "DCBaseTerminal"@en;
                   rdfs:subClassOf cim:ACDCTerminal;
                   cimdoc:cimPackage "IEC61970.Base.DC";
                   cimdoc:packageTier "Normative".
cim:DCBaseTerminal.DCTopologicalNode a owl:ObjectProperty;
                                     rdfs:comment "See association end Terminal.TopologicalNode."@en;
                                     rdfs:domain cim:DCBaseTerminal;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                     rdfs:label "DCTopologicalNode"@en;
                                     rdfs:range cim:DCTopologicalNode.
cim:DCBreaker a owl:Class;
              rdfs:comment "A breaker within a DC system."@en;
              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
              rdfs:label "DCBreaker"@en;
              rdfs:subClassOf cim:DCSwitch;
              cimdoc:cimPackage "IEC61970.Base.DC";
              cimdoc:packageTier "Normative".
cim:DCBusbar a owl:Class;
             rdfs:comment "A busbar within a DC system."@en;
             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
             rdfs:label "DCBusbar"@en;
             rdfs:subClassOf cim:DCConductingEquipment;
             cimdoc:cimPackage "IEC61970.Base.DC";
             cimdoc:packageTier "Normative".
cim:DCChopper a owl:Class;
              rdfs:comment "Low resistance equipment used in the internal DC circuit to balance voltages. It has typically positive and negative pole terminals and a ground."@en;
              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
              rdfs:label "DCChopper"@en;
              rdfs:subClassOf cim:DCConductingEquipment;
              cimdoc:cimPackage "IEC61970.Base.DC";
              cimdoc:packageTier "Normative".
cim:DCConductingEquipment a owl:Class;
                          rdfs:comment "The parts of the DC power system that are designed to carry current or that are conductively connected through DC terminals."@en;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                          rdfs:label "DCConductingEquipment"@en;
                          rdfs:subClassOf cim:Equipment;
                          cimdoc:cimPackage "IEC61970.Base.DC";
                          cimdoc:packageTier "Normative".
cim:DCConductingEquipment.DCTerminals a owl:ObjectProperty;
                                      rdfs:comment "A DC conducting equipment has DC terminals."@en;
                                      rdfs:domain cim:DCConductingEquipment;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                      rdfs:label "DCTerminals"@en;
                                      rdfs:range cim:DCTerminal.
cim:DCConductingEquipment.ratedUdc a owl:DatatypeProperty;
                                   rdfs:comment "Rated DC device voltage. The attribute shall be a positive value. It is configuration data used in power flow."@en;
                                   rdfs:domain cim:DCConductingEquipment;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                   rdfs:label "ratedUdc"@en;
                                   rdfs:range cim:Voltage.
cim:DCConverterOperatingModeKind a owl:Class;
                                 rdfs:comment "The operating mode of an HVDC bipole."@en;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "DCConverterOperatingModeKind"@en;
                                 owl:equivalentClass [a owl:Class ; 
                                                      owl:oneOf (cim:DCConverterOperatingModeKind.bipolar
                                                                 cim:DCConverterOperatingModeKind.monopolarGroundReturn
                                                                 cim:DCConverterOperatingModeKind.monopolarMetallicReturn)];
                                 cimdoc:cimPackage "IEC61970.Base.DC";
                                 cimdoc:packageTier "Normative".
cim:DCConverterOperatingModeKind.bipolar a owl:NamedIndividual,
                                           cim:DCConverterOperatingModeKind;
                                         rdfs:comment "Bipolar operation."@en;
                                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                         rdfs:label "bipolar"@en;
                                         cimdoc:enumCode 0 .
cim:DCConverterOperatingModeKind.monopolarGroundReturn a owl:NamedIndividual,
                                                         cim:DCConverterOperatingModeKind;
                                                       rdfs:comment "Monopolar operation with ground return."@en;
                                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                       rdfs:label "monopolarGroundReturn"@en;
                                                       cimdoc:enumCode 2 .
cim:DCConverterOperatingModeKind.monopolarMetallicReturn a owl:NamedIndividual,
                                                           cim:DCConverterOperatingModeKind;
                                                         rdfs:comment "Monopolar operation with metallic return."@en;
                                                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                         rdfs:label "monopolarMetallicReturn"@en;
                                                         cimdoc:enumCode 1 .
cim:DCConverterUnit a owl:Class;
                    rdfs:comment "Indivisible operative unit comprising all equipment between the point of common coupling on the AC side and the point of common coupling � DC side, essentially one or more converters, together with one or more converter transformers, converter control equipment, essential protective and switching devices and auxiliaries, if any, used for conversion."@en;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "DCConverterUnit"@en;
                    rdfs:subClassOf cim:DCEquipmentContainer;
                    cimdoc:cimPackage "IEC61970.Base.DC";
                    cimdoc:packageTier "Normative".
cim:DCConverterUnit.operationMode a owl:ObjectProperty;
                                  rdfs:comment "The operating mode of an HVDC bipole (bipolar, monopolar metallic return, etc)."@en;
                                  rdfs:domain cim:DCConverterUnit;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "operationMode"@en;
                                  rdfs:range cim:DCConverterOperatingModeKind.
cim:DCDisconnector a owl:Class;
                   rdfs:comment "A disconnector within a DC system."@en;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "DCDisconnector"@en;
                   rdfs:subClassOf cim:DCSwitch;
                   cimdoc:cimPackage "IEC61970.Base.DC";
                   cimdoc:packageTier "Normative".
cim:DCEquipmentContainer a owl:Class;
                         rdfs:comment "A modelling construct to provide a root class for containment of DC as well as AC equipment. The class differ from the EquipmentContaner for AC in that it may also contain DCNode-s. Hence it can contain both AC and DC equipment."@en;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                         rdfs:label "DCEquipmentContainer"@en;
                         rdfs:subClassOf cim:EquipmentContainer;
                         cimdoc:cimPackage "IEC61970.Base.DC";
                         cimdoc:packageTier "Normative".
cim:DCEquipmentContainer.DCTopologicalNode a owl:ObjectProperty;
                                           rdfs:comment "The topological nodes which belong to this connectivity node container."@en;
                                           rdfs:domain cim:DCEquipmentContainer;
                                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                           rdfs:label "DCTopologicalNode"@en;
                                           rdfs:range cim:DCTopologicalNode.
cim:DCGround a owl:Class;
             rdfs:comment "A ground within a DC system."@en;
             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
             rdfs:label "DCGround"@en;
             rdfs:subClassOf cim:DCConductingEquipment;
             cimdoc:cimPackage "IEC61970.Base.DC";
             cimdoc:packageTier "Normative".
cim:DCGround.inductance a owl:DatatypeProperty;
                        rdfs:comment "Inductance to ground."@en;
                        rdfs:domain cim:DCGround;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                        rdfs:label "inductance"@en;
                        rdfs:range cim:Inductance.
cim:DCGround.r a owl:DatatypeProperty;
               rdfs:comment "Resistance to ground."@en;
               rdfs:domain cim:DCGround;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "r"@en;
               rdfs:range cim:Resistance.
cim:DCLine a owl:Class;
           rdfs:comment "Overhead lines and/or cables connecting two or more HVDC substations."@en;
           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
           rdfs:label "DCLine"@en;
           rdfs:subClassOf cim:DCEquipmentContainer;
           cimdoc:cimPackage "IEC61970.Base.DC";
           cimdoc:packageTier "Normative".
cim:DCLine.Region a owl:ObjectProperty;
                  rdfs:comment "The SubGeographicalRegion containing the DC line."@en;
                  rdfs:domain cim:DCLine;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "Region"@en;
                  rdfs:range cim:SubGeographicalRegion.
cim:DCLineSegment a owl:Class;
                  rdfs:comment "A wire or combination of wires not insulated from one another, with consistent electrical characteristics, used to carry direct current between points in the DC region of the power system."@en;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "DCLineSegment"@en;
                  rdfs:subClassOf cim:DCConductingEquipment;
                  cimdoc:cimPackage "IEC61970.Base.DC";
                  cimdoc:packageTier "Normative".
cim:DCLineSegment.capacitance a owl:DatatypeProperty;
                              rdfs:comment "Capacitance of the DC line segment. Significant for cables only."@en;
                              rdfs:domain cim:DCLineSegment;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "capacitance"@en;
                              rdfs:range cim:Capacitance.
cim:DCLineSegment.inductance a owl:DatatypeProperty;
                             rdfs:comment "Inductance of the DC line segment. Negligible compared with DCSeriesDevice used for smoothing."@en;
                             rdfs:domain cim:DCLineSegment;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "inductance"@en;
                             rdfs:range cim:Inductance.
cim:DCLineSegment.length a owl:DatatypeProperty;
                         rdfs:comment "Segment length for calculating line section capabilities."@en;
                         rdfs:domain cim:DCLineSegment;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                         rdfs:label "length"@en;
                         rdfs:range cim:Length.
cim:DCLineSegment.resistance a owl:DatatypeProperty;
                             rdfs:comment "Resistance of the DC line segment."@en;
                             rdfs:domain cim:DCLineSegment;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "resistance"@en;
                             rdfs:range cim:Resistance.
cim:DCNode a owl:Class;
           rdfs:comment "DC nodes are points where terminals of DC conducting equipment are connected together with zero impedance."@en;
           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
           rdfs:label "DCNode"@en;
           rdfs:subClassOf cim:IdentifiedObject;
           cimdoc:cimPackage "IEC61970.Base.DC";
           cimdoc:packageTier "Normative".
cim:DCNode.DCEquipmentContainer a owl:ObjectProperty;
                                rdfs:comment "The DC container for the DC nodes."@en;
                                rdfs:domain cim:DCNode;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "DCEquipmentContainer"@en;
                                rdfs:range cim:DCEquipmentContainer.
cim:DCNode.DCTerminals a owl:ObjectProperty;
                       rdfs:comment "DC base terminals interconnected with zero impedance at a this DC connectivity node."@en;
                       rdfs:domain cim:DCNode;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "DCTerminals"@en;
                       rdfs:range cim:DCBaseTerminal.
cim:DCNode.DCTopologicalNode a owl:ObjectProperty;
                             rdfs:comment "The DC topological node to which this DC connectivity node is assigned. May depend on the current state of switches in the network."@en;
                             rdfs:domain cim:DCNode;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "DCTopologicalNode"@en;
                             rdfs:range cim:DCTopologicalNode.
cim:DCPolarityKind a owl:Class;
                   rdfs:comment "Polarity for DC circuits."@en;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "DCPolarityKind"@en;
                   owl:equivalentClass [a owl:Class ; 
                                        owl:oneOf (cim:DCPolarityKind.middle
                                                   cim:DCPolarityKind.negative
                                                   cim:DCPolarityKind.positive)];
                   cimdoc:cimPackage "IEC61970.Base.DC";
                   cimdoc:packageTier "Normative".
cim:DCPolarityKind.middle a owl:NamedIndividual,
                            cim:DCPolarityKind;
                          rdfs:comment "Middle pole. The converter terminal is the midpoint in a bipolar or symmetric monopole configuration. The midpoint can be grounded and/or have a metallic return."@en;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                          rdfs:label "middle"@en;
                          cimdoc:enumCode 1 .
cim:DCPolarityKind.negative a owl:NamedIndividual,
                              cim:DCPolarityKind;
                            rdfs:comment "Negative pole. The converter terminal is intended to operate at a negative voltage relative the midpoint or positive terminal."@en;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "negative"@en;
                            cimdoc:enumCode 2 .
cim:DCPolarityKind.positive a owl:NamedIndividual,
                              cim:DCPolarityKind;
                            rdfs:comment "Positive pole. The converter terminal is intended to operate at a positive voltage relative the midpoint or negative terminal."@en;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "positive"@en;
                            cimdoc:enumCode 0 .
cim:DCSeriesDevice a owl:Class;
                   rdfs:comment "A series device within the DC system, typically a reactor used for filtering or smoothing. Needed for transient and short circuit studies."@en;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "DCSeriesDevice"@en;
                   rdfs:subClassOf cim:DCConductingEquipment;
                   cimdoc:cimPackage "IEC61970.Base.DC";
                   cimdoc:packageTier "Normative".
cim:DCSeriesDevice.inductance a owl:DatatypeProperty;
                              rdfs:comment "Inductance of the device."@en;
                              rdfs:domain cim:DCSeriesDevice;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "inductance"@en;
                              rdfs:range cim:Inductance.
cim:DCSeriesDevice.resistance a owl:DatatypeProperty;
                              rdfs:comment "Resistance of the DC device."@en;
                              rdfs:domain cim:DCSeriesDevice;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "resistance"@en;
                              rdfs:range cim:Resistance.
cim:DCShunt a owl:Class;
            rdfs:comment "A shunt device within the DC system, typically used for filtering. Needed for transient and short circuit studies."@en;
            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
            rdfs:label "DCShunt"@en;
            rdfs:subClassOf cim:DCConductingEquipment;
            cimdoc:cimPackage "IEC61970.Base.DC";
            cimdoc:packageTier "Normative".
cim:DCShunt.capacitance a owl:DatatypeProperty;
                        rdfs:comment "Capacitance of the DC shunt."@en;
                        rdfs:domain cim:DCShunt;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                        rdfs:label "capacitance"@en;
                        rdfs:range cim:Capacitance.
cim:DCShunt.resistance a owl:DatatypeProperty;
                       rdfs:comment "Resistance of the DC device."@en;
                       rdfs:domain cim:DCShunt;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "resistance"@en;
                       rdfs:range cim:Resistance.
cim:DCSwitch a owl:Class;
             rdfs:comment "A switch within the DC system."@en;
             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
             rdfs:label "DCSwitch"@en;
             rdfs:subClassOf cim:DCConductingEquipment;
             cimdoc:cimPackage "IEC61970.Base.DC";
             cimdoc:packageTier "Normative".
cim:DCTerminal a owl:Class;
               rdfs:comment "An electrical connection point to generic DC conducting equipment."@en;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "DCTerminal"@en;
               rdfs:subClassOf cim:DCBaseTerminal;
               cimdoc:cimPackage "IEC61970.Base.DC";
               cimdoc:packageTier "Normative".
cim:DCTopologicalIsland a owl:Class;
                        rdfs:comment "An electrically connected subset of the network. DC topological islands can change as the current network state changes, e.g. due to: - disconnect switches or breakers changing state in a SCADA/EMS. - manual creation, change or deletion of topological nodes in a planning tool. Only energised TopologicalNode-s shall be part of the topological island."@en;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                        rdfs:label "DCTopologicalIsland"@en;
                        rdfs:subClassOf cim:IdentifiedObject;
                        cimdoc:cimPackage "IEC61970.Base.DC";
                        cimdoc:packageTier "Normative".
cim:DCTopologicalIsland.DCTopologicalNodes a owl:ObjectProperty;
                                           rdfs:comment "The DC topological nodes in a DC topological island."@en;
                                           rdfs:domain cim:DCTopologicalIsland;
                                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                           rdfs:label "DCTopologicalNodes"@en;
                                           rdfs:range cim:DCTopologicalNode.
cim:DCTopologicalNode a owl:Class;
                      rdfs:comment "DC bus."@en;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "DCTopologicalNode"@en;
                      rdfs:subClassOf cim:IdentifiedObject;
                      cimdoc:cimPackage "IEC61970.Base.DC";
                      cimdoc:packageTier "Normative".
cim:DCvoltageControl a owl:Class;
                     rdfs:comment "DC voltage control used for voltage regulation."@en;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                     rdfs:label "DCvoltageControl"@en;
