                    rdfs:label "rperm"@en;
                    rdfs:range cim:PU.
cim:GovHydro1.rtemp a owl:DatatypeProperty;
                    rdfs:comment "Temporary droop (r) (> GovHydro1.rperm). Typical value = 0,3."@en;
                    rdfs:domain cim:GovHydro1;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
