                                                rdfs:label "m_CompleteModelToBeDeleted"@en;
                                                rdfs:range cim:CompleteModelToBeDeleted.
cim:AsynchronousMachine a owl:Class;
                        rdfs:comment "A rotating machine whose shaft rotates asynchronously with the electrical field. Also known as an induction machine with no external connection to the rotor windings, e.g. squirrel-cage induction machine."@en;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                        rdfs:label "AsynchronousMachine"@en;
                        rdfs:subClassOf cim:RotatingMachine;
                        cimdoc:cimPackage "IEC61970.Base.Wires";
                        cimdoc:packageTier "Normative".
cim:AsynchronousMachine.asynchronousMachineType a owl:ObjectProperty;
                                                rdfs:comment "Indicates the type of Asynchronous Machine (motor or generator)."@en;
                                                rdfs:domain cim:AsynchronousMachine;
                                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                rdfs:label "asynchronousMachineType"@en;
                                                rdfs:range cim:AsynchronousMachineKind.
cim:AsynchronousMachine.converterFedDrive a owl:DatatypeProperty;
                                          rdfs:comment "Indicates whether the machine is a converter fed drive. Used for short circuit data exchange according to IEC 60909."@en;
                                          rdfs:domain cim:AsynchronousMachine;
                                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                          rdfs:label "converterFedDrive"@en;
                                          rdfs:range xsd:boolean.
cim:AsynchronousMachine.efficiency a owl:DatatypeProperty;
                                   rdfs:comment "Efficiency of the asynchronous machine at nominal operation as a percentage. Indicator for converter drive motors. Used for short circuit data exchange according to IEC 60909."@en;
                                   rdfs:domain cim:AsynchronousMachine;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                   rdfs:label "efficiency"@en;
                                   rdfs:range cim:PerCent.
cim:AsynchronousMachine.iaIrRatio a owl:DatatypeProperty;
                                  rdfs:comment "Ratio of locked-rotor current to the rated current of the motor (Ia/Ir). Used for short circuit data exchange according to IEC 60909."@en;
                                  rdfs:domain cim:AsynchronousMachine;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "iaIrRatio"@en;
                                  rdfs:range xsd:float.
cim:AsynchronousMachine.nominalFrequency a owl:DatatypeProperty;
                                         rdfs:comment "Nameplate data indicates if the machine is 50 Hz or 60 Hz."@en;
                                         rdfs:domain cim:AsynchronousMachine;
                                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                         rdfs:label "nominalFrequency"@en;
                                         rdfs:range cim:Frequency.
cim:AsynchronousMachine.nominalSpeed a owl:DatatypeProperty;
                                     rdfs:comment "Nameplate data. Depends on the slip and number of pole pairs."@en;
                                     rdfs:domain cim:AsynchronousMachine;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                     rdfs:label "nominalSpeed"@en;
                                     rdfs:range cim:RotationSpeed.
cim:AsynchronousMachine.polePairNumber a owl:DatatypeProperty;
                                       rdfs:comment "Number of pole pairs of stator. Used for short circuit data exchange according to IEC 60909."@en;
                                       rdfs:domain cim:AsynchronousMachine;
                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                       rdfs:label "polePairNumber"@en;
                                       rdfs:range xsd:integer.
cim:AsynchronousMachine.ratedMechanicalPower a owl:DatatypeProperty;
                                             rdfs:comment "Rated mechanical power (Pr in IEC 60909-0). Used for short circuit data exchange according to IEC 60909."@en;
                                             rdfs:domain cim:AsynchronousMachine;
                                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                             rdfs:label "ratedMechanicalPower"@en;
                                             rdfs:range cim:ActivePower.
cim:AsynchronousMachine.reversible a owl:DatatypeProperty;
                                   rdfs:comment "Indicates for converter drive motors if the power can be reversible. Used for short circuit data exchange according to IEC 60909."@en;
                                   rdfs:domain cim:AsynchronousMachine;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                   rdfs:label "reversible"@en;
                                   rdfs:range xsd:boolean.
cim:AsynchronousMachine.rr1 a owl:DatatypeProperty;
                            rdfs:comment "Damper 1 winding resistance."@en;
                            rdfs:domain cim:AsynchronousMachine;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "rr1"@en;
                            rdfs:range cim:Resistance.
cim:AsynchronousMachine.rr2 a owl:DatatypeProperty;
                            rdfs:comment "Damper 2 winding resistance."@en;
                            rdfs:domain cim:AsynchronousMachine;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "rr2"@en;
                            rdfs:range cim:Resistance.
cim:AsynchronousMachine.rxLockedRotorRatio a owl:DatatypeProperty;
                                           rdfs:comment "Locked rotor ratio (R/X). Used for short circuit data exchange according to IEC 60909."@en;
                                           rdfs:domain cim:AsynchronousMachine;
                                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                           rdfs:label "rxLockedRotorRatio"@en;
                                           rdfs:range xsd:float.
cim:AsynchronousMachine.tpo a owl:DatatypeProperty;
                            rdfs:comment "Transient rotor time constant (greater than tppo)."@en;
                            rdfs:domain cim:AsynchronousMachine;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "tpo"@en;
                            rdfs:range cim:Seconds.
cim:AsynchronousMachine.tppo a owl:DatatypeProperty;
                             rdfs:comment "Sub-transient rotor time constant (greater than 0)."@en;
                             rdfs:domain cim:AsynchronousMachine;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "tppo"@en;
                             rdfs:range cim:Seconds.
cim:AsynchronousMachine.xlr1 a owl:DatatypeProperty;
                             rdfs:comment "Damper 1 winding leakage reactance."@en;
                             rdfs:domain cim:AsynchronousMachine;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "xlr1"@en;
                             rdfs:range cim:Reactance.
cim:AsynchronousMachine.xlr2 a owl:DatatypeProperty;
                             rdfs:comment "Damper 2 winding leakage reactance."@en;
                             rdfs:domain cim:AsynchronousMachine;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "xlr2"@en;
                             rdfs:range cim:Reactance.
cim:AsynchronousMachine.xm a owl:DatatypeProperty;
                           rdfs:comment "Magnetizing reactance."@en;
                           rdfs:domain cim:AsynchronousMachine;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "xm"@en;
                           rdfs:range cim:Reactance.
cim:AsynchronousMachine.xp a owl:DatatypeProperty;
                           rdfs:comment "Transient reactance (unsaturated) (greater than or equal to xpp)."@en;
                           rdfs:domain cim:AsynchronousMachine;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "xp"@en;
                           rdfs:range cim:Reactance.
cim:AsynchronousMachine.xpp a owl:DatatypeProperty;
                            rdfs:comment "Sub-transient reactance (unsaturated)."@en;
                            rdfs:domain cim:AsynchronousMachine;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "xpp"@en;
                            rdfs:range cim:Reactance.
cim:AsynchronousMachine.xs a owl:DatatypeProperty;
                           rdfs:comment "Synchronous reactance (greater than xp)."@en;
                           rdfs:domain cim:AsynchronousMachine;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "xs"@en;
                           rdfs:range cim:Reactance.
cim:AsynchronousMachineDynamics a owl:Class;
                                rdfs:comment "Asynchronous machine whose behaviour is described by reference to a standard model expressed in either time constant reactance form or equivalent circuit form or by definition of a user-defined model. Parameter details: - Asynchronous machine parameters such as Xl, Xs, etc. are actually used as inductances in the model, but are commonly referred to as reactances since, at nominal frequency, the PU values are the same. However, some references use the symbol L instead of X."@en;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "AsynchronousMachineDynamics"@en;
                                rdfs:subClassOf cim:RotatingMachineDynamics;
                                cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.AsynchronousMachineDynamics";
                                cimdoc:packageTier "Normative".
cim:AsynchronousMachineDynamics.AsynchronousMachine a owl:ObjectProperty;
                                                    rdfs:comment "Asynchronous machine to which this asynchronous machine dynamics model applies."@en;
                                                    rdfs:domain cim:AsynchronousMachineDynamics;
                                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                    rdfs:label "AsynchronousMachine"@en;
                                                    rdfs:range cim:AsynchronousMachine.
cim:AsynchronousMachineEquivalentCircuit a owl:Class;
                                         rdfs:comment """The electrical equations of all variations of the asynchronous model are based on the AsynchronousEquivalentCircuit diagram for the direct- and quadrature- axes, with two equivalent rotor windings in each axis. Equations for conversion between equivalent circuit and time constant reactance forms: Xs = Xm + Xl X' = Xl + Xm x Xlr1 / (Xm + Xlr1) X'' = Xl + Xm x Xlr1 x Xlr2 / (Xm x Xlr1 + Xm x Xlr2 + Xlr1 x Xlr2) T'o = (Xm + Xlr1) / (omega0 x Rr1) T''o = (Xm x Xlr1 + Xm x Xlr2 + Xlr1 x Xlr2) / (omega0 x Rr2 x (Xm + Xlr1) Same equations using CIM attributes from AsynchronousMachineTimeConstantReactance class on left of \"=\" and AsynchronousMachineEquivalentCircuit class on right (except as noted): xs = xm + RotatingMachineDynamics.statorLeakageReactance xp = RotatingMachineDynamics.statorLeakageReactance + xm x xlr1 / (xm + xlr1) xpp = RotatingMachineDynamics.statorLeakageReactance + xm x xlr1 x xlr2 / (xm x xlr1 + xm x xlr2 + xlr1 x xlr2) tpo = (xm + xlr1) / (2 x pi x nominal frequency x rr1) tppo = (xm x xlr1 + xm x xlr2 + xlr1 x xlr2) / (2 x pi x nominal frequency x rr2 x (xm + xlr1)."""@en;
                                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                         rdfs:label "AsynchronousMachineEquivalentCircuit"@en;
                                         rdfs:subClassOf cim:AsynchronousMachineDynamics;
                                         cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.AsynchronousMachineDynamics";
                                         cimdoc:packageTier "Normative".
cim:AsynchronousMachineEquivalentCircuit.rr1 a owl:DatatypeProperty;
                                             rdfs:comment "Damper 1 winding resistance."@en;
                                             rdfs:domain cim:AsynchronousMachineEquivalentCircuit;
                                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                             rdfs:label "rr1"@en;
                                             rdfs:range cim:PU.
cim:AsynchronousMachineEquivalentCircuit.rr2 a owl:DatatypeProperty;
                                             rdfs:comment "Damper 2 winding resistance."@en;
                                             rdfs:domain cim:AsynchronousMachineEquivalentCircuit;
                                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                             rdfs:label "rr2"@en;
                                             rdfs:range cim:PU.
cim:AsynchronousMachineEquivalentCircuit.xlr1 a owl:DatatypeProperty;
                                              rdfs:comment "Damper 1 winding leakage reactance."@en;
                                              rdfs:domain cim:AsynchronousMachineEquivalentCircuit;
                                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                              rdfs:label "xlr1"@en;
                                              rdfs:range cim:PU.
cim:AsynchronousMachineEquivalentCircuit.xlr2 a owl:DatatypeProperty;
                                              rdfs:comment "Damper 2 winding leakage reactance."@en;
                                              rdfs:domain cim:AsynchronousMachineEquivalentCircuit;
                                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                              rdfs:label "xlr2"@en;
                                              rdfs:range cim:PU.
cim:AsynchronousMachineEquivalentCircuit.xm a owl:DatatypeProperty;
                                            rdfs:comment "Magnetizing reactance."@en;
                                            rdfs:domain cim:AsynchronousMachineEquivalentCircuit;
                                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                            rdfs:label "xm"@en;
                                            rdfs:range cim:PU.
cim:AsynchronousMachineKind a owl:Class;
                            rdfs:comment "Kind of Asynchronous Machine."@en;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "AsynchronousMachineKind"@en;
                            owl:equivalentClass [a owl:Class ; 
                                                 owl:oneOf (cim:AsynchronousMachineKind.generator
                                                            cim:AsynchronousMachineKind.motor)];
                            cimdoc:cimPackage "IEC61970.Base.Wires";
                            cimdoc:packageTier "Normative".
cim:AsynchronousMachineKind.generator a owl:NamedIndividual,
                                        cim:AsynchronousMachineKind;
                                      rdfs:comment "The Asynchronous Machine is a generator."@en;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                      rdfs:label "generator"@en;
                                      cimdoc:enumCode 0 .
cim:AsynchronousMachineKind.motor a owl:NamedIndividual,
                                    cim:AsynchronousMachineKind;
                                  rdfs:comment "The Asynchronous Machine is a motor."@en;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "motor"@en;
                                  cimdoc:enumCode 1 .
cim:AsynchronousMachineTimeConstantReactance a owl:Class;
                                             rdfs:comment "Parameter details: - If X'' = X', a single cage (one equivalent rotor winding per axis) is modelled. - The �p� in the attribute names is a substitution for a �prime� in the usual parameter notation, e.g. tpo refers to T'o. The parameters used for models expressed in time constant reactance form include: - RotatingMachine.ratedS (MVAbase); - RotatingMachineDynamics.damping (D); - RotatingMachineDynamics.inertia (H); - RotatingMachineDynamics.saturationFactor (S1); - RotatingMachineDynamics.saturationFactor120 (S12); - RotatingMachineDynamics.statorLeakageReactance (Xl); - RotatingMachineDynamics.statorResistance (Rs); - .xs (Xs); - .xp (X'); - .xpp (X''); - .tpo (T'o); - .tppo (T''o)."@en;
                                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                             rdfs:label "AsynchronousMachineTimeConstantReactance"@en;
                                             rdfs:subClassOf cim:AsynchronousMachineDynamics;
                                             cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.AsynchronousMachineDynamics";
                                             cimdoc:packageTier "Normative".
cim:AsynchronousMachineTimeConstantReactance.tpo a owl:DatatypeProperty;
                                                 rdfs:comment "Transient rotor time constant (T'o) (> AsynchronousMachineTimeConstantReactance.tppo). Typical value = 5."@en;
                                                 rdfs:domain cim:AsynchronousMachineTimeConstantReactance;
                                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                 rdfs:label "tpo"@en;
                                                 rdfs:range cim:Seconds.
cim:AsynchronousMachineTimeConstantReactance.tppo a owl:DatatypeProperty;
                                                  rdfs:comment "Subtransient rotor time constant (T''o) (> 0). Typical value = 0,03."@en;
                                                  rdfs:domain cim:AsynchronousMachineTimeConstantReactance;
                                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                  rdfs:label "tppo"@en;
                                                  rdfs:range cim:Seconds.
cim:AsynchronousMachineTimeConstantReactance.xp a owl:DatatypeProperty;
                                                rdfs:comment "Transient reactance (unsaturated) (X') (>= AsynchronousMachineTimeConstantReactance.xpp). Typical value = 0,5."@en;
                                                rdfs:domain cim:AsynchronousMachineTimeConstantReactance;
                                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                rdfs:label "xp"@en;
                                                rdfs:range cim:PU.
cim:AsynchronousMachineTimeConstantReactance.xpp a owl:DatatypeProperty;
                                                 rdfs:comment "Subtransient reactance (unsaturated) (X'') (> RotatingMachineDynamics. statorLeakageReactance). Typical value = 0,2."@en;
                                                 rdfs:domain cim:AsynchronousMachineTimeConstantReactance;
                                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                 rdfs:label "xpp"@en;
                                                 rdfs:range cim:PU.
cim:AsynchronousMachineTimeConstantReactance.xs a owl:DatatypeProperty;
                                                rdfs:comment "Synchronous reactance (Xs) (>= AsynchronousMachineTimeConstantReactance. xp). Typical value = 1,8."@en;
                                                rdfs:domain cim:AsynchronousMachineTimeConstantReactance;
                                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                rdfs:label "xs"@en;
                                                rdfs:range cim:PU.
cim:AsynchronousMachineUserDefined a owl:Class;
                                   rdfs:comment "Asynchronous machine whose dynamic behaviour is described by a user-defined model."@en;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                   rdfs:label "AsynchronousMachineUserDefined"@en;
                                   rdfs:subClassOf cim:AsynchronousMachineDynamics;
                                   cimdoc:cimPackage "IEC61970.Dynamics.UserDefinedModels";
                                   cimdoc:packageTier "Normative".
cim:AsynchronousMachineUserDefined.proprietary a owl:DatatypeProperty;
                                               rdfs:comment "Behaviour is based on a proprietary model as opposed to a detailed model. true = user-defined model is proprietary with behaviour mutually understood by sending and receiving applications and parameters passed as general attributes false = user-defined model is explicitly defined in terms of control blocks and their input and output signals."@en;
                                               rdfs:domain cim:AsynchronousMachineUserDefined;
                                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                               rdfs:label "proprietary"@en;
                                               rdfs:range xsd:boolean.
