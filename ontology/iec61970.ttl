cim:SteamTurbine.reheater2TC a owl:DatatypeProperty;
                             rdfs:comment "Second reheater time constant."@en;
                             rdfs:domain cim:SteamTurbine;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "reheater2TC"@en;
                             rdfs:range cim:Seconds.
cim:SteamTurbine.shaft1PowerHP a owl:DatatypeProperty;
                               rdfs:comment "Fraction of power from shaft 1 high pressure turbine output."@en;
                               rdfs:domain cim:SteamTurbine;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "shaft1PowerHP"@en;
                               rdfs:range xsd:float.
cim:SteamTurbine.shaft1PowerIP a owl:DatatypeProperty;
                               rdfs:comment "Fraction of power from shaft 1 intermediate pressure turbine output."@en;
                               rdfs:domain cim:SteamTurbine;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "shaft1PowerIP"@en;
                               rdfs:range xsd:float.
cim:SteamTurbine.shaft1PowerLP1 a owl:DatatypeProperty;
                                rdfs:comment "Fraction of power from shaft 1 first low pressure turbine output."@en;
                                rdfs:domain cim:SteamTurbine;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "shaft1PowerLP1"@en;
                                rdfs:range xsd:float.
cim:SteamTurbine.shaft1PowerLP2 a owl:DatatypeProperty;
                                rdfs:comment "Fraction of power from shaft 1 second low pressure turbine output."@en;
                                rdfs:domain cim:SteamTurbine;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "shaft1PowerLP2"@en;
                                rdfs:range xsd:float.
cim:SteamTurbine.shaft2PowerHP a owl:DatatypeProperty;
                               rdfs:comment "Fraction of power from shaft 2 high pressure turbine output."@en;
                               rdfs:domain cim:SteamTurbine;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "shaft2PowerHP"@en;
                               rdfs:range xsd:float.
cim:SteamTurbine.shaft2PowerIP a owl:DatatypeProperty;
                               rdfs:comment "Fraction of power from shaft 2 intermediate pressure turbine output."@en;
                               rdfs:domain cim:SteamTurbine;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
