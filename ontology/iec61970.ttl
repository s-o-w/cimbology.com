                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "t3"@en;
                   rdfs:range cim:Seconds.
cim:GovSteamSGO.t4 a owl:DatatypeProperty;
                   rdfs:comment "Delay due to steam inlet volumes associated with steam chest and inlet piping (T4) (>= 0)."@en;
                   rdfs:domain cim:GovSteamSGO;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "t4"@en;
                   rdfs:range cim:Seconds.
cim:GovSteamSGO.t5 a owl:DatatypeProperty;
                   rdfs:comment "Reheater delay including hot and cold leads (T5) (>= 0)."@en;
