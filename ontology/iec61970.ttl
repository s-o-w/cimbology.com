                                                                   cim:ProtectiveActionAdjustmentKind.measurement
                                                                   cim:ProtectiveActionAdjustmentKind.setValue)];
                                   cimdoc:cimPackage "IEC61970.InfIEC61970.InfSIPS";
                                   cimdoc:packageTier "Informative".
