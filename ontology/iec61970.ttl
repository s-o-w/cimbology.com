cim:PssWECC.t6 a owl:DatatypeProperty;
               rdfs:comment "Lag time constant (T6) (>= 0). Typical value = 1,5."@en;
               rdfs:domain cim:PssWECC;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "t6"@en;
               rdfs:range cim:Seconds.
cim:PssWECC.t7 a owl:DatatypeProperty;
               rdfs:comment "Lead time constant (T7) (>= 0). Typical value = 1,7."@en;
               rdfs:domain cim:PssWECC;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
