cim:Subcritical a owl:Class;
                rdfs:comment "Once-through subcritical boiler."@en;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "Subcritical"@en;
                rdfs:subClassOf cim:FossilSteamSupply;
                cimdoc:cimPackage "IEC61970.Base.Generation.GenerationTrainingSimulation";
                cimdoc:packageTier "Normative".
cim:Substation a owl:Class;
               rdfs:comment "A collection of equipment for purposes other than generation or utilization, through which electric energy in bulk is passed for the purposes of switching or modifying its characteristics."@en;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "Substation"@en;
               rdfs:subClassOf cim:EquipmentContainer;
               cimdoc:cimPackage "IEC61970.Base.Core";
               cimdoc:packageTier "Normative".
cim:Substation.Bays a owl:ObjectProperty;
                    rdfs:comment "Bays contained in the substation."@en;
