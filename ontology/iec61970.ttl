                    rdfs:comment "Exciter output current limit reference (ILR) (> 0). Typical value = 4,164."@en;
                    rdfs:domain cim:ExcIEEEST6B;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
