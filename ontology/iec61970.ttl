cim:UnderexcLimIEEE1.tu2 a owl:DatatypeProperty;
                         rdfs:comment "UEL lag time constant (TU2) (>= 0). Typical value = 0, 05."@en;
                         rdfs:domain cim:UnderexcLimIEEE1;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                         rdfs:label "tu2"@en;
