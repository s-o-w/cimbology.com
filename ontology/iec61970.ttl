cim:Pss2B.vsi2max a owl:DatatypeProperty;
                  rdfs:comment "Input signal #2 maximum limit (Vsi2max) (greater than Pss2B.vsi2min). Typical value = 2."@en;
                  rdfs:domain cim:Pss2B;
