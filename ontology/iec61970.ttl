                                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                           rdfs:label "cogenHPSendoutRating"@en;
                                           rdfs:range xsd:float.
cim:CogenerationPlant.cogenHPSteamRating a owl:DatatypeProperty;
                                         rdfs:comment "The high pressure steam rating."@en;
                                         rdfs:domain cim:CogenerationPlant;
                                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                         rdfs:label "cogenHPSteamRating"@en;
                                         rdfs:range xsd:float.
cim:CogenerationPlant.cogenLPSendoutRating a owl:DatatypeProperty;
                                           rdfs:comment "The low pressure steam sendout."@en;
                                           rdfs:domain cim:CogenerationPlant;
                                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                           rdfs:label "cogenLPSendoutRating"@en;
                                           rdfs:range xsd:float.
cim:CogenerationPlant.cogenLPSteamRating a owl:DatatypeProperty;
                                         rdfs:comment "The low pressure steam rating."@en;
                                         rdfs:domain cim:CogenerationPlant;
                                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                         rdfs:label "cogenLPSteamRating"@en;
                                         rdfs:range xsd:float.
cim:CogenerationPlant.ratedP a owl:DatatypeProperty;
                             rdfs:comment "The rated output active power of the cogeneration plant. The attribute shall be a positive value."@en;
                             rdfs:domain cim:CogenerationPlant;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "ratedP"@en;
                             rdfs:range cim:ActivePower.
cim:CombinedCyclePlant a owl:Class;
                       rdfs:comment "A set of combustion turbines and steam turbines where the exhaust heat from the combustion turbines is recovered to make steam for the steam turbines, resulting in greater overall plant efficiency."@en;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "CombinedCyclePlant"@en;
                       rdfs:subClassOf cim:PowerSystemResource;
                       cimdoc:cimPackage "IEC61970.Base.Generation.Production";
                       cimdoc:packageTier "Normative".
cim:CombinedCyclePlant.ThermalGeneratingUnits a owl:ObjectProperty;
                                              rdfs:comment "A thermal generating unit may be a member of a combined cycle plant."@en;
                                              rdfs:domain cim:CombinedCyclePlant;
                                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                              rdfs:label "ThermalGeneratingUnits"@en;
                                              rdfs:range cim:ThermalGeneratingUnit.
cim:CombinedCyclePlant.combCyclePlantRating a owl:DatatypeProperty;
                                            rdfs:comment "The combined cycle plant's active power output rating."@en;
                                            rdfs:domain cim:CombinedCyclePlant;
                                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                            rdfs:label "combCyclePlantRating"@en;
                                            rdfs:range cim:ActivePower.
cim:CombustionTurbine a owl:Class;
                      rdfs:comment "A prime mover that is typically fuelled by gas or light oil."@en;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "CombustionTurbine"@en;
                      rdfs:subClassOf cim:PrimeMover;
                      cimdoc:cimPackage "IEC61970.Base.Generation.GenerationTrainingSimulation";
                      cimdoc:packageTier "Normative".
cim:CombustionTurbine.AirCompressor a owl:ObjectProperty;
                                    rdfs:comment "A CAES air compressor is driven by combustion turbine."@en;
                                    rdfs:domain cim:CombustionTurbine;
                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                    rdfs:label "AirCompressor"@en;
                                    rdfs:range cim:AirCompressor.
cim:CombustionTurbine.CTTempActivePowerCurve a owl:ObjectProperty;
                                             rdfs:comment "A combustion turbine may have an active power versus ambient temperature relationship."@en;
                                             rdfs:domain cim:CombustionTurbine;
                                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                             rdfs:label "CTTempActivePowerCurve"@en;
                                             rdfs:range cim:CTTempActivePowerCurve.
cim:CombustionTurbine.ambientTemp a owl:DatatypeProperty;
                                  rdfs:comment "Default ambient temperature to be used in modelling applications."@en;
                                  rdfs:domain cim:CombustionTurbine;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "ambientTemp"@en;
                                  rdfs:range cim:Temperature.
cim:CombustionTurbine.auxPowerVersusFrequency a owl:DatatypeProperty;
                                              rdfs:comment "Off-nominal frequency effect on turbine auxiliaries. Per unit reduction in auxiliary active power consumption versus per unit reduction in frequency (from rated frequency)."@en;
                                              rdfs:domain cim:CombustionTurbine;
                                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                              rdfs:label "auxPowerVersusFrequency"@en;
                                              rdfs:range cim:PU.
cim:CombustionTurbine.auxPowerVersusVoltage a owl:DatatypeProperty;
                                            rdfs:comment "Off-nominal voltage effect on turbine auxiliaries. Per unit reduction in auxiliary active power consumption versus per unit reduction in auxiliary bus voltage (from a specified voltage level)."@en;
                                            rdfs:domain cim:CombustionTurbine;
                                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                            rdfs:label "auxPowerVersusVoltage"@en;
                                            rdfs:range cim:PU.
cim:CombustionTurbine.capabilityVersusFrequency a owl:DatatypeProperty;
                                                rdfs:comment "Off-nominal frequency effect on turbine capability. Per unit reduction in unit active power capability versus per unit reduction in frequency (from rated frequency)."@en;
                                                rdfs:domain cim:CombustionTurbine;
                                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                rdfs:label "capabilityVersusFrequency"@en;
                                                rdfs:range cim:PU.
cim:CombustionTurbine.heatRecoveryFlag a owl:DatatypeProperty;
                                       rdfs:comment "Flag that is set to true if the combustion turbine is associated with a heat recovery boiler."@en;
                                       rdfs:domain cim:CombustionTurbine;
                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                       rdfs:label "heatRecoveryFlag"@en;
                                       rdfs:range xsd:boolean.
cim:CombustionTurbine.powerVariationByTemp a owl:DatatypeProperty;
                                           rdfs:comment "Per unit change in power per (versus) unit change in ambient temperature."@en;
                                           rdfs:domain cim:CombustionTurbine;
                                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                           rdfs:label "powerVariationByTemp"@en;
                                           rdfs:range cim:PU.
cim:CombustionTurbine.referenceTemp a owl:DatatypeProperty;
                                    rdfs:comment "Reference temperature at which the output of the turbine was defined."@en;
                                    rdfs:domain cim:CombustionTurbine;
                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                    rdfs:label "referenceTemp"@en;
                                    rdfs:range cim:Temperature.
cim:CombustionTurbine.timeConstant a owl:DatatypeProperty;
                                   rdfs:comment "The time constant for the turbine."@en;
                                   rdfs:domain cim:CombustionTurbine;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                   rdfs:label "timeConstant"@en;
                                   rdfs:range cim:Seconds.
cim:Command a owl:Class;
            rdfs:comment "A Command is a discrete control used for supervisory control."@en;
            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
            rdfs:label "Command"@en;
            rdfs:subClassOf cim:Control;
            cimdoc:cimPackage "IEC61970.Base.Meas";
            cimdoc:packageTier "Normative".
cim:Command.ValueAliasSet a owl:ObjectProperty;
                          rdfs:comment "The ValueAliasSet used for translation of a Control value to a name."@en;
                          rdfs:domain cim:Command;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                          rdfs:label "ValueAliasSet"@en;
                          rdfs:range cim:ValueAliasSet.
cim:Command.normalValue a owl:DatatypeProperty;
                        rdfs:comment "Normal value for Control.value e.g. used for percentage scaling."@en;
                        rdfs:domain cim:Command;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                        rdfs:label "normalValue"@en;
                        rdfs:range xsd:integer.
cim:Command.value a owl:DatatypeProperty;
                  rdfs:comment "The value representing the actuator output."@en;
                  rdfs:domain cim:Command;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "value"@en;
                  rdfs:range xsd:integer.
cim:CommunicationLink a owl:Class;
                      rdfs:comment "The connection to remote units is through one or more communication links. Reduntant links may exist. The CommunicationLink class inherits PowerSystemResource. The intention is to allow CommunicationLinks to have Measurements. These Measurements can be used to model link status as operational, out of service, unit failure etc."@en;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "CommunicationLink"@en;
                      rdfs:subClassOf cim:PowerSystemResource;
                      cimdoc:cimPackage "IEC61970.Base.SCADA";
                      cimdoc:packageTier "Normative".
cim:CommunicationLink.BilateralExchangeActor a owl:ObjectProperty;
                                             rdfs:comment "ICCP data provider or consumer using communication addressing for a Bilateral table."@en;
                                             rdfs:domain cim:CommunicationLink;
                                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                             rdfs:label "BilateralExchangeActor"@en;
                                             rdfs:range cim:BilateralExchangeActor.
cim:CommunicationLink.RemoteUnits a owl:ObjectProperty;
                                  rdfs:comment "RTUs may be attached to communication links."@en;
                                  rdfs:domain cim:CommunicationLink;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "RemoteUnits"@en;
                                  rdfs:range cim:RemoteUnit.
cim:CompleteModelToBeDeleted a owl:Class;
                             rdfs:comment "A complete model can be used in applications to perform meaningful calculations, e.g. a study case in offline tools or a real time model in a SCADA/EMS."@en;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "CompleteModelToBeDeleted"@en;
                             rdfs:subClassOf cim:ModelToBeDeleted;
                             cimdoc:cimPackage "IEC61970.InfIEC61970.InfPart303.NetworkModelFrames";
                             cimdoc:packageTier "Informative".
cim:CompositeSwitch a owl:Class;
                    rdfs:comment "A model of a set of individual Switches normally enclosed within the same cabinet and possibly with interlocks that restrict the combination of switch positions. These are typically found in medium voltage distribution networks. A CompositeSwitch could represent a Ring-Main-Unit (RMU), or pad-mounted switchgear, with primitive internal devices such as an internal bus-bar plus 3 or 4 internal switches each of which may individually be open or closed. A CompositeSwitch and a set of contained Switches can also be used to represent a multi-position switch e.g. a switch that can connect a circuit to Ground, Open or Busbar."@en;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "CompositeSwitch"@en;
                    rdfs:subClassOf cim:Equipment;
                    cimdoc:cimPackage "IEC61970.Base.Wires";
                    cimdoc:packageTier "Normative".
cim:CompositeSwitch.Switches a owl:ObjectProperty;
                             rdfs:comment "Switches contained in this Composite switch."@en;
                             rdfs:domain cim:CompositeSwitch;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "Switches"@en;
                             rdfs:range cim:Switch.
cim:CompositeSwitch.compositeSwitchType a owl:DatatypeProperty;
                                        rdfs:comment "An alphanumeric code that can be used as a reference to extra information such as the description of the interlocking scheme if any."@en;
                                        rdfs:domain cim:CompositeSwitch;
                                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                        rdfs:label "compositeSwitchType"@en;
                                        rdfs:range xsd:string.
cim:Conductance a rdfs:Datatype;
                rdfs:comment "Factor by which voltage must be multiplied to give corresponding power lost from a circuit. Real part of admittance."@en;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "Conductance"@en;
                owl:equivalentClass xsd:float;
                cimdoc:cimPackage "IEC61970.Base.Domain";
                cimdoc:packageTier "Normative";
                cimdoc:unitSymbol cim:UnitSymbol.S.
cim:ConductancePerLength a rdfs:Datatype;
                         rdfs:comment "Real part of admittance per unit of length."@en;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                         rdfs:label "ConductancePerLength"@en;
                         owl:equivalentClass xsd:float;
                         cimdoc:cimPackage "IEC61970.Base.Domain";
                         cimdoc:packageTier "Normative";
                         cimdoc:unitMultiplier cim:UnitMultiplier.none;
                         cimdoc:unitSymbol cim:UnitSymbol.SPerm.
cim:ConductingEquipment a owl:Class;
                        rdfs:comment "The parts of the AC power system that are designed to carry current or that are conductively connected through terminals."@en;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                        rdfs:label "ConductingEquipment"@en;
                        rdfs:subClassOf cim:Equipment;
                        cimdoc:cimPackage "IEC61970.Base.Core";
                        cimdoc:packageTier "Normative".
cim:ConductingEquipment.ProtectiveActionAdjustment a owl:ObjectProperty;
                                                   rdfs:comment "The operating condition to the Conducting Equipment is changed when protective action adjustment is activated. For ShuntCompensator or other conducting equipment that operates on discrete values (integer), the values given in float will be rounded."@en;
                                                   rdfs:domain cim:ConductingEquipment;
                                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                   rdfs:label "ProtectiveActionAdjustment"@en;
                                                   rdfs:range cim:ProtectiveActionAdjustment.
cim:Conductor a owl:Class;
              rdfs:comment "Combination of conducting material with consistent electrical characteristics, building a single electrical system, used to carry current between points in the power system."@en;
              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
              rdfs:label "Conductor"@en;
              rdfs:subClassOf cim:ConductingEquipment;
              cimdoc:cimPackage "IEC61970.Base.Wires";
              cimdoc:packageTier "Normative".
cim:Conductor.length a owl:DatatypeProperty;
                     rdfs:comment "Segment length for calculating line section capabilities."@en;
                     rdfs:domain cim:Conductor;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                     rdfs:label "length"@en;
                     rdfs:range cim:Length.
cim:ConfigurationEvent a owl:Class;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>.
cim:ConformLoad a owl:Class;
                rdfs:comment "ConformLoad represent loads that follow a daily load change pattern where the pattern can be used to scale the load with a system load."@en;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "ConformLoad"@en;
                rdfs:subClassOf cim:EnergyConsumer;
                cimdoc:cimPackage "IEC61970.Base.LoadModel";
                cimdoc:packageTier "Normative".
cim:ConformLoadGroup a owl:Class;
                     rdfs:comment "A group of loads conforming to an allocation pattern."@en;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                     rdfs:label "ConformLoadGroup"@en;
                     rdfs:subClassOf cim:LoadGroup;
                     cimdoc:cimPackage "IEC61970.Base.LoadModel";
                     cimdoc:packageTier "Normative".
cim:ConformLoadGroup.ConformLoadSchedules a owl:ObjectProperty;
                                          rdfs:comment "The ConformLoadSchedules in the ConformLoadGroup."@en;
                                          rdfs:domain cim:ConformLoadGroup;
                                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                          rdfs:label "ConformLoadSchedules"@en;
                                          rdfs:range cim:ConformLoadSchedule.
cim:ConformLoadGroup.EnergyConsumers a owl:ObjectProperty;
                                     rdfs:comment "Conform loads assigned to this ConformLoadGroup."@en;
                                     rdfs:domain cim:ConformLoadGroup;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                     rdfs:label "EnergyConsumers"@en;
                                     rdfs:range cim:ConformLoad.
cim:ConformLoadSchedule a owl:Class;
                        rdfs:comment "A curve of load versus time (X-axis) showing the active power values (Y1-axis) and reactive power (Y2-axis) for each unit of the period covered. This curve represents a typical pattern of load over the time period for a given day type and season."@en;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                        rdfs:label "ConformLoadSchedule"@en;
                        rdfs:subClassOf cim:SeasonDayTypeSchedule;
                        cimdoc:cimPackage "IEC61970.Base.LoadModel";
                        cimdoc:packageTier "Normative".
cim:ConnectivityNode a owl:Class;
                     rdfs:comment "Connectivity nodes are points where terminals of AC conducting equipment are connected together with zero impedance."@en;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                     rdfs:label "ConnectivityNode"@en;
                     rdfs:subClassOf cim:IdentifiedObject;
                     cimdoc:cimPackage "IEC61970.Base.Core";
                     cimdoc:packageTier "Normative".
cim:ConnectivityNode.ConnectivityNodeContainer a owl:ObjectProperty;
                                               rdfs:comment "Container of this connectivity node."@en;
                                               rdfs:domain cim:ConnectivityNode;
                                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                               rdfs:label "ConnectivityNodeContainer"@en;
                                               rdfs:range cim:ConnectivityNodeContainer.
cim:ConnectivityNodeContainer a owl:Class;
                              rdfs:comment "A base class for all objects that may contain connectivity nodes or topological nodes."@en;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "ConnectivityNodeContainer"@en;
                              rdfs:subClassOf cim:PowerSystemResource;
                              cimdoc:cimPackage "IEC61970.Base.Core";
                              cimdoc:packageTier "Normative".
cim:Connector a owl:Class;
              rdfs:comment "A conductor, or group of conductors, with negligible impedance, that serve to connect other conducting equipment within a single substation and are modelled with a single logical terminal."@en;
              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
              rdfs:label "Connector"@en;
              rdfs:subClassOf cim:ConductingEquipment;
              cimdoc:cimPackage "IEC61970.Base.Wires";
              cimdoc:packageTier "Normative".
cim:Contingency a owl:Class;
                rdfs:comment "An event threatening system reliability, consisting of one or more contingency elements."@en;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "Contingency"@en;
                rdfs:subClassOf cim:IdentifiedObject;
                cimdoc:cimPackage "IEC61970.Base.Contingency";
                cimdoc:packageTier "Normative".
cim:Contingency.ContingencyElement a owl:ObjectProperty;
                                   rdfs:comment "A contingency can have any number of contingency elements."@en;
                                   rdfs:domain cim:Contingency;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                   rdfs:label "ContingencyElement"@en;
                                   rdfs:range cim:ContingencyElement.
cim:Contingency.mustStudy a owl:DatatypeProperty;
                          rdfs:comment "Set true if must study this contingency."@en;
                          rdfs:domain cim:Contingency;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                          rdfs:label "mustStudy"@en;
                          rdfs:range xsd:boolean.
cim:ContingencyElement a owl:Class;
                       rdfs:comment "An element of a system event to be studied by contingency analysis, representing a change in status of a single piece of equipment."@en;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "ContingencyElement"@en;
                       rdfs:subClassOf cim:IdentifiedObject;
                       cimdoc:cimPackage "IEC61970.Base.Contingency";
                       cimdoc:packageTier "Normative".
cim:ContingencyEquipment a owl:Class;
                         rdfs:comment "Equipment whose in service status is to change, such as a power transformer or AC line segment."@en;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                         rdfs:label "ContingencyEquipment"@en;
                         rdfs:subClassOf cim:ContingencyElement;
                         cimdoc:cimPackage "IEC61970.Base.Contingency";
                         cimdoc:packageTier "Normative".
cim:ContingencyEquipment.Equipment a owl:ObjectProperty;
                                   rdfs:comment "The single piece of equipment to which to apply the contingency."@en;
                                   rdfs:domain cim:ContingencyEquipment;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                   rdfs:label "Equipment"@en;
                                   rdfs:range cim:Equipment.
cim:ContingencyEquipment.contingentStatus a owl:ObjectProperty;
                                          rdfs:comment "The status for the associated equipment when in the contingency state. This status is independent of the case to which the contingency is originally applied, but defines the equipment status when the contingency is applied."@en;
                                          rdfs:domain cim:ContingencyEquipment;
                                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                          rdfs:label "contingentStatus"@en;
                                          rdfs:range cim:ContingencyEquipmentStatusKind.
cim:ContingencyEquipmentStatusKind a owl:Class;
                                   rdfs:comment "Indicates the state which the contingency equipment is to be in when the contingency is applied."@en;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                   rdfs:label "ContingencyEquipmentStatusKind"@en;
                                   owl:equivalentClass [a owl:Class ; 
                                                        owl:oneOf (cim:ContingencyEquipmentStatusKind.inService
                                                                   cim:ContingencyEquipmentStatusKind.outOfService)];
                                   cimdoc:cimPackage "IEC61970.Base.Contingency";
                                   cimdoc:packageTier "Normative".
cim:ContingencyEquipmentStatusKind.inService a owl:NamedIndividual,
                                               cim:ContingencyEquipmentStatusKind;
                                             rdfs:comment "The equipment is to be put into service."@en;
                                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                             rdfs:label "inService"@en;
                                             cimdoc:enumCode 0 .
cim:ContingencyEquipmentStatusKind.outOfService a owl:NamedIndividual,
                                                  cim:ContingencyEquipmentStatusKind;
                                                rdfs:comment "The equipment is to be taken out of service."@en;
                                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                rdfs:label "outOfService"@en;
                                                cimdoc:enumCode 1 .
cim:Control a owl:Class;
            rdfs:comment "Control is used for supervisory/device control. It represents control outputs that are used to change the state in a process, e.g. close or open breaker, a set point value or a raise lower command."@en;
            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
            rdfs:label "Control"@en;
            rdfs:subClassOf cim:IOPoint;
            cimdoc:cimPackage "IEC61970.Base.Meas";
            cimdoc:packageTier "Normative".
cim:Control.controlType a owl:DatatypeProperty;
                        rdfs:comment "Specifies the type of Control. For example, this specifies if the Control represents BreakerOpen, BreakerClose, GeneratorVoltageSetPoint, GeneratorRaise, GeneratorLower, etc."@en;
                        rdfs:domain cim:Control;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                        rdfs:label "controlType"@en;
                        rdfs:range xsd:string.
cim:Control.operationInProgress a owl:DatatypeProperty;
                                rdfs:comment "Indicates that a client is currently sending control commands that has not completed."@en;
                                rdfs:domain cim:Control;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "operationInProgress"@en;
                                rdfs:range xsd:boolean.
cim:Control.timeStamp a owl:DatatypeProperty;
                      rdfs:comment "The last time a control output was sent."@en;
                      rdfs:domain cim:Control;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "timeStamp"@en;
                      rdfs:range xsd:dateTime.
cim:Control.unitMultiplier a owl:ObjectProperty;
                           rdfs:comment "The unit multiplier of the controlled quantity."@en;
                           rdfs:domain cim:Control;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "unitMultiplier"@en;
                           rdfs:range cim:UnitMultiplier.
cim:Control.unitSymbol a owl:ObjectProperty;
                       rdfs:comment "The unit of measure of the controlled quantity."@en;
                       rdfs:domain cim:Control;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "unitSymbol"@en;
                       rdfs:range cim:UnitSymbol.
cim:ControlArea a owl:Class;
                rdfs:comment "A control area is a grouping of generating units and/or loads and a cutset of tie lines (as terminals) which may be used for a variety of purposes including automatic generation control, power flow solution area interchange control specification, and input to load forecasting. All generation and load within the area defined by the terminals on the border are considered in the area interchange control. Note that any number of overlapping control area specifications can be superimposed on the physical model. The following general principles apply to ControlArea: 1. The control area orientation for net interchange is positive for an import, negative for an export. 2. The control area net interchange is determined by summing flows in Terminals. The Terminals are identified by creating a set of TieFlow objects associated with a ControlArea object. Each TieFlow object identifies one Terminal. 3. In a single network model, a tie between two control areas must be modelled in both control area specifications, such that the two representations of the tie flow sum to zero. 4. The normal orientation of Terminal flow is positive for flow into the conducting equipment that owns the Terminal. (i.e. flow from a bus into a device is positive.) However, the orientation of each flow in the control area specification must align with the control area convention, i.e. import is positive. If the orientation of the Terminal flow referenced by a TieFlow is positive into the control area, then this is confirmed by setting TieFlow. positiveFlowIn flag TRUE. If not, the orientation must be reversed by setting the TieFlow.positiveFlowIn flag FALSE."@en;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "ControlArea"@en;
                rdfs:subClassOf cim:PowerSystemResource;
                cimdoc:cimPackage "IEC61970.Base.ControlArea";
                cimdoc:packageTier "Normative".
cim:ControlArea.ControlAreaGeneratingUnit a owl:ObjectProperty;
                                          rdfs:comment "The generating unit specifications for the control area."@en;
                                          rdfs:domain cim:ControlArea;
                                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                          rdfs:label "ControlAreaGeneratingUnit"@en;
                                          rdfs:range cim:ControlAreaGeneratingUnit.
cim:ControlArea.EnergyArea a owl:ObjectProperty;
                           rdfs:comment "The energy area that is forecast from this control area specification."@en;
                           rdfs:domain cim:ControlArea;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "EnergyArea"@en;
                           rdfs:range cim:EnergyArea.
cim:ControlArea.TieFlow a owl:ObjectProperty;
                        rdfs:comment "The tie flows associated with the control area."@en;
                        rdfs:domain cim:ControlArea;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                        rdfs:label "TieFlow"@en;
                        rdfs:range cim:TieFlow.
cim:ControlArea.netInterchange a owl:DatatypeProperty;
                               rdfs:comment "The specified positive net interchange into the control area, i.e. positive sign means flow into the area."@en;
                               rdfs:domain cim:ControlArea;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "netInterchange"@en;
                               rdfs:range cim:ActivePower.
cim:ControlArea.pTolerance a owl:DatatypeProperty;
                           rdfs:comment "Active power net interchange tolerance. The attribute shall be a positive value or zero."@en;
                           rdfs:domain cim:ControlArea;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "pTolerance"@en;
                           rdfs:range cim:ActivePower.
cim:ControlArea.type a owl:ObjectProperty;
                     rdfs:comment "The primary type of control area definition used to determine if this is used for automatic generation control, for planning interchange control, or other purposes. A control area specified with primary type of automatic generation control could still be forecast and used as an interchange area in power flow analysis."@en;
                     rdfs:domain cim:ControlArea;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                     rdfs:label "type"@en;
                     rdfs:range cim:ControlAreaTypeKind.
cim:ControlAreaGeneratingUnit a owl:Class;
                              rdfs:comment "A control area generating unit. This class is needed so that alternate control area definitions may include the same generating unit. It should be noted that only one instance within a control area should reference a specific generating unit."@en;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "ControlAreaGeneratingUnit"@en;
                              rdfs:subClassOf cim:IdentifiedObject;
                              cimdoc:cimPackage "IEC61970.Base.ControlArea";
                              cimdoc:packageTier "Normative".
cim:ControlAreaGeneratingUnit.AltGeneratingUnitMeas a owl:ObjectProperty;
                                                    rdfs:comment "The link to prioritized measurements for this GeneratingUnit."@en;
                                                    rdfs:domain cim:ControlAreaGeneratingUnit;
                                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                    rdfs:label "AltGeneratingUnitMeas"@en;
                                                    rdfs:range cim:AltGeneratingUnitMeas.
cim:ControlAreaGeneratingUnit.GeneratingUnit a owl:ObjectProperty;
                                             rdfs:comment "The generating unit specified for this control area. Note that a control area should include a GeneratingUnit only once."@en;
                                             rdfs:domain cim:ControlAreaGeneratingUnit;
                                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                             rdfs:label "GeneratingUnit"@en;
                                             rdfs:range cim:GeneratingUnit.
cim:ControlAreaTypeKind a owl:Class;
                        rdfs:comment "The type of control area."@en;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                        rdfs:label "ControlAreaTypeKind"@en;
                        owl:equivalentClass [a owl:Class ; 
                                             owl:oneOf (cim:ControlAreaTypeKind.AGC
                                                        cim:ControlAreaTypeKind.Forecast
                                                        cim:ControlAreaTypeKind.Interchange)];
                        cimdoc:cimPackage "IEC61970.Base.ControlArea";
                        cimdoc:packageTier "Normative".
cim:ControlAreaTypeKind.AGC a owl:NamedIndividual,
                              cim:ControlAreaTypeKind;
                            rdfs:comment "Used for automatic generation control."@en;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "AGC"@en;
                            cimdoc:enumCode 0 .
cim:ControlAreaTypeKind.Forecast a owl:NamedIndividual,
                                   cim:ControlAreaTypeKind;
                                 rdfs:comment "Used for load forecast."@en;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "Forecast"@en;
                                 cimdoc:enumCode 1 .
cim:ControlAreaTypeKind.Interchange a owl:NamedIndividual,
                                      cim:ControlAreaTypeKind;
                                    rdfs:comment "Used for interchange specification or control."@en;
                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                    rdfs:label "Interchange"@en;
                                    cimdoc:enumCode 2 .
cim:CoolantType a owl:Class;
                rdfs:comment "Method of cooling a machine."@en;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "CoolantType"@en;
                owl:equivalentClass [a owl:Class ; 
                                     owl:oneOf (cim:CoolantType.air
                                                cim:CoolantType.hydrogenGas
                                                cim:CoolantType.water)];
                cimdoc:cimPackage "IEC61970.Base.Wires";
                cimdoc:packageTier "Normative".
cim:CoolantType.air a owl:NamedIndividual,
                      cim:CoolantType;
                    rdfs:comment "Air."@en;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "air"@en;
                    cimdoc:enumCode 0 .
cim:CoolantType.hydrogenGas a owl:NamedIndividual,
                              cim:CoolantType;
                            rdfs:comment "Hydrogen gas."@en;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "hydrogenGas"@en;
                            cimdoc:enumCode 1 .
cim:CoolantType.water a owl:NamedIndividual,
                        cim:CoolantType;
                      rdfs:comment "Water."@en;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "water"@en;
                      cimdoc:enumCode 2 .
cim:CostPerEnergyUnit a rdfs:Datatype;
                      rdfs:comment "Cost, in units of currency, per quantity of electrical energy generated."@en;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "CostPerEnergyUnit"@en;
                      owl:equivalentClass xsd:float;
                      cimdoc:cimPackage "IEC61970.Base.Domain";
                      cimdoc:packageTier "Normative".
cim:CostPerHeatUnit a rdfs:Datatype;
