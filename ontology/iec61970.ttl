cim:GovHydro1.qnl a owl:DatatypeProperty;
                  rdfs:comment "No-load flow at nominal head (qnl) (>= 0). Typical value = 0,08."@en;
                  rdfs:domain cim:GovHydro1;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "qnl"@en;
