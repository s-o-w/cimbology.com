                 cimdoc:enumCode 129 .
cim:PhaseCode.B a owl:NamedIndividual,
                  cim:PhaseCode;
                rdfs:comment "Phase B."@en;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "B"@en;
                cimdoc:enumCode 64 .
cim:PhaseCode.BC a owl:NamedIndividual,
                   cim:PhaseCode;
                 rdfs:comment "Phases B and C."@en;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
