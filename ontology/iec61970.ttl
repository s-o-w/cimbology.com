cim:ExcSK.nq a owl:DatatypeProperty;
             rdfs:comment "Deadband of reactive power (nq). Determines the range of sensitivity. Typical value = 0,001."@en;
             rdfs:domain cim:ExcSK;
             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
             rdfs:label "nq"@en;
