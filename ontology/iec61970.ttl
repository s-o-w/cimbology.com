                           rdfs:label "tfma"@en;
                           rdfs:range cim:Seconds.
cim:WindProtectionIEC.uover a owl:DatatypeProperty;
                            rdfs:comment "Wind turbine over voltage protection activation threshold (uover). It is a project-dependent parameter."@en;
