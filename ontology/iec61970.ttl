                      rdfs:comment "Maximum voltage regulator output (VAMAX) (greater than 0). Typical value = 8."@en;
                      rdfs:domain cim:ExcIEEEAC2A;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "vamax"@en;
