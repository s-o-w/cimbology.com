                   rdfs:domain cim:ExcELIN2;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "seve2"@en;
                   rdfs:range cim:PU.
cim:ExcELIN2.tb1 a owl:DatatypeProperty;
                 rdfs:comment "Voltage controller derivative washout time constant (Tb1) (>= 0). Typical value = 12,45."@en;
                 rdfs:domain cim:ExcELIN2;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "tb1"@en;
