                               rdfs:comment "Gain Under excitation limiter (KUI). Typical value = 0,1."@en;
                               rdfs:domain cim:UnderexcLim2Simplified;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "kui"@en;
