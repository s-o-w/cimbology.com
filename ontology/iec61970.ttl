                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                    rdfs:label "stateSupplemental"@en;
                                    cimdoc:enumCode 3 .
cim:ICCPProvidedPoint a owl:Class;
                      rdfs:comment "The IdentifiedObject.name attribute must have a value. The name attribute shall be used as the DataValue name used for the exchange."@en;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "ICCPProvidedPoint"@en;
                      rdfs:subClassOf cim:ProvidedBilateralPoint;
                      cimdoc:cimPackage "IEC61970.Base.ICCPConfiguration";
                      cimdoc:packageTier "Normative".
cim:ICCPProvidedPoint.accessPriviledge a owl:ObjectProperty;
                                       rdfs:comment "Provides information regarding the access privileges allowed to the ICCP Point."@en;
                                       rdfs:domain cim:ICCPProvidedPoint;
                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                       rdfs:label "accessPriviledge"@en;
                                       rdfs:range cim:ICCPAccessPrivilegeKind.
cim:ICCPProvidedPoint.pointQuality a owl:ObjectProperty;
                                   rdfs:comment "Specifies the type of ICCP quality that will be conveyed as part of the ICCP Point."@en;
                                   rdfs:domain cim:ICCPProvidedPoint;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                   rdfs:label "pointQuality"@en;
                                   rdfs:range cim:ICCPQualityKind.
cim:ICCPProvidedPoint.pointType a owl:ObjectProperty;
                                rdfs:comment "Indicates the ICCP Point type that is to be conveyed. A CIM AccumlatorValue shall be mapped to an ICCP real. A CIM AnalogValue shall be mapped to an ICCP real. A CIM DiscreteValue shall be mapped to either an ICCP real, state, stateSupplemental, or either protection event type. A CIM StringMeasurementValue does not have a standardized mapping."@en;
                                rdfs:domain cim:ICCPProvidedPoint;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "pointType"@en;
                                rdfs:range cim:ICCPPointKind.
cim:ICCPProvidedPoint.scope a owl:ObjectProperty;
                            rdfs:comment "Indicates if the Point is global scoped (e.g. VCC) or accessible only to the Bilateral table peer (e.g. ICC)."@en;
                            rdfs:domain cim:ICCPProvidedPoint;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "scope"@en;
                            rdfs:range cim:ICCPScopeKind.
cim:ICCPQualityKind a owl:Class;
                    rdfs:comment """Indicates the type of quality information that is to be exchanged. For protection events the value shall be \"none\"."""@en;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "ICCPQualityKind"@en;
                    owl:equivalentClass [a owl:Class ; 
                                         owl:oneOf (cim:ICCPQualityKind.extended
                                                    cim:ICCPQualityKind.extendedwithQualityTime
                                                    cim:ICCPQualityKind.none
                                                    cim:ICCPQualityKind.qualityAndTime
                                                    cim:ICCPQualityKind.qualityOnly)];
                    cimdoc:cimPackage "IEC61970.Base.ICCPConfiguration";
                    cimdoc:packageTier "Normative".
cim:ICCPQualityKind.extended a owl:NamedIndividual,
                               cim:ICCPQualityKind;
                             rdfs:comment "Indicates that only extended information is to be provided."@en;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "extended"@en;
                             cimdoc:enumCode 3 .
cim:ICCPQualityKind.extendedwithQualityTime a owl:NamedIndividual,
                                              cim:ICCPQualityKind;
                                            rdfs:comment "Provides quality, timestamp, and extended information."@en;
                                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                            rdfs:label "extendedwithQualityTime"@en;
                                            cimdoc:enumCode 4 .
cim:ICCPQualityKind.none a owl:NamedIndividual,
                           cim:ICCPQualityKind;
                         rdfs:comment "Indicates that no quality is conveyed with the ICCP point."@en;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                         rdfs:label "none"@en;
                         cimdoc:enumCode 0 .
cim:ICCPQualityKind.qualityAndTime a owl:NamedIndividual,
                                     cim:ICCPQualityKind;
                                   rdfs:comment "Indicates that quality and a timestamp are to be provided."@en;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                   rdfs:label "qualityAndTime"@en;
                                   cimdoc:enumCode 2 .
cim:ICCPQualityKind.qualityOnly a owl:NamedIndividual,
                                  cim:ICCPQualityKind;
                                rdfs:comment "Indicates that only quality is to be provided."@en;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "qualityOnly"@en;
                                cimdoc:enumCode 1 .
cim:ICCPScopeKind a owl:Class;
                  rdfs:comment "Specifies the control centre scope."@en;
