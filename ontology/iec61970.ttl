cim:PFVArType1IEEEVArController.vvarcbw a owl:DatatypeProperty;
                                        rdfs:comment "Var controller deadband (VVARC_BW). Typical value = 0, 02."@en;
                                        rdfs:domain cim:PFVArType1IEEEVArController;
                                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                        rdfs:label "vvarcbw"@en;
