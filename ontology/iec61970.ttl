cim:EnergySource.voltageMagnitude a owl:DatatypeProperty;
                                  rdfs:comment "Phase-to-phase open circuit voltage magnitude used when voltage characteristics need to be imposed at the node associated with the terminal of the energy source, such as when voltages and angles from the transmission level are used as input to the distribution network. The attribute shall be a positive value or zero."@en;
                                  rdfs:domain cim:EnergySource;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "voltageMagnitude"@en;
                                  rdfs:range cim:Voltage.
cim:EnergySource.x a owl:DatatypeProperty;
