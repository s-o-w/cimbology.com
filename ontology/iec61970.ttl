               rdfs:comment "Minimum field voltage output (Emin) (< ExcSK.emax). Typical value = -20."@en;
               rdfs:domain cim:ExcSK;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "emin"@en;
