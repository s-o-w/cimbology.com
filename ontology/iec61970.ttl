                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                     rdfs:label "t7"@en;
                     rdfs:range cim:Seconds.
cim:GovSteamIEEE1.uc a owl:DatatypeProperty;
