cim:SteamTurbine.reheater1TC a owl:DatatypeProperty;
                             rdfs:comment "First reheater time constant."@en;
                             rdfs:domain cim:SteamTurbine;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "reheater1TC"@en;
