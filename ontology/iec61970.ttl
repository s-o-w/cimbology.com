cim:ExcREXS.kc a owl:DatatypeProperty;
               rdfs:comment "Rectifier regulation factor (Kc). Typical value = 0,05."@en;
               rdfs:domain cim:ExcREXS;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "kc"@en;
               rdfs:range cim:PU.
cim:ExcREXS.kd a owl:DatatypeProperty;
               rdfs:comment "Exciter regulation factor (Kd). Typical value = 2."@en;
               rdfs:domain cim:ExcREXS;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "kd"@en;
               rdfs:range cim:PU.
cim:ExcREXS.ke a owl:DatatypeProperty;
               rdfs:comment "Exciter field proportional constant (Ke). Typical value = 1."@en;
               rdfs:domain cim:ExcREXS;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "ke"@en;
               rdfs:range cim:PU.
cim:ExcREXS.kefd a owl:DatatypeProperty;
                 rdfs:comment "Field voltage feedback gain (Kefd). Typical value = 0."@en;
                 rdfs:domain cim:ExcREXS;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "kefd"@en;
                 rdfs:range cim:PU.
cim:ExcREXS.kf a owl:DatatypeProperty;
               rdfs:comment "Rate feedback gain (Kf) (>= 0). Typical value = 0,05."@en;
               rdfs:domain cim:ExcREXS;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "kf"@en;
               rdfs:range cim:Seconds.
cim:ExcREXS.kh a owl:DatatypeProperty;
               rdfs:comment "Field voltage controller feedback gain (Kh). Typical value = 0."@en;
               rdfs:domain cim:ExcREXS;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "kh"@en;
               rdfs:range cim:PU.
cim:ExcREXS.kii a owl:DatatypeProperty;
                rdfs:comment "Field current regulator integral gain (Kii). Typical value = 0."@en;
                rdfs:domain cim:ExcREXS;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "kii"@en;
                rdfs:range cim:PU.
cim:ExcREXS.kip a owl:DatatypeProperty;
                rdfs:comment "Field current regulator proportional gain (Kip). Typical value = 1."@en;
                rdfs:domain cim:ExcREXS;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "kip"@en;
                rdfs:range cim:PU.
cim:ExcREXS.ks a owl:DatatypeProperty;
               rdfs:comment "Coefficient to allow different usage of the model-speed coefficient (Ks). Typical value = 0."@en;
               rdfs:domain cim:ExcREXS;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "ks"@en;
               rdfs:range cim:PU.
cim:ExcREXS.kvi a owl:DatatypeProperty;
                rdfs:comment "Voltage regulator integral gain (Kvi). Typical value = 0."@en;
                rdfs:domain cim:ExcREXS;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "kvi"@en;
                rdfs:range cim:PU.
cim:ExcREXS.kvp a owl:DatatypeProperty;
                rdfs:comment "Voltage regulator proportional gain (Kvp). Typical value = 2800."@en;
                rdfs:domain cim:ExcREXS;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "kvp"@en;
                rdfs:range cim:PU.
cim:ExcREXS.kvphz a owl:DatatypeProperty;
                  rdfs:comment "V/Hz limiter gain (Kvphz). Typical value = 0."@en;
                  rdfs:domain cim:ExcREXS;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "kvphz"@en;
                  rdfs:range cim:PU.
cim:ExcREXS.nvphz a owl:DatatypeProperty;
                  rdfs:comment "Pickup speed of V/Hz limiter (Nvphz). Typical value = 0."@en;
                  rdfs:domain cim:ExcREXS;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "nvphz"@en;
                  rdfs:range cim:PU.
cim:ExcREXS.se1 a owl:DatatypeProperty;
                rdfs:comment "Saturation factor at E1 (Se1). Typical value = 0,0001."@en;
                rdfs:domain cim:ExcREXS;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "se1"@en;
                rdfs:range cim:PU.
cim:ExcREXS.se2 a owl:DatatypeProperty;
                rdfs:comment "Saturation factor at E2 (Se2). Typical value = 0,001."@en;
                rdfs:domain cim:ExcREXS;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "se2"@en;
                rdfs:range cim:PU.
cim:ExcREXS.ta a owl:DatatypeProperty;
               rdfs:comment "Voltage regulator time constant (Ta) (>= 0). If = 0, block is bypassed. Typical value = 0,01."@en;
               rdfs:domain cim:ExcREXS;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "ta"@en;
               rdfs:range cim:Seconds.
cim:ExcREXS.tb1 a owl:DatatypeProperty;
                rdfs:comment "Lag time constant (Tb1) (>= 0). If = 0, block is bypassed. Typical value = 0."@en;
                rdfs:domain cim:ExcREXS;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "tb1"@en;
                rdfs:range cim:Seconds.
cim:ExcREXS.tb2 a owl:DatatypeProperty;
                rdfs:comment "Lag time constant (Tb2) (>= 0). If = 0, block is bypassed. Typical value = 0."@en;
                rdfs:domain cim:ExcREXS;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "tb2"@en;
                rdfs:range cim:Seconds.
cim:ExcREXS.tc1 a owl:DatatypeProperty;
                rdfs:comment "Lead time constant (Tc1) (>= 0). Typical value = 0."@en;
                rdfs:domain cim:ExcREXS;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "tc1"@en;
                rdfs:range cim:Seconds.
cim:ExcREXS.tc2 a owl:DatatypeProperty;
                rdfs:comment "Lead time constant (Tc2) (>= 0). Typical value = 0."@en;
                rdfs:domain cim:ExcREXS;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "tc2"@en;
                rdfs:range cim:Seconds.
cim:ExcREXS.te a owl:DatatypeProperty;
               rdfs:comment "Exciter field time constant (Te) (> 0). Typical value = 1,2."@en;
               rdfs:domain cim:ExcREXS;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "te"@en;
               rdfs:range cim:Seconds.
cim:ExcREXS.tf a owl:DatatypeProperty;
               rdfs:comment "Rate feedback time constant (Tf) (>= 0). If = 0, the feedback path is not used. Typical value = 1."@en;
               rdfs:domain cim:ExcREXS;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "tf"@en;
               rdfs:range cim:Seconds.
cim:ExcREXS.tf1 a owl:DatatypeProperty;
                rdfs:comment "Feedback lead time constant (Tf1) (>= 0). Typical value = 0."@en;
                rdfs:domain cim:ExcREXS;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "tf1"@en;
                rdfs:range cim:Seconds.
cim:ExcREXS.tf2 a owl:DatatypeProperty;
                rdfs:comment "Feedback lag time constant (Tf2) (>= 0). If = 0, block is bypassed. Typical value = 0."@en;
                rdfs:domain cim:ExcREXS;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "tf2"@en;
                rdfs:range cim:Seconds.
cim:ExcREXS.tp a owl:DatatypeProperty;
               rdfs:comment "Field current bridge time constant (Tp) (>= 0). Typical value = 0."@en;
               rdfs:domain cim:ExcREXS;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "tp"@en;
               rdfs:range cim:Seconds.
cim:ExcREXS.vcmax a owl:DatatypeProperty;
                  rdfs:comment "Maximum compounding voltage (Vcmax). Typical value = 0."@en;
                  rdfs:domain cim:ExcREXS;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "vcmax"@en;
                  rdfs:range cim:PU.
cim:ExcREXS.vfmax a owl:DatatypeProperty;
                  rdfs:comment "Maximum exciter field current (Vfmax) (> ExcREXS.vfmin). Typical value = 47."@en;
                  rdfs:domain cim:ExcREXS;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "vfmax"@en;
                  rdfs:range cim:PU.
cim:ExcREXS.vfmin a owl:DatatypeProperty;
                  rdfs:comment "Minimum exciter field current (Vfmin) (< ExcREXS.vfmax). Typical value = -20."@en;
                  rdfs:domain cim:ExcREXS;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "vfmin"@en;
                  rdfs:range cim:PU.
cim:ExcREXS.vimax a owl:DatatypeProperty;
                  rdfs:comment "Voltage regulator input limit (Vimax). Typical value = 0,1."@en;
                  rdfs:domain cim:ExcREXS;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "vimax"@en;
                  rdfs:range cim:PU.
cim:ExcREXS.vrmax a owl:DatatypeProperty;
                  rdfs:comment "Maximum controller output (Vrmax) (> ExcREXS.vrmin). Typical value = 47."@en;
                  rdfs:domain cim:ExcREXS;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "vrmax"@en;
                  rdfs:range cim:PU.
cim:ExcREXS.vrmin a owl:DatatypeProperty;
                  rdfs:comment "Minimum controller output (Vrmin) (< ExcREXS.vrmax). Typical value = - 20."@en;
                  rdfs:domain cim:ExcREXS;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "vrmin"@en;
                  rdfs:range cim:PU.
cim:ExcREXS.xc a owl:DatatypeProperty;
               rdfs:comment "Exciter compounding reactance (Xc). Typical value = 0."@en;
               rdfs:domain cim:ExcREXS;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "xc"@en;
               rdfs:range cim:PU.
cim:ExcREXSFeedbackSignalKind a owl:Class;
                              rdfs:comment "Types of rate feedback signals."@en;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "ExcREXSFeedbackSignalKind"@en;
                              owl:equivalentClass [a owl:Class ; 
                                                   owl:oneOf (cim:ExcREXSFeedbackSignalKind.fieldCurrent
                                                              cim:ExcREXSFeedbackSignalKind.fieldVoltage
                                                              cim:ExcREXSFeedbackSignalKind.outputVoltage)];
                              cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.ExcitationSystemDynamics";
                              cimdoc:packageTier "Normative".
cim:ExcREXSFeedbackSignalKind.fieldCurrent a owl:NamedIndividual,
                                             cim:ExcREXSFeedbackSignalKind;
                                           rdfs:comment "The exciter field current is used."@en;
                                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                           rdfs:label "fieldCurrent"@en;
                                           cimdoc:enumCode 1 .
cim:ExcREXSFeedbackSignalKind.fieldVoltage a owl:NamedIndividual,
                                             cim:ExcREXSFeedbackSignalKind;
                                           rdfs:comment "The voltage regulator output voltage is used. It is the same as exciter field voltage."@en;
                                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                           rdfs:label "fieldVoltage"@en;
                                           cimdoc:enumCode 0 .
cim:ExcREXSFeedbackSignalKind.outputVoltage a owl:NamedIndividual,
                                              cim:ExcREXSFeedbackSignalKind;
                                            rdfs:comment "The output voltage of the exciter is used."@en;
                                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                            rdfs:label "outputVoltage"@en;
                                            cimdoc:enumCode 2 .
cim:ExcRQB a owl:Class;
           rdfs:comment "Excitation system type RQB (four-loop regulator, r?gulateur quatre boucles, developed in France) primarily used in nuclear or thermal generating units. This excitation system shall be always used together with power system stabilizer type PssRQB."@en;
           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
           rdfs:label "ExcRQB"@en;
           rdfs:subClassOf cim:ExcitationSystemDynamics;
           cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.ExcitationSystemDynamics";
           cimdoc:packageTier "Normative".
cim:ExcRQB.ki0 a owl:DatatypeProperty;
               rdfs:comment "Voltage reference input gain (Ki0). Typical value = 12,7."@en;
               rdfs:domain cim:ExcRQB;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "ki0"@en;
               rdfs:range xsd:float.
cim:ExcRQB.ki1 a owl:DatatypeProperty;
               rdfs:comment "Voltage input gain (Ki1). Typical value = -16,8."@en;
               rdfs:domain cim:ExcRQB;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "ki1"@en;
               rdfs:range xsd:float.
cim:ExcRQB.klir a owl:DatatypeProperty;
                rdfs:comment "OEL input gain (KLIR). Typical value = 12,13."@en;
                rdfs:domain cim:ExcRQB;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "klir"@en;
                rdfs:range xsd:float.
cim:ExcRQB.klus a owl:DatatypeProperty;
                rdfs:comment "Limiter gain (KLUS). Typical value = 50."@en;
                rdfs:domain cim:ExcRQB;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "klus"@en;
                rdfs:range xsd:float.
cim:ExcRQB.lsat a owl:DatatypeProperty;
                rdfs:comment "Integrator limiter (LSAT). Typical value = 5,73."@en;
                rdfs:domain cim:ExcRQB;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "lsat"@en;
                rdfs:range cim:PU.
cim:ExcRQB.lus a owl:DatatypeProperty;
               rdfs:comment "Setpoint (LUS). Typical value = 0,12."@en;
               rdfs:domain cim:ExcRQB;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "lus"@en;
               rdfs:range cim:PU.
cim:ExcRQB.mesu a owl:DatatypeProperty;
                rdfs:comment "Voltage input time constant (MESU) (>= 0). Typical value = 0,02."@en;
                rdfs:domain cim:ExcRQB;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "mesu"@en;
                rdfs:range cim:Seconds.
cim:ExcRQB.t4m a owl:DatatypeProperty;
               rdfs:comment "Input time constant (T4M) (>= 0). Typical value = 5."@en;
               rdfs:domain cim:ExcRQB;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "t4m"@en;
               rdfs:range cim:Seconds.
cim:ExcRQB.tc a owl:DatatypeProperty;
              rdfs:comment "Lead lag time constant (TC) (>= 0). Typical value = 0,02."@en;
              rdfs:domain cim:ExcRQB;
              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
              rdfs:label "tc"@en;
              rdfs:range cim:Seconds.
cim:ExcRQB.te a owl:DatatypeProperty;
              rdfs:comment "Lead lag time constant (TE) (>= 0). Typical value = 0,22."@en;
              rdfs:domain cim:ExcRQB;
              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
              rdfs:label "te"@en;
              rdfs:range cim:Seconds.
cim:ExcRQB.tf a owl:DatatypeProperty;
              rdfs:comment "Exciter time constant (TF) (>= 0). Typical value = 0,01."@en;
              rdfs:domain cim:ExcRQB;
              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
              rdfs:label "tf"@en;
              rdfs:range cim:Seconds.
cim:ExcRQB.ucmax a owl:DatatypeProperty;
                 rdfs:comment "Maximum voltage reference limit (UCMAX) (> ExcRQB.ucmin). Typical value = 1,1."@en;
                 rdfs:domain cim:ExcRQB;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "ucmax"@en;
                 rdfs:range cim:PU.
cim:ExcRQB.ucmin a owl:DatatypeProperty;
                 rdfs:comment "Minimum voltage reference limit (UCMIN) (< ExcRQB.ucmax). Typical value = 0,9."@en;
                 rdfs:domain cim:ExcRQB;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "ucmin"@en;
                 rdfs:range cim:PU.
cim:ExcSCRX a owl:Class;
            rdfs:comment "Simple excitation system with generic characteristics typical of many excitation systems; intended for use where negative field current could be a problem."@en;
            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
            rdfs:label "ExcSCRX"@en;
            rdfs:subClassOf cim:ExcitationSystemDynamics;
            cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.ExcitationSystemDynamics";
            cimdoc:packageTier "Normative".
cim:ExcSCRX.cswitch a owl:DatatypeProperty;
                    rdfs:comment "Power source switch (Cswitch). true = fixed voltage of 1.0 PU false = generator terminal voltage."@en;
                    rdfs:domain cim:ExcSCRX;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "cswitch"@en;
                    rdfs:range xsd:boolean.
cim:ExcSCRX.emax a owl:DatatypeProperty;
                 rdfs:comment "Maximum field voltage output (Emax) (> ExcSCRX.emin). Typical value = 5."@en;
                 rdfs:domain cim:ExcSCRX;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "emax"@en;
                 rdfs:range cim:PU.
cim:ExcSCRX.emin a owl:DatatypeProperty;
                 rdfs:comment "Minimum field voltage output (Emin) (< ExcSCRX.emax). Typical value = 0."@en;
                 rdfs:domain cim:ExcSCRX;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "emin"@en;
                 rdfs:range cim:PU.
cim:ExcSCRX.k a owl:DatatypeProperty;
              rdfs:comment "Gain (K) (> 0). Typical value = 200."@en;
              rdfs:domain cim:ExcSCRX;
              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
              rdfs:label "k"@en;
              rdfs:range cim:PU.
cim:ExcSCRX.rcrfd a owl:DatatypeProperty;
                  rdfs:comment "Ratio of field discharge resistance to field winding resistance ([rc / rfd]). Typical value = 0."@en;
                  rdfs:domain cim:ExcSCRX;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "rcrfd"@en;
                  rdfs:range xsd:float.
cim:ExcSCRX.tatb a owl:DatatypeProperty;
                 rdfs:comment "Gain reduction ratio of lag-lead element ([Ta / Tb]). The parameter Ta is not defined explicitly. Typical value = 0.1."@en;
                 rdfs:domain cim:ExcSCRX;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "tatb"@en;
                 rdfs:range xsd:float.
cim:ExcSCRX.tb a owl:DatatypeProperty;
               rdfs:comment "Denominator time constant of lag-lead block (Tb) (>= 0). Typical value = 10."@en;
               rdfs:domain cim:ExcSCRX;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "tb"@en;
               rdfs:range cim:Seconds.
cim:ExcSCRX.te a owl:DatatypeProperty;
               rdfs:comment "Time constant of gain block (Te) (> 0). Typical value = 0,02."@en;
               rdfs:domain cim:ExcSCRX;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "te"@en;
               rdfs:range cim:Seconds.
cim:ExcSEXS a owl:Class;
            rdfs:comment "Simplified excitation system."@en;
            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
            rdfs:label "ExcSEXS"@en;
            rdfs:subClassOf cim:ExcitationSystemDynamics;
            cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.ExcitationSystemDynamics";
            cimdoc:packageTier "Normative".
cim:ExcSEXS.efdmax a owl:DatatypeProperty;
                   rdfs:comment "Field voltage clipping maximum limit (Efdmax) (> ExcSEXS.efdmin). Typical value = 5."@en;
                   rdfs:domain cim:ExcSEXS;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "efdmax"@en;
                   rdfs:range cim:PU.
cim:ExcSEXS.efdmin a owl:DatatypeProperty;
                   rdfs:comment "Field voltage clipping minimum limit (Efdmin) (< ExcSEXS.efdmax). Typical value = -5."@en;
                   rdfs:domain cim:ExcSEXS;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "efdmin"@en;
                   rdfs:range cim:PU.
cim:ExcSEXS.emax a owl:DatatypeProperty;
                 rdfs:comment "Maximum field voltage output (Emax) (> ExcSEXS.emin). Typical value = 5."@en;
                 rdfs:domain cim:ExcSEXS;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "emax"@en;
                 rdfs:range cim:PU.
cim:ExcSEXS.emin a owl:DatatypeProperty;
                 rdfs:comment "Minimum field voltage output (Emin) (< ExcSEXS.emax). Typical value = - 5."@en;
                 rdfs:domain cim:ExcSEXS;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "emin"@en;
                 rdfs:range cim:PU.
cim:ExcSEXS.k a owl:DatatypeProperty;
              rdfs:comment "Gain (K) (> 0). Typical value = 100."@en;
              rdfs:domain cim:ExcSEXS;
              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
              rdfs:label "k"@en;
              rdfs:range cim:PU.
cim:ExcSEXS.kc a owl:DatatypeProperty;
               rdfs:comment "PI controller gain (Kc) (> 0 if ExcSEXS.tc > 0). Typical value = 0,08."@en;
               rdfs:domain cim:ExcSEXS;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "kc"@en;
