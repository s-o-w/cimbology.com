                    rdfs:label "kir"@en;
                    rdfs:range cim:PU.
cim:ExcIEEEAC7B.kl a owl:DatatypeProperty;
                   rdfs:comment "Exciter field voltage lower limit parameter (KL). Typical value = 10."@en;
                   rdfs:domain cim:ExcIEEEAC7B;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "kl"@en;
                   rdfs:range cim:PU.
cim:ExcIEEEAC7B.kp a owl:DatatypeProperty;
