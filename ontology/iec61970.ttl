                 rdfs:comment "Time in seconds."@en;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "s"@en;
                 cimdoc:enumCode 4 .
cim:UnitSymbol.sPers a owl:NamedIndividual,
