                                            rdfs:label "motorOrCondenser"@en;
                                            cimdoc:enumCode 5 .
cim:SynchronousMachineModelKind a owl:Class;
                                rdfs:comment "Type of synchronous machine model used in dynamic simulation applications."@en;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "SynchronousMachineModelKind"@en;
                                owl:equivalentClass [a owl:Class ; 
                                                     owl:oneOf (cim:SynchronousMachineModelKind.subtransient
                                                                cim:SynchronousMachineModelKind.subtransientSimplified
                                                                cim:SynchronousMachineModelKind.subtransientSimplifiedDirectAxis
                                                                cim:SynchronousMachineModelKind.subtransientTypeF
                                                                cim:SynchronousMachineModelKind.subtransientTypeJ)];
                                cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.SynchronousMachineDynamics";
                                cimdoc:packageTier "Normative".
cim:SynchronousMachineModelKind.subtransient a owl:NamedIndividual,
                                               cim:SynchronousMachineModelKind;
                                             rdfs:comment "Subtransient synchronous machine model."@en;
                                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                             rdfs:label "subtransient"@en;
                                             cimdoc:enumCode 0 .
cim:SynchronousMachineModelKind.subtransientSimplified a owl:NamedIndividual,
                                                         cim:SynchronousMachineModelKind;
                                                       rdfs:comment "Simplified version of subtransient synchronous machine model where magnetic coupling between the direct- and quadrature- axes is ignored."@en;
                                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                       rdfs:label "subtransientSimplified"@en;
                                                       cimdoc:enumCode 3 .
cim:SynchronousMachineModelKind.subtransientSimplifiedDirectAxis a owl:NamedIndividual,
                                                                   cim:SynchronousMachineModelKind;
                                                                 rdfs:comment "Simplified version of a subtransient synchronous machine model with no damper circuit on the direct-axis."@en;
                                                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                                 rdfs:label "subtransientSimplifiedDirectAxis"@en;
                                                                 cimdoc:enumCode 4 .
cim:SynchronousMachineModelKind.subtransientTypeF a owl:NamedIndividual,
                                                    cim:SynchronousMachineModelKind;
                                                  rdfs:comment "WECC type F variant of subtransient synchronous machine model."@en;
                                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                  rdfs:label "subtransientTypeF"@en;
                                                  cimdoc:enumCode 1 .
cim:SynchronousMachineModelKind.subtransientTypeJ a owl:NamedIndividual,
                                                    cim:SynchronousMachineModelKind;
                                                  rdfs:comment "WECC type J variant of subtransient synchronous machine model."@en;
                                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                  rdfs:label "subtransientTypeJ"@en;
                                                  cimdoc:enumCode 2 .
cim:SynchronousMachineOperatingMode a owl:Class;
                                    rdfs:comment "Synchronous machine operating mode."@en;
                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                    rdfs:label "SynchronousMachineOperatingMode"@en;
                                    owl:equivalentClass [a owl:Class ; 
                                                         owl:oneOf (cim:SynchronousMachineOperatingMode.condenser
                                                                    cim:SynchronousMachineOperatingMode.generator
                                                                    cim:SynchronousMachineOperatingMode.motor)];
                                    cimdoc:cimPackage "IEC61970.Base.Wires";
                                    cimdoc:packageTier "Normative".
cim:SynchronousMachineOperatingMode.condenser a owl:NamedIndividual,
                                                cim:SynchronousMachineOperatingMode;
                                              rdfs:comment "Operating as condenser."@en;
                                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                              rdfs:label "condenser"@en;
                                              cimdoc:enumCode 1 .
cim:SynchronousMachineOperatingMode.generator a owl:NamedIndividual,
                                                cim:SynchronousMachineOperatingMode;
                                              rdfs:comment "Operating as generator."@en;
                                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                              rdfs:label "generator"@en;
                                              cimdoc:enumCode 0 .
cim:SynchronousMachineOperatingMode.motor a owl:NamedIndividual,
                                            cim:SynchronousMachineOperatingMode;
                                          rdfs:comment "Operating as motor."@en;
                                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                          rdfs:label "motor"@en;
                                          cimdoc:enumCode 2 .
cim:SynchronousMachineSimplified a owl:Class;
                                 rdfs:comment "The simplified model represents a synchronous generator as a constant internal voltage behind an impedance (Rs + jXp) as shown in the Simplified diagram. Since internal voltage is held constant, there is no Efd input and any excitation system model will be ignored. There is also no Ifd output. This model should not be used for representing a real generator except, perhaps, small generators whose response is insignificant. The parameters used for the simplified model include: - RotatingMachineDynamics.damping (D); - RotatingMachineDynamics.inertia (H); - RotatingMachineDynamics.statorLeakageReactance (used to exchange jXp for SynchronousMachineSimplified); - RotatingMachineDynamics.statorResistance (Rs)."@en;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "SynchronousMachineSimplified"@en;
                                 rdfs:subClassOf cim:SynchronousMachineDynamics;
                                 cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.SynchronousMachineDynamics";
                                 cimdoc:packageTier "Normative".
cim:SynchronousMachineTimeConstantReactance a owl:Class;
                                            rdfs:comment "Synchronous machine detailed modelling types are defined by the combination of the attributes SynchronousMachineTimeConstantReactance.modelType and SynchronousMachineTimeConstantReactance.rotorType. Parameter details: - The �p� in the time-related attribute names is a substitution for a �prime� in the usual parameter notation, e.g. tpdo refers to T'do. - The parameters used for models expressed in time constant reactance form include:; - RotatingMachine.ratedS (MVAbase); - RotatingMachineDynamics.damping (D); - RotatingMachineDynamics.inertia (H); - RotatingMachineDynamics.saturationFactor (S1); - RotatingMachineDynamics.saturationFactor120 (S12); - RotatingMachineDynamics.statorLeakageReactance (Xl); - RotatingMachineDynamics.statorResistance (Rs); - SynchronousMachineTimeConstantReactance.ks (Ks); - SynchronousMachineDetailed.saturationFactorQAxis (S1q); - SynchronousMachineDetailed.saturationFactor120QAxis (S12q); - SynchronousMachineDetailed.efdBaseRatio; - SynchronousMachineDetailed.ifdBaseType; - .xDirectSync (Xd); - .xDirectTrans (X'd); - .xDirectSubtrans (X''d); - .xQuadSync (Xq); - .xQuadTrans (X'q); - .xQuadSubtrans (X''q); - .tpdo (T'do); - .tppdo (T''do); - .tpqo (T'qo); - .tppqo (T''qo); - .tc."@en;
                                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                            rdfs:label "SynchronousMachineTimeConstantReactance"@en;
                                            rdfs:subClassOf cim:SynchronousMachineDetailed;
                                            cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.SynchronousMachineDynamics";
                                            cimdoc:packageTier "Normative".
cim:SynchronousMachineTimeConstantReactance.ks a owl:DatatypeProperty;
                                               rdfs:comment "Saturation loading correction factor (Ks) (>= 0). Used only by type J model. Typical value = 0."@en;
                                               rdfs:domain cim:SynchronousMachineTimeConstantReactance;
                                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                               rdfs:label "ks"@en;
                                               rdfs:range xsd:float.
cim:SynchronousMachineTimeConstantReactance.modelType a owl:ObjectProperty;
                                                      rdfs:comment "Type of synchronous machine model used in dynamic simulation applications."@en;
                                                      rdfs:domain cim:SynchronousMachineTimeConstantReactance;
                                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                      rdfs:label "modelType"@en;
                                                      rdfs:range cim:SynchronousMachineModelKind.
cim:SynchronousMachineTimeConstantReactance.rotorType a owl:ObjectProperty;
                                                      rdfs:comment "Type of rotor on physical machine."@en;
                                                      rdfs:domain cim:SynchronousMachineTimeConstantReactance;
                                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                      rdfs:label "rotorType"@en;
                                                      rdfs:range cim:RotorKind.
cim:SynchronousMachineTimeConstantReactance.tc a owl:DatatypeProperty;
                                               rdfs:comment "Damping time constant for �Canay� reactance (>= 0). Typical value = 0."@en;
                                               rdfs:domain cim:SynchronousMachineTimeConstantReactance;
                                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                               rdfs:label "tc"@en;
                                               rdfs:range cim:Seconds.
cim:SynchronousMachineTimeConstantReactance.tpdo a owl:DatatypeProperty;
                                                 rdfs:comment "Direct-axis transient rotor time constant (T'do) (> SynchronousMachineTimeConstantReactance.tppdo). Typical value = 5."@en;
                                                 rdfs:domain cim:SynchronousMachineTimeConstantReactance;
                                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                 rdfs:label "tpdo"@en;
                                                 rdfs:range cim:Seconds.
cim:SynchronousMachineTimeConstantReactance.tppdo a owl:DatatypeProperty;
                                                  rdfs:comment "Direct-axis subtransient rotor time constant (T''do) (> 0). Typical value = 0,03."@en;
                                                  rdfs:domain cim:SynchronousMachineTimeConstantReactance;
                                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                  rdfs:label "tppdo"@en;
                                                  rdfs:range cim:Seconds.
cim:SynchronousMachineTimeConstantReactance.tppqo a owl:DatatypeProperty;
                                                  rdfs:comment "Quadrature-axis subtransient rotor time constant (T''qo) (> 0). Typical value = 0,03."@en;
                                                  rdfs:domain cim:SynchronousMachineTimeConstantReactance;
                                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                  rdfs:label "tppqo"@en;
                                                  rdfs:range cim:Seconds.
cim:SynchronousMachineTimeConstantReactance.tpqo a owl:DatatypeProperty;
                                                 rdfs:comment "Quadrature-axis transient rotor time constant (T'qo) (> SynchronousMachineTimeConstantReactance.tppqo). Typical value = 0,5."@en;
                                                 rdfs:domain cim:SynchronousMachineTimeConstantReactance;
                                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                 rdfs:label "tpqo"@en;
                                                 rdfs:range cim:Seconds.
cim:SynchronousMachineTimeConstantReactance.xDirectSubtrans a owl:DatatypeProperty;
                                                            rdfs:comment "Direct-axis subtransient reactance (unsaturated) (X''d) (> RotatingMachineDynamics.statorLeakageReactance). Typical value = 0,2."@en;
                                                            rdfs:domain cim:SynchronousMachineTimeConstantReactance;
                                                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                            rdfs:label "xDirectSubtrans"@en;
                                                            rdfs:range cim:PU.
cim:SynchronousMachineTimeConstantReactance.xDirectSync a owl:DatatypeProperty;
                                                        rdfs:comment "Direct-axis synchronous reactance (Xd) (>= SynchronousMachineTimeConstantReactance.xDirectTrans). The quotient of a sustained value of that AC component of armature voltage that is produced by the total direct-axis flux due to direct-axis armature current and the value of the AC component of this current, the machine running at rated speed. Typical value = 1,8."@en;
                                                        rdfs:domain cim:SynchronousMachineTimeConstantReactance;
                                                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                        rdfs:label "xDirectSync"@en;
                                                        rdfs:range cim:PU.
cim:SynchronousMachineTimeConstantReactance.xDirectTrans a owl:DatatypeProperty;
                                                         rdfs:comment "Direct-axis transient reactance (unsaturated) (X'd) (>= SynchronousMachineTimeConstantReactance.xDirectSubtrans). Typical value = 0,5."@en;
                                                         rdfs:domain cim:SynchronousMachineTimeConstantReactance;
                                                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                         rdfs:label "xDirectTrans"@en;
                                                         rdfs:range cim:PU.
cim:SynchronousMachineTimeConstantReactance.xQuadSubtrans a owl:DatatypeProperty;
                                                          rdfs:comment "Quadrature-axis subtransient reactance (X''q) (> RotatingMachineDynamics. statorLeakageReactance). Typical value = 0,2."@en;
                                                          rdfs:domain cim:SynchronousMachineTimeConstantReactance;
                                                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                          rdfs:label "xQuadSubtrans"@en;
                                                          rdfs:range cim:PU.
cim:SynchronousMachineTimeConstantReactance.xQuadSync a owl:DatatypeProperty;
                                                      rdfs:comment "Quadrature-axis synchronous reactance (Xq) (>= SynchronousMachineTimeConstantReactance.xQuadTrans). The ratio of the component of reactive armature voltage, due to the quadrature- axis component of armature current, to this component of current, under steady state conditions and at rated frequency. Typical value = 1,6."@en;
                                                      rdfs:domain cim:SynchronousMachineTimeConstantReactance;
                                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                      rdfs:label "xQuadSync"@en;
                                                      rdfs:range cim:PU.
cim:SynchronousMachineTimeConstantReactance.xQuadTrans a owl:DatatypeProperty;
                                                       rdfs:comment "Quadrature-axis transient reactance (X'q) (>= SynchronousMachineTimeConstantReactance.xQuadSubtrans). Typical value = 0,3."@en;
                                                       rdfs:domain cim:SynchronousMachineTimeConstantReactance;
                                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                       rdfs:label "xQuadTrans"@en;
                                                       rdfs:range cim:PU.
cim:SynchronousMachineUserDefined a owl:Class;
                                  rdfs:comment "Synchronous machine whose dynamic behaviour is described by a user-defined model."@en;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "SynchronousMachineUserDefined"@en;
                                  rdfs:subClassOf cim:SynchronousMachineDynamics;
                                  cimdoc:cimPackage "IEC61970.Dynamics.UserDefinedModels";
                                  cimdoc:packageTier "Normative".
cim:SynchronousMachineUserDefined.proprietary a owl:DatatypeProperty;
                                              rdfs:comment "Behaviour is based on a proprietary model as opposed to a detailed model. true = user-defined model is proprietary with behaviour mutually understood by sending and receiving applications and parameters passed as general attributes false = user-defined model is explicitly defined in terms of control blocks and their input and output signals."@en;
                                              rdfs:domain cim:SynchronousMachineUserDefined;
                                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                              rdfs:label "proprietary"@en;
                                              rdfs:range xsd:boolean.
cim:TASE2BilateralTable a owl:Class;
                        rdfs:comment "This class describe the sending (providing) side in a bilateral ICCP data exchange. Hence the ICCP bilateral (table) descriptions are created by exchanging ICCP Provider data between the parties."@en;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                        rdfs:label "TASE2BilateralTable"@en;
                        rdfs:subClassOf cim:BilateralExchangeAgreement;
                        cimdoc:cimPackage "IEC61970.Base.ICCPConfiguration";
                        cimdoc:packageTier "Normative".
cim:TASE2BilateralTable.bilateralTableID a owl:DatatypeProperty;
                                         rdfs:comment "Specifies the version of the Bilateral Table configuration that is being exchanged."@en;
                                         rdfs:domain cim:TASE2BilateralTable;
                                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                         rdfs:label "bilateralTableID"@en;
                                         rdfs:range xsd:string.
cim:TASE2BilateralTable.bilateralTableVersion a owl:DatatypeProperty;
                                              rdfs:comment "The Version attribute identifies a unique version of the Bilateral Table. If any changes are made to a Bilateral Table, then a new unique value for this attribute shall be generated."@en;
                                              rdfs:domain cim:TASE2BilateralTable;
                                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                              rdfs:label "bilateralTableVersion"@en;
                                              rdfs:range xsd:string.
cim:TASE2BilateralTable.tase2version a owl:DatatypeProperty;
                                     rdfs:comment "Specifies the version of the TASE.2 that is needed to access the Bilateral Table information via TASE.2. In order for a link to be established, both sides must have the same value."@en;
                                     rdfs:domain cim:TASE2BilateralTable;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                     rdfs:label "tase2version"@en;
                                     rdfs:range xsd:string.
cim:TCPAccessPoint a owl:Class;
                   rdfs:comment "Allows addressing and behavioural information regarding the use of TCP by ICCP links."@en;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "TCPAccessPoint"@en;
                   rdfs:subClassOf cim:IPAccessPoint;
                   cimdoc:cimPackage "IEC61970.Base.ICCPConfiguration";
                   cimdoc:packageTier "Normative".
cim:TCPAccessPoint.keepAliveTime a owl:DatatypeProperty;
                                 rdfs:comment "Indicates the default interval at which TCP will check if the TCP connection is still valid."@en;
                                 rdfs:domain cim:TCPAccessPoint;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "keepAliveTime"@en;
                                 rdfs:range xsd:integer.
cim:TCPAccessPoint.port a owl:DatatypeProperty;
                        rdfs:comment """This value is only needed to be specified for called nodes (e.g. those that respond to a TCP.Open request). This value specifies the TCP port to be used. Well known and \"registered\" ports are preferred and can be found at: http://www.iana.org/assignments/service-names-port-numbers/service-names-port- numbers.xhtml For IEC 60870-6 TASE.2 (e.g. ICCP) and IEC 61850, the value used shall be 102 for non-TLS protected exchanges. The value shall be 3782 for TLS transported ICCP and 61850 exchanges."""@en;
                        rdfs:domain cim:TCPAccessPoint;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                        rdfs:label "port"@en;
                        rdfs:range xsd:integer.
cim:TailbayLossCurve a owl:Class;
                     rdfs:comment "Relationship between tailbay head loss height (Y-axis) and the total discharge into the power station's tailbay volume per time unit (X-axis) . There could be more than one curve depending on the level of the tailbay reservoir or river level."@en;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                     rdfs:label "TailbayLossCurve"@en;
                     rdfs:subClassOf cim:Curve;
                     cimdoc:cimPackage "IEC61970.Base.Generation.Production";
                     cimdoc:packageTier "Normative".
cim:TapChanger a owl:Class;
               rdfs:comment "Mechanism for changing transformer winding tap positions."@en;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "TapChanger"@en;
               rdfs:subClassOf cim:PowerSystemResource;
               cimdoc:cimPackage "IEC61970.Base.Wires";
               cimdoc:packageTier "Normative".
cim:TapChanger.TapChangerControl a owl:ObjectProperty;
                                 rdfs:comment "The regulating control scheme in which this tap changer participates."@en;
                                 rdfs:domain cim:TapChanger;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "TapChangerControl"@en;
                                 rdfs:range cim:TapChangerControl.
cim:TapChanger.controlEnabled a owl:DatatypeProperty;
                              rdfs:comment "Specifies the regulation status of the equipment. True is regulating, false is not regulating."@en;
                              rdfs:domain cim:TapChanger;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "controlEnabled"@en;
                              rdfs:range xsd:boolean.
cim:TapChanger.highStep a owl:DatatypeProperty;
                        rdfs:comment "Highest possible tap step position, advance from neutral. The attribute shall be greater than lowStep."@en;
                        rdfs:domain cim:TapChanger;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                        rdfs:label "highStep"@en;
                        rdfs:range xsd:integer.
cim:TapChanger.initialDelay a owl:DatatypeProperty;
                            rdfs:comment "For an LTC, the delay for initial tap changer operation (first step change)."@en;
                            rdfs:domain cim:TapChanger;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "initialDelay"@en;
                            rdfs:range cim:Seconds.
cim:TapChanger.lowStep a owl:DatatypeProperty;
                       rdfs:comment "Lowest possible tap step position, retard from neutral."@en;
                       rdfs:domain cim:TapChanger;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "lowStep"@en;
                       rdfs:range xsd:integer.
cim:TapChanger.ltcFlag a owl:DatatypeProperty;
                       rdfs:comment "Specifies whether or not a TapChanger has load tap changing capabilities."@en;
                       rdfs:domain cim:TapChanger;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "ltcFlag"@en;
                       rdfs:range xsd:boolean.
cim:TapChanger.neutralStep a owl:DatatypeProperty;
                           rdfs:comment "The neutral tap step position for this winding. The attribute shall be equal to or greater than lowStep and equal or less than highStep. It is the step position where the voltage is neutralU when the other terminals of the transformer are at the ratedU. If there are other tap changers on the transformer those taps are kept constant at their neutralStep."@en;
                           rdfs:domain cim:TapChanger;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "neutralStep"@en;
                           rdfs:range xsd:integer.
cim:TapChanger.neutralU a owl:DatatypeProperty;
                        rdfs:comment "Voltage at which the winding operates at the neutral tap setting. It is the voltage at the terminal of the PowerTransformerEnd associated with the tap changer when all tap changers on the transformer are at their neutralStep position. Normally neutralU of the tap changer is the same as ratedU of the PowerTransformerEnd, but it can differ in special cases such as when the tapping mechanism is separate from the winding more common on lower voltage transformers. This attribute is not relevant for PhaseTapChangerAsymmetrical, PhaseTapChangerSymmetrical and PhaseTapChangerLinear."@en;
                        rdfs:domain cim:TapChanger;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                        rdfs:label "neutralU"@en;
                        rdfs:range cim:Voltage.
cim:TapChanger.normalStep a owl:DatatypeProperty;
                          rdfs:comment """The tap step position used in \"normal\" network operation for this winding. For a \"Fixed\" tap changer indicates the current physical tap setting. The attribute shall be equal to or greater than lowStep and equal to or less than highStep."""@en;
                          rdfs:domain cim:TapChanger;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                          rdfs:label "normalStep"@en;
                          rdfs:range xsd:integer.
cim:TapChanger.step a owl:DatatypeProperty;
                    rdfs:comment "Tap changer position. Starting step for a steady state solution. Non integer values are allowed to support continuous tap variables. The reasons for continuous value are to support study cases where no discrete tap changer has yet been designed, a solution where a narrow voltage band forces the tap step to oscillate or to accommodate for a continuous solution as input. The attribute shall be equal to or greater than lowStep and equal to or less than highStep."@en;
                    rdfs:domain cim:TapChanger;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "step"@en;
                    rdfs:range xsd:float.
cim:TapChanger.subsequentDelay a owl:DatatypeProperty;
                               rdfs:comment "For an LTC, the delay for subsequent tap changer operation (second and later step changes)."@en;
                               rdfs:domain cim:TapChanger;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "subsequentDelay"@en;
                               rdfs:range cim:Seconds.
cim:TapChangerControl a owl:Class;
                      rdfs:comment "Describes behaviour specific to tap changers, e.g. how the voltage at the end of a line varies with the load level and compensation of the voltage drop by tap adjustment."@en;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "TapChangerControl"@en;
                      rdfs:subClassOf cim:RegulatingControl;
                      cimdoc:cimPackage "IEC61970.Base.Wires";
                      cimdoc:packageTier "Normative".
cim:TapChangerControl.limitVoltage a owl:DatatypeProperty;
                                   rdfs:comment "Maximum allowed regulated voltage on the PT secondary, regardless of line drop compensation. Sometimes referred to as first-house protection."@en;
                                   rdfs:domain cim:TapChangerControl;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                   rdfs:label "limitVoltage"@en;
                                   rdfs:range cim:Voltage.
cim:TapChangerControl.lineDropCompensation a owl:DatatypeProperty;
                                           rdfs:comment "If true, the line drop compensation is to be applied."@en;
                                           rdfs:domain cim:TapChangerControl;
                                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                           rdfs:label "lineDropCompensation"@en;
                                           rdfs:range xsd:boolean.
cim:TapChangerControl.lineDropR a owl:DatatypeProperty;
                                rdfs:comment "Line drop compensator resistance setting for normal (forward) power flow."@en;
                                rdfs:domain cim:TapChangerControl;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "lineDropR"@en;
                                rdfs:range cim:Resistance.
cim:TapChangerControl.lineDropX a owl:DatatypeProperty;
                                rdfs:comment "Line drop compensator reactance setting for normal (forward) power flow."@en;
                                rdfs:domain cim:TapChangerControl;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "lineDropX"@en;
                                rdfs:range cim:Reactance.
cim:TapChangerControl.reverseLineDropR a owl:DatatypeProperty;
                                       rdfs:comment "Line drop compensator resistance setting for reverse power flow."@en;
                                       rdfs:domain cim:TapChangerControl;
                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                       rdfs:label "reverseLineDropR"@en;
                                       rdfs:range cim:Resistance.
cim:TapChangerControl.reverseLineDropX a owl:DatatypeProperty;
                                       rdfs:comment "Line drop compensator reactance setting for reverse power flow."@en;
                                       rdfs:domain cim:TapChangerControl;
                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                       rdfs:label "reverseLineDropX"@en;
                                       rdfs:range cim:Reactance.
cim:TapChangerTablePoint a owl:Class;
                         rdfs:comment "Describes each tap step in the tabular curve."@en;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                         rdfs:label "TapChangerTablePoint"@en;
                         cimdoc:cimPackage "IEC61970.Base.Wires";
                         cimdoc:packageTier "Normative".
cim:TapChangerTablePoint.b a owl:DatatypeProperty;
                           rdfs:comment "The magnetizing branch susceptance deviation as a percentage of nominal value. The actual susceptance is calculated as follows: calculated magnetizing susceptance = b(nominal) * (1 + b(from this class)/100). The b(nominal) is defined as the static magnetizing susceptance on the associated power transformer end or ends. This model assumes the star impedance (pi model) form."@en;
                           rdfs:domain cim:TapChangerTablePoint;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "b"@en;
                           rdfs:range cim:PerCent.
cim:TapChangerTablePoint.g a owl:DatatypeProperty;
                           rdfs:comment "The magnetizing branch conductance deviation as a percentage of nominal value. The actual conductance is calculated as follows: calculated magnetizing conductance = g(nominal) * (1 + g(from this class)/100). The g(nominal) is defined as the static magnetizing conductance on the associated power transformer end or ends. This model assumes the star impedance (pi model) form."@en;
                           rdfs:domain cim:TapChangerTablePoint;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "g"@en;
                           rdfs:range cim:PerCent.
cim:TapChangerTablePoint.r a owl:DatatypeProperty;
                           rdfs:comment "The resistance deviation as a percentage of nominal value. The actual reactance is calculated as follows: calculated resistance = r(nominal) * (1 + r(from this class)/100). The r(nominal) is defined as the static resistance on the associated power transformer end or ends. This model assumes the star impedance (pi model) form."@en;
                           rdfs:domain cim:TapChangerTablePoint;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "r"@en;
                           rdfs:range cim:PerCent.
cim:TapChangerTablePoint.ratio a owl:DatatypeProperty;
                               rdfs:comment "The voltage at the tap step divided by rated voltage of the transformer end having the tap changer. Hence this is a value close to one. For example, if the ratio at step 1 is 1.01, and the rated voltage of the transformer end is 110kV, then the voltage obtained by setting the tap changer to step 1 to is 111.1kV."@en;
                               rdfs:domain cim:TapChangerTablePoint;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "ratio"@en;
                               rdfs:range xsd:float.
cim:TapChangerTablePoint.step a owl:DatatypeProperty;
                              rdfs:comment "The tap step."@en;
                              rdfs:domain cim:TapChangerTablePoint;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "step"@en;
                              rdfs:range xsd:integer.
cim:TapChangerTablePoint.x a owl:DatatypeProperty;
                           rdfs:comment "The series reactance deviation as a percentage of nominal value. The actual reactance is calculated as follows: calculated reactance = x(nominal) * (1 + x(from this class)/100). The x(nominal) is defined as the static series reactance on the associated power transformer end or ends. This model assumes the star impedance (pi model) form."@en;
                           rdfs:domain cim:TapChangerTablePoint;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "x"@en;
                           rdfs:range cim:PerCent.
cim:TapSchedule a owl:Class;
                rdfs:comment "A pre-established pattern over time for a tap step."@en;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "TapSchedule"@en;
                rdfs:subClassOf cim:SeasonDayTypeSchedule;
                cimdoc:cimPackage "IEC61970.Base.Wires";
                cimdoc:packageTier "Normative".
cim:TapSchedule.TapChanger a owl:ObjectProperty;
                           rdfs:comment "A TapSchedule is associated with a TapChanger."@en;
                           rdfs:domain cim:TapSchedule;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "TapChanger"@en;
                           rdfs:range cim:TapChanger.
cim:TargetLevelSchedule a owl:Class;
                        rdfs:comment """Reservoir water level targets from advanced studies or \"rule curves\". Typically in one hour increments for up to 10 days."""@en;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                        rdfs:label "TargetLevelSchedule"@en;
                        rdfs:subClassOf cim:Curve;
                        cimdoc:cimPackage "IEC61970.Base.Generation.Production";
                        cimdoc:packageTier "Normative".
cim:TargetLevelSchedule.highLevelLimit a owl:DatatypeProperty;
                                       rdfs:comment "High target level limit, above which the reservoir operation will be penalized."@en;
                                       rdfs:domain cim:TargetLevelSchedule;
                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                       rdfs:label "highLevelLimit"@en;
                                       rdfs:range cim:WaterLevel.
cim:TargetLevelSchedule.lowLevelLimit a owl:DatatypeProperty;
                                      rdfs:comment "Low target level limit, below which the reservoir operation will be penalized."@en;
                                      rdfs:domain cim:TargetLevelSchedule;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                      rdfs:label "lowLevelLimit"@en;
                                      rdfs:range cim:WaterLevel.
cim:Temperature a rdfs:Datatype;
                rdfs:comment "Value of temperature in degrees Celsius."@en;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "Temperature"@en;
                owl:equivalentClass xsd:float;
                cimdoc:cimPackage "IEC61970.Base.Domain";
                cimdoc:packageTier "Normative";
                cimdoc:unitMultiplier cim:UnitMultiplier.none;
                cimdoc:unitSymbol cim:UnitSymbol.degC.
cim:TemperatureDependentLimitPoint a owl:Class;
                                   rdfs:comment "A point on a table of limit verses temperature."@en;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                   rdfs:label "TemperatureDependentLimitPoint"@en;
                                   cimdoc:cimPackage "IEC61970.InfIEC61970.InfOperationalLimits";
                                   cimdoc:packageTier "Informative".
cim:TemperatureDependentLimitPoint.limitPercent a owl:DatatypeProperty;
                                                rdfs:comment "The scaling of the operational limit in percent."@en;
                                                rdfs:domain cim:TemperatureDependentLimitPoint;
                                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                rdfs:label "limitPercent"@en;
                                                rdfs:range cim:PerCent.
cim:TemperatureDependentLimitPoint.temperature a owl:DatatypeProperty;
                                               rdfs:comment "The temperature of the table point."@en;
                                               rdfs:domain cim:TemperatureDependentLimitPoint;
                                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                               rdfs:label "temperature"@en;
                                               rdfs:range cim:Temperature.
cim:TemperatureDependentLimitTable a owl:Class;
                                   rdfs:comment "This is a table lookup that provides limit values corresponding to a temperature input."@en;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                   rdfs:label "TemperatureDependentLimitTable"@en;
                                   rdfs:subClassOf cim:EnvironmentalDependentLimit;
                                   cimdoc:cimPackage "IEC61970.InfIEC61970.InfOperationalLimits";
                                   cimdoc:packageTier "Informative".
cim:TemperatureDependentLimitTable.TemperatureLimitTablePoint a owl:ObjectProperty;
                                                              rdfs:comment "The temperature limit table point for this table."@en;
                                                              rdfs:domain cim:TemperatureDependentLimitTable;
                                                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                              rdfs:label "TemperatureLimitTablePoint"@en;
                                                              rdfs:range cim:TemperatureDependentLimitPoint.
cim:TemperaturePolynomialLimit a owl:Class;
                               rdfs:comment "This describes the coefficients of a polynomial function that has temperature as input and calculates limit values as output."@en;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "TemperaturePolynomialLimit"@en;
                               rdfs:subClassOf cim:EnvironmentalDependentLimit;
                               cimdoc:cimPackage "IEC61970.InfIEC61970.InfOperationalLimits";
                               cimdoc:packageTier "Informative".
cim:TemperaturePolynomialLimit.coefficient0 a owl:DatatypeProperty;
                                            rdfs:comment "The polynomial coefficient of power 0."@en;
                                            rdfs:domain cim:TemperaturePolynomialLimit;
                                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                            rdfs:label "coefficient0"@en;
                                            rdfs:range xsd:float.
cim:TemperaturePolynomialLimit.coefficient1 a owl:DatatypeProperty;
                                            rdfs:comment "The polynomial coefficient of power 1."@en;
                                            rdfs:domain cim:TemperaturePolynomialLimit;
                                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                            rdfs:label "coefficient1"@en;
                                            rdfs:range xsd:float.
cim:TemperaturePolynomialLimit.coefficient2 a owl:DatatypeProperty;
                                            rdfs:comment "The polynomial coefficient of power 2."@en;
                                            rdfs:domain cim:TemperaturePolynomialLimit;
                                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                            rdfs:label "coefficient2"@en;
                                            rdfs:range xsd:float.
cim:TemperaturePolynomialLimit.coefficient3 a owl:DatatypeProperty;
                                            rdfs:comment "The polynomial coefficient of power 3."@en;
                                            rdfs:domain cim:TemperaturePolynomialLimit;
                                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                            rdfs:label "coefficient3"@en;
                                            rdfs:range xsd:float.
cim:TemperaturePolynomialLimit.coefficient4 a owl:DatatypeProperty;
                                            rdfs:comment "The polynomial coefficient of power 4."@en;
                                            rdfs:domain cim:TemperaturePolynomialLimit;
                                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                            rdfs:label "coefficient4"@en;
                                            rdfs:range xsd:float.
cim:Terminal a owl:Class;
             rdfs:comment "An AC electrical connection point to a piece of conducting equipment. Terminals are connected at physical connection points called connectivity nodes."@en;
             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
             rdfs:label "Terminal"@en;
             rdfs:subClassOf cim:ACDCTerminal;
             cimdoc:cimPackage "IEC61970.Base.Core";
             cimdoc:packageTier "Normative".
cim:Terminal.ConductingEquipment a owl:ObjectProperty;
                                 rdfs:comment "The conducting equipment of the terminal. Conducting equipment have terminals that may be connected to other conducting equipment terminals via connectivity nodes or topological nodes."@en;
                                 rdfs:domain cim:Terminal;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "ConductingEquipment"@en;
                                 rdfs:range cim:ConductingEquipment.
cim:Terminal.ConnectivityNode a owl:ObjectProperty;
                              rdfs:comment "The connectivity node to which this terminal connects with zero impedance."@en;
                              rdfs:domain cim:Terminal;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "ConnectivityNode"@en;
                              rdfs:range cim:ConnectivityNode.
cim:Terminal.RegulatingControl a owl:ObjectProperty;
                               rdfs:comment "The controls regulating this terminal."@en;
                               rdfs:domain cim:Terminal;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "RegulatingControl"@en;
                               rdfs:range cim:RegulatingControl.
cim:Terminal.phases a owl:ObjectProperty;
                    rdfs:comment "Represents the normal network phasing condition. If the attribute is missing, three phases (ABC) shall be assumed, except for terminals of grounding classes (specializations of EarthFaultCompensator, GroundDisconnector, and Ground) which will be assumed to be N. Therefore, phase code ABCN is explicitly declared when needed, e.g. for star point grounding equipment. The phase code on terminals connecting same ConnectivityNode or same TopologicalNode as well as for equipment between two terminals shall be consistent."@en;
                    rdfs:domain cim:Terminal;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "phases"@en;
                    rdfs:range cim:PhaseCode.
cim:TextDiagramObject a owl:Class;
                      rdfs:comment "A diagram object for placing free-text or text derived from an associated domain object."@en;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "TextDiagramObject"@en;
                      rdfs:subClassOf cim:DiagramObject;
                      cimdoc:cimPackage "IEC61970.Base.DiagramLayout";
                      cimdoc:packageTier "Normative".
cim:TextDiagramObject.text a owl:DatatypeProperty;
                           rdfs:comment "The text that is displayed by this text diagram object."@en;
                           rdfs:domain cim:TextDiagramObject;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "text"@en;
                           rdfs:range xsd:string.
cim:ThermalGeneratingUnit a owl:Class;
                          rdfs:comment "A generating unit whose prime mover could be a steam turbine, combustion turbine, or diesel engine."@en;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                          rdfs:label "ThermalGeneratingUnit"@en;
                          rdfs:subClassOf cim:GeneratingUnit;
                          cimdoc:cimPackage "IEC61970.Base.Generation.Production";
                          cimdoc:packageTier "Normative".
cim:ThermalGeneratingUnit.EmissionCurves a owl:ObjectProperty;
                                         rdfs:comment "A thermal generating unit may have one or more emission curves."@en;
                                         rdfs:domain cim:ThermalGeneratingUnit;
                                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                         rdfs:label "EmissionCurves"@en;
                                         rdfs:range cim:EmissionCurve.
cim:ThermalGeneratingUnit.EmmissionAccounts a owl:ObjectProperty;
                                            rdfs:comment "A thermal generating unit may have one or more emission allowance accounts."@en;
                                            rdfs:domain cim:ThermalGeneratingUnit;
                                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                            rdfs:label "EmmissionAccounts"@en;
                                            rdfs:range cim:EmissionAccount.
cim:ThermalGeneratingUnit.FuelAllocationSchedules a owl:ObjectProperty;
                                                  rdfs:comment "A thermal generating unit may have one or more fuel allocation schedules."@en;
                                                  rdfs:domain cim:ThermalGeneratingUnit;
                                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                  rdfs:label "FuelAllocationSchedules"@en;
                                                  rdfs:range cim:FuelAllocationSchedule.
cim:ThermalGeneratingUnit.HeatInputCurve a owl:ObjectProperty;
                                         rdfs:comment "A thermal generating unit may have a heat input curve."@en;
                                         rdfs:domain cim:ThermalGeneratingUnit;
                                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                         rdfs:label "HeatInputCurve"@en;
                                         rdfs:range cim:HeatInputCurve.
cim:ThermalGeneratingUnit.HeatRateCurve a owl:ObjectProperty;
                                        rdfs:comment "A thermal generating unit may have a heat rate curve."@en;
                                        rdfs:domain cim:ThermalGeneratingUnit;
                                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                        rdfs:label "HeatRateCurve"@en;
                                        rdfs:range cim:HeatRateCurve.
cim:ThermalGeneratingUnit.IncrementalHeatRateCurve a owl:ObjectProperty;
                                                   rdfs:comment "A thermal generating unit may have an incremental heat rate curve."@en;
                                                   rdfs:domain cim:ThermalGeneratingUnit;
                                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                   rdfs:label "IncrementalHeatRateCurve"@en;
                                                   rdfs:range cim:IncrementalHeatRateCurve.
cim:ThermalGeneratingUnit.ShutdownCurve a owl:ObjectProperty;
                                        rdfs:comment "A thermal generating unit may have a shutdown curve."@en;
                                        rdfs:domain cim:ThermalGeneratingUnit;
                                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                        rdfs:label "ShutdownCurve"@en;
                                        rdfs:range cim:ShutdownCurve.
cim:ThermalGeneratingUnit.StartupModel a owl:ObjectProperty;
                                       rdfs:comment "A thermal generating unit may have a startup model."@en;
                                       rdfs:domain cim:ThermalGeneratingUnit;
                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                       rdfs:label "StartupModel"@en;
                                       rdfs:range cim:StartupModel.
cim:ThermalGeneratingUnit.oMCost a owl:DatatypeProperty;
                                 rdfs:comment "Operating and maintenance cost for the thermal unit."@en;
                                 rdfs:domain cim:ThermalGeneratingUnit;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "oMCost"@en;
                                 rdfs:range cim:CostPerHeatUnit.
cim:TieFlow a owl:Class;
            rdfs:comment "Defines the structure (in terms of location and direction) of the net interchange constraint for a control area. This constraint may be used by either AGC or power flow."@en;
            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
            rdfs:label "TieFlow"@en;
            rdfs:subClassOf cim:IdentifiedObject;
            cimdoc:cimPackage "IEC61970.Base.ControlArea";
            cimdoc:packageTier "Normative".
cim:TieFlow.AltTieMeas a owl:ObjectProperty;
                       rdfs:comment "The primary and alternate tie flow measurements associated with the tie flow."@en;
                       rdfs:domain cim:TieFlow;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "AltTieMeas"@en;
                       rdfs:range cim:AltTieMeas.
cim:TieFlow.Terminal a owl:ObjectProperty;
                     rdfs:comment "The terminal to which this tie flow belongs."@en;
                     rdfs:domain cim:TieFlow;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                     rdfs:label "Terminal"@en;
                     rdfs:range cim:Terminal.
cim:TieFlow.positiveFlowIn a owl:DatatypeProperty;
                           rdfs:comment "Specifies the sign of the tie flow associated with a control area. True if positive flow into the terminal (load convention) is also positive flow into the control area. See the description of ControlArea for further explanation of how TieFlow.positiveFlowIn is used."@en;
                           rdfs:domain cim:TieFlow;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "positiveFlowIn"@en;
                           rdfs:range xsd:boolean.
cim:Time a rdfs:Datatype;
         rdfs:comment """Time as \"hh:mm:ss.sss\", which conforms with ISO 8601. UTC time zone is specified as \"hh:mm:ss.sssZ\". A local timezone relative UTC is specified as \"hh: mm:ss.sss�hh:mm\". The second component (shown here as \"ss.sss\") could have any number of digits in its fractional part to allow any kind of precision beyond seconds."""@en;
         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
         rdfs:label "Time"@en;
         owl:equivalentClass xsd:time;
         cimdoc:cimPackage "IEC61970.Base.Domain";
         cimdoc:packageTier "Normative".
cim:TimeInterval a owl:Class;
                 rdfs:comment "Interval between two times."@en;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "TimeInterval"@en;
                 cimdoc:cimPackage "IEC61970.Base.Domain";
                 cimdoc:packageTier "Normative".
cim:TimeInterval.end a owl:DatatypeProperty;
                     rdfs:comment "End time of this interval."@en;
                     rdfs:domain cim:TimeInterval;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                     rdfs:label "end"@en;
                     rdfs:range xsd:time.
cim:TimeInterval.start a owl:DatatypeProperty;
                       rdfs:comment "Start time of this interval."@en;
                       rdfs:domain cim:TimeInterval;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "start"@en;
                       rdfs:range xsd:time.
cim:TopologicalIsland a owl:Class;
                      rdfs:comment "An electrically connected subset of the network. Topological islands can change as the current network state changes, e.g. due to: - disconnect switches or breakers changing state in a SCADA/EMS. - manual creation, change or deletion of topological nodes in a planning tool. Only energised TopologicalNode-s shall be part of the topological island."@en;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "TopologicalIsland"@en;
                      rdfs:subClassOf cim:IdentifiedObject;
                      cimdoc:cimPackage "IEC61970.Base.Topology";
                      cimdoc:packageTier "Normative".
cim:TopologicalIsland.AngleRefTopologicalNode a owl:ObjectProperty;
                                              rdfs:comment "The angle reference for the island. Normally there is one TopologicalNode that is selected as the angle reference for each island. Other reference schemes exist, so the association is typically optional."@en;
                                              rdfs:domain cim:TopologicalIsland;
                                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                              rdfs:label "AngleRefTopologicalNode"@en;
                                              rdfs:range cim:TopologicalNode.
cim:TopologicalIsland.TopologicalNodes a owl:ObjectProperty;
                                       rdfs:comment "A topological node belongs to a topological island."@en;
                                       rdfs:domain cim:TopologicalIsland;
                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                       rdfs:label "TopologicalNodes"@en;
                                       rdfs:range cim:TopologicalNode.
cim:TopologicalNode a owl:Class;
                    rdfs:comment """For a detailed substation model a topological node is a set of connectivity nodes that, in the current network state, are connected together through any type of closed switches, including jumpers. Topological nodes change as the current network state changes (i.e., switches, breakers, etc. change state). For a planning model, switch statuses are not used to form topological nodes. Instead they are manually created or deleted in a model builder tool. Topological nodes maintained this way are also called \"busses\"."""@en;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "TopologicalNode"@en;
                    rdfs:subClassOf cim:IdentifiedObject;
                    cimdoc:cimPackage "IEC61970.Base.Topology";
                    cimdoc:packageTier "Normative".
cim:TopologicalNode.BaseVoltage a owl:ObjectProperty;
                                rdfs:comment "The base voltage of the topological node."@en;
                                rdfs:domain cim:TopologicalNode;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "BaseVoltage"@en;
                                rdfs:range cim:BaseVoltage.
cim:TopologicalNode.ConnectivityNodeContainer a owl:ObjectProperty;
                                              rdfs:comment "The connectivity node container to which the topological node belongs."@en;
                                              rdfs:domain cim:TopologicalNode;
                                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                              rdfs:label "ConnectivityNodeContainer"@en;
                                              rdfs:range cim:ConnectivityNodeContainer.
cim:TopologicalNode.ConnectivityNodes a owl:ObjectProperty;
                                      rdfs:comment "The connectivity nodes combine together to form this topological node. May depend on the current state of switches in the network."@en;
                                      rdfs:domain cim:TopologicalNode;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                      rdfs:label "ConnectivityNodes"@en;
                                      rdfs:range cim:ConnectivityNode.
cim:TopologicalNode.ReportingGroup a owl:ObjectProperty;
                                   rdfs:comment "The reporting group to which the topological node belongs."@en;
                                   rdfs:domain cim:TopologicalNode;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                   rdfs:label "ReportingGroup"@en;
                                   rdfs:range cim:ReportingGroup.
cim:TopologicalNode.Terminal a owl:ObjectProperty;
                             rdfs:comment "The terminals associated with the topological node. This can be used as an alternative to the connectivity node path to terminal, thus making it unnecessary to model connectivity nodes in some cases. Note that if connectivity nodes are in the model, this association would probably not be used as an input specification."@en;
                             rdfs:domain cim:TopologicalNode;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "Terminal"@en;
                             rdfs:range cim:Terminal.
cim:TopologicalNode.pInjection a owl:DatatypeProperty;
                               rdfs:comment "The active power injected into the bus at this location in addition to injections from equipment. Positive sign means injection into the TopologicalNode (bus). Starting value for a steady state solution."@en;
                               rdfs:domain cim:TopologicalNode;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "pInjection"@en;
                               rdfs:range cim:ActivePower.
cim:TopologicalNode.qInjection a owl:DatatypeProperty;
                               rdfs:comment "The reactive power injected into the bus at this location in addition to injections from equipment. Positive sign means injection into the TopologicalNode (bus). Starting value for a steady state solution."@en;
                               rdfs:domain cim:TopologicalNode;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "qInjection"@en;
                               rdfs:range cim:ReactivePower.
cim:TransformerControlMode a owl:Class;
                           rdfs:comment "Control modes for a transformer."@en;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "TransformerControlMode"@en;
                           owl:equivalentClass [a owl:Class ; 
                                                owl:oneOf (cim:TransformerControlMode.reactive
                                                           cim:TransformerControlMode.volt)];
                           cimdoc:cimPackage "IEC61970.Base.Wires";
                           cimdoc:packageTier "Normative".
cim:TransformerControlMode.reactive a owl:NamedIndividual,
                                      cim:TransformerControlMode;
                                    rdfs:comment "Reactive power flow control."@en;
                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                    rdfs:label "reactive"@en;
                                    cimdoc:enumCode 1 .
cim:TransformerControlMode.volt a owl:NamedIndividual,
                                  cim:TransformerControlMode;
                                rdfs:comment "Voltage control."@en;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "volt"@en;
                                cimdoc:enumCode 0 .
cim:TransformerCoreAdmittance a owl:Class;
                              rdfs:comment "The transformer core admittance. Used to specify the core admittance of a transformer in a manner that can be shared among power transformers."@en;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "TransformerCoreAdmittance"@en;
                              rdfs:subClassOf cim:IdentifiedObject;
                              cimdoc:cimPackage "IEC61970.Base.Wires";
                              cimdoc:packageTier "Normative".
cim:TransformerCoreAdmittance.TransformerEnd a owl:ObjectProperty;
                                             rdfs:comment "All transformer ends having this core admittance."@en;
                                             rdfs:domain cim:TransformerCoreAdmittance;
                                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                             rdfs:label "TransformerEnd"@en;
                                             rdfs:range cim:TransformerEnd.
cim:TransformerCoreAdmittance.b a owl:DatatypeProperty;
                                rdfs:comment "Magnetizing branch susceptance (B mag). The value can be positive or negative."@en;
                                rdfs:domain cim:TransformerCoreAdmittance;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "b"@en;
                                rdfs:range cim:Susceptance.
cim:TransformerCoreAdmittance.b0 a owl:DatatypeProperty;
                                 rdfs:comment "Zero sequence magnetizing branch susceptance."@en;
                                 rdfs:domain cim:TransformerCoreAdmittance;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "b0"@en;
                                 rdfs:range cim:Susceptance.
cim:TransformerCoreAdmittance.g a owl:DatatypeProperty;
                                rdfs:comment "Magnetizing branch conductance (G mag)."@en;
                                rdfs:domain cim:TransformerCoreAdmittance;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "g"@en;
                                rdfs:range cim:Conductance.
cim:TransformerCoreAdmittance.g0 a owl:DatatypeProperty;
                                 rdfs:comment "Zero sequence magnetizing branch conductance."@en;
                                 rdfs:domain cim:TransformerCoreAdmittance;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "g0"@en;
                                 rdfs:range cim:Conductance.
cim:TransformerEnd a owl:Class;
                   rdfs:comment "A conducting connection point of a power transformer. It corresponds to a physical transformer winding terminal. In earlier CIM versions, the TransformerWinding class served a similar purpose, but this class is more flexible because it associates to terminal but is not a specialization of ConductingEquipment."@en;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "TransformerEnd"@en;
                   rdfs:subClassOf cim:IdentifiedObject;
                   cimdoc:cimPackage "IEC61970.Base.Wires";
                   cimdoc:packageTier "Normative".
cim:TransformerEnd.BaseVoltage a owl:ObjectProperty;
                               rdfs:comment "Base voltage of the transformer end. This is essential for PU calculation."@en;
                               rdfs:domain cim:TransformerEnd;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "BaseVoltage"@en;
                               rdfs:range cim:BaseVoltage.
cim:TransformerEnd.PhaseTapChanger a owl:ObjectProperty;
                                   rdfs:comment "Phase tap changer associated with this transformer end."@en;
                                   rdfs:domain cim:TransformerEnd;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                   rdfs:label "PhaseTapChanger"@en;
                                   rdfs:range cim:PhaseTapChanger.
cim:TransformerEnd.RatioTapChanger a owl:ObjectProperty;
                                   rdfs:comment "Ratio tap changer associated with this transformer end."@en;
                                   rdfs:domain cim:TransformerEnd;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                   rdfs:label "RatioTapChanger"@en;
                                   rdfs:range cim:RatioTapChanger.
cim:TransformerEnd.StarImpedance a owl:ObjectProperty;
                                 rdfs:comment "(accurate for 2- or 3-winding transformers only) Pi-model impedances of this transformer end. By convention, for a two winding transformer, the full values of the transformer should be entered on the high voltage end (endNumber=1)."@en;
                                 rdfs:domain cim:TransformerEnd;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "StarImpedance"@en;
                                 rdfs:range cim:TransformerStarImpedance.
cim:TransformerEnd.Terminal a owl:ObjectProperty;
                            rdfs:comment "Terminal of the power transformer to which this transformer end belongs."@en;
                            rdfs:domain cim:TransformerEnd;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "Terminal"@en;
                            rdfs:range cim:Terminal.
cim:TransformerEnd.bmagSat a owl:DatatypeProperty;
                           rdfs:comment "Core shunt magnetizing susceptance in the saturation region."@en;
                           rdfs:domain cim:TransformerEnd;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "bmagSat"@en;
                           rdfs:range cim:PerCent.
cim:TransformerEnd.endNumber a owl:DatatypeProperty;
                             rdfs:comment "Number for this transformer end, corresponding to the end's order in the power transformer vector group or phase angle clock number. Highest voltage winding should be 1. Each end within a power transformer should have a unique subsequent end number. Note the transformer end number need not match the terminal sequence number."@en;
                             rdfs:domain cim:TransformerEnd;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "endNumber"@en;
                             rdfs:range xsd:integer.
cim:TransformerEnd.grounded a owl:DatatypeProperty;
                            rdfs:comment "(for Yn and Zn connections) True if the neutral is solidly grounded."@en;
                            rdfs:domain cim:TransformerEnd;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "grounded"@en;
                            rdfs:range xsd:boolean.
cim:TransformerEnd.magBaseU a owl:DatatypeProperty;
                            rdfs:comment "The reference voltage at which the magnetizing saturation measurements were made."@en;
                            rdfs:domain cim:TransformerEnd;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "magBaseU"@en;
                            rdfs:range cim:Voltage.
cim:TransformerEnd.magSatFlux a owl:DatatypeProperty;
                              rdfs:comment "Core magnetizing saturation curve knee flux level."@en;
                              rdfs:domain cim:TransformerEnd;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "magSatFlux"@en;
                              rdfs:range cim:PerCent.
cim:TransformerEnd.rground a owl:DatatypeProperty;
                           rdfs:comment "(for Yn and Zn connections) Resistance part of neutral impedance where 'grounded' is true."@en;
                           rdfs:domain cim:TransformerEnd;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "rground"@en;
                           rdfs:range cim:Resistance.
cim:TransformerEnd.xground a owl:DatatypeProperty;
                           rdfs:comment "(for Yn and Zn connections) Reactive part of neutral impedance where 'grounded' is true."@en;
                           rdfs:domain cim:TransformerEnd;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "xground"@en;
                           rdfs:range cim:Reactance.
cim:TransformerMeshImpedance a owl:Class;
                             rdfs:comment "Transformer mesh impedance (Delta-model) between transformer ends. The typical case is that this class describes the impedance between two transformer ends pair-wise, i.e. the cardinalities at both transformer end associations are 1. However, in cases where two or more transformer ends are modelled the cardinalities are larger than 1."@en;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "TransformerMeshImpedance"@en;
                             rdfs:subClassOf cim:IdentifiedObject;
                             cimdoc:cimPackage "IEC61970.Base.Wires";
                             cimdoc:packageTier "Normative".
cim:TransformerMeshImpedance.FromTransformerEnd a owl:ObjectProperty;
                                                rdfs:comment "From end this mesh impedance is connected to. It determines the voltage reference."@en;
                                                rdfs:domain cim:TransformerMeshImpedance;
                                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                rdfs:label "FromTransformerEnd"@en;
                                                rdfs:range cim:TransformerEnd.
cim:TransformerMeshImpedance.ToTransformerEnd a owl:ObjectProperty;
                                              rdfs:comment "All transformer ends this mesh impedance is connected to."@en;
                                              rdfs:domain cim:TransformerMeshImpedance;
                                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                              rdfs:label "ToTransformerEnd"@en;
                                              rdfs:range cim:TransformerEnd.
cim:TransformerMeshImpedance.r a owl:DatatypeProperty;
                               rdfs:comment "Resistance between the 'from' and the 'to' end, seen from the 'from' end."@en;
                               rdfs:domain cim:TransformerMeshImpedance;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "r"@en;
                               rdfs:range cim:Resistance.
cim:TransformerMeshImpedance.r0 a owl:DatatypeProperty;
                                rdfs:comment "Zero-sequence resistance between the 'from' and the 'to' end, seen from the 'from' end."@en;
                                rdfs:domain cim:TransformerMeshImpedance;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "r0"@en;
                                rdfs:range cim:Resistance.
cim:TransformerMeshImpedance.x a owl:DatatypeProperty;
                               rdfs:comment "Reactance between the 'from' and the 'to' end, seen from the 'from' end."@en;
                               rdfs:domain cim:TransformerMeshImpedance;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "x"@en;
                               rdfs:range cim:Reactance.
cim:TransformerMeshImpedance.x0 a owl:DatatypeProperty;
                                rdfs:comment "Zero-sequence reactance between the 'from' and the 'to' end, seen from the 'from' end."@en;
                                rdfs:domain cim:TransformerMeshImpedance;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "x0"@en;
                                rdfs:range cim:Reactance.
cim:TransformerStarImpedance a owl:Class;
                             rdfs:comment "Transformer star impedance (Pi-model) that accurately reflects impedance for transformers with 2 or 3 windings. For transformers with 4 or more windings, TransformerMeshImpedance class shall be used. For transmission networks use PowerTransformerEnd impedances (r, r0, x, x0, b, b0, g and g0)."@en;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "TransformerStarImpedance"@en;
                             rdfs:subClassOf cim:IdentifiedObject;
                             cimdoc:cimPackage "IEC61970.Base.Wires";
                             cimdoc:packageTier "Normative".
cim:TransformerStarImpedance.r a owl:DatatypeProperty;
                               rdfs:comment "Resistance of the transformer end."@en;
                               rdfs:domain cim:TransformerStarImpedance;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "r"@en;
                               rdfs:range cim:Resistance.
cim:TransformerStarImpedance.r0 a owl:DatatypeProperty;
                                rdfs:comment "Zero sequence series resistance of the transformer end."@en;
                                rdfs:domain cim:TransformerStarImpedance;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "r0"@en;
                                rdfs:range cim:Resistance.
cim:TransformerStarImpedance.x a owl:DatatypeProperty;
                               rdfs:comment "Positive sequence series reactance of the transformer end."@en;
                               rdfs:domain cim:TransformerStarImpedance;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "x"@en;
                               rdfs:range cim:Reactance.
cim:TransformerStarImpedance.x0 a owl:DatatypeProperty;
                                rdfs:comment "Zero sequence series reactance of the transformer end."@en;
                                rdfs:domain cim:TransformerStarImpedance;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "x0"@en;
                                rdfs:range cim:Reactance.
cim:TransformerTank a owl:Class;
                    rdfs:comment "An assembly of two or more coupled windings that transform electrical power between voltage levels. These windings are bound on a common core and placed in the same tank. Transformer tank can be used to model both single-phase and 3- phase transformers."@en;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "TransformerTank"@en;
                    rdfs:subClassOf cim:Equipment;
                    cimdoc:cimPackage "IEC61970.Base.Wires";
                    cimdoc:packageTier "Normative".
cim:TransformerTank.PowerTransformer a owl:ObjectProperty;
                                     rdfs:comment "Bank this transformer belongs to."@en;
                                     rdfs:domain cim:TransformerTank;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                     rdfs:label "PowerTransformer"@en;
                                     rdfs:range cim:PowerTransformer.
cim:TransformerTankEnd a owl:Class;
                       rdfs:comment "Transformer tank end represents an individual winding for unbalanced models or for transformer tanks connected into a bank (and bank is modelled with the PowerTransformer)."@en;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "TransformerTankEnd"@en;
                       rdfs:subClassOf cim:TransformerEnd;
                       cimdoc:cimPackage "IEC61970.Base.Wires";
                       cimdoc:packageTier "Normative".
cim:TransformerTankEnd.TransformerTank a owl:ObjectProperty;
                                       rdfs:comment "Transformer this winding belongs to."@en;
                                       rdfs:domain cim:TransformerTankEnd;
                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                       rdfs:label "TransformerTank"@en;
                                       rdfs:range cim:TransformerTank.
cim:TransformerTankEnd.phases a owl:ObjectProperty;
                              rdfs:comment "Describes the phases carried by a conducting equipment."@en;
                              rdfs:domain cim:TransformerTankEnd;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "phases"@en;
                              rdfs:range cim:PhaseCode.
cim:TriggerCondition a owl:Class;
                     rdfs:comment "A conditions that can trigger remedial actions."@en;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                     rdfs:label "TriggerCondition"@en;
                     rdfs:subClassOf cim:IdentifiedObject;
                     cimdoc:cimPackage "IEC61970.InfIEC61970.InfSIPS";
                     cimdoc:packageTier "Informative".
cim:TriggerCondition.GateTrigger a owl:ObjectProperty;
                                 rdfs:comment "The resulting Gate that is the condition for the Trigger."@en;
                                 rdfs:domain cim:TriggerCondition;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "GateTrigger"@en;
                                 rdfs:range cim:Gate.
cim:TriggerCondition.RemedialActionScheme a owl:ObjectProperty;
                                          rdfs:comment "The remedial action scheme associated with this trigger condition."@en;
                                          rdfs:domain cim:TriggerCondition;
                                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                          rdfs:label "RemedialActionScheme"@en;
                                          rdfs:range cim:RemedialActionScheme.
cim:TurbLCFB1 a owl:Class;
              rdfs:comment "Turbine load controller model developed by WECC. This model represents a supervisory turbine load controller that acts to maintain turbine power at a set value by continuous adjustment of the turbine governor speed-load reference. This model is intended to represent slow reset 'outer loop' controllers managing the action of the turbine governor."@en;
              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
              rdfs:label "TurbLCFB1"@en;
              rdfs:subClassOf cim:TurbineLoadControllerDynamics;
              cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.TurbineLoadControllerDynamics";
              cimdoc:packageTier "Normative".
cim:TurbLCFB1.db a owl:DatatypeProperty;
                 rdfs:comment "Controller deadband (db). Typical value = 0."@en;
                 rdfs:domain cim:TurbLCFB1;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "db"@en;
                 rdfs:range cim:PU.
cim:TurbLCFB1.emax a owl:DatatypeProperty;
                   rdfs:comment "Maximum control error (Emax) (see parameter detail 4). Typical value = 0,02."@en;
                   rdfs:domain cim:TurbLCFB1;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "emax"@en;
                   rdfs:range cim:PU.
cim:TurbLCFB1.fb a owl:DatatypeProperty;
                 rdfs:comment "Frequency bias gain (Fb). Typical value = 0."@en;
                 rdfs:domain cim:TurbLCFB1;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "fb"@en;
                 rdfs:range cim:PU.
cim:TurbLCFB1.fbf a owl:DatatypeProperty;
                  rdfs:comment "Frequency bias flag (Fbf). true = enable frequency bias false = disable frequency bias. Typical value = false."@en;
                  rdfs:domain cim:TurbLCFB1;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "fbf"@en;
                  rdfs:range xsd:boolean.
cim:TurbLCFB1.irmax a owl:DatatypeProperty;
                    rdfs:comment "Maximum turbine speed/load reference bias (Irmax) (see parameter detail 3). Typical value = 0."@en;
                    rdfs:domain cim:TurbLCFB1;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "irmax"@en;
                    rdfs:range cim:PU.
cim:TurbLCFB1.ki a owl:DatatypeProperty;
                 rdfs:comment "Integral gain (Ki). Typical value = 0."@en;
                 rdfs:domain cim:TurbLCFB1;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "ki"@en;
                 rdfs:range cim:PU.
cim:TurbLCFB1.kp a owl:DatatypeProperty;
                 rdfs:comment "Proportional gain (Kp). Typical value = 0."@en;
                 rdfs:domain cim:TurbLCFB1;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "kp"@en;
                 rdfs:range cim:PU.
cim:TurbLCFB1.mwbase a owl:DatatypeProperty;
                     rdfs:comment "Base for power values (MWbase) (> 0). Unit = MW."@en;
                     rdfs:domain cim:TurbLCFB1;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                     rdfs:label "mwbase"@en;
                     rdfs:range cim:ActivePower.
cim:TurbLCFB1.pbf a owl:DatatypeProperty;
                  rdfs:comment "Power controller flag (Pbf). true = enable load controller false = disable load controller. Typical value = false."@en;
                  rdfs:domain cim:TurbLCFB1;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "pbf"@en;
                  rdfs:range xsd:boolean.
cim:TurbLCFB1.pmwset a owl:DatatypeProperty;
                     rdfs:comment "Power controller setpoint (Pmwset) (see parameter detail 1). Unit = MW. Typical value = 0."@en;
                     rdfs:domain cim:TurbLCFB1;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                     rdfs:label "pmwset"@en;
                     rdfs:range cim:ActivePower.
cim:TurbLCFB1.speedReferenceGovernor a owl:DatatypeProperty;
                                     rdfs:comment "Type of turbine governor reference (Type). true = speed reference governor false = load reference governor. Typical value = true."@en;
                                     rdfs:domain cim:TurbLCFB1;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                     rdfs:label "speedReferenceGovernor"@en;
                                     rdfs:range xsd:boolean.
cim:TurbLCFB1.tpelec a owl:DatatypeProperty;
                     rdfs:comment "Power transducer time constant (Tpelec) (>= 0). Typical value = 0."@en;
                     rdfs:domain cim:TurbLCFB1;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                     rdfs:label "tpelec"@en;
                     rdfs:range cim:Seconds.
