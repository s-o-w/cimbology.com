                               cimdoc:packageTier "Normative".
cim:Ground a owl:Class;
           rdfs:comment "A point where the system is grounded used for connecting conducting equipment to ground. The power system model can have any number of grounds."@en;
           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
           rdfs:label "Ground"@en;
           rdfs:subClassOf cim:ConductingEquipment;
           cimdoc:cimPackage "IEC61970.Base.Wires";
           cimdoc:packageTier "Normative".
cim:GroundDisconnector a owl:Class;
