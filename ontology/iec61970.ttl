cim:ExcELIN2.seve1 a owl:DatatypeProperty;
                   rdfs:comment "Exciter saturation function value at the corresponding exciter voltage, Ve1, back of commutating reactance (Se[Ve1]) (>= 0). Typical value = 0."@en;
