                          rdfs:label "FaultCauseTypes"@en;
                          rdfs:range cim:FaultCauseType.
cim:Fault.FaultyEquipment a owl:ObjectProperty;
                          rdfs:comment "Equipment carrying this fault."@en;
                          rdfs:domain cim:Fault;
