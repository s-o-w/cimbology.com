                rdfs:comment "Gain of radiation shield (K5)."@en;
                rdfs:domain cim:GovGAST2;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "k5"@en;
                rdfs:range cim:PU.
cim:GovGAST2.k6 a owl:DatatypeProperty;
                rdfs:comment "Minimum fuel flow (K6)."@en;
