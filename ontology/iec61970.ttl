                                          rdfs:domain cim:HydroPowerPlant;
                                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                          rdfs:label "hydroPlantStorageType"@en;
                                          rdfs:range cim:HydroPlantStorageKind.
cim:HydroPowerPlant.penstockType a owl:DatatypeProperty;
                                 rdfs:comment "Type and configuration of hydro plant penstock(s)."@en;
                                 rdfs:domain cim:HydroPowerPlant;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "penstockType"@en;
                                 rdfs:range xsd:string.
cim:HydroPowerPlant.plantDischargeCapacity a owl:DatatypeProperty;
