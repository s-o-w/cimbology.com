cim:PssWECC a owl:Class;
            rdfs:comment "Dual input power system stabilizer, based on IEEE type 2, with modified output limiter defined by WECC (Western Electricity Coordinating Council, USA)."@en;
            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
            rdfs:label "PssWECC"@en;
