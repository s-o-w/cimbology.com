cim:RemoteInputSignal a owl:Class;
                      rdfs:comment "Supports connection to a terminal associated with a remote bus from which an input signal of a specific type is coming."@en;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "RemoteInputSignal"@en;
                      rdfs:subClassOf cim:IdentifiedObject;
