                               rdfs:domain cim:IEC61970CIMVersion;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "version"@en;
                               rdfs:range xsd:string.
cim:IOPoint a owl:Class;
            rdfs:comment "The class describe a measurement or control value. The purpose is to enable having attributes and associations common for measurement and control."@en;
