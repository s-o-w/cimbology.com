cim:ExcSK.kqp a owl:DatatypeProperty;
              rdfs:comment "PI controller gain (Kqp). Typical value = 0."@en;
              rdfs:domain cim:ExcSK;
              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
              rdfs:label "kqp"@en;
