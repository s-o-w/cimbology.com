cim:ExcIEEEST2A a owl:Class;
                rdfs:comment "IEEE 421.5-2005 type ST2A model. Some static systems use both current and voltage sources (generator terminal quantities) to comprise the power source. The regulator controls the exciter output through controlled saturation of the power transformer components. These compound-source rectifier excitation systems are designated type ST2A and are represented by ExcIEEEST2A. Reference: IEEE 421.5-2005, 7.2."@en;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "ExcIEEEST2A"@en;
                rdfs:subClassOf cim:ExcitationSystemDynamics;
                cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.ExcitationSystemDynamics";
                cimdoc:packageTier "Normative".
cim:ExcIEEEST2A.efdmax a owl:DatatypeProperty;
                       rdfs:comment "Maximum field voltage (EFDMax) (>= 0). Typical value = 99."@en;
                       rdfs:domain cim:ExcIEEEST2A;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "efdmax"@en;
                       rdfs:range cim:PU.
cim:ExcIEEEST2A.ka a owl:DatatypeProperty;
                   rdfs:comment "Voltage regulator gain (KA) (> 0). Typical value = 120."@en;
                   rdfs:domain cim:ExcIEEEST2A;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "ka"@en;
                   rdfs:range cim:PU.
cim:ExcIEEEST2A.kc a owl:DatatypeProperty;
                   rdfs:comment "Rectifier loading factor proportional to commutating reactance (KC) (>= 0). Typical value = 1,82."@en;
                   rdfs:domain cim:ExcIEEEST2A;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "kc"@en;
                   rdfs:range cim:PU.
cim:ExcIEEEST2A.ke a owl:DatatypeProperty;
                   rdfs:comment "Exciter constant related to self-excited field (KE). Typical value = 1."@en;
                   rdfs:domain cim:ExcIEEEST2A;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "ke"@en;
                   rdfs:range cim:PU.
cim:ExcIEEEST2A.kf a owl:DatatypeProperty;
                   rdfs:comment "Excitation control system stabilizer gains (KF) (>= 0). Typical value = 0,05."@en;
                   rdfs:domain cim:ExcIEEEST2A;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "kf"@en;
                   rdfs:range cim:PU.
cim:ExcIEEEST2A.ki a owl:DatatypeProperty;
                   rdfs:comment "Potential circuit gain coefficient (KI) (>= 0). Typical value = 8."@en;
                   rdfs:domain cim:ExcIEEEST2A;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "ki"@en;
                   rdfs:range cim:PU.
cim:ExcIEEEST2A.kp a owl:DatatypeProperty;
                   rdfs:comment "Potential circuit gain coefficient (KP) (>= 0). Typical value = 4,88."@en;
                   rdfs:domain cim:ExcIEEEST2A;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "kp"@en;
                   rdfs:range cim:PU.
cim:ExcIEEEST2A.ta a owl:DatatypeProperty;
                   rdfs:comment "Voltage regulator time constant (TA) (> 0). Typical value = 0,15."@en;
                   rdfs:domain cim:ExcIEEEST2A;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "ta"@en;
                   rdfs:range cim:Seconds.
cim:ExcIEEEST2A.te a owl:DatatypeProperty;
                   rdfs:comment "Exciter time constant, integration rate associated with exciter control (TE) (> 0). Typical value = 0,5."@en;
                   rdfs:domain cim:ExcIEEEST2A;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "te"@en;
                   rdfs:range cim:Seconds.
cim:ExcIEEEST2A.tf a owl:DatatypeProperty;
                   rdfs:comment "Excitation control system stabilizer time constant (TF) (>= 0). Typical value = 1."@en;
                   rdfs:domain cim:ExcIEEEST2A;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "tf"@en;
                   rdfs:range cim:Seconds.
cim:ExcIEEEST2A.uelin a owl:DatatypeProperty;
                      rdfs:comment "UEL input (UELin). true = HV gate false = add to error signal. Typical value = true."@en;
                      rdfs:domain cim:ExcIEEEST2A;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "uelin"@en;
                      rdfs:range xsd:boolean.
cim:ExcIEEEST2A.vrmax a owl:DatatypeProperty;
                      rdfs:comment "Maximum voltage regulator outputs (VRMAX) (> 0). Typical value = 1."@en;
                      rdfs:domain cim:ExcIEEEST2A;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "vrmax"@en;
                      rdfs:range cim:PU.
cim:ExcIEEEST2A.vrmin a owl:DatatypeProperty;
                      rdfs:comment "Minimum voltage regulator outputs (VRMIN) (less than or equal to 0). Typical value = 0."@en;
                      rdfs:domain cim:ExcIEEEST2A;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "vrmin"@en;
                      rdfs:range cim:PU.
cim:ExcIEEEST3A a owl:Class;
                rdfs:comment "IEEE 421.5-2005 type ST3A model. Some static systems utilize a field voltage control loop to linearize the exciter control characteristic. This also makes the output independent of supply source variations until supply limitations are reached. These systems utilize a variety of controlled-rectifier designs: full thyristor complements or hybrid bridges in either series or shunt configurations. The power source can consist of only a potential source, either fed from the machine terminals or from internal windings. Some designs can have compound power sources utilizing both machine potential and current. These power sources are represented as phasor combinations of machine terminal current and voltage and are accommodated by suitable parameters in model type ST3A which is represented by ExcIEEEST3A. Reference: IEEE 421.5-2005, 7.3."@en;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "ExcIEEEST3A"@en;
                rdfs:subClassOf cim:ExcitationSystemDynamics;
                cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.ExcitationSystemDynamics";
                cimdoc:packageTier "Normative".
cim:ExcIEEEST3A.ka a owl:DatatypeProperty;
                   rdfs:comment "Voltage regulator gain (KA) (> 0). This is parameter K in the IEEE standard. Typical value = 200."@en;
                   rdfs:domain cim:ExcIEEEST3A;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "ka"@en;
                   rdfs:range cim:PU.
cim:ExcIEEEST3A.kc a owl:DatatypeProperty;
                   rdfs:comment "Rectifier loading factor proportional to commutating reactance (KC) (>= 0). Typical value = 0,2."@en;
                   rdfs:domain cim:ExcIEEEST3A;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "kc"@en;
                   rdfs:range cim:PU.
cim:ExcIEEEST3A.kg a owl:DatatypeProperty;
                   rdfs:comment "Feedback gain constant of the inner loop field regulator (KG) (>= 0). Typical value = 1."@en;
                   rdfs:domain cim:ExcIEEEST3A;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "kg"@en;
                   rdfs:range cim:PU.
cim:ExcIEEEST3A.ki a owl:DatatypeProperty;
                   rdfs:comment "Potential circuit gain coefficient (KI) (>= 0). Typical value = 0."@en;
                   rdfs:domain cim:ExcIEEEST3A;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "ki"@en;
                   rdfs:range cim:PU.
cim:ExcIEEEST3A.km a owl:DatatypeProperty;
                   rdfs:comment "Forward gain constant of the inner loop field regulator (KM) (> 0). Typical value = 7,93."@en;
                   rdfs:domain cim:ExcIEEEST3A;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "km"@en;
                   rdfs:range cim:PU.
cim:ExcIEEEST3A.kp a owl:DatatypeProperty;
                   rdfs:comment "Potential circuit gain coefficient (KP) (> 0). Typical value = 6,15."@en;
                   rdfs:domain cim:ExcIEEEST3A;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "kp"@en;
                   rdfs:range cim:PU.
cim:ExcIEEEST3A.ta a owl:DatatypeProperty;
                   rdfs:comment "Voltage regulator time constant (TA) (>= 0). Typical value = 0."@en;
                   rdfs:domain cim:ExcIEEEST3A;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "ta"@en;
                   rdfs:range cim:Seconds.
cim:ExcIEEEST3A.tb a owl:DatatypeProperty;
                   rdfs:comment "Voltage regulator time constant (TB) (>= 0). Typical value = 10."@en;
                   rdfs:domain cim:ExcIEEEST3A;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "tb"@en;
                   rdfs:range cim:Seconds.
cim:ExcIEEEST3A.tc a owl:DatatypeProperty;
                   rdfs:comment "Voltage regulator time constant (TC) (>= 0). Typical value = 1."@en;
                   rdfs:domain cim:ExcIEEEST3A;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "tc"@en;
                   rdfs:range cim:Seconds.
cim:ExcIEEEST3A.thetap a owl:DatatypeProperty;
                       rdfs:comment "Potential circuit phase angle (thetap). Typical value = 0."@en;
                       rdfs:domain cim:ExcIEEEST3A;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "thetap"@en;
                       rdfs:range cim:AngleDegrees.
cim:ExcIEEEST3A.tm a owl:DatatypeProperty;
                   rdfs:comment "Forward time constant of inner loop field regulator (TM) (> 0). Typical value = 0,4."@en;
                   rdfs:domain cim:ExcIEEEST3A;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "tm"@en;
                   rdfs:range cim:Seconds.
cim:ExcIEEEST3A.vbmax a owl:DatatypeProperty;
                      rdfs:comment "Maximum excitation voltage (VBMax) (> 0). Typical value = 6,9."@en;
                      rdfs:domain cim:ExcIEEEST3A;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "vbmax"@en;
                      rdfs:range cim:PU.
cim:ExcIEEEST3A.vgmax a owl:DatatypeProperty;
                      rdfs:comment "Maximum inner loop feedback voltage (VGMax) (>= 0). Typical value = 5,8."@en;
                      rdfs:domain cim:ExcIEEEST3A;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "vgmax"@en;
                      rdfs:range cim:PU.
cim:ExcIEEEST3A.vimax a owl:DatatypeProperty;
                      rdfs:comment "Maximum voltage regulator input limit (VIMAX) (> 0). Typical value = 0,2."@en;
                      rdfs:domain cim:ExcIEEEST3A;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "vimax"@en;
                      rdfs:range cim:PU.
cim:ExcIEEEST3A.vimin a owl:DatatypeProperty;
                      rdfs:comment "Minimum voltage regulator input limit (VIMIN) (less than 0). Typical value = -0,2."@en;
                      rdfs:domain cim:ExcIEEEST3A;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "vimin"@en;
                      rdfs:range cim:PU.
cim:ExcIEEEST3A.vmmax a owl:DatatypeProperty;
                      rdfs:comment "Maximum inner loop output (VMMax) (> 0). Typical value = 1."@en;
                      rdfs:domain cim:ExcIEEEST3A;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "vmmax"@en;
                      rdfs:range cim:PU.
cim:ExcIEEEST3A.vmmin a owl:DatatypeProperty;
                      rdfs:comment "Minimum inner loop output (VMMin) (less than or equal to 0). Typical value = 0."@en;
                      rdfs:domain cim:ExcIEEEST3A;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "vmmin"@en;
                      rdfs:range cim:PU.
cim:ExcIEEEST3A.vrmax a owl:DatatypeProperty;
                      rdfs:comment "Maximum voltage regulator output (VRMAX) (> 0). Typical value = 10."@en;
                      rdfs:domain cim:ExcIEEEST3A;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "vrmax"@en;
                      rdfs:range cim:PU.
cim:ExcIEEEST3A.vrmin a owl:DatatypeProperty;
                      rdfs:comment "Minimum voltage regulator output (VRMIN) (less than 0). Typical value = -10."@en;
                      rdfs:domain cim:ExcIEEEST3A;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "vrmin"@en;
                      rdfs:range cim:PU.
cim:ExcIEEEST3A.xl a owl:DatatypeProperty;
                   rdfs:comment "Reactance associated with potential source (XL) (>= 0). Typical value = 0,081."@en;
