cim:ExcIEEEAC8B a owl:Class;
                rdfs:comment "IEEE 421.5-2005 type AC8B model. This model represents a PID voltage regulator with either a brushless exciter or DC exciter. The AVR in this model consists of PID control, with separate constants for the proportional (KPR), integral (KIR), and derivative (KDR) gains. The representation of the brushless exciter (TE, KE, SE, KC, KD) is similar to the model type AC2A. The type AC8B model can be used to represent static voltage regulators applied to brushless excitation systems. Digitally based voltage regulators feeding DC rotating main exciters can be represented with the AC type AC8B model with the parameters KC and KD set to 0. For thyristor power stages fed from the generator terminals, the limits VRMAX and VRMIN should be a function of terminal voltage: VT x VRMAX and VT x VRMIN. Reference: IEEE 421.5-2005, 6.8."@en;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "ExcIEEEAC8B"@en;
                rdfs:subClassOf cim:ExcitationSystemDynamics;
                cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.ExcitationSystemDynamics";
                cimdoc:packageTier "Normative".
cim:ExcIEEEAC8B.ka a owl:DatatypeProperty;
                   rdfs:comment "Voltage regulator gain (KA) (> 0). Typical value = 1."@en;
                   rdfs:domain cim:ExcIEEEAC8B;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "ka"@en;
                   rdfs:range cim:PU.
cim:ExcIEEEAC8B.kc a owl:DatatypeProperty;
                   rdfs:comment "Rectifier loading factor proportional to commutating reactance (KC) (>= 0). Typical value = 0,55."@en;
                   rdfs:domain cim:ExcIEEEAC8B;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "kc"@en;
                   rdfs:range cim:PU.
cim:ExcIEEEAC8B.kd a owl:DatatypeProperty;
                   rdfs:comment "Demagnetizing factor, a function of exciter alternator reactances (KD) (>= 0). Typical value = 1,1."@en;
                   rdfs:domain cim:ExcIEEEAC8B;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "kd"@en;
                   rdfs:range cim:PU.
cim:ExcIEEEAC8B.kdr a owl:DatatypeProperty;
                    rdfs:comment "Voltage regulator derivative gain (KDR) (>= 0). Typical value = 10."@en;
                    rdfs:domain cim:ExcIEEEAC8B;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "kdr"@en;
                    rdfs:range cim:PU.
cim:ExcIEEEAC8B.ke a owl:DatatypeProperty;
                   rdfs:comment "Exciter constant related to self-excited field (KE). Typical value = 1."@en;
                   rdfs:domain cim:ExcIEEEAC8B;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "ke"@en;
                   rdfs:range cim:PU.
cim:ExcIEEEAC8B.kir a owl:DatatypeProperty;
                    rdfs:comment "Voltage regulator integral gain (KIR) (>= 0). Typical value = 5."@en;
                    rdfs:domain cim:ExcIEEEAC8B;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "kir"@en;
                    rdfs:range cim:PU.
cim:ExcIEEEAC8B.kpr a owl:DatatypeProperty;
                    rdfs:comment "Voltage regulator proportional gain (KPR) (> 0 if ExcIEEEAC8B.kir = 0). Typical value = 80."@en;
                    rdfs:domain cim:ExcIEEEAC8B;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "kpr"@en;
                    rdfs:range cim:PU.
cim:ExcIEEEAC8B.seve1 a owl:DatatypeProperty;
                      rdfs:comment "Exciter saturation function value at the corresponding exciter voltage, VE1, back of commutating reactance (SE[VE1]) (>= 0). Typical value = 0,3."@en;
                      rdfs:domain cim:ExcIEEEAC8B;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "seve1"@en;
                      rdfs:range xsd:float.
cim:ExcIEEEAC8B.seve2 a owl:DatatypeProperty;
                      rdfs:comment "Exciter saturation function value at the corresponding exciter voltage, VE2, back of commutating reactance (SE[VE2]) (>= 0). Typical value = 3."@en;
                      rdfs:domain cim:ExcIEEEAC8B;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "seve2"@en;
                      rdfs:range xsd:float.
cim:ExcIEEEAC8B.ta a owl:DatatypeProperty;
                   rdfs:comment "Voltage regulator time constant (TA) (>= 0). Typical value = 0."@en;
                   rdfs:domain cim:ExcIEEEAC8B;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "ta"@en;
                   rdfs:range cim:Seconds.
cim:ExcIEEEAC8B.tdr a owl:DatatypeProperty;
                    rdfs:comment "Lag time constant (TDR) (> 0). Typical value = 0,1."@en;
                    rdfs:domain cim:ExcIEEEAC8B;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "tdr"@en;
                    rdfs:range cim:Seconds.
cim:ExcIEEEAC8B.te a owl:DatatypeProperty;
                   rdfs:comment "Exciter time constant, integration rate associated with exciter control (TE) (> 0). Typical value = 1,2."@en;
                   rdfs:domain cim:ExcIEEEAC8B;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "te"@en;
                   rdfs:range cim:Seconds.
cim:ExcIEEEAC8B.ve1 a owl:DatatypeProperty;
                    rdfs:comment "Exciter alternator output voltages back of commutating reactance at which saturation is defined (VE1) (> 0). Typical value = 6, 5."@en;
                    rdfs:domain cim:ExcIEEEAC8B;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "ve1"@en;
                    rdfs:range cim:PU.
cim:ExcIEEEAC8B.ve2 a owl:DatatypeProperty;
                    rdfs:comment "Exciter alternator output voltages back of commutating reactance at which saturation is defined (VE2) (> 0). Typical value = 9."@en;
                    rdfs:domain cim:ExcIEEEAC8B;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "ve2"@en;
                    rdfs:range cim:PU.
cim:ExcIEEEAC8B.vemin a owl:DatatypeProperty;
                      rdfs:comment "Minimum exciter voltage output (VEMIN) (less than or equal to 0). Typical value = 0."@en;
                      rdfs:domain cim:ExcIEEEAC8B;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "vemin"@en;
                      rdfs:range cim:PU.
cim:ExcIEEEAC8B.vfemax a owl:DatatypeProperty;
                       rdfs:comment "Exciter field current limit reference (VFEMAX). Typical value = 6."@en;
                       rdfs:domain cim:ExcIEEEAC8B;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "vfemax"@en;
                       rdfs:range cim:PU.
cim:ExcIEEEAC8B.vrmax a owl:DatatypeProperty;
                      rdfs:comment "Maximum voltage regulator output (VRMAX) (> 0). Typical value = 35."@en;
                      rdfs:domain cim:ExcIEEEAC8B;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "vrmax"@en;
                      rdfs:range cim:PU.
cim:ExcIEEEAC8B.vrmin a owl:DatatypeProperty;
                      rdfs:comment "Minimum voltage regulator output (VRMIN) (less than or equal to 0). Typical value = 0."@en;
                      rdfs:domain cim:ExcIEEEAC8B;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "vrmin"@en;
                      rdfs:range cim:PU.
cim:ExcIEEEDC1A a owl:Class;
                rdfs:comment "IEEE 421.5-2005 type DC1A model. This model represents field-controlled DC commutator exciters with continuously acting voltage regulators (especially the direct-acting rheostatic, rotating amplifier, and magnetic amplifier types). Because this model has been widely implemented by the industry, it is sometimes used to represent other types of systems when detailed data for them are not available or when a simplified model is required. Reference: IEEE 421.5-2005, 5.1."@en;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "ExcIEEEDC1A"@en;
                rdfs:subClassOf cim:ExcitationSystemDynamics;
                cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.ExcitationSystemDynamics";
                cimdoc:packageTier "Normative".
cim:ExcIEEEDC1A.efd1 a owl:DatatypeProperty;
                     rdfs:comment "Exciter voltage at which exciter saturation is defined (EFD1) (> 0). Typical value = 3,1."@en;
                     rdfs:domain cim:ExcIEEEDC1A;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                     rdfs:label "efd1"@en;
                     rdfs:range cim:PU.
cim:ExcIEEEDC1A.efd2 a owl:DatatypeProperty;
                     rdfs:comment "Exciter voltage at which exciter saturation is defined (EFD2) (> 0). Typical value = 2,3."@en;
                     rdfs:domain cim:ExcIEEEDC1A;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                     rdfs:label "efd2"@en;
                     rdfs:range cim:PU.
cim:ExcIEEEDC1A.exclim a owl:DatatypeProperty;
                       rdfs:comment "(exclim). IEEE standard is ambiguous about lower limit on exciter output. true = a lower limit of zero is applied to integrator output false = a lower limit of zero is not applied to integrator output. Typical value = true."@en;
                       rdfs:domain cim:ExcIEEEDC1A;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "exclim"@en;
                       rdfs:range xsd:boolean.
cim:ExcIEEEDC1A.ka a owl:DatatypeProperty;
                   rdfs:comment "Voltage regulator gain (KA) (> 0). Typical value = 46."@en;
                   rdfs:domain cim:ExcIEEEDC1A;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "ka"@en;
                   rdfs:range cim:PU.
cim:ExcIEEEDC1A.ke a owl:DatatypeProperty;
                   rdfs:comment "Exciter constant related to self-excited field (KE). Typical value = 0."@en;
                   rdfs:domain cim:ExcIEEEDC1A;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "ke"@en;
                   rdfs:range cim:PU.
cim:ExcIEEEDC1A.kf a owl:DatatypeProperty;
                   rdfs:comment "Excitation control system stabilizer gain (KF) (>= 0). Typical value = 0.1."@en;
                   rdfs:domain cim:ExcIEEEDC1A;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "kf"@en;
                   rdfs:range cim:PU.
cim:ExcIEEEDC1A.seefd1 a owl:DatatypeProperty;
                       rdfs:comment "Exciter saturation function value at the corresponding exciter voltage, EFD1 (SE[EFD1]) (>= 0). Typical value = 0.33."@en;
                       rdfs:domain cim:ExcIEEEDC1A;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "seefd1"@en;
                       rdfs:range xsd:float.
cim:ExcIEEEDC1A.seefd2 a owl:DatatypeProperty;
