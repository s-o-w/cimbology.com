cim:HydroPowerPlant.HydroPumps a owl:ObjectProperty;
                               rdfs:comment "The hydro pump may be a member of a pumped storage plant or a pump for distributing water."@en;
                               rdfs:domain cim:HydroPowerPlant;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "HydroPumps"@en;
                               rdfs:range cim:HydroPump.
cim:HydroPowerPlant.Reservoir a owl:ObjectProperty;
                              rdfs:comment "Generators discharge water to or pumps are supplied water from a downstream reservoir."@en;
                              rdfs:domain cim:HydroPowerPlant;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "Reservoir"@en;
                              rdfs:range cim:Reservoir.
cim:HydroPowerPlant.dischargeTravelDelay a owl:DatatypeProperty;
