             cimdoc:packageTier "Informative".
cim:CTTempActivePowerCurve a owl:Class;
                           rdfs:comment "Relationship between the combustion turbine's power output rating in gross active power (X-axis) and the ambient air temperature (Y-axis)."@en;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "CTTempActivePowerCurve"@en;
                           rdfs:subClassOf cim:Curve;
