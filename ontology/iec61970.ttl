cim:PFVArType1IEEEVArController.vvarref a owl:DatatypeProperty;
                                        rdfs:comment "Var controller reference (VVARREF)."@en;
                                        rdfs:domain cim:PFVArType1IEEEVArController;
                                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                        rdfs:label "vvarref"@en;
                                        rdfs:range cim:PU.
cim:PFVArType1IEEEVArController.vvtmax a owl:DatatypeProperty;
                                       rdfs:comment "Maximum machine terminal voltage needed for pf/VAr controller to be enabled (VVTMAX) (greater than PFVArType1IEEEVArController.vvtmin)."@en;
