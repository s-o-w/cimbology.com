                                     rdfs:domain cim:PublicX509Certificate;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                     rdfs:label "issuerName"@en;
                                     rdfs:range xsd:string.
cim:PublicX509Certificate.serialNumber a owl:DatatypeProperty;
                                       rdfs:comment "Is the serial number of the certificate per X.509 definition."@en;
