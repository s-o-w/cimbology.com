                   rdfs:label "pgv1"@en;
                   rdfs:range cim:PU.
cim:GovHydro3.pgv2 a owl:DatatypeProperty;
                   rdfs:comment "Nonlinear gain point 2, PU power (Pgv2). Typical value = 0."@en;
                   rdfs:domain cim:GovHydro3;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "pgv2"@en;
                   rdfs:range cim:PU.
cim:GovHydro3.pgv3 a owl:DatatypeProperty;
                   rdfs:comment "Nonlinear gain point 3, PU power (Pgv3). Typical value = 0."@en;
                   rdfs:domain cim:GovHydro3;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "pgv3"@en;
                   rdfs:range cim:PU.
cim:GovHydro3.pgv4 a owl:DatatypeProperty;
                   rdfs:comment "Nonlinear gain point 4, PU power (Pgv4). Typical value = 0."@en;
                   rdfs:domain cim:GovHydro3;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "pgv4"@en;
                   rdfs:range cim:PU.
cim:GovHydro3.pgv5 a owl:DatatypeProperty;
                   rdfs:comment "Nonlinear gain point 5, PU power (Pgv5). Typical value = 0."@en;
                   rdfs:domain cim:GovHydro3;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "pgv5"@en;
                   rdfs:range cim:PU.
cim:GovHydro3.pgv6 a owl:DatatypeProperty;
                   rdfs:comment "Nonlinear gain point 6, PU power (Pgv6). Typical value = 0."@en;
                   rdfs:domain cim:GovHydro3;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "pgv6"@en;
                   rdfs:range cim:PU.
cim:GovHydro3.pmax a owl:DatatypeProperty;
                   rdfs:comment "Maximum gate opening, PU of MWbase (Pmax) (greater than GovHydro3.pmin). Typical value = 1."@en;
                   rdfs:domain cim:GovHydro3;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "pmax"@en;
                   rdfs:range cim:PU.
cim:GovHydro3.pmin a owl:DatatypeProperty;
                   rdfs:comment "Minimum gate opening, PU of MWbase (Pmin) (less than GovHydro3.pmax). Typical value = 0."@en;
                   rdfs:domain cim:GovHydro3;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "pmin"@en;
                   rdfs:range cim:PU.
cim:GovHydro3.qnl a owl:DatatypeProperty;
                  rdfs:comment "No-load turbine flow at nominal head (Qnl). Typical value = 0,08."@en;
                  rdfs:domain cim:GovHydro3;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "qnl"@en;
                  rdfs:range cim:PU.
cim:GovHydro3.relec a owl:DatatypeProperty;
                    rdfs:comment "Steady-state droop, PU, for electrical power feedback (Relec). Typical value = 0,05."@en;
                    rdfs:domain cim:GovHydro3;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "relec"@en;
                    rdfs:range cim:PU.
cim:GovHydro3.rgate a owl:DatatypeProperty;
                    rdfs:comment "Steady-state droop, PU, for governor output feedback (Rgate). Typical value = 0."@en;
                    rdfs:domain cim:GovHydro3;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "rgate"@en;
                    rdfs:range cim:PU.
cim:GovHydro3.td a owl:DatatypeProperty;
                 rdfs:comment "Input filter time constant (Td) (>= 0). Typical value = 0,05."@en;
                 rdfs:domain cim:GovHydro3;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "td"@en;
                 rdfs:range cim:Seconds.
cim:GovHydro3.tf a owl:DatatypeProperty;
                 rdfs:comment "Washout time constant (Tf) (>= 0). Typical value = 0,1."@en;
                 rdfs:domain cim:GovHydro3;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "tf"@en;
                 rdfs:range cim:Seconds.
cim:GovHydro3.tp a owl:DatatypeProperty;
                 rdfs:comment "Gate servo time constant (Tp) (>= 0). Typical value = 0,05."@en;
                 rdfs:domain cim:GovHydro3;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "tp"@en;
                 rdfs:range cim:Seconds.
cim:GovHydro3.tt a owl:DatatypeProperty;
                 rdfs:comment "Power feedback time constant (Tt) (>= 0). Typical value = 0,2."@en;
                 rdfs:domain cim:GovHydro3;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "tt"@en;
                 rdfs:range cim:Seconds.
cim:GovHydro3.tw a owl:DatatypeProperty;
                 rdfs:comment "Water inertia time constant (Tw) (>= 0). If = 0, block is bypassed. Typical value = 1."@en;
                 rdfs:domain cim:GovHydro3;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "tw"@en;
                 rdfs:range cim:Seconds.
cim:GovHydro3.velcl a owl:DatatypeProperty;
                    rdfs:comment "Maximum gate closing velocity (Velcl). Unit = PU / s. Typical value = - 0,2."@en;
                    rdfs:domain cim:GovHydro3;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "velcl"@en;
                    rdfs:range xsd:float.
cim:GovHydro3.velop a owl:DatatypeProperty;
                    rdfs:comment "Maximum gate opening velocity (Velop). Unit = PU / s. Typical value = 0, 2."@en;
                    rdfs:domain cim:GovHydro3;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "velop"@en;
                    rdfs:range xsd:float.
cim:GovHydro4 a owl:Class;
              rdfs:comment "Hydro turbine and governor. Represents plants with straight-forward penstock configurations and hydraulic governors of the traditional 'dashpot' type. This model can be used to represent simple, Francis/Pelton or Kaplan turbines."@en;
              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
              rdfs:label "GovHydro4"@en;
              rdfs:subClassOf cim:TurbineGovernorDynamics;
              cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.TurbineGovernorDynamics";
              cimdoc:packageTier "Normative".
cim:GovHydro4.at a owl:DatatypeProperty;
                 rdfs:comment "Turbine gain (At). Typical value = 1,2."@en;
                 rdfs:domain cim:GovHydro4;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "at"@en;
                 rdfs:range cim:PU.
cim:GovHydro4.bgv0 a owl:DatatypeProperty;
                   rdfs:comment "Kaplan blade servo point 0 (Bgv0) (= 0 for simple, = 0 for Francis/Pelton). Typical value for Kaplan = 0."@en;
                   rdfs:domain cim:GovHydro4;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "bgv0"@en;
                   rdfs:range cim:PU.
cim:GovHydro4.bgv1 a owl:DatatypeProperty;
                   rdfs:comment "Kaplan blade servo point 1 (Bgv1) (= 0 for simple, = 0 for Francis/Pelton). Typical value for Kaplan = 0."@en;
                   rdfs:domain cim:GovHydro4;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "bgv1"@en;
                   rdfs:range cim:PU.
cim:GovHydro4.bgv2 a owl:DatatypeProperty;
                   rdfs:comment "Kaplan blade servo point 2 (Bgv2) (= 0 for simple, = 0 for Francis/Pelton). Typical value for Kaplan = 0,1."@en;
                   rdfs:domain cim:GovHydro4;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "bgv2"@en;
                   rdfs:range cim:PU.
cim:GovHydro4.bgv3 a owl:DatatypeProperty;
                   rdfs:comment "Kaplan blade servo point 3 (Bgv3) (= 0 for simple, = 0 for Francis/Pelton). Typical value for Kaplan = 0,667."@en;
                   rdfs:domain cim:GovHydro4;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "bgv3"@en;
                   rdfs:range cim:PU.
cim:GovHydro4.bgv4 a owl:DatatypeProperty;
                   rdfs:comment "Kaplan blade servo point 4 (Bgv4) (= 0 for simple, = 0 for Francis/Pelton). Typical value for Kaplan = 0,9."@en;
                   rdfs:domain cim:GovHydro4;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "bgv4"@en;
                   rdfs:range cim:PU.
cim:GovHydro4.bgv5 a owl:DatatypeProperty;
                   rdfs:comment "Kaplan blade servo point 5 (Bgv5) (= 0 for simple, = 0 for Francis/Pelton). Typical value for Kaplan = 1."@en;
                   rdfs:domain cim:GovHydro4;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "bgv5"@en;
                   rdfs:range cim:PU.
cim:GovHydro4.bmax a owl:DatatypeProperty;
                   rdfs:comment "Maximum blade adjustment factor (Bmax) (= 0 for simple, = 0 for Francis/Pelton). Typical value for Kaplan = 1,1276."@en;
                   rdfs:domain cim:GovHydro4;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "bmax"@en;
                   rdfs:range xsd:float.
cim:GovHydro4.db1 a owl:DatatypeProperty;
                  rdfs:comment "Intentional deadband width (db1). Unit = Hz. Typical value = 0."@en;
                  rdfs:domain cim:GovHydro4;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "db1"@en;
                  rdfs:range cim:Frequency.
cim:GovHydro4.db2 a owl:DatatypeProperty;
                  rdfs:comment "Unintentional dead-band (db2). Unit = MW. Typical value = 0."@en;
                  rdfs:domain cim:GovHydro4;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "db2"@en;
                  rdfs:range cim:ActivePower.
cim:GovHydro4.dturb a owl:DatatypeProperty;
                    rdfs:comment "Turbine damping factor (Dturb). Unit = delta P (PU of MWbase) / delta speed (PU). Typical value for simple = 0,5, Francis/Pelton = 1,1, Kaplan = 1,1."@en;
                    rdfs:domain cim:GovHydro4;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "dturb"@en;
                    rdfs:range cim:PU.
cim:GovHydro4.eps a owl:DatatypeProperty;
                  rdfs:comment "Intentional db hysteresis (eps). Unit = Hz. Typical value = 0."@en;
                  rdfs:domain cim:GovHydro4;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "eps"@en;
                  rdfs:range cim:Frequency.
cim:GovHydro4.gmax a owl:DatatypeProperty;
                   rdfs:comment "Maximum gate opening, PU of MWbase (Gmax) (greater than GovHydro4.gmin). Typical value = 1."@en;
                   rdfs:domain cim:GovHydro4;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "gmax"@en;
                   rdfs:range cim:PU.
cim:GovHydro4.gmin a owl:DatatypeProperty;
                   rdfs:comment "Minimum gate opening, PU of MWbase (Gmin) (less than GovHydro4.gmax). Typical value = 0."@en;
                   rdfs:domain cim:GovHydro4;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "gmin"@en;
                   rdfs:range cim:PU.
cim:GovHydro4.gv0 a owl:DatatypeProperty;
                  rdfs:comment "Nonlinear gain point 0, PU gv (Gv0) (equals 0 for simple). Typical for Francis/Pelton equals 0,1, Kaplan equals 0,1."@en;
                  rdfs:domain cim:GovHydro4;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "gv0"@en;
                  rdfs:range cim:PU.
cim:GovHydro4.gv1 a owl:DatatypeProperty;
                  rdfs:comment "Nonlinear gain point 1, PU gv (Gv1) (equals 0 for simple, greater than GovHydro4.gv0 for Francis/Pelton and Kaplan). Typical value for Francis/Pelton equals 0,4, Kaplan equals 0,4."@en;
                  rdfs:domain cim:GovHydro4;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "gv1"@en;
                  rdfs:range cim:PU.
cim:GovHydro4.gv2 a owl:DatatypeProperty;
                  rdfs:comment "Nonlinear gain point 2, PU gv (Gv2) (equals 0 for simple, greater than GovHydro4.gv1 for Francis/Pelton and Kaplan). Typical value for Francis/Pelton equals 0,5, Kaplan equals 0,5."@en;
                  rdfs:domain cim:GovHydro4;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "gv2"@en;
                  rdfs:range cim:PU.
cim:GovHydro4.gv3 a owl:DatatypeProperty;
                  rdfs:comment "Nonlinear gain point 3, PU gv (Gv3) (equals 0 for simple, greater than GovHydro4.gv2 for Francis/Pelton and Kaplan). Typical value for Francis/Pelton equals 0,7, Kaplan equals 0,7."@en;
                  rdfs:domain cim:GovHydro4;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "gv3"@en;
                  rdfs:range cim:PU.
cim:GovHydro4.gv4 a owl:DatatypeProperty;
                  rdfs:comment "Nonlinear gain point 4, PU gv (Gv4) (equals 0 for simple, greater than GovHydro4.gv3 for Francis/Pelton and Kaplan). Typical value for Francis/Pelton equals 0,8, Kaplan equals 0,8."@en;
                  rdfs:domain cim:GovHydro4;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "gv4"@en;
                  rdfs:range cim:PU.
cim:GovHydro4.gv5 a owl:DatatypeProperty;
                  rdfs:comment "Nonlinear gain point 5, PU gv (Gv5) (equals 0 for simple, less than 1 and greater than GovHydro4.gv4 for Francis/Pelton and Kaplan). Typical value for Francis/Pelton equals 0,9, Kaplan equals 0,9."@en;
                  rdfs:domain cim:GovHydro4;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "gv5"@en;
                  rdfs:range cim:PU.
cim:GovHydro4.hdam a owl:DatatypeProperty;
                   rdfs:comment "Head available at dam (hdam). Typical value = 1."@en;
                   rdfs:domain cim:GovHydro4;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "hdam"@en;
                   rdfs:range cim:PU.
cim:GovHydro4.model a owl:ObjectProperty;
                    rdfs:comment "The kind of model being represented (simple, Francis/Pelton or Kaplan)."@en;
                    rdfs:domain cim:GovHydro4;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "model"@en;
