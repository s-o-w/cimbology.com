                   rdfs:comment "Excitation control system stabilizer gains (KF) (>= 0). Typical value = 0,03."@en;
                   rdfs:domain cim:ExcIEEEAC2A;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "kf"@en;
                   rdfs:range cim:PU.
cim:ExcIEEEAC2A.kh a owl:DatatypeProperty;
                   rdfs:comment "Exciter field current feedback gain (KH) (>= 0). Typical value = 1."@en;
                   rdfs:domain cim:ExcIEEEAC2A;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "kh"@en;
                   rdfs:range cim:PU.
cim:ExcIEEEAC2A.seve1 a owl:DatatypeProperty;
                      rdfs:comment "Exciter saturation function value at the corresponding exciter voltage, VE1, back of commutating reactance (SE[VE1]) (>= 0). Typical value = 0,037."@en;
                      rdfs:domain cim:ExcIEEEAC2A;
