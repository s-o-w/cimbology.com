                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "ModelFrameType"@en;
                                 rdfs:range cim:ModelFrameType.
cim:FrancisGovernorControlKind a owl:Class;
