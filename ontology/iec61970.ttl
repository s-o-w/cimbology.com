cim:ExcIEEEAC3A a owl:Class;
                rdfs:comment "IEEE 421.5-2005 type AC3A model. The model represents the field-controlled alternator-rectifier excitation systems designated type AC3A. These excitation systems include an alternator main exciter with non-controlled rectifiers. The exciter employs self-excitation, and the voltage regulator power is derived from the exciter output voltage. Therefore, this system has an additional nonlinearity, simulated by the use of a multiplier whose inputs are the voltage regulator command signal, Va, and the exciter output voltage, Efd, times KR. This model is applicable to excitation systems employing static voltage regulators. Reference: IEEE 421.5-2005, 6.3."@en;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "ExcIEEEAC3A"@en;
                rdfs:subClassOf cim:ExcitationSystemDynamics;
                cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.ExcitationSystemDynamics";
                cimdoc:packageTier "Normative".
cim:ExcIEEEAC3A.efdn a owl:DatatypeProperty;
                     rdfs:comment "Value of Efd at which feedback gain changes (EFDN) (> 0). Typical value = 2,36."@en;
                     rdfs:domain cim:ExcIEEEAC3A;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                     rdfs:label "efdn"@en;
                     rdfs:range cim:PU.
cim:ExcIEEEAC3A.ka a owl:DatatypeProperty;
                   rdfs:comment "Voltage regulator gain (KA) (> 0). Typical value = 45, 62."@en;
                   rdfs:domain cim:ExcIEEEAC3A;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "ka"@en;
                   rdfs:range cim:PU.
