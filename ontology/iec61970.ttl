                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "actuatorMaximum"@en;
                                  rdfs:range xsd:float.
cim:RemoteControl.actuatorMinimum a owl:DatatypeProperty;
