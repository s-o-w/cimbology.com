                    cimdoc:cimPackage "IEC61970.Base.Wires";
                    cimdoc:packageTier "Normative".
cim:RotatingMachine.HydroPump a owl:ObjectProperty;
                              rdfs:comment "The synchronous machine drives the turbine which moves the water from a low elevation to a higher elevation. The direction of machine rotation for pumping may or may not be the same as for generating."@en;
                              rdfs:domain cim:RotatingMachine;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "HydroPump"@en;
                              rdfs:range cim:HydroPump.
cim:RotatingMachine.p a owl:DatatypeProperty;
                      rdfs:comment "Active power injection. Load sign convention is used, i.e. positive sign means flow out from a node. Starting value for a steady state solution."@en;
                      rdfs:domain cim:RotatingMachine;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "p"@en;
                      rdfs:range cim:ActivePower.
cim:RotatingMachine.q a owl:DatatypeProperty;
                      rdfs:comment "Reactive power injection. Load sign convention is used, i.e. positive sign means flow out from a node. Starting value for a steady state solution."@en;
                      rdfs:domain cim:RotatingMachine;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "q"@en;
                      rdfs:range cim:ReactivePower.
cim:RotatingMachine.ratedPowerFactor a owl:DatatypeProperty;
                                     rdfs:comment "Power factor (nameplate data). It is primarily used for short circuit data exchange according to IEC 60909. The attribute cannot be a negative value."@en;
                                     rdfs:domain cim:RotatingMachine;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                     rdfs:label "ratedPowerFactor"@en;
                                     rdfs:range xsd:float.
cim:RotatingMachine.ratedS a owl:DatatypeProperty;
                           rdfs:comment "Nameplate apparent power rating for the unit. The attribute shall have a positive value."@en;
                           rdfs:domain cim:RotatingMachine;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "ratedS"@en;
                           rdfs:range cim:ApparentPower.
cim:RotatingMachine.ratedU a owl:DatatypeProperty;
                           rdfs:comment "Rated voltage (nameplate data, Ur in IEC 60909-0). It is primarily used for short circuit data exchange according to IEC 60909. The attribute shall be a positive value."@en;
                           rdfs:domain cim:RotatingMachine;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "ratedU"@en;
                           rdfs:range cim:Voltage.
cim:RotatingMachineDynamics a owl:Class;
                            rdfs:comment "Abstract parent class for all synchronous and asynchronous machine standard models."@en;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "RotatingMachineDynamics"@en;
                            rdfs:subClassOf cim:DynamicsFunctionBlock;
                            cimdoc:cimPackage "IEC61970.Dynamics.StandardModels";
                            cimdoc:packageTier "Normative".
cim:RotatingMachineDynamics.damping a owl:DatatypeProperty;
                                    rdfs:comment "Damping torque coefficient (D) (>= 0). A proportionality constant that, when multiplied by the angular velocity of the rotor poles with respect to the magnetic field (frequency), results in the damping torque. This value is often zero when the sources of damping torques (generator damper windings, load damping effects, etc.) are modelled in detail. Typical value = 0."@en;
                                    rdfs:domain cim:RotatingMachineDynamics;
                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                    rdfs:label "damping"@en;
                                    rdfs:range xsd:float.
cim:RotatingMachineDynamics.inertia a owl:DatatypeProperty;
                                    rdfs:comment "Inertia constant of generator or motor and mechanical load (H) (> 0). This is the specification for the stored energy in the rotating mass when operating at rated speed. For a generator, this includes the generator plus all other elements (turbine, exciter) on the same shaft and has units of MW x s. For a motor, it includes the motor plus its mechanical load. Conventional units are PU on the generator MVA base, usually expressed as MW x s / MVA or just s. This value is used in the accelerating power reference frame for operator training simulator solutions. Typical value = 3."@en;
                                    rdfs:domain cim:RotatingMachineDynamics;
                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                    rdfs:label "inertia"@en;
                                    rdfs:range cim:Seconds.
cim:RotatingMachineDynamics.saturationFactor a owl:DatatypeProperty;
                                             rdfs:comment "Saturation factor at rated terminal voltage (S1) (>= 0). Not used by simplified model. Defined by defined by S(E1) in the SynchronousMachineSaturationParameters diagram. Typical value = 0,02."@en;
                                             rdfs:domain cim:RotatingMachineDynamics;
                                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                             rdfs:label "saturationFactor"@en;
                                             rdfs:range xsd:float.
cim:RotatingMachineDynamics.saturationFactor120 a owl:DatatypeProperty;
                                                rdfs:comment "Saturation factor at 120% of rated terminal voltage (S12) (>= RotatingMachineDynamics.saturationFactor). Not used by the simplified model, defined by S(E2) in the SynchronousMachineSaturationParameters diagram. Typical value = 0,12."@en;
                                                rdfs:domain cim:RotatingMachineDynamics;
                                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                rdfs:label "saturationFactor120"@en;
                                                rdfs:range xsd:float.
cim:RotatingMachineDynamics.statorLeakageReactance a owl:DatatypeProperty;
                                                   rdfs:comment "Stator leakage reactance (Xl) (>= 0). Typical value = 0,15."@en;
                                                   rdfs:domain cim:RotatingMachineDynamics;
                                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                   rdfs:label "statorLeakageReactance"@en;
                                                   rdfs:range cim:PU.
cim:RotatingMachineDynamics.statorResistance a owl:DatatypeProperty;
                                             rdfs:comment "Stator (armature) resistance (Rs) (>= 0). Typical value = 0,005."@en;
                                             rdfs:domain cim:RotatingMachineDynamics;
                                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                             rdfs:label "statorResistance"@en;
                                             rdfs:range cim:PU.
cim:RotationSpeed a rdfs:Datatype;
                  rdfs:comment "Number of revolutions per second."@en;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "RotationSpeed"@en;
                  owl:equivalentClass xsd:float;
                  cimdoc:cimPackage "IEC61970.Base.Domain";
                  cimdoc:packageTier "Normative";
                  cimdoc:unitMultiplier cim:UnitMultiplier.none;
                  cimdoc:unitSymbol cim:UnitSymbol.Hz.
cim:RotorKind a owl:Class;
              rdfs:comment "Type of rotor on physical machine."@en;
              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
              rdfs:label "RotorKind"@en;
              owl:equivalentClass [a owl:Class ; 
                                   owl:oneOf (cim:RotorKind.roundRotor
                                              cim:RotorKind.salientPole)];
              cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.SynchronousMachineDynamics";
              cimdoc:packageTier "Normative".
cim:RotorKind.roundRotor a owl:NamedIndividual,
                           cim:RotorKind;
                         rdfs:comment "Round rotor type of synchronous machine."@en;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                         rdfs:label "roundRotor"@en;
                         cimdoc:enumCode 0 .
cim:RotorKind.salientPole a owl:NamedIndividual,
                            cim:RotorKind;
                          rdfs:comment "Salient pole type of synchronous machine."@en;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                          rdfs:label "salientPole"@en;
                          cimdoc:enumCode 1 .
cim:SVCControlMode a owl:Class;
                   rdfs:comment "Static VAr Compensator control mode."@en;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "SVCControlMode"@en;
                   owl:equivalentClass [a owl:Class ; 
                                        owl:oneOf (cim:SVCControlMode.reactivePower
                                                   cim:SVCControlMode.voltage)];
                   cimdoc:cimPackage "IEC61970.Base.Wires";
                   cimdoc:packageTier "Normative".
cim:SVCControlMode.reactivePower a owl:NamedIndividual,
                                   cim:SVCControlMode;
                                 rdfs:comment "Reactive power control."@en;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "reactivePower"@en;
                                 cimdoc:enumCode 0 .
cim:SVCControlMode.voltage a owl:NamedIndividual,
                             cim:SVCControlMode;
                           rdfs:comment "Voltage control."@en;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "voltage"@en;
                           cimdoc:enumCode 1 .
cim:SVCUserDefined a owl:Class;
                   rdfs:comment "Static var compensator (SVC) function block whose dynamic behaviour is described by a user-defined model."@en;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "SVCUserDefined"@en;
                   rdfs:subClassOf cim:StaticVarCompensatorDynamics;
                   cimdoc:cimPackage "IEC61970.Dynamics.UserDefinedModels";
                   cimdoc:packageTier "Normative".
cim:SVCUserDefined.ProprietaryParameterDynamics a owl:ObjectProperty;
                                                rdfs:comment "Parameter of this proprietary user-defined model."@en;
                                                rdfs:domain cim:SVCUserDefined;
                                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                rdfs:label "ProprietaryParameterDynamics"@en;
                                                rdfs:range cim:ProprietaryParameterDynamics.
cim:SVCUserDefined.proprietary a owl:DatatypeProperty;
                               rdfs:comment "Behaviour is based on a proprietary model as opposed to a detailed model. true = user-defined model is proprietary with behaviour mutually understood by sending and receiving applications and parameters passed as general attributes false = user-defined model is explicitly defined in terms of control blocks and their input and output signals."@en;
                               rdfs:domain cim:SVCUserDefined;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "proprietary"@en;
                               rdfs:range xsd:boolean.
cim:ScheduledActivePowerLimitValue a owl:Class;
                                   rdfs:comment "A scheduled value for active power limit at a specific time."@en;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                   rdfs:label "ScheduledActivePowerLimitValue"@en;
                                   rdfs:subClassOf cim:ScheduledLimitValue;
                                   cimdoc:cimPackage "IEC61970.InfIEC61970.InfOperationalLimits";
                                   cimdoc:packageTier "Informative".
cim:ScheduledActivePowerLimitValue.value a owl:DatatypeProperty;
                                         rdfs:comment "The active power limit value for the scheduled time."@en;
                                         rdfs:domain cim:ScheduledActivePowerLimitValue;
                                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                         rdfs:label "value"@en;
                                         rdfs:range cim:ActivePower.
cim:ScheduledApparentPowerLimitValue a owl:Class;
                                     rdfs:comment "A time scheduled value for apparent power limit."@en;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                     rdfs:label "ScheduledApparentPowerLimitValue"@en;
                                     rdfs:subClassOf cim:ScheduledLimitValue;
                                     cimdoc:cimPackage "IEC61970.InfIEC61970.InfOperationalLimits";
                                     cimdoc:packageTier "Informative".
cim:ScheduledApparentPowerLimitValue.value a owl:DatatypeProperty;
                                           rdfs:comment "The apparent power limit value for the scheduled time."@en;
                                           rdfs:domain cim:ScheduledApparentPowerLimitValue;
                                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                           rdfs:label "value"@en;
                                           rdfs:range cim:ApparentPower.
cim:ScheduledCurrentLimitValue a owl:Class;
                               rdfs:comment "A current limit that is scheduled."@en;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "ScheduledCurrentLimitValue"@en;
                               rdfs:subClassOf cim:ScheduledLimitValue;
                               cimdoc:cimPackage "IEC61970.InfIEC61970.InfOperationalLimits";
                               cimdoc:packageTier "Informative".
cim:ScheduledCurrentLimitValue.value a owl:DatatypeProperty;
                                     rdfs:comment "The current flow limit value applicable at the scheduled time."@en;
                                     rdfs:domain cim:ScheduledCurrentLimitValue;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                     rdfs:label "value"@en;
                                     rdfs:range cim:CurrentFlow.
cim:ScheduledLimitDependency a owl:Class;
                             rdfs:comment "A dependency that schedules limit values over time."@en;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "ScheduledLimitDependency"@en;
                             rdfs:subClassOf cim:LimitDependency;
                             cimdoc:cimPackage "IEC61970.InfIEC61970.InfOperationalLimits";
                             cimdoc:packageTier "Informative".
cim:ScheduledLimitDependency.ScheduledLimitValues a owl:ObjectProperty;
                                                  rdfs:comment "The scheduled limit values for this limit dependency."@en;
                                                  rdfs:domain cim:ScheduledLimitDependency;
                                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                  rdfs:label "ScheduledLimitValues"@en;
                                                  rdfs:range cim:ScheduledLimitValue.
cim:ScheduledLimitValue a owl:Class;
                        rdfs:comment "A limit that is applicable during a scheduled time period."@en;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                        rdfs:label "ScheduledLimitValue"@en;
                        rdfs:subClassOf cim:IdentifiedObject;
                        cimdoc:cimPackage "IEC61970.InfIEC61970.InfOperationalLimits";
                        cimdoc:packageTier "Informative".
cim:ScheduledLimitValue.Season a owl:ObjectProperty;
                               rdfs:comment "The season for which the scheduled limits applies. If not specified, then applicable to any season."@en;
                               rdfs:domain cim:ScheduledLimitValue;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "Season"@en;
                               rdfs:range cim:Season.
cim:ScheduledVoltageLimitValue a owl:Class;
                               rdfs:comment "A voltage limit value for a scheduled time."@en;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "ScheduledVoltageLimitValue"@en;
                               rdfs:subClassOf cim:ScheduledLimitValue;
                               cimdoc:cimPackage "IEC61970.InfIEC61970.InfOperationalLimits";
                               cimdoc:packageTier "Informative".
cim:ScheduledVoltageLimitValue.value a owl:DatatypeProperty;
                                     rdfs:comment "The voltage limit value for the scheduled time."@en;
                                     rdfs:domain cim:ScheduledVoltageLimitValue;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                     rdfs:label "value"@en;
                                     rdfs:range cim:Voltage.
cim:Season a owl:Class;
           rdfs:comment "A specified time period of the year."@en;
           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
           rdfs:label "Season"@en;
           rdfs:subClassOf cim:IdentifiedObject;
           cimdoc:cimPackage "IEC61970.Base.LoadModel";
           cimdoc:packageTier "Normative".
cim:Season.SeasonDayTypeSchedules a owl:ObjectProperty;
                                  rdfs:comment "Schedules that use this Season."@en;
                                  rdfs:domain cim:Season;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "SeasonDayTypeSchedules"@en;
                                  rdfs:range cim:SeasonDayTypeSchedule.
cim:Season.endDate a owl:DatatypeProperty;
                   rdfs:comment "Date season ends."@en;
                   rdfs:domain cim:Season;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "endDate"@en;
                   rdfs:range xsd:gMonthDay.
cim:Season.startDate a owl:DatatypeProperty;
                     rdfs:comment "Date season starts."@en;
                     rdfs:domain cim:Season;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                     rdfs:label "startDate"@en;
                     rdfs:range xsd:gMonthDay.
cim:SeasonDayTypeSchedule a owl:Class;
                          rdfs:comment "A time schedule covering a 24 hour period, with curve data for a specific type of season and day."@en;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                          rdfs:label "SeasonDayTypeSchedule"@en;
                          rdfs:subClassOf cim:RegularIntervalSchedule;
                          cimdoc:cimPackage "IEC61970.Base.LoadModel";
                          cimdoc:packageTier "Normative".
cim:Seconds a rdfs:Datatype;
            rdfs:comment "Time, in seconds."@en;
            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
            rdfs:label "Seconds"@en;
            owl:equivalentClass xsd:float;
            cimdoc:cimPackage "IEC61970.Base.Domain";
            cimdoc:packageTier "Normative";
            cimdoc:unitMultiplier cim:UnitMultiplier.none;
            cimdoc:unitSymbol cim:UnitSymbol.s.
cim:Sectionaliser a owl:Class;
                  rdfs:comment "Automatic switch that will lock open to isolate a faulted section. It may, or may not, have load breaking capability. Its primary purpose is to provide fault sectionalising at locations where the fault current is either too high, or too low, for proper coordination of fuses."@en;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "Sectionaliser"@en;
                  rdfs:subClassOf cim:Switch;
                  cimdoc:cimPackage "IEC61970.Base.Wires";
                  cimdoc:packageTier "Normative".
cim:Sensor a owl:Class;
           rdfs:comment "This class describe devices that transform a measured quantity into signals that can be presented at displays, used in control or be recorded."@en;
           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
           rdfs:label "Sensor"@en;
           rdfs:subClassOf cim:AuxiliaryEquipment;
           cimdoc:cimPackage "IEC61970.Base.AuxiliaryEquipment";
           cimdoc:packageTier "Normative".
cim:SeriesCompensator a owl:Class;
                      rdfs:comment "A Series Compensator is a series capacitor or reactor or an AC transmission line without charging susceptance. It is a two terminal device."@en;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "SeriesCompensator"@en;
                      rdfs:subClassOf cim:ConductingEquipment;
                      cimdoc:cimPackage "IEC61970.Base.Wires";
                      cimdoc:packageTier "Normative".
cim:SeriesCompensator.r a owl:DatatypeProperty;
                        rdfs:comment "Positive sequence resistance."@en;
                        rdfs:domain cim:SeriesCompensator;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                        rdfs:label "r"@en;
                        rdfs:range cim:Resistance.
cim:SeriesCompensator.r0 a owl:DatatypeProperty;
                         rdfs:comment "Zero sequence resistance."@en;
                         rdfs:domain cim:SeriesCompensator;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                         rdfs:label "r0"@en;
                         rdfs:range cim:Resistance.
cim:SeriesCompensator.varistorPresent a owl:DatatypeProperty;
                                      rdfs:comment "Describe if a metal oxide varistor (mov) for over voltage protection is configured in parallel with the series compensator. It is used for short circuit calculations."@en;
                                      rdfs:domain cim:SeriesCompensator;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                      rdfs:label "varistorPresent"@en;
                                      rdfs:range xsd:boolean.
cim:SeriesCompensator.varistorRatedCurrent a owl:DatatypeProperty;
                                           rdfs:comment "The maximum current the varistor is designed to handle at specified duration. It is used for short circuit calculations and exchanged only if SeriesCompensator.varistorPresent is true. The attribute shall be a positive value."@en;
                                           rdfs:domain cim:SeriesCompensator;
                                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                           rdfs:label "varistorRatedCurrent"@en;
                                           rdfs:range cim:CurrentFlow.
cim:SeriesCompensator.varistorVoltageThreshold a owl:DatatypeProperty;
                                               rdfs:comment "The dc voltage at which the varistor starts conducting. It is used for short circuit calculations and exchanged only if SeriesCompensator.varistorPresent is true."@en;
                                               rdfs:domain cim:SeriesCompensator;
                                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                               rdfs:label "varistorVoltageThreshold"@en;
                                               rdfs:range cim:Voltage.
cim:SeriesCompensator.x a owl:DatatypeProperty;
                        rdfs:comment "Positive sequence reactance."@en;
                        rdfs:domain cim:SeriesCompensator;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                        rdfs:label "x"@en;
                        rdfs:range cim:Reactance.
cim:SeriesCompensator.x0 a owl:DatatypeProperty;
                         rdfs:comment "Zero sequence reactance."@en;
                         rdfs:domain cim:SeriesCompensator;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                         rdfs:label "x0"@en;
                         rdfs:range cim:Reactance.
cim:SeriesEquipmentDependentLimit a owl:Class;
                                  rdfs:comment "Limit based on most restrictive series equipment limit. A specification of equipment that determines the calculated operational limit values based upon other equipment and their ratings."@en;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "SeriesEquipmentDependentLimit"@en;
                                  rdfs:subClassOf cim:LimitDependency;
                                  cimdoc:cimPackage "IEC61970.InfIEC61970.InfOperationalLimits";
                                  cimdoc:packageTier "Informative".
cim:SeriesEquipmentDependentLimit.EquipmentLimitSeriesComponent a owl:ObjectProperty;
                                                                rdfs:comment "Equipment linkages that participate in the limit calculation."@en;
                                                                rdfs:domain cim:SeriesEquipmentDependentLimit;
                                                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                                rdfs:label "EquipmentLimitSeriesComponent"@en;
                                                                rdfs:range cim:EquipmentLimitSeriesComponent.
cim:SetPoint a owl:Class;
             rdfs:comment "An analog control that issues a set point value."@en;
             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
             rdfs:label "SetPoint"@en;
             rdfs:subClassOf cim:AnalogControl;
             cimdoc:cimPackage "IEC61970.Base.Meas";
             cimdoc:packageTier "Normative".
cim:SetPoint.normalValue a owl:DatatypeProperty;
                         rdfs:comment "Normal value for Control.value e.g. used for percentage scaling."@en;
                         rdfs:domain cim:SetPoint;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                         rdfs:label "normalValue"@en;
                         rdfs:range xsd:float.
cim:SetPoint.value a owl:DatatypeProperty;
                   rdfs:comment "The value representing the actuator output."@en;
                   rdfs:domain cim:SetPoint;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "value"@en;
                   rdfs:range xsd:float.
cim:ShortCircuitRotorKind a owl:Class;
                          rdfs:comment "Type of rotor, used by short circuit applications."@en;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                          rdfs:label "ShortCircuitRotorKind"@en;
                          owl:equivalentClass [a owl:Class ; 
                                               owl:oneOf (cim:ShortCircuitRotorKind.salientPole1
                                                          cim:ShortCircuitRotorKind.salientPole2
                                                          cim:ShortCircuitRotorKind.turboSeries1
                                                          cim:ShortCircuitRotorKind.turboSeries2)];
                          cimdoc:cimPackage "IEC61970.Base.Wires";
                          cimdoc:packageTier "Normative".
cim:ShortCircuitRotorKind.salientPole1 a owl:NamedIndividual,
                                         cim:ShortCircuitRotorKind;
                                       rdfs:comment "Salient pole 1 in IEC 60909."@en;
                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                       rdfs:label "salientPole1"@en;
                                       cimdoc:enumCode 0 .
cim:ShortCircuitRotorKind.salientPole2 a owl:NamedIndividual,
                                         cim:ShortCircuitRotorKind;
                                       rdfs:comment "Salient pole 2 in IEC 60909."@en;
                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                       rdfs:label "salientPole2"@en;
                                       cimdoc:enumCode 1 .
cim:ShortCircuitRotorKind.turboSeries1 a owl:NamedIndividual,
                                         cim:ShortCircuitRotorKind;
                                       rdfs:comment "Turbo Series 1 in IEC 60909."@en;
                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                       rdfs:label "turboSeries1"@en;
                                       cimdoc:enumCode 2 .
cim:ShortCircuitRotorKind.turboSeries2 a owl:NamedIndividual,
                                         cim:ShortCircuitRotorKind;
                                       rdfs:comment "Turbo series 2 in IEC 60909."@en;
                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                       rdfs:label "turboSeries2"@en;
                                       cimdoc:enumCode 3 .
cim:ShuntCompensator a owl:Class;
                     rdfs:comment "A shunt capacitor or reactor or switchable bank of shunt capacitors or reactors. A section of a shunt compensator is an individual capacitor or reactor. A negative value for bPerSection indicates that the compensator is a reactor. ShuntCompensator is a single terminal device. Ground is implied."@en;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                     rdfs:label "ShuntCompensator"@en;
                     rdfs:subClassOf cim:RegulatingCondEq;
                     cimdoc:cimPackage "IEC61970.Base.Wires";
                     cimdoc:packageTier "Normative".
cim:ShuntCompensator.ShuntCompensatorAction a owl:ObjectProperty;
                                            rdfs:comment "The shunt compensator action that is performed on the shunt compensator"@en;
                                            rdfs:domain cim:ShuntCompensator;
                                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                            rdfs:label "ShuntCompensatorAction"@en;
                                            rdfs:range cim:ShuntCompensatorAction.
cim:ShuntCompensator.ShuntCompensatorPhase a owl:ObjectProperty;
                                           rdfs:comment "The individual phases models for the shunt compensator."@en;
                                           rdfs:domain cim:ShuntCompensator;
                                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                           rdfs:label "ShuntCompensatorPhase"@en;
                                           rdfs:range cim:ShuntCompensatorPhase.
cim:ShuntCompensator.aVRDelay a owl:DatatypeProperty;
                              rdfs:comment "An automatic voltage regulation delay (AVRDelay) which is the time delay from a change in voltage to when the capacitor is allowed to change state. This filters out temporary changes in voltage."@en;
                              rdfs:domain cim:ShuntCompensator;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "aVRDelay"@en;
                              rdfs:range cim:Seconds.
cim:ShuntCompensator.grounded a owl:DatatypeProperty;
                              rdfs:comment "Used for Yn and Zn connections. True if the neutral is solidly grounded."@en;
                              rdfs:domain cim:ShuntCompensator;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "grounded"@en;
                              rdfs:range xsd:boolean.
cim:ShuntCompensator.maximumSections a owl:DatatypeProperty;
                                     rdfs:comment "The maximum number of sections that may be switched in."@en;
                                     rdfs:domain cim:ShuntCompensator;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                     rdfs:label "maximumSections"@en;
                                     rdfs:range xsd:integer.
cim:ShuntCompensator.nomU a owl:DatatypeProperty;
                          rdfs:comment "The voltage at which the nominal reactive power may be calculated. This should normally be within 10% of the voltage at which the capacitor is connected to the network."@en;
                          rdfs:domain cim:ShuntCompensator;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                          rdfs:label "nomU"@en;
                          rdfs:range cim:Voltage.
cim:ShuntCompensator.normalSections a owl:DatatypeProperty;
                                    rdfs:comment "The normal number of sections switched in. The value shall be between zero and ShuntCompensator.maximumSections."@en;
                                    rdfs:domain cim:ShuntCompensator;
                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                    rdfs:label "normalSections"@en;
                                    rdfs:range xsd:integer.
cim:ShuntCompensator.phaseConnection a owl:ObjectProperty;
                                     rdfs:comment "The type of phase connection, such as wye or delta."@en;
                                     rdfs:domain cim:ShuntCompensator;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                     rdfs:label "phaseConnection"@en;
                                     rdfs:range cim:PhaseShuntConnectionKind.
cim:ShuntCompensator.sections a owl:DatatypeProperty;
                              rdfs:comment "Shunt compensator sections in use. Starting value for steady state solution. The attribute shall be a positive value or zero. Non integer values are allowed to support continuous variables. The reasons for continuous value are to support study cases where no discrete shunt compensators has yet been designed, a solutions where a narrow voltage band force the sections to oscillate or accommodate for a continuous solution as input. For LinearShuntConpensator the value shall be between zero and ShuntCompensator. maximumSections. At value zero the shunt compensator conductance and admittance is zero. Linear interpolation of conductance and admittance between the previous and next integer section is applied in case of non-integer values. For NonlinearShuntCompensator-s shall only be set to one of the NonlinearShuntCompenstorPoint.sectionNumber. There is no interpolation between NonlinearShuntCompenstorPoint-s."@en;
                              rdfs:domain cim:ShuntCompensator;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "sections"@en;
                              rdfs:range xsd:float.
cim:ShuntCompensator.switchOnCount a owl:DatatypeProperty;
                                   rdfs:comment "The switch on count since the capacitor count was last reset or initialized."@en;
                                   rdfs:domain cim:ShuntCompensator;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                   rdfs:label "switchOnCount"@en;
                                   rdfs:range xsd:integer.
cim:ShuntCompensator.switchOnDate a owl:DatatypeProperty;
                                  rdfs:comment "The date and time when the capacitor bank was last switched on."@en;
                                  rdfs:domain cim:ShuntCompensator;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "switchOnDate"@en;
                                  rdfs:range xsd:dateTime.
cim:ShuntCompensator.voltageSensitivity a owl:DatatypeProperty;
                                        rdfs:comment "Voltage sensitivity required for the device to regulate the bus voltage, in voltage/reactive power."@en;
                                        rdfs:domain cim:ShuntCompensator;
                                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                        rdfs:label "voltageSensitivity"@en;
                                        rdfs:range cim:VoltagePerReactivePower.
cim:ShuntCompensatorAction a owl:Class;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>.
cim:ShuntCompensatorPhase a owl:Class;
                          rdfs:comment "Single phase of a multi-phase shunt compensator when its attributes might be different per phase."@en;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                          rdfs:label "ShuntCompensatorPhase"@en;
                          rdfs:subClassOf cim:PowerSystemResource;
                          cimdoc:cimPackage "IEC61970.Base.Wires";
                          cimdoc:packageTier "Normative".
cim:ShuntCompensatorPhase.maximumSections a owl:DatatypeProperty;
                                          rdfs:comment "The maximum number of sections that may be switched in for this phase."@en;
                                          rdfs:domain cim:ShuntCompensatorPhase;
                                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                          rdfs:label "maximumSections"@en;
                                          rdfs:range xsd:integer.
cim:ShuntCompensatorPhase.normalSections a owl:DatatypeProperty;
                                         rdfs:comment "For the capacitor phase, the normal number of sections switched in. The value shall be between zero and ShuntCompensatorPhase.maximumSections."@en;
                                         rdfs:domain cim:ShuntCompensatorPhase;
                                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                         rdfs:label "normalSections"@en;
                                         rdfs:range xsd:integer.
cim:ShuntCompensatorPhase.phase a owl:ObjectProperty;
                                rdfs:comment "Phase of this shunt compensator component. If the shunt compensator is wye connected, the connection is from the indicated phase to the central ground or neutral point. If the shunt compensator is delta connected, the phase indicates a shunt compensator connected from the indicated phase to the next logical non-neutral phase."@en;
                                rdfs:domain cim:ShuntCompensatorPhase;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "phase"@en;
                                rdfs:range cim:SinglePhaseKind.
cim:ShuntCompensatorPhase.sections a owl:DatatypeProperty;
                                   rdfs:comment "Shunt compensator sections in use. Starting value for steady state solution. The attribute shall be a positive value or zero. Non integer values are allowed to support continuous variables. The reasons for continuous value are to support study cases where no discrete shunt compensators has yet been designed, a solutions where a narrow voltage band force the sections to oscillate or accommodate for a continuous solution as input. For LinearShuntConpensator the value shall be between zero and ShuntCompensatorPhase.maximumSections. At value zero the shunt compensator conductance and admittance is zero. Linear interpolation of conductance and admittance between the previous and next integer section is applied in case of non-integer values. For NonlinearShuntCompensator-s shall only be set to one of the NonlinearShuntCompenstorPhasePoint.sectionNumber. There is no interpolation between NonlinearShuntCompenstorPhasePoint-s."@en;
                                   rdfs:domain cim:ShuntCompensatorPhase;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                   rdfs:label "sections"@en;
                                   rdfs:range xsd:float.
cim:ShutdownCurve a owl:Class;
                  rdfs:comment "Relationship between the rate in gross active power/minute (Y-axis) at which a unit should be shutdown and its present gross MW output (X-axis)."@en;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "ShutdownCurve"@en;
                  rdfs:subClassOf cim:Curve;
                  cimdoc:cimPackage "IEC61970.Base.Generation.Production";
                  cimdoc:packageTier "Normative".
cim:ShutdownCurve.shutdownCost a owl:DatatypeProperty;
                               rdfs:comment "Fixed shutdown cost."@en;
                               rdfs:domain cim:ShutdownCurve;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "shutdownCost"@en;
                               rdfs:range cim:Money.
cim:ShutdownCurve.shutdownDate a owl:DatatypeProperty;
                               rdfs:comment "The date and time of the most recent generating unit shutdown."@en;
                               rdfs:domain cim:ShutdownCurve;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "shutdownDate"@en;
                               rdfs:range xsd:dateTime.
cim:SinglePhaseKind a owl:Class;
                    rdfs:comment "Enumeration of single phase identifiers. Allows designation of single phases for both transmission and distribution equipment, circuits and loads."@en;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "SinglePhaseKind"@en;
                    owl:equivalentClass [a owl:Class ; 
                                         owl:oneOf (cim:SinglePhaseKind.A
                                                    cim:SinglePhaseKind.B
                                                    cim:SinglePhaseKind.C
                                                    cim:SinglePhaseKind.N
                                                    cim:SinglePhaseKind.s1
                                                    cim:SinglePhaseKind.s2)];
                    cimdoc:cimPackage "IEC61970.Base.Wires";
                    cimdoc:packageTier "Normative".
cim:SinglePhaseKind.A a owl:NamedIndividual,
                        cim:SinglePhaseKind;
                      rdfs:comment "Phase A."@en;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "A"@en;
                      cimdoc:enumCode 0 .
cim:SinglePhaseKind.B a owl:NamedIndividual,
                        cim:SinglePhaseKind;
                      rdfs:comment "Phase B."@en;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "B"@en;
                      cimdoc:enumCode 1 .
cim:SinglePhaseKind.C a owl:NamedIndividual,
                        cim:SinglePhaseKind;
                      rdfs:comment "Phase C."@en;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "C"@en;
                      cimdoc:enumCode 2 .
cim:SinglePhaseKind.N a owl:NamedIndividual,
                        cim:SinglePhaseKind;
                      rdfs:comment "Neutral."@en;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "N"@en;
                      cimdoc:enumCode 3 .
cim:SinglePhaseKind.s1 a owl:NamedIndividual,
                         cim:SinglePhaseKind;
                       rdfs:comment "Secondary phase 1."@en;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "s1"@en;
                       cimdoc:enumCode 4 .
cim:SinglePhaseKind.s2 a owl:NamedIndividual,
                         cim:SinglePhaseKind;
                       rdfs:comment "Secondary phase 2."@en;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "s2"@en;
                       cimdoc:enumCode 5 .
cim:SolarGeneratingUnit a owl:Class;
                        rdfs:comment "A solar thermal generating unit, connected to the grid by means of a rotating machine. This class does not represent photovoltaic (PV) generation."@en;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                        rdfs:label "SolarGeneratingUnit"@en;
                        rdfs:subClassOf cim:GeneratingUnit;
                        cimdoc:cimPackage "IEC61970.Base.Generation.Production";
                        cimdoc:packageTier "Normative".
cim:Source a owl:Class;
           rdfs:comment "Source gives information related to the origin of a value."@en;
           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
           rdfs:label "Source"@en;
           owl:equivalentClass [a owl:Class ; 
                                owl:oneOf (cim:Source.DEFAULTED
                                           cim:Source.PROCESS
                                           cim:Source.SUBSTITUTED)];
           cimdoc:cimPackage "IEC61970.Base.SCADA";
           cimdoc:packageTier "Normative".
cim:Source.DEFAULTED a owl:NamedIndividual,
                       cim:Source;
                     rdfs:comment "The value contains a default value."@en;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                     rdfs:label "DEFAULTED"@en;
                     cimdoc:enumCode 1 .
cim:Source.PROCESS a owl:NamedIndividual,
                     cim:Source;
                   rdfs:comment "The value is provided by input from the process I/O or being calculated from some function."@en;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "PROCESS"@en;
                   cimdoc:enumCode 0 .
cim:Source.SUBSTITUTED a owl:NamedIndividual,
                         cim:Source;
                       rdfs:comment "The value is provided by input of an operator or by an automatic source."@en;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "SUBSTITUTED"@en;
                       cimdoc:enumCode 2 .
cim:Speed a rdfs:Datatype;
          rdfs:comment "Distance per unit of time."@en;
          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
          rdfs:label "Speed"@en;
          owl:equivalentClass xsd:float;
          cimdoc:cimPackage "IEC61970.Base.Domain";
          cimdoc:packageTier "Normative";
          cimdoc:unitMultiplier cim:UnitMultiplier.none;
          cimdoc:unitSymbol cim:UnitSymbol.mPers.
cim:Stage a owl:Class;
          rdfs:comment "Stage of a remedial action scheme."@en;
          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
          rdfs:label "Stage"@en;
          rdfs:subClassOf cim:IdentifiedObject;
          cimdoc:cimPackage "IEC61970.InfIEC61970.InfSIPS";
          cimdoc:packageTier "Informative".
cim:Stage.StageTrigger a owl:ObjectProperty;
                       rdfs:comment "A Stage consist of one or more StageTrigger."@en;
                       rdfs:domain cim:Stage;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "StageTrigger"@en;
                       rdfs:range cim:StageTrigger.
cim:Stage.priority a owl:DatatypeProperty;
                   rdfs:comment "The priority of the stage. 0 = don t care (default) 1 = highest priority. 2 is less than 1 and so on. A stage with higher priority needs be activated before a lower stage can be activated."@en;
                   rdfs:domain cim:Stage;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "priority"@en;
                   rdfs:range xsd:integer.
cim:StageTrigger a owl:Class;
                 rdfs:comment "Condition that is triggered either by TriggerCondition of by gate condition within a stage and has remedial action-s."@en;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "StageTrigger"@en;
                 rdfs:subClassOf cim:IdentifiedObject;
                 cimdoc:cimPackage "IEC61970.InfIEC61970.InfSIPS";
                 cimdoc:packageTier "Informative".
cim:StageTrigger.GateArmed a owl:ObjectProperty;
                           rdfs:comment "Association to a Gate that through a gate logic and input pin defines arming of the StageTrigger."@en;
                           rdfs:domain cim:StageTrigger;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "GateArmed"@en;
                           rdfs:range cim:Gate.
cim:StageTrigger.GateComCondition a owl:ObjectProperty;
                                  rdfs:comment "For the StageTrigger to active the set of protective actions the condition for communication needs to be met (true)."@en;
                                  rdfs:domain cim:StageTrigger;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "GateComCondition"@en;
                                  rdfs:range cim:Gate.
cim:StageTrigger.GateTrigger a owl:ObjectProperty;
                             rdfs:comment "The Gate result that trigger the StageTrigger and thereby executing the a set of protective actions."@en;
                             rdfs:domain cim:StageTrigger;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "GateTrigger"@en;
                             rdfs:range cim:Gate.
cim:StageTrigger.armed a owl:DatatypeProperty;
                       rdfs:comment "The status of the class set by operation or by signal. Optional field that will override other status fields."@en;
                       rdfs:domain cim:StageTrigger;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "armed"@en;
                       rdfs:range xsd:boolean.
cim:StageTrigger.normalArmed a owl:DatatypeProperty;
                             rdfs:comment "The default/normal value used when other active signal/values are missing."@en;
                             rdfs:domain cim:StageTrigger;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "normalArmed"@en;
                             rdfs:range xsd:boolean.
cim:StageTrigger.priority a owl:DatatypeProperty;
                          rdfs:comment "Priority of trigger. 0 = don t care (default) 1 = highest priority. 2 is less than 1 and so on. A trigger with the highest priority will trigger first."@en;
                          rdfs:domain cim:StageTrigger;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                          rdfs:label "priority"@en;
                          rdfs:range xsd:integer.
cim:StartIgnFuelCurve a owl:Class;
                      rdfs:comment "The quantity of ignition fuel (Y-axis) used to restart and repay the auxiliary power consumed versus the number of hours (X-axis) the unit was off line."@en;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "StartIgnFuelCurve"@en;
                      rdfs:subClassOf cim:Curve;
                      cimdoc:cimPackage "IEC61970.Base.Generation.Production";
                      cimdoc:packageTier "Normative".
cim:StartIgnFuelCurve.ignitionFuelType a owl:ObjectProperty;
                                       rdfs:comment "Type of ignition fuel."@en;
                                       rdfs:domain cim:StartIgnFuelCurve;
                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                       rdfs:label "ignitionFuelType"@en;
                                       rdfs:range cim:FuelType.
cim:StartMainFuelCurve a owl:Class;
                       rdfs:comment "The quantity of main fuel (Y-axis) used to restart and repay the auxiliary power consumed versus the number of hours (X-axis) the unit was off line."@en;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "StartMainFuelCurve"@en;
                       rdfs:subClassOf cim:Curve;
                       cimdoc:cimPackage "IEC61970.Base.Generation.Production";
                       cimdoc:packageTier "Normative".
cim:StartMainFuelCurve.mainFuelType a owl:ObjectProperty;
                                    rdfs:comment "Type of main fuel."@en;
                                    rdfs:domain cim:StartMainFuelCurve;
                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                    rdfs:label "mainFuelType"@en;
                                    rdfs:range cim:FuelType.
cim:StartRampCurve a owl:Class;
                   rdfs:comment "Rate in gross active power per minute (Y-axis) at which a unit can be loaded versus the number of hours (X-axis) the unit was off line."@en;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "StartRampCurve"@en;
                   rdfs:subClassOf cim:Curve;
                   cimdoc:cimPackage "IEC61970.Base.Generation.Production";
                   cimdoc:packageTier "Normative".
cim:StartRampCurve.hotStandbyRamp a owl:DatatypeProperty;
                                  rdfs:comment "The startup ramp rate in gross for a unit that is on hot standby."@en;
                                  rdfs:domain cim:StartRampCurve;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "hotStandbyRamp"@en;
                                  rdfs:range cim:ActivePowerChangeRate.
cim:StartupModel a owl:Class;
                 rdfs:comment "Unit start up characteristics depending on how long the unit has been off line."@en;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "StartupModel"@en;
                 rdfs:subClassOf cim:IdentifiedObject;
                 cimdoc:cimPackage "IEC61970.Base.Generation.Production";
                 cimdoc:packageTier "Normative".
cim:StartupModel.StartIgnFuelCurve a owl:ObjectProperty;
                                   rdfs:comment "The unit's startup model may have a startup ignition fuel curve."@en;
                                   rdfs:domain cim:StartupModel;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                   rdfs:label "StartIgnFuelCurve"@en;
                                   rdfs:range cim:StartIgnFuelCurve.
cim:StartupModel.StartMainFuelCurve a owl:ObjectProperty;
                                    rdfs:comment "The unit's startup model may have a startup main fuel curve."@en;
                                    rdfs:domain cim:StartupModel;
                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                    rdfs:label "StartMainFuelCurve"@en;
                                    rdfs:range cim:StartMainFuelCurve.
cim:StartupModel.StartRampCurve a owl:ObjectProperty;
                                rdfs:comment "The unit's startup model may have a startup ramp curve."@en;
                                rdfs:domain cim:StartupModel;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "StartRampCurve"@en;
                                rdfs:range cim:StartRampCurve.
cim:StartupModel.fixedMaintCost a owl:DatatypeProperty;
                                rdfs:comment "Fixed maintenance cost."@en;
                                rdfs:domain cim:StartupModel;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "fixedMaintCost"@en;
                                rdfs:range cim:CostRate.
cim:StartupModel.hotStandbyHeat a owl:DatatypeProperty;
                                rdfs:comment "The amount of heat input per time unit required for hot standby operation."@en;
                                rdfs:domain cim:StartupModel;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "hotStandbyHeat"@en;
                                rdfs:range cim:HeatRate.
cim:StartupModel.incrementalMaintCost a owl:DatatypeProperty;
                                      rdfs:comment "Incremental maintenance cost."@en;
                                      rdfs:domain cim:StartupModel;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                      rdfs:label "incrementalMaintCost"@en;
                                      rdfs:range cim:CostPerEnergyUnit.
cim:StartupModel.minimumDownTime a owl:DatatypeProperty;
                                 rdfs:comment "The minimum number of hours the unit must be down before restart."@en;
                                 rdfs:domain cim:StartupModel;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "minimumDownTime"@en;
                                 rdfs:range cim:Hours.
cim:StartupModel.minimumRunTime a owl:DatatypeProperty;
                                rdfs:comment "The minimum number of hours the unit must be operating before being allowed to shut down."@en;
                                rdfs:domain cim:StartupModel;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "minimumRunTime"@en;
                                rdfs:range cim:Hours.
cim:StartupModel.riskFactorCost a owl:DatatypeProperty;
                                rdfs:comment """The opportunity cost associated with the return in monetary unit. This represents the restart's \"share\" of the unit depreciation and risk of an event which would damage the unit."""@en;
                                rdfs:domain cim:StartupModel;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "riskFactorCost"@en;
                                rdfs:range cim:Money.
cim:StartupModel.startupCost a owl:DatatypeProperty;
                             rdfs:comment "Total miscellaneous start up costs."@en;
                             rdfs:domain cim:StartupModel;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "startupCost"@en;
                             rdfs:range cim:Money.
cim:StartupModel.startupDate a owl:DatatypeProperty;
                             rdfs:comment "The date and time of the most recent generating unit startup."@en;
                             rdfs:domain cim:StartupModel;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "startupDate"@en;
                             rdfs:range xsd:dateTime.
cim:StartupModel.startupPriority a owl:DatatypeProperty;
                                 rdfs:comment "Startup priority within control area where lower numbers indicate higher priorities. More than one unit in an area may be assigned the same priority."@en;
                                 rdfs:domain cim:StartupModel;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "startupPriority"@en;
                                 rdfs:range xsd:integer.
cim:StartupModel.stbyAuxP a owl:DatatypeProperty;
                          rdfs:comment "The unit's auxiliary active power consumption to maintain standby mode."@en;
                          rdfs:domain cim:StartupModel;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                          rdfs:label "stbyAuxP"@en;
                          rdfs:range cim:ActivePower.
cim:StateVariable a owl:Class;
                  rdfs:comment "An abstract class for state variables."@en;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "StateVariable"@en;
                  cimdoc:cimPackage "IEC61970.Base.StateVariables";
                  cimdoc:packageTier "Normative".
cim:StaticLoadModelKind a owl:Class;
                        rdfs:comment "Type of static load model."@en;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                        rdfs:label "StaticLoadModelKind"@en;
                        owl:equivalentClass [a owl:Class ; 
                                             owl:oneOf (cim:StaticLoadModelKind.constantZ
                                                        cim:StaticLoadModelKind.exponential
                                                        cim:StaticLoadModelKind.zIP1
                                                        cim:StaticLoadModelKind.zIP2)];
                        cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.LoadDynamics";
                        cimdoc:packageTier "Normative".
cim:StaticLoadModelKind.constantZ a owl:NamedIndividual,
                                    cim:StaticLoadModelKind;
                                  rdfs:comment "The load is represented as a constant impedance. ConstantZ equations are used for active and reactive power and no attributes are required."@en;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "constantZ"@en;
                                  cimdoc:enumCode 3 .
cim:StaticLoadModelKind.exponential a owl:NamedIndividual,
                                      cim:StaticLoadModelKind;
                                    rdfs:comment "This model is an exponential representation of the load. Exponential equations for active and reactive power are used and the following attributes are required: kp1, kp2, kp3, kpf, ep1, ep2, ep3 kq1, kq2, kq3, kqf, eq1, eq2, eq3."@en;
                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                    rdfs:label "exponential"@en;
                                    cimdoc:enumCode 0 .
cim:StaticLoadModelKind.zIP1 a owl:NamedIndividual,
                               cim:StaticLoadModelKind;
                             rdfs:comment "This model integrates the frequency-dependent load (primarily motors). ZIP1 equations for active and reactive power are used and the following attributes are required: kp1, kp2, kp3, kpf kq1, kq2, kq3, kqf."@en;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "zIP1"@en;
                             cimdoc:enumCode 1 .
cim:StaticLoadModelKind.zIP2 a owl:NamedIndividual,
                               cim:StaticLoadModelKind;
                             rdfs:comment "This model separates the frequency-dependent load (primarily motors) from other load. ZIP2 equations for active and reactive power are used and the following attributes are required: kp1, kp2, kp3, kq4, kpf kq1, kq2, kq3, kq4, kqf."@en;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "zIP2"@en;
                             cimdoc:enumCode 2 .
cim:StaticVarCompensator a owl:Class;
                         rdfs:comment "A facility for providing variable and controllable shunt reactive power. The SVC typically consists of a stepdown transformer, filter, thyristor-controlled reactor, and thyristor-switched capacitor arms. The SVC may operate in fixed MVar output mode or in voltage control mode. When in voltage control mode, the output of the SVC will be proportional to the deviation of voltage at the controlled bus from the voltage setpoint. The SVC characteristic slope defines the proportion. If the voltage at the controlled bus is equal to the voltage setpoint, the SVC MVar output is zero."@en;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                         rdfs:label "StaticVarCompensator"@en;
                         rdfs:subClassOf cim:RegulatingCondEq;
                         cimdoc:cimPackage "IEC61970.Base.Wires";
                         cimdoc:packageTier "Normative".
cim:StaticVarCompensator.capacitiveRating a owl:DatatypeProperty;
                                          rdfs:comment "Capacitive reactance at maximum capacitive reactive power. Shall always be positive."@en;
                                          rdfs:domain cim:StaticVarCompensator;
                                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                          rdfs:label "capacitiveRating"@en;
                                          rdfs:range cim:Reactance.
cim:StaticVarCompensator.inductiveRating a owl:DatatypeProperty;
                                         rdfs:comment "Inductive reactance at maximum inductive reactive power. Shall always be negative."@en;
                                         rdfs:domain cim:StaticVarCompensator;
                                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                         rdfs:label "inductiveRating"@en;
                                         rdfs:range cim:Reactance.
cim:StaticVarCompensator.q a owl:DatatypeProperty;
                           rdfs:comment "Reactive power injection. Load sign convention is used, i.e. positive sign means flow out from a node. Starting value for a steady state solution."@en;
                           rdfs:domain cim:StaticVarCompensator;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "q"@en;
                           rdfs:range cim:ReactivePower.
cim:StaticVarCompensator.sVCControlMode a owl:ObjectProperty;
                                        rdfs:comment "SVC control mode."@en;
                                        rdfs:domain cim:StaticVarCompensator;
                                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                        rdfs:label "sVCControlMode"@en;
                                        rdfs:range cim:SVCControlMode.
cim:StaticVarCompensator.slope a owl:DatatypeProperty;
                               rdfs:comment "The characteristics slope of an SVC defines how the reactive power output changes in proportion to the difference between the regulated bus voltage and the voltage setpoint. The attribute shall be a positive value or zero."@en;
                               rdfs:domain cim:StaticVarCompensator;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "slope"@en;
                               rdfs:range cim:VoltagePerReactivePower.
cim:StaticVarCompensator.voltageSetPoint a owl:DatatypeProperty;
                                         rdfs:comment "The reactive power output of the SVC is proportional to the difference between the voltage at the regulated bus and the voltage setpoint. When the regulated bus voltage is equal to the voltage setpoint, the reactive power output is zero."@en;
                                         rdfs:domain cim:StaticVarCompensator;
                                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                         rdfs:label "voltageSetPoint"@en;
                                         rdfs:range cim:Voltage.
cim:StaticVarCompensatorDynamics a owl:Class;
                                 rdfs:comment "Static var compensator whose behaviour is described by reference to a standard model or by definition of a user-defined model."@en;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "StaticVarCompensatorDynamics"@en;
                                 rdfs:subClassOf cim:DynamicsFunctionBlock;
                                 cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.StaticVarCompensatorDynamics";
                                 cimdoc:packageTier "Normative".
cim:StaticVarCompensatorDynamics.StaticVarCompensator a owl:ObjectProperty;
                                                      rdfs:comment "Static Var Compensator to which Static Var Compensator dynamics model applies."@en;
                                                      rdfs:domain cim:StaticVarCompensatorDynamics;
                                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                      rdfs:label "StaticVarCompensator"@en;
                                                      rdfs:range cim:StaticVarCompensator.
cim:StationSupply a owl:Class;
                  rdfs:comment "Station supply with load derived from the station output."@en;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "StationSupply"@en;
                  rdfs:subClassOf cim:EnergyConsumer;
                  cimdoc:cimPackage "IEC61970.Base.LoadModel";
                  cimdoc:packageTier "Normative".
cim:SteamSendoutSchedule a owl:Class;
                         rdfs:comment "The cogeneration plant's steam sendout schedule in volume per time unit."@en;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                         rdfs:label "SteamSendoutSchedule"@en;
                         rdfs:subClassOf cim:RegularIntervalSchedule;
                         cimdoc:cimPackage "IEC61970.Base.Generation.Production";
                         cimdoc:packageTier "Normative".
cim:SteamSupply a owl:Class;
                rdfs:comment "Steam supply for steam turbine."@en;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "SteamSupply"@en;
                rdfs:subClassOf cim:PowerSystemResource;
                cimdoc:cimPackage "IEC61970.Base.Generation.GenerationTrainingSimulation";
                cimdoc:packageTier "Normative".
cim:SteamSupply.SteamTurbines a owl:ObjectProperty;
                              rdfs:comment "Steam turbines may have steam supplied by a steam supply."@en;
                              rdfs:domain cim:SteamSupply;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "SteamTurbines"@en;
                              rdfs:range cim:SteamTurbine.
cim:SteamSupply.steamSupplyRating a owl:DatatypeProperty;
                                  rdfs:comment "Rating of steam supply."@en;
                                  rdfs:domain cim:SteamSupply;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "steamSupplyRating"@en;
                                  rdfs:range xsd:float.
cim:SteamTurbine a owl:Class;
                 rdfs:comment "Steam turbine."@en;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "SteamTurbine"@en;
                 rdfs:subClassOf cim:PrimeMover;
                 cimdoc:cimPackage "IEC61970.Base.Generation.GenerationTrainingSimulation";
                 cimdoc:packageTier "Normative".
cim:SteamTurbine.crossoverTC a owl:DatatypeProperty;
                             rdfs:comment "Crossover time constant."@en;
                             rdfs:domain cim:SteamTurbine;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "crossoverTC"@en;
