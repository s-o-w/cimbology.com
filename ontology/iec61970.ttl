cim:UnderexcLimIEEE2.kuf a owl:DatatypeProperty;
                         rdfs:comment "UEL excitation system stabilizer gain (KUF). Typical value = 0."@en;
                         rdfs:domain cim:UnderexcLimIEEE2;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
