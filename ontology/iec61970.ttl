cim:PssWECC.t2 a owl:DatatypeProperty;
               rdfs:comment "Input signal 2 transducer time constant (T2) (>= 0). Typical value = 0,0."@en;
               rdfs:domain cim:PssWECC;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "t2"@en;
               rdfs:range cim:Seconds.
cim:PssWECC.t3 a owl:DatatypeProperty;
               rdfs:comment "Stabilizer washout time constant (T3) (>= 0). Typical value = 9,5."@en;
               rdfs:domain cim:PssWECC;
