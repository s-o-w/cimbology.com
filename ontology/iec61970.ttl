cim:GovGAST1.loadinc a owl:DatatypeProperty;
                     rdfs:comment "Valve position change allowed at fast rate (Loadinc). Typical value = 0, 05."@en;
                     rdfs:domain cim:GovGAST1;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                     rdfs:label "loadinc"@en;
