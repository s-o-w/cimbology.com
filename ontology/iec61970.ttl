                                 rdfs:comment "Remedial Action Plan (RAP)."@en;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "rAP"@en;
                                 cimdoc:enumCode 1 .
cim:RemedialActionSchemeKind.rAS a owl:NamedIndividual,
                                   cim:RemedialActionSchemeKind;
                                 rdfs:comment "Remedial Action Scheme (RAS)."@en;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "rAS"@en;
                                 cimdoc:enumCode 0 .
cim:RemoteControl a owl:Class;
                  rdfs:comment "Remote controls are outputs that are sent by the remote unit to actuators in the process."@en;
