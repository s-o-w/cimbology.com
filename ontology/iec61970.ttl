cim:WindProtectionIEC.mzc a owl:DatatypeProperty;
                          rdfs:comment "Zero crossing measurement mode (Mzc). It is a type-dependent parameter. true = WT protection system uses zero crossings to detect frequency (1 in the IEC model) false = WT protection system does not use zero crossings to detect frequency (0 in the IEC model)."@en;
                          rdfs:domain cim:WindProtectionIEC;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                          rdfs:label "mzc"@en;
                          rdfs:range xsd:boolean.
cim:WindProtectionIEC.tfma a owl:DatatypeProperty;
