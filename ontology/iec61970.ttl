cim:GovHydro1.gmax a owl:DatatypeProperty;
                   rdfs:comment "Maximum gate opening (Gmax) (> 0 and > GovHydro.gmin). Typical value = 1."@en;
                   rdfs:domain cim:GovHydro1;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "gmax"@en;
