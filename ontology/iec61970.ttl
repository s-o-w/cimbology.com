cim:GovGAST1.gv1 a owl:DatatypeProperty;
                 rdfs:comment "Nonlinear gain point 1, PU gv (Gv1). Typical value = 0."@en;
                 rdfs:domain cim:GovGAST1;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
