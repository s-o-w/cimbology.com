cim:ExcBBC a owl:Class;
           rdfs:comment "Transformer fed static excitation system (static with ABB regulator). This model represents a static excitation system in which a gated thyristor bridge fed by a transformer at the main generator terminals feeds the main generator directly."@en;
           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
           rdfs:label "ExcBBC"@en;
           rdfs:subClassOf cim:ExcitationSystemDynamics;
           cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.ExcitationSystemDynamics";
           cimdoc:packageTier "Normative".
cim:ExcBBC.efdmax a owl:DatatypeProperty;
                  rdfs:comment "Maximum open circuit exciter voltage (Efdmax) (> ExcBBC.efdmin). Typical value = 5."@en;
                  rdfs:domain cim:ExcBBC;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "efdmax"@en;
                  rdfs:range cim:PU.
cim:ExcBBC.efdmin a owl:DatatypeProperty;
                  rdfs:comment "Minimum open circuit exciter voltage (Efdmin) (less than ExcBBC.efdmax). Typical value = -5."@en;
                  rdfs:domain cim:ExcBBC;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "efdmin"@en;
                  rdfs:range cim:PU.
cim:ExcBBC.k a owl:DatatypeProperty;
             rdfs:comment "Steady state gain (K) (not = 0). Typical value = 300."@en;
             rdfs:domain cim:ExcBBC;
             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
             rdfs:label "k"@en;
             rdfs:range cim:PU.
cim:ExcBBC.signalSwitch a owl:DatatypeProperty;
                        rdfs:comment "Supplementary signal routing selector (switch). true = Vs connected to 3rd summing point false = Vs connected to 1st summing point (see diagram). Typical value = false."@en;
                        rdfs:domain cim:ExcBBC;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                        rdfs:label "signalSwitch"@en;
                        rdfs:range xsd:boolean.
cim:ExcBBC.t1 a owl:DatatypeProperty;
              rdfs:comment "Controller time constant (T1) (>= 0). Typical value = 6."@en;
              rdfs:domain cim:ExcBBC;
              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
              rdfs:label "t1"@en;
              rdfs:range cim:Seconds.
cim:ExcBBC.t2 a owl:DatatypeProperty;
              rdfs:comment "Controller time constant (T2) (>= 0). Typical value = 1."@en;
              rdfs:domain cim:ExcBBC;
              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
              rdfs:label "t2"@en;
              rdfs:range cim:Seconds.
cim:ExcBBC.t3 a owl:DatatypeProperty;
              rdfs:comment "Lead/lag time constant (T3) (>= 0). If = 0, block is bypassed. Typical value = 0,05."@en;
              rdfs:domain cim:ExcBBC;
              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
              rdfs:label "t3"@en;
              rdfs:range cim:Seconds.
cim:ExcBBC.t4 a owl:DatatypeProperty;
              rdfs:comment "Lead/lag time constant (T4) (>= 0). If = 0, block is bypassed. Typical value = 0,01."@en;
              rdfs:domain cim:ExcBBC;
              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
              rdfs:label "t4"@en;
              rdfs:range cim:Seconds.
cim:ExcBBC.vrmax a owl:DatatypeProperty;
                 rdfs:comment "Maximum control element output (Vrmax) (> ExcBBC.vrmin). Typical value = 5."@en;
                 rdfs:domain cim:ExcBBC;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "vrmax"@en;
                 rdfs:range cim:PU.
cim:ExcBBC.vrmin a owl:DatatypeProperty;
                 rdfs:comment "Minimum control element output (Vrmin) (less than ExcBBC.vrmax). Typical value = -5."@en;
                 rdfs:domain cim:ExcBBC;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "vrmin"@en;
                 rdfs:range cim:PU.
cim:ExcBBC.xe a owl:DatatypeProperty;
              rdfs:comment "Effective excitation transformer reactance (Xe) (>= 0). Xe models the regulation of the transformer/rectifier unit. Typical value = 0,05."@en;
              rdfs:domain cim:ExcBBC;
              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
              rdfs:label "xe"@en;
              rdfs:range cim:PU.
cim:ExcCZ a owl:Class;
