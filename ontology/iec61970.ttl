             cimdoc:packageTier "Normative";
             cimdoc:unitSymbol cim:UnitSymbol.J.
cim:HeatRateCurve a owl:Class;
                  rdfs:comment "Relationship between unit heat rate per active power (Y-axis) and unit output (X-axis). The heat input is from all fuels."@en;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "HeatRateCurve"@en;
                  rdfs:subClassOf cim:Curve;
