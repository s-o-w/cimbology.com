cim:AnalogToDigitalLogicKind a owl:Class;
                             rdfs:comment "Categories of analog to digital (or logical result) comparison."@en;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "AnalogToDigitalLogicKind"@en;
                             owl:equivalentClass [a owl:Class ; 
                                                  owl:oneOf (cim:AnalogToDigitalLogicKind.eq
                                                             cim:AnalogToDigitalLogicKind.ge
                                                             cim:AnalogToDigitalLogicKind.gt
                                                             cim:AnalogToDigitalLogicKind.le
                                                             cim:AnalogToDigitalLogicKind.lt
                                                             cim:AnalogToDigitalLogicKind.ne)];
                             cimdoc:cimPackage "IEC61970.InfIEC61970.InfSIPS";
                             cimdoc:packageTier "Informative".
cim:AnalogToDigitalLogicKind.eq a owl:NamedIndividual,
                                  cim:AnalogToDigitalLogicKind;
                                rdfs:comment "Equal (like) comparison operation."@en;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "eq"@en;
                                cimdoc:enumCode 1 .
cim:AnalogToDigitalLogicKind.ge a owl:NamedIndividual,
                                  cim:AnalogToDigitalLogicKind;
                                rdfs:comment "Greater or equal comparison operation."@en;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "ge"@en;
                                cimdoc:enumCode 4 .
cim:AnalogToDigitalLogicKind.gt a owl:NamedIndividual,
                                  cim:AnalogToDigitalLogicKind;
                                rdfs:comment "Greater than comparison operation."@en;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "gt"@en;
                                cimdoc:enumCode 5 .
cim:AnalogToDigitalLogicKind.le a owl:NamedIndividual,
                                  cim:AnalogToDigitalLogicKind;
                                rdfs:comment "Less or equal comparison operation."@en;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "le"@en;
                                cimdoc:enumCode 2 .
cim:AnalogToDigitalLogicKind.lt a owl:NamedIndividual,
                                  cim:AnalogToDigitalLogicKind;
                                rdfs:comment "Less than comparison operation."@en;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "lt"@en;
                                cimdoc:enumCode 3 .
cim:AnalogToDigitalLogicKind.ne a owl:NamedIndividual,
                                  cim:AnalogToDigitalLogicKind;
                                rdfs:comment "Not equal (unlike) comparison operation."@en;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "ne"@en;
                                cimdoc:enumCode 0 .
