                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "maxU"@en;
                            rdfs:range cim:Voltage.
cim:FrequencyConverter.minP a owl:DatatypeProperty;
                            rdfs:comment "The minimum active power on the DC side at which the frequency converter should operate."@en;
                            rdfs:domain cim:FrequencyConverter;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "minP"@en;
                            rdfs:range cim:ActivePower.
cim:FrequencyConverter.minU a owl:DatatypeProperty;
                            rdfs:comment "The minimum voltage on the DC side at which the frequency converter should operate."@en;
                            rdfs:domain cim:FrequencyConverter;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "minU"@en;
                            rdfs:range cim:Voltage.
cim:FuelAllocationSchedule a owl:Class;
                           rdfs:comment "The amount of fuel of a given type which is allocated for consumption over a specified period of time."@en;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "FuelAllocationSchedule"@en;
                           rdfs:subClassOf cim:Curve;
