cim:WindLookupTableFunctionKind.ipmax a owl:NamedIndividual,
                                        cim:WindLookupTableFunctionKind;
                                      rdfs:comment "Lookup table for voltage dependency of active current limits (ipmax(uWT)). It is used for the current limitation model, IEC 61400-27-1:2015, 5.6.5.8."@en;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                      rdfs:label "ipmax"@en;
                                      cimdoc:enumCode 2 .
cim:WindLookupTableFunctionKind.iqmax a owl:NamedIndividual,
                                        cim:WindLookupTableFunctionKind;
                                      rdfs:comment "Lookup table for voltage dependency of reactive current limits (iqmax(uWT)). It is used for the current limitation model, IEC 61400-27-1:2015, 5.6.5.8."@en;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                      rdfs:label "iqmax"@en;
                                      cimdoc:enumCode 3 .
cim:WindLookupTableFunctionKind.omegap a owl:NamedIndividual,
                                         cim:WindLookupTableFunctionKind;
                                       rdfs:comment "Power vs. speed lookup table (omega(p)). It is used for the P control model type 3, IEC 61400-27-1:2015, 5.6.5.4."@en;
                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                       rdfs:label "omegap"@en;
                                       cimdoc:enumCode 1 .
cim:WindLookupTableFunctionKind.prr a owl:NamedIndividual,
                                      cim:WindLookupTableFunctionKind;
                                    rdfs:comment "Power versus speed change (negative slip) lookup table (prr(deltaomega)). It is used for the rotor resistance control model, IEC 61400-27-1:2015, 5.6.5.3."@en;
                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                    rdfs:label "prr"@en;
                                    cimdoc:enumCode 0 .
cim:WindLookupTableFunctionKind.pwp a owl:NamedIndividual,
                                      cim:WindLookupTableFunctionKind;
                                    rdfs:comment "Power vs. frequency lookup table (pWPbias(f)). It is used for the wind power plant frequency and active power control model, IEC 61400-27-1:2015, Annex D."@en;
                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                    rdfs:label "pwp"@en;
                                    cimdoc:enumCode 4 .
cim:WindLookupTableFunctionKind.qmaxp a owl:NamedIndividual,
                                        cim:WindLookupTableFunctionKind;
                                      rdfs:comment "Lookup table for active power dependency of reactive power maximum limit (qmaxp(p)). It is used for the QP and QU limitation model, IEC 61400- 27-1:2015, 5.6.5.10."@en;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                      rdfs:label "qmaxp"@en;
                                      cimdoc:enumCode 7 .
cim:WindLookupTableFunctionKind.qmaxu a owl:NamedIndividual,
                                        cim:WindLookupTableFunctionKind;
                                      rdfs:comment "Lookup table for voltage dependency of reactive power maximum limit (qmaxu(p)). It is used for the QP and QU limitation model, IEC 61400- 27-1:2015, 5.6.5.10."@en;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                      rdfs:label "qmaxu"@en;
                                      cimdoc:enumCode 9 .
cim:WindLookupTableFunctionKind.qminp a owl:NamedIndividual,
                                        cim:WindLookupTableFunctionKind;
                                      rdfs:comment "Lookup table for active power dependency of reactive power minimum limit (qminp(p)). It is used for the QP and QU limitation model, IEC 61400- 27-1:2015, 5.6.5.10."@en;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                      rdfs:label "qminp"@en;
                                      cimdoc:enumCode 8 .
cim:WindLookupTableFunctionKind.qminu a owl:NamedIndividual,
                                        cim:WindLookupTableFunctionKind;
                                      rdfs:comment "Lookup table for voltage dependency of reactive power minimum limit (qminu(p)). It is used for the QP and QU limitation model, IEC 61400- 27-1:2015, 5.6.5.10."@en;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                      rdfs:label "qminu"@en;
                                      cimdoc:enumCode 10 .
cim:WindLookupTableFunctionKind.qwp a owl:NamedIndividual,
                                      cim:WindLookupTableFunctionKind;
                                    rdfs:comment "Look up table for the UQ static mode (qWP(uerr)). It is used for the voltage and reactive power control model, IEC 61400-27-1:2015, Annex D."@en;
                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                    rdfs:label "qwp"@en;
                                    cimdoc:enumCode 15 .
cim:WindLookupTableFunctionKind.tcwdu a owl:NamedIndividual,
                                        cim:WindLookupTableFunctionKind;
                                      rdfs:comment "Crowbar duration versus voltage variation look-up table (TCW(du)). It is a case-dependent parameter. It is used for the type 3B generator set model, IEC 61400-27-1:2015, 5.6.3.3."@en;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                      rdfs:label "tcwdu"@en;
                                      cimdoc:enumCode 5 .
cim:WindLookupTableFunctionKind.tduwt a owl:NamedIndividual,
                                        cim:WindLookupTableFunctionKind;
                                      rdfs:comment "Lookup table to determine the duration of the power reduction after a voltage dip, depending on the size of the voltage dip (Td(uWT)). It is a type-dependent parameter. It is used for the pitch control power model, IEC 61400-27-1:2015, 5.6.5.1."@en;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                      rdfs:label "tduwt"@en;
                                      cimdoc:enumCode 6 .
cim:WindLookupTableFunctionKind.tfover a owl:NamedIndividual,
                                         cim:WindLookupTableFunctionKind;
                                       rdfs:comment "Disconnection time versus over-frequency lookup table (Tfover(fWT)). It is used for the grid protection model, IEC 61400-27-1:2015, 5.6.6."@en;
                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                       rdfs:label "tfover"@en;
                                       cimdoc:enumCode 13 .
cim:WindLookupTableFunctionKind.tfunder a owl:NamedIndividual,
                                          cim:WindLookupTableFunctionKind;
                                        rdfs:comment "Disconnection time versus under-frequency lookup table (Tfunder(fWT)). It is used for the grid protection model, IEC 61400-27-1:2015, 5.6.6."@en;
                                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                        rdfs:label "tfunder"@en;
                                        cimdoc:enumCode 14 .
cim:WindLookupTableFunctionKind.tuover a owl:NamedIndividual,
                                         cim:WindLookupTableFunctionKind;
                                       rdfs:comment "Disconnection time versus over-voltage lookup table (Tuover(uWT)). It is used for the grid protection model, IEC 61400-27-1:2015, 5.6.6."@en;
                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                       rdfs:label "tuover"@en;
                                       cimdoc:enumCode 11 .
cim:WindLookupTableFunctionKind.tuunder a owl:NamedIndividual,
