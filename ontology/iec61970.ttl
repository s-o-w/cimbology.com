                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "eqvs"@en;
                       rdfs:range xsd:float.
cim:LoadComposite.h a owl:DatatypeProperty;
                    rdfs:comment "Inertia constant (H) (>= 0). Typical value = 2,5."@en;
                    rdfs:domain cim:LoadComposite;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "h"@en;
