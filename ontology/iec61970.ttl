cim:NetworkModelProjectComponent2.closed a owl:DatatypeProperty;
                                         rdfs:comment "The date the component was closed."@en;
                                         rdfs:domain cim:NetworkModelProjectComponent2;
                                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                         rdfs:label "closed"@en;
                                         rdfs:range xsd:dateTime.
cim:NetworkModelProjectComponent2.created a owl:DatatypeProperty;
                                          rdfs:comment "The date the component was created."@en;
                                          rdfs:domain cim:NetworkModelProjectComponent2;
                                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                          rdfs:label "created"@en;
                                          rdfs:range xsd:dateTime.
cim:NetworkModelProjectComponent2.m_CurrentState a owl:ObjectProperty;
                                                 rdfs:comment "The current state of the component."@en;
                                                 rdfs:domain cim:NetworkModelProjectComponent2;
                                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                 rdfs:label "m_CurrentState"@en;
                                                 rdfs:range cim:CurrentState.
cim:NetworkModelProjectComponent2.updated a owl:DatatypeProperty;
                                          rdfs:comment "The date the component was last updated."@en;
                                          rdfs:domain cim:NetworkModelProjectComponent2;
                                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                          rdfs:label "updated"@en;
                                          rdfs:range xsd:dateTime.
cim:NetworkModelProjectComponent2.version a owl:DatatypeProperty;
                                          rdfs:comment "The version of the component."@en;
                                          rdfs:domain cim:NetworkModelProjectComponent2;
                                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                          rdfs:label "version"@en;
                                          rdfs:range xsd:integer.
cim:NetworkModelProjectDocument a owl:Class;
                                rdfs:comment "Represents a document associated with a network model project."@en;
