cim:GovHydro2.pmin a owl:DatatypeProperty;
                   rdfs:comment "Minimum gate opening (Pmin) (< GovHydro2.pmax). Typical value = 0."@en;
                   rdfs:domain cim:GovHydro2;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "pmin"@en;
                   rdfs:range cim:PU.
cim:GovHydro2.rperm a owl:DatatypeProperty;
                    rdfs:comment "Permanent droop (Rperm). Typical value = 0,05."@en;
                    rdfs:domain cim:GovHydro2;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "rperm"@en;
                    rdfs:range cim:PU.
cim:GovHydro2.rtemp a owl:DatatypeProperty;
