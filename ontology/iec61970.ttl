cim:FrequencyConverter.maxP a owl:DatatypeProperty;
                            rdfs:comment "The maximum active power on the DC side at which the frequency converter should operate."@en;
                            rdfs:domain cim:FrequencyConverter;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "maxP"@en;
