                                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                rdfs:label "byPercentage"@en;
                                                cimdoc:enumCode 0 .
cim:ProtectiveActionAdjustmentKind.byValue a owl:NamedIndividual,
                                             cim:ProtectiveActionAdjustmentKind;
                                           rdfs:comment "The adjustment is in given by a value that defined the changes that will be done to the active value."@en;
                                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
