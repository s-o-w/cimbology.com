                   rdfs:label "tb"@en;
                   rdfs:range cim:Seconds.
cim:ExcIEEEAC2A.tc a owl:DatatypeProperty;
                   rdfs:comment "Voltage regulator time constant (TC) (>= 0). Typical value = 0."@en;
                   rdfs:domain cim:ExcIEEEAC2A;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "tc"@en;
                   rdfs:range cim:Seconds.
cim:ExcIEEEAC2A.te a owl:DatatypeProperty;
                   rdfs:comment "Exciter time constant, integration rate associated with exciter control (TE) (> 0). Typical value = 0,6."@en;
                   rdfs:domain cim:ExcIEEEAC2A;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "te"@en;
                   rdfs:range cim:Seconds.
