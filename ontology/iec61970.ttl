cim:GovCT2.prate a owl:DatatypeProperty;
                 rdfs:comment "Ramp rate for frequency-dependent power limit (Prate). Typical value = 0,017."@en;
                 rdfs:domain cim:GovCT2;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "prate"@en;
                 rdfs:range cim:PU.
cim:GovCT2.r a owl:DatatypeProperty;
             rdfs:comment "Permanent droop (R). Typical value = 0,05."@en;
             rdfs:domain cim:GovCT2;
             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
             rdfs:label "r"@en;
             rdfs:range cim:PU.
cim:GovCT2.rclose a owl:DatatypeProperty;
                  rdfs:comment "Minimum valve closing rate (Rclose). Unit = PU / s. Typical value = - 99."@en;
                  rdfs:domain cim:GovCT2;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "rclose"@en;
                  rdfs:range xsd:float.
cim:GovCT2.rdown a owl:DatatypeProperty;
                 rdfs:comment "Maximum rate of load limit decrease (Rdown). Typical value = -99."@en;
                 rdfs:domain cim:GovCT2;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "rdown"@en;
                 rdfs:range cim:PU.
cim:GovCT2.ropen a owl:DatatypeProperty;
                 rdfs:comment "Maximum valve opening rate (Ropen). Unit = PU / s. Typical value = 99."@en;
                 rdfs:domain cim:GovCT2;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "ropen"@en;
                 rdfs:range xsd:float.
cim:GovCT2.rselect a owl:ObjectProperty;
                   rdfs:comment "Feedback signal for droop (Rselect). Typical value = electricalPower."@en;
                   rdfs:domain cim:GovCT2;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "rselect"@en;
                   rdfs:range cim:DroopSignalFeedbackKind.
cim:GovCT2.rup a owl:DatatypeProperty;
               rdfs:comment "Maximum rate of load limit increase (Rup). Typical value = 99."@en;
               rdfs:domain cim:GovCT2;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "rup"@en;
               rdfs:range cim:PU.
cim:GovCT2.ta a owl:DatatypeProperty;
              rdfs:comment "Acceleration limiter time constant (Ta) (>= 0). Typical value = 1."@en;
              rdfs:domain cim:GovCT2;
              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
              rdfs:label "ta"@en;
              rdfs:range cim:Seconds.
cim:GovCT2.tact a owl:DatatypeProperty;
                rdfs:comment "Actuator time constant (Tact) (>= 0). Typical value = 0,4."@en;
                rdfs:domain cim:GovCT2;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "tact"@en;
                rdfs:range cim:Seconds.
cim:GovCT2.tb a owl:DatatypeProperty;
              rdfs:comment "Turbine lag time constant (Tb) (>= 0). Typical value = 0,1."@en;
              rdfs:domain cim:GovCT2;
              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
              rdfs:label "tb"@en;
              rdfs:range cim:Seconds.
cim:GovCT2.tc a owl:DatatypeProperty;
              rdfs:comment "Turbine lead time constant (Tc) (>= 0). Typical value = 0."@en;
              rdfs:domain cim:GovCT2;
              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
              rdfs:label "tc"@en;
              rdfs:range cim:Seconds.
cim:GovCT2.tdgov a owl:DatatypeProperty;
                 rdfs:comment "Governor derivative controller time constant (Tdgov) (>= 0). Typical value = 1."@en;
                 rdfs:domain cim:GovCT2;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "tdgov"@en;
                 rdfs:range cim:Seconds.
cim:GovCT2.teng a owl:DatatypeProperty;
                rdfs:comment "Transport time delay for diesel engine used in representing diesel engines where there is a small but measurable transport delay between a change in fuel flow setting and the development of torque (Teng) (>= 0). Teng should be zero in all but special cases where this transport delay is of particular concern. Typical value = 0."@en;
                rdfs:domain cim:GovCT2;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "teng"@en;
                rdfs:range cim:Seconds.
cim:GovCT2.tfload a owl:DatatypeProperty;
                  rdfs:comment "Load limiter time constant (Tfload) (>= 0). Typical value = 3."@en;
                  rdfs:domain cim:GovCT2;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "tfload"@en;
                  rdfs:range cim:Seconds.
cim:GovCT2.tpelec a owl:DatatypeProperty;
                  rdfs:comment "Electrical power transducer time constant (Tpelec) (>= 0). Typical value = 2,5."@en;
                  rdfs:domain cim:GovCT2;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "tpelec"@en;
                  rdfs:range cim:Seconds.
cim:GovCT2.tsa a owl:DatatypeProperty;
               rdfs:comment "Temperature detection lead time constant (Tsa) (>= 0). Typical value = 0."@en;
               rdfs:domain cim:GovCT2;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "tsa"@en;
               rdfs:range cim:Seconds.
cim:GovCT2.tsb a owl:DatatypeProperty;
               rdfs:comment "Temperature detection lag time constant (Tsb) (>= 0). Typical value = 50."@en;
               rdfs:domain cim:GovCT2;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "tsb"@en;
               rdfs:range cim:Seconds.
cim:GovCT2.vmax a owl:DatatypeProperty;
                rdfs:comment "Maximum valve position limit (Vmax) (greater than GovCT2.vmin). Typical value = 1."@en;
                rdfs:domain cim:GovCT2;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "vmax"@en;
                rdfs:range cim:PU.
cim:GovCT2.vmin a owl:DatatypeProperty;
                rdfs:comment "Minimum valve position limit (Vmin) (less than GovCT2.vmax). Typical value = 0,175."@en;
                rdfs:domain cim:GovCT2;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "vmin"@en;
                rdfs:range cim:PU.
cim:GovCT2.wfnl a owl:DatatypeProperty;
                rdfs:comment "No load fuel flow (Wfnl). Typical value = 0,187."@en;
                rdfs:domain cim:GovCT2;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "wfnl"@en;
                rdfs:range cim:PU.
cim:GovCT2.wfspd a owl:DatatypeProperty;
                 rdfs:comment "Switch for fuel source characteristic to recognize that fuel flow, for a given fuel valve stroke, can be proportional to engine speed (Wfspd). true = fuel flow proportional to speed (for some gas turbines and diesel engines with positive displacement fuel injectors) false = fuel control system keeps fuel flow independent of engine speed. Typical value = false."@en;
                 rdfs:domain cim:GovCT2;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "wfspd"@en;
                 rdfs:range xsd:boolean.
cim:GovGAST a owl:Class;
            rdfs:comment "Single shaft gas turbine."@en;
            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
            rdfs:label "GovGAST"@en;
            rdfs:subClassOf cim:TurbineGovernorDynamics;
            cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.TurbineGovernorDynamics";
            cimdoc:packageTier "Normative".
cim:GovGAST.at a owl:DatatypeProperty;
               rdfs:comment "Ambient temperature load limit (Load Limit). Typical value = 1."@en;
               rdfs:domain cim:GovGAST;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "at"@en;
               rdfs:range cim:PU.
cim:GovGAST.dturb a owl:DatatypeProperty;
                  rdfs:comment "Turbine damping factor (Dturb). Typical value = 0,18."@en;
                  rdfs:domain cim:GovGAST;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "dturb"@en;
                  rdfs:range cim:PU.
cim:GovGAST.kt a owl:DatatypeProperty;
               rdfs:comment "Temperature limiter gain (Kt). Typical value = 3."@en;
               rdfs:domain cim:GovGAST;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "kt"@en;
               rdfs:range cim:PU.
cim:GovGAST.mwbase a owl:DatatypeProperty;
                   rdfs:comment "Base for power values (MWbase) (> 0). Unit = MW."@en;
                   rdfs:domain cim:GovGAST;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "mwbase"@en;
                   rdfs:range cim:ActivePower.
cim:GovGAST.r a owl:DatatypeProperty;
              rdfs:comment "Permanent droop (R) (>0). Typical value = 0,04."@en;
              rdfs:domain cim:GovGAST;
              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
              rdfs:label "r"@en;
              rdfs:range cim:PU.
cim:GovGAST.t1 a owl:DatatypeProperty;
               rdfs:comment "Governor mechanism time constant (T1) (>= 0). T1 represents the natural valve positioning time constant of the governor for small disturbances, as seen when rate limiting is not in effect. Typical value = 0,5."@en;
               rdfs:domain cim:GovGAST;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "t1"@en;
               rdfs:range cim:Seconds.
cim:GovGAST.t2 a owl:DatatypeProperty;
               rdfs:comment "Turbine power time constant (T2) (>= 0). T2 represents delay due to internal energy storage of the gas turbine engine. T2 can be used to give a rough approximation to the delay associated with acceleration of the compressor spool of a multi-shaft engine, or with the compressibility of gas in the plenum of a free power turbine of an aero-derivative unit, for example. Typical value = 0,5."@en;
               rdfs:domain cim:GovGAST;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "t2"@en;
               rdfs:range cim:Seconds.
cim:GovGAST.t3 a owl:DatatypeProperty;
               rdfs:comment "Turbine exhaust temperature time constant (T3) (>= 0). Typical value = 3."@en;
               rdfs:domain cim:GovGAST;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "t3"@en;
               rdfs:range cim:Seconds.
cim:GovGAST.vmax a owl:DatatypeProperty;
                 rdfs:comment "Maximum turbine power, PU of MWbase (Vmax) (greater than GovGAST.vmin). Typical value = 1."@en;
                 rdfs:domain cim:GovGAST;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "vmax"@en;
                 rdfs:range cim:PU.
cim:GovGAST.vmin a owl:DatatypeProperty;
                 rdfs:comment "Minimum turbine power, PU of MWbase (Vmin) (less than GovGAST.vmax). Typical value = 0."@en;
                 rdfs:domain cim:GovGAST;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "vmin"@en;
                 rdfs:range cim:PU.
cim:GovGAST1 a owl:Class;
             rdfs:comment "Modified single shaft gas turbine."@en;
