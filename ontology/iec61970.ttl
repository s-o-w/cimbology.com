                           cimdoc:packageTier "Normative".
cim:FuelAllocationSchedule.fuelAllocationEndDate a owl:DatatypeProperty;
                                                 rdfs:comment "The end time and date of the fuel allocation schedule."@en;
                                                 rdfs:domain cim:FuelAllocationSchedule;
                                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                 rdfs:label "fuelAllocationEndDate"@en;
                                                 rdfs:range xsd:dateTime.
cim:FuelAllocationSchedule.fuelAllocationStartDate a owl:DatatypeProperty;
                                                   rdfs:comment "The start time and date of the fuel allocation schedule."@en;
                                                   rdfs:domain cim:FuelAllocationSchedule;
                                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                   rdfs:label "fuelAllocationStartDate"@en;
                                                   rdfs:range xsd:dateTime.
cim:FuelAllocationSchedule.fuelType a owl:ObjectProperty;
                                    rdfs:comment "The type of fuel, which also indicates the corresponding measurement unit."@en;
                                    rdfs:domain cim:FuelAllocationSchedule;
                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                    rdfs:label "fuelType"@en;
                                    rdfs:range cim:FuelType.
cim:FuelAllocationSchedule.maxFuelAllocation a owl:DatatypeProperty;
                                             rdfs:comment "The maximum amount of fuel that is allocated for consumption for the scheduled time period."@en;
                                             rdfs:domain cim:FuelAllocationSchedule;
                                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                             rdfs:label "maxFuelAllocation"@en;
                                             rdfs:range xsd:float.
cim:FuelAllocationSchedule.minFuelAllocation a owl:DatatypeProperty;
                                             rdfs:comment """The minimum amount of fuel that is allocated for consumption for the scheduled time period, e.g., based on a \"take-or-pay\" contract."""@en;
                                             rdfs:domain cim:FuelAllocationSchedule;
                                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                             rdfs:label "minFuelAllocation"@en;
                                             rdfs:range xsd:float.
cim:FuelType a owl:Class;
             rdfs:comment "Type of fuel."@en;
             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
             rdfs:label "FuelType"@en;
             owl:equivalentClass [a owl:Class ; 
                                  owl:oneOf (cim:FuelType.brownCoalLignite
                                             cim:FuelType.coal
                                             cim:FuelType.coalDerivedGas
                                             cim:FuelType.gas
                                             cim:FuelType.hardCoal
                                             cim:FuelType.lignite
                                             cim:FuelType.oil
                                             cim:FuelType.oilShale
                                             cim:FuelType.other
                                             cim:FuelType.peat)];
             cimdoc:cimPackage "IEC61970.Base.Generation.Production";
             cimdoc:packageTier "Normative".
cim:FuelType.brownCoalLignite a owl:NamedIndividual,
                                cim:FuelType;
                              rdfs:comment "Brown coal lignite."@en;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "brownCoalLignite"@en;
                              cimdoc:enumCode 6 .
cim:FuelType.coal a owl:NamedIndividual,
                    cim:FuelType;
                  rdfs:comment "Generic coal, not including lignite type."@en;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "coal"@en;
                  cimdoc:enumCode 0 .
cim:FuelType.coalDerivedGas a owl:NamedIndividual,
                              cim:FuelType;
                            rdfs:comment "Coal derived gas."@en;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "coalDerivedGas"@en;
                            cimdoc:enumCode 7 .
cim:FuelType.gas a owl:NamedIndividual,
                   cim:FuelType;
                 rdfs:comment "Natural gas."@en;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "gas"@en;
                 cimdoc:enumCode 2 .
cim:FuelType.hardCoal a owl:NamedIndividual,
                        cim:FuelType;
                      rdfs:comment "Hard coal."@en;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "hardCoal"@en;
                      cimdoc:enumCode 4 .
cim:FuelType.lignite a owl:NamedIndividual,
                       cim:FuelType;
                     rdfs:comment "The fuel is lignite coal. Note that this is a special type of coal, so the other enum of coal is reserved for hard coal types or if the exact type of coal is not known."@en;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                     rdfs:label "lignite"@en;
                     cimdoc:enumCode 3 .
cim:FuelType.oil a owl:NamedIndividual,
                   cim:FuelType;
                 rdfs:comment "Oil."@en;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "oil"@en;
                 cimdoc:enumCode 1 .
cim:FuelType.oilShale a owl:NamedIndividual,
                        cim:FuelType;
                      rdfs:comment "Oil Shale."@en;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "oilShale"@en;
                      cimdoc:enumCode 5 .
cim:FuelType.other a owl:NamedIndividual,
                     cim:FuelType;
                   rdfs:comment "Any fuel type not included in the rest of the enumerated value."@en;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "other"@en;
                   cimdoc:enumCode 9 .
cim:FuelType.peat a owl:NamedIndividual,
                    cim:FuelType;
                  rdfs:comment "Peat."@en;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "peat"@en;
                  cimdoc:enumCode 8 .
cim:Fuse a owl:Class;
         rdfs:comment "An overcurrent protective device with a circuit opening fusible part that is heated and severed by the passage of overcurrent through it. A fuse is considered a switching device because it breaks current."@en;
         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
         rdfs:label "Fuse"@en;
         rdfs:subClassOf cim:Switch;
         cimdoc:cimPackage "IEC61970.Base.Wires";
         cimdoc:packageTier "Normative".
cim:Gate a owl:Class;
         rdfs:comment "Logical gate than support logical operation based on the input."@en;
         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
         rdfs:label "Gate"@en;
         rdfs:subClassOf cim:IdentifiedObject;
         cimdoc:cimPackage "IEC61970.InfIEC61970.InfSIPS";
         cimdoc:packageTier "Informative".
cim:Gate.GateInputPin a owl:ObjectProperty;
                      rdfs:comment "Input to the gate."@en;
                      rdfs:domain cim:Gate;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "GateInputPin"@en;
                      rdfs:range cim:GateInputPin.
cim:Gate.PinGate a owl:ObjectProperty;
                 rdfs:comment "The pin gate associated with this gate."@en;
                 rdfs:domain cim:Gate;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "PinGate"@en;
                 rdfs:range cim:PinGate.
cim:Gate.RemedialActionScheme a owl:ObjectProperty;
                              rdfs:comment "The remedial action scheme associated with this gate."@en;
                              rdfs:domain cim:Gate;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "RemedialActionScheme"@en;
                              rdfs:range cim:RemedialActionScheme.
cim:Gate.kind a owl:ObjectProperty;
              rdfs:comment "The logical operation of the gate."@en;
              rdfs:domain cim:Gate;
              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
              rdfs:label "kind"@en;
              rdfs:range cim:GateLogicKind.
cim:GateInputPin a owl:Class;
                 rdfs:comment "Input pin for a logical gate. The condition described in the input pin will give a logical true or false. Result from measurement and calculation are converted to a true or false."@en;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "GateInputPin"@en;
                 rdfs:subClassOf cim:IdentifiedObject;
                 cimdoc:cimPackage "IEC61970.InfIEC61970.InfSIPS";
                 cimdoc:packageTier "Informative".
cim:GateInputPin.aDLogicKind a owl:ObjectProperty;
                             rdfs:comment "The compare operation."@en;
                             rdfs:domain cim:GateInputPin;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "aDLogicKind"@en;
                             rdfs:range cim:AnalogToDigitalLogicKind.
cim:GateInputPin.absoluteValue a owl:DatatypeProperty;
                               rdfs:comment "If true, use the absolute value for compare.."@en;
                               rdfs:domain cim:GateInputPin;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "absoluteValue"@en;
                               rdfs:range xsd:boolean.
cim:GateInputPin.duration a owl:DatatypeProperty;
                          rdfs:comment "The duration the compare condition need to be present before given a true. Default is 0 seconds."@en;
                          rdfs:domain cim:GateInputPin;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                          rdfs:label "duration"@en;
                          rdfs:range cim:Seconds.
cim:GateInputPin.negate a owl:DatatypeProperty;
                        rdfs:comment "Invert/negate the result of the compare."@en;
                        rdfs:domain cim:GateInputPin;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                        rdfs:label "negate"@en;
                        rdfs:range xsd:boolean.
cim:GateInputPin.thresholdPercentage a owl:DatatypeProperty;
                                     rdfs:comment "The threshold percentage that should be used for compare with the percentage change between input value and threshold value."@en;
                                     rdfs:domain cim:GateInputPin;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                     rdfs:label "thresholdPercentage"@en;
                                     rdfs:range cim:PerCent.
cim:GateInputPin.thresholdValue a owl:DatatypeProperty;
                                rdfs:comment "The threshold value that should be used for compare with the input value."@en;
                                rdfs:domain cim:GateInputPin;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "thresholdValue"@en;
                                rdfs:range xsd:float.
cim:GateLogicKind a owl:Class;
                  rdfs:comment "Define the different logical operations."@en;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "GateLogicKind"@en;
                  owl:equivalentClass [a owl:Class ; 
                                       owl:oneOf (cim:GateLogicKind.and
                                                  cim:GateLogicKind.nand
                                                  cim:GateLogicKind.nor
                                                  cim:GateLogicKind.not
                                                  cim:GateLogicKind.or
                                                  cim:GateLogicKind.xnor
                                                  cim:GateLogicKind.xor)];
                  cimdoc:cimPackage "IEC61970.InfIEC61970.InfSIPS";
                  cimdoc:packageTier "Informative".
cim:GateLogicKind.and a owl:NamedIndividual,
                        cim:GateLogicKind;
                      rdfs:comment "A logical AND operation. True when all input are true."@en;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "and"@en;
                      cimdoc:enumCode 0 .
cim:GateLogicKind.nand a owl:NamedIndividual,
                         cim:GateLogicKind;
                       rdfs:comment "A logical NAND operation. False when all input are true."@en;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "nand"@en;
                       cimdoc:enumCode 3 .
cim:GateLogicKind.nor a owl:NamedIndividual,
                        cim:GateLogicKind;
                      rdfs:comment "A logical NOR operation. False when one or more input are true."@en;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "nor"@en;
                      cimdoc:enumCode 2 .
cim:GateLogicKind.not a owl:NamedIndividual,
                        cim:GateLogicKind;
                      rdfs:comment "A logical NOT operation. Only one input and true input will give false out and false in will give true out. An inverter."@en;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "not"@en;
                      cimdoc:enumCode 4 .
cim:GateLogicKind.or a owl:NamedIndividual,
                       cim:GateLogicKind;
                     rdfs:comment "A logical OR operation. True when one or more input are true."@en;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                     rdfs:label "or"@en;
                     cimdoc:enumCode 1 .
cim:GateLogicKind.xnor a owl:NamedIndividual,
                         cim:GateLogicKind;
                       rdfs:comment "A logical XNOR operation. The function is the inverse of the exclusive OR (XOR) gate. All input false or true will give true. Otherwise false."@en;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "xnor"@en;
                       cimdoc:enumCode 5 .
cim:GateLogicKind.xor a owl:NamedIndividual,
                        cim:GateLogicKind;
                      rdfs:comment "A logical XOR operation. All input false or true will give false. Otherwise true."@en;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "xor"@en;
                      cimdoc:enumCode 6 .
cim:GenUnitOpCostCurve a owl:Class;
                       rdfs:comment "Relationship between unit operating cost (Y-axis) and unit output active power (X-axis). The operating cost curve for thermal units is derived from heat input and fuel costs. The operating cost curve for hydro units is derived from water flow rates and equivalent water costs."@en;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "GenUnitOpCostCurve"@en;
                       rdfs:subClassOf cim:Curve;
                       cimdoc:cimPackage "IEC61970.Base.Generation.Production";
                       cimdoc:packageTier "Normative".
cim:GenUnitOpCostCurve.isNetGrossP a owl:DatatypeProperty;
                                   rdfs:comment "Flag is set to true when output is expressed in net active power."@en;
                                   rdfs:domain cim:GenUnitOpCostCurve;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                   rdfs:label "isNetGrossP"@en;
                                   rdfs:range xsd:boolean.
cim:GenUnitOpSchedule a owl:Class;
                      rdfs:comment "The generating unit's Operator-approved current operating schedule (or plan), typically produced with the aid of unit commitment type analyses. The X-axis represents absolute time. The Y1-axis represents the status (0=off-line and unavailable: 1=available: 2=must run: 3=must run at fixed power value: etc.). The Y2-axis represents the must run fixed power value where required."@en;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "GenUnitOpSchedule"@en;
                      rdfs:subClassOf cim:RegularIntervalSchedule;
                      cimdoc:cimPackage "IEC61970.Base.Generation.Production";
                      cimdoc:packageTier "Normative".
cim:GeneratingUnit a owl:Class;
                   rdfs:comment "A single or set of synchronous machines for converting mechanical power into alternating-current power. For example, individual machines within a set may be defined for scheduling purposes while a single control signal is derived for the set. In this case there would be a GeneratingUnit for each member of the set and an additional GeneratingUnit corresponding to the set."@en;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "GeneratingUnit"@en;
                   rdfs:subClassOf cim:Equipment;
                   cimdoc:cimPackage "IEC61970.Base.Generation.Production";
                   cimdoc:packageTier "Normative".
cim:GeneratingUnit.GenUnitOpCostCurves a owl:ObjectProperty;
                                       rdfs:comment "A generating unit may have one or more cost curves, depending upon fuel mixture and fuel cost."@en;
                                       rdfs:domain cim:GeneratingUnit;
                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                       rdfs:label "GenUnitOpCostCurves"@en;
                                       rdfs:range cim:GenUnitOpCostCurve.
cim:GeneratingUnit.GenUnitOpSchedule a owl:ObjectProperty;
                                     rdfs:comment "A generating unit may have an operating schedule, indicating the planned operation of the unit."@en;
                                     rdfs:domain cim:GeneratingUnit;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                     rdfs:label "GenUnitOpSchedule"@en;
                                     rdfs:range cim:GenUnitOpSchedule.
cim:GeneratingUnit.GrossToNetActivePowerCurves a owl:ObjectProperty;
                                               rdfs:comment "A generating unit may have a gross active power to net active power curve, describing the losses and auxiliary power requirements of the unit."@en;
                                               rdfs:domain cim:GeneratingUnit;
                                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                               rdfs:label "GrossToNetActivePowerCurves"@en;
                                               rdfs:range cim:GrossToNetActivePowerCurve.
cim:GeneratingUnit.RotatingMachine a owl:ObjectProperty;
                                   rdfs:comment "A synchronous machine may operate as a generator and as such becomes a member of a generating unit."@en;
                                   rdfs:domain cim:GeneratingUnit;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                   rdfs:label "RotatingMachine"@en;
                                   rdfs:range cim:RotatingMachine.
cim:GeneratingUnit.allocSpinResP a owl:DatatypeProperty;
                                 rdfs:comment "The planned unused capacity (spinning reserve) which can be used to support emergency load."@en;
                                 rdfs:domain cim:GeneratingUnit;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "allocSpinResP"@en;
                                 rdfs:range cim:ActivePower.
cim:GeneratingUnit.autoCntrlMarginP a owl:DatatypeProperty;
                                    rdfs:comment "The planned unused capacity which can be used to support automatic control overruns."@en;
                                    rdfs:domain cim:GeneratingUnit;
                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                    rdfs:label "autoCntrlMarginP"@en;
                                    rdfs:range cim:ActivePower.
cim:GeneratingUnit.baseP a owl:DatatypeProperty;
                         rdfs:comment "For dispatchable units, this value represents the economic active power basepoint, for units that are not dispatchable, this value represents the fixed generation value. The value shall be between the operating low and high limits."@en;
                         rdfs:domain cim:GeneratingUnit;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                         rdfs:label "baseP"@en;
                         rdfs:range cim:ActivePower.
cim:GeneratingUnit.controlDeadband a owl:DatatypeProperty;
                                   rdfs:comment "Unit control error deadband. When a unit's desired active power change is less than this deadband, then no control pulses will be sent to the unit."@en;
                                   rdfs:domain cim:GeneratingUnit;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                   rdfs:label "controlDeadband"@en;
                                   rdfs:range cim:ActivePower.
cim:GeneratingUnit.controlPulseHigh a owl:DatatypeProperty;
                                    rdfs:comment "Pulse high limit which is the largest control pulse that the unit can respond to."@en;
                                    rdfs:domain cim:GeneratingUnit;
                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                    rdfs:label "controlPulseHigh"@en;
                                    rdfs:range cim:Seconds.
cim:GeneratingUnit.controlPulseLow a owl:DatatypeProperty;
                                   rdfs:comment "Pulse low limit which is the smallest control pulse that the unit can respond to."@en;
                                   rdfs:domain cim:GeneratingUnit;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                   rdfs:label "controlPulseLow"@en;
                                   rdfs:range cim:Seconds.
cim:GeneratingUnit.controlResponseRate a owl:DatatypeProperty;
                                       rdfs:comment "Unit response rate which specifies the active power change for a control pulse of one second in the most responsive loading level of the unit."@en;
                                       rdfs:domain cim:GeneratingUnit;
                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                       rdfs:label "controlResponseRate"@en;
                                       rdfs:range cim:ActivePowerChangeRate.
cim:GeneratingUnit.efficiency a owl:DatatypeProperty;
                              rdfs:comment "The efficiency of the unit in converting mechanical energy, from the prime mover, into electrical energy."@en;
                              rdfs:domain cim:GeneratingUnit;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "efficiency"@en;
                              rdfs:range cim:PerCent.
cim:GeneratingUnit.genControlMode a owl:ObjectProperty;
                                  rdfs:comment "The unit control mode."@en;
                                  rdfs:domain cim:GeneratingUnit;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "genControlMode"@en;
                                  rdfs:range cim:GeneratorControlMode.
cim:GeneratingUnit.genControlSource a owl:ObjectProperty;
                                    rdfs:comment "The source of controls for a generating unit. Defines the control status of the generating unit."@en;
                                    rdfs:domain cim:GeneratingUnit;
                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                    rdfs:label "genControlSource"@en;
                                    rdfs:range cim:GeneratorControlSource.
cim:GeneratingUnit.governorMPL a owl:DatatypeProperty;
                               rdfs:comment "Governor motor position limit."@en;
                               rdfs:domain cim:GeneratingUnit;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "governorMPL"@en;
                               rdfs:range cim:PU.
cim:GeneratingUnit.governorSCD a owl:DatatypeProperty;
                               rdfs:comment "Governor Speed Changer Droop. This is the change in generator power output divided by the change in frequency normalized by the nominal power of the generator and the nominal frequency and expressed in percent and negated. A positive value of speed change droop provides additional generator output upon a drop in frequency."@en;
                               rdfs:domain cim:GeneratingUnit;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "governorSCD"@en;
                               rdfs:range cim:PerCent.
cim:GeneratingUnit.highControlLimit a owl:DatatypeProperty;
                                    rdfs:comment "High limit for secondary (AGC) control."@en;
                                    rdfs:domain cim:GeneratingUnit;
                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                    rdfs:label "highControlLimit"@en;
                                    rdfs:range cim:ActivePower.
cim:GeneratingUnit.initialP a owl:DatatypeProperty;
                            rdfs:comment "Default initial active power which is used to store a powerflow result for the initial active power for this unit in this network configuration."@en;
                            rdfs:domain cim:GeneratingUnit;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "initialP"@en;
                            rdfs:range cim:ActivePower.
cim:GeneratingUnit.longPF a owl:DatatypeProperty;
                          rdfs:comment "Generating unit long term economic participation factor."@en;
                          rdfs:domain cim:GeneratingUnit;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                          rdfs:label "longPF"@en;
                          rdfs:range xsd:float.
cim:GeneratingUnit.lowControlLimit a owl:DatatypeProperty;
                                   rdfs:comment "Low limit for secondary (AGC) control."@en;
                                   rdfs:domain cim:GeneratingUnit;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                   rdfs:label "lowControlLimit"@en;
                                   rdfs:range cim:ActivePower.
cim:GeneratingUnit.lowerRampRate a owl:DatatypeProperty;
                                 rdfs:comment "The normal maximum rate the generating unit active power output can be lowered by control actions."@en;
                                 rdfs:domain cim:GeneratingUnit;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "lowerRampRate"@en;
                                 rdfs:range cim:ActivePowerChangeRate.
cim:GeneratingUnit.maxEconomicP a owl:DatatypeProperty;
                                rdfs:comment "Maximum high economic active power limit, that should not exceed the maximum operating active power limit."@en;
                                rdfs:domain cim:GeneratingUnit;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "maxEconomicP"@en;
                                rdfs:range cim:ActivePower.
cim:GeneratingUnit.maxOperatingP a owl:DatatypeProperty;
                                 rdfs:comment "This is the maximum operating active power limit the dispatcher can enter for this unit."@en;
                                 rdfs:domain cim:GeneratingUnit;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "maxOperatingP"@en;
                                 rdfs:range cim:ActivePower.
cim:GeneratingUnit.maximumAllowableSpinningReserve a owl:DatatypeProperty;
                                                   rdfs:comment "Maximum allowable spinning reserve. Spinning reserve will never be considered greater than this value regardless of the current operating point."@en;
                                                   rdfs:domain cim:GeneratingUnit;
                                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                   rdfs:label "maximumAllowableSpinningReserve"@en;
                                                   rdfs:range cim:ActivePower.
cim:GeneratingUnit.minEconomicP a owl:DatatypeProperty;
                                rdfs:comment "Low economic active power limit that shall be greater than or equal to the minimum operating active power limit."@en;
                                rdfs:domain cim:GeneratingUnit;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "minEconomicP"@en;
                                rdfs:range cim:ActivePower.
cim:GeneratingUnit.minOperatingP a owl:DatatypeProperty;
                                 rdfs:comment "This is the minimum operating active power limit the dispatcher can enter for this unit."@en;
                                 rdfs:domain cim:GeneratingUnit;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "minOperatingP"@en;
                                 rdfs:range cim:ActivePower.
cim:GeneratingUnit.minimumOffTime a owl:DatatypeProperty;
                                  rdfs:comment "Minimum time interval between unit shutdown and startup."@en;
                                  rdfs:domain cim:GeneratingUnit;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "minimumOffTime"@en;
                                  rdfs:range cim:Seconds.
cim:GeneratingUnit.modelDetail a owl:DatatypeProperty;
                               rdfs:comment "Detail level of the generator model data."@en;
                               rdfs:domain cim:GeneratingUnit;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "modelDetail"@en;
                               rdfs:range cim:Classification.
cim:GeneratingUnit.nominalP a owl:DatatypeProperty;
                            rdfs:comment "The nominal power of the generating unit. Used to give precise meaning to percentage based attributes such as the governor speed change droop (governorSCD attribute). The attribute shall be a positive value equal to or less than RotatingMachine. ratedS."@en;
                            rdfs:domain cim:GeneratingUnit;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "nominalP"@en;
                            rdfs:range cim:ActivePower.
cim:GeneratingUnit.normalPF a owl:DatatypeProperty;
                            rdfs:comment "Generating unit economic participation factor. The sum of the participation factors across generating units does not have to sum to one. It is used for representing distributed slack participation factor. The attribute shall be a positive value or zero."@en;
                            rdfs:domain cim:GeneratingUnit;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "normalPF"@en;
                            rdfs:range xsd:float.
cim:GeneratingUnit.penaltyFactor a owl:DatatypeProperty;
                                 rdfs:comment "Defined as: 1 / ( 1 - Incremental Transmission Loss); with the Incremental Transmission Loss expressed as a plus or minus value. The typical range of penalty factors is (0.9 to 1.1)."@en;
                                 rdfs:domain cim:GeneratingUnit;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "penaltyFactor"@en;
                                 rdfs:range xsd:float.
cim:GeneratingUnit.raiseRampRate a owl:DatatypeProperty;
                                 rdfs:comment "The normal maximum rate the generating unit active power output can be raised by control actions."@en;
                                 rdfs:domain cim:GeneratingUnit;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "raiseRampRate"@en;
                                 rdfs:range cim:ActivePowerChangeRate.
cim:GeneratingUnit.ratedGrossMaxP a owl:DatatypeProperty;
                                  rdfs:comment "The unit's gross rated maximum capacity (book value). The attribute shall be a positive value."@en;
                                  rdfs:domain cim:GeneratingUnit;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "ratedGrossMaxP"@en;
                                  rdfs:range cim:ActivePower.
cim:GeneratingUnit.ratedGrossMinP a owl:DatatypeProperty;
                                  rdfs:comment "The gross rated minimum generation level which the unit can safely operate at while delivering power to the transmission grid. The attribute shall be a positive value."@en;
                                  rdfs:domain cim:GeneratingUnit;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "ratedGrossMinP"@en;
                                  rdfs:range cim:ActivePower.
cim:GeneratingUnit.ratedNetMaxP a owl:DatatypeProperty;
                                rdfs:comment "The net rated maximum capacity determined by subtracting the auxiliary power used to operate the internal plant machinery from the rated gross maximum capacity. The attribute shall be a positive value."@en;
                                rdfs:domain cim:GeneratingUnit;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "ratedNetMaxP"@en;
                                rdfs:range cim:ActivePower.
cim:GeneratingUnit.shortPF a owl:DatatypeProperty;
                           rdfs:comment "Generating unit short term economic participation factor."@en;
                           rdfs:domain cim:GeneratingUnit;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "shortPF"@en;
                           rdfs:range xsd:float.
cim:GeneratingUnit.startupCost a owl:DatatypeProperty;
                               rdfs:comment "The initial startup cost incurred for each start of the GeneratingUnit."@en;
                               rdfs:domain cim:GeneratingUnit;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "startupCost"@en;
                               rdfs:range cim:Money.
cim:GeneratingUnit.startupTime a owl:DatatypeProperty;
                               rdfs:comment "Time it takes to get the unit on-line, from the time that the prime mover mechanical power is applied."@en;
                               rdfs:domain cim:GeneratingUnit;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "startupTime"@en;
                               rdfs:range cim:Seconds.
cim:GeneratingUnit.tieLinePF a owl:DatatypeProperty;
                             rdfs:comment "Generating unit economic participation factor."@en;
                             rdfs:domain cim:GeneratingUnit;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "tieLinePF"@en;
                             rdfs:range xsd:float.
cim:GeneratingUnit.totalEfficiency a owl:DatatypeProperty;
                                   rdfs:comment "The efficiency of the unit in converting the fuel into electrical energy."@en;
                                   rdfs:domain cim:GeneratingUnit;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                   rdfs:label "totalEfficiency"@en;
                                   rdfs:range cim:PerCent.
cim:GeneratingUnit.variableCost a owl:DatatypeProperty;
                                rdfs:comment "The variable cost component of production per unit of ActivePower."@en;
                                rdfs:domain cim:GeneratingUnit;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "variableCost"@en;
                                rdfs:range cim:Money.
cim:GeneratorControlMode a owl:Class;
                         rdfs:comment "Unit control modes."@en;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                         rdfs:label "GeneratorControlMode"@en;
                         owl:equivalentClass [a owl:Class ; 
                                              owl:oneOf (cim:GeneratorControlMode.pulse
                                                         cim:GeneratorControlMode.setpoint)];
                         cimdoc:cimPackage "IEC61970.Base.Generation.Production";
                         cimdoc:packageTier "Normative".
cim:GeneratorControlMode.pulse a owl:NamedIndividual,
                                 cim:GeneratorControlMode;
                               rdfs:comment "Pulse control mode."@en;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "pulse"@en;
                               cimdoc:enumCode 1 .
cim:GeneratorControlMode.setpoint a owl:NamedIndividual,
                                    cim:GeneratorControlMode;
                                  rdfs:comment "Setpoint control mode."@en;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "setpoint"@en;
                                  cimdoc:enumCode 0 .
cim:GeneratorControlSource a owl:Class;
                           rdfs:comment "The source of controls for a generating unit."@en;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "GeneratorControlSource"@en;
                           owl:equivalentClass [a owl:Class ; 
                                                owl:oneOf (cim:GeneratorControlSource.offAGC
                                                           cim:GeneratorControlSource.onAGC
                                                           cim:GeneratorControlSource.plantControl
                                                           cim:GeneratorControlSource.unavailable)];
                           cimdoc:cimPackage "IEC61970.Base.Generation.Production";
                           cimdoc:packageTier "Normative".
cim:GeneratorControlSource.offAGC a owl:NamedIndividual,
                                    cim:GeneratorControlSource;
                                  rdfs:comment "Off of automatic generation control (AGC)."@en;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "offAGC"@en;
                                  cimdoc:enumCode 1 .
cim:GeneratorControlSource.onAGC a owl:NamedIndividual,
                                   cim:GeneratorControlSource;
                                 rdfs:comment "On automatic generation control (AGC)."@en;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "onAGC"@en;
                                 cimdoc:enumCode 2 .
cim:GeneratorControlSource.plantControl a owl:NamedIndividual,
                                          cim:GeneratorControlSource;
                                        rdfs:comment "Plant is controlling."@en;
                                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                        rdfs:label "plantControl"@en;
                                        cimdoc:enumCode 3 .
cim:GeneratorControlSource.unavailable a owl:NamedIndividual,
                                         cim:GeneratorControlSource;
                                       rdfs:comment "Not available."@en;
                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                       rdfs:label "unavailable"@en;
                                       cimdoc:enumCode 0 .
cim:GenericDataSetVersion a owl:Class;
                          rdfs:comment "Represents a version of a generic data set, including major and minor versioning details."@en;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                          rdfs:label "GenericDataSetVersion"@en;
                          cimdoc:cimPackage "IEC61970.InfIEC61970.Part303.GenericDataSet";
                          cimdoc:packageTier "Informative".
cim:GenericDataSetVersion.majorVersion a owl:DatatypeProperty;
                                       rdfs:comment "The universal CIM version name describing a consistent set of packages."@en;
                                       rdfs:domain cim:GenericDataSetVersion;
                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                       rdfs:label "majorVersion"@en;
                                       rdfs:range xsd:string.
cim:GenericDataSetVersion.minorVersion a owl:DatatypeProperty;
                                       rdfs:comment "Describes minor updates and error corrections."@en;
                                       rdfs:domain cim:GenericDataSetVersion;
                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                       rdfs:label "minorVersion"@en;
                                       rdfs:range xsd:string.
cim:GenericDataSetVersion.published a owl:DatatypeProperty;
                                    rdfs:comment "The date when the complete CIM canonical model is published and made available for use. After publication the major version and namespace are updated."@en;
                                    rdfs:domain cim:GenericDataSetVersion;
                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                    rdfs:label "published"@en;
                                    rdfs:range xsd:date.
cim:GenericNonLinearLoadModelKind a owl:Class;
                                  rdfs:comment "Type of generic non-linear load model."@en;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "GenericNonLinearLoadModelKind"@en;
                                  owl:equivalentClass [a owl:Class ; 
                                                       owl:oneOf (cim:GenericNonLinearLoadModelKind.exponentialRecovery
                                                                  cim:GenericNonLinearLoadModelKind.loadAdaptive)];
                                  cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.LoadDynamics";
                                  cimdoc:packageTier "Normative".
cim:GenericNonLinearLoadModelKind.exponentialRecovery a owl:NamedIndividual,
                                                        cim:GenericNonLinearLoadModelKind;
                                                      rdfs:comment "Exponential recovery model."@en;
                                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                      rdfs:label "exponentialRecovery"@en;
                                                      cimdoc:enumCode 0 .
cim:GenericNonLinearLoadModelKind.loadAdaptive a owl:NamedIndividual,
                                                 cim:GenericNonLinearLoadModelKind;
                                               rdfs:comment "Load adaptive model."@en;
                                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                               rdfs:label "loadAdaptive"@en;
                                               cimdoc:enumCode 1 .
cim:GeographicalRegion a owl:Class;
                       rdfs:comment "A geographical region of a power system network model."@en;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "GeographicalRegion"@en;
                       rdfs:subClassOf cim:IdentifiedObject;
                       cimdoc:cimPackage "IEC61970.Base.Core";
                       cimdoc:packageTier "Normative".
cim:GeographicalRegion.Regions a owl:ObjectProperty;
                               rdfs:comment "All sub-geographical regions within this geographical region."@en;
                               rdfs:domain cim:GeographicalRegion;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "Regions"@en;
                               rdfs:range cim:SubGeographicalRegion.
cim:GovCT1 a owl:Class;
           rdfs:comment "General model for any prime mover with a PID governor, used primarily for combustion turbine and combined cycle units. This model can be used to represent a variety of prime movers controlled by PID governors. It is suitable, for example, for the representation of: - gas turbine and single shaft combined cycle turbines; - diesel engines with modern electronic or digital governors; - steam turbines where steam is supplied from a large boiler drum or a large header whose pressure is substantially constant over the period under study; - simple hydro turbines in dam configurations where the water column length is short and water inertia effects are minimal. Additional information on this model is available in the 2012 IEEE report, Dynamic Models for Turbine-Governors in Power System Studies, 3.1. 2.3 pages 3-4 (GGOV1)."@en;
           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
           rdfs:label "GovCT1"@en;
           rdfs:subClassOf cim:TurbineGovernorDynamics;
           cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.TurbineGovernorDynamics";
           cimdoc:packageTier "Normative".
cim:GovCT1.aset a owl:DatatypeProperty;
                rdfs:comment "Acceleration limiter setpoint (Aset). Unit = PU / s. Typical value = 0, 01."@en;
                rdfs:domain cim:GovCT1;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "aset"@en;
                rdfs:range xsd:float.
cim:GovCT1.db a owl:DatatypeProperty;
              rdfs:comment "Speed governor deadband in PU speed (db). In the majority of applications, it is recommended that this value be set to zero. Typical value = 0."@en;
              rdfs:domain cim:GovCT1;
              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
              rdfs:label "db"@en;
              rdfs:range cim:PU.
cim:GovCT1.dm a owl:DatatypeProperty;
              rdfs:comment "Speed sensitivity coefficient (Dm). Dm can represent either the variation of the engine power with the shaft speed or the variation of maximum power capability with shaft speed. If it is positive it describes the falling slope of the engine speed verses power characteristic as speed increases. A slightly falling characteristic is typical for reciprocating engines and some aero-derivative turbines. If it is negative the engine power is assumed to be unaffected by the shaft speed, but the maximum permissible fuel flow is taken to fall with falling shaft speed. This is characteristic of single-shaft industrial turbines due to exhaust temperature limits. Typical value = 0."@en;
              rdfs:domain cim:GovCT1;
              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
              rdfs:label "dm"@en;
              rdfs:range cim:PU.
cim:GovCT1.ka a owl:DatatypeProperty;
              rdfs:comment "Acceleration limiter gain (Ka). Typical value = 10."@en;
              rdfs:domain cim:GovCT1;
              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
              rdfs:label "ka"@en;
              rdfs:range cim:PU.
cim:GovCT1.kdgov a owl:DatatypeProperty;
                 rdfs:comment "Governor derivative gain (Kdgov). Typical value = 0."@en;
                 rdfs:domain cim:GovCT1;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "kdgov"@en;
                 rdfs:range cim:PU.
cim:GovCT1.kigov a owl:DatatypeProperty;
                 rdfs:comment "Governor integral gain (Kigov). Typical value = 2."@en;
                 rdfs:domain cim:GovCT1;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "kigov"@en;
                 rdfs:range cim:PU.
cim:GovCT1.kiload a owl:DatatypeProperty;
                  rdfs:comment "Load limiter integral gain for PI controller (Kiload). Typical value = 0,67."@en;
                  rdfs:domain cim:GovCT1;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "kiload"@en;
                  rdfs:range cim:PU.
cim:GovCT1.kimw a owl:DatatypeProperty;
                rdfs:comment "Power controller (reset) gain (Kimw). The default value of 0,01 corresponds to a reset time of 100 s. A value of 0,001 corresponds to a relatively slow-acting load controller. Typical value = 0,01."@en;
                rdfs:domain cim:GovCT1;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "kimw"@en;
                rdfs:range cim:PU.
cim:GovCT1.kpgov a owl:DatatypeProperty;
                 rdfs:comment "Governor proportional gain (Kpgov). Typical value = 10."@en;
                 rdfs:domain cim:GovCT1;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "kpgov"@en;
                 rdfs:range cim:PU.
cim:GovCT1.kpload a owl:DatatypeProperty;
                  rdfs:comment "Load limiter proportional gain for PI controller (Kpload). Typical value = 2."@en;
                  rdfs:domain cim:GovCT1;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "kpload"@en;
                  rdfs:range cim:PU.
cim:GovCT1.kturb a owl:DatatypeProperty;
                 rdfs:comment "Turbine gain (Kturb) (> 0). Typical value = 1,5."@en;
                 rdfs:domain cim:GovCT1;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "kturb"@en;
                 rdfs:range cim:PU.
cim:GovCT1.ldref a owl:DatatypeProperty;
                 rdfs:comment "Load limiter reference value (Ldref). Typical value = 1."@en;
                 rdfs:domain cim:GovCT1;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "ldref"@en;
                 rdfs:range cim:PU.
cim:GovCT1.maxerr a owl:DatatypeProperty;
                  rdfs:comment "Maximum value for speed error signal (maxerr) (greater than GovCT1.minerr). Typical value = 0,05."@en;
                  rdfs:domain cim:GovCT1;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "maxerr"@en;
                  rdfs:range cim:PU.
cim:GovCT1.minerr a owl:DatatypeProperty;
                  rdfs:comment "Minimum value for speed error signal (minerr) (less than GovCT1.maxerr). Typical value = -0,05."@en;
                  rdfs:domain cim:GovCT1;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "minerr"@en;
                  rdfs:range cim:PU.
cim:GovCT1.mwbase a owl:DatatypeProperty;
                  rdfs:comment "Base for power values (MWbase) (> 0). Unit = MW."@en;
                  rdfs:domain cim:GovCT1;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "mwbase"@en;
                  rdfs:range cim:ActivePower.
cim:GovCT1.r a owl:DatatypeProperty;
             rdfs:comment "Permanent droop (R). Typical value = 0,04."@en;
             rdfs:domain cim:GovCT1;
             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
             rdfs:label "r"@en;
             rdfs:range cim:PU.
cim:GovCT1.rclose a owl:DatatypeProperty;
                  rdfs:comment "Minimum valve closing rate (Rclose). Unit = PU / s. Typical value = -0, 1."@en;
                  rdfs:domain cim:GovCT1;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "rclose"@en;
                  rdfs:range xsd:float.
cim:GovCT1.rdown a owl:DatatypeProperty;
                 rdfs:comment "Maximum rate of load limit decrease (Rdown). Typical value = -99."@en;
                 rdfs:domain cim:GovCT1;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "rdown"@en;
                 rdfs:range cim:PU.
cim:GovCT1.ropen a owl:DatatypeProperty;
                 rdfs:comment "Maximum valve opening rate (Ropen). Unit = PU / s. Typical value = 0. 10."@en;
                 rdfs:domain cim:GovCT1;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "ropen"@en;
                 rdfs:range xsd:float.
cim:GovCT1.rselect a owl:ObjectProperty;
                   rdfs:comment "Feedback signal for droop (Rselect). Typical value = electricalPower."@en;
                   rdfs:domain cim:GovCT1;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "rselect"@en;
                   rdfs:range cim:DroopSignalFeedbackKind.
cim:GovCT1.rup a owl:DatatypeProperty;
               rdfs:comment "Maximum rate of load limit increase (Rup). Typical value = 99."@en;
               rdfs:domain cim:GovCT1;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "rup"@en;
               rdfs:range cim:PU.
cim:GovCT1.ta a owl:DatatypeProperty;
              rdfs:comment "Acceleration limiter time constant (Ta) (> 0). Typical value = 0,1."@en;
              rdfs:domain cim:GovCT1;
              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
              rdfs:label "ta"@en;
              rdfs:range cim:Seconds.
cim:GovCT1.tact a owl:DatatypeProperty;
                rdfs:comment "Actuator time constant (Tact) (>= 0). Typical value = 0,5."@en;
                rdfs:domain cim:GovCT1;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "tact"@en;
                rdfs:range cim:Seconds.
cim:GovCT1.tb a owl:DatatypeProperty;
              rdfs:comment "Turbine lag time constant (Tb) (> 0). Typical value = 0,5."@en;
              rdfs:domain cim:GovCT1;
              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
              rdfs:label "tb"@en;
              rdfs:range cim:Seconds.
cim:GovCT1.tc a owl:DatatypeProperty;
              rdfs:comment "Turbine lead time constant (Tc) (>= 0). Typical value = 0."@en;
              rdfs:domain cim:GovCT1;
              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
              rdfs:label "tc"@en;
              rdfs:range cim:Seconds.
cim:GovCT1.tdgov a owl:DatatypeProperty;
                 rdfs:comment "Governor derivative controller time constant (Tdgov) (>= 0). Typical value = 1."@en;
                 rdfs:domain cim:GovCT1;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "tdgov"@en;
                 rdfs:range cim:Seconds.
cim:GovCT1.teng a owl:DatatypeProperty;
                rdfs:comment "Transport time delay for diesel engine used in representing diesel engines where there is a small but measurable transport delay between a change in fuel flow setting and the development of torque (Teng) (>= 0). Teng should be zero in all but special cases where this transport delay is of particular concern. Typical value = 0."@en;
                rdfs:domain cim:GovCT1;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "teng"@en;
                rdfs:range cim:Seconds.
cim:GovCT1.tfload a owl:DatatypeProperty;
                  rdfs:comment "Load-limiter time constant (Tfload) (> 0). Typical value = 3."@en;
                  rdfs:domain cim:GovCT1;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "tfload"@en;
                  rdfs:range cim:Seconds.
cim:GovCT1.tpelec a owl:DatatypeProperty;
                  rdfs:comment "Electrical power transducer time constant (Tpelec) (> 0). Typical value = 1."@en;
                  rdfs:domain cim:GovCT1;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "tpelec"@en;
                  rdfs:range cim:Seconds.
cim:GovCT1.tsa a owl:DatatypeProperty;
               rdfs:comment "Temperature detection lead time constant (Tsa) (>= 0). Typical value = 4."@en;
               rdfs:domain cim:GovCT1;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "tsa"@en;
               rdfs:range cim:Seconds.
cim:GovCT1.tsb a owl:DatatypeProperty;
               rdfs:comment "Temperature detection lag time constant (Tsb) (>= 0). Typical value = 5."@en;
               rdfs:domain cim:GovCT1;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "tsb"@en;
               rdfs:range cim:Seconds.
cim:GovCT1.vmax a owl:DatatypeProperty;
                rdfs:comment "Maximum valve position limit (Vmax) (greater than GovCT1.vmin). Typical value = 1."@en;
                rdfs:domain cim:GovCT1;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "vmax"@en;
                rdfs:range cim:PU.
cim:GovCT1.vmin a owl:DatatypeProperty;
                rdfs:comment "Minimum valve position limit (Vmin) (less than GovCT1.vmax). Typical value = 0, 15."@en;
                rdfs:domain cim:GovCT1;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "vmin"@en;
                rdfs:range cim:PU.
cim:GovCT1.wfnl a owl:DatatypeProperty;
                rdfs:comment "No load fuel flow (Wfnl). Typical value = 0,2."@en;
                rdfs:domain cim:GovCT1;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "wfnl"@en;
                rdfs:range cim:PU.
cim:GovCT1.wfspd a owl:DatatypeProperty;
                 rdfs:comment "Switch for fuel source characteristic to recognize that fuel flow, for a given fuel valve stroke, can be proportional to engine speed (Wfspd). true = fuel flow proportional to speed (for some gas turbines and diesel engines with positive displacement fuel injectors) false = fuel control system keeps fuel flow independent of engine speed. Typical value = true."@en;
                 rdfs:domain cim:GovCT1;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "wfspd"@en;
                 rdfs:range xsd:boolean.
cim:GovCT2 a owl:Class;
           rdfs:comment "General governor with frequency-dependent fuel flow limit. This model is a modification of the GovCT1 model in order to represent the frequency- dependent fuel flow limit of a specific gas turbine manufacturer."@en;
           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
           rdfs:label "GovCT2"@en;
           rdfs:subClassOf cim:TurbineGovernorDynamics;
           cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.TurbineGovernorDynamics";
           cimdoc:packageTier "Normative".
cim:GovCT2.aset a owl:DatatypeProperty;
                rdfs:comment "Acceleration limiter setpoint (Aset). Unit = PU / s. Typical value = 10."@en;
                rdfs:domain cim:GovCT2;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "aset"@en;
                rdfs:range xsd:float.
cim:GovCT2.db a owl:DatatypeProperty;
              rdfs:comment "Speed governor deadband in PU speed (db). In the majority of applications, it is recommended that this value be set to zero. Typical value = 0."@en;
              rdfs:domain cim:GovCT2;
              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
              rdfs:label "db"@en;
              rdfs:range cim:PU.
cim:GovCT2.dm a owl:DatatypeProperty;
              rdfs:comment "Speed sensitivity coefficient (Dm). Dm can represent either the variation of the engine power with the shaft speed or the variation of maximum power capability with shaft speed. If it is positive it describes the falling slope of the engine speed verses power characteristic as speed increases. A slightly falling characteristic is typical for reciprocating engines and some aero-derivative turbines. If it is negative the engine power is assumed to be unaffected by the shaft speed, but the maximum permissible fuel flow is taken to fall with falling shaft speed. This is characteristic of single-shaft industrial turbines due to exhaust temperature limits. Typical value = 0."@en;
              rdfs:domain cim:GovCT2;
              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
              rdfs:label "dm"@en;
              rdfs:range cim:PU.
cim:GovCT2.flim1 a owl:DatatypeProperty;
                 rdfs:comment "Frequency threshold 1 (Flim1). Unit = Hz. Typical value = 59."@en;
                 rdfs:domain cim:GovCT2;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "flim1"@en;
                 rdfs:range cim:Frequency.
cim:GovCT2.flim10 a owl:DatatypeProperty;
                  rdfs:comment "Frequency threshold 10 (Flim10). Unit = Hz. Typical value = 0."@en;
                  rdfs:domain cim:GovCT2;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "flim10"@en;
                  rdfs:range cim:Frequency.
cim:GovCT2.flim2 a owl:DatatypeProperty;
                 rdfs:comment "Frequency threshold 2 (Flim2). Unit = Hz. Typical value = 0."@en;
                 rdfs:domain cim:GovCT2;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "flim2"@en;
                 rdfs:range cim:Frequency.
cim:GovCT2.flim3 a owl:DatatypeProperty;
                 rdfs:comment "Frequency threshold 3 (Flim3). Unit = Hz. Typical value = 0."@en;
                 rdfs:domain cim:GovCT2;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "flim3"@en;
                 rdfs:range cim:Frequency.
cim:GovCT2.flim4 a owl:DatatypeProperty;
                 rdfs:comment "Frequency threshold 4 (Flim4). Unit = Hz. Typical value = 0."@en;
                 rdfs:domain cim:GovCT2;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "flim4"@en;
                 rdfs:range cim:Frequency.
cim:GovCT2.flim5 a owl:DatatypeProperty;
                 rdfs:comment "Frequency threshold 5 (Flim5). Unit = Hz. Typical value = 0."@en;
                 rdfs:domain cim:GovCT2;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "flim5"@en;
                 rdfs:range cim:Frequency.
cim:GovCT2.flim6 a owl:DatatypeProperty;
                 rdfs:comment "Frequency threshold 6 (Flim6). Unit = Hz. Typical value = 0."@en;
                 rdfs:domain cim:GovCT2;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "flim6"@en;
                 rdfs:range cim:Frequency.
cim:GovCT2.flim7 a owl:DatatypeProperty;
                 rdfs:comment "Frequency threshold 7 (Flim7). Unit = Hz. Typical value = 0."@en;
                 rdfs:domain cim:GovCT2;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "flim7"@en;
                 rdfs:range cim:Frequency.
cim:GovCT2.flim8 a owl:DatatypeProperty;
                 rdfs:comment "Frequency threshold 8 (Flim8). Unit = Hz. Typical value = 0."@en;
                 rdfs:domain cim:GovCT2;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "flim8"@en;
                 rdfs:range cim:Frequency.
cim:GovCT2.flim9 a owl:DatatypeProperty;
                 rdfs:comment "Frequency threshold 9 (Flim9). Unit = Hz. Typical value = 0."@en;
                 rdfs:domain cim:GovCT2;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "flim9"@en;
                 rdfs:range cim:Frequency.
cim:GovCT2.ka a owl:DatatypeProperty;
              rdfs:comment "Acceleration limiter gain (Ka). Typical value = 10."@en;
              rdfs:domain cim:GovCT2;
              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
              rdfs:label "ka"@en;
              rdfs:range cim:PU.
cim:GovCT2.kdgov a owl:DatatypeProperty;
                 rdfs:comment "Governor derivative gain (Kdgov). Typical value = 0."@en;
                 rdfs:domain cim:GovCT2;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "kdgov"@en;
                 rdfs:range cim:PU.
cim:GovCT2.kigov a owl:DatatypeProperty;
                 rdfs:comment "Governor integral gain (Kigov). Typical value = 0,45."@en;
                 rdfs:domain cim:GovCT2;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "kigov"@en;
                 rdfs:range cim:PU.
cim:GovCT2.kiload a owl:DatatypeProperty;
                  rdfs:comment "Load limiter integral gain for PI controller (Kiload). Typical value = 1."@en;
                  rdfs:domain cim:GovCT2;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "kiload"@en;
                  rdfs:range cim:PU.
cim:GovCT2.kimw a owl:DatatypeProperty;
                rdfs:comment "Power controller (reset) gain (Kimw). The default value of 0,01 corresponds to a reset time of 100 seconds. A value of 0,001 corresponds to a relatively slow-acting load controller. Typical value = 0."@en;
                rdfs:domain cim:GovCT2;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "kimw"@en;
                rdfs:range cim:PU.
cim:GovCT2.kpgov a owl:DatatypeProperty;
                 rdfs:comment "Governor proportional gain (Kpgov). Typical value = 4."@en;
                 rdfs:domain cim:GovCT2;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "kpgov"@en;
                 rdfs:range cim:PU.
cim:GovCT2.kpload a owl:DatatypeProperty;
                  rdfs:comment "Load limiter proportional gain for PI controller (Kpload). Typical value = 1."@en;
                  rdfs:domain cim:GovCT2;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "kpload"@en;
                  rdfs:range cim:PU.
cim:GovCT2.kturb a owl:DatatypeProperty;
                 rdfs:comment "Turbine gain (Kturb). Typical value = 1,9168."@en;
                 rdfs:domain cim:GovCT2;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "kturb"@en;
