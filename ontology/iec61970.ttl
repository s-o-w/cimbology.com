cim:UnderexcLimIEEE1.tu4 a owl:DatatypeProperty;
                         rdfs:comment "UEL lag time constant (TU4) (>= 0). Typical value = 0."@en;
                         rdfs:domain cim:UnderexcLimIEEE1;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
