                      cimdoc:packageTier "Normative".
cim:RemoteInputSignal.Terminal a owl:ObjectProperty;
                               rdfs:comment "Remote terminal with which this input signal is associated."@en;
                               rdfs:domain cim:RemoteInputSignal;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "Terminal"@en;
