cim:HydroEnergyConversionKind a owl:Class;
                              rdfs:comment "Specifies the capability of the hydro generating unit to convert energy as a generator or pump."@en;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "HydroEnergyConversionKind"@en;
                              owl:equivalentClass [a owl:Class ; 
                                                   owl:oneOf (cim:HydroEnergyConversionKind.generator
                                                              cim:HydroEnergyConversionKind.pumpAndGenerator)];
                              cimdoc:cimPackage "IEC61970.Base.Generation.Production";
                              cimdoc:packageTier "Normative".
cim:HydroEnergyConversionKind.generator a owl:NamedIndividual,
                                          cim:HydroEnergyConversionKind;
                                        rdfs:comment "Able to generate power, but not able to pump water for energy storage."@en;
                                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                        rdfs:label "generator"@en;
                                        cimdoc:enumCode 0 .
cim:HydroEnergyConversionKind.pumpAndGenerator a owl:NamedIndividual,
                                                 cim:HydroEnergyConversionKind;
                                               rdfs:comment "Able to both generate power and pump water for energy storage."@en;
                                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                               rdfs:label "pumpAndGenerator"@en;
                                               cimdoc:enumCode 1 .
cim:HydroGeneratingEfficiencyCurve a owl:Class;
                                   rdfs:comment "Relationship between unit efficiency as percentage and unit output active power for a given net head in meters. The relationship between efficiency, discharge, head, and power output is expressed as follows: E =KP/HQ where: E is the efficiency, as a percentage; P is the active power; H is the height; Q is the discharge, volume/time unit; K is a constant. For example, a curve instance for a given net head could show efficiency (Y- axis) versus active power output (X-axis) or versus discharge on the X-axis."@en;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                   rdfs:label "HydroGeneratingEfficiencyCurve"@en;
                                   rdfs:subClassOf cim:Curve;
                                   cimdoc:cimPackage "IEC61970.Base.Generation.Production";
                                   cimdoc:packageTier "Normative".
cim:HydroGeneratingUnit a owl:Class;
                        rdfs:comment "A generating unit whose prime mover is a hydraulic turbine (e.g., Francis, Pelton, Kaplan)."@en;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                        rdfs:label "HydroGeneratingUnit"@en;
                        rdfs:subClassOf cim:GeneratingUnit;
                        cimdoc:cimPackage "IEC61970.Base.Generation.Production";
                        cimdoc:packageTier "Normative".
cim:HydroGeneratingUnit.HydroGeneratingEfficiencyCurves a owl:ObjectProperty;
