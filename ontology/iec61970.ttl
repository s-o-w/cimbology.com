cim:WindProtectionIEC.fover a owl:DatatypeProperty;
                            rdfs:comment "Wind turbine over frequency protection activation threshold (fover). It is a project-dependent parameter."@en;
                            rdfs:domain cim:WindProtectionIEC;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "fover"@en;
                            rdfs:range cim:PU.
cim:WindProtectionIEC.funder a owl:DatatypeProperty;
