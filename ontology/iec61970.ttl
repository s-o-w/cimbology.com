                  rdfs:label "vilim"@en;
                  rdfs:range xsd:boolean.
cim:ExcST6B.vimax a owl:DatatypeProperty;
                  rdfs:comment "Maximum voltage regulator input limit (Vimax) (greater than ExcST6B.vimin). Typical value = 10."@en;
                  rdfs:domain cim:ExcST6B;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "vimax"@en;
                  rdfs:range cim:PU.
cim:ExcST6B.vimin a owl:DatatypeProperty;
                  rdfs:comment "Minimum voltage regulator input limit (Vimin) (less than ExcST6B.vimax). Typical value = -10."@en;
                  rdfs:domain cim:ExcST6B;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "vimin"@en;
                  rdfs:range cim:PU.
cim:ExcST6B.vmult a owl:DatatypeProperty;
                  rdfs:comment "Selector (vmult). true = multiply regulator output by terminal voltage false = do not multiply regulator output by terminal voltage. Typical value = true."@en;
                  rdfs:domain cim:ExcST6B;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "vmult"@en;
                  rdfs:range xsd:boolean.
cim:ExcST6B.vrmax a owl:DatatypeProperty;
                  rdfs:comment "Maximum voltage regulator output (Vrmax) (greater than 0). Typical value = 4,81."@en;
                  rdfs:domain cim:ExcST6B;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "vrmax"@en;
                  rdfs:range cim:PU.
cim:ExcST6B.vrmin a owl:DatatypeProperty;
                  rdfs:comment "Minimum voltage regulator output (Vrmin) (less than 0). Typical value = -3,85."@en;
                  rdfs:domain cim:ExcST6B;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "vrmin"@en;
                  rdfs:range cim:PU.
cim:ExcST6B.xc a owl:DatatypeProperty;
               rdfs:comment "Excitation source reactance (Xc). Typical value = 0,05."@en;
               rdfs:domain cim:ExcST6B;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "xc"@en;
               rdfs:range cim:PU.
cim:ExcST6BOELselectorKind a owl:Class;
                           rdfs:comment "Types of connections for the OEL input used for static excitation systems type 6B."@en;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "ExcST6BOELselectorKind"@en;
                           owl:equivalentClass [a owl:Class ; 
                                                owl:oneOf (cim:ExcST6BOELselectorKind.afterUEL
                                                           cim:ExcST6BOELselectorKind.beforeUEL
                                                           cim:ExcST6BOELselectorKind.noOELinput)];
                           cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.ExcitationSystemDynamics";
                           cimdoc:packageTier "Normative".
cim:ExcST6BOELselectorKind.afterUEL a owl:NamedIndividual,
                                      cim:ExcST6BOELselectorKind;
                                    rdfs:comment "The connection is after UEL. Corresponds to OELin = 2 on the ExcST6B diagram."@en;
                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                    rdfs:label "afterUEL"@en;
                                    cimdoc:enumCode 2 .
cim:ExcST6BOELselectorKind.beforeUEL a owl:NamedIndividual,
                                       cim:ExcST6BOELselectorKind;
                                     rdfs:comment "The connection is before UEL. Corresponds to OELin = 1 on the ExcST6B diagram."@en;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                     rdfs:label "beforeUEL"@en;
                                     cimdoc:enumCode 1 .
cim:ExcST6BOELselectorKind.noOELinput a owl:NamedIndividual,
                                        cim:ExcST6BOELselectorKind;
                                      rdfs:comment "No OEL input is used. Corresponds to OELin not = 1 and not = 2 on the ExcST6B diagram. Original ExcST6B model would have called this OELin = 0."@en;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                      rdfs:label "noOELinput"@en;
                                      cimdoc:enumCode 0 .
cim:ExcST7B a owl:Class;
            rdfs:comment "Modified IEEE ST7B static excitation system without stator current limiter (SCL) and current compensator (DROOP) inputs."@en;
            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
            rdfs:label "ExcST7B"@en;
            rdfs:subClassOf cim:ExcitationSystemDynamics;
            cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.ExcitationSystemDynamics";
            cimdoc:packageTier "Normative".
cim:ExcST7B.kh a owl:DatatypeProperty;
               rdfs:comment "High-value gate feedback gain (Kh) (>= 0). Typical value = 1."@en;
               rdfs:domain cim:ExcST7B;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "kh"@en;
               rdfs:range cim:PU.
cim:ExcST7B.kia a owl:DatatypeProperty;
                rdfs:comment "Voltage regulator integral gain (Kia) (>= 0). Typical value = 1."@en;
                rdfs:domain cim:ExcST7B;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "kia"@en;
                rdfs:range cim:PU.
cim:ExcST7B.kl a owl:DatatypeProperty;
               rdfs:comment "Low-value gate feedback gain (Kl) (>= 0). Typical value = 1."@en;
               rdfs:domain cim:ExcST7B;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "kl"@en;
               rdfs:range cim:PU.
cim:ExcST7B.kpa a owl:DatatypeProperty;
                rdfs:comment "Voltage regulator proportional gain (Kpa) (> 0). Typical value = 40."@en;
                rdfs:domain cim:ExcST7B;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "kpa"@en;
                rdfs:range cim:PU.
cim:ExcST7B.oelin a owl:ObjectProperty;
                  rdfs:comment "OEL input selector (OELin). Typical value = noOELinput."@en;
                  rdfs:domain cim:ExcST7B;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "oelin"@en;
                  rdfs:range cim:ExcST7BOELselectorKind.
cim:ExcST7B.tb a owl:DatatypeProperty;
               rdfs:comment "Regulator lag time constant (Tb) (>= 0). Typical value = 1."@en;
               rdfs:domain cim:ExcST7B;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "tb"@en;
               rdfs:range cim:Seconds.
cim:ExcST7B.tc a owl:DatatypeProperty;
               rdfs:comment "Regulator lead time constant (Tc) (>= 0). Typical value = 1."@en;
               rdfs:domain cim:ExcST7B;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "tc"@en;
               rdfs:range cim:Seconds.
cim:ExcST7B.tf a owl:DatatypeProperty;
               rdfs:comment "Excitation control system stabilizer time constant (Tf) (>= 0). Typical value = 1."@en;
               rdfs:domain cim:ExcST7B;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "tf"@en;
               rdfs:range cim:Seconds.
cim:ExcST7B.tg a owl:DatatypeProperty;
               rdfs:comment "Feedback time constant of inner loop field voltage regulator (Tg) (>= 0). Typical value = 1."@en;
               rdfs:domain cim:ExcST7B;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "tg"@en;
               rdfs:range cim:Seconds.
cim:ExcST7B.tia a owl:DatatypeProperty;
                rdfs:comment "Feedback time constant (Tia) (>= 0). Typical value = 3."@en;
                rdfs:domain cim:ExcST7B;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "tia"@en;
                rdfs:range cim:Seconds.
cim:ExcST7B.ts a owl:DatatypeProperty;
               rdfs:comment "Rectifier firing time constant (Ts) (>= 0). Typical value = 0."@en;
               rdfs:domain cim:ExcST7B;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "ts"@en;
               rdfs:range cim:Seconds.
cim:ExcST7B.uelin a owl:ObjectProperty;
                  rdfs:comment "UEL input selector (UELin). Typical value = noUELinput."@en;
                  rdfs:domain cim:ExcST7B;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "uelin"@en;
                  rdfs:range cim:ExcST7BUELselectorKind.
cim:ExcST7B.vmax a owl:DatatypeProperty;
                 rdfs:comment "Maximum voltage reference signal (Vmax) (> 0 and > ExcST7B.vmin)). Typical value = 1,1."@en;
                 rdfs:domain cim:ExcST7B;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "vmax"@en;
                 rdfs:range cim:PU.
cim:ExcST7B.vmin a owl:DatatypeProperty;
                 rdfs:comment "Minimum voltage reference signal (Vmin) (greater than 0 and less than ExcST7B.vmax). Typical value = 0,9."@en;
                 rdfs:domain cim:ExcST7B;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "vmin"@en;
                 rdfs:range cim:PU.
cim:ExcST7B.vrmax a owl:DatatypeProperty;
                  rdfs:comment "Maximum voltage regulator output (Vrmax) (> 0). Typical value = 5."@en;
                  rdfs:domain cim:ExcST7B;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "vrmax"@en;
                  rdfs:range cim:PU.
cim:ExcST7B.vrmin a owl:DatatypeProperty;
                  rdfs:comment "Minimum voltage regulator output (Vrmin) (less than 0). Typical value = -4,5."@en;
                  rdfs:domain cim:ExcST7B;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "vrmin"@en;
                  rdfs:range cim:PU.
cim:ExcST7BOELselectorKind a owl:Class;
                           rdfs:comment "Types of connections for the OEL input used for static excitation systems type 7B."@en;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "ExcST7BOELselectorKind"@en;
                           owl:equivalentClass [a owl:Class ; 
                                                owl:oneOf (cim:ExcST7BOELselectorKind.addVref
                                                           cim:ExcST7BOELselectorKind.inputLVgate
                                                           cim:ExcST7BOELselectorKind.noOELinput
                                                           cim:ExcST7BOELselectorKind.outputLVgate)];
                           cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.ExcitationSystemDynamics";
                           cimdoc:packageTier "Normative".
cim:ExcST7BOELselectorKind.addVref a owl:NamedIndividual,
                                     cim:ExcST7BOELselectorKind;
                                   rdfs:comment "The signal is added to Vref. Corresponds to OELin = 1 on the ExcST7B diagram."@en;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                   rdfs:label "addVref"@en;
                                   cimdoc:enumCode 1 .
cim:ExcST7BOELselectorKind.inputLVgate a owl:NamedIndividual,
                                         cim:ExcST7BOELselectorKind;
                                       rdfs:comment "The signal is connected into the input LVGate. Corresponds to OELin = 2 on the ExcST7B diagram."@en;
                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                       rdfs:label "inputLVgate"@en;
                                       cimdoc:enumCode 2 .
cim:ExcST7BOELselectorKind.noOELinput a owl:NamedIndividual,
                                        cim:ExcST7BOELselectorKind;
                                      rdfs:comment "No OEL input is used. Corresponds to OELin not = 1 and not = 2 and not = 3 on the ExcST7B diagram. Original ExcST7B model would have called this OELin = 0."@en;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                      rdfs:label "noOELinput"@en;
                                      cimdoc:enumCode 0 .
cim:ExcST7BOELselectorKind.outputLVgate a owl:NamedIndividual,
                                          cim:ExcST7BOELselectorKind;
                                        rdfs:comment "The signal is connected into the output LVGate. Corresponds to OELin = 3 on the ExcST7B diagram."@en;
                                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                        rdfs:label "outputLVgate"@en;
                                        cimdoc:enumCode 3 .
cim:ExcST7BUELselectorKind a owl:Class;
                           rdfs:comment "Types of connections for the UEL input used for static excitation systems type 7B."@en;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "ExcST7BUELselectorKind"@en;
                           owl:equivalentClass [a owl:Class ; 
                                                owl:oneOf (cim:ExcST7BUELselectorKind.addVref
                                                           cim:ExcST7BUELselectorKind.inputHVgate
                                                           cim:ExcST7BUELselectorKind.noUELinput
                                                           cim:ExcST7BUELselectorKind.outputHVgate)];
                           cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.ExcitationSystemDynamics";
                           cimdoc:packageTier "Normative".
cim:ExcST7BUELselectorKind.addVref a owl:NamedIndividual,
                                     cim:ExcST7BUELselectorKind;
                                   rdfs:comment "The signal is added to Vref. Corresponds to UELin = 1 on the ExcST7B diagram."@en;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                   rdfs:label "addVref"@en;
                                   cimdoc:enumCode 1 .
cim:ExcST7BUELselectorKind.inputHVgate a owl:NamedIndividual,
                                         cim:ExcST7BUELselectorKind;
                                       rdfs:comment "The signal is connected into the input HVGate. Corresponds to UELin = 2 on the ExcST7B diagram."@en;
                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                       rdfs:label "inputHVgate"@en;
                                       cimdoc:enumCode 2 .
cim:ExcST7BUELselectorKind.noUELinput a owl:NamedIndividual,
                                        cim:ExcST7BUELselectorKind;
                                      rdfs:comment "No UEL input is used. Corresponds to UELin not = 1 and not = 2 and not = 3 on the ExcST7B diagram. Original ExcST7B model would have called this UELin = 0."@en;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                      rdfs:label "noUELinput"@en;
                                      cimdoc:enumCode 0 .
cim:ExcST7BUELselectorKind.outputHVgate a owl:NamedIndividual,
                                          cim:ExcST7BUELselectorKind;
                                        rdfs:comment "The signal is connected into the output HVGate. Corresponds to UELin = 3 on the ExcST7B diagram."@en;
                                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                        rdfs:label "outputHVgate"@en;
                                        cimdoc:enumCode 3 .
cim:ExcitationSystemDynamics a owl:Class;
                             rdfs:comment "Excitation system function block whose behaviour is described by reference to a standard model or by definition of a user-defined model."@en;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "ExcitationSystemDynamics"@en;
                             rdfs:subClassOf cim:DynamicsFunctionBlock;
                             cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.ExcitationSystemDynamics";
                             cimdoc:packageTier "Normative".
cim:ExcitationSystemDynamics.SynchronousMachineDynamics a owl:ObjectProperty;
                                                        rdfs:comment "Synchronous machine model with which this excitation system model is associated."@en;
                                                        rdfs:domain cim:ExcitationSystemDynamics;
                                                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                        rdfs:label "SynchronousMachineDynamics"@en;
                                                        rdfs:range cim:SynchronousMachineDynamics.
cim:ExcitationSystemUserDefined a owl:Class;
                                rdfs:comment "Excitation system function block whose dynamic behaviour is described by a user-defined model."@en;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "ExcitationSystemUserDefined"@en;
                                rdfs:subClassOf cim:ExcitationSystemDynamics;
                                cimdoc:cimPackage "IEC61970.Dynamics.UserDefinedModels";
                                cimdoc:packageTier "Normative".
cim:ExcitationSystemUserDefined.proprietary a owl:DatatypeProperty;
                                            rdfs:comment "Behaviour is based on a proprietary model as opposed to a detailed model. true = user-defined model is proprietary with behaviour mutually understood by sending and receiving applications and parameters passed as general attributes false = user-defined model is explicitly defined in terms of control blocks and their input and output signals."@en;
                                            rdfs:domain cim:ExcitationSystemUserDefined;
                                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                            rdfs:label "proprietary"@en;
                                            rdfs:range xsd:boolean.
cim:ExternalNetworkInjection a owl:Class;
                             rdfs:comment "This class represents the external network and it is used for IEC 60909 calculations."@en;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "ExternalNetworkInjection"@en;
                             rdfs:subClassOf cim:RegulatingCondEq;
                             cimdoc:cimPackage "IEC61970.Base.Wires";
                             cimdoc:packageTier "Normative".
cim:ExternalNetworkInjection.governorSCD a owl:DatatypeProperty;
                                         rdfs:comment "Power Frequency Bias. This is the change in power injection divided by the change in frequency and negated. A positive value of the power frequency bias provides additional power injection upon a drop in frequency."@en;
                                         rdfs:domain cim:ExternalNetworkInjection;
                                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                         rdfs:label "governorSCD"@en;
                                         rdfs:range cim:ActivePowerPerFrequency.
cim:ExternalNetworkInjection.ikSecond a owl:DatatypeProperty;
                                      rdfs:comment """Indicates whether initial symmetrical short-circuit current and power have been calculated according to IEC (Ik\"). Used only if short circuit calculations are done according to superposition method."""@en;
                                      rdfs:domain cim:ExternalNetworkInjection;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                      rdfs:label "ikSecond"@en;
                                      rdfs:range xsd:boolean.
cim:ExternalNetworkInjection.maxInitialSymShCCurrent a owl:DatatypeProperty;
                                                     rdfs:comment """Maximum initial symmetrical short-circuit currents (Ik\" max) in A (Ik\" = Sk\"/(SQRT(3) Un)). Used for short circuit data exchange according to IEC 60909."""@en;
                                                     rdfs:domain cim:ExternalNetworkInjection;
                                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                     rdfs:label "maxInitialSymShCCurrent"@en;
                                                     rdfs:range cim:CurrentFlow.
cim:ExternalNetworkInjection.maxP a owl:DatatypeProperty;
                                  rdfs:comment "Maximum active power of the injection."@en;
                                  rdfs:domain cim:ExternalNetworkInjection;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "maxP"@en;
                                  rdfs:range cim:ActivePower.
cim:ExternalNetworkInjection.maxQ a owl:DatatypeProperty;
                                  rdfs:comment "Maximum reactive power limit. It is used for modelling of infeed for load flow exchange and not for short circuit modelling."@en;
                                  rdfs:domain cim:ExternalNetworkInjection;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "maxQ"@en;
                                  rdfs:range cim:ReactivePower.
cim:ExternalNetworkInjection.maxR0ToX0Ratio a owl:DatatypeProperty;
                                            rdfs:comment "Maximum ratio of zero sequence resistance of Network Feeder to its zero sequence reactance (R(0)/X(0) max). Used for short circuit data exchange according to IEC 60909."@en;
                                            rdfs:domain cim:ExternalNetworkInjection;
                                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                            rdfs:label "maxR0ToX0Ratio"@en;
                                            rdfs:range xsd:float.
cim:ExternalNetworkInjection.maxR1ToX1Ratio a owl:DatatypeProperty;
                                            rdfs:comment "Maximum ratio of positive sequence resistance of Network Feeder to its positive sequence reactance (R(1)/X(1) max). Used for short circuit data exchange according to IEC 60909."@en;
                                            rdfs:domain cim:ExternalNetworkInjection;
                                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                            rdfs:label "maxR1ToX1Ratio"@en;
                                            rdfs:range xsd:float.
cim:ExternalNetworkInjection.maxZ0ToZ1Ratio a owl:DatatypeProperty;
                                            rdfs:comment "Maximum ratio of zero sequence impedance to its positive sequence impedance (Z(0)/Z(1) max). Used for short circuit data exchange according to IEC 60909."@en;
                                            rdfs:domain cim:ExternalNetworkInjection;
                                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                            rdfs:label "maxZ0ToZ1Ratio"@en;
                                            rdfs:range xsd:float.
cim:ExternalNetworkInjection.minInitialSymShCCurrent a owl:DatatypeProperty;
                                                     rdfs:comment """Minimum initial symmetrical short-circuit currents (Ik\" min) in A (Ik\" = Sk\"/(SQRT(3) Un)). Used for short circuit data exchange according to IEC 60909."""@en;
                                                     rdfs:domain cim:ExternalNetworkInjection;
                                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                     rdfs:label "minInitialSymShCCurrent"@en;
                                                     rdfs:range cim:CurrentFlow.
cim:ExternalNetworkInjection.minP a owl:DatatypeProperty;
                                  rdfs:comment "Minimum active power of the injection."@en;
                                  rdfs:domain cim:ExternalNetworkInjection;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "minP"@en;
                                  rdfs:range cim:ActivePower.
cim:ExternalNetworkInjection.minQ a owl:DatatypeProperty;
                                  rdfs:comment "Minimum reactive power limit. It is used for modelling of infeed for load flow exchange and not for short circuit modelling."@en;
                                  rdfs:domain cim:ExternalNetworkInjection;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "minQ"@en;
                                  rdfs:range cim:ReactivePower.
cim:ExternalNetworkInjection.minR0ToX0Ratio a owl:DatatypeProperty;
                                            rdfs:comment """Indicates whether initial symmetrical short-circuit current and power have been calculated according to IEC (Ik\"). Used for short circuit data exchange according to IEC 6090."""@en;
                                            rdfs:domain cim:ExternalNetworkInjection;
                                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                            rdfs:label "minR0ToX0Ratio"@en;
                                            rdfs:range xsd:float.
cim:ExternalNetworkInjection.minR1ToX1Ratio a owl:DatatypeProperty;
                                            rdfs:comment "Minimum ratio of positive sequence resistance of Network Feeder to its positive sequence reactance (R(1)/X(1) min). Used for short circuit data exchange according to IEC 60909."@en;
                                            rdfs:domain cim:ExternalNetworkInjection;
                                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                            rdfs:label "minR1ToX1Ratio"@en;
                                            rdfs:range xsd:float.
cim:ExternalNetworkInjection.minZ0ToZ1Ratio a owl:DatatypeProperty;
                                            rdfs:comment "Minimum ratio of zero sequence impedance to its positive sequence impedance (Z(0)/Z(1) min). Used for short circuit data exchange according to IEC 60909."@en;
                                            rdfs:domain cim:ExternalNetworkInjection;
                                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                            rdfs:label "minZ0ToZ1Ratio"@en;
                                            rdfs:range xsd:float.
cim:ExternalNetworkInjection.p a owl:DatatypeProperty;
                               rdfs:comment "Active power injection. Load sign convention is used, i.e. positive sign means flow out from a node. Starting value for steady state solutions."@en;
                               rdfs:domain cim:ExternalNetworkInjection;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "p"@en;
                               rdfs:range cim:ActivePower.
cim:ExternalNetworkInjection.q a owl:DatatypeProperty;
                               rdfs:comment "Reactive power injection. Load sign convention is used, i.e. positive sign means flow out from a node. Starting value for steady state solutions."@en;
                               rdfs:domain cim:ExternalNetworkInjection;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "q"@en;
                               rdfs:range cim:ReactivePower.
cim:ExternalNetworkInjection.referencePriority a owl:DatatypeProperty;
                                               rdfs:comment "Priority of unit for use as powerflow voltage phase angle reference bus selection. 0 = don t care (default) 1 = highest priority. 2 is less than 1 and so on."@en;
                                               rdfs:domain cim:ExternalNetworkInjection;
                                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                               rdfs:label "referencePriority"@en;
                                               rdfs:range xsd:integer.
cim:ExternalNetworkInjection.voltageFactor a owl:DatatypeProperty;
                                           rdfs:comment """Voltage factor in pu, which was used to calculate short-circuit current Ik\" and power Sk\". Used only if short circuit calculations are done according to superposition method."""@en;
                                           rdfs:domain cim:ExternalNetworkInjection;
                                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                           rdfs:label "voltageFactor"@en;
                                           rdfs:range cim:PU.
cim:Fault a owl:Class;
          rdfs:comment "Abnormal condition causing current flow through conducting equipment, such as caused by equipment failure or short circuits from objects not typically modelled (for example, a tree falling on a line)."@en;
          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
          rdfs:label "Fault"@en;
          rdfs:subClassOf cim:IdentifiedObject;
          cimdoc:cimPackage "IEC61970.Base.Faults";
          cimdoc:packageTier "Normative".
cim:Fault.FaultCauseTypes a owl:ObjectProperty;
                          rdfs:comment "All types of fault cause."@en;
                          rdfs:domain cim:Fault;
