cim:ExcDC3A1.exclim a owl:DatatypeProperty;
                    rdfs:comment "(exclim). true = lower limit of zero is applied to integrator output false = lower limit of zero not applied to integrator output. Typical value = true."@en;
                    rdfs:domain cim:ExcDC3A1;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "exclim"@en;
                    rdfs:range xsd:boolean.
cim:ExcDC3A1.ka a owl:DatatypeProperty;
                rdfs:comment "Voltage regulator gain (Ka) (> 0). Typical value = 300."@en;
                rdfs:domain cim:ExcDC3A1;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "ka"@en;
                rdfs:range cim:PU.
cim:ExcDC3A1.ke a owl:DatatypeProperty;
                rdfs:comment "Exciter constant related to self-excited field (Ke). Typical value = 1."@en;
                rdfs:domain cim:ExcDC3A1;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "ke"@en;
                rdfs:range cim:PU.
cim:ExcDC3A1.kf a owl:DatatypeProperty;
                rdfs:comment "Excitation control system stabilizer gain (Kf) (>= 0). Typical value = 0,1."@en;
                rdfs:domain cim:ExcDC3A1;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "kf"@en;
                rdfs:range cim:PU.
cim:ExcDC3A1.ki a owl:DatatypeProperty;
                rdfs:comment "Potential circuit gain coefficient (Ki) (>= 0). Typical value = 4,83."@en;
                rdfs:domain cim:ExcDC3A1;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "ki"@en;
                rdfs:range cim:PU.
cim:ExcDC3A1.kp a owl:DatatypeProperty;
                rdfs:comment "Potential circuit gain coefficient (Kp) (>= 0). Typical value = 4,37."@en;
                rdfs:domain cim:ExcDC3A1;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "kp"@en;
                rdfs:range cim:PU.
cim:ExcDC3A1.ta a owl:DatatypeProperty;
                rdfs:comment "Voltage regulator time constant (Ta) (> 0). Typical value = 0,01."@en;
                rdfs:domain cim:ExcDC3A1;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "ta"@en;
                rdfs:range cim:Seconds.
cim:ExcDC3A1.te a owl:DatatypeProperty;
                rdfs:comment "Exciter time constant, integration rate associated with exciter control (Te) (> 0). Typical value = 1,83."@en;
                rdfs:domain cim:ExcDC3A1;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "te"@en;
                rdfs:range cim:Seconds.
cim:ExcDC3A1.tf a owl:DatatypeProperty;
                rdfs:comment "Excitation control system stabilizer time constant (Tf) (>= 0). Typical value = 0,675."@en;
                rdfs:domain cim:ExcDC3A1;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "tf"@en;
                rdfs:range cim:Seconds.
cim:ExcDC3A1.vb1max a owl:DatatypeProperty;
