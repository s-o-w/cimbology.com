                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "rad"@en;
                   cimdoc:enumCode 10 .
cim:UnitSymbol.radPers a owl:NamedIndividual,
                         cim:UnitSymbol;
                       rdfs:comment "Angular velocity in radians per second (rad/s)."@en;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "radPers"@en;
                       cimdoc:enumCode 54 .
cim:UnitSymbol.radPers2 a owl:NamedIndividual,
                          cim:UnitSymbol;
                        rdfs:comment "Angular acceleration, radians per second squared."@en;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                        rdfs:label "radPers2"@en;
                        cimdoc:enumCode 178 .
cim:UnitSymbol.rev a owl:NamedIndividual,
                     cim:UnitSymbol;
                   rdfs:comment "Amount of rotation, revolutions."@en;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "rev"@en;
                   cimdoc:enumCode 154 .
cim:UnitSymbol.rotPers a owl:NamedIndividual,
