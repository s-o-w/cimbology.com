cim:PetersenCoil a owl:Class;
                 rdfs:comment "A variable impedance device normally used to offset line charging during single line faults in an ungrounded section of network."@en;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "PetersenCoil"@en;
                 rdfs:subClassOf cim:EarthFaultCompensator;
                 cimdoc:cimPackage "IEC61970.Base.Wires";
                 cimdoc:packageTier "Normative".
cim:PetersenCoil.mode a owl:ObjectProperty;
                      rdfs:comment "The mode of operation of the Petersen coil."@en;
                      rdfs:domain cim:PetersenCoil;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "mode"@en;
                      rdfs:range cim:PetersenCoilModeKind.
cim:PetersenCoil.nominalU a owl:DatatypeProperty;
                          rdfs:comment "The nominal voltage for which the coil is designed."@en;
                          rdfs:domain cim:PetersenCoil;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                          rdfs:label "nominalU"@en;
                          rdfs:range cim:Voltage.
cim:PetersenCoil.offsetCurrent a owl:DatatypeProperty;
                               rdfs:comment "The offset current that the Petersen coil controller is operating from the resonant point. This is normally a fixed amount for which the controller is configured and could be positive or negative. Typically 0 to 60 A depending on voltage and resonance conditions."@en;
                               rdfs:domain cim:PetersenCoil;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "offsetCurrent"@en;
                               rdfs:range cim:CurrentFlow.
cim:PetersenCoil.positionCurrent a owl:DatatypeProperty;
                                 rdfs:comment "The control current used to control the Petersen coil also known as the position current. Typically in the range of 20 mA to 200 mA."@en;
                                 rdfs:domain cim:PetersenCoil;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "positionCurrent"@en;
                                 rdfs:range cim:CurrentFlow.
cim:PetersenCoil.xGroundMax a owl:DatatypeProperty;
                            rdfs:comment "The maximum reactance."@en;
                            rdfs:domain cim:PetersenCoil;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "xGroundMax"@en;
                            rdfs:range cim:Reactance.
cim:PetersenCoil.xGroundMin a owl:DatatypeProperty;
                            rdfs:comment "The minimum reactance."@en;
                            rdfs:domain cim:PetersenCoil;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "xGroundMin"@en;
                            rdfs:range cim:Reactance.
cim:PetersenCoil.xGroundNominal a owl:DatatypeProperty;
                                rdfs:comment "The nominal reactance. This is the operating point (normally over compensation) that is defined based on the resonance point in the healthy network condition. The impedance is calculated based on nominal voltage divided by position current."@en;
                                rdfs:domain cim:PetersenCoil;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "xGroundNominal"@en;
                                rdfs:range cim:Reactance.
cim:PetersenCoilModeKind a owl:Class;
