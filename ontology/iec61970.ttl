cim:HeatInputCurve a owl:Class;
                   rdfs:comment "Relationship between unit heat input in energy per time for main fuel (Y1-axis) and supplemental fuel (Y2-axis) versus unit output in active power (X-axis). The quantity of main fuel used to sustain generation at this output level is prorated for throttling between definition points. The quantity of supplemental fuel used at this output level is fixed and not prorated."@en;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "HeatInputCurve"@en;
                   rdfs:subClassOf cim:Curve;
                   cimdoc:cimPackage "IEC61970.Base.Generation.Production";
                   cimdoc:packageTier "Normative".
cim:HeatInputCurve.auxPowerMult a owl:DatatypeProperty;
                                rdfs:comment "Power output - auxiliary power multiplier adjustment factor."@en;
                                rdfs:domain cim:HeatInputCurve;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "auxPowerMult"@en;
                                rdfs:range cim:PU.
cim:HeatInputCurve.auxPowerOffset a owl:DatatypeProperty;
                                  rdfs:comment "Power output - auxiliary power offset adjustment factor."@en;
                                  rdfs:domain cim:HeatInputCurve;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "auxPowerOffset"@en;
