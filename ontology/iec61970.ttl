cim:CurrentRelay.currentLimit1 a owl:DatatypeProperty;
                               rdfs:comment "Current limit number one 1 for inverse time pickup."@en;
                               rdfs:domain cim:CurrentRelay;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
