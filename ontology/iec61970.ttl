                          rdfs:subClassOf cim:IdentifiedObject;
                          cimdoc:cimPackage "IEC61970.Base.Core";
                          cimdoc:packageTier "Normative".
cim:SubGeographicalRegion.Lines a owl:ObjectProperty;
                                rdfs:comment "The lines within the sub-geographical region."@en;
                                rdfs:domain cim:SubGeographicalRegion;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "Lines"@en;
                                rdfs:range cim:Line.
cim:SubGeographicalRegion.Substations a owl:ObjectProperty;
                                      rdfs:comment "The substations in this sub-geographical region."@en;
