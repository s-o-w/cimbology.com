                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "ty"@en;
                rdfs:range cim:Seconds.
cim:GovGASTWD a owl:Class;
              rdfs:comment "Woodward� gas turbine governor. [Footnote: Woodward gas turbines are an example of suitable products available commercially. This information is given for the convenience of users of this document and does not constitute an endorsement by IEC of these products.]"@en;
