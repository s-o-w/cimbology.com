cim:IPAccessPoint a owl:Class;
                  rdfs:comment "Internet Protocol Access Point � used to represent an addressing structure is based upon an Internet Protocol (IP) address."@en;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "IPAccessPoint"@en;
                  rdfs:subClassOf cim:CommunicationLink;
                  cimdoc:cimPackage "IEC61970.Base.ICCPConfiguration";
                  cimdoc:packageTier "Normative".
cim:IPAccessPoint.address a owl:DatatypeProperty;
                          rdfs:comment "Is the dotted decimal IP Address resolve the IP address. The format is controlled by the value of the addressType."@en;
                          rdfs:domain cim:IPAccessPoint;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                          rdfs:label "address"@en;
                          rdfs:range xsd:string.
cim:IPAccessPoint.addressType a owl:ObjectProperty;
                              rdfs:comment "IP address type."@en;
                              rdfs:domain cim:IPAccessPoint;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "addressType"@en;
                              rdfs:range cim:IPAddressKind.
cim:IPAccessPoint.gateway a owl:DatatypeProperty;
                          rdfs:comment "Is the dotted decimal IPAddress of the first hop router. Format is controlled by the addressType."@en;
                          rdfs:domain cim:IPAccessPoint;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                          rdfs:label "gateway"@en;
                          rdfs:range xsd:string.
cim:IPAccessPoint.subnet a owl:DatatypeProperty;
                         rdfs:comment "This is the IP subnet mask which controls the local vs non-local routing."@en;
                         rdfs:domain cim:IPAccessPoint;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                         rdfs:label "subnet"@en;
                         rdfs:range xsd:string.
cim:IPAddressKind a owl:Class;
                  rdfs:comment "Indicates if the addressing of the IPAccessPoint, gateway, and subnet are per IPv4 or IPv6."@en;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "IPAddressKind"@en;
                  owl:equivalentClass [a owl:Class ; 
                                       owl:oneOf (cim:IPAddressKind.iPv4
                                                  cim:IPAddressKind.iPv6)];
                  cimdoc:cimPackage "IEC61970.Base.ICCPConfiguration";
                  cimdoc:packageTier "Normative".
cim:IPAddressKind.iPv4 a owl:NamedIndividual,
                         cim:IPAddressKind;
                       rdfs:comment "Indicates that IPv4 dotted decimal notation is in use."@en;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
