cim:LoadStatic.kp4 a owl:DatatypeProperty;
                   rdfs:comment "Frequency coefficient for active power (Kp4) (not = 0 if .staticLoadModelType = zIP2). Used only when .staticLoadModelType = zIP2."@en;
