cim:MutualCoupling a owl:Class;
                   rdfs:comment "This class represents the zero sequence line mutual coupling."@en;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "MutualCoupling"@en;
                   rdfs:subClassOf cim:IdentifiedObject;
                   cimdoc:cimPackage "IEC61970.Base.Wires";
                   cimdoc:packageTier "Normative".
cim:MutualCoupling.First_Terminal a owl:ObjectProperty;
                                  rdfs:comment "The starting terminal for the calculation of distances along the first branch of the mutual coupling. Normally MutualCoupling would only be used for terminals of AC line segments. The first and second terminals of a mutual coupling should point to different AC line segments."@en;
                                  rdfs:domain cim:MutualCoupling;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "First_Terminal"@en;
                                  rdfs:range cim:Terminal.
cim:MutualCoupling.Second_Terminal a owl:ObjectProperty;
                                   rdfs:comment "The starting terminal for the calculation of distances along the second branch of the mutual coupling."@en;
                                   rdfs:domain cim:MutualCoupling;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                   rdfs:label "Second_Terminal"@en;
                                   rdfs:range cim:Terminal.
cim:MutualCoupling.b0ch a owl:DatatypeProperty;
                        rdfs:comment "Zero sequence mutual coupling shunt (charging) susceptance, uniformly distributed, of the entire line section."@en;
                        rdfs:domain cim:MutualCoupling;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                        rdfs:label "b0ch"@en;
                        rdfs:range cim:Susceptance.
cim:MutualCoupling.distance11 a owl:DatatypeProperty;
                              rdfs:comment "Distance to the start of the coupled region from the first line's terminal having sequence number equal to 1."@en;
                              rdfs:domain cim:MutualCoupling;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "distance11"@en;
                              rdfs:range cim:Length.
cim:MutualCoupling.distance12 a owl:DatatypeProperty;
                              rdfs:comment "Distance to the end of the coupled region from the first line's terminal with sequence number equal to 1."@en;
                              rdfs:domain cim:MutualCoupling;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "distance12"@en;
                              rdfs:range cim:Length.
cim:MutualCoupling.distance21 a owl:DatatypeProperty;
                              rdfs:comment "Distance to the start of coupled region from the second line's terminal with sequence number equal to 1."@en;
                              rdfs:domain cim:MutualCoupling;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "distance21"@en;
                              rdfs:range cim:Length.
cim:MutualCoupling.distance22 a owl:DatatypeProperty;
                              rdfs:comment "Distance to the end of coupled region from the second line's terminal with sequence number equal to 1."@en;
                              rdfs:domain cim:MutualCoupling;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "distance22"@en;
                              rdfs:range cim:Length.
cim:MutualCoupling.g0ch a owl:DatatypeProperty;
                        rdfs:comment "Zero sequence mutual coupling shunt (charging) conductance, uniformly distributed, of the entire line section."@en;
                        rdfs:domain cim:MutualCoupling;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                        rdfs:label "g0ch"@en;
                        rdfs:range cim:Conductance.
cim:MutualCoupling.r0 a owl:DatatypeProperty;
                      rdfs:comment "Zero sequence branch-to-branch mutual impedance coupling, resistance."@en;
                      rdfs:domain cim:MutualCoupling;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "r0"@en;
                      rdfs:range cim:Resistance.
cim:MutualCoupling.x0 a owl:DatatypeProperty;
                      rdfs:comment "Zero sequence branch-to-branch mutual impedance coupling, reactance."@en;
                      rdfs:domain cim:MutualCoupling;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "x0"@en;
                      rdfs:range cim:Reactance.
cim:Name a owl:Class;
         rdfs:comment "The Name class provides the means to define any number of human readable names for an object. A name is not to be used for defining inter-object relationships. For inter-object relationships instead use the object identification 'mRID'."@en;
         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
         rdfs:label "Name"@en;
         cimdoc:cimPackage "IEC61970.Base.Core";
         cimdoc:packageTier "Normative".
cim:Name.IdentifiedObject a owl:ObjectProperty;
                          rdfs:comment "Identified object that this name designates."@en;
                          rdfs:domain cim:Name;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                          rdfs:label "IdentifiedObject"@en;
                          rdfs:range cim:IdentifiedObject.
cim:Name.NameType a owl:ObjectProperty;
                  rdfs:comment "Type of this name."@en;
                  rdfs:domain cim:Name;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "NameType"@en;
                  rdfs:range cim:NameType.
cim:Name.name a owl:DatatypeProperty;
              rdfs:comment "Any free text that name the object."@en;
              rdfs:domain cim:Name;
              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
              rdfs:label "name"@en;
              rdfs:range xsd:string.
cim:NameType a owl:Class;
             rdfs:comment "Type of name. Possible values for attribute 'name' are implementation dependent but standard profiles may specify types. An enterprise may have multiple IT systems each having its own local name for the same object, e.g. a planning system may have different names from an EMS. An object may also have different names within the same IT system, e.g. localName as defined in CIM version 14. The definition from CIM14 is: The localName is a human readable name of the object. It is a free text name local to a node in a naming hierarchy similar to a file directory structure. A power system related naming hierarchy may be: Substation, VoltageLevel, Equipment etc. Children of the same parent in such a hierarchy have names that typically are unique among them."@en;
             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
             rdfs:label "NameType"@en;
             cimdoc:cimPackage "IEC61970.Base.Core";
             cimdoc:packageTier "Normative".
cim:NameType.NameTypeAuthority a owl:ObjectProperty;
                               rdfs:comment "Authority responsible for managing names of this type."@en;
                               rdfs:domain cim:NameType;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "NameTypeAuthority"@en;
                               rdfs:range cim:NameTypeAuthority.
cim:NameType.description a owl:DatatypeProperty;
                         rdfs:comment "Description of the name type."@en;
                         rdfs:domain cim:NameType;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                         rdfs:label "description"@en;
                         rdfs:range xsd:string.
cim:NameType.name a owl:DatatypeProperty;
                  rdfs:comment "Name of the name type."@en;
                  rdfs:domain cim:NameType;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "name"@en;
                  rdfs:range xsd:string.
cim:NameTypeAuthority a owl:Class;
                      rdfs:comment "Authority responsible for creation and management of names of a given type; typically an organization or an enterprise system."@en;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "NameTypeAuthority"@en;
                      cimdoc:cimPackage "IEC61970.Base.Core";
                      cimdoc:packageTier "Normative".
cim:NameTypeAuthority.description a owl:DatatypeProperty;
                                  rdfs:comment "Description of the name type authority."@en;
                                  rdfs:domain cim:NameTypeAuthority;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "description"@en;
                                  rdfs:range xsd:string.
cim:NameTypeAuthority.name a owl:DatatypeProperty;
                           rdfs:comment "Name of the name type authority."@en;
                           rdfs:domain cim:NameTypeAuthority;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "name"@en;
                           rdfs:range xsd:string.
cim:NetworkBoundary a owl:Class;
