cim:GovHydro3.gv4 a owl:DatatypeProperty;
                  rdfs:comment "Nonlinear gain point 4, PU gv (Gv4). Typical value = 0."@en;
                  rdfs:domain cim:GovHydro3;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "gv4"@en;
                  rdfs:range cim:PU.
cim:GovHydro3.gv5 a owl:DatatypeProperty;
                  rdfs:comment "Nonlinear gain point 5, PU gv (Gv5). Typical value = 0."@en;
                  rdfs:domain cim:GovHydro3;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "gv5"@en;
