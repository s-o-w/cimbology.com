cim:GovGAST2.etd a owl:DatatypeProperty;
                 rdfs:comment "Turbine and exhaust delay (Etd) (>= 0)."@en;
                 rdfs:domain cim:GovGAST2;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "etd"@en;
