cim:PFVArControllerType1Dynamics.RemoteInputSignal a owl:ObjectProperty;
                                                   rdfs:comment "Remote input signal used by this power factor or VAr controller type 1 model."@en;
                                                   rdfs:domain cim:PFVArControllerType1Dynamics;
                                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                   rdfs:label "RemoteInputSignal"@en;
