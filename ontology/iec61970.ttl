cim:GovHydro4.pgv0 a owl:DatatypeProperty;
                   rdfs:comment "Nonlinear gain point 0, PU power (Pgv0) (= 0 for simple). Typical value = 0."@en;
                   rdfs:domain cim:GovHydro4;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "pgv0"@en;
                   rdfs:range cim:PU.
cim:GovHydro4.pgv1 a owl:DatatypeProperty;
                   rdfs:comment "Nonlinear gain point 1, PU power (Pgv1) (= 0 for simple). Typical value for Francis/Pelton = 0,42, Kaplan = 0,35."@en;
                   rdfs:domain cim:GovHydro4;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "pgv1"@en;
                   rdfs:range cim:PU.
cim:GovHydro4.pgv2 a owl:DatatypeProperty;
