cim:Pss2B a owl:Class;
          rdfs:comment "Modified IEEE PSS2B. Extra lead/lag (or rate) block added at end (up to 4 lead/lags total)."@en;
          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
          rdfs:label "Pss2B"@en;
          rdfs:subClassOf cim:PowerSystemStabilizerDynamics;
