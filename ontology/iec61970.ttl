cim:GovGAST1.gv5 a owl:DatatypeProperty;
                 rdfs:comment "Nonlinear gain point 5, PU gv (Gv5). Typical value = 0."@en;
                 rdfs:domain cim:GovGAST1;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "gv5"@en;
                 rdfs:range cim:PU.
cim:GovGAST1.gv6 a owl:DatatypeProperty;
                 rdfs:comment "Nonlinear gain point 6, PU gv (Gv6). Typical value = 0."@en;
                 rdfs:domain cim:GovGAST1;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "gv6"@en;
                 rdfs:range cim:PU.
cim:GovGAST1.ka a owl:DatatypeProperty;
                rdfs:comment "Governor gain (Ka). Typical value = 0."@en;
                rdfs:domain cim:GovGAST1;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "ka"@en;
                rdfs:range cim:PU.
cim:GovGAST1.kt a owl:DatatypeProperty;
                rdfs:comment "Temperature limiter gain (Kt). Typical value = 3."@en;
                rdfs:domain cim:GovGAST1;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "kt"@en;
                rdfs:range cim:PU.
cim:GovGAST1.lmax a owl:DatatypeProperty;
