cim:NetworkModelProjectComponent2.Parent a owl:ObjectProperty;
                                         rdfs:comment "The parent project of this component."@en;
                                         rdfs:domain cim:NetworkModelProjectComponent2;
                                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                         rdfs:label "Parent"@en;
