                                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                         rdfs:label "breakerAndAHalf"@en;
                                         cimdoc:enumCode 1 .
cim:BreakerConfiguration.doubleBreaker a owl:NamedIndividual,
                                         cim:BreakerConfiguration;
                                       rdfs:comment "Double breaker."@en;
                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                       rdfs:label "doubleBreaker"@en;
                                       cimdoc:enumCode 2 .
cim:BreakerConfiguration.noBreaker a owl:NamedIndividual,
                                     cim:BreakerConfiguration;
                                   rdfs:comment "No breaker."@en;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                   rdfs:label "noBreaker"@en;
                                   cimdoc:enumCode 3 .
cim:BreakerConfiguration.singleBreaker a owl:NamedIndividual,
                                         cim:BreakerConfiguration;
                                       rdfs:comment "Single breaker."@en;
