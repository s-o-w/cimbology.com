cim:ExcSK.qz a owl:DatatypeProperty;
             rdfs:comment "Desired value (setpoint) of reactive power, manual setting (Qz)."@en;
             rdfs:domain cim:ExcSK;
             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
