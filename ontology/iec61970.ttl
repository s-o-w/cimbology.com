cim:Delay.DCvoltageControl a owl:ObjectProperty;
                           rdfs:comment "The cvoltage control"@en;
                           rdfs:domain cim:Delay;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "DCvoltageControl"@en;
                           rdfs:range cim:DCvoltageControl.
cim:Delay.PFmode a owl:ObjectProperty;
                 rdfs:comment "The fmode"@en;
                 rdfs:domain cim:Delay;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "PFmode"@en;
                 rdfs:range cim:PFmode.
cim:Delay.Pcontrol a owl:ObjectProperty;
                   rdfs:comment "The pcontrol"@en;
                   rdfs:domain cim:Delay;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "Pcontrol"@en;
                   rdfs:range cim:Pcontrol.
cim:Delay.Qlimiter a owl:ObjectProperty;
                   rdfs:comment "The qlimiter"@en;
                   rdfs:domain cim:Delay;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "Qlimiter"@en;
                   rdfs:range cim:Qlimiter.
cim:Delay.Qmode a owl:ObjectProperty;
                rdfs:comment "The qmode"@en;
                rdfs:domain cim:Delay;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "Qmode"@en;
                rdfs:range cim:Qmode.
cim:Delay.Qregulator a owl:ObjectProperty;
                     rdfs:comment "The qregulator"@en;
                     rdfs:domain cim:Delay;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                     rdfs:label "Qregulator"@en;
                     rdfs:range cim:Qregulator.
cim:Delay.Umode a owl:ObjectProperty;
                rdfs:comment "The umode"@en;
                rdfs:domain cim:Delay;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "Umode"@en;
                rdfs:range cim:Umode.
cim:Delay.m_CCAinverter a owl:ObjectProperty;
                        rdfs:comment "The ccainverter"@en;
                        rdfs:domain cim:Delay;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                        rdfs:label "m_CCAinverter"@en;
                        rdfs:range cim:CCAinverter.
cim:Delay.m_CCArectifierControl a owl:ObjectProperty;
                                rdfs:comment "The ccarectifiercontrol"@en;
                                rdfs:domain cim:Delay;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "m_CCArectifierControl"@en;
                                rdfs:range cim:CCArectifierControl.
cim:Delay.m_IdcInverterControl a owl:ObjectProperty;
                               rdfs:comment "The idcinvertercontrol"@en;
                               rdfs:domain cim:Delay;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "m_IdcInverterControl"@en;
                               rdfs:range cim:IdcInverterControl.
cim:Delay.m_VDCOL a owl:ObjectProperty;
                  rdfs:comment "The vdcol"@en;
                  rdfs:domain cim:Delay;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "m_VDCOL"@en;
                  rdfs:range cim:VDCOL.
cim:Delay.tm a owl:DatatypeProperty;
             rdfs:comment "Time constant."@en;
             rdfs:domain cim:Delay;
             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
             rdfs:label "tm"@en;
             rdfs:range cim:Seconds.
cim:DependencyKind a owl:Class;
                   rdfs:comment "Enumerates the types of dependencies between network model project stages."@en;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "DependencyKind"@en;
                   owl:equivalentClass [a owl:Class ; 
                                        owl:oneOf (cim:DependencyKind.mutuallyExclusive
                                                   cim:DependencyKind.required)];
                   cimdoc:cimPackage "IEC61970.InfIEC61970.InfPart303.NetworkModelProjects";
                   cimdoc:packageTier "Informative".
cim:DependencyKind.mutuallyExclusive a owl:NamedIndividual,
                                       cim:DependencyKind;
                                     rdfs:comment "The projects are mutually exclusive."@en;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                     rdfs:label "mutuallyExclusive"@en;
                                     cimdoc:enumCode 0 .
cim:DependencyKind.required a owl:NamedIndividual,
                              cim:DependencyKind;
                            rdfs:comment "The project is required."@en;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "required"@en;
                            cimdoc:enumCode 1 .
cim:Diagram a owl:Class;
            rdfs:comment "The diagram being exchanged. The coordinate system is a standard Cartesian coordinate system and the orientation attribute defines the orientation. The initial view related attributes can be used to specify an initial view with the x,y coordinates of the diagonal points."@en;
            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
            rdfs:label "Diagram"@en;
            rdfs:subClassOf cim:IdentifiedObject;
            cimdoc:cimPackage "IEC61970.Base.DiagramLayout";
            cimdoc:packageTier "Normative".
cim:Diagram.orientation a owl:ObjectProperty;
                        rdfs:comment "Coordinate system orientation of the diagram. A positive orientation gives standard �right-hand� orientation, with negative orientation indicating a �left- hand� orientation. For 2D diagrams, a positive orientation will result in X values increasing from left to right and Y values increasing from bottom to top. A negative orientation gives the �left-hand� orientation (favoured by computer graphics displays) with X values increasing from left to right and Y values increasing from top to bottom."@en;
                        rdfs:domain cim:Diagram;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                        rdfs:label "orientation"@en;
                        rdfs:range cim:OrientationKind.
cim:Diagram.x1InitialView a owl:DatatypeProperty;
                          rdfs:comment "X coordinate of the first corner of the initial view."@en;
                          rdfs:domain cim:Diagram;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                          rdfs:label "x1InitialView"@en;
                          rdfs:range xsd:float.
cim:Diagram.x2InitialView a owl:DatatypeProperty;
                          rdfs:comment "X coordinate of the second corner of the initial view."@en;
                          rdfs:domain cim:Diagram;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                          rdfs:label "x2InitialView"@en;
                          rdfs:range xsd:float.
cim:Diagram.y1InitialView a owl:DatatypeProperty;
                          rdfs:comment "Y coordinate of the first corner of the initial view."@en;
                          rdfs:domain cim:Diagram;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                          rdfs:label "y1InitialView"@en;
                          rdfs:range xsd:float.
cim:Diagram.y2InitialView a owl:DatatypeProperty;
                          rdfs:comment "Y coordinate of the second corner of the initial view."@en;
                          rdfs:domain cim:Diagram;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                          rdfs:label "y2InitialView"@en;
                          rdfs:range xsd:float.
cim:DiagramObject a owl:Class;
                  rdfs:comment "An object that defines one or more points in a given space. This object can be associated with anything that specializes IdentifiedObject. For single line diagrams such objects typically include such items as analog values, breakers, disconnectors, power transformers, and transmission lines."@en;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "DiagramObject"@en;
                  rdfs:subClassOf cim:IdentifiedObject;
                  cimdoc:cimPackage "IEC61970.Base.DiagramLayout";
                  cimdoc:packageTier "Normative".
cim:DiagramObject.Diagram a owl:ObjectProperty;
                          rdfs:comment "A diagram object is part of a diagram."@en;
                          rdfs:domain cim:DiagramObject;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                          rdfs:label "Diagram"@en;
                          rdfs:range cim:Diagram.
cim:DiagramObject.DiagramObjectPoints a owl:ObjectProperty;
                                      rdfs:comment "A diagram object can have 0 or more points to reflect its layout position, routing (for polylines) or boundary (for polygons)."@en;
                                      rdfs:domain cim:DiagramObject;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                      rdfs:label "DiagramObjectPoints"@en;
                                      rdfs:range cim:DiagramObjectPoint.
cim:DiagramObject.DiagramObjectStyle a owl:ObjectProperty;
                                     rdfs:comment "A diagram object has a style associated that provides a reference for the style used in the originating system."@en;
                                     rdfs:domain cim:DiagramObject;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                     rdfs:label "DiagramObjectStyle"@en;
                                     rdfs:range cim:DiagramObjectStyle.
cim:DiagramObject.VisibilityLayers a owl:ObjectProperty;
                                   rdfs:comment "A diagram object can be part of multiple visibility layers."@en;
                                   rdfs:domain cim:DiagramObject;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                   rdfs:label "VisibilityLayers"@en;
                                   rdfs:range cim:VisibilityLayer.
cim:DiagramObject.drawingOrder a owl:DatatypeProperty;
                               rdfs:comment "The drawing order of this element. The higher the number, the later the element is drawn in sequence. This is used to ensure that elements that overlap are rendered in the correct order."@en;
                               rdfs:domain cim:DiagramObject;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "drawingOrder"@en;
                               rdfs:range xsd:integer.
cim:DiagramObject.isPolygon a owl:DatatypeProperty;
                            rdfs:comment "Defines whether or not the diagram objects points define the boundaries of a polygon or the routing of a polyline. If this value is true then a receiving application should consider the first and last points to be connected."@en;
                            rdfs:domain cim:DiagramObject;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "isPolygon"@en;
                            rdfs:range xsd:boolean.
cim:DiagramObject.offsetX a owl:DatatypeProperty;
                          rdfs:comment "The offset in the X direction. This is used for defining the offset from centre for rendering an icon (the default is that a single point specifies the centre of the icon). The offset is in per-unit with 0 indicating there is no offset from the horizontal centre of the icon. -0.5 indicates it is offset by 50% to the left and 0.5 indicates an offset of 50% to the right."@en;
                          rdfs:domain cim:DiagramObject;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                          rdfs:label "offsetX"@en;
                          rdfs:range xsd:float.
cim:DiagramObject.offsetY a owl:DatatypeProperty;
                          rdfs:comment "The offset in the Y direction. This is used for defining the offset from centre for rendering an icon (the default is that a single point specifies the centre of the icon). The offset is in per-unit with 0 indicating there is no offset from the vertical centre of the icon. The offset direction is dependent on the orientation of the diagram, with -0.5 and 0.5 indicating an offset of +/- 50% on the vertical axis."@en;
                          rdfs:domain cim:DiagramObject;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                          rdfs:label "offsetY"@en;
                          rdfs:range xsd:float.
cim:DiagramObject.rotation a owl:DatatypeProperty;
                           rdfs:comment """Sets the angle of rotation of the diagram object. Zero degrees is pointing to the top of the diagram. Rotation is clockwise. DiagramObject.rotation=0 has the following meaning: The connection point of an element which has one terminal is pointing to the top side of the diagram. The connection point \"From side\" of an element which has more than one terminal is pointing to the top side of the diagram. DiagramObject.rotation=90 has the following meaning: The connection point of an element which has one terminal is pointing to the right hand side of the diagram. The connection point \"From side\" of an element which has more than one terminal is pointing to the right hand side of the diagram."""@en;
                           rdfs:domain cim:DiagramObject;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "rotation"@en;
                           rdfs:range cim:AngleDegrees.
cim:DiagramObjectGluePoint a owl:Class;
                           rdfs:comment "This is used for grouping diagram object points from different diagram objects that are considered to be glued together in a diagram even if they are not at the exact same coordinates."@en;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "DiagramObjectGluePoint"@en;
                           cimdoc:cimPackage "IEC61970.Base.DiagramLayout";
                           cimdoc:packageTier "Normative".
cim:DiagramObjectPoint a owl:Class;
                       rdfs:comment "A point in a given space defined by 3 coordinates and associated to a diagram object. The coordinates may be positive or negative as the origin does not have to be in the corner of a diagram."@en;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "DiagramObjectPoint"@en;
                       cimdoc:cimPackage "IEC61970.Base.DiagramLayout";
                       cimdoc:packageTier "Normative".
cim:DiagramObjectPoint.DiagramObjectGluePoint a owl:ObjectProperty;
                                              rdfs:comment "The 'glue' point to which this point is associated."@en;
                                              rdfs:domain cim:DiagramObjectPoint;
                                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                              rdfs:label "DiagramObjectGluePoint"@en;
                                              rdfs:range cim:DiagramObjectGluePoint.
cim:DiagramObjectPoint.sequenceNumber a owl:DatatypeProperty;
                                      rdfs:comment "The sequence position of the point, used for defining the order of points for diagram objects acting as a polyline or polygon with more than one point. The attribute shall be a positive value."@en;
                                      rdfs:domain cim:DiagramObjectPoint;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                      rdfs:label "sequenceNumber"@en;
                                      rdfs:range xsd:integer.
cim:DiagramObjectPoint.xPosition a owl:DatatypeProperty;
                                 rdfs:comment "The X coordinate of this point."@en;
                                 rdfs:domain cim:DiagramObjectPoint;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "xPosition"@en;
                                 rdfs:range xsd:float.
cim:DiagramObjectPoint.yPosition a owl:DatatypeProperty;
                                 rdfs:comment "The Y coordinate of this point."@en;
                                 rdfs:domain cim:DiagramObjectPoint;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "yPosition"@en;
                                 rdfs:range xsd:float.
cim:DiagramObjectPoint.zPosition a owl:DatatypeProperty;
                                 rdfs:comment "The Z coordinate of this point."@en;
                                 rdfs:domain cim:DiagramObjectPoint;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "zPosition"@en;
                                 rdfs:range xsd:float.
cim:DiagramObjectStyle a owl:Class;
                       rdfs:comment "A reference to a style used by the originating system for a diagram object. A diagram object style describes information such as line thickness, shape such as circle or rectangle etc, and colour."@en;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "DiagramObjectStyle"@en;
                       rdfs:subClassOf cim:IdentifiedObject;
                       cimdoc:cimPackage "IEC61970.Base.DiagramLayout";
                       cimdoc:packageTier "Normative".
cim:DiagramStyle a owl:Class;
                 rdfs:comment "The diagram style refers to a style used by the originating system for a diagram. A diagram style describes information such as schematic, geographic, etc."@en;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "DiagramStyle"@en;
                 rdfs:subClassOf cim:IdentifiedObject;
                 cimdoc:cimPackage "IEC61970.Base.DiagramLayout";
                 cimdoc:packageTier "Normative".
cim:DiagramStyle.Diagram a owl:ObjectProperty;
                         rdfs:comment "A DiagramStyle can be used by many Diagrams."@en;
                         rdfs:domain cim:DiagramStyle;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                         rdfs:label "Diagram"@en;
                         rdfs:range cim:Diagram.
cim:DifferentialModel a owl:Class;
                      rdfs:comment "A set of statements describing the changes in the network model. The statement is defined in the incremental model."@en;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "DifferentialModel"@en;
                      cimdoc:cimPackage "IEC61970.InfIEC61970.InfPart303.NetworkModelProjects";
                      cimdoc:packageTier "Informative".
cim:DiscExcContIEEEDEC1A a owl:Class;
                         rdfs:comment "IEEE type DEC1A discontinuous excitation control model that boosts generator excitation to a level higher than that demanded by the voltage regulator and stabilizer immediately following a system fault. Reference: IEEE 421.5-2005, 12.2."@en;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                         rdfs:label "DiscExcContIEEEDEC1A"@en;
                         rdfs:subClassOf cim:DiscontinuousExcitationControlDynamics;
                         cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.DiscontinuousExcitationControlDynamics";
                         cimdoc:packageTier "Normative".
cim:DiscExcContIEEEDEC1A.esc a owl:DatatypeProperty;
                             rdfs:comment "Speed change reference (ESC). Typical value = 0,0015."@en;
                             rdfs:domain cim:DiscExcContIEEEDEC1A;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "esc"@en;
                             rdfs:range cim:PU.
cim:DiscExcContIEEEDEC1A.kan a owl:DatatypeProperty;
                             rdfs:comment "Discontinuous controller gain (KAN). Typical value = 400."@en;
                             rdfs:domain cim:DiscExcContIEEEDEC1A;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "kan"@en;
                             rdfs:range cim:PU.
cim:DiscExcContIEEEDEC1A.ketl a owl:DatatypeProperty;
                              rdfs:comment "Terminal voltage limiter gain (KETL). Typical value = 47."@en;
                              rdfs:domain cim:DiscExcContIEEEDEC1A;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "ketl"@en;
                              rdfs:range cim:PU.
cim:DiscExcContIEEEDEC1A.tan a owl:DatatypeProperty;
                             rdfs:comment "Discontinuous controller time constant (TAN) (>= 0). Typical value = 0,08."@en;
                             rdfs:domain cim:DiscExcContIEEEDEC1A;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "tan"@en;
                             rdfs:range cim:Seconds.
cim:DiscExcContIEEEDEC1A.td a owl:DatatypeProperty;
                            rdfs:comment "Time constant (TD) (>= 0). Typical value = 0,03."@en;
                            rdfs:domain cim:DiscExcContIEEEDEC1A;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "td"@en;
                            rdfs:range cim:Seconds.
cim:DiscExcContIEEEDEC1A.tl1 a owl:DatatypeProperty;
                             rdfs:comment "Time constant (TL1) (>= 0). Typical value = 0,025."@en;
                             rdfs:domain cim:DiscExcContIEEEDEC1A;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "tl1"@en;
                             rdfs:range cim:Seconds.
cim:DiscExcContIEEEDEC1A.tl2 a owl:DatatypeProperty;
                             rdfs:comment "Time constant (TL2) (>= 0). Typical value = 1,25."@en;
                             rdfs:domain cim:DiscExcContIEEEDEC1A;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "tl2"@en;
                             rdfs:range cim:Seconds.
cim:DiscExcContIEEEDEC1A.tw5 a owl:DatatypeProperty;
                             rdfs:comment "DEC washout time constant (TW5) (>= 0). Typical value = 5."@en;
                             rdfs:domain cim:DiscExcContIEEEDEC1A;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "tw5"@en;
                             rdfs:range cim:Seconds.
cim:DiscExcContIEEEDEC1A.val a owl:DatatypeProperty;
                             rdfs:comment "Regulator voltage reference (VAL). Typical value = 5, 5."@en;
                             rdfs:domain cim:DiscExcContIEEEDEC1A;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "val"@en;
                             rdfs:range cim:PU.
cim:DiscExcContIEEEDEC1A.vanmax a owl:DatatypeProperty;
                                rdfs:comment "Limiter for Van (VANMAX)."@en;
                                rdfs:domain cim:DiscExcContIEEEDEC1A;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "vanmax"@en;
                                rdfs:range cim:PU.
cim:DiscExcContIEEEDEC1A.vomax a owl:DatatypeProperty;
                               rdfs:comment "Limiter (VOMAX) (greater than DiscExcContIEEEDEC1A.vomin). Typical value = 0,3."@en;
                               rdfs:domain cim:DiscExcContIEEEDEC1A;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "vomax"@en;
                               rdfs:range cim:PU.
cim:DiscExcContIEEEDEC1A.vomin a owl:DatatypeProperty;
                               rdfs:comment "Limiter (VOMIN) (less than DiscExcContIEEEDEC1A.vomax). Typical value = 0,1."@en;
                               rdfs:domain cim:DiscExcContIEEEDEC1A;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "vomin"@en;
                               rdfs:range cim:PU.
cim:DiscExcContIEEEDEC1A.vsmax a owl:DatatypeProperty;
                               rdfs:comment "Limiter (VSMAX) (greater than DiscExcContIEEEDEC1A.vsmin). Typical value = 0,2."@en;
                               rdfs:domain cim:DiscExcContIEEEDEC1A;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "vsmax"@en;
                               rdfs:range cim:PU.
cim:DiscExcContIEEEDEC1A.vsmin a owl:DatatypeProperty;
                               rdfs:comment "Limiter (VSMIN) (less than DiscExcContIEEEDEC1A.vsmax). Typical value = -0,066."@en;
                               rdfs:domain cim:DiscExcContIEEEDEC1A;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "vsmin"@en;
                               rdfs:range cim:PU.
cim:DiscExcContIEEEDEC1A.vtc a owl:DatatypeProperty;
                             rdfs:comment "Terminal voltage level reference (VTC). Typical value = 0,95."@en;
                             rdfs:domain cim:DiscExcContIEEEDEC1A;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "vtc"@en;
                             rdfs:range cim:PU.
cim:DiscExcContIEEEDEC1A.vtlmt a owl:DatatypeProperty;
                               rdfs:comment "Voltage reference (VTLMT). Typical value = 1,1."@en;
                               rdfs:domain cim:DiscExcContIEEEDEC1A;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "vtlmt"@en;
                               rdfs:range cim:PU.
cim:DiscExcContIEEEDEC1A.vtm a owl:DatatypeProperty;
                             rdfs:comment "Voltage limits (VTM). Typical value = 1,13."@en;
                             rdfs:domain cim:DiscExcContIEEEDEC1A;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "vtm"@en;
                             rdfs:range cim:PU.
cim:DiscExcContIEEEDEC1A.vtn a owl:DatatypeProperty;
                             rdfs:comment "Voltage limits (VTN). Typical value = 1,12."@en;
                             rdfs:domain cim:DiscExcContIEEEDEC1A;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "vtn"@en;
                             rdfs:range cim:PU.
cim:DiscExcContIEEEDEC2A a owl:Class;
                         rdfs:comment "IEEE type DEC2A model for discontinuous excitation control. This system provides transient excitation boosting via an open-loop control as initiated by a trigger signal generated remotely. Reference: IEEE 421.5-2005 12.3."@en;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                         rdfs:label "DiscExcContIEEEDEC2A"@en;
                         rdfs:subClassOf cim:DiscontinuousExcitationControlDynamics;
                         cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.DiscontinuousExcitationControlDynamics";
                         cimdoc:packageTier "Normative".
cim:DiscExcContIEEEDEC2A.td1 a owl:DatatypeProperty;
                             rdfs:comment "Discontinuous controller time constant (TD1) (>= 0)."@en;
                             rdfs:domain cim:DiscExcContIEEEDEC2A;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "td1"@en;
                             rdfs:range cim:Seconds.
cim:DiscExcContIEEEDEC2A.td2 a owl:DatatypeProperty;
                             rdfs:comment "Discontinuous controller washout time constant (TD2) (>= 0)."@en;
                             rdfs:domain cim:DiscExcContIEEEDEC2A;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "td2"@en;
                             rdfs:range cim:Seconds.
cim:DiscExcContIEEEDEC2A.vdmax a owl:DatatypeProperty;
                               rdfs:comment "Limiter (VDMAX) (greater than DiscExcContIEEEDEC2A.vdmin)."@en;
                               rdfs:domain cim:DiscExcContIEEEDEC2A;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "vdmax"@en;
                               rdfs:range cim:PU.
cim:DiscExcContIEEEDEC2A.vdmin a owl:DatatypeProperty;
                               rdfs:comment "Limiter (VDMIN) (less than DiscExcContIEEEDEC2A.vdmax)."@en;
                               rdfs:domain cim:DiscExcContIEEEDEC2A;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "vdmin"@en;
                               rdfs:range cim:PU.
cim:DiscExcContIEEEDEC2A.vk a owl:DatatypeProperty;
                            rdfs:comment "Discontinuous controller input reference (VK)."@en;
                            rdfs:domain cim:DiscExcContIEEEDEC2A;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "vk"@en;
                            rdfs:range cim:PU.
cim:DiscExcContIEEEDEC3A a owl:Class;
                         rdfs:comment "IEEE type DEC3A model. In some systems, the stabilizer output is disconnected from the regulator immediately following a severe fault to prevent the stabilizer from competing with action of voltage regulator during the first swing. Reference: IEEE 421.5-2005 12.4."@en;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                         rdfs:label "DiscExcContIEEEDEC3A"@en;
                         rdfs:subClassOf cim:DiscontinuousExcitationControlDynamics;
                         cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.DiscontinuousExcitationControlDynamics";
                         cimdoc:packageTier "Normative".
cim:DiscExcContIEEEDEC3A.tdr a owl:DatatypeProperty;
                             rdfs:comment "Reset time delay (TDR) (>= 0)."@en;
                             rdfs:domain cim:DiscExcContIEEEDEC3A;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "tdr"@en;
                             rdfs:range cim:Seconds.
cim:DiscExcContIEEEDEC3A.vtmin a owl:DatatypeProperty;
                               rdfs:comment "Terminal undervoltage comparison level (VTMIN)."@en;
                               rdfs:domain cim:DiscExcContIEEEDEC3A;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "vtmin"@en;
                               rdfs:range cim:PU.
cim:DisconnectingCircuitBreaker a owl:Class;
                                rdfs:comment "A circuit breaking device including disconnecting function, eliminating the need for separate disconnectors."@en;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "DisconnectingCircuitBreaker"@en;
                                rdfs:subClassOf cim:Breaker;
                                cimdoc:cimPackage "IEC61970.Base.Wires";
                                cimdoc:packageTier "Normative".
cim:Disconnector a owl:Class;
                 rdfs:comment "A manually operated or motor operated mechanical switching device used for changing the connections in a circuit, or for isolating a circuit or equipment from a source of power. It is required to open or close circuits when negligible current is broken or made."@en;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "Disconnector"@en;
                 rdfs:subClassOf cim:Switch;
                 cimdoc:cimPackage "IEC61970.Base.Wires";
                 cimdoc:packageTier "Normative".
cim:DiscontinuousExcitationControlDynamics a owl:Class;
                                           rdfs:comment "Discontinuous excitation control function block whose behaviour is described by reference to a standard model or by definition of a user-defined model."@en;
                                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                           rdfs:label "DiscontinuousExcitationControlDynamics"@en;
                                           rdfs:subClassOf cim:DynamicsFunctionBlock;
                                           cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.DiscontinuousExcitationControlDynamics";
                                           cimdoc:packageTier "Normative".
cim:DiscontinuousExcitationControlDynamics.ExcitationSystemDynamics a owl:ObjectProperty;
                                                                    rdfs:comment "Excitation system model with which this discontinuous excitation control model is associated."@en;
                                                                    rdfs:domain cim:DiscontinuousExcitationControlDynamics;
                                                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                                    rdfs:label "ExcitationSystemDynamics"@en;
                                                                    rdfs:range cim:ExcitationSystemDynamics.
cim:DiscontinuousExcitationControlDynamics.RemoteInputSignal a owl:ObjectProperty;
                                                             rdfs:comment "Remote input signal used by this discontinuous excitation control system model."@en;
                                                             rdfs:domain cim:DiscontinuousExcitationControlDynamics;
                                                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                             rdfs:label "RemoteInputSignal"@en;
                                                             rdfs:range cim:RemoteInputSignal.
cim:DiscontinuousExcitationControlUserDefined a owl:Class;
                                              rdfs:comment "Discontinuous excitation control function block whose dynamic behaviour is described by a user-defined model."@en;
                                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                              rdfs:label "DiscontinuousExcitationControlUserDefined"@en;
                                              rdfs:subClassOf cim:DiscontinuousExcitationControlDynamics;
                                              cimdoc:cimPackage "IEC61970.Dynamics.UserDefinedModels";
                                              cimdoc:packageTier "Normative".
cim:DiscontinuousExcitationControlUserDefined.proprietary a owl:DatatypeProperty;
                                                          rdfs:comment "Behaviour is based on a proprietary model as opposed to a detailed model. true = user-defined model is proprietary with behaviour mutually understood by sending and receiving applications and parameters passed as general attributes false = user-defined model is explicitly defined in terms of control blocks and their input and output signals."@en;
                                                          rdfs:domain cim:DiscontinuousExcitationControlUserDefined;
                                                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                          rdfs:label "proprietary"@en;
                                                          rdfs:range xsd:boolean.
cim:Discrete a owl:Class;
             rdfs:comment "Discrete represents a discrete Measurement, i.e. a Measurement representing discrete values, e.g. a Breaker position."@en;
             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
             rdfs:label "Discrete"@en;
             rdfs:subClassOf cim:Measurement;
             cimdoc:cimPackage "IEC61970.Base.Meas";
             cimdoc:packageTier "Normative".
cim:Discrete.DiscreteValues a owl:ObjectProperty;
                            rdfs:comment "The values connected to this measurement."@en;
                            rdfs:domain cim:Discrete;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "DiscreteValues"@en;
                            rdfs:range cim:DiscreteValue.
cim:Discrete.maxValue a owl:DatatypeProperty;
                      rdfs:comment "Normal value range maximum for any of the MeasurementValue.values. Used for scaling, e.g. in bar graphs or of telemetered raw values."@en;
                      rdfs:domain cim:Discrete;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "maxValue"@en;
                      rdfs:range xsd:integer.
cim:Discrete.minValue a owl:DatatypeProperty;
                      rdfs:comment "Normal value range minimum for any of the MeasurementValue.values. Used for scaling, e.g. in bar graphs or of telemetered raw values."@en;
                      rdfs:domain cim:Discrete;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "minValue"@en;
                      rdfs:range xsd:integer.
cim:Discrete.normalValue a owl:DatatypeProperty;
                         rdfs:comment "Normal measurement value, e.g., used for percentage calculations."@en;
                         rdfs:domain cim:Discrete;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                         rdfs:label "normalValue"@en;
                         rdfs:range xsd:integer.
cim:DiscreteValue a owl:Class;
                  rdfs:comment "DiscreteValue represents a discrete MeasurementValue."@en;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "DiscreteValue"@en;
                  rdfs:subClassOf cim:MeasurementValue;
                  cimdoc:cimPackage "IEC61970.Base.Meas";
                  cimdoc:packageTier "Normative".
cim:DiscreteValue.Command a owl:ObjectProperty;
                          rdfs:comment "The Control variable associated with the MeasurementValue."@en;
                          rdfs:domain cim:DiscreteValue;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                          rdfs:label "Command"@en;
                          rdfs:range cim:Command.
cim:DiscreteValue.value a owl:DatatypeProperty;
                        rdfs:comment "The value to supervise."@en;
                        rdfs:domain cim:DiscreteValue;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                        rdfs:label "value"@en;
                        rdfs:range xsd:integer.
cim:Displacement a rdfs:Datatype;
                 rdfs:comment "Unit of displacement relative to a reference position, hence can be negative."@en;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "Displacement"@en;
                 owl:equivalentClass xsd:float;
                 cimdoc:cimPackage "IEC61970.Base.Domain";
                 cimdoc:packageTier "Normative";
                 cimdoc:unitMultiplier cim:UnitMultiplier.none;
                 cimdoc:unitSymbol cim:UnitSymbol.m.
cim:DroopSignalFeedbackKind a owl:Class;
                            rdfs:comment "Governor droop signal feedback source."@en;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "DroopSignalFeedbackKind"@en;
                            owl:equivalentClass [a owl:Class ; 
                                                 owl:oneOf (cim:DroopSignalFeedbackKind.electricalPower
                                                            cim:DroopSignalFeedbackKind.fuelValveStroke
                                                            cim:DroopSignalFeedbackKind.governorOutput
                                                            cim:DroopSignalFeedbackKind.none)];
                            cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.TurbineGovernorDynamics";
                            cimdoc:packageTier "Normative".
cim:DroopSignalFeedbackKind.electricalPower a owl:NamedIndividual,
                                              cim:DroopSignalFeedbackKind;
                                            rdfs:comment "Electrical power feedback (connection indicated as 1 in the block diagrams of models, e.g. GovCT1, GovCT2)."@en;
                                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                            rdfs:label "electricalPower"@en;
                                            cimdoc:enumCode 0 .
cim:DroopSignalFeedbackKind.fuelValveStroke a owl:NamedIndividual,
                                              cim:DroopSignalFeedbackKind;
                                            rdfs:comment "Fuel valve stroke feedback (true stroke) (connection indicated as 2 in the block diagrams of model, e.g. GovCT1, GovCT2)."@en;
                                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                            rdfs:label "fuelValveStroke"@en;
                                            cimdoc:enumCode 2 .
cim:DroopSignalFeedbackKind.governorOutput a owl:NamedIndividual,
                                             cim:DroopSignalFeedbackKind;
                                           rdfs:comment "Governor output feedback (requested stroke) (connection indicated as 3 in the block diagrams of models, e.g. GovCT1, GovCT2)."@en;
                                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                           rdfs:label "governorOutput"@en;
                                           cimdoc:enumCode 3 .
cim:DroopSignalFeedbackKind.none a owl:NamedIndividual,
                                   cim:DroopSignalFeedbackKind;
                                 rdfs:comment "No droop signal feedback, is isochronous governor."@en;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "none"@en;
                                 cimdoc:enumCode 1 .
cim:DrumBoiler a owl:Class;
               rdfs:comment "Drum boiler."@en;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "DrumBoiler"@en;
               rdfs:subClassOf cim:FossilSteamSupply;
               cimdoc:cimPackage "IEC61970.Base.Generation.GenerationTrainingSimulation";
               cimdoc:packageTier "Normative".
cim:DrumBoiler.drumBoilerRating a owl:DatatypeProperty;
                                rdfs:comment "Rating of drum boiler in steam units."@en;
                                rdfs:domain cim:DrumBoiler;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "drumBoilerRating"@en;
                                rdfs:range xsd:float.
cim:Duration a rdfs:Datatype;
             rdfs:comment """Duration as \"PnYnMnDTnHnMnS\" which conforms to ISO 8601, where nY expresses a number of years, nM a number of months, nD a number of days. The letter T separates the date expression from the time expression and, after it, nH identifies a number of hours, nM a number of minutes and nS a number of seconds. The number of seconds could be expressed as a decimal number, but all other numbers are integers."""@en;
             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
             rdfs:label "Duration"@en;
             owl:equivalentClass xsd:duration;
             cimdoc:cimPackage "IEC61970.Base.Domain";
             cimdoc:packageTier "Normative".
cim:DynamicsFunctionBlock a owl:Class;
                          rdfs:comment "Abstract parent class for all Dynamics function blocks."@en;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                          rdfs:label "DynamicsFunctionBlock"@en;
                          rdfs:subClassOf cim:IdentifiedObject;
                          cimdoc:cimPackage "IEC61970.Dynamics.StandardModels";
                          cimdoc:packageTier "Normative".
cim:DynamicsFunctionBlock.enabled a owl:DatatypeProperty;
                                  rdfs:comment "Function block used indicator. true = use of function block is enabled false = use of function block is disabled."@en;
                                  rdfs:domain cim:DynamicsFunctionBlock;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "enabled"@en;
                                  rdfs:range xsd:boolean.
cim:EarthFaultCompensator a owl:Class;
                          rdfs:comment "A conducting equipment used to represent a connection to ground which is typically used to compensate earth faults. An earth fault compensator device modelled with a single terminal implies a second terminal solidly connected to ground. If two terminals are modelled, the ground is not assumed and normal connection rules apply."@en;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                          rdfs:label "EarthFaultCompensator"@en;
                          rdfs:subClassOf cim:ConductingEquipment;
                          cimdoc:cimPackage "IEC61970.Base.Wires";
                          cimdoc:packageTier "Normative".
cim:EarthFaultCompensator.r a owl:DatatypeProperty;
                            rdfs:comment "Nominal resistance of device."@en;
                            rdfs:domain cim:EarthFaultCompensator;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "r"@en;
                            rdfs:range cim:Resistance.
cim:Emission a rdfs:Datatype;
             rdfs:comment "Quantity of emission per fuel heat content."@en;
             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
             rdfs:label "Emission"@en;
             owl:equivalentClass xsd:float;
             cimdoc:cimPackage "IEC61970.Base.Domain";
             cimdoc:packageTier "Normative";
             cimdoc:unitMultiplier cim:UnitMultiplier.none;
             cimdoc:unitSymbol cim:UnitSymbol.kgPerJ.
cim:EmissionAccount a owl:Class;
                    rdfs:comment "Accounts for tracking emissions usage and credits for thermal generating units. A unit may have zero or more emission accounts, and will typically have one for tracking usage and one for tracking credits."@en;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "EmissionAccount"@en;
                    rdfs:subClassOf cim:Curve;
                    cimdoc:cimPackage "IEC61970.Base.Generation.Production";
                    cimdoc:packageTier "Normative".
cim:EmissionAccount.emissionType a owl:ObjectProperty;
                                 rdfs:comment "The type of emission, for example sulfur dioxide (SO2). The y1AxisUnits of the curve contains the unit of measure (e.g. kg) and the emissionType is the type of emission (e.g. sulfur dioxide)."@en;
                                 rdfs:domain cim:EmissionAccount;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "emissionType"@en;
                                 rdfs:range cim:EmissionType.
cim:EmissionAccount.emissionValueSource a owl:ObjectProperty;
                                        rdfs:comment "The source of the emission value."@en;
                                        rdfs:domain cim:EmissionAccount;
                                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                        rdfs:label "emissionValueSource"@en;
                                        rdfs:range cim:EmissionValueSource.
cim:EmissionCurve a owl:Class;
                  rdfs:comment "Relationship between the unit's emission rate in units of mass per hour (Y- axis) and output active power (X-axis) for a given type of emission. This curve applies when only one type of fuel is being burned."@en;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "EmissionCurve"@en;
                  rdfs:subClassOf cim:Curve;
                  cimdoc:cimPackage "IEC61970.Base.Generation.Production";
                  cimdoc:packageTier "Normative".
cim:EmissionCurve.emissionContent a owl:DatatypeProperty;
                                  rdfs:comment "The emission content per quantity of fuel burned."@en;
                                  rdfs:domain cim:EmissionCurve;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "emissionContent"@en;
                                  rdfs:range cim:Emission.
cim:EmissionCurve.emissionType a owl:ObjectProperty;
                               rdfs:comment "The type of emission, which also gives the production rate measurement unit. The y1AxisUnits of the curve contains the unit of measure (e.g. kg) and the emissionType is the type of emission (e.g. sulfur dioxide)."@en;
                               rdfs:domain cim:EmissionCurve;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "emissionType"@en;
                               rdfs:range cim:EmissionType.
cim:EmissionCurve.isNetGrossP a owl:DatatypeProperty;
                              rdfs:comment "Flag is set to true when output is expressed in net active power."@en;
                              rdfs:domain cim:EmissionCurve;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "isNetGrossP"@en;
                              rdfs:range xsd:boolean.
cim:EmissionType a owl:Class;
                 rdfs:comment "The type of emission."@en;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "EmissionType"@en;
                 owl:equivalentClass [a owl:Class ; 
                                      owl:oneOf (cim:EmissionType.carbonDioxide
                                                 cim:EmissionType.carbonDisulfide
                                                 cim:EmissionType.chlorine
                                                 cim:EmissionType.hydrogenSulfide
                                                 cim:EmissionType.nitrogenOxide
                                                 cim:EmissionType.sulfurDioxide)];
                 cimdoc:cimPackage "IEC61970.Base.Generation.Production";
                 cimdoc:packageTier "Normative".
cim:EmissionType.carbonDioxide a owl:NamedIndividual,
                                 cim:EmissionType;
                               rdfs:comment "Carbon dioxide."@en;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "carbonDioxide"@en;
                               cimdoc:enumCode 1 .
cim:EmissionType.carbonDisulfide a owl:NamedIndividual,
                                   cim:EmissionType;
                                 rdfs:comment "Carbon disulfide."@en;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "carbonDisulfide"@en;
                                 cimdoc:enumCode 5 .
cim:EmissionType.chlorine a owl:NamedIndividual,
                            cim:EmissionType;
                          rdfs:comment "Chlorine."@en;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                          rdfs:label "chlorine"@en;
                          cimdoc:enumCode 4 .
cim:EmissionType.hydrogenSulfide a owl:NamedIndividual,
                                   cim:EmissionType;
                                 rdfs:comment "Hydrogen sulfide."@en;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "hydrogenSulfide"@en;
                                 cimdoc:enumCode 3 .
cim:EmissionType.nitrogenOxide a owl:NamedIndividual,
                                 cim:EmissionType;
                               rdfs:comment "Nitrogen oxide."@en;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "nitrogenOxide"@en;
                               cimdoc:enumCode 2 .
cim:EmissionType.sulfurDioxide a owl:NamedIndividual,
                                 cim:EmissionType;
                               rdfs:comment "Sulfur dioxide."@en;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "sulfurDioxide"@en;
                               cimdoc:enumCode 0 .
cim:EmissionValueSource a owl:Class;
                        rdfs:comment "The source of the emission value."@en;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                        rdfs:label "EmissionValueSource"@en;
                        owl:equivalentClass [a owl:Class ; 
                                             owl:oneOf (cim:EmissionValueSource.calculated
                                                        cim:EmissionValueSource.measured)];
                        cimdoc:cimPackage "IEC61970.Base.Generation.Production";
                        cimdoc:packageTier "Normative".
cim:EmissionValueSource.calculated a owl:NamedIndividual,
                                     cim:EmissionValueSource;
                                   rdfs:comment "Calculated."@en;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                   rdfs:label "calculated"@en;
                                   cimdoc:enumCode 1 .
cim:EmissionValueSource.measured a owl:NamedIndividual,
                                   cim:EmissionValueSource;
                                 rdfs:comment "Measured."@en;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "measured"@en;
                                 cimdoc:enumCode 0 .
cim:EnergyArea a owl:Class;
               rdfs:comment "Describes an area having energy production or consumption. Specializations are intended to support the load allocation function as typically required in energy management systems or planning studies to allocate hypothesized load levels to individual load points for power flow analysis. Often the energy area can be linked to both measured and forecast load levels."@en;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "EnergyArea"@en;
               rdfs:subClassOf cim:IdentifiedObject;
               cimdoc:cimPackage "IEC61970.Base.LoadModel";
               cimdoc:packageTier "Normative".
cim:EnergyComponent a owl:Class;
                    rdfs:comment "Represents an energy component in the energy area."@en;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "EnergyComponent"@en;
                    rdfs:subClassOf cim:IdentifiedObject;
                    cimdoc:cimPackage "IEC61970.InfIEC61970.EnergyArea";
                    cimdoc:packageTier "Informative".
cim:EnergyComponent.m_EnergyGroup a owl:ObjectProperty;
                                  rdfs:comment "The energy group associated with this energy component."@en;
                                  rdfs:domain cim:EnergyComponent;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
