               cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.TurbineGovernorDynamics";
               cimdoc:packageTier "Normative".
cim:GovHydroDD.aturb a owl:DatatypeProperty;
                     rdfs:comment "Turbine numerator multiplier (Aturb) (see parameter detail 3). Typical value = -1."@en;
                     rdfs:domain cim:GovHydroDD;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                     rdfs:label "aturb"@en;
                     rdfs:range cim:PU.
cim:GovHydroDD.bturb a owl:DatatypeProperty;
                     rdfs:comment "Turbine denominator multiplier (Bturb) (see parameter detail 3). Typical value = 0,5."@en;
                     rdfs:domain cim:GovHydroDD;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                     rdfs:label "bturb"@en;
                     rdfs:range cim:PU.
cim:GovHydroDD.db1 a owl:DatatypeProperty;
                   rdfs:comment "Intentional dead-band width (db1). Unit = Hz. Typical value = 0."@en;
                   rdfs:domain cim:GovHydroDD;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "db1"@en;
                   rdfs:range cim:Frequency.
cim:GovHydroDD.db2 a owl:DatatypeProperty;
                   rdfs:comment "Unintentional dead-band (db2). Unit = MW. Typical value = 0."@en;
                   rdfs:domain cim:GovHydroDD;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
