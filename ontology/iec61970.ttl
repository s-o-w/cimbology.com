cim:GovHydro4.tg a owl:DatatypeProperty;
                 rdfs:comment "Gate servo time constant (Tg) (> 0). Typical value = 0,5."@en;
                 rdfs:domain cim:GovHydro4;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "tg"@en;
                 rdfs:range cim:Seconds.
cim:GovHydro4.tp a owl:DatatypeProperty;
                 rdfs:comment "Pilot servo time constant (Tp) (>= 0). Typical value = 0,1."@en;
                 rdfs:domain cim:GovHydro4;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "tp"@en;
                 rdfs:range cim:Seconds.
cim:GovHydro4.tr a owl:DatatypeProperty;
                 rdfs:comment "Dashpot time constant (Tr) (>= 0). Typical value = 5."@en;
                 rdfs:domain cim:GovHydro4;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "tr"@en;
                 rdfs:range cim:Seconds.
cim:GovHydro4.tw a owl:DatatypeProperty;
                 rdfs:comment "Water inertia time constant (Tw) (> 0). Typical value = 1."@en;
                 rdfs:domain cim:GovHydro4;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "tw"@en;
                 rdfs:range cim:Seconds.
cim:GovHydro4.uc a owl:DatatypeProperty;
                 rdfs:comment "Max gate closing velocity (Uc). Typical value = 0,2."@en;
                 rdfs:domain cim:GovHydro4;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "uc"@en;
