                                 rdfs:comment "The terminal to be summed."@en;
                                 rdfs:domain cim:BranchGroupTerminal;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "Terminal"@en;
                                 rdfs:range cim:Terminal.
cim:BranchGroupTerminal.positiveFlowIn a owl:DatatypeProperty;
                                       rdfs:comment "The flow into the terminal is summed if set true. The flow out of the terminal is summed if set false."@en;
                                       rdfs:domain cim:BranchGroupTerminal;
                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                       rdfs:label "positiveFlowIn"@en;
                                       rdfs:range xsd:boolean.
cim:Breaker a owl:Class;
            rdfs:comment "A mechanical switching device capable of making, carrying, and breaking currents under normal circuit conditions and also making, carrying for a specified time, and breaking currents under specified abnormal circuit conditions e.g. those of short circuit."@en;
            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
            rdfs:label "Breaker"@en;
            rdfs:subClassOf cim:ProtectedSwitch;
            cimdoc:cimPackage "IEC61970.Base.Wires";
            cimdoc:packageTier "Normative".
cim:Breaker.inTransitTime a owl:DatatypeProperty;
                          rdfs:comment "The transition time from open to close."@en;
                          rdfs:domain cim:Breaker;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                          rdfs:label "inTransitTime"@en;
                          rdfs:range cim:Seconds.
cim:BreakerConfiguration a owl:Class;
                         rdfs:comment "Switching arrangement for bay."@en;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                         rdfs:label "BreakerConfiguration"@en;
                         owl:equivalentClass [a owl:Class ; 
