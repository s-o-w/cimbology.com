cim:Pss2B.ks2 a owl:DatatypeProperty;
              rdfs:comment "Gain on signal #2 (Ks2). Typical value = 0,2."@en;
              rdfs:domain cim:Pss2B;
              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
              rdfs:label "ks2"@en;
              rdfs:range cim:PU.
cim:Pss2B.ks3 a owl:DatatypeProperty;
              rdfs:comment "Gain on signal #2 input before ramp-tracking filter (Ks3). Typical value = 1."@en;
              rdfs:domain cim:Pss2B;
              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
              rdfs:label "ks3"@en;
              rdfs:range cim:PU.
cim:Pss2B.ks4 a owl:DatatypeProperty;
              rdfs:comment "Gain on signal #2 input after ramp-tracking filter (Ks4). Typical value = 1."@en;
              rdfs:domain cim:Pss2B;
              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
              rdfs:label "ks4"@en;
              rdfs:range cim:PU.
cim:Pss2B.m a owl:DatatypeProperty;
