@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix cim: <http://iec.ch/TC57/CIM100#>.
@prefix cimdoc: <https://cimbology.com/ontology/cimdoc#>.

cim:ACDCConverter a owl:Class;
                  rdfs:comment "A unit with valves for three phases, together with unit control equipment, essential protective and switching devices, DC storage capacitors, phase reactors and auxiliaries, if any, used for conversion."@en;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "ACDCConverter"@en;
                  rdfs:subClassOf cim:ConductingEquipment;
                  cimdoc:cimPackage "IEC61970.Base.DC";
                  cimdoc:packageTier "Normative".
cim:ACDCConverter.PccTerminal a owl:ObjectProperty;
                              rdfs:comment "Point of common coupling terminal for this converter DC side. It is typically the terminal on the power transformer (or switch) closest to the AC network."@en;
                              rdfs:domain cim:ACDCConverter;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "PccTerminal"@en;
                              rdfs:range cim:Terminal.
cim:ACDCConverter.baseS a owl:DatatypeProperty;
                        rdfs:comment "Base apparent power of the converter pole. The attribute shall be a positive value."@en;
                        rdfs:domain cim:ACDCConverter;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                        rdfs:label "baseS"@en;
                        rdfs:range cim:ApparentPower.
cim:ACDCConverter.idc a owl:DatatypeProperty;
                      rdfs:comment "Converter DC current, also called Id. It is converter�s state variable, result from power flow."@en;
                      rdfs:domain cim:ACDCConverter;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "idc"@en;
                      rdfs:range cim:CurrentFlow.
cim:ACDCConverter.idleLoss a owl:DatatypeProperty;
                           rdfs:comment "Active power loss in pole at no power transfer. It is converter�s configuration data used in power flow. The attribute shall be a positive value."@en;
                           rdfs:domain cim:ACDCConverter;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "idleLoss"@en;
                           rdfs:range cim:ActivePower.
cim:ACDCConverter.maxP a owl:DatatypeProperty;
                       rdfs:comment "Maximum active power limit. The value is overwritten by values of VsCapabilityCurve, if present."@en;
                       rdfs:domain cim:ACDCConverter;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "maxP"@en;
                       rdfs:range cim:ActivePower.
cim:ACDCConverter.maxUdc a owl:DatatypeProperty;
                         rdfs:comment "The maximum voltage on the DC side at which the converter should operate. It is converter�s configuration data used in power flow. The attribute shall be a positive value."@en;
                         rdfs:domain cim:ACDCConverter;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                         rdfs:label "maxUdc"@en;
                         rdfs:range cim:Voltage.
cim:ACDCConverter.minP a owl:DatatypeProperty;
                       rdfs:comment "Minimum active power limit. The value is overwritten by values of VsCapabilityCurve, if present."@en;
                       rdfs:domain cim:ACDCConverter;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "minP"@en;
                       rdfs:range cim:ActivePower.
cim:ACDCConverter.minUdc a owl:DatatypeProperty;
                         rdfs:comment "The minimum voltage on the DC side at which the converter should operate. It is converter�s configuration data used in power flow. The attribute shall be a positive value."@en;
                         rdfs:domain cim:ACDCConverter;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                         rdfs:label "minUdc"@en;
                         rdfs:range cim:Voltage.
cim:ACDCConverter.numberOfValves a owl:DatatypeProperty;
                                 rdfs:comment "Number of valves in the converter. Used in loss calculations."@en;
                                 rdfs:domain cim:ACDCConverter;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "numberOfValves"@en;
                                 rdfs:range xsd:integer.
cim:ACDCConverter.p a owl:DatatypeProperty;
                    rdfs:comment "Active power at the point of common coupling. Load sign convention is used, i.e. positive sign means flow out from a node. Starting value for a steady state solution in the case a simplified power flow model is used."@en;
                    rdfs:domain cim:ACDCConverter;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "p"@en;
                    rdfs:range cim:ActivePower.
cim:ACDCConverter.poleLossP a owl:DatatypeProperty;
                            rdfs:comment "The active power loss at a DC Pole = idleLoss + switchingLoss*|Idc| + resitiveLoss*Idc^2. For lossless operation Pdc=Pac. For rectifier operation with losses Pdc=Pac-lossP. For inverter operation with losses Pdc=Pac+lossP. It is converter�s state variable used in power flow. The attribute shall be a positive value."@en;
                            rdfs:domain cim:ACDCConverter;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "poleLossP"@en;
                            rdfs:range cim:ActivePower.
cim:ACDCConverter.q a owl:DatatypeProperty;
                    rdfs:comment "Reactive power at the point of common coupling. Load sign convention is used, i. e. positive sign means flow out from a node. Starting value for a steady state solution in the case a simplified power flow model is used."@en;
                    rdfs:domain cim:ACDCConverter;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "q"@en;
                    rdfs:range cim:ReactivePower.
cim:ACDCConverter.ratedUdc a owl:DatatypeProperty;
                           rdfs:comment "Rated converter DC voltage, also called UdN. The attribute shall be a positive value. It is converter�s configuration data used in power flow. For instance a bipolar HVDC link with value 200 kV has a 400kV difference between the dc lines."@en;
                           rdfs:domain cim:ACDCConverter;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "ratedUdc"@en;
                           rdfs:range cim:Voltage.
cim:ACDCConverter.resistiveLoss a owl:DatatypeProperty;
                                rdfs:comment "It is converter�s configuration data used in power flow. Refer to poleLossP. The attribute shall be a positive value."@en;
                                rdfs:domain cim:ACDCConverter;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "resistiveLoss"@en;
                                rdfs:range cim:Resistance.
cim:ACDCConverter.switchingLoss a owl:DatatypeProperty;
                                rdfs:comment "Switching losses, relative to the base apparent power 'baseS'. Refer to poleLossP. The attribute shall be a positive value."@en;
                                rdfs:domain cim:ACDCConverter;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "switchingLoss"@en;
                                rdfs:range cim:ActivePowerPerCurrentFlow.
cim:ACDCConverter.targetPpcc a owl:DatatypeProperty;
                             rdfs:comment "Real power injection target in AC grid, at point of common coupling. Load sign convention is used, i.e. positive sign means flow out from a node."@en;
                             rdfs:domain cim:ACDCConverter;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "targetPpcc"@en;
                             rdfs:range cim:ActivePower.
cim:ACDCConverter.targetUdc a owl:DatatypeProperty;
                            rdfs:comment "Target value for DC voltage magnitude. The attribute shall be a positive value."@en;
                            rdfs:domain cim:ACDCConverter;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "targetUdc"@en;
                            rdfs:range cim:Voltage.
cim:ACDCConverter.uc a owl:DatatypeProperty;
                     rdfs:comment "Line-to-line converter voltage, the voltage at the AC side of the valve. It is converter�s state variable, result from power flow. The attribute shall be a positive value."@en;
                     rdfs:domain cim:ACDCConverter;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                     rdfs:label "uc"@en;
                     rdfs:range cim:Voltage.
cim:ACDCConverter.udc a owl:DatatypeProperty;
                      rdfs:comment "Converter voltage at the DC side, also called Ud. It is converter�s state variable, result from power flow. The attribute shall be a positive value."@en;
                      rdfs:domain cim:ACDCConverter;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "udc"@en;
                      rdfs:range cim:Voltage.
cim:ACDCConverter.valveU0 a owl:DatatypeProperty;
                          rdfs:comment "Valve threshold voltage, also called Uvalve. Forward voltage drop when the valve is conducting. Used in loss calculations, i.e. the switchLoss depend on numberOfValves * valveU0."@en;
                          rdfs:domain cim:ACDCConverter;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                          rdfs:label "valveU0"@en;
                          rdfs:range cim:Voltage.
cim:ACDCConverterDCTerminal a owl:Class;
                            rdfs:comment "A DC electrical connection point at the AC/DC converter. The AC/DC converter is electrically connected also to the AC side. The AC connection is inherited from the AC conducting equipment in the same way as any other AC equipment. The AC/DC converter DC terminal is separate from generic DC terminal to restrict the connection with the AC side to AC/DC converter and so that no other DC conducting equipment can be connected to the AC side."@en;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "ACDCConverterDCTerminal"@en;
                            rdfs:subClassOf cim:DCBaseTerminal;
                            cimdoc:cimPackage "IEC61970.Base.DC";
                            cimdoc:packageTier "Normative".
cim:ACDCConverterDCTerminal.DCConductingEquipment a owl:ObjectProperty;
                                                  rdfs:comment "A DC converter terminal belong to an DC converter."@en;
                                                  rdfs:domain cim:ACDCConverterDCTerminal;
                                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                  rdfs:label "DCConductingEquipment"@en;
                                                  rdfs:range cim:ACDCConverter.
cim:ACDCConverterDCTerminal.polarity a owl:ObjectProperty;
                                     rdfs:comment "Represents the normal network polarity condition. Depending on the converter configuration the value shall be set as follows: - For a monopole with two converter terminals use DCPolarityKind �positive� and �negative�. - For a bi-pole or symmetric monopole with three converter terminals use DCPolarityKind �positive�, �middle� and �negative�."@en;
                                     rdfs:domain cim:ACDCConverterDCTerminal;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                     rdfs:label "polarity"@en;
                                     rdfs:range cim:DCPolarityKind.
cim:ACDCTerminal a owl:Class;
                 rdfs:comment "An electrical connection point (AC or DC) to a piece of conducting equipment. Terminals are connected at physical connection points called connectivity nodes."@en;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "ACDCTerminal"@en;
                 rdfs:subClassOf cim:IdentifiedObject;
                 cimdoc:cimPackage "IEC61970.Base.Core";
                 cimdoc:packageTier "Normative".
cim:ACDCTerminal.connected a owl:DatatypeProperty;
                           rdfs:comment "The connected status is related to a bus-branch model and the topological node to terminal relation. True implies the terminal is connected to the related topological node and false implies it is not. In a bus-branch model, the connected status is used to tell if equipment is disconnected without having to change the connectivity described by the topological node to terminal relation. A valid case is that conducting equipment can be connected in one end and open in the other. In particular for an AC line segment, where the reactive line charging can be significant, this is a relevant case."@en;
                           rdfs:domain cim:ACDCTerminal;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "connected"@en;
                           rdfs:range xsd:boolean.
cim:ACDCTerminal.sequenceNumber a owl:DatatypeProperty;
                                rdfs:comment """The orientation of the terminal connections for a multiple terminal conducting equipment. The sequence numbering starts with 1 and additional terminals should follow in increasing order. The first terminal is the \"starting point\" for a two terminal branch."""@en;
                                rdfs:domain cim:ACDCTerminal;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "sequenceNumber"@en;
                                rdfs:range xsd:integer.
cim:ACLineSegment a owl:Class;
                  rdfs:comment "A wire or combination of wires, with consistent electrical characteristics, building a single electrical system, used to carry alternating current between points in the power system. For symmetrical, transposed three phase lines, it is sufficient to use attributes of the line segment, which describe impedances and admittances for the entire length of the segment. Additionally impedances can be computed by using length and associated per length impedances. The BaseVoltage at the two ends of ACLineSegments in a Line shall have the same BaseVoltage.nominalVoltage. However, boundary lines may have slightly different BaseVoltage.nominalVoltages and variation is allowed. Larger voltage difference in general requires use of an equivalent branch."@en;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "ACLineSegment"@en;
                  rdfs:subClassOf cim:Conductor;
                  cimdoc:cimPackage "IEC61970.Base.Wires";
                  cimdoc:packageTier "Normative".
cim:ACLineSegment.Clamp a owl:ObjectProperty;
                        rdfs:comment "The clamps connected to the line segment."@en;
                        rdfs:domain cim:ACLineSegment;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                        rdfs:label "Clamp"@en;
                        rdfs:range cim:Clamp.
cim:ACLineSegment.WireSpacingInfo a owl:ObjectProperty;
                                  rdfs:comment "The wire spacing information that applies to this AC line segment"@en;
                                  rdfs:domain cim:ACLineSegment;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "WireSpacingInfo"@en;
                                  rdfs:range cim:WireSpacingInfo.
cim:ACLineSegment.b0ch a owl:DatatypeProperty;
                       rdfs:comment "Zero sequence shunt (charging) susceptance, uniformly distributed, of the entire line section."@en;
                       rdfs:domain cim:ACLineSegment;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "b0ch"@en;
                       rdfs:range cim:Susceptance.
cim:ACLineSegment.bch a owl:DatatypeProperty;
                      rdfs:comment "Positive sequence shunt (charging) susceptance, uniformly distributed, of the entire line section. This value represents the full charging over the full length of the line."@en;
                      rdfs:domain cim:ACLineSegment;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "bch"@en;
                      rdfs:range cim:Susceptance.
cim:ACLineSegment.g0ch a owl:DatatypeProperty;
                       rdfs:comment "Zero sequence shunt (charging) conductance, uniformly distributed, of the entire line section."@en;
                       rdfs:domain cim:ACLineSegment;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "g0ch"@en;
                       rdfs:range cim:Conductance.
cim:ACLineSegment.gch a owl:DatatypeProperty;
                      rdfs:comment "Positive sequence shunt (charging) conductance, uniformly distributed, of the entire line section."@en;
                      rdfs:domain cim:ACLineSegment;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "gch"@en;
                      rdfs:range cim:Conductance.
cim:ACLineSegment.r a owl:DatatypeProperty;
                    rdfs:comment "Positive sequence series resistance of the entire line section."@en;
                    rdfs:domain cim:ACLineSegment;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "r"@en;
                    rdfs:range cim:Resistance.
cim:ACLineSegment.r0 a owl:DatatypeProperty;
                     rdfs:comment "Zero sequence series resistance of the entire line section."@en;
                     rdfs:domain cim:ACLineSegment;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                     rdfs:label "r0"@en;
                     rdfs:range cim:Resistance.
cim:ACLineSegment.shortCircuitEndTemperature a owl:DatatypeProperty;
                                             rdfs:comment "Maximum permitted temperature at the end of SC for the calculation of minimum short-circuit currents. Used for short circuit data exchange according to IEC 60909."@en;
                                             rdfs:domain cim:ACLineSegment;
                                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                             rdfs:label "shortCircuitEndTemperature"@en;
                                             rdfs:range cim:Temperature.
cim:ACLineSegment.x a owl:DatatypeProperty;
                    rdfs:comment "Positive sequence series reactance of the entire line section."@en;
                    rdfs:domain cim:ACLineSegment;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "x"@en;
                    rdfs:range cim:Reactance.
cim:ACLineSegment.x0 a owl:DatatypeProperty;
                     rdfs:comment "Zero sequence series reactance of the entire line section."@en;
                     rdfs:domain cim:ACLineSegment;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                     rdfs:label "x0"@en;
                     rdfs:range cim:Reactance.
cim:ACLineSegmentPhase a owl:Class;
                       rdfs:comment "Represents a single wire of an alternating current line segment."@en;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "ACLineSegmentPhase"@en;
                       rdfs:subClassOf cim:PowerSystemResource;
                       cimdoc:cimPackage "IEC61970.Base.Wires";
                       cimdoc:packageTier "Normative".
cim:ACLineSegmentPhase.ACLineSegment a owl:ObjectProperty;
                                     rdfs:comment "The line segment to which the phase belongs."@en;
                                     rdfs:domain cim:ACLineSegmentPhase;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                     rdfs:label "ACLineSegment"@en;
                                     rdfs:range cim:ACLineSegment.
cim:ACLineSegmentPhase.WireInfo a owl:ObjectProperty;
                                rdfs:comment "Wire information contributing to this AC line segment phase information."@en;
                                rdfs:domain cim:ACLineSegmentPhase;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "WireInfo"@en;
                                rdfs:range cim:WireInfo.
cim:ACLineSegmentPhase.phase a owl:ObjectProperty;
                             rdfs:comment "The phase connection of the wire at both ends."@en;
                             rdfs:domain cim:ACLineSegmentPhase;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "phase"@en;
                             rdfs:range cim:SinglePhaseKind.
cim:ACLineSegmentPhase.sequenceNumber a owl:DatatypeProperty;
                                      rdfs:comment "Number designation for this line segment phase. Each line segment phase within a line segment should have a unique sequence number. This is useful for unbalanced modelling to bind the mathematical model (PhaseImpedanceData of PerLengthPhaseImpedance) with the connectivity model (this class) and the physical model (WirePosition) without tight coupling."@en;
                                      rdfs:domain cim:ACLineSegmentPhase;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                      rdfs:label "sequenceNumber"@en;
                                      rdfs:range xsd:integer.
cim:Accumulator a owl:Class;
                rdfs:comment "Accumulator represents an accumulated (counted) Measurement, e.g. an energy value."@en;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "Accumulator"@en;
                rdfs:subClassOf cim:Measurement;
                cimdoc:cimPackage "IEC61970.Base.Meas";
                cimdoc:packageTier "Normative".
cim:Accumulator.AccumulatorValues a owl:ObjectProperty;
                                  rdfs:comment "The values connected to this measurement."@en;
                                  rdfs:domain cim:Accumulator;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "AccumulatorValues"@en;
                                  rdfs:range cim:AccumulatorValue.
cim:Accumulator.LimitSets a owl:ObjectProperty;
                          rdfs:comment "A measurement may have zero or more limit ranges defined for it."@en;
                          rdfs:domain cim:Accumulator;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                          rdfs:label "LimitSets"@en;
                          rdfs:range cim:AccumulatorLimitSet.
cim:Accumulator.maxValue a owl:DatatypeProperty;
                         rdfs:comment "Normal value range maximum for any of the MeasurementValue.values. Used for scaling, e.g. in bar graphs or of telemetered raw values."@en;
                         rdfs:domain cim:Accumulator;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                         rdfs:label "maxValue"@en;
                         rdfs:range xsd:integer.
cim:AccumulatorLimit a owl:Class;
                     rdfs:comment "Limit values for Accumulator measurements."@en;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                     rdfs:label "AccumulatorLimit"@en;
                     rdfs:subClassOf cim:Limit;
                     cimdoc:cimPackage "IEC61970.Base.Meas";
                     cimdoc:packageTier "Normative".
cim:AccumulatorLimit.value a owl:DatatypeProperty;
                           rdfs:comment "The value to supervise against. The value is positive."@en;
                           rdfs:domain cim:AccumulatorLimit;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "value"@en;
                           rdfs:range xsd:integer.
cim:AccumulatorLimitSet a owl:Class;
                        rdfs:comment "An AccumulatorLimitSet specifies a set of Limits that are associated with an Accumulator measurement."@en;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                        rdfs:label "AccumulatorLimitSet"@en;
                        rdfs:subClassOf cim:LimitSet;
                        cimdoc:cimPackage "IEC61970.Base.Meas";
                        cimdoc:packageTier "Normative".
cim:AccumulatorLimitSet.Limits a owl:ObjectProperty;
                               rdfs:comment "The limit values used for supervision of Measurements."@en;
                               rdfs:domain cim:AccumulatorLimitSet;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "Limits"@en;
                               rdfs:range cim:AccumulatorLimit.
cim:AccumulatorReset a owl:Class;
                     rdfs:comment "This command resets the counter value to zero."@en;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                     rdfs:label "AccumulatorReset"@en;
                     rdfs:subClassOf cim:Control;
                     cimdoc:cimPackage "IEC61970.Base.Meas";
                     cimdoc:packageTier "Normative".
cim:AccumulatorReset.AccumulatorValue a owl:ObjectProperty;
                                      rdfs:comment "The accumulator value that is reset by the command."@en;
                                      rdfs:domain cim:AccumulatorReset;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                      rdfs:label "AccumulatorValue"@en;
                                      rdfs:range cim:AccumulatorValue.
cim:AccumulatorValue a owl:Class;
                     rdfs:comment "AccumulatorValue represents an accumulated (counted) MeasurementValue."@en;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                     rdfs:label "AccumulatorValue"@en;
                     rdfs:subClassOf cim:MeasurementValue;
                     cimdoc:cimPackage "IEC61970.Base.Meas";
                     cimdoc:packageTier "Normative".
cim:AccumulatorValue.value a owl:DatatypeProperty;
                           rdfs:comment "The value to supervise. The value is positive."@en;
                           rdfs:domain cim:AccumulatorValue;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "value"@en;
                           rdfs:range xsd:integer.
cim:ActivePower a rdfs:Datatype;
                rdfs:comment "Product of RMS value of the voltage and the RMS value of the in-phase component of the current."@en;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "ActivePower"@en;
                owl:equivalentClass xsd:float;
                cimdoc:cimPackage "IEC61970.Base.Domain";
                cimdoc:packageTier "Normative";
                cimdoc:unitSymbol cim:UnitSymbol.W.
cim:ActivePowerChangeRate a rdfs:Datatype;
                          rdfs:comment "Rate of change of active power per time."@en;
