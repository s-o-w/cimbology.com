cim:LoadComposite.pfrac a owl:DatatypeProperty;
                        rdfs:comment "Fraction of constant-power load to be represented by this motor model (PFRAC) (greater than or equal to 0,0 and less than or equal to 1,0). Typical value = 0,5."@en;
                        rdfs:domain cim:LoadComposite;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                        rdfs:label "pfrac"@en;
