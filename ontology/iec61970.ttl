cim:PssIEEE4B a owl:Class;
              rdfs:comment "IEEE 421.5-2005 type PSS4B power system stabilizer. The PSS4B model represents a structure based on multiple working frequency bands. Three separate bands, respectively dedicated to the low-, intermediate- and high-frequency modes of oscillations, are used in this delta omega (speed input) PSS. There is an error in the in IEEE 421.5-2005 PSS4B model: the Pe input should read �Pe. This implies that the input Pe needs to be multiplied by -1. Reference: IEEE 4B 421.5-2005, 8.4. Parameter details: This model has 2 input signals. They have the following fixed types (expressed in terms of InputSignalKind values): the first one is of rotorAngleFrequencyDeviation type and the second one is of generatorElectricalPower type."@en;
              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
              rdfs:label "PssIEEE4B"@en;
              rdfs:subClassOf cim:PowerSystemStabilizerDynamics;
              cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.PowerSystemStabilizerDynamics";
              cimdoc:packageTier "Normative".
cim:PssIEEE4B.bwh1 a owl:DatatypeProperty;
                   rdfs:comment "Notch filter 1 (high-frequency band): three dB bandwidth (Bwi)."@en;
                   rdfs:domain cim:PssIEEE4B;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "bwh1"@en;
                   rdfs:range xsd:float.
