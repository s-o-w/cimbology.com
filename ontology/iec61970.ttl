                rdfs:comment "Rated temperature (Tr). Unit = �C depending on parameters Af1 and Bf1."@en;
                rdfs:domain cim:GovGAST2;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "tr"@en;
