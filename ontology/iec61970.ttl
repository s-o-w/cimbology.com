cim:GovGAST2.t5 a owl:DatatypeProperty;
                rdfs:comment "Temperature control time constant (T5) (>= 0)."@en;
                rdfs:domain cim:GovGAST2;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
