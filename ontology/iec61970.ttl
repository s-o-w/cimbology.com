cim:GovSteamSGO.t1 a owl:DatatypeProperty;
                   rdfs:comment "Controller lag (T1) (>= 0)."@en;
                   rdfs:domain cim:GovSteamSGO;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "t1"@en;
