cim:WindUVRTQcontrolModeKind.mode1 a owl:NamedIndividual,
                                     cim:WindUVRTQcontrolModeKind;
                                   rdfs:comment "Reactive current injection controlled as the pre-fault value plus an additional voltage dependent reactive current injection (MqUVRT equals 1)."@en;
