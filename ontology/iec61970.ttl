                                  rdfs:subClassOf cim:VoltageCompensatorDynamics;
                                  cimdoc:cimPackage "IEC61970.Dynamics.UserDefinedModels";
                                  cimdoc:packageTier "Normative".
cim:VoltageCompensatorUserDefined.proprietary a owl:DatatypeProperty;
                                              rdfs:comment "Behaviour is based on a proprietary model as opposed to a detailed model. true = user-defined model is proprietary with behaviour mutually understood by sending and receiving applications and parameters passed as general attributes false = user-defined model is explicitly defined in terms of control blocks and their input and output signals."@en;
                                              rdfs:domain cim:VoltageCompensatorUserDefined;
                                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                              rdfs:label "proprietary"@en;
                                              rdfs:range xsd:boolean.
cim:VoltageControlZone a owl:Class;
                       rdfs:comment "An area of the power system network which is defined for secondary voltage control purposes. A voltage control zone consists of a collection of substations with a designated bus bar section whose voltage will be controlled."@en;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "VoltageControlZone"@en;
                       rdfs:subClassOf cim:PowerSystemResource;
                       cimdoc:cimPackage "IEC61970.Base.Wires";
                       cimdoc:packageTier "Normative".
cim:VoltageLevel a owl:Class;
                 rdfs:comment "A collection of equipment at one common system voltage forming a switchgear. The equipment typically consists of breakers, busbars, instrumentation, control, regulation and protection devices as well as assemblies of all these."@en;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "VoltageLevel"@en;
                 rdfs:subClassOf cim:EquipmentContainer;
                 cimdoc:cimPackage "IEC61970.Base.Core";
                 cimdoc:packageTier "Normative".
cim:VoltageLevel.BaseVoltage a owl:ObjectProperty;
                             rdfs:comment "The base voltage used for all equipment within the voltage level."@en;
                             rdfs:domain cim:VoltageLevel;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "BaseVoltage"@en;
                             rdfs:range cim:BaseVoltage.
cim:VoltageLevel.Bays a owl:ObjectProperty;
                      rdfs:comment "The bays within this voltage level."@en;
                      rdfs:domain cim:VoltageLevel;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "Bays"@en;
                      rdfs:range cim:Bay.
cim:VoltageLevel.highVoltageLimit a owl:DatatypeProperty;
                                  rdfs:comment "The bus bar's high voltage limit. The limit applies to all equipment and nodes contained in a given VoltageLevel. It is not required that it is exchanged in pair with lowVoltageLimit. It is preferable to use operational VoltageLimit, which prevails, if present."@en;
                                  rdfs:domain cim:VoltageLevel;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "highVoltageLimit"@en;
                                  rdfs:range cim:Voltage.
cim:VoltageLevel.lowVoltageLimit a owl:DatatypeProperty;
                                 rdfs:comment "The bus bar's low voltage limit. The limit applies to all equipment and nodes contained in a given VoltageLevel. It is not required that it is exchanged in pair with highVoltageLimit. It is preferable to use operational VoltageLimit, which prevails, if present."@en;
                                 rdfs:domain cim:VoltageLevel;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "lowVoltageLimit"@en;
                                 rdfs:range cim:Voltage.
cim:VoltageLimit a owl:Class;
                 rdfs:comment "Operational limit applied to voltage. The use of operational VoltageLimit is preferred instead of limits defined at VoltageLevel. The operational VoltageLimits are used, if present."@en;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "VoltageLimit"@en;
                 rdfs:subClassOf cim:OperationalLimit;
                 cimdoc:cimPackage "IEC61970.Base.OperationalLimits";
                 cimdoc:packageTier "Normative".
cim:VoltageLimit.normalValue a owl:DatatypeProperty;
                             rdfs:comment "The normal limit on voltage. High or low limit nature of the limit depends upon the properties of the operational limit type. The attribute shall be a positive value or zero."@en;
                             rdfs:domain cim:VoltageLimit;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "normalValue"@en;
                             rdfs:range cim:Voltage.
cim:VoltageLimit.value a owl:DatatypeProperty;
                       rdfs:comment "Limit on voltage. High or low limit nature of the limit depends upon the properties of the operational limit type. The attribute shall be a positive value or zero."@en;
                       rdfs:domain cim:VoltageLimit;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "value"@en;
                       rdfs:range cim:Voltage.
cim:VoltagePerReactivePower a rdfs:Datatype;
                            rdfs:comment "Voltage variation with reactive power."@en;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "VoltagePerReactivePower"@en;
                            owl:equivalentClass xsd:float;
                            cimdoc:cimPackage "IEC61970.Base.Domain";
                            cimdoc:packageTier "Normative";
                            cimdoc:unitSymbol cim:UnitSymbol.VPerVAr.
cim:Volume a rdfs:Datatype;
           rdfs:comment "Volume."@en;
           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
           rdfs:label "Volume"@en;
           owl:equivalentClass xsd:float;
           cimdoc:cimPackage "IEC61970.Base.Domain";
           cimdoc:packageTier "Normative";
           cimdoc:unitSymbol cim:UnitSymbol.m3.
cim:VolumeFlowRate a rdfs:Datatype;
                   rdfs:comment "Volume per time."@en;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "VolumeFlowRate"@en;
                   owl:equivalentClass xsd:float;
                   cimdoc:cimPackage "IEC61970.Base.Domain";
                   cimdoc:packageTier "Normative";
                   cimdoc:unitMultiplier cim:UnitMultiplier.none;
                   cimdoc:unitSymbol cim:UnitSymbol.m3Pers.
cim:VsCapabilityCurve a owl:Class;
                      rdfs:comment "The P-Q capability curve for a voltage source converter, with P on X-axis and Qmin and Qmax on Y1-axis and Y2-axis."@en;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "VsCapabilityCurve"@en;
                      rdfs:subClassOf cim:Curve;
                      cimdoc:cimPackage "IEC61970.Base.DC";
                      cimdoc:packageTier "Normative".
cim:VsConverter a owl:Class;
                rdfs:comment "DC side of the voltage source converter (VSC)."@en;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "VsConverter"@en;
                rdfs:subClassOf cim:ACDCConverter;
                cimdoc:cimPackage "IEC61970.Base.DC";
                cimdoc:packageTier "Normative".
cim:VsConverter.CapabilityCurve a owl:ObjectProperty;
                                rdfs:comment "Capability curve of this converter."@en;
                                rdfs:domain cim:VsConverter;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "CapabilityCurve"@en;
                                rdfs:range cim:VsCapabilityCurve.
cim:VsConverter.delta a owl:DatatypeProperty;
                      rdfs:comment "Angle between VsConverter.uv and ACDCConverter.uc. It is converter�s state variable used in power flow. The attribute shall be a positive value or zero."@en;
                      rdfs:domain cim:VsConverter;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "delta"@en;
                      rdfs:range cim:AngleDegrees.
cim:VsConverter.droop a owl:DatatypeProperty;
                      rdfs:comment "Droop constant. The pu value is obtained as D [kV/MW] x Sb / Ubdc. The attribute shall be a positive value."@en;
                      rdfs:domain cim:VsConverter;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "droop"@en;
                      rdfs:range cim:PU.
cim:VsConverter.droopCompensation a owl:DatatypeProperty;
                                  rdfs:comment "Compensation constant. Used to compensate for voltage drop when controlling voltage at a distant bus. The attribute shall be a positive value."@en;
                                  rdfs:domain cim:VsConverter;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "droopCompensation"@en;
                                  rdfs:range cim:Resistance.
cim:VsConverter.maxModulationIndex a owl:DatatypeProperty;
                                   rdfs:comment "The maximum quotient between the AC converter voltage (Uc) and DC voltage (Ud). A factor typically less than 1. It is converter�s configuration data used in power flow."@en;
                                   rdfs:domain cim:VsConverter;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                   rdfs:label "maxModulationIndex"@en;
                                   rdfs:range xsd:float.
cim:VsConverter.maxValveCurrent a owl:DatatypeProperty;
                                rdfs:comment "The maximum current through a valve. It is converter�s configuration data."@en;
                                rdfs:domain cim:VsConverter;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "maxValveCurrent"@en;
                                rdfs:range cim:CurrentFlow.
cim:VsConverter.pPccControl a owl:ObjectProperty;
                            rdfs:comment "Kind of control of real power and/or DC voltage."@en;
                            rdfs:domain cim:VsConverter;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "pPccControl"@en;
                            rdfs:range cim:VsPpccControlKind.
cim:VsConverter.qPccControl a owl:ObjectProperty;
                            rdfs:comment "Kind of reactive power control."@en;
                            rdfs:domain cim:VsConverter;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "qPccControl"@en;
                            rdfs:range cim:VsQpccControlKind.
cim:VsConverter.qShare a owl:DatatypeProperty;
                       rdfs:comment "Reactive power sharing factor among parallel converters on Uac control. The attribute shall be a positive value or zero."@en;
                       rdfs:domain cim:VsConverter;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "qShare"@en;
                       rdfs:range cim:PerCent.
cim:VsConverter.targetPWMfactor a owl:DatatypeProperty;
                                rdfs:comment "Magnitude of pulse-modulation factor. The attribute shall be a positive value."@en;
                                rdfs:domain cim:VsConverter;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "targetPWMfactor"@en;
                                rdfs:range xsd:float.
cim:VsConverter.targetPhasePcc a owl:DatatypeProperty;
                               rdfs:comment "Phase target at AC side, at point of common coupling. The attribute shall be a positive value."@en;
                               rdfs:domain cim:VsConverter;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "targetPhasePcc"@en;
                               rdfs:range cim:AngleDegrees.
cim:VsConverter.targetPowerFactorPcc a owl:DatatypeProperty;
                                     rdfs:comment "Power factor target at the AC side, at point of common coupling. The attribute shall be a positive value."@en;
                                     rdfs:domain cim:VsConverter;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                     rdfs:label "targetPowerFactorPcc"@en;
                                     rdfs:range xsd:float.
cim:VsConverter.targetQpcc a owl:DatatypeProperty;
                           rdfs:comment "Reactive power injection target in AC grid, at point of common coupling. Load sign convention is used, i.e. positive sign means flow out from a node."@en;
                           rdfs:domain cim:VsConverter;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "targetQpcc"@en;
                           rdfs:range cim:ReactivePower.
cim:VsConverter.targetUpcc a owl:DatatypeProperty;
                           rdfs:comment "Voltage target in AC grid, at point of common coupling. The attribute shall be a positive value."@en;
                           rdfs:domain cim:VsConverter;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "targetUpcc"@en;
                           rdfs:range cim:Voltage.
cim:VsConverter.uv a owl:DatatypeProperty;
                   rdfs:comment "Line-to-line voltage on the valve side of the converter transformer. It is converter�s state variable, result from power flow. The attribute shall be a positive value."@en;
                   rdfs:domain cim:VsConverter;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "uv"@en;
                   rdfs:range cim:Voltage.
cim:VsPpccControlKind a owl:Class;
                      rdfs:comment "Types applicable to the control of real power and/or DC voltage by voltage source converter."@en;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "VsPpccControlKind"@en;
                      owl:equivalentClass [a owl:Class ; 
                                           owl:oneOf (cim:VsPpccControlKind.pPcc
                                                      cim:VsPpccControlKind.pPccAndUdcDroop
                                                      cim:VsPpccControlKind.pPccAndUdcDroopPilot
                                                      cim:VsPpccControlKind.pPccAndUdcDroopWithCompensation
                                                      cim:VsPpccControlKind.phasePcc
                                                      cim:VsPpccControlKind.udc)];
                      cimdoc:cimPackage "IEC61970.Base.DC";
                      cimdoc:packageTier "Normative".
cim:VsPpccControlKind.pPcc a owl:NamedIndividual,
                             cim:VsPpccControlKind;
                           rdfs:comment "Control is real power at point of common coupling. The target value is provided by ACDCConverter.targetPpcc."@en;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "pPcc"@en;
                           cimdoc:enumCode 0 .
cim:VsPpccControlKind.pPccAndUdcDroop a owl:NamedIndividual,
                                        cim:VsPpccControlKind;
                                      rdfs:comment "Control is active power at point of common coupling and local DC voltage, with the droop. Target values are provided by ACDCConverter.targetPpcc, ACDCConverter.targetUdc and VsConverter.droop."@en;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                      rdfs:label "pPccAndUdcDroop"@en;
                                      cimdoc:enumCode 2 .
cim:VsPpccControlKind.pPccAndUdcDroopPilot a owl:NamedIndividual,
                                             cim:VsPpccControlKind;
                                           rdfs:comment "Control is active power at point of common coupling and the pilot DC voltage, with the droop. The mode is used for Multi Terminal High Voltage DC (MTDC) systems where multiple HVDC Substations are connected to the HVDC transmission lines. The pilot voltage is then used to coordinate the control the DC voltage across the HVDC substations. Targets are provided by ACDCConverter.targetPpcc, ACDCConverter.targetUdc and VsConverter.droop."@en;
                                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                           rdfs:label "pPccAndUdcDroopPilot"@en;
                                           cimdoc:enumCode 4 .
cim:VsPpccControlKind.pPccAndUdcDroopWithCompensation a owl:NamedIndividual,
                                                        cim:VsPpccControlKind;
                                                      rdfs:comment "Control is active power at point of common coupling and compensated DC voltage, with the droop. Compensation factor is the resistance, as an approximation of the DC voltage of a common (real or virtual) node in the DC network. Targets are provided by ACDCConverter.targetPpcc, ACDCConverter.targetUdc, VsConverter. droop and VsConverter.droopCompensation."@en;
                                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                      rdfs:label "pPccAndUdcDroopWithCompensation"@en;
                                                      cimdoc:enumCode 3 .
cim:VsPpccControlKind.phasePcc a owl:NamedIndividual,
                                 cim:VsPpccControlKind;
                               rdfs:comment "Control is phase at point of common coupling. Target is provided by VsConverter. targetPhasePcc."@en;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "phasePcc"@en;
                               cimdoc:enumCode 5 .
cim:VsPpccControlKind.udc a owl:NamedIndividual,
                            cim:VsPpccControlKind;
                          rdfs:comment "Control is DC voltage with target value provided by ACDCConverter.targetUdc."@en;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                          rdfs:label "udc"@en;
                          cimdoc:enumCode 1 .
cim:VsQpccControlKind a owl:Class;
                      rdfs:comment "Kind of reactive power control at point of common coupling for a voltage source converter."@en;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "VsQpccControlKind"@en;
                      owl:equivalentClass [a owl:Class ; 
                                           owl:oneOf (cim:VsQpccControlKind.powerFactorPcc
                                                      cim:VsQpccControlKind.pulseWidthModulation
                                                      cim:VsQpccControlKind.reactivePcc
                                                      cim:VsQpccControlKind.voltagePcc)];
                      cimdoc:cimPackage "IEC61970.Base.DC";
                      cimdoc:packageTier "Normative".
cim:VsQpccControlKind.powerFactorPcc a owl:NamedIndividual,
                                       cim:VsQpccControlKind;
                                     rdfs:comment "Control is power factor at point of common coupling. Target is provided by VsConverter.targetPowerFactorPcc."@en;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                     rdfs:label "powerFactorPcc"@en;
                                     cimdoc:enumCode 2 .
cim:VsQpccControlKind.pulseWidthModulation a owl:NamedIndividual,
                                             cim:VsQpccControlKind;
                                           rdfs:comment "No explicit control. Pulse-modulation factor is directly set in magnitude (VsConverter.targetPWMfactor) and phase (VsConverter.targetPhasePcc)."@en;
                                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                           rdfs:label "pulseWidthModulation"@en;
                                           cimdoc:enumCode 3 .
cim:VsQpccControlKind.reactivePcc a owl:NamedIndividual,
                                    cim:VsQpccControlKind;
                                  rdfs:comment "Control is reactive power at point of common coupling. Target is provided by VsConverter.targetQpcc."@en;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "reactivePcc"@en;
                                  cimdoc:enumCode 0 .
cim:VsQpccControlKind.voltagePcc a owl:NamedIndividual,
                                   cim:VsQpccControlKind;
                                 rdfs:comment "Control is voltage at point of common coupling. Target is provided by VsConverter.targetUpcc."@en;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "voltagePcc"@en;
                                 cimdoc:enumCode 1 .
cim:WaterLevel a rdfs:Datatype;
               rdfs:comment "Reservoir water level referred to a given datum such as mean sea level."@en;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "WaterLevel"@en;
               owl:equivalentClass xsd:float;
               cimdoc:cimPackage "IEC61970.Base.Domain";
               cimdoc:packageTier "Normative";
               cimdoc:unitSymbol cim:UnitSymbol.m.
cim:WaveTrap a owl:Class;
             rdfs:comment "Line traps are devices that impede high frequency power line carrier signals yet present a negligible impedance at the main power frequency."@en;
             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
             rdfs:label "WaveTrap"@en;
             rdfs:subClassOf cim:AuxiliaryEquipment;
             cimdoc:cimPackage "IEC61970.Base.AuxiliaryEquipment";
             cimdoc:packageTier "Normative".
cim:WeatherStation a owl:Class;
                   rdfs:comment "This represents a source of ambient temperature."@en;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "WeatherStation"@en;
                   rdfs:subClassOf cim:PowerSystemResource;
                   cimdoc:cimPackage "IEC61970.InfIEC61970.InfOperationalLimits";
                   cimdoc:packageTier "Informative".
cim:WindAeroConstIEC a owl:Class;
                     rdfs:comment "Constant aerodynamic torque model which assumes that the aerodynamic torque is constant. Reference: IEC 61400-27-1:2015, 5.6.1.1."@en;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                     rdfs:label "WindAeroConstIEC"@en;
                     rdfs:subClassOf cim:IdentifiedObject;
                     cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.WindDynamics";
                     cimdoc:packageTier "Normative".
cim:WindAeroConstIEC.WindGenTurbineType1aIEC a owl:ObjectProperty;
                                             rdfs:comment "Wind turbine type 1A model with which this wind aerodynamic model is associated."@en;
                                             rdfs:domain cim:WindAeroConstIEC;
                                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                             rdfs:label "WindGenTurbineType1aIEC"@en;
                                             rdfs:range cim:WindGenTurbineType1aIEC.
cim:WindAeroOneDimIEC a owl:Class;
                      rdfs:comment "One-dimensional aerodynamic model. Reference: IEC 61400-27-1:2015, 5.6.1.2."@en;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "WindAeroOneDimIEC"@en;
                      rdfs:subClassOf cim:IdentifiedObject;
                      cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.WindDynamics";
                      cimdoc:packageTier "Normative".
cim:WindAeroOneDimIEC.WindTurbineType3IEC a owl:ObjectProperty;
                                          rdfs:comment "Wind turbine type 3 model with which this wind aerodynamic model is associated."@en;
                                          rdfs:domain cim:WindAeroOneDimIEC;
                                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                          rdfs:label "WindTurbineType3IEC"@en;
                                          rdfs:range cim:WindTurbineType3IEC.
cim:WindAeroOneDimIEC.ka a owl:DatatypeProperty;
                         rdfs:comment "Aerodynamic gain (ka). It is a type-dependent parameter."@en;
                         rdfs:domain cim:WindAeroOneDimIEC;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                         rdfs:label "ka"@en;
                         rdfs:range xsd:float.
cim:WindAeroOneDimIEC.thetaomega a owl:DatatypeProperty;
                                 rdfs:comment "Initial pitch angle (thetaomega0). It is a case- dependent parameter."@en;
                                 rdfs:domain cim:WindAeroOneDimIEC;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "thetaomega"@en;
                                 rdfs:range cim:AngleDegrees.
cim:WindAeroTwoDimIEC a owl:Class;
                      rdfs:comment "Two-dimensional aerodynamic model. Reference: IEC 61400-27-1:2015, 5.6.1.3."@en;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "WindAeroTwoDimIEC"@en;
                      rdfs:subClassOf cim:IdentifiedObject;
                      cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.WindDynamics";
                      cimdoc:packageTier "Normative".
cim:WindAeroTwoDimIEC.WindTurbineType3IEC a owl:ObjectProperty;
                                          rdfs:comment "Wind turbine type 3 model with which this wind aerodynamic model is associated."@en;
                                          rdfs:domain cim:WindAeroTwoDimIEC;
                                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                          rdfs:label "WindTurbineType3IEC"@en;
                                          rdfs:range cim:WindTurbineType3IEC.
cim:WindAeroTwoDimIEC.dpomega a owl:DatatypeProperty;
                              rdfs:comment "Partial derivative of aerodynamic power with respect to changes in WTR speed (dpomega). It is a type-dependent parameter."@en;
                              rdfs:domain cim:WindAeroTwoDimIEC;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "dpomega"@en;
                              rdfs:range cim:PU.
cim:WindAeroTwoDimIEC.dptheta a owl:DatatypeProperty;
                              rdfs:comment "Partial derivative of aerodynamic power with respect to changes in pitch angle (dptheta). It is a type-dependent parameter."@en;
                              rdfs:domain cim:WindAeroTwoDimIEC;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "dptheta"@en;
                              rdfs:range cim:PU.
cim:WindAeroTwoDimIEC.dpv1 a owl:DatatypeProperty;
                           rdfs:comment "Partial derivative (dpv1). It is a type-dependent parameter."@en;
                           rdfs:domain cim:WindAeroTwoDimIEC;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "dpv1"@en;
                           rdfs:range cim:PU.
cim:WindAeroTwoDimIEC.omegazero a owl:DatatypeProperty;
                                rdfs:comment "Rotor speed if the wind turbine is not derated (omega0). It is a type-dependent parameter."@en;
                                rdfs:domain cim:WindAeroTwoDimIEC;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "omegazero"@en;
                                rdfs:range cim:PU.
cim:WindAeroTwoDimIEC.pavail a owl:DatatypeProperty;
                             rdfs:comment "Available aerodynamic power (pavail). It is a case-dependent parameter."@en;
                             rdfs:domain cim:WindAeroTwoDimIEC;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "pavail"@en;
                             rdfs:range cim:PU.
cim:WindAeroTwoDimIEC.thetav2 a owl:DatatypeProperty;
                              rdfs:comment "Blade angle at twice rated wind speed (thetav2). It is a type-dependent parameter."@en;
                              rdfs:domain cim:WindAeroTwoDimIEC;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "thetav2"@en;
                              rdfs:range cim:AngleDegrees.
cim:WindAeroTwoDimIEC.thetazero a owl:DatatypeProperty;
                                rdfs:comment "Pitch angle if the wind turbine is not derated (theta0). It is a case-dependent parameter."@en;
                                rdfs:domain cim:WindAeroTwoDimIEC;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "thetazero"@en;
                                rdfs:range cim:AngleDegrees.
cim:WindContCurrLimIEC a owl:Class;
                       rdfs:comment "Current limitation model. The current limitation model combines the physical limits and the control limits. Reference: IEC 61400-27-1:2015, 5.6.5.8."@en;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "WindContCurrLimIEC"@en;
                       rdfs:subClassOf cim:IdentifiedObject;
                       cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.WindDynamics";
                       cimdoc:packageTier "Normative".
cim:WindContCurrLimIEC.WindTurbineType3or4IEC a owl:ObjectProperty;
                                              rdfs:comment "Wind turbine type 3 or type 4 model with which this wind control current limitation model is associated."@en;
                                              rdfs:domain cim:WindContCurrLimIEC;
                                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                              rdfs:label "WindTurbineType3or4IEC"@en;
                                              rdfs:range cim:WindTurbineType3or4IEC.
cim:WindContCurrLimIEC.imax a owl:DatatypeProperty;
                            rdfs:comment "Maximum continuous current at the wind turbine terminals (imax). It is a type-dependent parameter."@en;
                            rdfs:domain cim:WindContCurrLimIEC;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "imax"@en;
                            rdfs:range cim:PU.
cim:WindContCurrLimIEC.imaxdip a owl:DatatypeProperty;
                               rdfs:comment "Maximum current during voltage dip at the wind turbine terminals (imaxdip). It is a project-dependent parameter."@en;
                               rdfs:domain cim:WindContCurrLimIEC;
