cim:LoadGroup a owl:Class;
              rdfs:comment "The class is the third level in a hierarchical structure for grouping of loads for the purpose of load flow load scaling."@en;
              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
              rdfs:label "LoadGroup"@en;
              rdfs:subClassOf cim:IdentifiedObject;
              cimdoc:cimPackage "IEC61970.Base.LoadModel";
              cimdoc:packageTier "Normative".
cim:LoadModelPartVersion a owl:Class;
                         rdfs:comment "Load a model part version."@en;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                         rdfs:label "LoadModelPartVersion"@en;
                         cimdoc:cimPackage "IEC61970.InfIEC61970.InfPart303.NetworkModelFrames";
                         cimdoc:packageTier "Informative".
cim:LoadMotor a owl:Class;
              rdfs:comment """Aggregate induction motor load. This model is used to represent a fraction of an ordinary load as \"induction motor load\". It allows a load that is treated as an ordinary constant power in power flow analysis to be represented by an induction motor in dynamic simulation. This model is intended for representation of aggregations of many motors dispersed through a load represented at a high voltage bus but where there is no information on the characteristics of individual motors. Either a \"one-cage\" or \"two-cage\" model of the induction machine can be modelled. Magnetic saturation is not modelled. This model treats a fraction of the constant power part of a load as a motor. During initialisation, the initial power drawn by the motor is set equal to Pfrac times the constant P part of the static load. The remainder of the load is left as a static load. The reactive power demand of the motor is calculated during initialisation as a function of voltage at the load bus. This reactive power demand can be less than or greater than the constant Q component of the load. If the motor's reactive demand is greater than the constant Q component of the load, the model inserts a shunt capacitor at the terminal of the motor to bring its reactive demand down to equal the constant Q reactive load. If an induction motor load model and a static load model are both present for a load, the motor Pfrac is assumed to be subtracted from the power flow constant P load before the static load model is applied. The remainder of the load, if any, is then represented by the static load model."""@en;
              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
              rdfs:label "LoadMotor"@en;
              rdfs:subClassOf cim:IdentifiedObject;
              cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.LoadDynamics";
              cimdoc:packageTier "Normative".
cim:LoadMotor.LoadAggregate a owl:ObjectProperty;
                            rdfs:comment "Aggregate load to which this aggregate motor (dynamic) load belongs."@en;
                            rdfs:domain cim:LoadMotor;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "LoadAggregate"@en;
                            rdfs:range cim:LoadAggregate.
cim:LoadMotor.d a owl:DatatypeProperty;
                rdfs:comment "Damping factor (D). Unit = delta P/delta speed. Typical value = 2."@en;
                rdfs:domain cim:LoadMotor;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "d"@en;
                rdfs:range xsd:float.
cim:LoadMotor.h a owl:DatatypeProperty;
                rdfs:comment "Inertia constant (H) (greater than or equal to 0). Typical value = 0,4."@en;
                rdfs:domain cim:LoadMotor;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "h"@en;
                rdfs:range cim:Seconds.
cim:LoadMotor.lfac a owl:DatatypeProperty;
                   rdfs:comment "Loading factor (Lfac). The ratio of initial P to motor MVA base. Typical value = 0,8."@en;
                   rdfs:domain cim:LoadMotor;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "lfac"@en;
                   rdfs:range xsd:float.
cim:LoadMotor.lp a owl:DatatypeProperty;
                 rdfs:comment "Transient reactance (Lp). Typical value = 0,15."@en;
                 rdfs:domain cim:LoadMotor;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "lp"@en;
                 rdfs:range cim:PU.
cim:LoadMotor.lpp a owl:DatatypeProperty;
                  rdfs:comment "Subtransient reactance (Lpp). Typical value = 0,15."@en;
                  rdfs:domain cim:LoadMotor;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "lpp"@en;
                  rdfs:range cim:PU.
cim:LoadMotor.ls a owl:DatatypeProperty;
                 rdfs:comment "Synchronous reactance (Ls). Typical value = 3,2."@en;
                 rdfs:domain cim:LoadMotor;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "ls"@en;
                 rdfs:range cim:PU.
cim:LoadMotor.pfrac a owl:DatatypeProperty;
                    rdfs:comment "Fraction of constant-power load to be represented by this motor model (Pfrac) (greater than or equal to 0,0 and less than or equal to 1,0). Typical value = 0,3."@en;
                    rdfs:domain cim:LoadMotor;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "pfrac"@en;
                    rdfs:range xsd:float.
cim:LoadMotor.ra a owl:DatatypeProperty;
                 rdfs:comment "Stator resistance (Ra). Typical value = 0."@en;
                 rdfs:domain cim:LoadMotor;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "ra"@en;
                 rdfs:range cim:PU.
cim:LoadMotor.tbkr a owl:DatatypeProperty;
                   rdfs:comment "Circuit breaker operating time (Tbkr) (greater than or equal to 0). Typical value = 0,08."@en;
                   rdfs:domain cim:LoadMotor;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "tbkr"@en;
                   rdfs:range cim:Seconds.
cim:LoadMotor.tpo a owl:DatatypeProperty;
                  rdfs:comment "Transient rotor time constant (Tpo) (greater than or equal to 0). Typical value = 1."@en;
                  rdfs:domain cim:LoadMotor;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "tpo"@en;
                  rdfs:range cim:Seconds.
cim:LoadMotor.tppo a owl:DatatypeProperty;
                   rdfs:comment "Subtransient rotor time constant (Tppo) (greater than or equal to 0). Typical value = 0,02."@en;
                   rdfs:domain cim:LoadMotor;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "tppo"@en;
                   rdfs:range cim:Seconds.
cim:LoadMotor.tv a owl:DatatypeProperty;
                 rdfs:comment "Voltage trip pickup time (Tv) (greater than or equal to 0). Typical value = 0,1."@en;
                 rdfs:domain cim:LoadMotor;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "tv"@en;
                 rdfs:range cim:Seconds.
cim:LoadMotor.vt a owl:DatatypeProperty;
                 rdfs:comment "Voltage threshold for tripping (Vt). Typical value = 0,7."@en;
                 rdfs:domain cim:LoadMotor;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "vt"@en;
                 rdfs:range cim:PU.
cim:LoadResponseCharacteristic a owl:Class;
                               rdfs:comment """Models the characteristic response of the load demand due to changes in system conditions such as voltage and frequency. It is not related to demand response. If LoadResponseCharacteristic.exponentModel is True, the exponential voltage or frequency dependent models are specified and used as to calculate active and reactive power components of the load model. The equations to calculate active and reactive power components of the load model are internal to the power flow calculation, hence they use different quantities depending on the use case of the data exchange. The equations for exponential voltage dependent load model injected power are: pInjection= Pnominal* (Voltage/cim:BaseVoltage.nominalVoltage) ** cim: LoadResponseCharacteristic.pVoltageExponent qInjection= Qnominal* (Voltage/cim:BaseVoltage.nominalVoltage) ** cim: LoadResponseCharacteristic.qVoltageExponent Where: 1) * means \"multiply\" and ** is \"raised to power of\"; 2) Pnominal and Qnominal represent the active power and reactive power at nominal voltage as any load described by the voltage exponential model shall be given at nominal voltage. This means that EnergyConsumer.p and EnergyConsumer. q are at nominal voltage. 3) After power flow is solved: -pInjection and qInjection correspond to SvPowerflow.p and SvPowerflow.q respectively. - Voltage corresponds to SvVoltage.v at the TopologicalNode where the load is connected."""@en;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "LoadResponseCharacteristic"@en;
                               rdfs:subClassOf cim:IdentifiedObject;
                               cimdoc:cimPackage "IEC61970.Base.LoadModel";
                               cimdoc:packageTier "Normative".
cim:LoadResponseCharacteristic.exponentModel a owl:DatatypeProperty;
                                             rdfs:comment "Indicates the exponential voltage dependency model is to be used. If false, the coefficient model is to be used. The exponential voltage dependency model consist of the attributes: - pVoltageExponent - qVoltageExponent - pFrequencyExponent - qFrequencyExponent. The coefficient model consist of the attributes: - pConstantImpedance - pConstantCurrent - pConstantPower - qConstantImpedance - qConstantCurrent - qConstantPower. The sum of pConstantImpedance, pConstantCurrent and pConstantPower shall equal 1. The sum of qConstantImpedance, qConstantCurrent and qConstantPower shall equal 1."@en;
                                             rdfs:domain cim:LoadResponseCharacteristic;
                                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                             rdfs:label "exponentModel"@en;
                                             rdfs:range xsd:boolean.
cim:LoadResponseCharacteristic.pConstantCurrent a owl:DatatypeProperty;
                                                rdfs:comment "Portion of active power load modelled as constant current."@en;
                                                rdfs:domain cim:LoadResponseCharacteristic;
                                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                rdfs:label "pConstantCurrent"@en;
                                                rdfs:range xsd:float.
cim:LoadResponseCharacteristic.pConstantImpedance a owl:DatatypeProperty;
                                                  rdfs:comment "Portion of active power load modelled as constant impedance."@en;
                                                  rdfs:domain cim:LoadResponseCharacteristic;
                                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                  rdfs:label "pConstantImpedance"@en;
                                                  rdfs:range xsd:float.
cim:LoadResponseCharacteristic.pConstantPower a owl:DatatypeProperty;
                                              rdfs:comment "Portion of active power load modelled as constant power."@en;
                                              rdfs:domain cim:LoadResponseCharacteristic;
                                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                              rdfs:label "pConstantPower"@en;
                                              rdfs:range xsd:float.
cim:LoadResponseCharacteristic.pFrequencyExponent a owl:DatatypeProperty;
                                                  rdfs:comment "Exponent of per unit frequency effecting active power."@en;
                                                  rdfs:domain cim:LoadResponseCharacteristic;
                                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                  rdfs:label "pFrequencyExponent"@en;
                                                  rdfs:range xsd:float.
cim:LoadResponseCharacteristic.pVoltageExponent a owl:DatatypeProperty;
                                                rdfs:comment "Exponent of per unit voltage effecting real power."@en;
                                                rdfs:domain cim:LoadResponseCharacteristic;
                                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                rdfs:label "pVoltageExponent"@en;
                                                rdfs:range xsd:float.
cim:LoadResponseCharacteristic.qConstantCurrent a owl:DatatypeProperty;
                                                rdfs:comment "Portion of reactive power load modelled as constant current."@en;
                                                rdfs:domain cim:LoadResponseCharacteristic;
                                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                rdfs:label "qConstantCurrent"@en;
                                                rdfs:range xsd:float.
cim:LoadResponseCharacteristic.qConstantImpedance a owl:DatatypeProperty;
                                                  rdfs:comment "Portion of reactive power load modelled as constant impedance."@en;
                                                  rdfs:domain cim:LoadResponseCharacteristic;
                                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                  rdfs:label "qConstantImpedance"@en;
                                                  rdfs:range xsd:float.
cim:LoadResponseCharacteristic.qConstantPower a owl:DatatypeProperty;
                                              rdfs:comment "Portion of reactive power load modelled as constant power."@en;
                                              rdfs:domain cim:LoadResponseCharacteristic;
                                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                              rdfs:label "qConstantPower"@en;
                                              rdfs:range xsd:float.
cim:LoadResponseCharacteristic.qFrequencyExponent a owl:DatatypeProperty;
                                                  rdfs:comment "Exponent of per unit frequency effecting reactive power."@en;
                                                  rdfs:domain cim:LoadResponseCharacteristic;
                                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                  rdfs:label "qFrequencyExponent"@en;
                                                  rdfs:range xsd:float.
cim:LoadResponseCharacteristic.qVoltageExponent a owl:DatatypeProperty;
                                                rdfs:comment "Exponent of per unit voltage effecting reactive power."@en;
                                                rdfs:domain cim:LoadResponseCharacteristic;
                                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                rdfs:label "qVoltageExponent"@en;
                                                rdfs:range xsd:float.
