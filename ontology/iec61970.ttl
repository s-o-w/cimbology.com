cim:ModelPartVersion.ModelSpecification a owl:ObjectProperty;
                                        rdfs:comment "Model specification of the modelt."@en;
                                        rdfs:domain cim:ModelPartVersion;
                                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                        rdfs:label "ModelSpecification"@en;
                                        rdfs:range cim:ModelPartSpecification.
cim:ModelPartVersion.m_CompleteModelToBeDeleted a owl:ObjectProperty;
                                                rdfs:comment "The complete model to be deleted, if any, associated with this model part version."@en;
                                                rdfs:domain cim:ModelPartVersion;
                                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                rdfs:label "m_CompleteModelToBeDeleted"@en;
