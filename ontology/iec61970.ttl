                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "Changeset"@en;
                              rdfs:range cim:ChangeSet.
cim:ChangeSetMember.PropertiesObject a owl:ObjectProperty;
                                     rdfs:comment "Gets or sets the CIM object holding the properties of this dataset context. Sometimes only a reference to the registered object is used."@en;
                                     rdfs:domain cim:ChangeSetMember;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                     rdfs:label "PropertiesObject"@en;
