                       cimdoc:enumCode 0 .
cim:IPAddressKind.iPv6 a owl:NamedIndividual,
                         cim:IPAddressKind;
                       rdfs:comment "Indicates that an IPv6 dotted decimal is in use."@en;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "iPv6"@en;
                       cimdoc:enumCode 1 .
cim:ISOUpperLayer a owl:Class;
                  rdfs:comment "Is a set of configure addressing information that is required since ICCP utilizes addressing other than a TCP port."@en;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "ISOUpperLayer"@en;
                  rdfs:subClassOf cim:TCPAccessPoint;
                  cimdoc:cimPackage "IEC61970.Base.ICCPConfiguration";
                  cimdoc:packageTier "Normative".
cim:ISOUpperLayer.aeInvoke a owl:DatatypeProperty;
                           rdfs:comment "Is part of the Application Entity addressing as specified by ISO Addressing."@en;
                           rdfs:domain cim:ISOUpperLayer;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "aeInvoke"@en;
                           rdfs:range xsd:integer.
cim:ISOUpperLayer.aeQual a owl:DatatypeProperty;
                         rdfs:comment "Is the AE qualifier and represents further application level addressing information."@en;
                         rdfs:domain cim:ISOUpperLayer;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                         rdfs:label "aeQual"@en;
                         rdfs:range xsd:integer.
cim:ISOUpperLayer.apInvoke a owl:DatatypeProperty;
                           rdfs:comment "Is a further application level OSI addressing parameter."@en;
                           rdfs:domain cim:ISOUpperLayer;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "apInvoke"@en;
                           rdfs:range xsd:integer.
cim:ISOUpperLayer.apTitle a owl:DatatypeProperty;
                          rdfs:comment """Is a sequence of integer strings separated by \".\". The value, in conjunction with other application addressing attributes (e.g. other APs) are used to select a specific application (e.g. the ICCP application entity) per the OSI reference model. The sequence, and its values, represent a namespace whose values are governed by ISO/IEC 7498-3."""@en;
                          rdfs:domain cim:ISOUpperLayer;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                          rdfs:label "apTitle"@en;
                          rdfs:range xsd:string.
cim:ISOUpperLayer.osiPsel a owl:DatatypeProperty;
                          rdfs:comment "Is the addressing selector for OSI presentation addressing."@en;
                          rdfs:domain cim:ISOUpperLayer;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                          rdfs:label "osiPsel"@en;
                          rdfs:range xsd:string.
cim:ISOUpperLayer.osiSsel a owl:DatatypeProperty;
                          rdfs:comment "Is the OSI session layer addressing information."@en;
                          rdfs:domain cim:ISOUpperLayer;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                          rdfs:label "osiSsel"@en;
                          rdfs:range xsd:string.
cim:ISOUpperLayer.osiTsel a owl:DatatypeProperty;
                          rdfs:comment "Is the OSI Transport Layer addressing information."@en;
                          rdfs:domain cim:ISOUpperLayer;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                          rdfs:label "osiTsel"@en;
                          rdfs:range xsd:string.
cim:IdcInverterControl a owl:Class;
