                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                       rdfs:label "remoteSignalType"@en;
                                       rdfs:range cim:RemoteSignalKind.
cim:RemotePoint a owl:Class;
                rdfs:comment "For an RTU, remote points correspond to telemetered values or control outputs. Other units (e.g. control centres) usually also contain calculated values."@en;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "RemotePoint"@en;
                rdfs:subClassOf cim:IdentifiedObject;
                cimdoc:cimPackage "IEC61970.Base.SCADA";
                cimdoc:packageTier "Normative".
cim:RemoteSignalKind a owl:Class;
                     rdfs:comment "Type of input signal coming from remote bus."@en;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                     rdfs:label "RemoteSignalKind"@en;
                     owl:equivalentClass [a owl:Class ; 
                                          owl:oneOf (cim:RemoteSignalKind.remoteBranchCurrentAmplitude
                                                     cim:RemoteSignalKind.remoteBusFrequency
                                                     cim:RemoteSignalKind.remoteBusFrequencyDeviation
                                                     cim:RemoteSignalKind.remoteBusVoltage
                                                     cim:RemoteSignalKind.remoteBusVoltageAmplitude
                                                     cim:RemoteSignalKind.remoteBusVoltageAmplitudeDerivative
                                                     cim:RemoteSignalKind.remoteBusVoltageFrequency
                                                     cim:RemoteSignalKind.remoteBusVoltageFrequencyDeviation
                                                     cim:RemoteSignalKind.remotePuBusVoltageDerivative)];
                     cimdoc:cimPackage "IEC61970.Dynamics.StandardInterconnections";
                     cimdoc:packageTier "Normative".
cim:RemoteSignalKind.remoteBranchCurrentAmplitude a owl:NamedIndividual,
                                                    cim:RemoteSignalKind;
                                                  rdfs:comment "Input is branch current amplitude from remote terminal bus."@en;
                                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                  rdfs:label "remoteBranchCurrentAmplitude"@en;
                                                  cimdoc:enumCode 6 .
cim:RemoteSignalKind.remoteBusFrequency a owl:NamedIndividual,
                                          cim:RemoteSignalKind;
                                        rdfs:comment "Input is frequency from remote terminal bus."@en;
                                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                        rdfs:label "remoteBusFrequency"@en;
                                        cimdoc:enumCode 2 .
cim:RemoteSignalKind.remoteBusFrequencyDeviation a owl:NamedIndividual,
                                                   cim:RemoteSignalKind;
                                                 rdfs:comment "Input is frequency deviation from remote terminal bus."@en;
                                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                 rdfs:label "remoteBusFrequencyDeviation"@en;
                                                 cimdoc:enumCode 3 .
cim:RemoteSignalKind.remoteBusVoltage a owl:NamedIndividual,
                                        cim:RemoteSignalKind;
                                      rdfs:comment "Input is voltage from remote terminal bus."@en;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                      rdfs:label "remoteBusVoltage"@en;
                                      cimdoc:enumCode 5 .
cim:RemoteSignalKind.remoteBusVoltageAmplitude a owl:NamedIndividual,
                                                 cim:RemoteSignalKind;
                                               rdfs:comment "Input is voltage amplitude from remote terminal bus."@en;
                                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                               rdfs:label "remoteBusVoltageAmplitude"@en;
                                               cimdoc:enumCode 4 .
cim:RemoteSignalKind.remoteBusVoltageAmplitudeDerivative a owl:NamedIndividual,
                                                           cim:RemoteSignalKind;
                                                         rdfs:comment "Input is branch current amplitude derivative from remote terminal bus."@en;
                                                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                         rdfs:label "remoteBusVoltageAmplitudeDerivative"@en;
                                                         cimdoc:enumCode 7 .
cim:RemoteSignalKind.remoteBusVoltageFrequency a owl:NamedIndividual,
                                                 cim:RemoteSignalKind;
                                               rdfs:comment "Input is voltage frequency from remote terminal bus."@en;
                                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                               rdfs:label "remoteBusVoltageFrequency"@en;
                                               cimdoc:enumCode 0 .
cim:RemoteSignalKind.remoteBusVoltageFrequencyDeviation a owl:NamedIndividual,
                                                          cim:RemoteSignalKind;
                                                        rdfs:comment "Input is voltage frequency deviation from remote terminal bus."@en;
                                                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                        rdfs:label "remoteBusVoltageFrequencyDeviation"@en;
