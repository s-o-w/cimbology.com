cim:VSCtype1 a owl:Class;
             rdfs:comment "The vs ctype class"@en;
             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
             rdfs:label "VSCtype1"@en;
             rdfs:subClassOf cim:VSCDynamics;
             cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.InfHVDCDynamics.VSC";
             cimdoc:packageTier "Informative".
cim:VSCtype1.DCvoltageControl a owl:ObjectProperty;
                              rdfs:comment "The cvoltage control"@en;
                              rdfs:domain cim:VSCtype1;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "DCvoltageControl"@en;
                              rdfs:range cim:DCvoltageControl.
cim:Validity a owl:Class;
             rdfs:comment "Validity for MeasurementValue."@en;
             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
             rdfs:label "Validity"@en;
             owl:equivalentClass [a owl:Class ; 
                                  owl:oneOf (cim:Validity.GOOD
                                             cim:Validity.INVALID
                                             cim:Validity.QUESTIONABLE)];
             cimdoc:cimPackage "IEC61970.Base.Meas";
             cimdoc:packageTier "Normative".
cim:Validity.GOOD a owl:NamedIndividual,
                    cim:Validity;
                  rdfs:comment "The value is marked good if no abnormal condition of the acquisition function or the information source is detected."@en;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "GOOD"@en;
                  cimdoc:enumCode 0 .
cim:Validity.INVALID a owl:NamedIndividual,
                       cim:Validity;
                     rdfs:comment "The value is marked invalid when a supervision function recognises abnormal conditions of the acquisition function or the information source (missing or non-operating updating devices). The value is not defined under this condition. The mark invalid is used to indicate to the client that the value may be incorrect and shall not be used."@en;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                     rdfs:label "INVALID"@en;
                     cimdoc:enumCode 2 .
cim:Validity.QUESTIONABLE a owl:NamedIndividual,
                            cim:Validity;
                          rdfs:comment """The value is marked questionable if a supervision function detects an abnormal behaviour, however the value could still be valid. The client is responsible for determining whether or not values marked \"questionable\" should be used."""@en;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                          rdfs:label "QUESTIONABLE"@en;
                          cimdoc:enumCode 1 .
cim:ValueAliasSet a owl:Class;
                  rdfs:comment """Describes the translation of a set of values into a name and is intendend to facilitate custom translations. Each ValueAliasSet has a name, description etc. A specific Measurement may represent a discrete state like Open, Closed, Intermediate etc. This requires a translation from the MeasurementValue.value number to a string, e.g. 0->\"Invalid\", 1->\"Open\", 2->\"Closed\", 3- >\"Intermediate\". Each ValueToAlias member in ValueAliasSet.Value describe a mapping for one particular value to a name."""@en;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "ValueAliasSet"@en;
                  rdfs:subClassOf cim:IdentifiedObject;
                  cimdoc:cimPackage "IEC61970.Base.Meas";
                  cimdoc:packageTier "Normative".
cim:ValueAliasSet.Discretes a owl:ObjectProperty;
                            rdfs:comment "The Measurements using the set for translation."@en;
                            rdfs:domain cim:ValueAliasSet;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "Discretes"@en;
                            rdfs:range cim:Discrete.
cim:ValueAliasSet.Values a owl:ObjectProperty;
                         rdfs:comment "The ValueToAlias mappings included in the set."@en;
                         rdfs:domain cim:ValueAliasSet;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                         rdfs:label "Values"@en;
                         rdfs:range cim:ValueToAlias.
cim:ValueToAlias a owl:Class;
                 rdfs:comment """Describes the translation of one particular value into a name, e.g. 1 as \"Open\"."""@en;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "ValueToAlias"@en;
                 rdfs:subClassOf cim:IdentifiedObject;
                 cimdoc:cimPackage "IEC61970.Base.Meas";
                 cimdoc:packageTier "Normative".
cim:ValueToAlias.value a owl:DatatypeProperty;
                       rdfs:comment "The value that is mapped."@en;
                       rdfs:domain cim:ValueToAlias;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "value"@en;
                       rdfs:range xsd:integer.
cim:VisibilityLayer a owl:Class;
                    rdfs:comment "Layers are typically used for grouping diagram objects according to themes and scales. Themes are used to display or hide certain information (e.g., lakes, borders), while scales are used for hiding or displaying information depending on the current zoom level (hide text when it is too small to be read, or when it exceeds the screen size). This is also called de-cluttering. CIM based graphics exchange supports an m:n relationship between diagram objects and layers. The importing system shall convert an m:n case into an appropriate 1:n representation if the importing system does not support m:n."@en;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "VisibilityLayer"@en;
                    rdfs:subClassOf cim:IdentifiedObject;
                    cimdoc:cimPackage "IEC61970.Base.DiagramLayout";
                    cimdoc:packageTier "Normative".
cim:VisibilityLayer.drawingOrder a owl:DatatypeProperty;
                                 rdfs:comment "The drawing order for this layer. The higher the number, the later the layer and the objects within it are rendered."@en;
                                 rdfs:domain cim:VisibilityLayer;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "drawingOrder"@en;
                                 rdfs:range xsd:integer.
cim:Voltage a rdfs:Datatype;
            rdfs:comment "Electrical voltage, can be both AC and DC."@en;
            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
            rdfs:label "Voltage"@en;
            owl:equivalentClass xsd:float;
            cimdoc:cimPackage "IEC61970.Base.Domain";
            cimdoc:packageTier "Normative";
            cimdoc:unitSymbol cim:UnitSymbol.V.
