cim:Pss1.kf a owl:DatatypeProperty;
            rdfs:comment "Frequency power input gain (KF). Typical value = 5."@en;
            rdfs:domain cim:Pss1;
            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
            rdfs:label "kf"@en;
            rdfs:range xsd:float.
cim:Pss1.komega a owl:DatatypeProperty;
                rdfs:comment "Shaft speed power input gain (Komega). Typical value = 0."@en;
                rdfs:domain cim:Pss1;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "komega"@en;
                rdfs:range xsd:float.
cim:Pss1.kpe a owl:DatatypeProperty;
             rdfs:comment "Electric power input gain (KPE). Typical value = 0,3."@en;
             rdfs:domain cim:Pss1;
             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
             rdfs:label "kpe"@en;
             rdfs:range xsd:float.
cim:Pss1.ks a owl:DatatypeProperty;
            rdfs:comment "PSS gain (Ks). Typical value = 1."@en;
            rdfs:domain cim:Pss1;
            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
            rdfs:label "ks"@en;
            rdfs:range xsd:float.
cim:Pss1.pmin a owl:DatatypeProperty;
              rdfs:comment "Minimum power PSS enabling (Pmin). Typical value = 0,25."@en;
              rdfs:domain cim:Pss1;
              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
              rdfs:label "pmin"@en;
              rdfs:range cim:PU.
cim:Pss1.t10 a owl:DatatypeProperty;
             rdfs:comment "Lead/lag time constant (T10) (>= 0). Typical value = 0."@en;
             rdfs:domain cim:Pss1;
             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
             rdfs:label "t10"@en;
             rdfs:range cim:Seconds.
cim:Pss1.t5 a owl:DatatypeProperty;
            rdfs:comment "Washout (T5) (>= 0). Typical value = 3,5."@en;
            rdfs:domain cim:Pss1;
            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
            rdfs:label "t5"@en;
            rdfs:range cim:Seconds.
cim:Pss1.t6 a owl:DatatypeProperty;
            rdfs:comment "Filter time constant (T6) (>= 0). Typical value = 0."@en;
            rdfs:domain cim:Pss1;
            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
            rdfs:label "t6"@en;
            rdfs:range cim:Seconds.
cim:Pss1.t7 a owl:DatatypeProperty;
            rdfs:comment "Lead/lag time constant (T7) (>= 0). If = 0, both blocks are bypassed. Typical value = 0."@en;
            rdfs:domain cim:Pss1;
            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
            rdfs:label "t7"@en;
            rdfs:range cim:Seconds.
cim:Pss1.t8 a owl:DatatypeProperty;
            rdfs:comment "Lead/lag time constant (T8) (>= 0). Typical value = 0."@en;
            rdfs:domain cim:Pss1;
            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
            rdfs:label "t8"@en;
            rdfs:range cim:Seconds.
cim:Pss1.t9 a owl:DatatypeProperty;
            rdfs:comment "Lead/lag time constant (T9) (>= 0). If = 0, both blocks are bypassed. Typical value = 0."@en;
            rdfs:domain cim:Pss1;
            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
            rdfs:label "t9"@en;
            rdfs:range cim:Seconds.
cim:Pss1.tpe a owl:DatatypeProperty;
             rdfs:comment "Electric power filter time constant (TPE) (>= 0). Typical value = 0,05."@en;
             rdfs:domain cim:Pss1;
             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
             rdfs:label "tpe"@en;
             rdfs:range cim:Seconds.
cim:Pss1.vadat a owl:DatatypeProperty;
               rdfs:comment "Signal selector (VADAT). true = closed (generator power is greater than Pmin) false = open (Pe is smaller than Pmin). Typical value = true."@en;
               rdfs:domain cim:Pss1;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "vadat"@en;
               rdfs:range xsd:boolean.
cim:Pss1.vsmn a owl:DatatypeProperty;
              rdfs:comment "Stabilizer output maximum limit (VSMN). Typical value = -0,06."@en;
              rdfs:domain cim:Pss1;
              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
              rdfs:label "vsmn"@en;
              rdfs:range cim:PU.
cim:Pss1.vsmx a owl:DatatypeProperty;
              rdfs:comment "Stabilizer output minimum limit (VSMX). Typical value = 0,06."@en;
              rdfs:domain cim:Pss1;
              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
              rdfs:label "vsmx"@en;
              rdfs:range cim:PU.
