                  rdfs:label "ABN"@en;
                  cimdoc:enumCode 193 .
cim:PhaseCode.AC a owl:NamedIndividual,
                   cim:PhaseCode;
                 rdfs:comment "Phases A and C."@en;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "AC"@en;
                 cimdoc:enumCode 96 .
cim:PhaseCode.ACN a owl:NamedIndividual,
