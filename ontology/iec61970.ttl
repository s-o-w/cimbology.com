cim:LoadDynamics a owl:Class;
                 rdfs:comment "Load whose behaviour is described by reference to a standard model or by definition of a user-defined model. A standard feature of dynamic load behaviour modelling is the ability to associate the same behaviour to multiple energy consumers by means of a single load definition. The load model is always applied to individual bus loads (energy consumers)."@en;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "LoadDynamics"@en;
                 rdfs:subClassOf cim:IdentifiedObject;
                 cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.LoadDynamics";
                 cimdoc:packageTier "Normative".
cim:LoadDynamics.EnergyConsumer a owl:ObjectProperty;
                                rdfs:comment "Energy consumer to which this dynamics load model applies."@en;
                                rdfs:domain cim:LoadDynamics;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "EnergyConsumer"@en;
                                rdfs:range cim:EnergyConsumer.
cim:LoadGenericNonLinear a owl:Class;
                         rdfs:comment "Generic non-linear dynamic (GNLD) load. This model can be used in mid-term and long-term voltage stability simulations (i.e., to study voltage collapse), as it can replace a more detailed representation of aggregate load, including induction motors, thermostatically controlled and static loads."@en;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                         rdfs:label "LoadGenericNonLinear"@en;
                         rdfs:subClassOf cim:LoadDynamics;
                         cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.LoadDynamics";
                         cimdoc:packageTier "Normative".
cim:LoadGenericNonLinear.bs a owl:DatatypeProperty;
                            rdfs:comment "Steady state voltage index for reactive power (BS)."@en;
                            rdfs:domain cim:LoadGenericNonLinear;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "bs"@en;
                            rdfs:range xsd:float.
cim:LoadGenericNonLinear.bt a owl:DatatypeProperty;
                            rdfs:comment "Transient voltage index for reactive power (BT)."@en;
                            rdfs:domain cim:LoadGenericNonLinear;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "bt"@en;
                            rdfs:range xsd:float.
cim:LoadGenericNonLinear.genericNonLinearLoadModelType a owl:ObjectProperty;
                                                       rdfs:comment "Type of generic non-linear load model."@en;
