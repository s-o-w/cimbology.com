                                  rdfs:domain cim:RemoteControl;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "actuatorMinimum"@en;
                                  rdfs:range xsd:float.
cim:RemoteControl.remoteControlled a owl:DatatypeProperty;
