cim:ProtectiveActionAdjustmentKind a owl:Class;
                                   rdfs:comment "Categorisation of different protective action adjustments that can be performed on equipment."@en;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                   rdfs:label "ProtectiveActionAdjustmentKind"@en;
                                   owl:equivalentClass [a owl:Class ; 
