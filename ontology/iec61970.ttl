                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "CostPerVolume"@en;
                  owl:equivalentClass xsd:float;
                  cimdoc:cimPackage "IEC61970.Base.Domain";
                  cimdoc:packageTier "Normative".
cim:CostRate a rdfs:Datatype;
             rdfs:comment "Cost, in units of currency, per elapsed time."@en;
             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
             rdfs:label "CostRate"@en;
             owl:equivalentClass xsd:float;
             cimdoc:cimPackage "IEC61970.Base.Domain";
             cimdoc:packageTier "Normative".
cim:CrossCompoundTurbineGovernorDynamics a owl:Class;
                                         rdfs:comment "Turbine-governor cross-compound function block whose behaviour is described by reference to a standard model or by definition of a user- defined model."@en;
                                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                         rdfs:label "CrossCompoundTurbineGovernorDynamics"@en;
                                         rdfs:subClassOf cim:DynamicsFunctionBlock;
                                         cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.TurbineGovernorDynamics";
                                         cimdoc:packageTier "Normative".
cim:CrossCompoundTurbineGovernorDynamics.HighPressureSynchronousMachineDynamics a owl:ObjectProperty;
                                                                                rdfs:comment "High-pressure synchronous machine with which this cross-compound turbine governor is associated."@en;
                                                                                rdfs:domain cim:CrossCompoundTurbineGovernorDynamics;
                                                                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                                                rdfs:label "HighPressureSynchronousMachineDynamics"@en;
                                                                                rdfs:range cim:SynchronousMachineDynamics.
cim:CrossCompoundTurbineGovernorDynamics.LowPressureSynchronousMachineDynamics a owl:ObjectProperty;
                                                                               rdfs:comment "Low-pressure synchronous machine with which this cross-compound turbine governor is associated."@en;
                                                                               rdfs:domain cim:CrossCompoundTurbineGovernorDynamics;
                                                                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                                               rdfs:label "LowPressureSynchronousMachineDynamics"@en;
                                                                               rdfs:range cim:SynchronousMachineDynamics.
cim:CsConverter a owl:Class;
                rdfs:comment "DC side of the current source converter (CSC). The firing angle controls the dc voltage at the converter, both for rectifier and inverter. The difference between the dc voltages of the rectifier and inverter determines the dc current. The extinction angle is used to limit the dc voltage at the inverter, if needed, and is not used in active power control. The firing angle, transformer tap position and number of connected filters are the primary means to control a current source dc line. Higher level controls are built on top, e.g. dc voltage, dc current and active power. From a steady state perspective it is sufficient to specify the wanted active power transfer (ACDCConverter.targetPpcc) and the control functions will set the dc voltage, dc current, firing angle, transformer tap position and number of connected filters to meet this. Therefore attributes targetAlpha and targetGamma are not applicable in this case. The reactive power consumed by the converter is a function of the firing angle, transformer tap position and number of connected filter, which can be approximated with half of the active power. The losses is a function of the dc voltage and dc current. The attributes minAlpha and maxAlpha define the range of firing angles for rectifier operation between which no discrete tap changer action takes place. The range is typically 10-18 degrees. The attributes minGamma and maxGamma define the range of extinction angles for inverter operation between which no discrete tap changer action takes place. The range is typically 17-20 degrees."@en;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "CsConverter"@en;
                rdfs:subClassOf cim:ACDCConverter;
                cimdoc:cimPackage "IEC61970.Base.DC";
                cimdoc:packageTier "Normative".
cim:CsConverter.alpha a owl:DatatypeProperty;
                      rdfs:comment "Firing angle that determines the dc voltage at the converter dc terminal. Typical value between 10 degrees and 18 degrees for a rectifier. It is converter�s state variable, result from power flow. The attribute shall be a positive value."@en;
                      rdfs:domain cim:CsConverter;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "alpha"@en;
                      rdfs:range cim:AngleDegrees.
cim:CsConverter.gamma a owl:DatatypeProperty;
                      rdfs:comment "Extinction angle. It is used to limit the dc voltage at the inverter if needed. Typical value between 17 degrees and 20 degrees for an inverter. It is converter�s state variable, result from power flow. The attribute shall be a positive value."@en;
                      rdfs:domain cim:CsConverter;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "gamma"@en;
                      rdfs:range cim:AngleDegrees.
cim:CsConverter.maxAlpha a owl:DatatypeProperty;
                         rdfs:comment "Maximum firing angle. It is converter�s configuration data used in power flow. The attribute shall be a positive value."@en;
                         rdfs:domain cim:CsConverter;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                         rdfs:label "maxAlpha"@en;
                         rdfs:range cim:AngleDegrees.
cim:CsConverter.maxGamma a owl:DatatypeProperty;
                         rdfs:comment "Maximum extinction angle. It is converter�s configuration data used in power flow. The attribute shall be a positive value."@en;
                         rdfs:domain cim:CsConverter;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                         rdfs:label "maxGamma"@en;
                         rdfs:range cim:AngleDegrees.
cim:CsConverter.maxIdc a owl:DatatypeProperty;
                       rdfs:comment "The maximum direct current (Id) on the DC side at which the converter should operate. It is converter�s configuration data use in power flow. The attribute shall be a positive value."@en;
                       rdfs:domain cim:CsConverter;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "maxIdc"@en;
                       rdfs:range cim:CurrentFlow.
cim:CsConverter.minAlpha a owl:DatatypeProperty;
                         rdfs:comment "Minimum firing angle. It is converter�s configuration data used in power flow. The attribute shall be a positive value."@en;
                         rdfs:domain cim:CsConverter;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                         rdfs:label "minAlpha"@en;
                         rdfs:range cim:AngleDegrees.
cim:CsConverter.minGamma a owl:DatatypeProperty;
                         rdfs:comment "Minimum extinction angle. It is converter�s configuration data used in power flow. The attribute shall be a positive value."@en;
                         rdfs:domain cim:CsConverter;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                         rdfs:label "minGamma"@en;
                         rdfs:range cim:AngleDegrees.
cim:CsConverter.minIdc a owl:DatatypeProperty;
                       rdfs:comment "The minimum direct current (Id) on the DC side at which the converter should operate. It is converter�s configuration data used in power flow. The attribute shall be a positive value."@en;
                       rdfs:domain cim:CsConverter;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "minIdc"@en;
                       rdfs:range cim:CurrentFlow.
cim:CsConverter.operatingMode a owl:ObjectProperty;
                              rdfs:comment "Indicates whether the DC pole is operating as an inverter or as a rectifier. It is converter�s control variable used in power flow."@en;
                              rdfs:domain cim:CsConverter;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "operatingMode"@en;
                              rdfs:range cim:CsOperatingModeKind.
cim:CsConverter.pPccControl a owl:ObjectProperty;
                            rdfs:comment "Kind of active power control."@en;
                            rdfs:domain cim:CsConverter;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "pPccControl"@en;
                            rdfs:range cim:CsPpccControlKind.
cim:CsConverter.ratedIdc a owl:DatatypeProperty;
                         rdfs:comment "Rated converter DC current, also called IdN. The attribute shall be a positive value. It is converter�s configuration data used in power flow."@en;
                         rdfs:domain cim:CsConverter;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                         rdfs:label "ratedIdc"@en;
                         rdfs:range cim:CurrentFlow.
cim:CsConverter.targetAlpha a owl:DatatypeProperty;
                            rdfs:comment "Target firing angle. It is converter's control variable used in power flow. It is only applicable for rectifier if continuous tap changer control is used. Allowed values are within the range minAlpha less than or equal to targetAlpha less than or equal to maxAlpha. The attribute shall be a positive value."@en;
                            rdfs:domain cim:CsConverter;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "targetAlpha"@en;
                            rdfs:range cim:AngleDegrees.
cim:CsConverter.targetGamma a owl:DatatypeProperty;
                            rdfs:comment "Target extinction angle. It is converter's control variable used in power flow. It is only applicable for inverter if continuous tap changer control is used. Allowed values are within the range minGamma less than or equal to targetGamma less than or equal to maxGamma. The attribute shall be a positive value."@en;
                            rdfs:domain cim:CsConverter;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "targetGamma"@en;
                            rdfs:range cim:AngleDegrees.
cim:CsConverter.targetIdc a owl:DatatypeProperty;
                          rdfs:comment "DC current target value. It is converter's control variable used in power flow. The attribute shall be a positive value."@en;
                          rdfs:domain cim:CsConverter;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                          rdfs:label "targetIdc"@en;
                          rdfs:range cim:CurrentFlow.
cim:CsOperatingModeKind a owl:Class;
                        rdfs:comment "Operating mode for HVDC line operating as Current Source Converter."@en;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                        rdfs:label "CsOperatingModeKind"@en;
                        owl:equivalentClass [a owl:Class ; 
                                             owl:oneOf (cim:CsOperatingModeKind.inverter
                                                        cim:CsOperatingModeKind.rectifier)];
                        cimdoc:cimPackage "IEC61970.Base.DC";
                        cimdoc:packageTier "Normative".
cim:CsOperatingModeKind.inverter a owl:NamedIndividual,
                                   cim:CsOperatingModeKind;
                                 rdfs:comment "Operating as inverter, which is the power receiving end."@en;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "inverter"@en;
                                 cimdoc:enumCode 0 .
cim:CsOperatingModeKind.rectifier a owl:NamedIndividual,
                                    cim:CsOperatingModeKind;
                                  rdfs:comment "Operating as rectifier, which is the power sending end."@en;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "rectifier"@en;
                                  cimdoc:enumCode 1 .
cim:CsPpccControlKind a owl:Class;
                      rdfs:comment "Active power control modes for HVDC line operating as Current Source Converter."@en;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "CsPpccControlKind"@en;
                      owl:equivalentClass [a owl:Class ; 
                                           owl:oneOf (cim:CsPpccControlKind.activePower
                                                      cim:CsPpccControlKind.dcCurrent
                                                      cim:CsPpccControlKind.dcVoltage)];
                      cimdoc:cimPackage "IEC61970.Base.DC";
                      cimdoc:packageTier "Normative".
cim:CsPpccControlKind.activePower a owl:NamedIndividual,
                                    cim:CsPpccControlKind;
                                  rdfs:comment "Control is active power control at AC side, at point of common coupling. Target is provided by ACDCConverter.targetPpcc."@en;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "activePower"@en;
                                  cimdoc:enumCode 0 .
cim:CsPpccControlKind.dcCurrent a owl:NamedIndividual,
                                  cim:CsPpccControlKind;
                                rdfs:comment "Control is DC current with target value provided by CsConverter.targetIdc."@en;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "dcCurrent"@en;
                                cimdoc:enumCode 2 .
cim:CsPpccControlKind.dcVoltage a owl:NamedIndividual,
                                  cim:CsPpccControlKind;
                                rdfs:comment "Control is DC voltage with target value provided by ACDCConverter.targetUdc."@en;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "dcVoltage"@en;
                                cimdoc:enumCode 1 .
