                               rdfs:comment "Voltage adjuster function block whose dynamic behaviour is described by a user-defined model."@en;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "VoltageAdjusterUserDefined"@en;
                               rdfs:subClassOf cim:VoltageAdjusterDynamics;
                               cimdoc:cimPackage "IEC61970.Dynamics.UserDefinedModels";
                               cimdoc:packageTier "Normative".
cim:VoltageAdjusterUserDefined.proprietary a owl:DatatypeProperty;
                                           rdfs:comment "Behaviour is based on a proprietary model as opposed to a detailed model. true = user-defined model is proprietary with behaviour mutually understood by sending and receiving applications and parameters passed as general attributes false = user-defined model is explicitly defined in terms of control blocks and their input and output signals."@en;
                                           rdfs:domain cim:VoltageAdjusterUserDefined;
                                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                           rdfs:label "proprietary"@en;
                                           rdfs:range xsd:boolean.
cim:VoltageCompensatorDynamics a owl:Class;
                               rdfs:comment "Voltage compensator function block whose behaviour is described by reference to a standard model or by definition of a user-defined model."@en;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "VoltageCompensatorDynamics"@en;
                               rdfs:subClassOf cim:DynamicsFunctionBlock;
                               cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.VoltageCompensatorDynamics";
                               cimdoc:packageTier "Normative".
cim:VoltageCompensatorDynamics.PFVArControllerType2Dynamics a owl:ObjectProperty;
                                                            rdfs:comment "Power factor or VAr controller type 2 model with which this voltage compensator is associated."@en;
                                                            rdfs:domain cim:VoltageCompensatorDynamics;
                                                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                            rdfs:label "PFVArControllerType2Dynamics"@en;
                                                            rdfs:range cim:PFVArControllerType2Dynamics.
cim:VoltageCompensatorUserDefined a owl:Class;
