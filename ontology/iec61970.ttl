                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                    rdfs:label "NetworkModelProjectRelationship"@en;
                                    rdfs:subClassOf cim:IdentifiedObject;
                                    cimdoc:cimPackage "IEC61970.InfIEC61970.InfPart303.NetworkModelProjects";
                                    cimdoc:packageTier "Informative".
cim:NetworkModelProjectRelationship.ProjectA a owl:ObjectProperty;
                                             rdfs:comment "The first project component in the relationship."@en;
                                             rdfs:domain cim:NetworkModelProjectRelationship;
                                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                             rdfs:label "ProjectA"@en;
                                             rdfs:range cim:NetworkModelProjectComponent.
cim:NetworkModelProjectRelationship.ProjectB a owl:ObjectProperty;
                                             rdfs:comment "The second project component in the relationship."@en;
                                             rdfs:domain cim:NetworkModelProjectRelationship;
                                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                             rdfs:label "ProjectB"@en;
                                             rdfs:range cim:NetworkModelProjectComponent.
cim:NetworkModelProjectStage a owl:Class;
                             rdfs:comment "Represents a stage in a network model project, including changeset version and commissioning dates."@en;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "NetworkModelProjectStage"@en;
                             rdfs:subClassOf cim:NetworkModelProjectComponent2;
                             cimdoc:cimPackage "IEC61970.InfIEC61970.InfPart303.NetworkModelProjects";
                             cimdoc:packageTier "Informative".
cim:NetworkModelProjectStage.ChangeSets a owl:ObjectProperty;
                                        rdfs:comment "The set of changes associated with this project stage."@en;
                                        rdfs:domain cim:NetworkModelProjectStage;
                                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                        rdfs:label "ChangeSets"@en;
                                        rdfs:range cim:ChangeSet.
cim:NetworkModelProjectStage.changesetVersion a owl:DatatypeProperty;
                                              rdfs:comment "The version of the changeset."@en;
                                              rdfs:domain cim:NetworkModelProjectStage;
                                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                              rdfs:label "changesetVersion"@en;
                                              rdfs:range xsd:integer.
cim:NetworkModelProjectStage.commissionedDate a owl:DatatypeProperty;
                                              rdfs:comment "The date the project was commissioned."@en;
                                              rdfs:domain cim:NetworkModelProjectStage;
                                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                              rdfs:label "commissionedDate"@en;
                                              rdfs:range xsd:dateTime.
cim:NetworkModelProjectStage.plannedCommissionedDate a owl:DatatypeProperty;
                                                     rdfs:comment "The planned date for commissioning."@en;
                                                     rdfs:domain cim:NetworkModelProjectStage;
                                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                     rdfs:label "plannedCommissionedDate"@en;
                                                     rdfs:range xsd:dateTime.
cim:NetworkModelProjectState a owl:Class;
                             rdfs:comment """A network model project version state. States are agreed upon by the exchange community. Examples are \"approved\", \"proposed\", \"withdrawn\", \"committed\" etc."""@en;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "NetworkModelProjectState"@en;
                             rdfs:subClassOf cim:IdentifiedObject;
                             cimdoc:cimPackage "IEC61970.InfIEC61970.InfPart303.NetworkModelProjects";
                             cimdoc:packageTier "Informative".
cim:NonConformLoad a owl:Class;
                   rdfs:comment "NonConformLoad represents loads that do not follow a daily load change pattern and whose changes are not correlated with the daily load change pattern."@en;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "NonConformLoad"@en;
                   rdfs:subClassOf cim:EnergyConsumer;
                   cimdoc:cimPackage "IEC61970.Base.LoadModel";
                   cimdoc:packageTier "Normative".
cim:NonConformLoadGroup a owl:Class;
                        rdfs:comment "Loads that do not follow a daily and seasonal load variation pattern."@en;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                        rdfs:label "NonConformLoadGroup"@en;
                        rdfs:subClassOf cim:LoadGroup;
                        cimdoc:cimPackage "IEC61970.Base.LoadModel";
                        cimdoc:packageTier "Normative".
cim:NonConformLoadGroup.EnergyConsumers a owl:ObjectProperty;
                                        rdfs:comment "Conform loads assigned to this ConformLoadGroup."@en;
                                        rdfs:domain cim:NonConformLoadGroup;
                                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                        rdfs:label "EnergyConsumers"@en;
                                        rdfs:range cim:NonConformLoad.
cim:NonConformLoadGroup.NonConformLoadSchedules a owl:ObjectProperty;
                                                rdfs:comment "The NonConformLoadSchedules in the NonConformLoadGroup."@en;
                                                rdfs:domain cim:NonConformLoadGroup;
                                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                rdfs:label "NonConformLoadSchedules"@en;
                                                rdfs:range cim:NonConformLoadSchedule.
cim:NonConformLoadSchedule a owl:Class;
                           rdfs:comment "An active power (Y1-axis) and reactive power (Y2-axis) schedule (curves) versus time (X-axis) for non-conforming loads, e.g., large industrial load or power station service (where modelled)."@en;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "NonConformLoadSchedule"@en;
                           rdfs:subClassOf cim:SeasonDayTypeSchedule;
                           cimdoc:cimPackage "IEC61970.Base.LoadModel";
                           cimdoc:packageTier "Normative".
cim:NonlinearShuntCompensator a owl:Class;
                              rdfs:comment "A non linear shunt compensator has bank or section admittance values that differ. The attributes g, b, g0 and b0 of the associated NonlinearShuntCompensatorPoint describe the total conductance and admittance of a NonlinearShuntCompensatorPoint at a section number specified by NonlinearShuntCompensatorPoint.sectionNumber."@en;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "NonlinearShuntCompensator"@en;
                              rdfs:subClassOf cim:ShuntCompensator;
                              cimdoc:cimPackage "IEC61970.Base.Wires";
                              cimdoc:packageTier "Normative".
cim:NonlinearShuntCompensator.NonlinearShuntCompensatorPoints a owl:ObjectProperty;
                                                              rdfs:comment "All points of the non-linear shunt compensator."@en;
                                                              rdfs:domain cim:NonlinearShuntCompensator;
                                                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                              rdfs:label "NonlinearShuntCompensatorPoints"@en;
                                                              rdfs:range cim:NonlinearShuntCompensatorPoint.
cim:NonlinearShuntCompensatorPhase a owl:Class;
                                   rdfs:comment "A per phase non linear shunt compensator has bank or section admittance values that differ. The attributes g and b of the associated NonlinearShuntCompensatorPhasePoint describe the total conductance and admittance of a NonlinearShuntCompensatorPhasePoint at a section number specified by NonlinearShuntCompensatorPhasePoint.sectionNumber."@en;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                   rdfs:label "NonlinearShuntCompensatorPhase"@en;
                                   rdfs:subClassOf cim:ShuntCompensatorPhase;
                                   cimdoc:cimPackage "IEC61970.Base.Wires";
                                   cimdoc:packageTier "Normative".
cim:NonlinearShuntCompensatorPhase.NonlinearShuntCompensatorPhasePoints a owl:ObjectProperty;
                                                                        rdfs:comment "All points of the non-linear shunt compensator phase."@en;
                                                                        rdfs:domain cim:NonlinearShuntCompensatorPhase;
                                                                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                                        rdfs:label "NonlinearShuntCompensatorPhasePoints"@en;
                                                                        rdfs:range cim:NonlinearShuntCompensatorPhasePoint.
cim:NonlinearShuntCompensatorPhasePoint a owl:Class;
                                        rdfs:comment "A per phase non linear shunt compensator bank or section admittance value. The number of NonlinearShuntCompenstorPhasePoint instances associated with a NonlinearShuntCompensatorPhase shall be equal to ShuntCompensatorPhase. maximumSections. ShuntCompensator.sections shall only be set to one of the NonlinearShuntCompenstorPhasePoint.sectionNumber. There is no interpolation between NonlinearShuntCompenstorPhasePoint-s."@en;
                                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                        rdfs:label "NonlinearShuntCompensatorPhasePoint"@en;
                                        cimdoc:cimPackage "IEC61970.Base.Wires";
                                        cimdoc:packageTier "Normative".
cim:NonlinearShuntCompensatorPhasePoint.b a owl:DatatypeProperty;
                                          rdfs:comment "Positive sequence shunt (charging) susceptance per section."@en;
                                          rdfs:domain cim:NonlinearShuntCompensatorPhasePoint;
                                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                          rdfs:label "b"@en;
                                          rdfs:range cim:Susceptance.
cim:NonlinearShuntCompensatorPhasePoint.g a owl:DatatypeProperty;
                                          rdfs:comment "Positive sequence shunt (charging) conductance per section."@en;
                                          rdfs:domain cim:NonlinearShuntCompensatorPhasePoint;
                                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                          rdfs:label "g"@en;
                                          rdfs:range cim:Conductance.
cim:NonlinearShuntCompensatorPhasePoint.sectionNumber a owl:DatatypeProperty;
                                                      rdfs:comment "The number of the section."@en;
                                                      rdfs:domain cim:NonlinearShuntCompensatorPhasePoint;
                                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                      rdfs:label "sectionNumber"@en;
                                                      rdfs:range xsd:integer.
cim:NonlinearShuntCompensatorPoint a owl:Class;
                                   rdfs:comment "A non linear shunt compensator bank or section admittance value. The number of NonlinearShuntCompenstorPoint instances associated with a NonlinearShuntCompensator shall be equal to ShuntCompensator.maximumSections. ShuntCompensator.sections shall only be set to one of the NonlinearShuntCompenstorPoint.sectionNumber. There is no interpolation between NonlinearShuntCompenstorPoint-s."@en;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                   rdfs:label "NonlinearShuntCompensatorPoint"@en;
                                   cimdoc:cimPackage "IEC61970.Base.Wires";
                                   cimdoc:packageTier "Normative".
cim:NonlinearShuntCompensatorPoint.b a owl:DatatypeProperty;
                                     rdfs:comment "Positive sequence shunt (charging) susceptance per section."@en;
                                     rdfs:domain cim:NonlinearShuntCompensatorPoint;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                     rdfs:label "b"@en;
                                     rdfs:range cim:Susceptance.
cim:NonlinearShuntCompensatorPoint.b0 a owl:DatatypeProperty;
                                      rdfs:comment "Zero sequence shunt (charging) susceptance per section."@en;
                                      rdfs:domain cim:NonlinearShuntCompensatorPoint;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                      rdfs:label "b0"@en;
                                      rdfs:range cim:Susceptance.
cim:NonlinearShuntCompensatorPoint.g a owl:DatatypeProperty;
                                     rdfs:comment "Positive sequence shunt (charging) conductance per section."@en;
                                     rdfs:domain cim:NonlinearShuntCompensatorPoint;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                     rdfs:label "g"@en;
                                     rdfs:range cim:Conductance.
cim:NonlinearShuntCompensatorPoint.g0 a owl:DatatypeProperty;
                                      rdfs:comment "Zero sequence shunt (charging) conductance per section."@en;
                                      rdfs:domain cim:NonlinearShuntCompensatorPoint;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                      rdfs:label "g0"@en;
                                      rdfs:range cim:Conductance.
cim:NonlinearShuntCompensatorPoint.sectionNumber a owl:DatatypeProperty;
                                                 rdfs:comment "The number of the section."@en;
                                                 rdfs:domain cim:NonlinearShuntCompensatorPoint;
                                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                 rdfs:label "sectionNumber"@en;
                                                 rdfs:range xsd:integer.
cim:NuclearGeneratingUnit a owl:Class;
                          rdfs:comment "A nuclear generating unit."@en;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                          rdfs:label "NuclearGeneratingUnit"@en;
                          rdfs:subClassOf cim:GeneratingUnit;
                          cimdoc:cimPackage "IEC61970.Base.Generation.Production";
                          cimdoc:packageTier "Normative".
cim:ObjectCreation a owl:Class;
                   rdfs:comment "Represents an object creation within the dataset context."@en;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "ObjectCreation"@en;
                   rdfs:subClassOf cim:ChangeSetMember;
                   cimdoc:cimPackage "IEC61970.InfIEC61970.Part303.GenericDataSet";
                   cimdoc:packageTier "Informative".
cim:ObjectDeletion a owl:Class;
                   rdfs:comment "Represents an object deletion within the dataset context."@en;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "ObjectDeletion"@en;
                   rdfs:subClassOf cim:ChangeSetMember;
                   cimdoc:cimPackage "IEC61970.InfIEC61970.Part303.GenericDataSet";
                   cimdoc:packageTier "Informative".
cim:ObjectModification a owl:Class;
                       rdfs:comment "Represents an object modification for an already existing object."@en;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "ObjectModification"@en;
                       rdfs:subClassOf cim:ChangeSetMember;
                       cimdoc:cimPackage "IEC61970.InfIEC61970.Part303.GenericDataSet";
                       cimdoc:packageTier "Informative".
cim:ObjectReverseModification a owl:Class;
                              rdfs:comment "Used to specify precondition properties for a preconditioned update."@en;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "ObjectReverseModification"@en;
                              rdfs:subClassOf cim:ChangeSetMember;
                              cimdoc:cimPackage "IEC61970.InfIEC61970.Part303.GenericDataSet";
                              cimdoc:packageTier "Informative".
cim:ObjectReverseModification.ObjectModification a owl:ObjectProperty;
                                                 rdfs:comment "Gets or sets the associated data object representing the update. Normally the association is specified, but in the case of a proxy object where the association is removed, it might not reference any data object."@en;
                                                 rdfs:domain cim:ObjectReverseModification;
                                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                 rdfs:label "ObjectModification"@en;
                                                 rdfs:range cim:ObjectModification.
cim:OperatingParticipant a owl:Class;
                         rdfs:comment "An operator of multiple power system resource objects. Note multple operating participants may operate the same power system resource object. This can be used for modeling jointly owned units where each owner operates as a contractual share."@en;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                         rdfs:label "OperatingParticipant"@en;
                         rdfs:subClassOf cim:IdentifiedObject;
                         cimdoc:cimPackage "IEC61970.Base.Core";
                         cimdoc:packageTier "Normative".
cim:OperatingShare a owl:Class;
                   rdfs:comment "Specifies the operations contract relationship between a power system resource and a contract participant."@en;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "OperatingShare"@en;
                   cimdoc:cimPackage "IEC61970.Base.Core";
                   cimdoc:packageTier "Normative".
cim:OperatingShare.OperatingParticipant a owl:ObjectProperty;
                                        rdfs:comment "The operating participant having this share with the associated power system resource."@en;
                                        rdfs:domain cim:OperatingShare;
                                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                        rdfs:label "OperatingParticipant"@en;
                                        rdfs:range cim:OperatingParticipant.
cim:OperatingShare.PowerSystemResource a owl:ObjectProperty;
                                       rdfs:comment "The power system resource to which the share applies."@en;
                                       rdfs:domain cim:OperatingShare;
                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                       rdfs:label "PowerSystemResource"@en;
                                       rdfs:range cim:PowerSystemResource.
cim:OperatingShare.percentage a owl:DatatypeProperty;
                              rdfs:comment "Percentage operational ownership between the pair (power system resource and operating participant) associated with this share. The total percentage ownership for a power system resource should add to 100%."@en;
                              rdfs:domain cim:OperatingShare;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "percentage"@en;
                              rdfs:range cim:PerCent.
cim:Operation a owl:Class;
              rdfs:comment "Represents an operation in the network model frame."@en;
              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
              rdfs:label "Operation"@en;
              cimdoc:cimPackage "IEC61970.InfIEC61970.InfPart303.NetworkModelFrames";
              cimdoc:packageTier "Informative".
cim:OperationalLimit a owl:Class;
                     rdfs:comment "A value and normal value associated with a specific kind of limit. The sub class value and normalValue attributes vary inversely to the associated OperationalLimitType.acceptableDuration (acceptableDuration for short). If a particular piece of equipment has multiple operational limits of the same kind (apparent power, current, etc.), the limit with the greatest acceptableDuration shall have the smallest limit value and the limit with the smallest acceptableDuration shall have the largest limit value. Note: A large current can only be allowed to flow through a piece of equipment for a short duration without causing damage, but a lesser current can be allowed to flow for a longer duration."@en;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                     rdfs:label "OperationalLimit"@en;
                     rdfs:subClassOf cim:IdentifiedObject;
                     cimdoc:cimPackage "IEC61970.Base.OperationalLimits";
                     cimdoc:packageTier "Normative".
cim:OperationalLimit.LimitDependencyModel a owl:ObjectProperty;
                                          rdfs:comment "The limit dependency models which are used to calculate this limit. If no limit dependencies are specified then the native limit value is used."@en;
                                          rdfs:domain cim:OperationalLimit;
                                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                          rdfs:label "LimitDependencyModel"@en;
                                          rdfs:range cim:LimitDependency.
cim:OperationalLimit.OperationalLimitType a owl:ObjectProperty;
                                          rdfs:comment "The limit type associated with this limit."@en;
                                          rdfs:domain cim:OperationalLimit;
                                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                          rdfs:label "OperationalLimitType"@en;
                                          rdfs:range cim:OperationalLimitType.
cim:OperationalLimitDirectionKind a owl:Class;
                                  rdfs:comment "The direction attribute describes the side of a limit that is a violation."@en;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "OperationalLimitDirectionKind"@en;
                                  owl:equivalentClass [a owl:Class ; 
                                                       owl:oneOf (cim:OperationalLimitDirectionKind.absoluteValue
                                                                  cim:OperationalLimitDirectionKind.high
                                                                  cim:OperationalLimitDirectionKind.low)];
                                  cimdoc:cimPackage "IEC61970.Base.OperationalLimits";
                                  cimdoc:packageTier "Normative".
cim:OperationalLimitDirectionKind.absoluteValue a owl:NamedIndividual,
                                                  cim:OperationalLimitDirectionKind;
                                                rdfs:comment "An absoluteValue limit means that a monitored absolute value above the limit value is a violation."@en;
                                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                rdfs:label "absoluteValue"@en;
                                                cimdoc:enumCode 2 .
cim:OperationalLimitDirectionKind.high a owl:NamedIndividual,
                                         cim:OperationalLimitDirectionKind;
                                       rdfs:comment "High means that a monitored value above the limit value is a violation. If applied to a terminal flow, the positive direction is into the terminal."@en;
                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                       rdfs:label "high"@en;
                                       cimdoc:enumCode 0 .
cim:OperationalLimitDirectionKind.low a owl:NamedIndividual,
                                        cim:OperationalLimitDirectionKind;
                                      rdfs:comment "Low means a monitored value below the limit is a violation. If applied to a terminal flow, the positive direction is into the terminal."@en;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                      rdfs:label "low"@en;
                                      cimdoc:enumCode 1 .
cim:OperationalLimitSet a owl:Class;
                        rdfs:comment "A set of limits associated with equipment. Sets of limits might apply to a specific temperature, or season for example. A set of limits may contain different severities of limit levels that would apply to the same equipment. The set may contain limits of different types such as apparent power and current limits or high and low voltage limits that are logically applied together as a set."@en;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                        rdfs:label "OperationalLimitSet"@en;
                        rdfs:subClassOf cim:IdentifiedObject;
                        cimdoc:cimPackage "IEC61970.Base.OperationalLimits";
                        cimdoc:packageTier "Normative".
cim:OperationalLimitSet.Equipment a owl:ObjectProperty;
                                  rdfs:comment "The equipment to which the limit set applies."@en;
                                  rdfs:domain cim:OperationalLimitSet;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "Equipment"@en;
                                  rdfs:range cim:Equipment.
cim:OperationalLimitSet.OperationalLimitValue a owl:ObjectProperty;
                                              rdfs:comment "Values of equipment limits."@en;
                                              rdfs:domain cim:OperationalLimitSet;
                                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                              rdfs:label "OperationalLimitValue"@en;
                                              rdfs:range cim:OperationalLimit.
cim:OperationalLimitSet.Terminal a owl:ObjectProperty;
                                 rdfs:comment "The terminal where the operational limit set apply."@en;
                                 rdfs:domain cim:OperationalLimitSet;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "Terminal"@en;
                                 rdfs:range cim:ACDCTerminal.
cim:OperationalLimitType a owl:Class;
                         rdfs:comment "The operational meaning of a category of limits."@en;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                         rdfs:label "OperationalLimitType"@en;
                         rdfs:subClassOf cim:IdentifiedObject;
                         cimdoc:cimPackage "IEC61970.Base.OperationalLimits";
                         cimdoc:packageTier "Normative".
cim:OperationalLimitType.acceptableDuration a owl:DatatypeProperty;
                                            rdfs:comment "The nominal acceptable duration of the limit. Limits are commonly expressed in terms of the time limit for which the limit is normally acceptable. The actual acceptable duration of a specific limit may depend on other local factors such as temperature or wind speed. The attribute has meaning only if the flag isInfiniteDuration is set to false, hence it shall not be exchanged when isInfiniteDuration is set to true."@en;
                                            rdfs:domain cim:OperationalLimitType;
                                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                            rdfs:label "acceptableDuration"@en;
                                            rdfs:range cim:Seconds.
cim:OperationalLimitType.direction a owl:ObjectProperty;
                                   rdfs:comment "The direction of the limit."@en;
                                   rdfs:domain cim:OperationalLimitType;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                   rdfs:label "direction"@en;
                                   rdfs:range cim:OperationalLimitDirectionKind.
cim:OperationalLimitType.isInfiniteDuration a owl:DatatypeProperty;
                                            rdfs:comment "Defines if the operational limit type has infinite duration. If true, the limit has infinite duration. If false, the limit has definite duration which is defined by the attribute acceptableDuration."@en;
                                            rdfs:domain cim:OperationalLimitType;
                                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                            rdfs:label "isInfiniteDuration"@en;
                                            rdfs:range xsd:boolean.
cim:OperatonalLimitTypeScaling a owl:Class;
                               rdfs:comment "Represents scaling between two operational limit types within the same set."@en;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "OperatonalLimitTypeScaling"@en;
                               cimdoc:cimPackage "IEC61970.InfIEC61970.InfOperationalLimits";
                               cimdoc:packageTier "Informative".
cim:OperatonalLimitTypeScaling.SourceOperationalLimitType a owl:ObjectProperty;
                                                          rdfs:comment "The source operational limit type."@en;
                                                          rdfs:domain cim:OperatonalLimitTypeScaling;
                                                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                          rdfs:label "SourceOperationalLimitType"@en;
                                                          rdfs:range cim:OperationalLimitType.
cim:OperatonalLimitTypeScaling.TargetOperationalLimit a owl:ObjectProperty;
                                                      rdfs:comment "The target operational limit type."@en;
                                                      rdfs:domain cim:OperatonalLimitTypeScaling;
                                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                      rdfs:label "TargetOperationalLimit"@en;
                                                      rdfs:range cim:OperationalLimitType.
cim:OperatonalLimitTypeScaling.scalingPercent a owl:DatatypeProperty;
                                              rdfs:comment "The percentage scaling of the source limit to compute the target limit. Applies to operational limits within an operational limit set when both source and target operational limit types exist."@en;
                                              rdfs:domain cim:OperatonalLimitTypeScaling;
                                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                              rdfs:label "scalingPercent"@en;
                                              rdfs:range cim:PerCent.
cim:OrientationKind a owl:Class;
                    rdfs:comment "The orientation of the coordinate system with respect to top, left, and the coordinate number system."@en;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "OrientationKind"@en;
                    owl:equivalentClass [a owl:Class ; 
                                         owl:oneOf (cim:OrientationKind.negative
                                                    cim:OrientationKind.positive)];
                    cimdoc:cimPackage "IEC61970.Base.DiagramLayout";
                    cimdoc:packageTier "Normative".
cim:OrientationKind.negative a owl:NamedIndividual,
                               cim:OrientationKind;
                             rdfs:comment "For 2D diagrams, a negative orientation gives the left-hand orientation (favoured by computer graphics displays) with X values increasing from left to right and Y values increasing from top to bottom. This is also known as a left hand orientation."@en;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "negative"@en;
                             cimdoc:enumCode 1 .
cim:OrientationKind.positive a owl:NamedIndividual,
                               cim:OrientationKind;
                             rdfs:comment "For 2D diagrams, a positive orientation will result in X values increasing from left to right and Y values increasing from bottom to top. This is also known as a right hand orientation."@en;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                             rdfs:label "positive"@en;
                             cimdoc:enumCode 0 .
cim:OverexcLim2 a owl:Class;
                rdfs:comment "Different from LimIEEEOEL, LimOEL2 has a fixed pickup threshold and reduces the excitation set-point by means of a non-windup integral regulator. Irated is the rated machine excitation current (calculated from nameplate conditions: Vnom, Pnom, CosPhinom)."@en;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "OverexcLim2"@en;
                rdfs:subClassOf cim:OverexcitationLimiterDynamics;
                cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.OverexcitationLimiterDynamics";
                cimdoc:packageTier "Normative".
cim:OverexcLim2.ifdlim a owl:DatatypeProperty;
                       rdfs:comment "Limit value of rated field current (IFDLIM). Typical value = 1,05."@en;
                       rdfs:domain cim:OverexcLim2;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "ifdlim"@en;
                       rdfs:range cim:PU.
cim:OverexcLim2.koi a owl:DatatypeProperty;
                    rdfs:comment "Gain Over excitation limiter (KOI). Typical value = 0, 1."@en;
                    rdfs:domain cim:OverexcLim2;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "koi"@en;
                    rdfs:range cim:PU.
cim:OverexcLim2.voimax a owl:DatatypeProperty;
                       rdfs:comment "Maximum error signal (VOIMAX) (greater than OverexcLim2.voimin). Typical value = 0."@en;
                       rdfs:domain cim:OverexcLim2;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "voimax"@en;
                       rdfs:range cim:PU.
cim:OverexcLim2.voimin a owl:DatatypeProperty;
                       rdfs:comment "Minimum error signal (VOIMIN) (less than OverexcLim2.voimax). Typical value = -9999."@en;
                       rdfs:domain cim:OverexcLim2;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "voimin"@en;
                       rdfs:range cim:PU.
cim:OverexcLimIEEE a owl:Class;
                   rdfs:comment "The over excitation limiter model is intended to represent the significant features of OELs necessary for some large-scale system studies. It is the result of a pragmatic approach to obtain a model that can be widely applied with attainable data from generator owners. An attempt to include all variations in the functionality of OELs and duplicate how they interact with the rest of the excitation systems would likely result in a level of application insufficient for the studies for which they are intended. Reference: IEEE OEL 421.5-2005, 9."@en;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "OverexcLimIEEE"@en;
                   rdfs:subClassOf cim:OverexcitationLimiterDynamics;
                   cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.OverexcitationLimiterDynamics";
                   cimdoc:packageTier "Normative".
cim:OverexcLimIEEE.hyst a owl:DatatypeProperty;
                        rdfs:comment "OEL pickup/drop-out hysteresis (HYST). Typical value = 0,03."@en;
                        rdfs:domain cim:OverexcLimIEEE;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                        rdfs:label "hyst"@en;
                        rdfs:range cim:PU.
cim:OverexcLimIEEE.ifdlim a owl:DatatypeProperty;
                          rdfs:comment "OEL timed field current limit (IFDLIM). Typical value = 1,05."@en;
                          rdfs:domain cim:OverexcLimIEEE;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                          rdfs:label "ifdlim"@en;
                          rdfs:range cim:PU.
cim:OverexcLimIEEE.ifdmax a owl:DatatypeProperty;
                          rdfs:comment "OEL instantaneous field current limit (IFDMAX). Typical value = 1,5."@en;
                          rdfs:domain cim:OverexcLimIEEE;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                          rdfs:label "ifdmax"@en;
                          rdfs:range cim:PU.
cim:OverexcLimIEEE.itfpu a owl:DatatypeProperty;
                         rdfs:comment "OEL timed field current limiter pickup level (ITFPU). Typical value = 1,05."@en;
                         rdfs:domain cim:OverexcLimIEEE;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                         rdfs:label "itfpu"@en;
                         rdfs:range cim:PU.
cim:OverexcLimIEEE.kcd a owl:DatatypeProperty;
                       rdfs:comment "OEL cooldown gain (KCD). Typical value = 1."@en;
                       rdfs:domain cim:OverexcLimIEEE;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "kcd"@en;
                       rdfs:range cim:PU.
cim:OverexcLimIEEE.kramp a owl:DatatypeProperty;
                         rdfs:comment "OEL ramped limit rate (KRAMP). Unit = PU / s. Typical value = 10."@en;
                         rdfs:domain cim:OverexcLimIEEE;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                         rdfs:label "kramp"@en;
                         rdfs:range xsd:float.
cim:OverexcLimX1 a owl:Class;
                 rdfs:comment "Field voltage over excitation limiter."@en;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "OverexcLimX1"@en;
                 rdfs:subClassOf cim:OverexcitationLimiterDynamics;
                 cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.OverexcitationLimiterDynamics";
                 cimdoc:packageTier "Normative".
cim:OverexcLimX1.efd1 a owl:DatatypeProperty;
                      rdfs:comment "Low voltage point on the inverse time characteristic (EFD1). Typical value = 1,1."@en;
                      rdfs:domain cim:OverexcLimX1;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "efd1"@en;
                      rdfs:range cim:PU.
cim:OverexcLimX1.efd2 a owl:DatatypeProperty;
                      rdfs:comment "Mid voltage point on the inverse time characteristic (EFD2). Typical value = 1,2."@en;
                      rdfs:domain cim:OverexcLimX1;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "efd2"@en;
                      rdfs:range cim:PU.
cim:OverexcLimX1.efd3 a owl:DatatypeProperty;
                      rdfs:comment "High voltage point on the inverse time characteristic (EFD3). Typical value = 1,5."@en;
                      rdfs:domain cim:OverexcLimX1;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "efd3"@en;
                      rdfs:range cim:PU.
cim:OverexcLimX1.efddes a owl:DatatypeProperty;
                        rdfs:comment "Desired field voltage (EFDDES). Typical value = 0,9."@en;
                        rdfs:domain cim:OverexcLimX1;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                        rdfs:label "efddes"@en;
                        rdfs:range cim:PU.
cim:OverexcLimX1.efdrated a owl:DatatypeProperty;
                          rdfs:comment "Rated field voltage (EFDRATED). Typical value = 1,05."@en;
                          rdfs:domain cim:OverexcLimX1;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                          rdfs:label "efdrated"@en;
                          rdfs:range cim:PU.
cim:OverexcLimX1.kmx a owl:DatatypeProperty;
                     rdfs:comment "Gain (KMX). Typical value = 0,01."@en;
                     rdfs:domain cim:OverexcLimX1;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                     rdfs:label "kmx"@en;
                     rdfs:range cim:PU.
cim:OverexcLimX1.t1 a owl:DatatypeProperty;
                    rdfs:comment "Time to trip the exciter at the low voltage point on the inverse time characteristic (TIME1) (>= 0). Typical value = 120."@en;
                    rdfs:domain cim:OverexcLimX1;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "t1"@en;
                    rdfs:range cim:Seconds.
cim:OverexcLimX1.t2 a owl:DatatypeProperty;
                    rdfs:comment "Time to trip the exciter at the mid voltage point on the inverse time characteristic (TIME2) (>= 0). Typical value = 40."@en;
                    rdfs:domain cim:OverexcLimX1;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "t2"@en;
                    rdfs:range cim:Seconds.
cim:OverexcLimX1.t3 a owl:DatatypeProperty;
                    rdfs:comment "Time to trip the exciter at the high voltage point on the inverse time characteristic (TIME3) (>= 0). Typical value = 15."@en;
                    rdfs:domain cim:OverexcLimX1;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "t3"@en;
                    rdfs:range cim:Seconds.
cim:OverexcLimX1.vlow a owl:DatatypeProperty;
                      rdfs:comment "Low voltage limit (VLOW) (> 0)."@en;
                      rdfs:domain cim:OverexcLimX1;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "vlow"@en;
                      rdfs:range cim:PU.
cim:OverexcLimX2 a owl:Class;
                 rdfs:comment "Field voltage or current overexcitation limiter designed to protect the generator field of an AC machine with automatic excitation control from overheating due to prolonged overexcitation."@en;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "OverexcLimX2"@en;
                 rdfs:subClassOf cim:OverexcitationLimiterDynamics;
                 cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.OverexcitationLimiterDynamics";
                 cimdoc:packageTier "Normative".
cim:OverexcLimX2.efd1 a owl:DatatypeProperty;
                      rdfs:comment "Low voltage or current point on the inverse time characteristic (EFD1). Typical value = 1,1."@en;
                      rdfs:domain cim:OverexcLimX2;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "efd1"@en;
                      rdfs:range cim:PU.
cim:OverexcLimX2.efd2 a owl:DatatypeProperty;
                      rdfs:comment "Mid voltage or current point on the inverse time characteristic (EFD2). Typical value = 1,2."@en;
                      rdfs:domain cim:OverexcLimX2;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "efd2"@en;
                      rdfs:range cim:PU.
cim:OverexcLimX2.efd3 a owl:DatatypeProperty;
                      rdfs:comment "High voltage or current point on the inverse time characteristic (EFD3). Typical value = 1,5."@en;
                      rdfs:domain cim:OverexcLimX2;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "efd3"@en;
                      rdfs:range cim:PU.
cim:OverexcLimX2.efddes a owl:DatatypeProperty;
                        rdfs:comment "Desired field voltage if m = false or desired field current if m = true (EFDDES). Typical value = 1."@en;
                        rdfs:domain cim:OverexcLimX2;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                        rdfs:label "efddes"@en;
                        rdfs:range cim:PU.
cim:OverexcLimX2.efdrated a owl:DatatypeProperty;
                          rdfs:comment "Rated field voltage if m = false or rated field current if m = true (EFDRATED). Typical value = 1,05."@en;
                          rdfs:domain cim:OverexcLimX2;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                          rdfs:label "efdrated"@en;
                          rdfs:range cim:PU.
cim:OverexcLimX2.kmx a owl:DatatypeProperty;
                     rdfs:comment "Gain (KMX). Typical value = 0,002."@en;
                     rdfs:domain cim:OverexcLimX2;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                     rdfs:label "kmx"@en;
                     rdfs:range cim:PU.
cim:OverexcLimX2.m a owl:DatatypeProperty;
                   rdfs:comment "(m). true = IFD limiting false = EFD limiting."@en;
                   rdfs:domain cim:OverexcLimX2;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "m"@en;
                   rdfs:range xsd:boolean.
cim:OverexcLimX2.t1 a owl:DatatypeProperty;
                    rdfs:comment "Time to trip the exciter at the low voltage or current point on the inverse time characteristic (TIME1) (>= 0). Typical value = 120."@en;
                    rdfs:domain cim:OverexcLimX2;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "t1"@en;
                    rdfs:range cim:Seconds.
cim:OverexcLimX2.t2 a owl:DatatypeProperty;
                    rdfs:comment "Time to trip the exciter at the mid voltage or current point on the inverse time characteristic (TIME2) (>= 0). Typical value = 40."@en;
                    rdfs:domain cim:OverexcLimX2;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "t2"@en;
                    rdfs:range cim:Seconds.
cim:OverexcLimX2.t3 a owl:DatatypeProperty;
                    rdfs:comment "Time to trip the exciter at the high voltage or current point on the inverse time characteristic (TIME3) (>= 0). Typical value = 15."@en;
                    rdfs:domain cim:OverexcLimX2;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "t3"@en;
                    rdfs:range cim:Seconds.
cim:OverexcLimX2.vlow a owl:DatatypeProperty;
                      rdfs:comment "Low voltage limit (VLOW) (> 0)."@en;
                      rdfs:domain cim:OverexcLimX2;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "vlow"@en;
                      rdfs:range cim:PU.
cim:OverexcitationLimiterDynamics a owl:Class;
                                  rdfs:comment "Overexcitation limiter function block whose behaviour is described by reference to a standard model or by definition of a user-defined model."@en;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "OverexcitationLimiterDynamics"@en;
                                  rdfs:subClassOf cim:DynamicsFunctionBlock;
                                  cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.OverexcitationLimiterDynamics";
                                  cimdoc:packageTier "Normative".
cim:OverexcitationLimiterDynamics.ExcitationSystemDynamics a owl:ObjectProperty;
                                                           rdfs:comment "Excitation system model with which this overexcitation limiter model is associated."@en;
                                                           rdfs:domain cim:OverexcitationLimiterDynamics;
                                                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                           rdfs:label "ExcitationSystemDynamics"@en;
                                                           rdfs:range cim:ExcitationSystemDynamics.
cim:OverexcitationLimiterUserDefined a owl:Class;
                                     rdfs:comment "Overexcitation limiter system function block whose dynamic behaviour is described by a user-defined model."@en;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                     rdfs:label "OverexcitationLimiterUserDefined"@en;
                                     rdfs:subClassOf cim:OverexcitationLimiterDynamics;
                                     cimdoc:cimPackage "IEC61970.Dynamics.UserDefinedModels";
                                     cimdoc:packageTier "Normative".
cim:OverexcitationLimiterUserDefined.proprietary a owl:DatatypeProperty;
                                                 rdfs:comment "Behaviour is based on a proprietary model as opposed to a detailed model. true = user-defined model is proprietary with behaviour mutually understood by sending and receiving applications and parameters passed as general attributes false = user-defined model is explicitly defined in terms of control blocks and their input and output signals."@en;
                                                 rdfs:domain cim:OverexcitationLimiterUserDefined;
                                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                 rdfs:label "proprietary"@en;
                                                 rdfs:range xsd:boolean.
cim:PFVArControllerType1Dynamics a owl:Class;
                                 rdfs:comment "Power factor or VAr controller type 1 function block whose behaviour is described by reference to a standard model or by definition of a user-defined model."@en;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
