cim:ExcSEXS.tc a owl:DatatypeProperty;
               rdfs:comment "PI controller phase lead time constant (Tc) (>= 0). Typical value = 0."@en;
               rdfs:domain cim:ExcSEXS;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "tc"@en;
