cim:ExcIEEEST7B a owl:Class;
                rdfs:comment "IEEE 421.5-2005 type ST7B model. This model is representative of static potential-source excitation systems. In this system, the AVR consists of a PI voltage regulator. A phase lead-lag filter in series allows the introduction of a derivative function, typically used with brushless excitation systems. In that case, the regulator is of the PID type. In addition, the terminal voltage channel includes a phase lead-lag filter. The AVR includes the appropriate inputs on its reference for overexcitation limiter (OEL1), underexcitation limiter (UEL), stator current limiter (SCL), and current compensator (DROOP). All these limitations, when they work at voltage reference level, keep the PSS (VS signal from PSS) in operation. However, the UEL limitation can also be transferred to the high value (HV) gate acting on the output signal. In addition, the output signal passes through a low value (LV) gate for a ceiling overexcitation limiter (OEL2). Reference: IEEE 421.5-2005, 7.7."@en;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "ExcIEEEST7B"@en;
                rdfs:subClassOf cim:ExcitationSystemDynamics;
                cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.ExcitationSystemDynamics";
                cimdoc:packageTier "Normative".
cim:ExcIEEEST7B.kh a owl:DatatypeProperty;
                   rdfs:comment "High-value gate feedback gain (KH) (>= 0). Typical value = 1."@en;
                   rdfs:domain cim:ExcIEEEST7B;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "kh"@en;
                   rdfs:range cim:PU.
cim:ExcIEEEST7B.kia a owl:DatatypeProperty;
                    rdfs:comment "Voltage regulator integral gain (KIA) (>= 0). Typical value = 1."@en;
                    rdfs:domain cim:ExcIEEEST7B;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "kia"@en;
                    rdfs:range cim:PU.
cim:ExcIEEEST7B.kl a owl:DatatypeProperty;
                   rdfs:comment "Low-value gate feedback gain (KL) (>= 0). Typical value = 1."@en;
                   rdfs:domain cim:ExcIEEEST7B;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "kl"@en;
                   rdfs:range cim:PU.
cim:ExcIEEEST7B.kpa a owl:DatatypeProperty;
                    rdfs:comment "Voltage regulator proportional gain (KPA) (> 0). Typical value = 40."@en;
                    rdfs:domain cim:ExcIEEEST7B;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "kpa"@en;
                    rdfs:range cim:PU.
cim:ExcIEEEST7B.oelin a owl:ObjectProperty;
                      rdfs:comment "OEL input selector (OELin). Typical value = noOELinput."@en;
                      rdfs:domain cim:ExcIEEEST7B;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "oelin"@en;
                      rdfs:range cim:ExcST7BOELselectorKind.
cim:ExcIEEEST7B.tb a owl:DatatypeProperty;
                   rdfs:comment "Regulator lag time constant (TB) (>= 0). Typical value = 1."@en;
                   rdfs:domain cim:ExcIEEEST7B;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "tb"@en;
                   rdfs:range cim:Seconds.
cim:ExcIEEEST7B.tc a owl:DatatypeProperty;
                   rdfs:comment "Regulator lead time constant (TC) (>= 0). Typical value = 1."@en;
                   rdfs:domain cim:ExcIEEEST7B;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "tc"@en;
                   rdfs:range cim:Seconds.
cim:ExcIEEEST7B.tf a owl:DatatypeProperty;
                   rdfs:comment "Excitation control system stabilizer time constant (TF) (>= 0). Typical value = 1."@en;
                   rdfs:domain cim:ExcIEEEST7B;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "tf"@en;
                   rdfs:range cim:Seconds.
cim:ExcIEEEST7B.tg a owl:DatatypeProperty;
                   rdfs:comment "Feedback time constant of inner loop field voltage regulator (TG) (>= 0). Typical value = 1."@en;
                   rdfs:domain cim:ExcIEEEST7B;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
