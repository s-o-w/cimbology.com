                   rdfs:domain cim:ExcIEEEST6B;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "kg"@en;
                   rdfs:range cim:PU.
cim:ExcIEEEST6B.kia a owl:DatatypeProperty;
                    rdfs:comment "Voltage regulator integral gain (KIA) (> 0). Typical value = 45,094."@en;
                    rdfs:domain cim:ExcIEEEST6B;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "kia"@en;
                    rdfs:range cim:PU.
cim:ExcIEEEST6B.klr a owl:DatatypeProperty;
                    rdfs:comment "Exciter output current limiter gain (KLR) (> 0). Typical value = 17,33."@en;
                    rdfs:domain cim:ExcIEEEST6B;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "klr"@en;
                    rdfs:range cim:PU.
cim:ExcIEEEST6B.km a owl:DatatypeProperty;
                   rdfs:comment "Forward gain constant of the inner loop field regulator (KM). Typical value = 1."@en;
                   rdfs:domain cim:ExcIEEEST6B;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "km"@en;
                   rdfs:range cim:PU.
cim:ExcIEEEST6B.kpa a owl:DatatypeProperty;
                    rdfs:comment "Voltage regulator proportional gain (KPA) (> 0). Typical value = 18,038."@en;
                    rdfs:domain cim:ExcIEEEST6B;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "kpa"@en;
                    rdfs:range cim:PU.
cim:ExcIEEEST6B.oelin a owl:ObjectProperty;
                      rdfs:comment "OEL input selector (OELin). Typical value = noOELinput."@en;
                      rdfs:domain cim:ExcIEEEST6B;
