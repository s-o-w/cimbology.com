cim:GovCT2.plim7 a owl:DatatypeProperty;
                 rdfs:comment "Power limit 7 (Plim7). Typical value = 0."@en;
                 rdfs:domain cim:GovCT2;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "plim7"@en;
                 rdfs:range cim:PU.
cim:GovCT2.plim8 a owl:DatatypeProperty;
                 rdfs:comment "Power limit 8 (Plim8). Typical value = 0."@en;
                 rdfs:domain cim:GovCT2;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "plim8"@en;
