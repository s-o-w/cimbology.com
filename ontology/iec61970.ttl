          cimdoc:packageTier "Normative".
cim:Pss2B.a a owl:DatatypeProperty;
            rdfs:comment "Numerator constant (a). Typical value = 1."@en;
            rdfs:domain cim:Pss2B;
            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
            rdfs:label "a"@en;
            rdfs:range xsd:float.
cim:Pss2B.ks1 a owl:DatatypeProperty;
              rdfs:comment "Stabilizer gain (Ks1). Typical value = 12."@en;
