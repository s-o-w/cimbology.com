                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "k2"@en;
                rdfs:range cim:PU.
cim:ExcELIN2.k3 a owl:DatatypeProperty;
                rdfs:comment "Gain (K3). Typical value = 0,1."@en;
                rdfs:domain cim:ExcELIN2;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "k3"@en;
