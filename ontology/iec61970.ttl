                 rdfs:comment "Turbine nominal head (H0). Typical value = 1."@en;
                 rdfs:domain cim:GovHydro3;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "h0"@en;
                 rdfs:range cim:PU.
cim:GovHydro3.k1 a owl:DatatypeProperty;
                 rdfs:comment "Derivative gain (K1). Typical value = 0,01."@en;
                 rdfs:domain cim:GovHydro3;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "k1"@en;
                 rdfs:range cim:PU.
cim:GovHydro3.k2 a owl:DatatypeProperty;
                 rdfs:comment "Double derivative gain, if Cflag = -1 (K2). Typical value = 2,5."@en;
                 rdfs:domain cim:GovHydro3;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "k2"@en;
                 rdfs:range cim:PU.
cim:GovHydro3.kg a owl:DatatypeProperty;
                 rdfs:comment "Gate servo gain (Kg). Typical value = 2."@en;
                 rdfs:domain cim:GovHydro3;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "kg"@en;
                 rdfs:range cim:PU.
cim:GovHydro3.ki a owl:DatatypeProperty;
                 rdfs:comment "Integral gain (Ki). Typical value = 0,5."@en;
                 rdfs:domain cim:GovHydro3;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                 rdfs:label "ki"@en;
                 rdfs:range cim:PU.
cim:GovHydro3.mwbase a owl:DatatypeProperty;
                     rdfs:comment "Base for power values (MWbase) (> 0). Unit = MW."@en;
                     rdfs:domain cim:GovHydro3;
