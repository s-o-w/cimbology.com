                     rdfs:comment "Mass in tons, �tonne� or �metric ton� (1000 kg = 1 Mg)."@en;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                     rdfs:label "tonne"@en;
                     cimdoc:enumCode 199 .
cim:VAdjIEEE a owl:Class;
             rdfs:comment "IEEE voltage adjuster which is used to represent the voltage adjuster in either a power factor or VAr control system. Reference: IEEE 421.5-2005, 11.1."@en;
             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
             rdfs:label "VAdjIEEE"@en;
             rdfs:subClassOf cim:VoltageAdjusterDynamics;
             cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.VoltageAdjusterDynamics";
             cimdoc:packageTier "Normative".
cim:VAdjIEEE.adjslew a owl:DatatypeProperty;
                     rdfs:comment "Rate at which output of adjuster changes (ADJ_SLEW). Unit = s / PU. Typical value = 300."@en;
                     rdfs:domain cim:VAdjIEEE;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                     rdfs:label "adjslew"@en;
                     rdfs:range xsd:float.
cim:VAdjIEEE.taoff a owl:DatatypeProperty;
                   rdfs:comment "Time that adjuster pulses are off (TAOFF) (>= 0). Typical value = 0,5."@en;
                   rdfs:domain cim:VAdjIEEE;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "taoff"@en;
                   rdfs:range cim:Seconds.
cim:VAdjIEEE.taon a owl:DatatypeProperty;
                  rdfs:comment "Time that adjuster pulses are on (TAON) (>= 0). Typical value = 0,1."@en;
                  rdfs:domain cim:VAdjIEEE;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "taon"@en;
                  rdfs:range cim:Seconds.
cim:VAdjIEEE.vadjf a owl:DatatypeProperty;
                   rdfs:comment "Set high to provide a continuous raise or lower (VADJF)."@en;
                   rdfs:domain cim:VAdjIEEE;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "vadjf"@en;
                   rdfs:range xsd:float.
cim:VAdjIEEE.vadjmax a owl:DatatypeProperty;
                     rdfs:comment "Maximum output of the adjuster (VADJMAX) (> VAdjIEEE. vadjmin). Typical value = 1,1."@en;
                     rdfs:domain cim:VAdjIEEE;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                     rdfs:label "vadjmax"@en;
                     rdfs:range cim:PU.
cim:VAdjIEEE.vadjmin a owl:DatatypeProperty;
                     rdfs:comment "Minimum output of the adjuster (VADJMIN) (< VAdjIEEE.vadjmax). Typical value = 0,9."@en;
                     rdfs:domain cim:VAdjIEEE;
                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                     rdfs:label "vadjmin"@en;
                     rdfs:range cim:PU.
cim:VDCOL a owl:Class;
          rdfs:comment "The vdcol class"@en;
          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
          rdfs:label "VDCOL"@en;
          cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.InfHVDCDynamics.CSC";
          cimdoc:packageTier "Informative".
cim:VDCOL.m_IdcInverterControl a owl:ObjectProperty;
                               rdfs:comment "The idcinvertercontrol"@en;
                               rdfs:domain cim:VDCOL;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "m_IdcInverterControl"@en;
                               rdfs:range cim:IdcInverterControl.
cim:VSCDynamics a owl:Class;
                rdfs:comment "VSC function block whose behaviour is described by reference to a standard model or by definition of a user-defined model."@en;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "VSCDynamics"@en;
                rdfs:subClassOf cim:HVDCDynamics;
                cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.HVDCDynamics";
                cimdoc:packageTier "Normative".
cim:VSCDynamics.VsConverter a owl:ObjectProperty;
                            rdfs:comment "Voltage source converter to which voltage source converter dynamics model applies."@en;
                            rdfs:domain cim:VSCDynamics;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "VsConverter"@en;
                            rdfs:range cim:VsConverter.
cim:VSCUserDefined a owl:Class;
                   rdfs:comment "Voltage source converter (VSC) function block whose dynamic behaviour is described by a user-defined model."@en;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "VSCUserDefined"@en;
                   rdfs:subClassOf cim:VSCDynamics;
                   cimdoc:cimPackage "IEC61970.Dynamics.UserDefinedModels";
                   cimdoc:packageTier "Normative".
cim:VSCUserDefined.ProprietaryParameterDynamics a owl:ObjectProperty;
                                                rdfs:comment "Parameter of this proprietary user-defined model."@en;
                                                rdfs:domain cim:VSCUserDefined;
                                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                rdfs:label "ProprietaryParameterDynamics"@en;
                                                rdfs:range cim:ProprietaryParameterDynamics.
cim:VSCUserDefined.proprietary a owl:DatatypeProperty;
                               rdfs:comment "Behaviour is based on a proprietary model as opposed to a detailed model. true = user-defined model is proprietary with behaviour mutually understood by sending and receiving applications and parameters passed as general attributes false = user-defined model is explicitly defined in terms of control blocks and their input and output signals."@en;
                               rdfs:domain cim:VSCUserDefined;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "proprietary"@en;
