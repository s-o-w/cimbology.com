cim:GovHydro4ModelKind a owl:Class;
                       rdfs:comment "Possible types of GovHydro4 models."@en;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "GovHydro4ModelKind"@en;
                       owl:equivalentClass [a owl:Class ; 
                                            owl:oneOf (cim:GovHydro4ModelKind.francisPelton
                                                       cim:GovHydro4ModelKind.kaplan
                                                       cim:GovHydro4ModelKind.simple)];
                       cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.TurbineGovernorDynamics";
                       cimdoc:packageTier "Normative".
cim:GovHydro4ModelKind.francisPelton a owl:NamedIndividual,
                                       cim:GovHydro4ModelKind;
                                     rdfs:comment "Francis or Pelton model."@en;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                     rdfs:label "francisPelton"@en;
                                     cimdoc:enumCode 1 .
cim:GovHydro4ModelKind.kaplan a owl:NamedIndividual,
                                cim:GovHydro4ModelKind;
                              rdfs:comment "Kaplan model."@en;
