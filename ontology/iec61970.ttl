cim:ExcDC3A1 a owl:Class;
             rdfs:comment "Modified old IEEE type 3 excitation system."@en;
             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
             rdfs:label "ExcDC3A1"@en;
             rdfs:subClassOf cim:ExcitationSystemDynamics;
