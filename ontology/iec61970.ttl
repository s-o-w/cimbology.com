cim:UnderexcLimIEEE1.vulmax a owl:DatatypeProperty;
                            rdfs:comment "UEL output maximum limit (VULMAX) (> UnderexcLimIEEE1.vulmin). Typical value = 18."@en;
                            rdfs:domain cim:UnderexcLimIEEE1;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "vulmax"@en;
                            rdfs:range cim:PU.
cim:UnderexcLimIEEE1.vulmin a owl:DatatypeProperty;
                            rdfs:comment "UEL output minimum limit (VULMIN) (< UnderexcLimIEEE1.vulmax). Typical value = -18."@en;
                            rdfs:domain cim:UnderexcLimIEEE1;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "vulmin"@en;
