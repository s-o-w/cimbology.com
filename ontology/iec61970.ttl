cim:PFVArType2Common1 a owl:Class;
                      rdfs:comment "Power factor / reactive power regulator. This model represents the power factor or reactive power controller such as the Basler SCP-250. The controller measures power factor or reactive power (PU on generator rated power) and compares it with the operator's set point. [Footnote: Basler SCP-250 is an example of a suitable product available commercially. This information is given for the convenience of users of this document and does not constitute an endorsement by IEC of this product.]"@en;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "PFVArType2Common1"@en;
                      rdfs:subClassOf cim:PFVArControllerType2Dynamics;
                      cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.PFVArControllerType2Dynamics";
                      cimdoc:packageTier "Normative".
cim:PFVArType2Common1.j a owl:DatatypeProperty;
                        rdfs:comment "Selector (J). true = control mode for reactive power false = control mode for power factor."@en;
                        rdfs:domain cim:PFVArType2Common1;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                        rdfs:label "j"@en;
                        rdfs:range xsd:boolean.
cim:PFVArType2Common1.ki a owl:DatatypeProperty;
                         rdfs:comment "Reset gain (Ki)."@en;
                         rdfs:domain cim:PFVArType2Common1;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                         rdfs:label "ki"@en;
                         rdfs:range cim:PU.
cim:PFVArType2Common1.kp a owl:DatatypeProperty;
                         rdfs:comment "Proportional gain (Kp)."@en;
                         rdfs:domain cim:PFVArType2Common1;
                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                         rdfs:label "kp"@en;
                         rdfs:range cim:PU.
cim:PFVArType2Common1.max a owl:DatatypeProperty;
                          rdfs:comment "Output limit (max)."@en;
                          rdfs:domain cim:PFVArType2Common1;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                          rdfs:label "max"@en;
                          rdfs:range cim:PU.
cim:PFVArType2Common1.refValue a owl:DatatypeProperty;
                               rdfs:comment "Reference value of reactive power or power factor (Ref). The reference value is initialised by this model. This initialisation can override the value exchanged by this attribute to represent a plant operator's change of the reference setting."@en;
                               rdfs:domain cim:PFVArType2Common1;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "refValue"@en;
                               rdfs:range cim:PU.
cim:PFVArType2IEEEPFController a owl:Class;
                               rdfs:comment "IEEE PF controller type 2 which is a summing point type controller making up the outside loop of a two-loop system. This controller is implemented as a slow PI type controller. The voltage regulator forms the inner loop and is implemented as a fast controller. Reference: IEEE 421.5-2005, 11.4."@en;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "PFVArType2IEEEPFController"@en;
                               rdfs:subClassOf cim:PFVArControllerType2Dynamics;
                               cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.PFVArControllerType2Dynamics";
                               cimdoc:packageTier "Normative".
cim:PFVArType2IEEEPFController.exlon a owl:DatatypeProperty;
                                     rdfs:comment "Overexcitation or under excitation flag (EXLON) true = 1 (not in the overexcitation or underexcitation state, integral action is active) false = 0 (in the overexcitation or underexcitation state, so integral action is disabled to allow the limiter to play its role)."@en;
                                     rdfs:domain cim:PFVArType2IEEEPFController;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                     rdfs:label "exlon"@en;
                                     rdfs:range xsd:boolean.
cim:PFVArType2IEEEPFController.ki a owl:DatatypeProperty;
                                  rdfs:comment "Integral gain of the pf controller (KI). Typical value = 1."@en;
                                  rdfs:domain cim:PFVArType2IEEEPFController;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "ki"@en;
                                  rdfs:range cim:PU.
cim:PFVArType2IEEEPFController.kp a owl:DatatypeProperty;
                                  rdfs:comment "Proportional gain of the pf controller (KP). Typical value = 1."@en;
                                  rdfs:domain cim:PFVArType2IEEEPFController;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "kp"@en;
                                  rdfs:range cim:PU.
cim:PFVArType2IEEEPFController.pfref a owl:DatatypeProperty;
                                     rdfs:comment "Power factor reference (PFREF)."@en;
                                     rdfs:domain cim:PFVArType2IEEEPFController;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                     rdfs:label "pfref"@en;
                                     rdfs:range cim:PU.
cim:PFVArType2IEEEPFController.vclmt a owl:DatatypeProperty;
                                     rdfs:comment "Maximum output of the pf controller (VCLMT). Typical value = 0,1."@en;
                                     rdfs:domain cim:PFVArType2IEEEPFController;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                     rdfs:label "vclmt"@en;
                                     rdfs:range cim:PU.
cim:PFVArType2IEEEPFController.vref a owl:DatatypeProperty;
                                    rdfs:comment "Voltage regulator reference (VREF)."@en;
                                    rdfs:domain cim:PFVArType2IEEEPFController;
                                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                    rdfs:label "vref"@en;
                                    rdfs:range cim:PU.
cim:PFVArType2IEEEPFController.vs a owl:DatatypeProperty;
                                  rdfs:comment "Generator sensing voltage (VS)."@en;
                                  rdfs:domain cim:PFVArType2IEEEPFController;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "vs"@en;
                                  rdfs:range xsd:float.
cim:PFVArType2IEEEVArController a owl:Class;
                                rdfs:comment "IEEE VAR controller type 2 which is a summing point type controller. It makes up the outside loop of a two-loop system. This controller is implemented as a slow PI type controller, and the voltage regulator forms the inner loop and is implemented as a fast controller. Reference: IEEE 421.5-2005, 11.5."@en;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "PFVArType2IEEEVArController"@en;
                                rdfs:subClassOf cim:PFVArControllerType2Dynamics;
                                cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.PFVArControllerType2Dynamics";
                                cimdoc:packageTier "Normative".
cim:PFVArType2IEEEVArController.exlon a owl:DatatypeProperty;
                                      rdfs:comment "Overexcitation or under excitation flag (EXLON) true = 1 (not in the overexcitation or underexcitation state, integral action is active) false = 0 (in the overexcitation or underexcitation state, so integral action is disabled to allow the limiter to play its role)."@en;
                                      rdfs:domain cim:PFVArType2IEEEVArController;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                      rdfs:label "exlon"@en;
                                      rdfs:range xsd:boolean.
cim:PFVArType2IEEEVArController.ki a owl:DatatypeProperty;
                                   rdfs:comment "Integral gain of the pf controller (KI)."@en;
                                   rdfs:domain cim:PFVArType2IEEEVArController;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                   rdfs:label "ki"@en;
                                   rdfs:range cim:PU.
cim:PFVArType2IEEEVArController.kp a owl:DatatypeProperty;
                                   rdfs:comment "Proportional gain of the pf controller (KP)."@en;
                                   rdfs:domain cim:PFVArType2IEEEVArController;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                   rdfs:label "kp"@en;
                                   rdfs:range cim:PU.
cim:PFVArType2IEEEVArController.qref a owl:DatatypeProperty;
                                     rdfs:comment "Reactive power reference (QREF)."@en;
                                     rdfs:domain cim:PFVArType2IEEEVArController;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                     rdfs:label "qref"@en;
                                     rdfs:range cim:PU.
cim:PFVArType2IEEEVArController.vclmt a owl:DatatypeProperty;
                                      rdfs:comment "Maximum output of the pf controller (VCLMT)."@en;
                                      rdfs:domain cim:PFVArType2IEEEVArController;
                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                      rdfs:label "vclmt"@en;
                                      rdfs:range cim:PU.
cim:PFVArType2IEEEVArController.vref a owl:DatatypeProperty;
                                     rdfs:comment "Voltage regulator reference (VREF)."@en;
                                     rdfs:domain cim:PFVArType2IEEEVArController;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                     rdfs:label "vref"@en;
                                     rdfs:range cim:PU.
cim:PFVArType2IEEEVArController.vs a owl:DatatypeProperty;
                                   rdfs:comment "Generator sensing voltage (VS)."@en;
                                   rdfs:domain cim:PFVArType2IEEEVArController;
                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                   rdfs:label "vs"@en;
                                   rdfs:range xsd:float.
