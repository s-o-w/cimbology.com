                                        rdfs:label "surgeTankCrestLevel"@en;
                                        rdfs:range cim:WaterLevel.
cim:HydroPump a owl:Class;
              rdfs:comment "A synchronous motor-driven pump, typically associated with a pumped storage plant."@en;
