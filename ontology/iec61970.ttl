cim:IncrementalHeatRateCurve.isNetGrossP a owl:DatatypeProperty;
                                         rdfs:comment "Flag is set to true when output is expressed in net active power."@en;
                                         rdfs:domain cim:IncrementalHeatRateCurve;
                                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                         rdfs:label "isNetGrossP"@en;
                                         rdfs:range xsd:boolean.
cim:Inductance a rdfs:Datatype;
               rdfs:comment "Inductive part of reactance (imaginary part of impedance), at rated frequency."@en;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "Inductance"@en;
               owl:equivalentClass xsd:float;
               cimdoc:cimPackage "IEC61970.Base.Domain";
               cimdoc:packageTier "Normative";
               cimdoc:unitSymbol cim:UnitSymbol.H.
cim:InductancePerLength a rdfs:Datatype;
                        rdfs:comment "Inductance per unit of length."@en;
                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                        rdfs:label "InductancePerLength"@en;
                        owl:equivalentClass xsd:float;
                        cimdoc:cimPackage "IEC61970.Base.Domain";
                        cimdoc:packageTier "Normative";
                        cimdoc:unitMultiplier cim:UnitMultiplier.none;
                        cimdoc:unitSymbol cim:UnitSymbol.HPerm.
cim:InflowForecast a owl:Class;
                   rdfs:comment "Natural water inflow to a reservoir, usually forecasted from predicted rain and snowmelt. Typically in one hour increments for up to 10 days. The forecast is given in average cubic meters per second over the time increment."@en;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "InflowForecast"@en;
                   rdfs:subClassOf cim:RegularIntervalSchedule;
                   cimdoc:cimPackage "IEC61970.Base.Generation.Production";
                   cimdoc:packageTier "Normative".
cim:InputSignalKind a owl:Class;
                    rdfs:comment "Types of input signals. In dynamics modelling, commonly represented by the j parameter."@en;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "InputSignalKind"@en;
                    owl:equivalentClass [a owl:Class ; 
                                         owl:oneOf (cim:InputSignalKind.branchCurrent
                                                    cim:InputSignalKind.busFrequency
                                                    cim:InputSignalKind.busFrequencyDeviation
                                                    cim:InputSignalKind.busVoltage
                                                    cim:InputSignalKind.busVoltageDerivative
                                                    cim:InputSignalKind.fieldCurrent
                                                    cim:InputSignalKind.generatorAcceleratingPower
                                                    cim:InputSignalKind.generatorElectricalPower
                                                    cim:InputSignalKind.generatorMechanicalPower
                                                    cim:InputSignalKind.rotorAngularFrequencyDeviation
                                                    cim:InputSignalKind.rotorSpeed)];
                    cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.PowerSystemStabilizerDynamics";
                    cimdoc:packageTier "Normative".
cim:InputSignalKind.branchCurrent a owl:NamedIndividual,
                                    cim:InputSignalKind;
                                  rdfs:comment "Input signal is amplitude of remote branch current."@en;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "branchCurrent"@en;
                                  cimdoc:enumCode 8 .
cim:InputSignalKind.busFrequency a owl:NamedIndividual,
                                   cim:InputSignalKind;
                                 rdfs:comment "Input signal is bus voltage frequency. This could be a terminal frequency or remote frequency."@en;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "busFrequency"@en;
                                 cimdoc:enumCode 2 .
cim:InputSignalKind.busFrequencyDeviation a owl:NamedIndividual,
                                            cim:InputSignalKind;
                                          rdfs:comment "Input signal is deviation of bus voltage frequency. This could be a terminal frequency deviation or remote frequency deviation."@en;
                                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                          rdfs:label "busFrequencyDeviation"@en;
                                          cimdoc:enumCode 3 .
cim:InputSignalKind.busVoltage a owl:NamedIndividual,
                                 cim:InputSignalKind;
                               rdfs:comment "Input signal is bus voltage. This could be a terminal voltage or remote voltage."@en;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "busVoltage"@en;
                               cimdoc:enumCode 6 .
cim:InputSignalKind.busVoltageDerivative a owl:NamedIndividual,
                                           cim:InputSignalKind;
                                         rdfs:comment "Input signal is derivative of bus voltage. This could be a terminal voltage derivative or remote voltage derivative."@en;
                                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                         rdfs:label "busVoltageDerivative"@en;
                                         cimdoc:enumCode 7 .
cim:InputSignalKind.fieldCurrent a owl:NamedIndividual,
                                   cim:InputSignalKind;
                                 rdfs:comment "Input signal is generator field current."@en;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "fieldCurrent"@en;
                                 cimdoc:enumCode 9 .
cim:InputSignalKind.generatorAcceleratingPower a owl:NamedIndividual,
                                                 cim:InputSignalKind;
                                               rdfs:comment "Input signal is generator accelerating power."@en;
                                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                               rdfs:label "generatorAcceleratingPower"@en;
                                               cimdoc:enumCode 5 .
cim:InputSignalKind.generatorElectricalPower a owl:NamedIndividual,
                                               cim:InputSignalKind;
                                             rdfs:comment "Input signal is generator electrical power on rated S."@en;
                                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                             rdfs:label "generatorElectricalPower"@en;
                                             cimdoc:enumCode 4 .
cim:InputSignalKind.generatorMechanicalPower a owl:NamedIndividual,
                                               cim:InputSignalKind;
                                             rdfs:comment "Input signal is generator mechanical power."@en;
                                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                             rdfs:label "generatorMechanicalPower"@en;
                                             cimdoc:enumCode 10 .
cim:InputSignalKind.rotorAngularFrequencyDeviation a owl:NamedIndividual,
                                                     cim:InputSignalKind;
                                                   rdfs:comment "Input signal is rotor or shaft angular frequency deviation."@en;
                                                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                   rdfs:label "rotorAngularFrequencyDeviation"@en;
                                                   cimdoc:enumCode 1 .
cim:InputSignalKind.rotorSpeed a owl:NamedIndividual,
                                 cim:InputSignalKind;
                               rdfs:comment "Input signal is rotor or shaft speed (angular frequency)."@en;
                               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                               rdfs:label "rotorSpeed"@en;
                               cimdoc:enumCode 0 .
cim:InstanceSet a owl:Class;
                rdfs:comment "Represents an instance set, a version of a model part corresponding to a payload of instance data."@en;
                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "InstanceSet"@en;
                rdfs:subClassOf cim:DataSet;
                cimdoc:cimPackage "IEC61970.InfIEC61970.Part303.GenericDataSet";
                cimdoc:packageTier "Informative".
cim:Integer a rdfs:Datatype;
            rdfs:comment "An integer number. The range is unspecified and not limited."@en;
            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
            rdfs:label "Integer"@en;
            owl:equivalentClass xsd:integer;
            cimdoc:cimPackage "IEC61970.Base.Domain";
            cimdoc:packageTier "Normative".
cim:IntegerQuantity a rdfs:Datatype;
                    rdfs:comment "Quantity with integer value and associated unit information."@en;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "IntegerQuantity"@en;
                    owl:equivalentClass xsd:integer;
                    cimdoc:cimPackage "IEC61970.Base.Domain";
                    cimdoc:packageTier "Normative".
cim:IrregularIntervalSchedule a owl:Class;
                              rdfs:comment "The schedule has time points where the time between them varies."@en;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "IrregularIntervalSchedule"@en;
                              rdfs:subClassOf cim:BasicIntervalSchedule;
                              cimdoc:cimPackage "IEC61970.Base.Core";
                              cimdoc:packageTier "Normative".
cim:IrregularIntervalSchedule.TimePoints a owl:ObjectProperty;
                                         rdfs:comment "The point data values that define a curve."@en;
                                         rdfs:domain cim:IrregularIntervalSchedule;
                                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                         rdfs:label "TimePoints"@en;
                                         rdfs:range cim:IrregularTimePoint.
cim:IrregularTimePoint a owl:Class;
                       rdfs:comment "TimePoints for a schedule where the time between the points varies."@en;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "IrregularTimePoint"@en;
                       cimdoc:cimPackage "IEC61970.Base.Core";
                       cimdoc:packageTier "Normative".
cim:IrregularTimePoint.time a owl:DatatypeProperty;
                            rdfs:comment "The time is relative to the schedule starting time."@en;
                            rdfs:domain cim:IrregularTimePoint;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "time"@en;
                            rdfs:range cim:Seconds.
cim:IrregularTimePoint.value1 a owl:DatatypeProperty;
                              rdfs:comment "The first value at the time. The meaning of the value is defined by the derived type of the associated schedule."@en;
                              rdfs:domain cim:IrregularTimePoint;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "value1"@en;
                              rdfs:range xsd:float.
cim:IrregularTimePoint.value2 a owl:DatatypeProperty;
                              rdfs:comment "The second value at the time. The meaning of the value is defined by the derived type of the associated schedule."@en;
                              rdfs:domain cim:IrregularTimePoint;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "value2"@en;
                              rdfs:range xsd:float.
cim:Jumper a owl:Class;
           rdfs:comment "A short section of conductor with negligible impedance which can be manually removed and replaced if the circuit is de-energized. Note that zero-impedance branches can potentially be modelled by other equipment types."@en;
           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
           rdfs:label "Jumper"@en;
           rdfs:subClassOf cim:Switch;
           cimdoc:cimPackage "IEC61970.Base.Wires";
           cimdoc:packageTier "Normative".
cim:JumperAction a owl:Class;
                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61968.ttl>.
cim:Junction a owl:Class;
             rdfs:comment "A point where one or more conducting equipments are connected with zero resistance."@en;
             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
             rdfs:label "Junction"@en;
             rdfs:subClassOf cim:Connector;
             cimdoc:cimPackage "IEC61970.Base.Wires";
             cimdoc:packageTier "Normative".
cim:KiloActivePower a rdfs:Datatype;
                    rdfs:comment "Active power in kilowatts."@en;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "KiloActivePower"@en;
                    owl:equivalentClass xsd:float;
                    cimdoc:cimPackage "IEC61970.Base.Domain";
                    cimdoc:packageTier "Normative";
                    cimdoc:unitMultiplier cim:UnitMultiplier.k;
                    cimdoc:unitSymbol cim:UnitSymbol.W.
cim:Length a rdfs:Datatype;
           rdfs:comment "Unit of length. It shall be a positive value or zero."@en;
           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
           rdfs:label "Length"@en;
           owl:equivalentClass xsd:float;
           cimdoc:cimPackage "IEC61970.Base.Domain";
           cimdoc:packageTier "Normative";
           cimdoc:unitSymbol cim:UnitSymbol.m.
cim:LevelVsVolumeCurve a owl:Class;
                       rdfs:comment "Relationship between reservoir volume and reservoir level. The volume is at the Y-axis and the reservoir level at the X-axis."@en;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "LevelVsVolumeCurve"@en;
                       rdfs:subClassOf cim:Curve;
                       cimdoc:cimPackage "IEC61970.Base.Generation.Production";
                       cimdoc:packageTier "Normative".
cim:Limit a owl:Class;
          rdfs:comment "Specifies one limit value for a Measurement. A Measurement typically has several limits that are kept together by the LimitSet class. The actual meaning and use of a Limit instance (i.e., if it is an alarm or warning limit or if it is a high or low limit) is not captured in the Limit class. However the name of a Limit instance may indicate both meaning and use."@en;
          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
          rdfs:label "Limit"@en;
          rdfs:subClassOf cim:IdentifiedObject;
          cimdoc:cimPackage "IEC61970.Base.Meas";
          cimdoc:packageTier "Normative".
cim:LimitDependency a owl:Class;
                    rdfs:comment "A limit calculation model used to compute an operational limit based on external input such as temperature. These are intended to be shared among operational limits with the same calculation form that apply to a piece of equipment."@en;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "LimitDependency"@en;
                    rdfs:subClassOf cim:IdentifiedObject;
                    cimdoc:cimPackage "IEC61970.InfIEC61970.InfOperationalLimits";
                    cimdoc:packageTier "Informative".
cim:LimitScalingLimit a owl:Class;
                      rdfs:comment "Specifies an operational limit that is calculated by scaling another operational limit."@en;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "LimitScalingLimit"@en;
                      rdfs:subClassOf cim:LimitDependency;
                      cimdoc:cimPackage "IEC61970.InfIEC61970.InfOperationalLimits";
                      cimdoc:packageTier "Informative".
cim:LimitScalingLimit.SourceOperationalLimit a owl:ObjectProperty;
                                             rdfs:comment "The source operational limit used for scaling."@en;
                                             rdfs:domain cim:LimitScalingLimit;
                                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                             rdfs:label "SourceOperationalLimit"@en;
                                             rdfs:range cim:OperationalLimit.
cim:LimitScalingLimit.limitScalingPercent a owl:DatatypeProperty;
                                          rdfs:comment "The associated source limit is scaled by this value to compute the limit of the dependency model."@en;
                                          rdfs:domain cim:LimitScalingLimit;
                                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                          rdfs:label "limitScalingPercent"@en;
                                          rdfs:range cim:PerCent.
cim:LimitSet a owl:Class;
             rdfs:comment "Specifies a set of Limits that are associated with a Measurement. A Measurement may have several LimitSets corresponding to seasonal or other changing conditions. The condition is captured in the name and description attributes. The same LimitSet may be used for several Measurements. In particular percentage limits are used this way."@en;
             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
             rdfs:label "LimitSet"@en;
             rdfs:subClassOf cim:IdentifiedObject;
             cimdoc:cimPackage "IEC61970.Base.Meas";
             cimdoc:packageTier "Normative".
cim:LimitSet.isPercentageLimits a owl:DatatypeProperty;
                                rdfs:comment "Tells if the limit values are in percentage of normalValue or the specified Unit for Measurements and Controls."@en;
                                rdfs:domain cim:LimitSet;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "isPercentageLimits"@en;
                                rdfs:range xsd:boolean.
cim:Line a owl:Class;
         rdfs:comment "Contains equipment beyond a substation belonging to a power transmission line."@en;
         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
         rdfs:label "Line"@en;
         rdfs:subClassOf cim:EquipmentContainer;
         cimdoc:cimPackage "IEC61970.Base.Wires";
         cimdoc:packageTier "Normative".
cim:LineFault a owl:Class;
              rdfs:comment "A fault that occurs on an AC line segment at some point along the length."@en;
              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
              rdfs:label "LineFault"@en;
              rdfs:subClassOf cim:Fault;
              cimdoc:cimPackage "IEC61970.Base.Faults";
              cimdoc:packageTier "Normative".
cim:LineFault.ACLineSegment a owl:ObjectProperty;
                            rdfs:comment "The line segment of this line fault."@en;
                            rdfs:domain cim:LineFault;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                            rdfs:label "ACLineSegment"@en;
                            rdfs:range cim:ACLineSegment.
cim:LineFault.lengthFromTerminal1 a owl:DatatypeProperty;
                                  rdfs:comment "The length to the place where the fault is located starting from terminal with sequence number 1 of the faulted line segment."@en;
                                  rdfs:domain cim:LineFault;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "lengthFromTerminal1"@en;
                                  rdfs:range cim:Length.
cim:LinearShuntCompensator a owl:Class;
                           rdfs:comment "A linear shunt compensator has banks or sections with equal admittance values."@en;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "LinearShuntCompensator"@en;
                           rdfs:subClassOf cim:ShuntCompensator;
                           cimdoc:cimPackage "IEC61970.Base.Wires";
                           cimdoc:packageTier "Normative".
cim:LinearShuntCompensator.b0PerSection a owl:DatatypeProperty;
                                        rdfs:comment "Zero sequence shunt (charging) susceptance per section."@en;
                                        rdfs:domain cim:LinearShuntCompensator;
                                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                        rdfs:label "b0PerSection"@en;
                                        rdfs:range cim:Susceptance.
cim:LinearShuntCompensator.bPerSection a owl:DatatypeProperty;
                                       rdfs:comment "Positive sequence shunt (charging) susceptance per section."@en;
                                       rdfs:domain cim:LinearShuntCompensator;
                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                       rdfs:label "bPerSection"@en;
                                       rdfs:range cim:Susceptance.
cim:LinearShuntCompensator.g0PerSection a owl:DatatypeProperty;
                                        rdfs:comment "Zero sequence shunt (charging) conductance per section."@en;
                                        rdfs:domain cim:LinearShuntCompensator;
                                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                        rdfs:label "g0PerSection"@en;
                                        rdfs:range cim:Conductance.
cim:LinearShuntCompensator.gPerSection a owl:DatatypeProperty;
                                       rdfs:comment "Positive sequence shunt (charging) conductance per section."@en;
                                       rdfs:domain cim:LinearShuntCompensator;
                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                       rdfs:label "gPerSection"@en;
                                       rdfs:range cim:Conductance.
cim:LinearShuntCompensatorPhase a owl:Class;
                                rdfs:comment "A per phase linear shunt compensator has banks or sections with equal admittance values."@en;
                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                rdfs:label "LinearShuntCompensatorPhase"@en;
                                rdfs:subClassOf cim:ShuntCompensatorPhase;
                                cimdoc:cimPackage "IEC61970.Base.Wires";
                                cimdoc:packageTier "Normative".
cim:LinearShuntCompensatorPhase.bPerSection a owl:DatatypeProperty;
                                            rdfs:comment "Susceptance per section of the phase if shunt compensator is wye connected. Susceptance per section phase to phase if shunt compensator is delta connected."@en;
                                            rdfs:domain cim:LinearShuntCompensatorPhase;
                                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                            rdfs:label "bPerSection"@en;
                                            rdfs:range cim:Susceptance.
cim:LinearShuntCompensatorPhase.gPerSection a owl:DatatypeProperty;
                                            rdfs:comment "Conductance per section for this phase if shunt compensator is wye connected. Conductance per section phase to phase if shunt compensator is delta connected."@en;
                                            rdfs:domain cim:LinearShuntCompensatorPhase;
                                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                            rdfs:label "gPerSection"@en;
                                            rdfs:range cim:Conductance.
cim:LoadAggregate a owl:Class;
                  rdfs:comment "Aggregate loads are used to represent all or part of the real and reactive load from one or more loads in the static (power flow) data. This load is usually the aggregation of many individual load devices and the load model is an approximate representation of the aggregate response of the load devices to system disturbances. Standard aggregate load model comprised of static and/or dynamic components. A static load model represents the sensitivity of the real and reactive power consumed by the load to the amplitude and frequency of the bus voltage. A dynamic load model can be used to represent the aggregate response of the motor components of the load."@en;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "LoadAggregate"@en;
                  rdfs:subClassOf cim:LoadDynamics;
                  cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.LoadDynamics";
                  cimdoc:packageTier "Normative".
cim:LoadArea a owl:Class;
             rdfs:comment "The class is the root or first level in a hierarchical structure for grouping of loads for the purpose of load flow load scaling."@en;
             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
             rdfs:label "LoadArea"@en;
             rdfs:subClassOf cim:EnergyArea;
             cimdoc:cimPackage "IEC61970.Base.LoadModel";
             cimdoc:packageTier "Normative".
cim:LoadArea.SubLoadAreas a owl:ObjectProperty;
                          rdfs:comment "The SubLoadAreas in the LoadArea."@en;
                          rdfs:domain cim:LoadArea;
                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                          rdfs:label "SubLoadAreas"@en;
                          rdfs:range cim:SubLoadArea.
cim:LoadBreakSwitch a owl:Class;
                    rdfs:comment "A mechanical switching device capable of making, carrying, and breaking currents under normal operating conditions."@en;
                    rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                    rdfs:label "LoadBreakSwitch"@en;
                    rdfs:subClassOf cim:ProtectedSwitch;
                    cimdoc:cimPackage "IEC61970.Base.Wires";
                    cimdoc:packageTier "Normative".
cim:LoadComposite a owl:Class;
                  rdfs:comment "Combined static load and induction motor load effects. The dynamics of the motor are simplified by linearizing the induction machine equations."@en;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "LoadComposite"@en;
                  rdfs:subClassOf cim:LoadDynamics;
                  cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.LoadDynamics";
                  cimdoc:packageTier "Normative".
cim:LoadComposite.epfd a owl:DatatypeProperty;
                       rdfs:comment "Active load-frequency dependence index (dynamic) (Epfd). Typical value = 1,5."@en;
                       rdfs:domain cim:LoadComposite;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "epfd"@en;
                       rdfs:range xsd:float.
cim:LoadComposite.epfs a owl:DatatypeProperty;
                       rdfs:comment "Active load-frequency dependence index (static) (Epfs). Typical value = 1,5."@en;
                       rdfs:domain cim:LoadComposite;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "epfs"@en;
                       rdfs:range xsd:float.
cim:LoadComposite.epvd a owl:DatatypeProperty;
                       rdfs:comment "Active load-voltage dependence index (dynamic) (Epvd). Typical value = 0,7."@en;
                       rdfs:domain cim:LoadComposite;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "epvd"@en;
                       rdfs:range xsd:float.
cim:LoadComposite.epvs a owl:DatatypeProperty;
                       rdfs:comment "Active load-voltage dependence index (static) (Epvs). Typical value = 0, 7."@en;
                       rdfs:domain cim:LoadComposite;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "epvs"@en;
                       rdfs:range xsd:float.
cim:LoadComposite.eqfd a owl:DatatypeProperty;
                       rdfs:comment "Reactive load-frequency dependence index (dynamic) (Eqfd). Typical value = 0."@en;
                       rdfs:domain cim:LoadComposite;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "eqfd"@en;
