cim:IncrementalHeatRateCurve a owl:Class;
                             rdfs:comment """Relationship between unit incremental heat rate in (delta energy/time) per (delta active power) and unit output in active power. The IHR curve represents the slope of the HeatInputCurve. Note that the \"incremental heat rate\" and the \"heat rate\" have the same engineering units."""@en;
                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
