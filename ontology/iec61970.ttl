                                         rdfs:domain cim:HydroPowerPlant;
                                         rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                         rdfs:label "dischargeTravelDelay"@en;
                                         rdfs:range cim:Seconds.
cim:HydroPowerPlant.genRatedP a owl:DatatypeProperty;
                              rdfs:comment "The hydro plant's generating rating active power for rated head conditions. The attribute shall be a positive value."@en;
                              rdfs:domain cim:HydroPowerPlant;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "genRatedP"@en;
                              rdfs:range cim:ActivePower.
cim:HydroPowerPlant.hydroPlantStorageType a owl:ObjectProperty;
