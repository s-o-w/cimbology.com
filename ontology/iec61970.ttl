cim:UnderexcLim2Simplified.p0 a owl:DatatypeProperty;
                              rdfs:comment "Segment P initial point (P0). Typical value = 0."@en;
                              rdfs:domain cim:UnderexcLim2Simplified;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "p0"@en;
                              rdfs:range cim:PU.
cim:UnderexcLim2Simplified.p1 a owl:DatatypeProperty;
                              rdfs:comment "Segment P end point (P1). Typical value = 1."@en;
                              rdfs:domain cim:UnderexcLim2Simplified;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "p1"@en;
                              rdfs:range cim:PU.
cim:UnderexcLim2Simplified.q0 a owl:DatatypeProperty;
                              rdfs:comment "Segment Q initial point (Q0). Typical value = -0,31."@en;
                              rdfs:domain cim:UnderexcLim2Simplified;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "q0"@en;
