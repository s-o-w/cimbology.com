cim:GovHydro3.gv6 a owl:DatatypeProperty;
                  rdfs:comment "Nonlinear gain point 6, PU gv (Gv6). Typical value = 0."@en;
                  rdfs:domain cim:GovHydro3;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "gv6"@en;
                  rdfs:range cim:PU.
