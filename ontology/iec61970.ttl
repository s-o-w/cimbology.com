                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                rdfs:label "e"@en;
                rdfs:range xsd:float.
cim:MechanicalLoadDynamics a owl:Class;
                           rdfs:comment "Mechanical load function block whose behaviour is described by reference to a standard model or by definition of a user-defined model."@en;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "MechanicalLoadDynamics"@en;
                           rdfs:subClassOf cim:DynamicsFunctionBlock;
                           cimdoc:cimPackage "IEC61970.Dynamics.StandardModels.MechanicalLoadDynamics";
                           cimdoc:packageTier "Normative".
cim:MechanicalLoadDynamics.AsynchronousMachineDynamics a owl:ObjectProperty;
                                                       rdfs:comment "Asynchronous machine model with which this mechanical load model is associated. MechanicalLoadDynamics shall have either an association to SynchronousMachineDynamics or to AsynchronousMachineDynamics."@en;
                                                       rdfs:domain cim:MechanicalLoadDynamics;
                                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                       rdfs:label "AsynchronousMachineDynamics"@en;
                                                       rdfs:range cim:AsynchronousMachineDynamics.
cim:MechanicalLoadDynamics.SynchronousMachineDynamics a owl:ObjectProperty;
                                                      rdfs:comment "Synchronous machine model with which this mechanical load model is associated. MechanicalLoadDynamics shall have either an association to SynchronousMachineDynamics or AsynchronousMachineDyanmics."@en;
                                                      rdfs:domain cim:MechanicalLoadDynamics;
                                                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                      rdfs:label "SynchronousMachineDynamics"@en;
                                                      rdfs:range cim:SynchronousMachineDynamics.
cim:MechanicalLoadUserDefined a owl:Class;
                              rdfs:comment "Mechanical load function block whose dynamic behaviour is described by a user-defined model."@en;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "MechanicalLoadUserDefined"@en;
                              rdfs:subClassOf cim:MechanicalLoadDynamics;
                              cimdoc:cimPackage "IEC61970.Dynamics.UserDefinedModels";
                              cimdoc:packageTier "Normative".
cim:MechanicalLoadUserDefined.proprietary a owl:DatatypeProperty;
                                          rdfs:comment "Behaviour is based on a proprietary model as opposed to a detailed model. true = user-defined model is proprietary with behaviour mutually understood by sending and receiving applications and parameters passed as general attributes false = user-defined model is explicitly defined in terms of control blocks and their input and output signals."@en;
                                          rdfs:domain cim:MechanicalLoadUserDefined;
                                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                          rdfs:label "proprietary"@en;
                                          rdfs:range xsd:boolean.
cim:Minutes a rdfs:Datatype;
            rdfs:comment "Time in minutes."@en;
            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
            rdfs:label "Minutes"@en;
            owl:equivalentClass xsd:float;
            cimdoc:cimPackage "IEC61970.Base.Domain";
            cimdoc:packageTier "Normative";
            cimdoc:unitMultiplier cim:UnitMultiplier.none;
            cimdoc:unitSymbol cim:UnitSymbol.min.
cim:ModelAuthority a owl:Class;
                   rdfs:comment "A Modeling Authority is an entity responsible for supplying and maintaining the data defining a specific set of objects in a network model."@en;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "ModelAuthority"@en;
                   rdfs:subClassOf cim:IdentifiedObject;
                   cimdoc:cimPackage "IEC61970.InfIEC61970.InfPart303.NetworkModelFrames";
                   cimdoc:packageTier "Informative".
cim:ModelAuthoritySet a owl:Class;
                      rdfs:comment "A Modeling Authority Set is a group of objects in a network model where the data is supplied and maintained by the same Modeling Authority. This class is typically not included in instance data exchange as this information is tracked by other mechanisms in the exchange."@en;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "ModelAuthoritySet"@en;
                      rdfs:subClassOf cim:IdentifiedObject;
                      cimdoc:cimPackage "IEC61970.InfIEC61970.InfPart303.NetworkModelFrames";
                      cimdoc:packageTier "Informative".
cim:ModelAuthoritySet.ModelingAuthority a owl:ObjectProperty;
                                        rdfs:comment "Modeling Authority suppliying and maintaining the data for the objects in this Modeling Authority Set."@en;
                                        rdfs:domain cim:ModelAuthoritySet;
                                        rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                        rdfs:label "ModelingAuthority"@en;
                                        rdfs:range cim:ModelAuthority.
cim:ModelFrameType a owl:Class;
                   rdfs:comment """Examples would be \"Boundary\" or \"Region\" type of frame."""@en;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "ModelFrameType"@en;
                   rdfs:subClassOf cim:IdentifiedObject;
                   cimdoc:cimPackage "IEC61970.InfIEC61970.InfPart303.NetworkModelFrames.unused";
                   cimdoc:packageTier "Informative".
cim:ModelOperation a owl:Class;
                   rdfs:comment "An operation performed on models."@en;
                   rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                   rdfs:label "ModelOperation"@en;
                   rdfs:subClassOf cim:IdentifiedObject;
                   cimdoc:cimPackage "IEC61970.InfIEC61970.InfPart303.ModelOperations";
                   cimdoc:packageTier "Informative".
cim:ModelOperation.ModelOperationDescription a owl:ObjectProperty;
                                             rdfs:comment "The type of the model operation."@en;
                                             rdfs:domain cim:ModelOperation;
                                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                             rdfs:label "ModelOperationDescription"@en;
                                             rdfs:range cim:ModelOperationDescription.
cim:ModelOperation.sequenceNumber a owl:DatatypeProperty;
                                  rdfs:comment "Sequence number within a operation sequence, lower is first. Normally starts with 1."@en;
                                  rdfs:domain cim:ModelOperation;
                                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                  rdfs:label "sequenceNumber"@en;
                                  rdfs:range xsd:integer.
cim:ModelOperationArg a owl:Class;
                      rdfs:comment "Describes the role a dataset plays in a model operation. The role is applicable only in the context of a single operation."@en;
                      rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                      rdfs:label "ModelOperationArg"@en;
                      rdfs:subClassOf cim:IdentifiedObject;
                      cimdoc:cimPackage "IEC61970.InfIEC61970.InfPart303.ModelOperations";
                      cimdoc:packageTier "Informative".
cim:ModelOperationArg.ModelOperation a owl:ObjectProperty;
                                     rdfs:comment "The operation for the operation argument."@en;
                                     rdfs:domain cim:ModelOperationArg;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                     rdfs:label "ModelOperation"@en;
                                     rdfs:range cim:ModelOperation.
cim:ModelOperationArg.sequenceNumber a owl:DatatypeProperty;
                                     rdfs:comment "The sequence number of the argument in an operation. Argument entries are considered in numerical order where the operation requires an ordering."@en;
                                     rdfs:domain cim:ModelOperationArg;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                     rdfs:label "sequenceNumber"@en;
                                     rdfs:range xsd:integer.
cim:ModelOperationArgDescription a owl:Class;
                                 rdfs:comment "The type of custom operation dataset role for an operation description."@en;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "ModelOperationArgDescription"@en;
                                 rdfs:subClassOf cim:IdentifiedObject;
                                 cimdoc:cimPackage "IEC61970.InfIEC61970.InfPart303.ModelOperations";
                                 cimdoc:packageTier "Informative".
cim:ModelOperationArgDescription.ModelOperationDefinition a owl:ObjectProperty;
                                                          rdfs:comment "The type of operation for this type of dataset role. Operations referencing the dataset role type should only belong to operations that reference the operation type."@en;
                                                          rdfs:domain cim:ModelOperationArgDescription;
                                                          rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                          rdfs:label "ModelOperationDefinition"@en;
                                                          rdfs:range cim:ModelOperationDescription.
cim:ModelOperationArgDescription.multiplicityMaximum a owl:DatatypeProperty;
                                                     rdfs:comment "The maximum multiplicity of the instance arguments that should be supplied for a single operation. Use -1 to indicate unlimited."@en;
                                                     rdfs:domain cim:ModelOperationArgDescription;
                                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                     rdfs:label "multiplicityMaximum"@en;
                                                     rdfs:range xsd:integer.
cim:ModelOperationArgDescription.multiplicityMinimum a owl:DatatypeProperty;
                                                     rdfs:comment "The minimum multiplicity of the instance arguments that should be supplied for a single operation. Use zero to indicate optional."@en;
                                                     rdfs:domain cim:ModelOperationArgDescription;
                                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                     rdfs:label "multiplicityMinimum"@en;
                                                     rdfs:range xsd:integer.
cim:ModelOperationDescription a owl:Class;
                              rdfs:comment "The type of model operation. This class is referenced by model operations and defines the kind of operation."@en;
                              rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                              rdfs:label "ModelOperationDescription"@en;
                              rdfs:subClassOf cim:IdentifiedObject;
                              cimdoc:cimPackage "IEC61970.InfIEC61970.InfPart303.ModelOperations";
                              cimdoc:packageTier "Informative".
cim:ModelOperationSequence a owl:Class;
                           rdfs:comment "A concrete sequence of operations. For example, this may be used to describe a specific audit trail, a script or other specific set of actions on specific datasets."@en;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "ModelOperationSequence"@en;
                           rdfs:subClassOf cim:IdentifiedObject;
                           cimdoc:cimPackage "IEC61970.InfIEC61970.InfPart303.ModelOperations";
