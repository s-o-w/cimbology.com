                                            rdfs:domain cim:SynchronousMachineEquivalentCircuit;
                                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                            rdfs:label "rfd"@en;
                                            rdfs:range cim:PU.
cim:SynchronousMachineEquivalentCircuit.x1d a owl:DatatypeProperty;
                                            rdfs:comment "Direct-axis damper 1 winding leakage reactance."@en;
                                            rdfs:domain cim:SynchronousMachineEquivalentCircuit;
                                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                            rdfs:label "x1d"@en;
                                            rdfs:range cim:PU.
cim:SynchronousMachineEquivalentCircuit.x1q a owl:DatatypeProperty;
                                            rdfs:comment "Quadrature-axis damper 1 winding leakage reactance."@en;
                                            rdfs:domain cim:SynchronousMachineEquivalentCircuit;
                                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                            rdfs:label "x1q"@en;
                                            rdfs:range cim:PU.
cim:SynchronousMachineEquivalentCircuit.x2q a owl:DatatypeProperty;
                                            rdfs:comment "Quadrature-axis damper 2 winding leakage reactance."@en;
                                            rdfs:domain cim:SynchronousMachineEquivalentCircuit;
                                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                            rdfs:label "x2q"@en;
                                            rdfs:range cim:PU.
cim:SynchronousMachineEquivalentCircuit.xad a owl:DatatypeProperty;
                                            rdfs:comment "Direct-axis mutual reactance."@en;
                                            rdfs:domain cim:SynchronousMachineEquivalentCircuit;
                                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                            rdfs:label "xad"@en;
                                            rdfs:range cim:PU.
cim:SynchronousMachineEquivalentCircuit.xaq a owl:DatatypeProperty;
                                            rdfs:comment "Quadrature-axis mutual reactance."@en;
                                            rdfs:domain cim:SynchronousMachineEquivalentCircuit;
                                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                            rdfs:label "xaq"@en;
                                            rdfs:range cim:PU.
cim:SynchronousMachineEquivalentCircuit.xf1d a owl:DatatypeProperty;
                                             rdfs:comment "Differential mutual (�Canay�) reactance."@en;
                                             rdfs:domain cim:SynchronousMachineEquivalentCircuit;
                                             rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                             rdfs:label "xf1d"@en;
                                             rdfs:range cim:PU.
cim:SynchronousMachineEquivalentCircuit.xfd a owl:DatatypeProperty;
                                            rdfs:comment "Field winding leakage reactance."@en;
                                            rdfs:domain cim:SynchronousMachineEquivalentCircuit;
                                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                            rdfs:label "xfd"@en;
                                            rdfs:range cim:PU.
cim:SynchronousMachineKind a owl:Class;
                           rdfs:comment "Synchronous machine type."@en;
                           rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                           rdfs:label "SynchronousMachineKind"@en;
                           owl:equivalentClass [a owl:Class ; 
                                                owl:oneOf (cim:SynchronousMachineKind.condenser
                                                           cim:SynchronousMachineKind.generator
                                                           cim:SynchronousMachineKind.generatorOrCondenser
                                                           cim:SynchronousMachineKind.generatorOrCondenserOrMotor
                                                           cim:SynchronousMachineKind.generatorOrMotor
                                                           cim:SynchronousMachineKind.motor
                                                           cim:SynchronousMachineKind.motorOrCondenser)];
                           cimdoc:cimPackage "IEC61970.Base.Wires";
                           cimdoc:packageTier "Normative".
cim:SynchronousMachineKind.condenser a owl:NamedIndividual,
                                       cim:SynchronousMachineKind;
                                     rdfs:comment "Indicates the synchronous machine can operate as a condenser."@en;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                     rdfs:label "condenser"@en;
                                     cimdoc:enumCode 1 .
cim:SynchronousMachineKind.generator a owl:NamedIndividual,
                                       cim:SynchronousMachineKind;
                                     rdfs:comment "Indicates the synchronous machine can operate as a generator."@en;
                                     rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                     rdfs:label "generator"@en;
                                     cimdoc:enumCode 0 .
cim:SynchronousMachineKind.generatorOrCondenser a owl:NamedIndividual,
                                                  cim:SynchronousMachineKind;
                                                rdfs:comment "Indicates the synchronous machine can operate as a generator or as a condenser."@en;
                                                rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                rdfs:label "generatorOrCondenser"@en;
                                                cimdoc:enumCode 2 .
cim:SynchronousMachineKind.generatorOrCondenserOrMotor a owl:NamedIndividual,
                                                         cim:SynchronousMachineKind;
                                                       rdfs:comment "Indicates the synchronous machine can operate as a generator or as a condenser or as a motor."@en;
                                                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                                       rdfs:label "generatorOrCondenserOrMotor"@en;
                                                       cimdoc:enumCode 6 .
cim:SynchronousMachineKind.generatorOrMotor a owl:NamedIndividual,
                                              cim:SynchronousMachineKind;
                                            rdfs:comment "Indicates the synchronous machine can operate as a generator or as a motor."@en;
                                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                            rdfs:label "generatorOrMotor"@en;
                                            cimdoc:enumCode 4 .
cim:SynchronousMachineKind.motor a owl:NamedIndividual,
                                   cim:SynchronousMachineKind;
                                 rdfs:comment "Indicates the synchronous machine can operate as a motor."@en;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "motor"@en;
