                                  rdfs:label "HydroPumpOpSchedule"@en;
                                  rdfs:range cim:HydroPumpOpSchedule.
cim:HydroPump.pumpDischAtMaxHead a owl:DatatypeProperty;
                                 rdfs:comment "The pumping discharge under maximum head conditions, usually at full gate."@en;
                                 rdfs:domain cim:HydroPump;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "pumpDischAtMaxHead"@en;
                                 rdfs:range cim:VolumeFlowRate.
cim:HydroPump.pumpDischAtMinHead a owl:DatatypeProperty;
                                 rdfs:comment "The pumping discharge under minimum head conditions, usually at full gate."@en;
                                 rdfs:domain cim:HydroPump;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "pumpDischAtMinHead"@en;
                                 rdfs:range cim:VolumeFlowRate.
cim:HydroPump.pumpPowerAtMaxHead a owl:DatatypeProperty;
                                 rdfs:comment "The pumping power under maximum head conditions, usually at full gate."@en;
                                 rdfs:domain cim:HydroPump;
                                 rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                                 rdfs:label "pumpPowerAtMaxHead"@en;
                                 rdfs:range cim:ActivePower.
cim:HydroPump.pumpPowerAtMinHead a owl:DatatypeProperty;
                                 rdfs:comment "The pumping power under minimum head conditions, usually at full gate."@en;
