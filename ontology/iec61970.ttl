cim:UnderexcLimIEEE1.vurmax a owl:DatatypeProperty;
                            rdfs:comment "UEL maximum limit for radius phasor magnitude (VURMAX). Typical value = 5,8."@en;
                            rdfs:domain cim:UnderexcLimIEEE1;
                            rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
