cim:ExcAVR2.tb a owl:DatatypeProperty;
               rdfs:comment "AVR time constant (TB) (>= 0). Typical value = 0."@en;
               rdfs:domain cim:ExcAVR2;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "tb"@en;
               rdfs:range cim:Seconds.
cim:ExcAVR2.te a owl:DatatypeProperty;
               rdfs:comment "Exciter time constant (TE) (>= 0). Typical value = 1."@en;
               rdfs:domain cim:ExcAVR2;
