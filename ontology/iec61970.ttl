                       rdfs:comment "Rotations per second (1/s). See also Hz (1/s)."@en;
                       rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                       rdfs:label "rotPers"@en;
                       cimdoc:enumCode 53 .
cim:UnitSymbol.s a owl:NamedIndividual,
