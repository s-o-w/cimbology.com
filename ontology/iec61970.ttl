cim:ExcDC3A.vrmin a owl:DatatypeProperty;
                  rdfs:comment "Minimum voltage regulator output (Vrmin) (<= 0). Typical value = 0."@en;
                  rdfs:domain cim:ExcDC3A;
                  rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
                  rdfs:label "vrmin"@en;
