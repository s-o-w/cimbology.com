cim:ExcAVR2.ta a owl:DatatypeProperty;
               rdfs:comment "AVR time constant (TA) (>= 0). Typical value = 0,02."@en;
               rdfs:domain cim:ExcAVR2;
               rdfs:isDefinedBy <https://cimbology.com/ontology/iec61970.ttl>;
               rdfs:label "ta"@en;
