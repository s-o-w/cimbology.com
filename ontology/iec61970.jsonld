      {
        "@id": "http://iec.ch/TC57/CIM100#SynchronousMachine"
      }
    ]
  },
  {
    "@id": "http://iec.ch/TC57/CIM100#SynchronousMachineDynamics.TurbineGovernorDynamics",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Turbine-governor model associated with this synchronous machine model. Multiplicity of greater than one is intended to support hydro units that have multiple turbines on one generator.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://iec.ch/TC57/CIM100#SynchronousMachineDynamics"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
