    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Governor mechanism time constant (T1) (\u003E= 0). T1 represents the natural valve positioning time constant of the governor for small disturbances, as seen when rate limiting is not in effect. Typical value = 0,5.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
