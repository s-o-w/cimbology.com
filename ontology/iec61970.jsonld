    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Turbine exhaust temperature time constant (T3) (\u003E= 0). T3 represents delay in the exhaust temperature and load limiting system. Typical value = 3.",
