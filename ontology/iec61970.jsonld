        "@value": "3",
        "@type": "http://www.w3.org/2001/XMLSchema#integer"
      }
    ]
  },
  {
    "@id": "http://iec.ch/TC57/CIM100#PhaseTapChanger",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A transformer phase shifting tap model that controls the phase angle difference across the power transformer and potentially the active power flow through the power transformer. This phase tap model may also impact the voltage magnitude.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://cimbology.com/ontology/iec61970.ttl"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "PhaseTapChanger",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://iec.ch/TC57/CIM100#TapChanger"
      }
    ],
    "https://cimbology.com/ontology/cimdoc#cimPackage": [
      {
        "@value": "IEC61970.Base.Wires"
      }
    ],
    "https://cimbology.com/ontology/cimdoc#packageTier": [
      {
        "@value": "Normative"
      }
    ]
  },
  {
    "@id": "http://iec.ch/TC57/CIM100#PhaseTapChangerAsymmetrical",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Describes the tap model for an asymmetrical phase shifting transformer in which the difference voltage vector adds to the in-phase winding. The out-of-phase winding is the transformer end where the tap changer is located. The angle between the in-phase and out-of-phase windings is named the winding connection angle. The phase shift depends on both the difference voltage magnitude and the winding connection angle.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://cimbology.com/ontology/iec61970.ttl"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "PhaseTapChangerAsymmetrical",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://iec.ch/TC57/CIM100#PhaseTapChangerNonLinear"
      }
    ],
    "https://cimbology.com/ontology/cimdoc#cimPackage": [
      {
        "@value": "IEC61970.Base.Wires"
      }
    ],
    "https://cimbology.com/ontology/cimdoc#packageTier": [
      {
        "@value": "Normative"
      }
    ]
  },
  {
    "@id": "http://iec.ch/TC57/CIM100#PhaseTapChangerAsymmetrical.windingConnectionAngle",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The phase angle between the in-phase winding and the out-of -phase winding used for creating phase shift. The out-of-phase winding produces what is known as the difference voltage. Setting this angle to 90 degrees is not the same as a symmetrical transformer. The attribute can only be multiples of 30 degrees. The allowed range is -150 degrees to 150 degrees excluding 0.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://iec.ch/TC57/CIM100#PhaseTapChangerAsymmetrical"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://cimbology.com/ontology/iec61970.ttl"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "windingConnectionAngle",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://iec.ch/TC57/CIM100#AngleDegrees"
      }
    ]
  },
  {
    "@id": "http://iec.ch/TC57/CIM100#PhaseTapChangerLinear",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Describes a tap changer with a linear relation between the tap step and the phase angle difference across the transformer. This is a mathematical model that is an approximation of a real phase tap changer. The phase angle is computed as stepPhaseShiftIncrement times the tap position. The voltage magnitude of both sides is the same.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://cimbology.com/ontology/iec61970.ttl"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "PhaseTapChangerLinear",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://iec.ch/TC57/CIM100#PhaseTapChanger"
      }
    ],
    "https://cimbology.com/ontology/cimdoc#cimPackage": [
      {
        "@value": "IEC61970.Base.Wires"
      }
    ],
    "https://cimbology.com/ontology/cimdoc#packageTier": [
      {
        "@value": "Normative"
      }
    ]
  },
  {
    "@id": "http://iec.ch/TC57/CIM100#PhaseTapChangerLinear.stepPhaseShiftIncrement",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Phase shift per step position. A positive value indicates a positive angle variation from the Terminal at the PowerTransformerEnd, where the TapChanger is located, into the transformer. The actual phase shift increment might be more accurately computed from the symmetrical or asymmetrical models or a tap step table lookup if those are available.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://iec.ch/TC57/CIM100#PhaseTapChangerLinear"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://cimbology.com/ontology/iec61970.ttl"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "stepPhaseShiftIncrement",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://iec.ch/TC57/CIM100#AngleDegrees"
      }
    ]
  },
  {
    "@id": "http://iec.ch/TC57/CIM100#PhaseTapChangerLinear.xMax",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The reactance depends on the tap position according to a \u0022u\u0022 shaped curve. The maximum reactance (xMax) appears at the low and high tap positions. Depending on the \uFFFDu\uFFFD curve the attribute can be either higher or lower than PowerTransformerEnd.x.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://iec.ch/TC57/CIM100#PhaseTapChangerLinear"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://cimbology.com/ontology/iec61970.ttl"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "xMax",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://iec.ch/TC57/CIM100#Reactance"
      }
    ]
  },
  {
    "@id": "http://iec.ch/TC57/CIM100#PhaseTapChangerLinear.xMin",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The reactance depends on the tap position according to a \u0022u\u0022 shaped curve. The minimum reactance (xMin) appears at the mid tap position. PowerTransformerEnd. x shall be consistent with PhaseTapChangerLinear.xMin and PhaseTapChangerNonLinear.xMin. In case of inconsistency, PowerTransformerEnd.x shall be used.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://iec.ch/TC57/CIM100#PhaseTapChangerLinear"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://cimbology.com/ontology/iec61970.ttl"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "xMin",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://iec.ch/TC57/CIM100#Reactance"
      }
    ]
  },
  {
    "@id": "http://iec.ch/TC57/CIM100#PhaseTapChangerNonLinear",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The non-linear phase tap changer describes the non-linear behaviour of a phase tap changer. This is a base class for the symmetrical and asymmetrical phase tap changer models. The details of these models can be found in IEC 61970-301.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://cimbology.com/ontology/iec61970.ttl"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "PhaseTapChangerNonLinear",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://iec.ch/TC57/CIM100#PhaseTapChanger"
      }
    ],
    "https://cimbology.com/ontology/cimdoc#cimPackage": [
      {
        "@value": "IEC61970.Base.Wires"
      }
    ],
    "https://cimbology.com/ontology/cimdoc#packageTier": [
      {
        "@value": "Normative"
      }
    ]
  },
  {
    "@id": "http://iec.ch/TC57/CIM100#PhaseTapChangerNonLinear.voltageStepIncrement",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The voltage step increment on the out of phase winding (the PowerTransformerEnd where the TapChanger is located) specified in percent of rated voltage of the PowerTransformerEnd. A positive value means a positive voltage variation from the Terminal at the PowerTransformerEnd, where the TapChanger is located, into the transformer. When the increment is negative, the voltage decreases when the tap step increases.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://iec.ch/TC57/CIM100#PhaseTapChangerNonLinear"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://cimbology.com/ontology/iec61970.ttl"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "voltageStepIncrement",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://iec.ch/TC57/CIM100#PerCent"
      }
    ]
  },
  {
    "@id": "http://iec.ch/TC57/CIM100#PhaseTapChangerNonLinear.xMax",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The reactance depends on the tap position according to a \u0022u\u0022 shaped curve. The maximum reactance (xMax) appears at the low and high tap positions. Depending on the \uFFFDu\uFFFD curve the attribute can be either higher or lower than PowerTransformerEnd.x.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://iec.ch/TC57/CIM100#PhaseTapChangerNonLinear"
      }
    ],
