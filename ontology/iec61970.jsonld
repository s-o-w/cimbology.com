  {
    "@id": "http://iec.ch/TC57/CIM100#PhaseTapChangerNonLinear.xMin",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The reactance depend on the tap position according to a \u0022u\u0022 shaped curve. The minimum reactance (xMin) appear at the mid tap position. PowerTransformerEnd. x shall be consistent with PhaseTapChangerLinear.xMin and PhaseTapChangerNonLinear.xMin. In case of inconsistency, PowerTransformerEnd.x shall be used.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
