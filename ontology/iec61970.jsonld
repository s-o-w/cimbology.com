      {
        "@value": "Specifies the version of the Bilateral Table configuration that is being exchanged.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://iec.ch/TC57/CIM100#TASE2BilateralTable"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://cimbology.com/ontology/iec61970.ttl"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "bilateralTableID",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "http://iec.ch/TC57/CIM100#TASE2BilateralTable.bilateralTableVersion",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The Version attribute identifies a unique version of the Bilateral Table. If any changes are made to a Bilateral Table, then a new unique value for this attribute shall be generated.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://iec.ch/TC57/CIM100#TASE2BilateralTable"
      }
    ],
