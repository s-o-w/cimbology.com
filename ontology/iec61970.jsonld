    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Measurement value is blocked and hence unavailable for transmission.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://iec.ch/TC57/CIM100#Quality61850"
