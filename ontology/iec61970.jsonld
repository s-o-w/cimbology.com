    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The position of the regular time point in the sequence. Note that time points don\u0027t have to be sequential, i.e. time points may be omitted. The actual time for a RegularTimePoint is computed by multiplying the associated regular interval schedule\u0027s time step with the regular time point sequence number and adding the associated schedules start time. To specify values for the start time, use sequence number 0. The sequence number cannot be negative.",
        "@language": "en"
      }
    ],
