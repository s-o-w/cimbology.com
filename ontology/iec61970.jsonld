  {
    "@id": "http://iec.ch/TC57/CIM100#Validity.GOOD",
    "@type": [
      "http://iec.ch/TC57/CIM100#Validity",
      "http://www.w3.org/2002/07/owl#NamedIndividual"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The value is marked good if no abnormal condition of the acquisition function or the information source is detected.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
