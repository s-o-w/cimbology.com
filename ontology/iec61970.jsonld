    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Governor Speed Changer Droop. This is the change in generator power output divided by the change in frequency normalized by the nominal power of the generator and the nominal frequency and expressed in percent and negated. A positive value of speed change droop provides additional generator output upon a drop in frequency.",
        "@language": "en"
      }
    ],
