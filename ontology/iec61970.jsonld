  {
    "@id": "http://iec.ch/TC57/CIM100#Duration",
    "@type": [
      "http://www.w3.org/2000/01/rdf-schema#Datatype"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Duration as \u0022PnYnMnDTnHnMnS\u0022 which conforms to ISO 8601, where nY expresses a number of years, nM a number of months, nD a number of days. The letter T separates the date expression from the time expression and, after it, nH identifies a number of hours, nM a number of minutes and nS a number of seconds. The number of seconds could be expressed as a decimal number, but all other numbers are integers.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://cimbology.com/ontology/iec61970.ttl"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Duration",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2002/07/owl#equivalentClass": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#duration"
      }
    ],
    "https://cimbology.com/ontology/cimdoc#cimPackage": [
      {
        "@value": "IEC61970.Base.Domain"
      }
    ],
    "https://cimbology.com/ontology/cimdoc#packageTier": [
      {
        "@value": "Normative"
      }
    ]
  },
