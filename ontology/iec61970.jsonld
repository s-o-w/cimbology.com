  {
    "@id": "http://iec.ch/TC57/CIM100#AsynchronousMachineTimeConstantReactance",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Parameter details: - If X\u0027\u0027 = X\u0027, a single cage (one equivalent rotor winding per axis) is modelled. - The \uFFFDp\uFFFD in the attribute names is a substitution for a \uFFFDprime\uFFFD in the usual parameter notation, e.g. tpo refers to T\u0027o. The parameters used for models expressed in time constant reactance form include: - RotatingMachine.ratedS (MVAbase); - RotatingMachineDynamics.damping (D); - RotatingMachineDynamics.inertia (H); - RotatingMachineDynamics.saturationFactor (S1); - RotatingMachineDynamics.saturationFactor120 (S12); - RotatingMachineDynamics.statorLeakageReactance (Xl); - RotatingMachineDynamics.statorResistance (Rs); - .xs (Xs); - .xp (X\u0027); - .xpp (X\u0027\u0027); - .tpo (T\u0027o); - .tppo (T\u0027\u0027o).",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://cimbology.com/ontology/iec61970.ttl"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "AsynchronousMachineTimeConstantReactance",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://iec.ch/TC57/CIM100#AsynchronousMachineDynamics"
      }
    ],
    "https://cimbology.com/ontology/cimdoc#cimPackage": [
      {
        "@value": "IEC61970.Dynamics.StandardModels.AsynchronousMachineDynamics"
      }
    ],
    "https://cimbology.com/ontology/cimdoc#packageTier": [
      {
        "@value": "Normative"
      }
    ]
  },
  {
    "@id": "http://iec.ch/TC57/CIM100#AsynchronousMachineTimeConstantReactance.tpo",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Transient rotor time constant (T\u0027o) (\u003E AsynchronousMachineTimeConstantReactance.tppo). Typical value = 5.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
