  {
    "@id": "http://iec.ch/TC57/CIM100#Time",
    "@type": [
      "http://www.w3.org/2000/01/rdf-schema#Datatype"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Time as \u0022hh:mm:ss.sss\u0022, which conforms with ISO 8601. UTC time zone is specified as \u0022hh:mm:ss.sssZ\u0022. A local timezone relative UTC is specified as \u0022hh: mm:ss.sss\uFFFDhh:mm\u0022. The second component (shown here as \u0022ss.sss\u0022) could have any number of digits in its fractional part to allow any kind of precision beyond seconds.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://cimbology.com/ontology/iec61970.ttl"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Time",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2002/07/owl#equivalentClass": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#time"
      }
    ],
    "https://cimbology.com/ontology/cimdoc#cimPackage": [
      {
        "@value": "IEC61970.Base.Domain"
      }
    ],
    "https://cimbology.com/ontology/cimdoc#packageTier": [
      {
        "@value": "Normative"
      }
    ]
  },
