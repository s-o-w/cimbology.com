      {
        "@value": "4",
        "@type": "http://www.w3.org/2001/XMLSchema#integer"
      }
    ]
  },
  {
    "@id": "http://iec.ch/TC57/CIM100#PhaseShuntConnectionKind.Y",
    "@type": [
      "http://iec.ch/TC57/CIM100#PhaseShuntConnectionKind",
      "http://www.w3.org/2002/07/owl#NamedIndividual"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Wye connection.",
