  {
    "@id": "http://iec.ch/TC57/CIM100#OrientationKind",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The orientation of the coordinate system with respect to top, left, and the coordinate number system.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
