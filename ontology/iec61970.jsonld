        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "http://iec.ch/TC57/CIM100#Measurement.phases",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Indicates to which phases the measurement applies and avoids the need to use \u0027measurementType\u0027 to also encode phase information (which would explode the types). The phase information in Measurement, along with \u0027measurementType\u0027 and \u0027phases\u0027 uniquely defines a Measurement for a device, based on normal network phase. Their meaning will not change when the computed energizing phasing is changed due to jumpers or other reasons. If the attribute is missing three phases (ABC) shall be assumed.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://iec.ch/TC57/CIM100#Measurement"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
