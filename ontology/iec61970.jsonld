    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "IEEE 421.5-2005 type AC2A model. The model represents a high initial response field-controlled alternator-rectifier excitation system. The alternator main exciter is used with non-controlled rectifiers. The type AC2A model is similar to that of type AC1A except for the inclusion of exciter time constant compensation and exciter field current limiting elements. Reference: IEEE 421.5-2005, 6.2.",
        "@language": "en"
      }
    ],
