    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "An electrical device designed to respond to input conditions in a prescribed manner and after specified conditions are met to cause contact operation or similar abrupt change in associated electric control circuits, or simply to display the detected condition. Protection equipment is associated with conducting equipment and usually operate circuit breakers.",
        "@language": "en"
      }
    ],
