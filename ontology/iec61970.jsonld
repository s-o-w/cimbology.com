      }
    ]
  },
  {
    "@id": "http://iec.ch/TC57/CIM100#DiagramObject",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "An object that defines one or more points in a given space. This object can be associated with anything that specializes IdentifiedObject. For single line diagrams such objects typically include such items as analog values, breakers, disconnectors, power transformers, and transmission lines.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://cimbology.com/ontology/iec61970.ttl"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "DiagramObject",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://iec.ch/TC57/CIM100#IdentifiedObject"
      }
    ],
    "https://cimbology.com/ontology/cimdoc#cimPackage": [
      {
        "@value": "IEC61970.Base.DiagramLayout"
      }
    ],
    "https://cimbology.com/ontology/cimdoc#packageTier": [
      {
        "@value": "Normative"
      }
    ]
  },
  {
    "@id": "http://iec.ch/TC57/CIM100#DiagramObject.Diagram",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A diagram object is part of a diagram.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://iec.ch/TC57/CIM100#DiagramObject"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://cimbology.com/ontology/iec61970.ttl"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Diagram",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://iec.ch/TC57/CIM100#Diagram"
      }
    ]
  },
  {
    "@id": "http://iec.ch/TC57/CIM100#DiagramObject.DiagramObjectPoints",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A diagram object can have 0 or more points to reflect its layout position, routing (for polylines) or boundary (for polygons).",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://iec.ch/TC57/CIM100#DiagramObject"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://cimbology.com/ontology/iec61970.ttl"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "DiagramObjectPoints",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://iec.ch/TC57/CIM100#DiagramObjectPoint"
      }
    ]
  },
  {
    "@id": "http://iec.ch/TC57/CIM100#DiagramObject.DiagramObjectStyle",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A diagram object has a style associated that provides a reference for the style used in the originating system.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://iec.ch/TC57/CIM100#DiagramObject"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://cimbology.com/ontology/iec61970.ttl"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "DiagramObjectStyle",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://iec.ch/TC57/CIM100#DiagramObjectStyle"
      }
    ]
  },
  {
    "@id": "http://iec.ch/TC57/CIM100#DiagramObject.VisibilityLayers",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A diagram object can be part of multiple visibility layers.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://iec.ch/TC57/CIM100#DiagramObject"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://cimbology.com/ontology/iec61970.ttl"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "VisibilityLayers",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://iec.ch/TC57/CIM100#VisibilityLayer"
      }
    ]
  },
  {
    "@id": "http://iec.ch/TC57/CIM100#DiagramObject.drawingOrder",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The drawing order of this element. The higher the number, the later the element is drawn in sequence. This is used to ensure that elements that overlap are rendered in the correct order.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://iec.ch/TC57/CIM100#DiagramObject"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://cimbology.com/ontology/iec61970.ttl"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "drawingOrder",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#integer"
      }
    ]
  },
  {
    "@id": "http://iec.ch/TC57/CIM100#DiagramObject.isPolygon",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Defines whether or not the diagram objects points define the boundaries of a polygon or the routing of a polyline. If this value is true then a receiving application should consider the first and last points to be connected.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://iec.ch/TC57/CIM100#DiagramObject"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://cimbology.com/ontology/iec61970.ttl"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "isPolygon",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#boolean"
      }
    ]
  },
  {
    "@id": "http://iec.ch/TC57/CIM100#DiagramObject.offsetX",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The offset in the X direction. This is used for defining the offset from centre for rendering an icon (the default is that a single point specifies the centre of the icon). The offset is in per-unit with 0 indicating there is no offset from the horizontal centre of the icon. -0.5 indicates it is offset by 50% to the left and 0.5 indicates an offset of 50% to the right.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://iec.ch/TC57/CIM100#DiagramObject"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://cimbology.com/ontology/iec61970.ttl"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "offsetX",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#float"
      }
    ]
  },
  {
    "@id": "http://iec.ch/TC57/CIM100#DiagramObject.offsetY",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The offset in the Y direction. This is used for defining the offset from centre for rendering an icon (the default is that a single point specifies the centre of the icon). The offset is in per-unit with 0 indicating there is no offset from the vertical centre of the icon. The offset direction is dependent on the orientation of the diagram, with -0.5 and 0.5 indicating an offset of \u002B/- 50% on the vertical axis.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://iec.ch/TC57/CIM100#DiagramObject"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://cimbology.com/ontology/iec61970.ttl"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "offsetY",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#float"
      }
    ]
  },
  {
    "@id": "http://iec.ch/TC57/CIM100#DiagramObject.rotation",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Sets the angle of rotation of the diagram object. Zero degrees is pointing to the top of the diagram. Rotation is clockwise. DiagramObject.rotation=0 has the following meaning: The connection point of an element which has one terminal is pointing to the top side of the diagram. The connection point \u0022From side\u0022 of an element which has more than one terminal is pointing to the top side of the diagram. DiagramObject.rotation=90 has the following meaning: The connection point of an element which has one terminal is pointing to the right hand side of the diagram. The connection point \u0022From side\u0022 of an element which has more than one terminal is pointing to the right hand side of the diagram.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://iec.ch/TC57/CIM100#DiagramObject"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://cimbology.com/ontology/iec61970.ttl"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "rotation",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://iec.ch/TC57/CIM100#AngleDegrees"
      }
    ]
  },
  {
    "@id": "http://iec.ch/TC57/CIM100#DiagramObjectGluePoint",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "This is used for grouping diagram object points from different diagram objects that are considered to be glued together in a diagram even if they are not at the exact same coordinates.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://cimbology.com/ontology/iec61970.ttl"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "DiagramObjectGluePoint",
        "@language": "en"
      }
    ],
    "https://cimbology.com/ontology/cimdoc#cimPackage": [
      {
        "@value": "IEC61970.Base.DiagramLayout"
      }
    ],
    "https://cimbology.com/ontology/cimdoc#packageTier": [
      {
        "@value": "Normative"
      }
    ]
  },
  {
    "@id": "http://iec.ch/TC57/CIM100#DiagramObjectPoint",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A point in a given space defined by 3 coordinates and associated to a diagram object. The coordinates may be positive or negative as the origin does not have to be in the corner of a diagram.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://cimbology.com/ontology/iec61970.ttl"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "DiagramObjectPoint",
        "@language": "en"
      }
    ],
    "https://cimbology.com/ontology/cimdoc#cimPackage": [
      {
        "@value": "IEC61970.Base.DiagramLayout"
      }
    ],
    "https://cimbology.com/ontology/cimdoc#packageTier": [
      {
        "@value": "Normative"
      }
    ]
  },
  {
    "@id": "http://iec.ch/TC57/CIM100#DiagramObjectPoint.DiagramObjectGluePoint",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The \u0027glue\u0027 point to which this point is associated.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://iec.ch/TC57/CIM100#DiagramObjectPoint"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://cimbology.com/ontology/iec61970.ttl"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "DiagramObjectGluePoint",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://iec.ch/TC57/CIM100#DiagramObjectGluePoint"
      }
    ]
