      }
    ],
    "https://cimbology.com/ontology/cimdoc#enumCode": [
      {
        "@value": "2",
        "@type": "http://www.w3.org/2001/XMLSchema#integer"
      }
    ]
  },
  {
    "@id": "http://iec.ch/TC57/CIM100#OperationalLimitDirectionKind.high",
    "@type": [
      "http://iec.ch/TC57/CIM100#OperationalLimitDirectionKind",
      "http://www.w3.org/2002/07/owl#NamedIndividual"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "High means that a monitored value above the limit value is a violation. If applied to a terminal flow, the positive direction is into the terminal.",
        "@language": "en"
