      {
        "@value": "Queenpost Height"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#double"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#r",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://qudt.org/schema/qudt/applicableUnit": [
      {
        "@id": "http://qudt.org/vocab/unit/OHM"
      }
    ],
    "http://qudt.org/schema/qudt/quantityKind": [
      {
        "@id": "http://qudt.org/vocab/quantitykind/Resistance"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Positive sequence series resistance, in ohms. Optional. Mirrors cim:ACLineSegment.r. Absent unless an explicit value is provided by the designer; consumers fall back to cim:WireInfo per-length values * total length when this property is missing."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Positive Sequence Series Resistance"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#double"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#r0",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://qudt.org/schema/qudt/applicableUnit": [
      {
        "@id": "http://qudt.org/vocab/unit/OHM"
      }
    ],
    "http://qudt.org/schema/qudt/quantityKind": [
      {
        "@id": "http://qudt.org/vocab/quantitykind/Resistance"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Zero sequence series resistance, in ohms. Optional. Mirrors cim:ACLineSegment.r0. Absent unless an explicit value is provided by the designer."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Zero Sequence Series Resistance"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#double"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#rbs",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://qudt.org/schema/qudt/applicableUnit": [
      {
        "@id": "http://qudt.org/vocab/unit/N"
      }
    ],
    "http://qudt.org/schema/qudt/quantityKind": [
      {
        "@id": "http://qudt.org/vocab/quantitykind/Force"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Rated breaking strength in newtons. Applies to distribution overhead conductors, substation strain bus conductors, and shield wires. Source: ASTM B232 and conductor manufacturer data sheets.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Rated Breaking Strength"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#double"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#reactance",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Inductive reactance at 60 Hz in ohms per kilometer. Required by any tool performing voltage drop or power flow calculations \u2014 distribution overhead conductors, HV cable, and substation buswork all carry this parameter. Source: ASTM B232 and conductor manufacturer data sheets.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Reactance"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#double"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://iec.ch/TC57/CIM100#WireInfo"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#recloserType",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Recloser operational type (e.g., \u0027normal\u0027, \u0027bypass\u0027). CIM may model reclosers as cim:Breaker or cim:Recloser depending on profile version.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Recloser Type"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
