      {
        "@id": "http://www.w3.org/2001/XMLSchema#double"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#maxAllowableSag",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://qudt.org/schema/qudt/applicableUnit": [
      {
        "@id": "http://qudt.org/vocab/unit/M"
      }
    ],
    "http://qudt.org/schema/qudt/quantityKind": [
      {
        "@id": "http://qudt.org/vocab/quantitykind/Length"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Maximum allowable conductor sag in meters. Design limit \u2014 conductors must not sag below this value under any design condition. Typical default: 16.4 ft = 5.0 m.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://cimbology.com/ontology/kg#DistributionCriteria"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Max Allowable Sag"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#double"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#maxConductorTension",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://qudt.org/schema/qudt/applicableUnit": [
      {
        "@id": "http://qudt.org/vocab/unit/N"
      }
    ],
    "http://qudt.org/schema/qudt/quantityKind": [
      {
        "@id": "http://qudt.org/vocab/quantitykind/Force"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Maximum allowable conductor tension in newtons for stringing design. Typical default: 22480 lbf = 99,970 N.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://cimbology.com/ontology/kg#DistributionCriteria"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Max Conductor Tension"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#double"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#maxEyePull",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://qudt.org/schema/qudt/applicableUnit": [
      {
        "@id": "http://qudt.org/vocab/unit/N"
      }
    ],
    "http://qudt.org/schema/qudt/quantityKind": [
      {
        "@id": "http://qudt.org/vocab/quantitykind/Force"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Maximum pulling tension via a pulling eye attached to the conductor core in newtons. Typically higher than cimbology:maxGripPull because load is transferred directly to the structural core. Source: conductor manufacturer installation data.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Max Eye Pull"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#double"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#maxGripPull",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://qudt.org/schema/qudt/applicableUnit": [
      {
        "@id": "http://qudt.org/vocab/unit/N"
      }
    ],
    "http://qudt.org/schema/qudt/quantityKind": [
      {
        "@id": "http://qudt.org/vocab/quantitykind/Force"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Maximum pulling tension via a grip or stocking on the conductor outer jacket in newtons. Limits cable jacket damage during conduit pulls. Source: conductor manufacturer installation data.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Max Grip Pull"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#double"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#maxHeight",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://qudt.org/schema/qudt/applicableUnit": [
      {
        "@id": "http://qudt.org/vocab/unit/M"
      }
    ],
    "http://qudt.org/schema/qudt/quantityKind": [
      {
        "@id": "http://qudt.org/vocab/quantitykind/Length"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Maximum rated pole height in meters \u2014 the longest standard length available for this pole class/species. Distinct from cimbology:poleHeight which is the actual installed pole height.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Max Pole Height"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#double"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#maxIceThickness",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://qudt.org/schema/qudt/applicableUnit": [
      {
        "@id": "http://qudt.org/vocab/unit/M"
      }
    ],
    "http://qudt.org/schema/qudt/quantityKind": [
      {
        "@id": "http://qudt.org/vocab/quantitykind/Length"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
