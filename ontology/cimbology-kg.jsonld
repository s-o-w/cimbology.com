      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Legacy potential-transformer ratio string (e.g., \u0027138000:120\u0027 for substation, \u00277200:120\u0027 for distribution). For structured ratio metadata such as accuracy class and ratio components, use cim:PotentialTransformerInfo from the IEC 61968 informative AssetInfo package alongside this string when needed."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "PT Ratio"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
