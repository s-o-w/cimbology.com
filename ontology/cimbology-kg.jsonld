      {
        "@value": "Is Catalog Key"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#isGangOperated",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "True if a multi-pole switching device operates all poles simultaneously via a shared operating mechanism. Applicable to cim:Disconnector and cim:LoadBreakSwitch where independent-pole operation is physically possible but operationally undesired. Absent or false = poles may operate independently. Breakers inherently operate all poles simultaneously and do not need this flag. Aligns with (and inverts) CIM\u0027s SwitchInfo.isUnganged: isGangOperated = NOT isUnganged."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Is Gang Operated"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#boolean"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#isPhysicallyInverted",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "True if the equipment is physically installed 180\u00B0 from the conventional orientation. Affects only the physical mapping from cim:Terminal.sequenceNumber to the physical terminal on the equipment body. Does NOT change electrical topology (odd sequenceNumber 1,3,5 = line side; even 2,4,6 = load side). Absent or false = conventional. Applicable to two-sided switching equipment (cim:Breaker, cim:Disconnector, cim:Fuse, cim:ACLineSegment)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Is Physically Inverted"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#boolean"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#isReversed",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "True if the span direction was reversed during analysis (start/end poles swapped for computational reasons). Consumers must account for this when interpreting start/end height and tension values.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://cimbology.com/ontology/kg#SagTensionResult"
