        "@id": "http://qudt.org/vocab/quantitykind/Force"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Conductor tension at the lowest point of the catenary in newtons (equals horizontal tension for a catenary; used both as a DistributionCriteria threshold, typical default 1 lbf = 4.45 N, and as a SagTensionResult output).",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Lowest Point Tension"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#double"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#mainPanelSize",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://qudt.org/schema/qudt/applicableUnit": [
