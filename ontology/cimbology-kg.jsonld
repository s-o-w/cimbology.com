      {
        "@id": "http://qudt.org/vocab/quantitykind/Length"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Duct length threshold in meters above which fill ratio governs sizing (shorter ducts are governed by jam ratio). Typical default: ~1.969 ft = 0.6 m.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://cimbology.com/ontology/kg#DistributionCriteria"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "FR Length Threshold"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#double"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#frameSize",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Physical frame designation for a breaker or switchgear assembly (for example \u0027225AF\u0027 or \u0027600A frame\u0027). Needed for catalog resolution and replacement planning.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Frame Size"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#framingType",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Pole-top framing layout (e.g., \u0027Horizontal\u0027, \u0027Vertical\u0027, \u0027Spacer\u0027). Determines phase spacing, crossarm requirements, and pole head geometry.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://cimbology.com/ontology/kg#Framing"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Framing Type"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#frictionCoeffThreshold",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Threshold in N/m above which the high friction coefficient applies. Imperial equivalent: lbf/ft (typical default: 2190 N/m = 150 lbf/ft).",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://cimbology.com/ontology/kg#DistributionCriteria"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Friction Coeff Threshold"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#double"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#fuseRating",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://qudt.org/schema/qudt/applicableUnit": [
      {
        "@id": "http://qudt.org/vocab/unit/A"
      }
    ],
    "http://qudt.org/schema/qudt/quantityKind": [
      {
        "@id": "http://qudt.org/vocab/quantitykind/ElectricCurrent"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Fuse continuous current rating in amperes per IEEE C37.42-2016 (distribution cutouts and fuse links). CIM models fuses via cim:Fuse but does not carry detailed fuse link ratings.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Fuse Rating"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#double"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://iec.ch/TC57/CIM100#Fuse"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#fuseType",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Fuse/cutout type (e.g., \u0027standard fuse\u0027, \u0027cutout\u0027, \u0027arrester\u0027, \u0027disconnect\u0027). Fuse type determines time-current characteristics and fault interrupting behavior.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Fuse Type"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://iec.ch/TC57/CIM100#Fuse"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#groundLineMomentApplied",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://qudt.org/schema/qudt/applicableUnit": [
      {
        "@id": "http://qudt.org/vocab/unit/N-M"
      }
