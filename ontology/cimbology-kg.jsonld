        "@value": "Rated ground-line moment capacity in newton-meters, derived from pole class, species, and circumference at ground line per ANSI O5.1.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Ground-Line Moment Capacity"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#double"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#groundedTo",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
