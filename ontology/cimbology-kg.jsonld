    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Demand factor (0\u20131) applied to connected load to estimate peak demand. Distribution design uses demand factors to avoid oversizing transformers and service conductors. Typical residential: 0.4\u20130.6; commercial: varies by load category.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
