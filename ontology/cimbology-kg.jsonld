  {
    "@id": "https://cimbology.com/ontology/kg#regulatorBandwidth",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://qudt.org/schema/qudt/applicableUnit": [
      {
        "@id": "http://qudt.org/vocab/unit/V"
      }
    ],
    "http://qudt.org/schema/qudt/quantityKind": [
      {
        "@id": "http://qudt.org/vocab/quantitykind/Voltage"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Voltage regulator bandwidth in volts per IEEE C57.15-2009. Bandwidth defines the voltage deadband within which the regulator does not tap-change. Typical values: 1.5\u20133.0 V on a 120 V base.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Regulator Bandwidth"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#double"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#regulatorImpedancePct",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Series impedance of a voltage regulator expressed as percent of rated. Needed for voltage-drop and short-circuit studies on regulator banks. Related CIM concept: cim:TransformerEnd.x on the underlying regulator transformer.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Regulator Impedance"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#double"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://iec.ch/TC57/CIM100#PowerTransformer"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#regulatorRangePct",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Voltage regulator range as a percentage of nominal per IEEE C57.15 (e.g., \u00B110% is the most common for 32-step regulators). CIM models this via cim:RatioTapChanger.stepVoltageIncrement and step count.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Regulator Range"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#double"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://iec.ch/TC57/CIM100#PowerTransformer"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#regulatorType",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Voltage regulator type designation.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Regulator Type"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://iec.ch/TC57/CIM100#PowerTransformer"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#relationKind",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "REQUIRED: The semantic type of this relation (Containment, PhysicalConnection, ParentChild, ProtectionAssignment, etc.)"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://cimbology.com/ontology/kg#Relation"
      }
    ],
