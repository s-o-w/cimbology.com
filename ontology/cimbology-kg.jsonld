      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Transformer load loss in watts from the rated-current short-circuit test. Needed for efficiency, voltage-drop, and thermal studies in both distribution and substation contexts. CIM equivalent if any: cim:ShortCircuitTest.loss.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Load Loss"
