      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Fully resolved tool-native catalog item identifier. When present, a catalog resolver may bypass lens-driven catalog query construction and return this value directly. Use when the producing tool already knows the exact catalog row (e.g. user selected from a picker) and round-tripping through canonical CIM properties would risk precision loss."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
