[
  {
    "@id": "https://cimbology.com/ontology/cimbology-kg.ttl",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "CIMBOLOGY-KG Core Ontology \u2014 CIM-grounded knowledge graph extensions for electrical infrastructure. Uses IEC CIM100 types directly.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "CIMBOLOGY-KG Core Ontology",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://iec.ch/TC57/CIM100"
      }
    ],
    "http://www.w3.org/2002/07/owl#imports": [
      {
        "@id": "https://cimbology.com/ontology/cim100.ttl"
      }
    ],
    "http://www.w3.org/2002/07/owl#versionInfo": [
      {
        "@value": "1.0.0"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#AnchorGuy",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Down-guy and anchor assembly providing lateral support to a distribution pole. Carries guy wire tension, lead distance, and attachment height. CIM has cim:StructureSupport.anchorKind (an enum) but does not model the full guy assembly as a class with engineering properties.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Anchor and Guy"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://iec.ch/TC57/CIM100#StructureSupport"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#AuxiliaryContact",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Discrete auxiliary breaker contact (for example 52a/52b) modeled as a first-class circuit node for path tracing."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Auxiliary Contact"
      }
    ],
    "https://cimbology.com/ontology/kg#equipmentDomain": [
      {
        "@value": "electrical"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#BusEnd",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "End fitting or termination point of a bus section. Not modeled in CIM (cim:BusbarSection models the bus itself, not its endpoints)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Bus End"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://iec.ch/TC57/CIM100#BusbarSection"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#BusExpansion",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Expansion joint or flexible connection in a bus run, allowing thermal expansion. Not modeled in CIM."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Bus Expansion"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#CableTap",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Cable tap or junction point where a cable is tapped for a branch connection. Not modeled in CIM."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Cable Tap"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#Clearance",
    "@type": [
      "https://cimbology.com/ontology/kg#RelationKind"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Source-to-target clearance relation carrying measured/required distance and governing rule metadata."
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#ClearanceCheck",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Reusable clearance verification relation between two objects (including NESC Table 232-1 ground, road, building, and crossing checks for distribution spans as well as substation clearance checks). Stores actual clearance, required clearance, violation state, and governing rule citation.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Clearance Check"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://cimbology.com/ontology/kg#Relation"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#ClearanceKind",
    "@type": [
      "http://www.w3.org/2000/01/rdf-schema#Class"
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#CloseCircuit",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Aggregate circuit object representing the ordered wiring path that closes a breaker. Queryable metadata object, not a physical conductor."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Close Circuit"
      }
    ],
    "https://cimbology.com/ontology/kg#equipmentDomain": [
      {
        "@value": "electrical"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#Conductor",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A logical per-phase electrical conductor that runs between two equipment termination points. Has exactly 2 cim:Terminal nodes (sequenceNumber 1 = source, sequenceNumber 2 = destination); phase is on each terminal via cim:Terminal.phases. Physically composed of one or more members typed as cim:BusbarSection (rigid bus, A-frame segments) or cim:ACLineSegment (cable). Members point back via cimbology:memberOfConductorRun. cim:Conductor.length on the cimbology:Conductor itself is NOT stored at emit time; it is the lazy sum of member lengths, computed on demand across the graph. Three cimbology:Conductor instances (one per phase A/B/C) make up a typical 3-phase logical run."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Conductor (Logical Run)"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://iec.ch/TC57/CIM100#Conductor"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#Conduit",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Conduit, raceway, or cable tray for routing and protecting cables. CIM models underground duct banks via cim:DuctBank but does not cover above-ground conduit or cable tray."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Conduit"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://iec.ch/TC57/CIM100#DuctBank"
      }
    ],
    "https://cimbology.com/ontology/kg#equipmentDomain": [
      {
        "@value": "structural"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#ConduitFitting",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Conduit fitting (elbows, couplings, junction boxes, pull boxes). Not modeled in CIM."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Conduit Fitting"
      }
    ],
    "https://cimbology.com/ontology/kg#equipmentDomain": [
      {
        "@value": "structural"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#ConnectivityHint",
    "@type": [
      "https://cimbology.com/ontology/kg#RelationKind"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Low-confidence hint from IFC port topology suggesting two elements are connected."
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#Containment",
    "@type": [
      "https://cimbology.com/ontology/kg#RelationKind"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Source contains target (cables in conduits, equipment in bays)"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#Crossing",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Location where the distribution line crosses a road, railroad, power line, waterway, or other facility requiring specific NESC clearance rules. Not modeled in CIM.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Crossing"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#DCSystem",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Station DC control power system (batteries, charger, distribution panels). Provides power for trip/close coils and relays. Not modeled in CIM."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "DC System"
      }
    ],
    "https://cimbology.com/ontology/kg#equipmentDomain": [
      {
        "@value": "electrical"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#DeadEndStructure",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Termination structure where overhead lines end and transition (e.g., line-to-bus or line-to-cable). A specialized structural type not modeled in CIM."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Dead-End Structure"
      }
    ],
    "https://cimbology.com/ontology/kg#equipmentDomain": [
      {
        "@value": "structural"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#DistributionCriteria",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "NESC Section 23 design basis for a distribution line. Captures loading district, construction grade, overload factors, and environmental assumptions. CIM models as-built operational parameters, not design inputs \u2014 this class fills that gap.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Distribution Criteria"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#DistributionLine",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Root container for a distribution line or circuit. CIM\u0027s cim:Line is abstract and covers both transmission and distribution; this class anchors distribution-specific design data (criteria, spans, pole loading) that cim:Line cannot express.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Distribution Line"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://iec.ch/TC57/CIM100#Line"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#ElectricalClearance",
    "@type": [
      "https://cimbology.com/ontology/kg#ClearanceKind"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Clearance driven by electrical insulation/separation requirements.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#ElectricalProximityHint",
    "@type": [
      "https://cimbology.com/ontology/kg#RelationKind"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Low-confidence hint from spatial proximity analysis suggesting electrical adjacency."
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#EquipmentBank",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A coordinated set of per-phase equipment (typically 3 members - one per phase) installed and managed as a single logical asset. Examples: 3 CTs monitoring a breaker, 3 CCVTs at a line entrance, 3 PTs at a bus section, 3 surge arresters protecting a transformer side. Subclassing cim:EquipmentContainer aligns the concept with CIM containment semantics; however, equipment links to its bank via cimbology:memberOfBank rather than cim:Equipment.EquipmentContainer (which remains reserved for the Substation/VoltageLevel/Bay containment chain). A bank node has UUID identity; its rdfs:label is optional and human-friendly only."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Equipment Bank"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://iec.ch/TC57/CIM100#EquipmentContainer"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#Fence",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Perimeter fencing around a substation (chain-link fabric, pipe rails, masonry walls, gates). Every substation has a security fence but CIM does not model it \u2014 cim:AssetContainer mentions \u0027fences\u0027 only as an example of aggregated assets with no dedicated class."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Fence"
      }
    ],
    "https://cimbology.com/ontology/kg#equipmentDomain": [
      {
        "@value": "structural"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#Fitting",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Conductor fitting or hardware (splices, clamps, connectors, terminations). Used for physical conductor accessories not modeled in CIM."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Fitting"
      }
    ],
    "https://cimbology.com/ontology/kg#equipmentDomain": [
      {
        "@value": "structural"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#Foundation",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Concrete foundation for substation equipment (transformer pads, switch bases, etc.). Not modeled in CIM."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Foundation"
      }
    ],
    "https://cimbology.com/ontology/kg#equipmentDomain": [
      {
        "@value": "structural"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#Framing",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Pole-top configuration defining crossarm type, phase arrangement, and attachment geometry. Distribution poles carry framing as a first-class concept (horizontal, vertical, triangular, wishbone, etc.) whereas transmission structures define attachment implicitly via geometry. Not modeled in CIM.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Framing"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#GenericEquipment",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Catch-all type for equipment that does not map to any specific CIM or CIMBOLOGY-KG type. Used as a fallback when type mapping produces no match."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Generic Equipment"
      }
    ],
    "https://cimbology.com/ontology/kg#equipmentDomain": [
      {
        "@value": "structural"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#GroundOrCrossing",
    "@type": [
      "https://cimbology.com/ontology/kg#ClearanceKind"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Clearance driven by ground/crossing rulebooks such as NESC crossing tables.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#GroundingSystem",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Physical grounding infrastructure (ground rods, ground grid, ground wells, grounding conductors). Distinct from CIM\u0027s cim:Ground which is an abstract electrical connection to earth in the network model."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Grounding System"
      }
    ],
    "https://cimbology.com/ontology/kg#equipmentDomain": [
      {
        "@value": "structural"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#GuyingResult",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Per-guy analysis result from pole loading / guying calculations. Captures the computed tension, lead distance adequacy, and strength factor for an individual guy wire. Separating guy-level results from pole-level results (cimbology:PoleLoadResult) allows violation queries at each guy independently.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Guying Result"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#HousedIn",
    "@type": [
      "https://cimbology.com/ontology/kg#RelationKind"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Links equipment (relays, panels, batteries) to the cim:Structure that physically contains it."
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#Insulator",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Electrical insulator (post, suspension, pin, etc.) providing mechanical support and electrical isolation. CIM does not define an insulator class; it models insulation as properties on other equipment."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Insulator"
      }
    ],
    "https://cimbology.com/ontology/kg#equipmentDomain": [
      {
        "@value": "structural"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#InsulatorBracket",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Mounting bracket or hardware for attaching an insulator to a support structure. Not modeled in CIM."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Insulator Bracket"
      }
    ],
    "https://cimbology.com/ontology/kg#equipmentDomain": [
      {
        "@value": "structural"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#LinearGeometry",
    "@type": [
      "http://www.w3.org/2000/01/rdf-schema#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Ordered sequence of 3D points defining a path for cables, conduits, etc."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Linear Geometry"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#LoadCase",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Temperature, wind, and ice loading combination for design analysis. Defines the environmental conditions under which sag-tension and clearance are evaluated. Distinct from CIM\u0027s cim:LoadGroup which models operational demand.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Load Case"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#MaintenanceAccess",
    "@type": [
      "https://cimbology.com/ontology/kg#ClearanceKind"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Clearance driven by maintenance access and removal path requirements.",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#ParentChild",
    "@type": [
      "https://cimbology.com/ontology/kg#RelationKind"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Source is parent of target (assembly hierarchy)"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#PhysicalConnection",
    "@type": [
      "https://cimbology.com/ontology/kg#RelationKind"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Source connects to target (terminal-to-terminal wiring)"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#PointGeometry",
    "@type": [
      "http://www.w3.org/2000/01/rdf-schema#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Single 3D coordinate for connection points and attachment locations."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Point Geometry"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#PoleLoadResult",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Pole loading analysis result expressing applied ground-line moment as a percentage of the pole\u0027s rated capacity. First-class in distribution design \u2014 every pole must pass a loading check. Transmission uses structure-level analysis instead.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Pole Load Result"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#PrimarySpan",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Physical span of primary conductor between two adjacent distribution poles. The unit for sag-tension analysis. Distinct from cim:ACLineSegment which models the electrical segment, not the physical catenary.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Primary Span"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://iec.ch/TC57/CIM100#ACLineSegment"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#ProtectionAssignment",
    "@type": [
      "https://cimbology.com/ontology/kg#RelationKind"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Links a protection relay (cim:ProtectionEquipment) to the breaker it protects."
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#Relation",
    "@type": [
      "http://www.w3.org/2000/01/rdf-schema#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Generic relation between CIMBOLOGY-KG objects. Requires relationKind."
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#RelationKind",
    "@type": [
      "http://www.w3.org/2000/01/rdf-schema#Class"
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#Replacement",
    "@type": [
      "https://cimbology.com/ontology/kg#RelationKind"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Source node replaces target node. Source should have changeAction=add, target should have changeAction=remove. Tools should transfer correlation data from target to source."
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#SagTensionResult",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Read-only solver output for a distribution span under a specific load case. Same concept as transmission sag-tension but applied to distribution spans with typically shorter spans and lighter conductors.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Sag Tension Result"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#ServicePoint",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Customer service delivery point where the utility\u0027s distribution system connects to the customer\u0027s premises. Carries load data (demand, connected load) for voltage drop and transformer sizing. Not modeled in CIM\u0027s network topology.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Service Point"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#ServiceSpan",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Span of secondary or service-drop conductor from a distribution pole or transformer to a service point. Distribution has distinct primary, secondary, and service conductor categories that transmission does not need.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Service Span"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#SupportStructure",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Steel structure supporting equipment in a substation (A-frames, columns, bus support stands). CIM models structures via cim:Structure (Pole, Tower) but does not cover substation-specific steel support."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Support Structure"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://iec.ch/TC57/CIM100#Structure"
      }
    ],
    "https://cimbology.com/ontology/kg#equipmentDomain": [
      {
        "@value": "structural"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#TerminalConnector",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Physical terminal connector hardware (lugs, bolted connectors, compression connectors). Distinct from CIM\u0027s cim:Terminal which is an abstract electrical connection point in the network model."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Terminal Connector"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#Transform",
    "@type": [
      "http://www.w3.org/2000/01/rdf-schema#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "4x4 transformation matrix for equipment placement. Serialized as flat 16-float array."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Transform"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#TripCircuit",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Aggregate circuit object representing the ordered wiring path that trips a breaker. Queryable metadata object, not a physical conductor."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Trip Circuit"
      }
    ],
    "https://cimbology.com/ontology/kg#equipmentDomain": [
      {
        "@value": "electrical"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#VoltageDropResult",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Voltage drop analysis result for a distribution circuit section. Any distribution design tool must exchange voltage drop and flicker percentages to verify ANSI C84.1 service voltage limits. Not modeled in CIM (CIM tracks operational voltage, not design-stage voltage drop analysis).",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Voltage Drop Result"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#aboveGroundHeight",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://qudt.org/schema/qudt/applicableUnit": [
      {
        "@id": "http://qudt.org/vocab/unit/M"
      }
    ],
    "http://qudt.org/schema/qudt/quantityKind": [
      {
        "@id": "http://qudt.org/vocab/quantitykind/Length"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Pole height above ground in meters (poleHeight minus settingDepth). CIM equivalent: cim:Structure.height (IEC61968 AssetInfo) \u2014 \u0027Visible height of structure above ground level for overhead construction (e.g., Pole or Tower).\u0027 cim:Pole is a subclass of cim:Structure, so this field applies directly.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Above Ground Height"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#double"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://iec.ch/TC57/CIM100#Structure"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#acResistance",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "AC resistance at operating temperature in ohms per kilometer. Applies to distribution overhead conductors and HV cables alike. CIM equivalent: cim:WireInfo.rAC50 (IEC61968 AssetInfo) \u2014 resistance per unit length at 50\u00B0C. CIMBOLOGY-KG uses ohms/km to match ASTM B232 and conductor manufacturer data sheets; CIM uses ohms/meter.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "AC Resistance"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#double"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://iec.ch/TC57/CIM100#WireInfo"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#actualDemandKvar",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://qudt.org/schema/qudt/applicableUnit": [
      {
        "@id": "http://qudt.org/vocab/unit/KILO-VAR"
      }
    ],
    "http://qudt.org/schema/qudt/quantityKind": [
      {
        "@id": "http://qudt.org/vocab/quantitykind/ReactivePower"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Measured or actual reactive demand in kilovar at the service point. Any distribution planning tool exchanging load-study inputs needs a separate reactive-demand slot.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://cimbology.com/ontology/kg#ServicePoint"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Actual Demand kVAR"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#double"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#actualDemandKw",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://qudt.org/schema/qudt/applicableUnit": [
      {
        "@id": "http://qudt.org/vocab/unit/KiloW"
      }
    ],
    "http://qudt.org/schema/qudt/quantityKind": [
      {
        "@id": "http://qudt.org/vocab/quantitykind/Power"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Measured or actual service demand in kilowatts. Distinct from cimbology:demandKw, which is a design estimate derived from connected load and diversity.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://cimbology.com/ontology/kg#ServicePoint"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Actual Demand"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#double"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#ambientTemp",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://qudt.org/schema/qudt/applicableUnit": [
      {
        "@id": "http://qudt.org/vocab/unit/DEG_C"
      }
    ],
    "http://qudt.org/schema/qudt/quantityKind": [
      {
        "@id": "http://qudt.org/vocab/quantitykind/Temperature"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Ambient temperature for NESC combined loading in degrees Celsius. NESC \u00A7250B specifies -18\u00B0C for Heavy/Medium, -1\u00B0C for Light.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://cimbology.com/ontology/kg#DistributionCriteria"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Ambient Temperature"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#double"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#ampacity",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://qudt.org/schema/qudt/applicableUnit": [
      {
        "@id": "http://qudt.org/vocab/unit/A"
      }
    ],
    "http://qudt.org/schema/qudt/quantityKind": [
      {
        "@id": "http://qudt.org/vocab/quantitykind/ElectricCurrent"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Continuous thermal current rating in amperes. Applies to distribution conductors, HV cables, and substation buswork \u2014 any current-carrying conductor in any domain has an ampacity limit. Source: IEEE 738 and conductor manufacturer data.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Ampacity"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#double"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://iec.ch/TC57/CIM100#WireInfo"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#anchorCapacity",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://qudt.org/schema/qudt/applicableUnit": [
      {
        "@id": "http://qudt.org/vocab/unit/N"
      }
    ],
    "http://qudt.org/schema/qudt/quantityKind": [
      {
        "@id": "http://qudt.org/vocab/quantitykind/Force"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Holding capacity of the anchor in newtons based on soil class.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://cimbology.com/ontology/kg#AnchorGuy"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Anchor Capacity"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#double"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#anchorIsDouble",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "True if the anchor consists of two anchor rods or plates (double anchor) providing roughly double the single-anchor holding capacity. Affects anchor adequacy check in pole loading analysis.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://cimbology.com/ontology/kg#AnchorGuy"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Is Double Anchor"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#boolean"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#anchorMaxTension",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://qudt.org/schema/qudt/applicableUnit": [
      {
        "@id": "http://qudt.org/vocab/unit/N"
      }
    ],
    "http://qudt.org/schema/qudt/quantityKind": [
      {
        "@id": "http://qudt.org/vocab/quantitykind/Force"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Maximum rated pullout tension for this anchor assembly in newtons \u2014 the manufacturer\u0027s catalog capacity at standard soil class. Distinct from cimbology:anchorCapacity (domain: cimbology:GuyingResult) which is the computed soil-specific holding capacity for a specific installation.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://cimbology.com/ontology/kg#AnchorGuy"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Anchor Max Tension"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#double"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#anchorStrengthFactor",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Strength factor for the anchor \u2014 ratio of anchor holding capacity to applied guy tension. Values below 1.0 indicate the anchor is inadequate.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://cimbology.com/ontology/kg#GuyingResult"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Anchor Strength Factor"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#double"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#anchorType",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Anchor type (e.g., \u0027expanding\u0027, \u0027screw\u0027, \u0027plate\u0027, \u0027rock\u0027, \u0027swamp\u0027, \u0027log\u0027, \u0027cone\u0027, \u0027rail anchor\u0027, \u0027hinged tie bar\u0027, \u0027traction strut\u0027).",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://cimbology.com/ontology/kg#AnchorGuy"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Anchor Type"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#ansiDeviceNumber",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "ANSI/IEEE device function number(s) (e.g., \u002750/51\u0027, \u002779\u0027, \u002786\u0027, \u002725\u0027). Used by substation protection relays and distribution recloser/relay controllers. Multiple functions separated by \u0027/\u0027."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "ANSI Device Number"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#applyWireDiversity",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Whether to apply load diversity factors to wire voltage drop calculations. Typical default: true.",
        "@language": "en"
      }
    ],
