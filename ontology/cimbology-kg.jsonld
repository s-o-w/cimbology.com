      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Ordered sequence of [x,y,z] points for linear geometry (cables, conduits)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#peakDemandKw",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://qudt.org/schema/qudt/applicableUnit": [
      {
        "@id": "http://qudt.org/vocab/unit/KiloW"
      }
    ],
    "http://qudt.org/schema/qudt/quantityKind": [
      {
        "@id": "http://qudt.org/vocab/quantitykind/Power"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Historical or billed peak demand in kilowatts. Distinct from cimbology:demandKw, which is the design-calculated demand, and cimbology:actualDemandKw, which captures current measured load.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://cimbology.com/ontology/kg#ServicePoint"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Measured Peak Demand"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#double"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#phase",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Electrical phase assignment (e.g., \u0027A\u0027, \u0027B\u0027, \u0027C\u0027, \u0027N\u0027, \u0027ABC\u0027). Used on relations and conductors. Supplementary convenience property for fast querying. cim:Terminal.phases is the authoritative source. If both present and conflict, cim:Terminal.phases wins."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Phase"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#phaseArrangement",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Phase arrangement on the framing (e.g., \u0027ABC\u0027, \u0027ACB\u0027, \u0027BAC\u0027, \u0027Single\u0027). Affects induced voltage calculations and circuit identification.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://cimbology.com/ontology/kg#Framing"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Phase Arrangement"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#phaseCount",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Number of phases (1 for single-phase, 2 for V-phase/open-delta, 3 for three-phase). Applies to distribution framings, service points, and substation equipment (transformers, switchgear, feeders) in any domain.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Phase Count"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#integer"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#phaseCreated",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Design/construction phase during which this element was created (e.g., \u0027Schematic\u0027, \u0027Detail Design\u0027)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Phase Created"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#phases",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Number or combination of electrical phases (e.g., \u00273\u0027, \u0027ABC\u0027, \u00271\u0027). Simplified from CIM\u0027s PhaseCode enumeration. Supplementary convenience property for fast querying. cim:Terminal.phases is the authoritative source. If both present and conflict, cim:Terminal.phases wins."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Phases"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#physicalSide",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Physical side designation on a terminal of an inverted equipment. Values: \u0027LineSide\u0027 or \u0027LoadSide\u0027. REQUIRED on all 6 terminals when the parent equipment has cimbology:isPhysicallyInverted = true; OMITTED on terminals of conventionally-installed equipment (convention is unambiguous from cim:Terminal.sequenceNumber). When inverted: terminals with odd sequenceNumber (1,3,5) carry physicalSide=\u0027LoadSide\u0027 and terminals with even sequenceNumber (2,4,6) carry physicalSide=\u0027LineSide\u0027."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Physical Side"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#pluginName",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Name of the tool plugin or exporter that produced this data."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Plugin Name"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#pluginVersion",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Version of the tool plugin that produced this data."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Plugin Version"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#point",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Single [x,y,z] coordinate (connection points, attachment locations)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON"
      }
    ],
    "https://cimbology.com/ontology/kg#firstClassProperty": [
      {
        "@value": "true",
        "@type": "http://www.w3.org/2001/XMLSchema#boolean"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#points",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Array of [x,y,z] coordinates (distinct from cimbology:path which implies ordering for linear geometry)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON"
      }
    ],
    "https://cimbology.com/ontology/kg#firstClassProperty": [
      {
        "@value": "true",
        "@type": "http://www.w3.org/2001/XMLSchema#boolean"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#poleCapLength",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://qudt.org/schema/qudt/applicableUnit": [
      {
        "@id": "http://qudt.org/vocab/unit/M"
      }
    ],
    "http://qudt.org/schema/qudt/quantityKind": [
      {
        "@id": "http://qudt.org/vocab/quantitykind/Length"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Pole cap length in meters \u2014 reserved clearance from pole top to the first conductor attachment. Typical default: 0.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://cimbology.com/ontology/kg#DistributionCriteria"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Pole Cap Length"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#double"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#poleClass",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "ANSI O5.1 pole class. Standard classes: \u00277\u0027, \u00276\u0027, \u00275\u0027, \u00274\u0027, \u00273\u0027, \u00272\u0027, \u00271\u0027, \u0027H1\u0027, \u0027H2\u0027, \u0027H3\u0027, \u0027H4\u0027, \u0027H5\u0027, \u0027H6\u0027. Concrete classes: \u0027C-01.9\u0027 through \u0027C-12.0\u0027. Other: \u0027G\u0027, \u0027F\u0027, \u0027H\u0027, \u0027J\u0027. Determines ground-line moment capacity. CIM equivalent: cim:Pole.classification (IEC61968 InfAssets), which uses the same class codes.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Pole Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://iec.ch/TC57/CIM100#Pole"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#poleHeadStyle",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Pole head assembly style (e.g., \u0027ruling span\u0027, \u0027non ruling span\u0027, \u0027buck\u0027, \u0027end\u0027). Describes the structural assembly configuration.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://cimbology.com/ontology/kg#Framing"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Pole Head Style"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#poleHeadType",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Pole head conductor type (e.g., \u0027primary\u0027, \u0027secondary\u0027, \u0027service\u0027, \u0027neutral\u0027, \u0027communication\u0027). Identifies which circuit level a pole head assembly serves.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://cimbology.com/ontology/kg#Framing"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Pole Head Type"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#poleHeight",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://qudt.org/schema/qudt/applicableUnit": [
      {
        "@id": "http://qudt.org/vocab/unit/M"
      }
    ],
    "http://qudt.org/schema/qudt/quantityKind": [
      {
        "@id": "http://qudt.org/vocab/quantitykind/Length"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Total pole height in meters (above ground \u002B setting depth). CIM equivalent: cim:Pole.length (IEC61968 InfAssets) \u2014 \u0027Length of the pole (inclusive of any section of the pole that may be underground post-installation).\u0027",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Pole Height"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#double"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://iec.ch/TC57/CIM100#Pole"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#poleLoadingPct",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Applied ground-line moment as a percentage of rated capacity (0\u2013100\u002B). Values over 100% indicate overloaded poles.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://cimbology.com/ontology/kg#PoleLoadResult"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Pole Loading Percent"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#double"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#poleLoadingViolated",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "True if poleLoadingPct exceeds 100% (pole is overloaded after applying NESC strength factors per \u00A7261). Same convenience-boolean pattern as cimbology:clearanceViolated.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://cimbology.com/ontology/kg#PoleLoadResult"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Pole Loading Violated"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#boolean"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#poleMaterial",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Pole material (e.g., \u0027wood\u0027, \u0027composite\u0027, \u0027steel\u0027, \u0027concrete\u0027). CIM equivalent: cim:Structure.materialKind (IEC61968 AssetInfo) using cim:StructureMaterialKind enum (wood, steel, concrete, other). CIMBOLOGY-KG uses a string to accommodate \u0027composite\u0027 which the CIM enum does not include.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Pole Material"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://iec.ch/TC57/CIM100#Structure"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#poleSpecies",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Wood pole species per ANSI O5.1 (e.g., \u0027Southern Yellow Pine\u0027, \u0027Western Red Cedar\u0027, \u0027Douglas Fir\u0027). Species determines fiber strength and ground-line moment capacity. CIM equivalent: cim:Pole.speciesType (IEC61968 InfAssets), which lists \u0027Wood-Treated\u0027, \u0027Wood-Hard\u0027, \u0027Wood-Salt Treated\u0027, \u0027Wood-Soft\u0027, etc. CIMBOLOGY-KG uses ANSI O5.1 species names because design tools reference the standard directly.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Pole Species"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://iec.ch/TC57/CIM100#Pole"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#poleType",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Pole functional type (e.g., \u0027support\u0027, \u0027guy\u0027, \u0027porch\u0027, \u0027deadend\u0027, \u0027tangent\u0027, \u0027non-meter\u0027). Describes the structural role in the line, not the material (use poleSpecies/poleMaterial for material).",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Pole Type"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://iec.ch/TC57/CIM100#Pole"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#positionInBay",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "0-based position of equipment within its bay. For BAH: 0=Bus-A-side, 1=Middle/Tie, 2=Bus-B-side. For DBDB: 0=Bus-A-side, 1=Bus-B-side. Consuming tools use this instead of parsing equipment names."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Position In Bay"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#integer"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#projectCode",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Project or work order code for tracking design/construction scope."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Project Code"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#protects",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Functional relationship linking a surge arrester to the equipment or junction it protects from overvoltage events."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Protects"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#provenanceCitation",
