        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://cimbology.com/ontology/kg#DistributionCriteria"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Max Ice Thickness"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#double"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#maxJamRatio",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Maximum allowable jam ratio (duct inner diameter / cable outer diameter). Jam occurs when ratio approaches 3. Typical default: 3.1.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://cimbology.com/ontology/kg#DistributionCriteria"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Max Jam Ratio"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#double"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#maxOperatingTemp",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://qudt.org/schema/qudt/applicableUnit": [
      {
        "@id": "http://qudt.org/vocab/unit/DEG_C"
      }
    ],
    "http://qudt.org/schema/qudt/quantityKind": [
      {
        "@id": "http://qudt.org/vocab/quantitykind/Temperature"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Maximum operating temperature in degrees Celsius for thermal rating. Applies to distribution conductors (sag calculation), HV cables (insulation thermal limit), and substation buswork (continuous current rating). CIM equivalent: cim:WireInfo.ratedCurrent implicitly encodes this via the thermal rating.",
