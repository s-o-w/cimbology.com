        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://cimbology.com/ontology/kg#DistributionCriteria"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Strength Factor"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#double"
      }
    ]
  },
  {
    "@id": "https://cimbology.com/ontology/kg#structureType",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Structure location or installation type (e.g., \u0027above ground\u0027, \u0027underground\u0027, \u0027overhead\u0027). Applies to distribution poles, substation structures, HV cable routes, and civil infrastructure alike.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Structure Type"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
