  {
    "@id": "http://iec.ch/TC57/CIM100#RandomisationKind",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Kind of randomisation to be applied to control the timing of end device control commands and/or the definition of demand response and load control events. Value other than \u0027none\u0027 is typically used to mitigate potential deleterious effects of simultaneous operation of multiple devices.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://cimbology.com/ontology/iec61968.ttl"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "RandomisationKind",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2002/07/owl#equivalentClass": [
      {
        "@id": "_:oneOfClass_RandomisationKind"
      }
    ],
    "https://cimbology.com/ontology/cimdoc#cimPackage": [
      {
        "@value": "IEC61968.Metering"
      }
    ],
    "https://cimbology.com/ontology/cimdoc#packageTier": [
      {
        "@value": "Normative"
      }
    ]
  },
  {
    "@id": "http://iec.ch/TC57/CIM100#RandomisationKind.default",
    "@type": [
      "http://iec.ch/TC57/CIM100#RandomisationKind",
      "http://www.w3.org/2002/07/owl#NamedIndividual"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Randomisation of start and/or end times involving the operation of one or more devices is controlled by default settings for the device(s).",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://cimbology.com/ontology/iec61968.ttl"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "default",
        "@language": "en"
      }
    ],
    "https://cimbology.com/ontology/cimdoc#enumCode": [
      {
        "@value": "3",
        "@type": "http://www.w3.org/2001/XMLSchema#integer"
      }
    ]
  },
  {
    "@id": "http://iec.ch/TC57/CIM100#RandomisationKind.end",
    "@type": [
      "http://iec.ch/TC57/CIM100#RandomisationKind",
      "http://www.w3.org/2002/07/owl#NamedIndividual"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "End time of an event or control action affecting one or more devices is randomised to prevent simultaneous operation.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://cimbology.com/ontology/iec61968.ttl"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "end",
        "@language": "en"
      }
    ],
    "https://cimbology.com/ontology/cimdoc#enumCode": [
      {
        "@value": "1",
        "@type": "http://www.w3.org/2001/XMLSchema#integer"
      }
    ]
  },
  {
    "@id": "http://iec.ch/TC57/CIM100#RandomisationKind.none",
    "@type": [
      "http://iec.ch/TC57/CIM100#RandomisationKind",
      "http://www.w3.org/2002/07/owl#NamedIndividual"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Neither the start time nor the end time of an event or control action affecting one or more devices is randomised.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://cimbology.com/ontology/iec61968.ttl"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "none",
        "@language": "en"
      }
    ],
    "https://cimbology.com/ontology/cimdoc#enumCode": [
      {
        "@value": "4",
        "@type": "http://www.w3.org/2001/XMLSchema#integer"
      }
    ]
  },
  {
    "@id": "http://iec.ch/TC57/CIM100#RandomisationKind.start",
    "@type": [
      "http://iec.ch/TC57/CIM100#RandomisationKind",
      "http://www.w3.org/2002/07/owl#NamedIndividual"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Start time of an event or control action affecting one or more multiple devices is randomised.",
