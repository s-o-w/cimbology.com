      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The frequency for automatically recurring auxiliary charges, where \u0027AuxiliaryAccount.initialCharge\u0027 is recursively added to \u0027AuxiliaryAccount. dueCurrent\u0027 at the start of each \u0027auxCycle\u0027. For example: on a specified date and time; hourly; daily; weekly; monthly; 3-monthly; 6-monthly; 12-monthly; etc.",
        "@language": "en"
      }
    ],
