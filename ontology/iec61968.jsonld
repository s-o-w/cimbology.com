  {
    "@id": "http://iec.ch/TC57/CIM100#OperationalRestriction",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A document that can be associated with equipment to describe any sort of restrictions compared with the original manufacturer\u0027s specification or with the usual operational practice e.g. temporary maximum loadings, maximum switching current, do not operate if bus couplers are open, etc. In the UK, for example, if a breaker or switch ever mal-operates, this is reported centrally and utilities use their asset systems to identify all the installed devices of the same manufacturer\u0027s type. They then apply operational restrictions in the operational systems to warn operators of potential problems. After appropriate inspection and maintenance, the operational restrictions may be removed.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://cimbology.com/ontology/iec61968.ttl"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "OperationalRestriction",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://iec.ch/TC57/CIM100#Document"
      }
    ],
    "https://cimbology.com/ontology/cimdoc#cimPackage": [
      {
        "@value": "IEC61968.Operations"
      }
    ],
    "https://cimbology.com/ontology/cimdoc#packageTier": [
      {
        "@value": "Normative"
      }
    ]
  },
