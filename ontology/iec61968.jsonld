  {
    "@id": "http://iec.ch/TC57/CIM100#UsagePoint.isSdp",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "If true, this usage point is a service delivery point, i.e., a usage point where the ownership of the service changes hands.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
