  {
    "@id": "http://iec.ch/TC57/CIM100#ReadingInterharmonic",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Interharmonics are represented as a rational number \u0027numerator\u0027 / \u0027denominator\u0027, and harmonics are represented using the same mechanism and identified by \u0027denominator\u0027=1.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://cimbology.com/ontology/iec61968.ttl"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "ReadingInterharmonic",
        "@language": "en"
      }
    ],
    "https://cimbology.com/ontology/cimdoc#cimPackage": [
      {
        "@value": "IEC61968.Metering"
      }
    ],
    "https://cimbology.com/ontology/cimdoc#packageTier": [
      {
        "@value": "Normative"
      }
    ]
  },
  {
    "@id": "http://iec.ch/TC57/CIM100#ReadingInterharmonic.denominator",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Interharmonic denominator. Value 0 means not applicable. Value 2 is used in combination with \u0027numerator\u0027=1 to represent interharmonic 1/2. Finally, value 1 indicates the harmonic of the order specified with \u0027numerator\u0027.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://iec.ch/TC57/CIM100#ReadingInterharmonic"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://cimbology.com/ontology/iec61968.ttl"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "denominator",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#integer"
      }
    ]
  },
  {
    "@id": "http://iec.ch/TC57/CIM100#ReadingInterharmonic.numerator",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Interharmonic numerator. Value 0 means not applicable. Value 1 is used in combination with \u0027denominator\u0027=2 to represent interharmonic 1/2, and with \u0027denominator\u0027=1 it represents fundamental frequency. Finally, values greater than 1 indicate the harmonic of that order (e.g., \u0027numerator\u0027=5 is the fifth harmonic).",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://iec.ch/TC57/CIM100#ReadingInterharmonic"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://cimbology.com/ontology/iec61968.ttl"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "numerator",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#integer"
      }
    ]
  },
  {
    "@id": "http://iec.ch/TC57/CIM100#ReadingQuality",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Quality of a specific reading value or interval reading value. Note that more than one quality may be applicable to a given reading. Typically not used unless problems or unusual conditions occur (i.e., quality for each reading is assumed to be good unless stated otherwise in associated reading quality type). It can also be used with the corresponding reading quality type to indicate that the validation has been performed and succeeded.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
