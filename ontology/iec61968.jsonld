  {
    "@id": "http://iec.ch/TC57/CIM100#UsagePointConnectedKind.connected",
    "@type": [
      "http://iec.ch/TC57/CIM100#UsagePointConnectedKind",
      "http://www.w3.org/2002/07/owl#NamedIndividual"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The usage point is connected to the network and able to receive or send the applicable commodity (electricity, gas, water, etc.).",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://cimbology.com/ontology/iec61968.ttl"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "connected",
        "@language": "en"
      }
    ],
    "https://cimbology.com/ontology/cimdoc#enumCode": [
      {
        "@value": "0",
        "@type": "http://www.w3.org/2001/XMLSchema#integer"
      }
    ]
  },
  {
    "@id": "http://iec.ch/TC57/CIM100#UsagePointConnectedKind.logicallyDisconnected",
    "@type": [
      "http://iec.ch/TC57/CIM100#UsagePointConnectedKind",
      "http://www.w3.org/2002/07/owl#NamedIndividual"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The usage point has been disconnected through operation of a disconnect function within the meter present at the usage point. The usage point is unable to receive or send the applicable commodity (electricity, gas, water, etc.) A logical disconnect can often be achieved without utilising a field crew.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://cimbology.com/ontology/iec61968.ttl"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "logicallyDisconnected",
        "@language": "en"
      }
    ],
    "https://cimbology.com/ontology/cimdoc#enumCode": [
      {
        "@value": "2",
        "@type": "http://www.w3.org/2001/XMLSchema#integer"
      }
    ]
  },
  {
    "@id": "http://iec.ch/TC57/CIM100#UsagePointConnectedKind.physicallyDisconnected",
    "@type": [
      "http://iec.ch/TC57/CIM100#UsagePointConnectedKind",
      "http://www.w3.org/2002/07/owl#NamedIndividual"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The usage point has been disconnected from the network at a point upstream of the meter. The usage point is unable to receive or send the applicable commodity (electricity, gas, water, etc.). A physical disconnect is often achieved by utilising a field crew.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://cimbology.com/ontology/iec61968.ttl"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "physicallyDisconnected",
        "@language": "en"
      }
    ],
    "https://cimbology.com/ontology/cimdoc#enumCode": [
      {
        "@value": "1",
        "@type": "http://www.w3.org/2001/XMLSchema#integer"
      }
    ]
  },
