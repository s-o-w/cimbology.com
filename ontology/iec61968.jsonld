      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The interest per annum to be charged prorata on \u0027AuxiliaryAccount.dueArrears\u0027 at the end of each \u0027payCycle\u0027.",
