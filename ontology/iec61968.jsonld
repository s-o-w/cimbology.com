      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "scalarDenominator",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#integer"
      }
    ]
  },
  {
    "@id": "http://iec.ch/TC57/CIM100#PendingCalculation.scalarFloat",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "(if scalar is floating number) When multiplied with \u0027IntervalReading.value\u0027, it causes a unit of measure conversion to occur, according to the \u0027ReadingType. unit\u0027.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://iec.ch/TC57/CIM100#PendingCalculation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
