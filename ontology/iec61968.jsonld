  },
  {
    "@id": "http://iec.ch/TC57/CIM100#PendingCalculation.scalarDenominator",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "(if scalar is rational number) When \u0027IntervalReading.value\u0027 is multiplied by \u0027scalarNumerator\u0027 and divided by this value, it causes a unit of measure conversion to occur, resulting in the \u0027ReadingType.unit\u0027.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://iec.ch/TC57/CIM100#PendingCalculation"
      }
    ],
