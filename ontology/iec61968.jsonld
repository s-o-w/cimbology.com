  {
    "@id": "http://iec.ch/TC57/CIM100#OilAnalysisGasAnalogKind.equivalentTCGPercent",
    "@type": [
      "http://iec.ch/TC57/CIM100#OilAnalysisGasAnalogKind",
      "http://www.w3.org/2002/07/owl#NamedIndividual"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Equivalent Total Combustible Gas (ETCG) percent. An estimate, calculated from the dissolved-gas concentrations and the oil sample temperature, of what the TCG would be in a gas space in equilibrium with the oil. ETCG reflects what the TCG would be in air spaces near the oil.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
