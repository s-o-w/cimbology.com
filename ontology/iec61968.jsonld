    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "It is possible for a meter to be outfitted with an external VT and/or CT. The meter might not be aware of these devices, and the display not compensate for their presence. Ultimately, when these scalars are applied, the value that represents the service value is called the \uFFFDprimary metered\uFFFD value. The \uFFFDindex\uFFFD in sub-category 3 mirrors those of sub-category 0.",
        "@language": "en"
      }
    ],
