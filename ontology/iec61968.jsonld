  {
    "@id": "http://iec.ch/TC57/CIM100#CoolingPowerRating.powerRating",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The power rating associated with type of cooling specified for this stage.",
