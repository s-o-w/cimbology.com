  {
    "@id": "http://iec.ch/TC57/CIM100#Shift",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Generally referring to a period of operation or work performed. Whether the shift is open/closed can be derived from attributes \u0027activityInterval.start\u0027 and \u0027activityInterval.end\u0027. The grand total for receipts (i.e., cumulative total of all actual receipted amounts during this shift; bankable \u002B non-bankable; excludes rounding error totals) can be derived from receipt: =sum(\u0027Receipt.receiptAmount\u0027); includes bankable and non-bankable receipts. It also has to be reconciled against: =sum(\u0027receiptsGrandTotalBankable\u0027 \u002B \u0027receiptsGrandTotalNonBankable\u0027) and against receipt summary: =sum(\u0027ReceiptSummary.receiptsTotal\u0027). The attributes with \u0022GrandTotal\u0022 defined in this class may need to be used when the source data is periodically flushed from the system and then these cannot be derived.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://cimbology.com/ontology/iec61968.ttl"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Shift",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://iec.ch/TC57/CIM100#IdentifiedObject"
      }
    ],
    "https://cimbology.com/ontology/cimdoc#cimPackage": [
      {
        "@value": "IEC61968.PaymentMetering"
      }
    ],
    "https://cimbology.com/ontology/cimdoc#packageTier": [
      {
        "@value": "Normative"
      }
    ]
  },
  {
    "@id": "http://iec.ch/TC57/CIM100#Shift.activityInterval",
