  {
    "@id": "http://iec.ch/TC57/CIM100#Tender",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Tender is what is \u0022offered\u0022 by the customer towards making a payment and is often more than the required payment (hence the need for \u0027change\u0027). The payment is thus that part of the Tender that goes towards settlement of a particular transaction. Tender is modelled as an aggregation of Cheque and Card. Both these tender types can exist in a single tender bid thus \u0027accountHolderName\u0027 has to exist separately in each of Cheque and Card as each could have a different account holder name.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://cimbology.com/ontology/iec61968.ttl"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Tender",
        "@language": "en"
      }
    ],
