      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "scalarFloat",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#float"
      }
    ]
  },
  {
    "@id": "http://iec.ch/TC57/CIM100#PendingCalculation.scalarNumerator",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "(if scalar is integer or rational number) When the scalar is a simple integer, and this attribute is presented alone and multiplied with \u0027IntervalReading. value\u0027, it causes a unit of measure conversion to occur, resulting in the \u0027ReadingType.unit\u0027. It is never used in conjunction with \u0027scalarFloat\u0027, only with \u0027scalarDenominator\u0027.",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://iec.ch/TC57/CIM100#PendingCalculation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
