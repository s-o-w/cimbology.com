      {
        "@id": "http://iec.ch/TC57/CIM100#TimePoint"
      }
    ]
  },
  {
    "@id": "http://iec.ch/TC57/CIM100#TimeSchedule.disabled",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "True if this schedule is deactivated (disabled).",
        "@language": "en"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://iec.ch/TC57/CIM100#TimeSchedule"
      }
    ],
