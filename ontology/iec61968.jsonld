  {
    "@id": "http://iec.ch/TC57/CIM100#Ratio.denominator",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The part of a fraction that is below the line and that functions as the divisor of the numerator.",
        "@language": "en"
      }
    ],
